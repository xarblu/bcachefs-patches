+        &mut self,
+        t: &TransAttempt<'a, 't>,
+    ) -> Option<BtreeNodeRef> {
+        unsafe {
+            let path = c::btree_iter_path(t.raw(), self.raw_mut());
+            let node = (*path).l[(*path).level() as usize].b;
