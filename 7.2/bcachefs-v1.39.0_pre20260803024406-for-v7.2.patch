+	data/migrate.o				\
+	data/move.o				\
+	data/nocow_locking.o			\
+	data/read.o				\
+	data/reconcile/check.o			\
+	data/reconcile/trigger.o		\
+	data/reconcile/work.o			\
+	data/reflink.o				\
