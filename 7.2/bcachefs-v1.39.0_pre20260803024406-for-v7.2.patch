+bitfield! {
+    #[derive(Copy, Clone)]
+    /// documentation comments also work!
+    struct FooBar(u32);
+    impl Debug;
+    foo1, set_foo1: 0, 0;
+    u8;
+    foo2, set_foo2: 31, 31;
+    foo3, set_foo3: THREE, 0;
