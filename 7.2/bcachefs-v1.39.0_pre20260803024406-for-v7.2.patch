+
+int bch2_btree_lost_data(struct bch_fs *, struct printbuf *, enum btree_id);
+void bch2_set_btree_clean(struct bch_fs *, enum btree_id);
+void bch2_clear_btree_clean(struct bch_fs *, enum btree_id);
