+static long bch2_ioctl_read_super(struct bch_fs *c,
+				  struct bch_ioctl_read_super arg)
+{
+	struct bch_dev *ca __free(bch2_dev_put) = NULL;
+	struct bch_sb *sb;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return bch_err_throw(c, EPERM_non_admin);
+
+	if ((arg.flags & ~(BCH_BY_INDEX|BCH_READ_DEV)) ||
+	    arg.pad)
+		return bch_err_throw(c, EINVAL_ioctl_read_super_bad_flags);
+
+	guard(mutex_noio)(&c->sb_lock);
+
+	if (arg.flags & BCH_READ_DEV) {
+		ca = errptr_try(bch2_device_lookup(c, arg.dev, arg.flags));
+		sb = ca->disk_sb.sb;
+	} else {
+		sb = c->disk_sb.sb;
+	}
+
+	if (vstruct_bytes(sb) > arg.size)
+		return -ERANGE;
+
+	return copy_to_user_errcode((void __user *)(unsigned long)arg.sb, sb,
+				    vstruct_bytes(sb));
+}
