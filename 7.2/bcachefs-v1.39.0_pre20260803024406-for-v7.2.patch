+noinline __cold
+static void data_read_trace(struct bch_read_bio *rbio, struct bkey_s_c k)
+{
+	__event_trace(rbio->c, data_read, buf, ({
+		bch2_bkey_val_to_text(&buf, rbio->c, k);
+		prt_newline(&buf);
