+		struct bkey k1 = bkey_unpack_key(b, prev);
+		bch2_bkey_to_text(&buf, &k1);
+		prt_newline(&buf);
+
+		prt_str(&buf, "insert  key ");
+		struct bkey k2 = bkey_unpack_key(b, insert);
+		bch2_bkey_to_text(&buf, &k2);
+		prt_newline(&buf);
