+#define bch2_bkey_ops_deleted ((struct bkey_ops) {	\
+	.key_validate	= deleted_key_validate,		\
+})
+
+#define bch2_bkey_ops_whiteout ((struct bkey_ops) {	\
+	.key_validate	= deleted_key_validate,		\
