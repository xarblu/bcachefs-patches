+
+	bkey_fsck_err_on(INODEv1_STR_HASH(inode.v) >= BCH_STR_HASH_NR,
+			 c, inode_str_hash_invalid,
+			 "invalid str hash type (%llu >= %u)",
+			 INODEv1_STR_HASH(inode.v), BCH_STR_HASH_NR);
+
+	ret = __bch2_inode_validate(c, k, from);
+fsck_err:
+	return ret;
+}
