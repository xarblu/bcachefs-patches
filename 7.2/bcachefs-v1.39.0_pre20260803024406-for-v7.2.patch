+static inline void bch2_prt_member_name(struct printbuf *out, struct bch_fs *c, unsigned idx)
+{
+	if (idx == BCH_SB_MEMBER_INVALID) {
+		prt_str(out, "(none)");
+	} else {
+		guard(rcu)();
+		guard(printbuf_atomic)(out);
+		struct bch_dev *ca = c ? bch2_dev_rcu_noerror(c, idx) : NULL;
