+#[macro_export]
+#[doc(hidden)]
+macro_rules! __bitfield_stringify {
+    ($s:ident) => {
+        stringify!($s)
+    };
+}
+
+// Same as std::debug_assert but callable from local_inner_macros macros defined inside
+// this crate.
+#[macro_export]
+#[doc(hidden)]
+macro_rules! __bitfield_debug_assert {
+    ($e:expr) => {
+        debug_assert!($e)
+    };
+}
