+	if (!trace_btree_path_set_pos_enabled()) {
+		return path_set_pos(trans, path_idx, new_pos, intent, ip);
+	} else {
+		return path_set_pos_trace(trans, path_idx, new_pos, intent, ip);
+	}
+}
