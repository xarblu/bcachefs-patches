+    u16, foo4, set_foo4: 31, 28;
+    foo5, set_foo5: 0, 0, 32;
+    u32;
+    foo6, set_foo6: 5, THREE, THREE;
+    getter_only, _: 3, 1;
+    _, setter_only: 2*2, 2;
+    getter_only_array, _: 5, 3, 3;
+    _, setter_only_array: 2*THREE, 4, 3;
+    all_bits, set_all_bits: 31, 0;
+    single_bit, set_single_bit: 3;
