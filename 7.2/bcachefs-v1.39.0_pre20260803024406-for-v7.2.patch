+    out.push_str("// Auto-generated from BCH_BKEY_TYPES() — do not edit\n\n");
+    out.push_str(
+        "/// A bkey type together with its val struct's type info.\n\
+         pub struct BkeyTypeInfo {\n\
+         \x20   pub name: &'static str,\n\
+         \x20   pub type_: u32,\n\
+         \x20   pub info: &'static StructInfo,\n\
+         }\n\n",
+    );
