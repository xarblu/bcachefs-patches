+	sb/io.o					\
+	sb/members.o				\
+	snapshots/check_snapshots.o		\
+	snapshots/delete.o			\
+	snapshots/snapshot.o			\
+	snapshots/subvolume.o			\
+	util/clock.o				\
+	util/darray.o				\
+	util/enumerated_ref.o			\
+	util/eytzinger.o			\
+	util/fast_list.o			\
+	util/locking.o				\
+	util/mean_and_variance.o		\
+	util/printbuf.o				\
+	util/rcu_pending.o			\
+	util/siphash.o				\
