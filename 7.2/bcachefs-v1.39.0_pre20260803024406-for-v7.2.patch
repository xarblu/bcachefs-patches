+		bch2_btree_node_bsets_to_text(&buf, NULL, b);
+
+		prt_str(&buf, "insert > next:\n");
+
+		prt_str(&buf, "prev    key ");
+		struct bkey k1 = bkey_unpack_key(b, prev);
+		bch2_bkey_to_text(&buf, &k1);
