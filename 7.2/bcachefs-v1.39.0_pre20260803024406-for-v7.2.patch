+typedef DARRAY(struct bch_fs *) darray_fs;
+
+static int bch2_test_super(struct super_block *s, struct fs_context *fc)
+{
+	struct bch_fs *c = s->s_fs_info;
+	darray_fs *d = fc->s_fs_info;
+
+	if (!c)
+		return false;
+
+	darray_for_each(*d, i)
+		if (c != *i)
+			return false;
+	return true;
+}
