+#[inline]
+fn encode_braced<'b>(src: &[u8; 16], buffer: &'b mut [u8], upper: bool) -> &'b mut str {
+    let buf = &mut buffer[..Braced::LENGTH];
+    buf[0] = b'{';
+    buf[Braced::LENGTH - 1] = b'}';
