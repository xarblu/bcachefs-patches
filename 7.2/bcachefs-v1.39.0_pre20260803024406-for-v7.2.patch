+
+    loop {
+        let done = lockrestart_do(&trans, |t| {
+            let Some(k) = iter.peek()? else {
+                return t.done(true);
+            };
+            let u = t.bkey_reassemble(k)?;
+            let t = t.update(&mut iter, u, UpdateTriggerFlags::empty())?;
+            let t = t.commit(None, NO_ENOSPC)?;
+            t.done(false)
+        })
+        ?;
+
+        if done {
+            break;
+        }
+        iter.advance();
+    }
