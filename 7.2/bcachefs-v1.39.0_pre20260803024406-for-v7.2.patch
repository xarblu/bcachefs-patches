index 0000000..602c14a
--- /dev/null
+++ b/fs/bcachefs/btree/write.c
@@ -0,0 +1,867 @@
+// SPDX-License-Identifier: GPL-2.0
+#include "bcachefs.h"
+
+#include "btree/interior.h"
+#include "btree/read.h"
+#include "btree/sort.h"
+#include "btree/write.h"
