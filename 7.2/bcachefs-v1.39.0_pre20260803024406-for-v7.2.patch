+static size_t bch2_btree_cache_size(struct bch_fs *c)
+{
+	struct bch_fs_btree_cache *bc = &c->btree.cache;
+
+	return (btree_cache_list_nr(&bc->live[0]) +
+		btree_cache_list_nr(&bc->live[1])) * c->opts.btree_node_size;
+}
