+++ b/fs/bcachefs/init/chardev.c
@@ -0,0 +1,956 @@
+// SPDX-License-Identifier: GPL-2.0
+#ifndef NO_BCACHEFS_CHARDEV
+
+#include "bcachefs.h"
+#include "bcachefs_ioctl.h"
+
+#include "alloc/accounting.h"
