+#define for_btree_root_key_at_level(_trans, _iter, _btree_id, _level, _k, _do)		\
+	lockrestart_do(trans, ({							\
+		CLASS(btree_iter_uninit, iter)(trans);					\
+		struct bkey_s_c _k;							\
+		bkey_err(k = bch2_btree_iter_peek_root(_trans, &_iter,			\
+						       _btree_id, level)) ?:		\
+		(k.k ? _do : 0);							\
+	}))
