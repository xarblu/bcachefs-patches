new file mode 100644
index 0000000..abe65d9
--- /dev/null
+++ b/fs/bcachefs/init/recovery.c
@@ -0,0 +1,1223 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include "bcachefs.h"
+
