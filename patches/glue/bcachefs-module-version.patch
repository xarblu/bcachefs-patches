From 086ba2912e46624ed9c5c75140b3dc08a20eb119 Mon Sep 17 00:00:00 2001
From: Xarblu <xarblu@protonmail.com>
Date: Mon, 23 Feb 2026 19:28:06 +0100
Subject: [PATCH] bcachefs: unconditional module version

Signed-off-by: Xarblu <xarblu@protonmail.com>
---
 fs/bcachefs/Makefile | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/fs/bcachefs/Makefile b/fs/bcachefs/Makefile
index c0c9d466d01f..1235cd925927 100644
--- a/fs/bcachefs/Makefile
+++ b/fs/bcachefs/Makefile
@@ -29,6 +29,11 @@ endif
 bcachefs-config-cppflags := \
 	$(foreach o,DEBUG INJECT_TRANSACTION_RESTARTS PATH_TRACEPOINTS TESTS,$(if $(BCACHEFS_$(o)),-DCONFIG_BCACHEFS_$(o)=1)) \
 	$(if $(CONFIG_QUOTA),-DCONFIG_BCACHEFS_QUOTA=1)
+else
+# Patched in-tree build - the patch has a fixed version.h
+bcachefs-version := $(shell sed -n 's/.*bcachefs_version "\(.*\)".*/\1/p' $(src)/version.h 2>/dev/null)
+RUSTFLAGS_mod.o += --cfg bch_version
+export BCACHEFS_VERSION := $(bcachefs-version)
 endif
 
 # The generated rust/extern.c includes our shim headers relative to fs/
-- 
2.56.1

