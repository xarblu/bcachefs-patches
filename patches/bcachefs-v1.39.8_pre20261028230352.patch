new file mode 100644
index 0000000..860066d
--- /dev/null
+++ b/fs/bcachefs/vendor/kernel-rust/zerocopy/src/ref.rs
@@ -0,0 +1,1358 @@
+// SPDX-License-Identifier: (BSD-2-Clause OR Apache-2.0) OR MIT
