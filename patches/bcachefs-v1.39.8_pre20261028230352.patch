+++ b/fs/bcachefs/fs/quota_format.rs
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::types::{Le32, Le64};
+use crate::util::vstructs::{vstruct, Head};
+use cstruct_macros::{c_enum, whole, CStruct, Plain, TypeInfo, SizedVal};
+
+/* KEY_TYPE_quota: */
+c_enum! {
+    #[open]
+    pub enum quota_types: u32 {
+        QTYP_USR = 0,
+        QTYP_GRP = 1,
+        QTYP_PRJ = 2,
+        QTYP_NR = 3,
+    }
+}
+
+c_enum! {
+    #[open]
+    pub enum quota_counters: u32 {
+        Q_SPC = 0,
+        Q_INO = 1,
+        Q_COUNTERS = 2,
+    }
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, CStruct, Plain, TypeInfo)]
+pub struct bch_quota_counter {
+    pub hardlimit: Le64,
+    pub softlimit: Le64,
+}
+
+#[repr(C, align(8))]
+#[derive(Clone, Copy, Default, CStruct, Plain, TypeInfo, SizedVal)]
+#[c_packed]
+#[c_name(bch_quota)]
+pub struct Quota {
+    pub v: c::bch_val,
+    pub c: [c::bch_quota_counter; c::Q_COUNTERS as usize],
+}
+
+/* BCH_SB_FIELD_quota: */
+#[repr(C)]
+#[derive(Clone, Copy, Default, CStruct, Plain, TypeInfo)]
+pub struct bch_sb_quota_counter {
+    pub timelimit: Le32,
+    pub warnlimit: Le32,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, CStruct, Plain, TypeInfo)]
+pub struct bch_sb_quota_type {
+    pub flags: Le64,
+    pub c: [c::bch_sb_quota_counter; c::Q_COUNTERS as usize],
+}
+
+#[whole]
+#[repr(C, align(8))]
+#[derive(Clone, Copy, Default, CStruct, Plain, TypeInfo)]
+#[c_packed]
+pub struct bch_sb_field_quota {
+    pub field: Head<c::bch_sb_field>,
+    pub q: [c::bch_sb_quota_type; c::QTYP_NR as usize],
+}
+vstruct!(bch_sb_field_quota, field.u64s, start = 0);
diff --git a/fs/bcachefs/fs/quota_types.rs b/fs/bcachefs/fs/quota_types.rs
new file mode 100644
index 0000000..521bc5c
--- /dev/null
+++ b/fs/bcachefs/fs/quota_types.rs
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::locking::Lock;
+use crate::new_lock;
+use crate::util::genradix::SharedGenRadix;
+use core::sync::atomic::AtomicU32;
+use cstruct_macros::{c_enum, CStruct, TypeInfo};
+use pin_init::{pin_data, pin_init, PinInit};
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, CStruct, TypeInfo)]
+pub struct bch_qid {
+    pub q: [u32; c::QTYP_NR as usize],
+}
+
+c_enum! {
+    #[closed]
+    pub enum quota_acct_mode: u32 {
+        KEY_TYPE_QUOTA_PREALLOC,
+        KEY_TYPE_QUOTA_WARN,
+        KEY_TYPE_QUOTA_NOCHECK,
+    }
+}
+
+/// One counter of one id's in-memory quota: its usage, its limits, and the
+/// grace period's end and warnings.
+#[derive(Clone, Copy, Default, PartialEq, ::pin_init::Zeroable)]
+pub struct MemquotaCounter {
+    pub v:              u64,
+    pub hardlimit:      u64,
+    pub softlimit:      u64,
+    pub timer:          i64,
+    pub warns:          i32,
+    pub warning_issued: u32,
+}
+
+/// One id's in-memory quota - a uid's, a gid's or a project's.
+#[derive(Clone, Copy, Default, PartialEq, ::pin_init::Zeroable)]
+pub struct Memquota {
+    pub c: [MemquotaCounter; c::Q_COUNTERS as usize],
+}
+
+/// A limit from the superblock: written under sb_lock, read without a lock,
+/// as C's are.
+#[derive(Default)]
+pub struct QuotaLimit {
+    pub timelimit: AtomicU32,
+    pub warnlimit: AtomicU32,
+}
+
+/// The in-memory quotas of one type, as C's struct bch_memquota_type: the
+/// limits, and the counters by id - allocated without the lock, genradix
+/// being safe against concurrent allocation and lookup, and touched only
+/// with it held. quota.rs's guard is the way in.
+#[pin_data]
+pub struct MemquotaType {
+    pub limits:       [QuotaLimit; c::Q_COUNTERS as usize],
+    #[pin]
+    pub(crate) lock:  Lock<c::mutex>,
+    pub(crate) table: SharedGenRadix<Memquota>,
+}
+
+impl MemquotaType {
+    fn new(lock: impl PinInit<Lock<c::mutex>>) -> impl PinInit<Self> {
+        pin_init!(Self {
+            limits:  Default::default(),
+            lock    <- lock,
+            table:   SharedGenRadix::new(),
+        })
+    }
+}
+
+/// The in-memory quotas, by type - c->quotas, Rust's alone: quota.rs.
+#[pin_data]
+pub struct Quotas {
+    #[pin]
+    usr: MemquotaType,
+    #[pin]
+    grp: MemquotaType,
+    #[pin]
+    prj: MemquotaType,
+}
+
+impl Quotas {
+    /// No limits, and empty tables. A new_lock!() each, so a lock class
+    /// each: they're taken together, in type order, as C's are with
+    /// mutex_lock_nested().
+    pub fn new() -> impl PinInit<Self> {
+        pin_init!(Self {
+            usr <- MemquotaType::new(new_lock!(())),
+            grp <- MemquotaType::new(new_lock!(())),
+            prj <- MemquotaType::new(new_lock!(())),
+        })
+    }
+
+    /// Type @qtype's: a quota_types.
+    pub fn get(&self, qtype: usize) -> &MemquotaType {
+        match qtype {
+            0 => &self.usr,
+            1 => &self.grp,
+            2 => &self.prj,
+            _ => panic!("quota type {qtype} out of range"),
+        }
+    }
+}
