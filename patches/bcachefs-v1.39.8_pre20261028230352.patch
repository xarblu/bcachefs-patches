+// ── snapshot_tree keys ───────────────────────────────────────────────────
+//
+// Keys in BTREE_ID_snapshot_trees identify a whole tree of snapshot nodes;
+// they exist to provide a stable identifier for the whole lifetime of a
+// snapshot tree.
+
+fn tree_validate(v: &BkeyValidate<'_, '_>) -> Result<(), BchError> {
+    let p = v.k.k.p;
+    bkey_fsck_err_on!(v, bkey_gt(p, pos(0, u32::MAX as u64)) || bkey_lt(p, pos(0, 1)),
+                      id::snapshot_tree_pos_bad, "bad pos")?;
+    Ok(())
+}
+
+#[c_export]
+pub fn bch2_snapshot_tree_validate(
+    c:    &Opaque<c::bch_fs>,
+    k:    BkeySC<'_>,
+    from: &c::bkey_validate_context,
+) -> c_int {
+    ret_to_c(tree_validate(&BkeyValidate { fs: Fs::from_c(c), k, from }))
+}
+
+#[cold]
+#[c_export]
+pub fn bch2_snapshot_tree_to_text(out: &mut Printbuf, _c: &Opaque<c::bch_fs>, k: BkeySC<'_>) {
+    let t = c::SnapshotTree::val_copy_pad(k).expect("a snapshot_tree");
+    write!(out, "subvol {} root snapshot {}", t.master_subvol.get(), t.root_snapshot.get());
+}
+
+pub fn tree_lookup(t: &TransAttempt<'_, '_>, id: u32) -> Result<c::SnapshotTree, BchError> {
+    t.bkey_get_val::<c::SnapshotTree>(c::btree_id::snapshot_trees, pos(0, id as u64),
+                                      BtreeIterFlags::empty())
+        .map_err(|e| if e.matches(c::ENOENT) {
+            t.fs().err(bch_errcode::BCH_ERR_ENOENT_snapshot_tree)
+        } else {
+            e
+        })
+}
+
+/// At an unused id, queued for the commit, for the caller to fill in.
+pub fn tree_create<'a, 't>(t: &TransAttempt<'a, 't>)
+    -> Result<TransBkey<'a, 't, c::SnapshotTree>, BchError>
+{
+    let mut iter = BtreeIter::uninit();
+    match t.bkey_get_empty_slot(&mut iter, c::btree_id::snapshot_trees, POS_MIN,
+                                pos(0, u32::MAX as u64)) {
+        Err(e) if e.matches(bch_errcode::BCH_ERR_ENOSPC_btree_slot) =>
+            return t.fs().throw(bch_errcode::BCH_ERR_ENOSPC_snapshot_tree),
+        r => r?,
+    }
+
+    let mut k = t.bkey_alloc_typed::<c::SnapshotTree>()?;
+    k.k_mut().p = iter.pos();
+    t.update(&iter, &k, UpdateTriggerFlags::empty())?;
+    Ok(k)
+}
+
+// ── Node creation ────────────────────────────────────────────────────────
+
+/// @new_snapids.len() new nodes under @parent, in @tree, each with its
+/// subvolume from @subvols: at the free ids below the lowest in use - ids
+/// descend - and in the table already, before the commit, for what the rest
+/// of the transaction asks about them.
+fn create_snapids(
+    t:           &TransAttempt<'_, '_>,
+    parent:      u32,
+    tree:        u32,
+    new_snapids: &mut [u32],
+    subvols:     &[u32],
+) -> Result<(), BchError> {
+    let fs = t.fs();
+    let depth = fs.snapshots.depth(parent);
+
+    let mut iter = BtreeIter::new(t, c::btree_id::snapshots, POS_MIN, BtreeIterFlags::INTENT);
+    iter.peek(t)?;
+
+    for (new_id, &subvol) in new_snapids.iter_mut().zip(subvols) {
+        let p = match iter.prev_slot(t)? {
+            Some(k) if k.k.p.offset != 0 => k.k.p,
+            _ => return fs.throw(bch_errcode::BCH_ERR_ENOSPC_snapshot_create),
+        };
+
+        let mut n = t.bkey_alloc_typed::<c::Snapshot>()?;
+        n.k_mut().p = p;
+
+        let v = n.v_mut();
+        v.flags    = 0u32.into();
+        v.parent   = parent.into();
+        v.subvol   = subvol.into();
+        v.tree     = tree.into();
+        v.depth    = depth.into();
+        v.btime.lo = fs.current_time().into();
+        v.btime.hi = 0u64.into();
+
+        let mut skip: [u32; 3] = core::array::from_fn(|_| fs.snapshots.skiplist_get(parent));
+        skip.sort_unstable();
+        v.skip = skip.map(Into::into);
+
+        v.set_state(c::bch_snapshot_state::SNAPSHOT_STATE_live);
+
+        t.update(&iter, &n, UpdateTriggerFlags::empty())?;
+        mark_snapshot(fs, BkeySC::from(n.as_ref()))?;
+
+        *new_id = p.offset as u32;
+    }
+    Ok(())
+}
+
+/// Two new nodes, children of the existing @parent - a snapshot.
+fn node_create_children(
+    t:           &TransAttempt<'_, '_>,
+    parent:      u32,
+    new_snapids: &mut [u32],
+    subvols:     &[u32],
+) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    let mut n_parent: TransBkey<'_, '_, c::Snapshot> =
+        match t.bkey_get_mut(c::btree_id::snapshots, pos(0, parent as u64),
+                             BtreeIterFlags::empty(), UpdateTriggerFlags::empty()) {
+            Err(e) if e.matches(c::ENOENT) => {
+                bch_err!(fs, "snapshot {parent} not found");
+                return Err(e);
+            }
+            r => r?,
+        };
+
+    if n_parent.v().children() != [0, 0] {
+        bch_err!(fs, "Trying to add child snapshot nodes to parent that already has children");
+        return fs.throw(bch_errcode::BCH_ERR_EINVAL_snapshot_parent_already_has_children);
+    }
+
+    create_snapids(t, parent, n_parent.v().tree(), new_snapids, subvols)?;
+
+    let v = n_parent.v_mut();
+    v.children = [new_snapids[0].into(), new_snapids[1].into()];
+    v.subvol   = 0u32.into();
+    v.set_state(c::bch_snapshot_state::SNAPSHOT_STATE_live);
+    Ok(())
+}
+
+/// One new node, the root of a new tree.
+fn node_create_tree(t: &TransAttempt<'_, '_>, new_snapids: &mut [u32], subvols: &[u32])
+    -> Result<(), BchError>
+{
+    let mut n_tree = tree_create(t)?;
+
+    create_snapids(t, 0, n_tree.k().p.offset as u32, new_snapids, subvols)?;
+
+    let v = n_tree.v_mut();
+    v.master_subvol = subvols[0].into();
+    v.root_snapshot = new_snapids[0].into();
+    Ok(())
+}
+
+/// New snapshot nodes, one for each of @subvols: two children of @parent, or
+/// with @parent 0 the root of a new tree. Their ids go in @new_snapids.
+pub fn node_create(t: &TransAttempt<'_, '_>, parent: u32, new_snapids: &mut [u32], subvols: &[u32])
+    -> Result<(), BchError>
+{
+    if new_snapids.len() != subvols.len() {
+        return t.fs().throw(bch_errcode::BCH_ERR_invalid_snapshot_node);
+    }
+    assert_eq!(parent == 0, new_snapids.len() == 1);
+    assert_eq!(parent != 0, new_snapids.len() == 2);
+
+    if parent != 0 {
+        node_create_children(t, parent, new_snapids, subvols)
+    } else {
+        node_create_tree(t, new_snapids, subvols)
+    }
+}
+
+// ── Reading the table ────────────────────────────────────────────────────
+
+/// table_rebuild(), if repairs set need_table_rebuild.
+pub fn table_rebuild_if_needed(trans: &BtreeTrans<'_>) -> Result<(), BchError> {
+    if !trans.fs().snapshots.need_table_rebuild.load(Ordering::Relaxed) {
+        return Ok(());
+    }
+    table_rebuild(trans)
+}
+
+/// A topology repair rewrote a parent pointer: mark_snapshot recomputed that
+/// node's table entry, but descendants' is_ancestor bitmaps were built under
+/// the old topology. Re-mark everything (reverse: ancestors first). Ancestor
+/// queries during check_snapshots itself use the parent-walking _early
+/// variants, so the stale window ends before anything trusts the bitmaps.
+fn table_rebuild(trans: &BtreeTrans<'_>) -> Result<(), BchError> {
+    let fs = trans.fs();
+    let mut iter = BtreeIter::new(trans, c::btree_id::snapshots, POS_MAX, BtreeIterFlags::empty());
+    iter.for_each_reverse(trans, POS_MIN, |_, _, k| mark_snapshot(fs, k))?;
+
+    fs.snapshots.need_table_rebuild.store(false, Ordering::Relaxed);
+    Ok(())
+}
+
+/// The table, from the btree - and the deletions it finds to schedule: the
+/// snapshots_read recovery pass.
+fn snapshots_read(fs: &Fs) -> Result<(), BchError> {
+    // It's important that we check if we need to reconstruct snapshots before
+    // going RW, so we mark that pass as required in the superblock -
+    // otherwise, we could end up deleting keys with missing snapshot nodes
+    // instead
+    assert!(fs.flag(c::bch_fs_flags::BCH_FS_new_fs) || !fs.flag(c::bch_fs_flags::BCH_FS_may_go_rw),
+            "snapshots_read after going rw");
+
+    // Initializing the is_ancestor bitmaps requires ancestors to already be
+    // initialized - so mark in reverse:
+    let trans = crate::btree_trans!(fs);
+    let mut nr_empty_interior = 0;
+    let mut iter = BtreeIter::new(&trans, c::btree_id::snapshots, POS_MAX, BtreeIterFlags::empty());
+    iter.for_each_reverse(&trans, POS_MIN, |t, _, k| {
+        mark_snapshot(fs, k)?;
+        delete::check_snapshot_needs_deletion(t, k, &mut nr_empty_interior);
+        Ok(())
+    })?;
+
+    if nr_empty_interior != 0 {
+        let mut msg = LogMsg::with_level(fs, LogLevel::NOTICE);
+
+        let _ = writeln!(msg, "Found {nr_empty_interior} empty interior snapshot nodes");
+        passes::run_explicit(fs, &mut msg, c::bch_recovery_pass::BCH_RECOVERY_PASS_delete_dead_interior_snapshots,
+                             c::bch_run_recovery_pass_flags::empty())?;
+    }
+    Ok(())
+}
+
+crate::recovery_pass!(bch2_snapshots_read => snapshots_read);
+
+// ── Lookups ──────────────────────────────────────────────────────────────
+
+/// ENOENT if there's none.
+pub fn lookup(t: &TransAttempt<'_, '_>, id: u32) -> Result<c::Snapshot, BchError> {
+    t.bkey_get_val::<c::Snapshot>(c::btree_id::snapshots, pos(0, id as u64),
+                                  BtreeIterFlags::empty())
+}
+
+/// ENOENT if there's none.
+pub fn lookup_key(t: &TransAttempt<'_, '_>, id: u32) -> Result<BkeyI<c::Snapshot>, BchError> {
+    t.bkey_get_key::<c::Snapshot>(c::btree_id::snapshots, pos(0, id as u64),
+                                  BtreeIterFlags::empty())
+}
+
+/// Whether @k is in a snapshot that doesn't exist - reported, and @k deleted
+/// or its snapshot reconstructed - for the caller to skip it.
+pub fn check_key_has_snapshot<'a>(
+    t:    &TransAttempt<'a, '_>,
+    iter: &BtreeIter<'a>,
+    k:    BkeySC<'_>,
+) -> Result<bool, BchError> {
+    if t.fs().snapshots.id_state(k.k.p.snapshot) == c::snapshot_id_state::SNAPSHOT_ID_live {
+        return Ok(false);
+    }
+    check_snapshots::check_key_has_snapshot(t, Some(iter), k)
+}
+
+/// The snapshots that have overwritten the key at @pos in @btree: on each
+/// branch, the one closest to @pos.snapshot.
+pub fn overwrites(t: &TransAttempt<'_, '_>, btree: c::btree_id, pos: c::bpos)
+    -> Result<KVVec<u32>, BchError>
+{
+    let mut ids = KVVec::new();
+
+    if !t.fs().snapshots.has_children(pos.snapshot) {
+        return Ok(ids);
+    }
+
+    // From the version before @pos's - in the snapshot with the next lower
+    // ID; @pos.snapshot has children, so it isn't 0 - down
+    let mut iter = BtreeIter::new(t, btree, spos(pos.inode, pos.offset, pos.snapshot - 1),
+                                  BtreeIterFlags::ALL_SNAPSHOTS);
+    iter.for_each_reverse_norestart(t, spos(pos.inode, pos.offset, 0), |_, k| {
+        let id = k.k.p.snapshot;
+        if is_ancestor(t, id, pos.snapshot) &&
+           !ids.iter().any(|&i| is_ancestor(t, id, i)) {
+            ids.push(id, GFP_KERNEL)?;
+        }
+        Ok(())
+    })?;
+    Ok(ids)
+}
+
+/// Whether a descendant of @pos.snapshot has its own version of the key at
+/// @pos in @btree: overwrote it there.
+pub fn has_overwrites(t: &TransAttempt<'_, '_>, btree: c::btree_id, pos: c::bpos)
+    -> Result<bool, BchError>
+{
+    // Descendants have lower IDs: none below snapshot 0
+    let Some(below) = pos.snapshot.checked_sub(1) else { return Ok(false) };
+
+    let mut iter = BtreeIter::new(t, btree, spos(pos.inode, pos.offset, below),
+                                  BtreeIterFlags::NOT_EXTENTS | BtreeIterFlags::ALL_SNAPSHOTS);
+    iter.for_each_reverse_norestart(t, spos(pos.inode, pos.offset, 0), |_, k| {
+        Ok(if is_ancestor(t, k.k.p.snapshot, pos.snapshot) {
+            ControlFlow::Break(true)
+        } else {
+            ControlFlow::Continue(())
+        })
+    })
+}
+
+/// bch2_key_has_snapshot_overwrites()'s slow path, past its leaf check.
+///
+/// # Safety
+/// @trans is in an attempt.
+#[c_export]
+pub unsafe extern "C" fn __bch2_key_has_snapshot_overwrites<'t>(
+    trans: &'t BtreeTrans<'t>,
+    btree: c::btree_id,
+    pos:   c::bpos,
+) -> c_int {
+    match has_overwrites(&unsafe { trans.attempt_in_progress() }, btree, pos) {
+        Ok(has) => has as c_int,
+        Err(e)  => -e.raw(),
+    }
+}
+
+/// TransAttempt::insert_snapshot_whiteouts(), for C: splitting an extent in
+/// a snapshot with descendants.
+///
+/// # Safety
+/// @trans is in an attempt.
+#[c_export]
+pub unsafe extern "C" fn bch2_insert_snapshot_whiteouts<'t>(
+    trans:   &'t BtreeTrans<'t>,
+    btree:   c::btree_id,
+    old_pos: c::bpos,
+    new_pos: c::bpos,
+) -> c_int {
+    ret_to_c(unsafe { trans.attempt_in_progress() }.insert_snapshot_whiteouts(btree, old_pos, new_pos))
+}
+
+// ── The tree, for error messages ─────────────────────────────────────────
+
+/// Node @id's line of tree_keys_to_text(): its state, its subvolume's path,
+/// its data.
+#[cold]
+fn node_to_text(out: &mut Printbuf, t: &TransAttempt<'_, '_>, id: u32) -> Result<(), BchError> {
+    let _ = write!(out, "{id} \t");
+
+    match lookup(t, id) {
+        Err(e) if is_restart(&e) => return Err(e),
+        Err(e) => { let _ = write!(out, "{}", e.msg()); }
+        Ok(s) => {
+            let _ = write!(out, "{} ", c::bch_snapshot_state(s.state.get()));
+            let subvol = s.subvol.get();
+            if subvol != 0 {
+                let _ = write!(out, "subvol {subvol}");
+            }
+            out.tab();
+
+            if subvol != 0 {
+                match subvolume::get(t, subvol, false) {
+                    Err(e) if is_restart(&e) => return Err(e),
+                    Err(e) => { let _ = write!(out, "{}", e.msg()); }
+                    Ok(sv) => crate::namei::inum_to_path(
+                        t, c::subvol_inum { subvol: subvol as u64, inum: sv.inode.get() }, out)?,
+                }
+            }
+            out.tab();
+
+            // external_sectors is counter 2, and only the extents btree
+            // (btree 0, the default here) carries it - so this one read is
+            // the snapshot's total on-disk usage.
+            let mut v = [0u64; 3];
+            crate::accounting::mem_read(t.fs(), &c::disk_accounting_pos::from_arm(
+                    c::bch_acct_snapshot { id, btree: 0 }), &mut v);
+            prt!(out, "{}\r", HumanReadable(v[2] << 9));
+        }
+    }
+    out.newline();
+
+    // Room for the next line now, while dropping locks to get it is cheap.
+    // Without it the next line's cut short; a restart redoes this one
+    match t.allocate_dropping_locks(|gfp| out.make_room_gfp(1024, gfp).then_some(()).ok_or(c::ENOMEM.into())) {
+        Err(e) if is_restart(&e) => Err(e),
+        _ => Ok(()),
+    }
+}
+
+/// The snapshot keys of the tree @start is in, indented by depth, for an
+/// error message. Each node is its own attempt - so not for a caller in the
+/// middle of one: the dump would restart it.
+#[cold]
+pub fn tree_keys_to_text(out: &mut Printbuf, trans: &BtreeTrans<'_>, start: u32)
+    -> Result<(), BchError>
+{
+    let fs = trans.fs();
+    let max_depth = fs.snapshots.with_table(|t| t.subtree(start).map(|(_, d)| d).max().unwrap_or(0));
+
+    out.tabstops_reset();
+    out.tabstop_push(out.indent_level() + 12 + 2 * max_depth as u32);
+    out.tabstop_push(20);
+    out.tabstop_push(40);
+    out.tabstop_push(12);
+
+    let (mut depth, mut prev_depth) = (0i32, 0i32);
+    let mut id = start;
+    while id != 0 && id <= start {
+        let d = depth - prev_depth;
+        if d > 0 {
+            out.indent_add(d as u32 * 2);
+        } else {
+            out.indent_sub((-d) as u32 * 2);
+        }
+        prev_depth = depth;
+
+        lockrestart_do(trans, |t| {
+            let restore = out.state_save();
+            node_to_text(out, t, id).inspect_err(|e| if is_restart(e) {
+                out.state_restore(restore);
+            })
+        })?;
+
+        id = fs.snapshots.with_table(|t| t.tree_next(id, &mut depth));
+    }
+
+    out.indent_sub(prev_depth as u32 * 2);
+    Ok(())
+}
diff --git a/fs/bcachefs/snapshots/subvolume.h b/fs/bcachefs/snapshots/subvolume.h
new file mode 100644
index 0000000..f2bf31d
--- /dev/null
+++ b/fs/bcachefs/snapshots/subvolume.h
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_SUBVOLUME_H
+#define _BCACHEFS_SUBVOLUME_H
+
+#include "util/darray.h"
+#include "snapshots/types_gen.h"
+#include "snapshots/subvolume_gen.h"
+
+static inline enum bch_subvolume_state bch2_subvolume_state(const struct bch_subvolume *s)
+{
+	return le32_to_cpu(s->state);
+}
+
+static inline enum bch_subvolume_state bch2_subvolume_state_from_flags(const struct bch_subvolume *s)
+{
+	return BCH_SUBVOLUME_UNLINKED_OBSOLETE(s)
+		? SUBVOLUME_STATE_unlinked
+		: SUBVOLUME_STATE_live;
+}
+
+static inline enum bch_subvolume_state bch2_subvolume_state_compat(const struct bch_subvolume *s)
+{
+	return s->state
+		? bch2_subvolume_state(s)
+		: bch2_subvolume_state_from_flags(s);
+}
+
+#define bch2_bkey_ops_subvolume ((struct bkey_ops) {		\
+	.key_validate	= bch2_subvolume_validate,		\
+	.val_to_text	= bch2_subvolume_to_text,		\
+	.trigger	= bch2_subvolume_trigger,		\
+})
+
+static inline struct bkey_s_c
+bch2_btree_iter_peek_in_subvolume_max_type(struct btree_iter *iter, struct bpos end,
+					   u32 subvolid, u32 *snapshot, unsigned flags)
+{
+	int ret = bch2_trans_relock(iter->trans);
+	if (ret)
+		return bkey_s_c_err(ret);
+
+	if (!*snapshot) {
+		ret = bch2_subvolume_get_snapshot(iter->trans, subvolid, snapshot);
+		if (ret)
+			return bkey_s_c_err(ret);
+
+		bch2_btree_iter_set_snapshot(iter, *snapshot);
+	}
+	return bch2_btree_iter_peek_max_type(iter, end, flags);
+}
+
+#define for_each_btree_key_in_subvolume_max_continue(_trans, _iter,		\
+					 _end, _subvolid, _flags, _k, _do)	\
+({										\
+	int _ret3 = 0;								\
+										\
+	do {									\
+		u32 _restart_count = bch2_trans_begin(_trans);			\
+		u32 _snapshot = 0;						\
+		_ret3 = 0;							\
+										\
+		struct bkey_s_c _k = bch2_btree_iter_peek_in_subvolume_max_type(&(_iter),\
+					_end, _subvolid, &_snapshot, (_flags));	\
+		if (!(_k).k)							\
+			break;							\
+										\
+		_ret3 = bkey_err(_k) ?: (_do);					\
+		if (!_ret3)							\
+			bch2_trans_verify_not_restarted(_trans, _restart_count);\
+	} while (bch2_err_matches(_ret3, BCH_ERR_transaction_restart) ||	\
+		 (!_ret3 && bch2_btree_iter_advance(&(_iter))));		\
+										\
+	_ret3;									\
+})
+
+static inline bool
+febk_in_subvolume_in_trans_cond(struct btree_trans *trans,
+				struct btree_iter *iter,
+				u32 *restart_count,
+				u32 *snapshot,
+				int *ret)
+{
+	if (!*ret) {
+		bch2_trans_verify_not_restarted(trans, *restart_count);
+		return bch2_btree_iter_advance(iter);
+	}
+
+	if (bch2_err_matches(*ret, BCH_ERR_transaction_restart)) {
+		*restart_count = bch2_trans_begin(trans);
+		*snapshot = 0;
+		*ret = 0;
+		return true;
+	}
+
+	return false;
+}
+
+#define for_each_btree_key_in_subvolume_max_continue_in_trans(_trans, _iter,	\
+					 _end, _subvolid, _flags, _k, _do)	\
+({										\
+	u32 _restart_count = (_trans)->restart_count;				\
+	u32 _snapshot = 0;							\
+	int _ret3 = 0;								\
+										\
+	do {									\
+		struct bkey_s_c _k = bch2_btree_iter_peek_in_subvolume_max_type(&(_iter),\
+					_end, _subvolid, &_snapshot, (_flags));	\
+		if (!(_k).k)							\
+			break;							\
+										\
+		_ret3 = bkey_err(_k) ?: (_do);					\
+	} while (febk_in_subvolume_in_trans_cond(_trans, &(_iter),		\
+				 &_restart_count, &_snapshot, &_ret3));		\
+										\
+	_ret3;									\
+})
+
+#define for_each_btree_key_in_subvolume_max(_trans, _iter, _btree_id,		\
+				_start, _end, _subvolid, _flags, _k, _do)	\
+({										\
+	CLASS(btree_iter, _iter)((_trans), (_btree_id), (_start), (_flags));	\
+										\
+	for_each_btree_key_in_subvolume_max_continue(_trans, _iter,		\
+					_end, _subvolid, _flags, _k, _do);	\
+})
+
+#define for_each_btree_key_in_subvolume_max_in_trans(_trans, _iter, _btree_id,	\
+				_start, _end, _subvolid, _flags, _k, _do)	\
+({										\
+	CLASS(btree_iter, _iter)((_trans), (_btree_id), (_start), (_flags));	\
+										\
+	for_each_btree_key_in_subvolume_max_continue_in_trans(_trans, _iter,		\
+					_end, _subvolid, _flags, _k, _do);	\
+})
+
+#endif /* _BCACHEFS_SUBVOLUME_H */
diff --git a/fs/bcachefs/snapshots/subvolume.rs b/fs/bcachefs/snapshots/subvolume.rs
new file mode 100644
index 0000000..9071334
--- /dev/null
+++ b/fs/bcachefs/snapshots/subvolume.rs
@@ -0,0 +1,964 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Subvolumes: independent directory trees, each with a root inode and a
+//! snapshot, the leaf its writes go to.
+//!
+//! State is live, unlinked or deleted, stored as codewords so check_subvol()
+//! can correct a damaged field to the nearest one. set_state() also writes
+//! the legacy UNLINKED_OBSOLETE flag; a key with state 0 predates the field,
+//! and the flag is its state.
+//!
+//! unlink() marks a subvolume unlinked and, on commit, queues the delete work,
+//! which waits for the VFS to drop the subvolume's inodes and then calls
+//! set_deleted(). A deleted subvolume is a tombstone until snapshot deletion
+//! reaps its snapshot: get() returns ENOENT for it, get_snapshot() doesn't.
+//! check_subvols deletes subvolumes a crash left unlinked.
+//!
+//! subvolume_children has a bit at (fs_path_parent, subvolume) for each nested
+//! subvolume, maintained by the trigger.
+
+use crate::btree::bkey::prelude::*;
+use crate::btree::bkey::{pos, BkeyI, BkeySC, BkeyWhole, POS_MIN};
+use crate::util::vstructs::{Validated, Whole};
+use crate::btree::bkey_methods::TriggerOp;
+use crate::btree::cow_key::CowKey;
+use crate::btree::iter::{
+    commit_do, is_restart, lockrestart_do, BtreeIter, BtreeIterFlags, BtreeTrans, CommitFlags,
+    LoopControl, Step, TransAttempt, UpdateTriggerFlags,
+};
+use crate::c;
+use crate::c::bch_recovery_pass::*;
+use crate::errcode::{bch_errcode, ret_to_c, BchError};
+use crate::fs::Fs;
+use crate::init::error::{count_fsck_err, id, BkeyValidate};
+use crate::init::passes;
+use crate::inode;
+use crate::snapshots::snapshot;
+use crate::util::alloc::KVVec;
+use crate::util::ffi::Opaque;
+use crate::util::place::Placed;
+use crate::util::Printbuf;
+use crate::util::log::{LogLevel, LogMsg};
+use crate::{bch_err, bch_err_msg, bkey_fsck_err_on, fs_inconsistent, fsck_err,
+            fsck_err_on, fsck_err_report, prt};
+use core::mem::offset_of;
+use cstruct_macros::c_export;
+
+/// Whether subvolume key @k is long enough to have @field.
+macro_rules! has_field {
+    ($k:expr, $field:ident) => {
+        $k.val_bytes().len() >=
+            offset_of!(c::Subvolume, repr.$field) + size_of_val(&c::Subvolume::default().$field)
+    };
+}
+
+// ── Lookups ──────────────────────────────────────────────────────────────
+
+/// Report @subvol missing, and schedule check_inodes to recreate it.
+#[cold]
+fn missing(fs: &Fs, subvol: u32) -> Result<(), BchError> {
+    let mut msg = LogMsg::new(fs);
+    writeln!(msg, "missing subvolume {subvol}");
+    let log = count_fsck_err(fs, id::subvol_missing, &mut msg);
+    msg.set_suppressed(!log);
+
+    passes::run_explicit(fs, &mut msg, BCH_RECOVERY_PASS_check_inodes,
+                         c::bch_run_recovery_pass_flags::from_bits_retain(0))
+}
+
+/// A tombstone is ENOENT_subvolume_deleted.
+pub fn get_key(
+    t:                         &TransAttempt<'_, '_>,
+    subvol:                    u32,
+    inconsistent_if_not_found: bool,
+) -> Result<BkeyI<c::Subvolume>, BchError> {
+    let fs = t.fs();
+
+    let mut ret = t.bkey_get_key::<c::Subvolume>(c::btree_id::subvolumes, pos(0, subvol as u64),
+                                                   BtreeIterFlags::CACHED);
+    if matches!(&ret, Ok(k) if k.v.state_decoded() == Some(c::bch_subvolume_state::SUBVOLUME_STATE_deleted)) {
+        ret = Err(fs.err(bch_errcode::BCH_ERR_ENOENT_subvolume_deleted));
+    }
+    if let Err(e) = &ret {
+        if e.matches(c::ENOENT) && inconsistent_if_not_found {
+            missing(fs, subvol)?;
+        }
+    }
+    ret
+}
+
+pub fn get(
+    t:                         &TransAttempt<'_, '_>,
+    subvol:                    u32,
+    inconsistent_if_not_found: bool,
+) -> Result<c::Subvolume, BchError> {
+    Ok(get_key(t, subvol, inconsistent_if_not_found)?.v)
+}
+
+#[c_export]
+pub fn bch2_subvolume_get(
+    trans:                     &BtreeTrans<'_>,
+    subvol:                    core::ffi::c_uint,
+    inconsistent_if_not_found: bool,
+    s:                         &mut c::Subvolume,
+) -> core::ffi::c_int {
+    ret_to_c(get(&unsafe { trans.attempt_in_progress() }, subvol,
+                 inconsistent_if_not_found).map(|v| *s = v))
+}
+
+/// Unlike get(), finds a tombstone's snapshot.
+pub(crate) fn __get_snapshot(t: &TransAttempt<'_, '_>, subvol: u32, warn: bool) -> Result<u32, BchError> {
+    let fs = t.fs();
+    let mut iter = BtreeIter::new(t, c::btree_id::subvolumes, pos(0, subvol as u64),
+                                  BtreeIterFlags::CACHED);
+    match iter.peek_slot_typed::<c::Subvolume>(t) {
+        Ok(k) => Ok(k.v().snapshot()),
+        Err(e) => {
+            if warn && e.matches(c::ENOENT) {
+                missing(fs, subvol)?;
+            }
+            Err(e)
+        }
+    }
+}
+
+pub fn get_snapshot(t: &TransAttempt<'_, '_>, subvol: u32) -> Result<u32, BchError> {
+    __get_snapshot(t, subvol, true)
+}
+
+/// For callers that handle a missing subvolume themselves: not reported.
+pub fn get_snapshot_nowarn(t: &TransAttempt<'_, '_>, subvol: u32) -> Result<u32, BchError> {
+    __get_snapshot(t, subvol, false)
+}
+
+#[c_export]
+pub fn bch2_subvolume_get_snapshot(
+    trans:  &BtreeTrans<'_>,
+    subvol: u32,
+    snapid: &mut u32,
+) -> core::ffi::c_int {
+    ret_to_c(get_snapshot(&unsafe { trans.attempt_in_progress() }, subvol)
+             .map(|s| *snapid = s))
+}
+
+/// Unlinked is the only state in which a subvolume's root may be an unlinked
+/// directory.
+pub fn is_unlinked(t: &TransAttempt<'_, '_>, subvol: u32) -> Result<bool, BchError> {
+    match get(t, subvol, false) {
+        Ok(s) => Ok(s.state_decoded() == Some(c::bch_subvolume_state::SUBVOLUME_STATE_unlinked)),
+        Err(e) if e.matches(c::ENOENT) => Ok(false),
+        Err(e) => Err(e),
+    }
+}
+
+/// EROFS if @subvol is read-only or unlinked, else its snapshot.
+pub fn is_ro_trans(t: &TransAttempt<'_, '_>, subvol: u32) -> Result<u32, BchError> {
+    let s = get(t, subvol, true)?;
+
+    if s.ro() || s.state_decoded() == Some(c::bch_subvolume_state::SUBVOLUME_STATE_unlinked) {
+        return Err(BchError::from(c::EROFS));
+    }
+    Ok(s.snapshot())
+}
+
+pub fn is_ro(fs: &Fs, subvol: u32) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+    lockrestart_do(&trans, |t| is_ro_trans(t, subvol).map(|_| ()))
+}
+
+#[c_export]
+pub fn bch2_subvol_is_ro(c: &Opaque<c::bch_fs>, subvol: u32) -> core::ffi::c_int {
+    ret_to_c(is_ro(Fs::from_c(c), subvol))
+}
+
+/// ENOTEMPTY_subvol_not_empty if @subvol has subvolumes under it.
+pub fn require_no_children(t: &TransAttempt<'_, '_>, subvol: u32) -> Result<(), BchError> {
+    let mut iter = BtreeIter::new(t, c::btree_id::subvolume_children, pos(subvol as u64, 0),
+                                  BtreeIterFlags::empty());
+    match iter.peek(t)? {
+        Some(k) if k.k.p.inode == subvol as u64 =>
+            Err(t.fs().err(bch_errcode::BCH_ERR_ENOTEMPTY_subvol_not_empty)),
+        _ => Ok(()),
+    }
+}
+
+/// Walk @iter to @end at @subvol's snapshot, calling @f on each key - with
+/// the iterator, to update at - until it breaks. A restart re-reads the
+/// snapshot and retries the current key, so @f must not restart after doing
+/// something it can't redo. @f may unlock: the next peek relocks. An attempt
+/// @f ends with ignore_restarts() is followed by a new one, as a restart's
+/// is.
+pub fn for_each_in_subvolume_max_in_trans<'t, F, R>(
+    trans:  &BtreeTrans<'t>,
+    iter:   &mut BtreeIter<'t>,
+    end:    c::bpos,
+    subvol: u32,
+    flags:  BtreeIterFlags,
+    mut f:  F,
+) -> Result<R::Break, BchError>
+where
+    F: FnMut(&TransAttempt<'_, 't>, &BtreeIter<'t>, BkeySC<'_>) -> Result<R, BchError>,
+    R: LoopControl,
+{
+    // One attempt for the walk, not one per key - readdir doesn't need a
+    // begin per key; a restart begins the next.
+    let mut t = trans.begin();
+    let mut snapshot = 0;
+
+    loop {
+        if t.is_spent() {
+            t = trans.begin();
+            snapshot = 0;
+        }
+
+        let ret = (|| -> Result<Step<R::Break>, BchError> {
+            t.relock()?;
+            if snapshot == 0 {
+                snapshot = get_snapshot(&t, subvol)?;
+                iter.set_snapshot(snapshot);
+            }
+            Ok(match iter.peek_max_type_with(&t, end, flags)? {
+                Some((iter, k)) => f(&t, iter, k)?.into_step(),
+                None    => Step::Break(Default::default()),
+            })
+        })();
+
+        match ret {
+            Ok(Step::Break(b)) => return Ok(b),
+            Ok(Step::Next)     => {
+                t.verify_not_restarted();
+                if !iter.advance() {
+                    return Ok(Default::default());
+                }
+            }
+            Ok(Step::From(pos)) => {
+                t.verify_not_restarted();
+                iter.set_pos(pos);
+            }
+            Err(e) if is_restart(&e) => {
+                t = trans.begin();
+                snapshot = 0;
+            }
+            Err(e) => return Err(e),
+        }
+    }
+}
+
+// ── The state field ──────────────────────────────────────────────────────
+
+/// Zero padded past the fields an older key lacks.
+pub fn val(k: BkeySC<'_>) -> Option<c::Subvolume> {
+    c::Subvolume::val_copy_pad(k)
+}
+
+const SUBVOLUME_STATES: [c::bch_subvolume_state; 3] = [
+    c::bch_subvolume_state::SUBVOLUME_STATE_live,
+    c::bch_subvolume_state::SUBVOLUME_STATE_unlinked,
+    c::bch_subvolume_state::SUBVOLUME_STATE_deleted,
+];
+
+/// Any subvolume, in place or whole - the struct reaches these too.
+impl c::Subvolume<Validated> {
+    pub fn snapshot(&self) -> u32 { self.snapshot.get() }
+
+    /// None if the field is 0 - the key predates it - or damaged.
+    pub fn state_field(&self) -> Option<c::bch_subvolume_state> {
+        SUBVOLUME_STATES.into_iter().find(|&s| s.0 == self.state().get())
+    }
+
+    /// The state the legacy UNLINKED_OBSOLETE flag implies.
+    pub fn state_from_flags(&self) -> c::bch_subvolume_state {
+        if self.unlinked_obsolete() { c::bch_subvolume_state::SUBVOLUME_STATE_unlinked } else { c::bch_subvolume_state::SUBVOLUME_STATE_live }
+    }
+
+    /// From the legacy flag if the key predates the state field; None if the
+    /// field is damaged.
+    pub fn state_decoded(&self) -> Option<c::bch_subvolume_state> {
+        if self.state() == 0 { Some(self.state_from_flags()) } else { self.state_field() }
+    }
+}
+
+/// The struct: a field an older key lacks, to set.
+impl c::Subvolume<Whole> {
+    /// Also sets the legacy flag for either non-live state: a state field
+    /// wiped and recovered from the flag comes back unlinked, so the deletion
+    /// reruns rather than being reverted, and an old kernel keeps deleting a
+    /// tombstone.
+    pub fn set_state(&mut self, state: c::bch_subvolume_state) {
+        self.set_unlinked_obsolete(state != c::bch_subvolume_state::SUBVOLUME_STATE_live);
+        self.state = state.0.into();
+    }
+}
+
+/// See snapshot::state_nearest().
+fn state_nearest(raw: u32) -> (c::bch_subvolume_state, u32) {
+    let mut best = (c::bch_subvolume_state::SUBVOLUME_STATE_live, 33);
+    for st in SUBVOLUME_STATES {
+        let dist = (raw ^ st.0).count_ones();
+        if dist < best.1 {
+            best = (st, dist);
+        }
+    }
+    best
+}
+
+// ── Validate, to_text, the trigger ───────────────────────────────────────
+
+fn validate(v: &BkeyValidate<'_, '_>) -> Result<(), BchError> {
+    let k = v.k;
+    let s = val(k).expect("a subvolume");
+
+    bkey_fsck_err_on!(v, k.k.p.inode != 0 || k.k.p.offset < 1 || k.k.p.offset > i32::MAX as u64,
+                      id::subvol_pos_bad, "invalid pos")?;
+    bkey_fsck_err_on!(v, s.snapshot == 0, id::subvol_snapshot_bad, "invalid snapshot")?;
+    bkey_fsck_err_on!(v, s.inode == 0, id::subvol_inode_bad, "invalid inode")?;
+
+    if has_field!(k, pad) {
+        bkey_fsck_err_on!(v, s.pad != 0, id::subvol_pad_nonzero, "reserved pad field nonzero")?;
+    }
+
+    // Only at commit, never on existing keys. Only Ok(false) fails: is_leaf()
+    // errors for ids not in the table yet, and create() commits the subvolume
+    // with its new snapshot nodes, before their trigger adds them.
+    if v.from.from() == c::bkey_validate_from::BKEY_VALIDATE_commit &&
+       v.fs.opts().no_commit_validate == 0 {
+        if has_field!(k, state) {
+            bkey_fsck_err_on!(v, s.state != 0 && s.state_field().is_none(), id::subvol_state_bad,
+                              "invalid state {:#x}", s.state.get())?;
+        }
+
+        let snapshot = s.snapshot.get();
+        bkey_fsck_err_on!(v, matches!(v.fs.snapshots.is_leaf(snapshot), Ok(false)),
+                          id::subvol_snapshot_not_leaf,
+                          "snapshot {snapshot} is an interior node (subvolumes only reference leaves)")?;
+    }
+    Ok(())
+}
+
+#[c_export]
+pub fn bch2_subvolume_validate(
+    c:    &Opaque<c::bch_fs>,
+    k:    BkeySC<'_>,
+    from: &c::bkey_validate_context,
+) -> core::ffi::c_int {
+    ret_to_c(validate(&BkeyValidate { fs: Fs::from_c(c), k, from }))
+}
+
+#[cold]
+#[c_export]
+pub fn bch2_subvolume_to_text(
+    out: &mut Printbuf,
+    _c:  &Opaque<c::bch_fs>,
+    k:   BkeySC<'_>,
+) {
+    let s = val(k).expect("a subvolume");
+
+    write!(out, "root {} snapshot id {}", s.inode.get(), s.snapshot.get());
+
+    if has_field!(k, creation_parent) {
+        write!(out, " creation_parent {}", s.creation_parent.get());
+        write!(out, " fs_parent {}", s.fs_path_parent.get());
+    }
+
+    if s.ro() {
+        write!(out, " ro");
+    }
+    if s.snap() {
+        write!(out, " snapshot");
+    }
+
+    let state = s.state().get();
+    if state == 0 {
+        write!(out, " {} (not upgraded, unlinked_obsolete={})",
+               s.state_from_flags(), s.unlinked_obsolete() as u32);
+    } else if let Some(state) = s.state_field() {
+        write!(out, " {state}");
+
+        // The legacy flag disagreeing with the state
+        if s.unlinked_obsolete() != (state != c::bch_subvolume_state::SUBVOLUME_STATE_live) {
+            write!(out, " unlinked_obsolete={}", s.unlinked_obsolete() as u32);
+        }
+    } else {
+        write!(out, " state {state:#x} invalid (unlinked_obsolete={})", s.unlinked_obsolete() as u32);
+    }
+}
+
+/// POS_MIN if it isn't nested.
+fn children_pos(k: BkeySC<'_>) -> c::bpos {
+    match val(k) {
+        Some(s) if s.fs_path_parent() != 0 => pos(s.fs_path_parent().get() as u64, k.k.p.offset),
+        _                                   => POS_MIN,
+    }
+}
+
+fn children_mod(t: &TransAttempt<'_, '_>, p: c::bpos, set: bool) -> Result<(), BchError> {
+    if p == POS_MIN {
+        return Ok(());
+    }
+    t.bit_mod(c::btree_id::subvolume_children, p, set)
+}
+
+fn trigger(t: &TransAttempt<'_, '_>, op: &TriggerOp<'_>) -> Result<(), BchError> {
+    if op.flags.contains(UpdateTriggerFlags::TRANSACTIONAL) {
+        passes::clear_btree_clean(t.fs(), c::btree_id::subvolumes);
+
+        let old = children_pos(op.old);
+        let new = children_pos(BkeySC::from(&op.new));
+
+        if old != new {
+            children_mod(t, old, false)?;
+            children_mod(t, new, true)?;
+        }
+    }
+    Ok(())
+}
+
+crate::key_trigger!(bch2_subvolume_trigger => trigger);
+
+// ── fsck ─────────────────────────────────────────────────────────────────
+
+fn check_subvol<'a, 't>(
+    t:    &TransAttempt<'a, 't>,
+    iter: &BtreeIter<'t>,
+    k:    BkeySC<'_>,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    let Some(mut s) = CowKey::<c::Subvolume>::new(iter, k) else { return Ok(()) };
+    let id = s.pos().offset;
+
+    // Predates the state field, or was wiped: silent mid-upgrade, an error
+    // after.
+    if s.v().state().get() == 0 {
+        let upgrading = fs.version_upgrade_complete() <
+            c::bcachefs_metadata_version::per_dev_fragmentation_lru;
+        if upgrading ||
+           fsck_err!(t, id::subvol_state_bad,
+                     "subvolume state unset, recovering from legacy flags:\n{}", s.to_text(fs))? {
+            let state = s.v().state_from_flags();
+            s.v_mut(t)?.state = state.0.into();
+        }
+    }
+
+    // The repairs below go by the state, so it has to be readable first.
+    if s.v().state_field().is_none() {
+        let raw = s.v().state().get();
+        let (nearest, dist) = state_nearest(raw);
+
+        // Codewords are >= 14 bits apart: within 6 bits, the nearest is the
+        // original
+        let fix = if dist <= 2 {
+            fsck_err!(t, id::subvol_state_bitflip,
+                      "subvolume state {raw:#x} is a {dist}-bit flip of {nearest} - correcting:\n{}",
+                      s.to_text(fs))?
+        } else if dist <= 6 {
+            fsck_err!(t, id::subvol_state_bad,
+                      "subvolume state {raw:#x} is {dist} bits from {nearest} - correcting:\n{}",
+                      s.to_text(fs))?
+        } else {
+            fsck_err_report!(fs, id::subvol_state_bad,
+                             "subvolume has invalid state {raw:#x} (nearest codeword {nearest} is {dist} bits away):\n{}",
+                             s.to_text(fs));
+            return fs.throw(bch_errcode::BCH_ERR_fsck_repair_unimplemented);
+        };
+
+        if fix {
+            s.v_mut(t)?.set_state(nearest);
+        }
+    }
+
+    // A tombstone only waits for its snapshot to be reaped; none of the checks
+    // below apply, and its root inode may already be gone.
+    if s.v().state_decoded() == Some(c::bch_subvolume_state::SUBVOLUME_STATE_deleted) {
+        return Ok(());
+    }
+
+    let snapid = s.v().snapshot();
+    let mut snap_iter = BtreeIter::new(t, c::btree_id::snapshots, pos(0, snapid as u64),
+                                       BtreeIterFlags::INTENT);
+    let (snap_iter, sk) = match snap_iter.peek_slot_typed_shared::<c::Snapshot>(t) {
+        Ok(r) => r,
+        Err(e) if e.matches(c::ENOENT) => {
+            let mut msg = LogMsg::with_level(fs, LogLevel::NOTICE);
+            prt!(&mut msg, "subvolume points to missing snapshot\n{}\n", s.to_text(fs));
+            passes::run_explicit(fs, &mut msg, BCH_RECOVERY_PASS_reconstruct_snapshots,
+                                 c::bch_run_recovery_pass_flags::from_bits_retain(0))?;
+            return Err(e);
+        }
+        Err(e) => return Err(e),
+    };
+    let mut n = CowKey::<c::Snapshot>::new(snap_iter, sk.untyped()).expect("a snapshot");
+
+    // The repairs below assume we own this snapshot. If it backrefs another
+    // subvolume that also points at it, that one is the owner - don't let
+    // whichever is checked last take it.
+    let backref = n.v().subvol();
+
+    if backref != 0 && backref as u64 != id {
+        match get(t, backref, false) {
+            Ok(other) if other.snapshot() == snapid => {
+                fsck_err_report!(fs, id::snapshot_subvol_backref_wrong,
+                                 "snapshot {snapid} is claimed by subvolume {backref}, which it backrefs, and also by {id}:\n{}\n{}",
+                                 s.to_text(fs), n.v());
+                return fs.throw(bch_errcode::BCH_ERR_fsck_repair_unimplemented);
+            }
+            Err(e) if !e.matches(c::ENOENT) => return Err(e),
+            _ => {}
+        }
+    }
+
+    // Subvolumes only point at leaves. No repair: which descendant to point
+    // at isn't decidable here. Before the unlinked branch, since
+    // set_deleted() would mark an interior node will_delete.
+    if n.v().children()[0] != 0 {
+        fsck_err_report!(fs, id::subvol_snapshot_not_leaf,
+                         "subvolume points to interior snapshot node:\n{}\n{}",
+                         s.to_text(fs), n.v());
+        return fs.throw(bch_errcode::BCH_ERR_fsck_repair_unimplemented);
+    }
+
+    if s.v().state_decoded() == Some(c::bch_subvolume_state::SUBVOLUME_STATE_unlinked) {
+        // Repairs above may still be queued: commit them, and rerun
+        // check_subvol() - whose fixes are then in, and don't refire -
+        // before deleting. Free when nothing's queued.
+        t.commit_lazy(None, CommitFlags::NO_ENOSPC)?;
+        return Err(t.close(CommitFlags::NO_ENOSPC, |trans|
+            bch_err_msg!(fs, set_deleted(trans, id as u32), "deleting subvolume {id}")));
+    }
+
+    // A live subvolume's snapshot must be live and point back at it. This is
+    // the side that can repair it: check_snapshots' state repair needs the
+    // backref, and its backref repair needs the state live, so a torn snapshot
+    // deletion - will_delete set, backref cleared, no tombstone - gets past
+    // both. Backref first: set_state() derives SUBVOL_OBSOLETE from it.
+    if fsck_err_on!(t, backref as u64 != id, id::snapshot_subvol_backref_wrong,
+                    "subvolume points to a snapshot that doesn't point back:\n{}\n{}",
+                    s.to_text(fs), n.v())? {
+        n.v_mut(t)?.subvol = (id as u32).into();
+    }
+
+    if fsck_err_on!(t, n.v().state_decoded() != Some(c::bch_snapshot_state::SNAPSHOT_STATE_live),
+                    id::snapshot_subvol_state_mismatch,
+                    "subvolume points to a snapshot that isn't live:\n{}\n{}",
+                    s.to_text(fs), n.v())? {
+        n.v_mut(t)?.set_state(c::bch_snapshot_state::SNAPSHOT_STATE_live);
+    }
+
+    if fsck_err_on!(t, id == c::BCACHEFS_ROOT_SUBVOL as u64 && s.v().fs_path_parent() != 0,
+                    id::subvol_root_fs_path_parent_nonzero,
+                    "root subvolume has nonzero fs_path_parent\n{}", s.to_text(fs))? {
+        s.v_mut(t)?.fs_path_parent = 0.into();
+    }
+
+    if s.v().fs_path_parent() != 0 {
+        let p = children_pos(s.key());
+        let mut children_iter = BtreeIter::new(t, c::btree_id::subvolume_children, p,
+                                               BtreeIterFlags::empty());
+        let ck = children_iter.peek_slot(t)?.expect("a slot always has a key");
+
+        if fsck_err_on!(t, ck.k.type_ != c::bch_bkey_type::KEY_TYPE_set.0 as u8,
+                        id::subvol_children_not_set,
+                        "subvolume not set in subvolume_children btree at {}:{}\n{}",
+                        { p.inode }, { p.offset }, s.to_text(fs))? {
+            t.bit_mod(c::btree_id::subvolume_children, p, true)?;
+        }
+    }
+
+    let root = c::subvol_inum { subvol: id, inum: s.v().inode.get() };
+    match inode::peek(t, &mut BtreeIter::uninit(), root, BtreeIterFlags::empty()) {
+        Ok(mut inode) => {
+            if fsck_err_on!(t, inode.bi_subvol as u64 != id, id::subvol_root_wrong_bi_subvol,
+                            "subvol root {}:{} has wrong bi_subvol field: got {}, should be {id}\n{}\nsnapshot {snapid}: {}\n{}",
+                            inode.bi_inum, inode.bi_snapshot, inode.bi_subvol,
+                            s.to_text(fs), n.v(), inode)? {
+                inode.bi_subvol = id as u32;
+                inode.bi_snapshot = s.v().snapshot();
+                inode::fsck_write(t, &mut inode)?;
+            }
+        }
+        Err(e) if e.matches(c::ENOENT) => {
+            if fsck_err!(t, id::subvol_to_missing_root,
+                         "subvolume {id} points to missing subvolume root {}:{}",
+                         root.inum, s.v().snapshot())? {
+                // Recreated empty; check_directory_structure reattaches its
+                // contents under lost+found
+                let mut inode = c::bch_inode_unpacked::default();
+                inode::init_early(fs, &mut inode);
+                inode::init_late(fs, &mut inode, fs.current_time(), 0, 0,
+                                 (c::S_IFDIR | 0o700) as c::umode_t, 0, None);
+                inode.bi_inum          = root.inum;
+                inode.bi_snapshot      = s.v().snapshot();
+                inode.bi_subvol        = id as u32;
+                inode.bi_parent_subvol = s.v().fs_path_parent().get();
+                inode::fsck_write(t, &mut inode)?;
+            }
+        }
+        Err(e) => return Err(e),
+    }
+
+    if !s.v().snap() {
+        let snapshot_root = fs.snapshots.root(s.v().snapshot());
+        let tree = fs.snapshots.tree(snapshot_root);
+
+        let st = match snapshot::tree_lookup(t, tree) {
+            Ok(st) => st,
+            Err(e) => {
+                if e.matches(c::ENOENT) {
+                    fs_inconsistent!(fs, "check_subvol: snapshot tree {tree} not found");
+                }
+                return Err(e);
+            }
+        };
+
+        if fsck_err_on!(t, st.master_subvol.get() as u64 != id,
+                        id::subvol_not_master_and_not_snapshot,
+                        "subvolume {id} is not set as snapshot but is not master subvolume")? {
+            s.v_mut(t)?.set_snap(true);
+        }
+    }
+    Ok(())
+}
+
+fn check_subvols(fs: &Fs) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+    let mut iter = BtreeIter::new(&trans, c::btree_id::subvolumes, POS_MIN,
+                                  BtreeIterFlags::PREFETCH);
+    iter.for_each_commit(&trans, None, CommitFlags::NO_ENOSPC,
+                         |t, iter, k| check_subvol(t, iter, k))?;
+
+    // A clean pass lets check_key_has_snapshot trust the in-memory table
+    if !fs.flag(c::bch_fs_flags::BCH_FS_error) {
+        passes::set_btree_clean(fs, c::btree_id::subvolumes);
+    }
+    Ok(())
+}
+
+crate::recovery_pass!(bch2_check_subvols => check_subvols);
+
+fn check_subvol_child(
+    t:    &TransAttempt<'_, '_>,
+    iter: &BtreeIter<'_>,
+    k:    BkeySC<'_>,
+) -> Result<(), BchError> {
+    let mut s_iter = BtreeIter::new(t, c::btree_id::subvolumes, pos(0, k.k.p.offset),
+                                    BtreeIterFlags::empty());
+    let s = val(s_iter.peek_slot(t)?.expect("a slot always has a key"));
+
+    // A missing subvolume means a stray entry, not a failed pass
+    if fsck_err_on!(t, s.is_none_or(|s| s.state_decoded() != Some(c::bch_subvolume_state::SUBVOLUME_STATE_live) ||
+                                        s.fs_path_parent().get() as u64 != k.k.p.inode),
+                    id::subvol_children_bad,
+                    "incorrect entry in subvolume_children btree {}:{}",
+                    { k.k.p.inode }, { k.k.p.offset })? {
+        t.delete_at(iter, UpdateTriggerFlags::empty())?;
+    }
+    Ok(())
+}
+
+fn check_subvol_children(fs: &Fs) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+    let mut iter = BtreeIter::new(&trans, c::btree_id::subvolume_children, POS_MIN,
+                                  BtreeIterFlags::PREFETCH);
+    iter.for_each_commit(&trans, None, CommitFlags::NO_ENOSPC,
+                         |t, iter, k| check_subvol_child(t, iter, k))
+}
+
+crate::recovery_pass!(bch2_check_subvol_children => check_subvol_children);
+
+// ── Unlinking, deleting ──────────────────────────────────────────────────
+
+/// Already queued as an update.
+fn get_mut<'a, 't>(t: &TransAttempt<'a, 't>, subvol: u32)
+    -> Result<crate::btree::iter::TransBkey<'a, 't, c::Subvolume>, BchError>
+{
+    let ret = t.bkey_get_mut::<c::Subvolume>(c::btree_id::subvolumes, pos(0, subvol as u64),
+                                             BtreeIterFlags::CACHED, UpdateTriggerFlags::empty());
+    if let Err(e) = &ret {
+        if e.matches(c::ENOENT) {
+            missing(t.fs(), subvol)?;
+        }
+    }
+    ret
+}
+
+/// For unlinking and deleting: also takes it out of the filesystem tree.
+fn set_state_trans(t: &TransAttempt<'_, '_>, subvol: u32, state: c::bch_subvolume_state)
+    -> Result<(), BchError>
+{
+    let mut k = get_mut(t, subvol)?;
+    let s = k.v_mut();
+    s.set_state(state);
+    s.fs_path_parent = 0.into();
+    Ok(())
+}
+
+/// @old is being deleted: subvolumes created from it name @new instead.
+fn reparent(
+    t:    &TransAttempt<'_, '_>,
+    iter: &BtreeIter<'_>,
+    k:    BkeySC<'_>,
+    old:  u32,
+    new:  u32,
+) -> Result<(), BchError> {
+    let Some(k) = k.arm::<c::Subvolume>() else { return Ok(()) };
+    let s = k.v();
+
+    // A key without creation_parent predates the field: nobody's child
+    if !has_field!(k, creation_parent) || s.creation_parent().get() != old {
+        return Ok(());
+    }
+
+    let mut u = t.bkey_make_mut(iter, k, UpdateTriggerFlags::empty())?;
+    u.v_mut().creation_parent = new.into();
+    Ok(())
+}
+
+/// Point @subvol's snapshots at @subvol's own creation_parent.
+fn reparent_children(trans: &BtreeTrans<'_>, subvol: u32) -> Result<(), BchError> {
+    let s = lockrestart_do(trans, |t| get(t, subvol, true))?;
+    let new = s.creation_parent.get();
+
+    let mut iter = BtreeIter::new(trans, c::btree_id::subvolumes, POS_MIN,
+                                  BtreeIterFlags::PREFETCH);
+    iter.for_each_commit(trans, None, CommitFlags::NO_ENOSPC,
+                         |t, iter, k| reparent(t, iter, k, subvol, new))
+}
+
+/// Make @subvol a tombstone, clear it as its tree's master, and mark its
+/// snapshot will_delete.
+fn __set_deleted(t: &TransAttempt<'_, '_>, subvol: u32) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    let mut iter = BtreeIter::new(t, c::btree_id::subvolumes, pos(0, subvol as u64),
+                                  BtreeIterFlags::CACHED | BtreeIterFlags::INTENT);
+    let k = match iter.peek_slot_typed::<c::Subvolume>(t) {
+        Err(e) if e.matches(c::ENOENT) => {
+            missing(fs, subvol)?;
+            return Err(e);
+        }
+        r => r?,
+    };
+    let snapid = k.v().snapshot();
+
+    let mut snapshot_iter = BtreeIter::new(t, c::btree_id::snapshots, pos(0, snapid as u64),
+                                           BtreeIterFlags::empty());
+    let sk = snapshot_iter.peek_slot_typed::<c::Snapshot>(t)
+        .inspect_err(|e| if e.matches(c::ENOENT) {
+            fs_inconsistent!(fs, "missing snapshot {snapid}");
+        })?;
+    let tree = sk.v().tree();
+
+    let mut tree_iter = BtreeIter::new(t, c::btree_id::snapshot_trees, pos(0, tree as u64),
+                                       BtreeIterFlags::empty());
+    let (tree_iter, tk) = tree_iter
+        .peek_slot_typed_shared::<c::SnapshotTree>(t)
+        .inspect_err(|e| if e.matches(c::ENOENT) {
+            fs_inconsistent!(fs, "missing snapshot tree {tree}");
+        })?;
+
+    if tk.v().master_subvol.get() == subvol {
+        let mut u = t.bkey_make_mut(tree_iter, tk, UpdateTriggerFlags::empty())?;
+        u.v_mut().master_subvol = 0.into();
+    }
+
+    set_state_trans(t, subvol, c::bch_subvolume_state::SUBVOLUME_STATE_deleted)?;
+    crate::snapshots::delete::node_set_deleted(t, snapid)
+}
+
+fn set_deleted(trans: &BtreeTrans<'_>, subvol: u32) -> Result<(), BchError> {
+    reparent_children(trans, subvol)?;
+    commit_do(trans, None, CommitFlags::NO_ENOSPC, |t| __set_deleted(t, subvol))
+}
+
+/// Waits for inodes still in use.
+#[cfg(kernel)]
+fn evict_inodes(fs: &Fs, subvols: &[u32]) {
+    // Borrowed: C only reads it
+    let mut list = c::snapshot_id_list {
+        data: subvols.as_ptr() as *mut u32,
+        nr:   subvols.len(),
+        size: subvols.len(),
+        ..Default::default()
+    };
+    unsafe { c::bch2_evict_subvolume_inodes(fs.as_ptr(), &mut list) }
+}
+
+#[cfg(not(kernel))]
+fn evict_inodes(_fs: &Fs, _subvols: &[u32]) {}
+
+/// Deletes unlinked subvolumes, once the VFS has let go of their inodes:
+/// unlink() queues it, holding a write ref.
+pub(crate) fn delete_unlinked(snapshots: &c::bch_fs_snapshots) {
+    let fs = snapshots.container();
+    loop {
+        let subvols = core::mem::replace(&mut *snapshots.unlinked.lock(), KVVec::new());
+        if subvols.is_empty() {
+            break;
+        }
+
+        evict_inodes(fs, &subvols);
+
+        let trans = crate::btree_trans!(fs);
+        for &id in subvols.iter() {
+            if bch_err_msg!(fs, set_deleted(&trans, id), "deleting subvolume {id}").is_err() {
+                return;
+            }
+        }
+    }
+}
+
+/// On commit, queues the delete work.
+pub fn unlink(t: &TransAttempt<'_, '_>, subvol: u32) -> Result<(), BchError> {
+    t.commit_hook(move |t| {
+        let fs = t.fs();
+
+        {
+            let mut unlinked = fs.snapshots.unlinked.lock();
+            if !unlinked.contains(&subvol) {
+                unlinked.push(subvol, crate::util::alloc::flags::GFP_KERNEL)?;
+            }
+        }
+
+        if !fs.snapshots.wait_for_pagecache_and_delete_work.queue(fs.write_ref_wq()) {
+            return Err(c::EROFS.into());
+        }
+        Ok(())
+    })?;
+
+    set_state_trans(t, subvol, c::bch_subvolume_state::SUBVOLUME_STATE_unlinked)?;
+
+    // There's no unlinked-subvolumes btree, as there is for inodes: if we
+    // crash while it's still open, check_subvols finds and deletes it
+    passes::set_no_ratelimit(t.fs(), BCH_RECOVERY_PASS_check_subvols);
+    Ok(())
+}
+
+// ── Creating ─────────────────────────────────────────────────────────────
+
+pub struct Created {
+    pub subvol:   u32,
+    pub snapshot: u32,
+    pub v:        c::Subvolume,
+}
+
+/// A subvolume rooted at @inode, under @parent in the filesystem tree; a
+/// snapshot of @src, or empty if @src is 0.
+pub fn create(
+    t:      &TransAttempt<'_, '_>,
+    inode:  u64,
+    parent: u32,
+    src:    u32,
+    ro:     bool,
+) -> Result<Created, BchError> {
+    let fs = t.fs();
+
+    let mut dst_iter = BtreeIter::uninit();
+    match t.bkey_get_empty_slot(&mut dst_iter, c::btree_id::subvolumes, POS_MIN,
+                                pos(0, u32::MAX as u64)) {
+        Err(e) if e.matches(bch_errcode::BCH_ERR_ENOSPC_btree_slot) =>
+            return fs.throw(bch_errcode::BCH_ERR_ENOSPC_subvolume_create),
+        r => r?,
+    }
+    let new_id = dst_iter.pos().offset as u32;
+
+    let mut new_nodes = [0u32; 2];
+    let snapshot_subvols = [new_id, src];
+
+    // Creating a snapshot:
+    let mut src_k = None;
+    let mut parent_snapshot = 0;
+    if src != 0 {
+        let k = get_mut(t, src)?;
+        parent_snapshot = k.v().snapshot.get();
+        src_k = Some(k);
+    }
+
+    let nr = if src != 0 { 2 } else { 1 };
+    snapshot::node_create(t, parent_snapshot, &mut new_nodes[..nr], &snapshot_subvols[..nr])?;
+
+    if let Some(mut k) = src_k {
+        k.v_mut().snapshot = new_nodes[1].into();
+    }
+
+    let mut k = t.bkey_alloc_typed::<c::Subvolume>()?;
+    k.k_mut().p = dst_iter.pos();
+    let v = k.v_mut();
+    v.flags           = 0.into();
+    v.snapshot        = new_nodes[0].into();
+    v.inode           = inode.into();
+    v.creation_parent = src.into();
+    v.fs_path_parent  = parent.into();
+    v.otime.lo        = fs.current_time().into();
+    v.otime.hi        = 0.into();
+    v.set_ro(ro);
+    v.set_snap(src != 0);
+    v.set_state(c::bch_subvolume_state::SUBVOLUME_STATE_live);
+    let v = *k.v();
+
+    t.update(&dst_iter, &k, UpdateTriggerFlags::empty())?;
+
+    Ok(Created { subvol: new_id, snapshot: new_nodes[0], v })
+}
+
+// ── A new filesystem, an upgrade ─────────────────────────────────────────
+
+/// The root snapshot tree, snapshot and subvolume of a new filesystem.
+fn initialize(fs: &Fs) -> Result<(), BchError> {
+    let mut root_tree = BkeyI::<c::SnapshotTree>::new();
+    root_tree.k.p.offset = 1;
+    let v = &mut root_tree.v;
+    v.master_subvol = (1u32).into();
+    v.root_snapshot = (u32::MAX).into();
+
+    let mut root_snapshot = BkeyI::<c::Snapshot>::new();
+    root_snapshot.k.p.offset = u32::MAX as u64;
+    let v = &mut root_snapshot.v;
+    v.flags  = 0.into();
+    v.parent = 0.into();
+    v.subvol = (c::BCACHEFS_ROOT_SUBVOL).into();
+    v.tree   = (1u32).into();
+    v.set_state(c::bch_snapshot_state::SNAPSHOT_STATE_live);
+
+    let mut root_volume = BkeyI::<c::Subvolume>::new();
+    root_volume.k.p.offset = c::BCACHEFS_ROOT_SUBVOL as u64;
+    let v = &mut root_volume.v;
+    v.flags    = 0.into();
+    v.snapshot = (u32::MAX).into();
+    v.inode    = ((c::BCACHEFS_ROOT_INO as u64)).into();
+    v.set_state(c::bch_subvolume_state::SUBVOLUME_STATE_live);
+
+    fs.btree_insert(c::btree_id::snapshot_trees, &mut root_tree, None, CommitFlags::empty(),
+                    BtreeIterFlags::empty())?;
+    fs.btree_insert(c::btree_id::snapshots, &mut root_snapshot, None, CommitFlags::empty(),
+                    BtreeIterFlags::empty())?;
+    fs.btree_insert(c::btree_id::subvolumes, &mut root_volume, None, CommitFlags::empty(),
+                    BtreeIterFlags::empty())
+}
+
+#[c_export]
+pub fn bch2_initialize_subvolumes(c: &Opaque<c::bch_fs>) -> core::ffi::c_int {
+    ret_to_c(initialize(Fs::from_c(c)))
+}
+
+/// Set bi_subvol on the root inode, upgrading to subvolumes.
+fn fs_upgrade_for_subvolumes(fs: &Fs) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+    commit_do(&trans, None, CommitFlags::NO_ENOSPC, |t| {
+        let mut iter = BtreeIter::new(t, c::btree_id::inodes,
+                                      c::bpos { inode: 0, offset: c::BCACHEFS_ROOT_INO as u64,
+                                                snapshot: u32::MAX },
+                                      BtreeIterFlags::empty());
+        let k = iter.peek_slot(t)?.expect("a slot always has a key");
+
+        if !inode::bkey_is_inode(k.k) {
+            bch_err!(fs, "root inode not found");
+            return fs.throw(bch_errcode::BCH_ERR_ENOENT_inode);
+        }
+
+        let mut inode = inode::unpack(fs, k);
+        inode.bi_subvol = c::BCACHEFS_ROOT_SUBVOL;
+        inode::write(t, &mut iter, &mut inode)
+    })
+}
+
+crate::recovery_pass!(bch2_fs_upgrade_for_subvolumes => fs_upgrade_for_subvolumes);
diff --git a/fs/bcachefs/snapshots/types.rs b/fs/bcachefs/snapshots/types.rs
new file mode 100644
index 0000000..205455e
--- /dev/null
+++ b/fs/bcachefs/snapshots/types.rs
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::fs::Fs;
+use crate::locking::Lock;
+use crate::new_lock;
+use crate::snapshots::subvolume::delete_unlinked;
+use crate::types::{DArray, RustOnly, bits_to_longs, rust_only};
+use crate::util::alloc::KVVec;
+use crate::util::bitmap::AtomicBitArray;
+use crate::util::workqueue::ReffedWork;
+use core::sync::atomic::{AtomicBool, AtomicU32};
+use cstruct_macros::{c_const, c_enum, c_rcu_array, placed, CStruct, c_typedef, Init, TypeInfo};
+use pin_init::pin_data;
+
+c_typedef! {
+    pub type snapshot_id_list = DArray<u32>;
+}
+
+c_const! {
+    #[c_int]
+    pub const IS_ANCESTOR_BITMAP: u32 = 128;
+}
+
+/*
+ * In-memory snapshot table entry, indexed by snapshot ID.
+ *
+ * Snapshots form a binary tree where IDs decrease going deeper: a parent's ID
+ * is always greater than its children's.
+ *
+ * Ancestor lookups use a three-tier strategy:
+ *  1. Skiplist (skip[]): jump up the tree in O(log n) steps
+ *  2. Bitmap (is_ancestor[]): O(1) lookup for ancestors within 128 IDs
+ *  3. Parent walk: fallback linear traversal
+ *
+ * Read under RCU; partial is_ancestor[] updates are tolerable since readers
+ * fall back to the skiplist.
+ */
+c_enum! {
+    #[closed]
+    pub enum snapshot_id_state: u32 {
+        SNAPSHOT_ID_empty,
+        SNAPSHOT_ID_live,
+        SNAPSHOT_ID_deleted,
+    }
+}
+
+/*
+ * A table entry: rewritten in place by mark_snapshot() (snapshot.rs) under
+ * table_lock while readers read it under RCU alone, so every field is an
+ * atomic - C still sees plain integers.
+ */
+#[repr(C)]
+#[derive(CStruct)]
+pub struct snapshot_t {
+    #[c("enum snapshot_id_state state")]
+    pub state: AtomicU32,
+    #[c("u32 parent")]
+    pub parent: AtomicU32,
+    /* skiplist: random ancestors, sorted ascending; try [2] first */
+    #[c("u32 skip[3]")]
+    pub skip: [AtomicU32; 3],
+    #[c("u32 depth")]
+    pub depth: AtomicU32,
+    #[c("u32 children[2]")]
+    pub children: [AtomicU32; 2], /* normalized: [0] >= [1] */
+    #[c("u32 subvol")]
+    pub subvol: AtomicU32, /* Nonzero only if a subvolume points to this node: */
+    #[c("u32 tree")]
+    pub tree: AtomicU32,
+    /* bit (ancestor - id - 1) set for ancestors within 128 IDs */
+    #[c("unsigned long is_ancestor[BITS_TO_LONGS(IS_ANCESTOR_BITMAP)]")]
+    pub is_ancestor: AtomicBitArray<{ bits_to_longs(c::IS_ANCESTOR_BITMAP as usize) }>,
+}
+
+// SAFETY: atomic integers; all zeroes is SNAPSHOT_ID_empty
+unsafe impl crate::util::rcu::RcuElement for snapshot_t {}
+
+c_rcu_array! {
+    /// c->snapshots.table, published under RCU.
+    pub type SnapshotTable = crate::util::rcu::RcuArray<c::snapshot_t>
+        as struct snapshot_table { nr, s };
+}
+
+/*
+ * Snapshot creation must prevent userspace from dirtying the page cache while
+ * the snapshot is being taken: sync_inodes_sb flushes existing dirty pages
+ * before the snapshot transaction, but if new pages get dirtied in the window
+ * between sync_inodes_sb returning and the snapshot transaction running, those
+ * dirty pages can be partially flushed (e.g. data page flushed but redo log
+ * page not yet) such that the snapshot captures an inconsistent state — the
+ * shape that bit MySQL/InnoDB.
+ *
+ * Page-cache dirtying paths (buffered write_iter and mmap mkdirty) take this
+ * lock as readers; snapshot creation takes it as a writer. O_DIRECT doesn't
+ * need it — direct writes commit as atomic btree transactions, no page cache
+ * staleness window. Buffered writeback is fine too — each writeback insert
+ * is atomic w.r.t. the snapshot transaction.
+ */
+#[placed(Fs.snapshots)]
+#[pin_data]
+#[repr(C)]
+#[derive(CStruct, TypeInfo, Init)]
+pub struct bch_fs_snapshots {
+    pub table: c::SnapshotTable,
+    /// The table's writers' lock: taken by table_write(), in snapshot.rs.
+    #[pin]
+    #[init(RustOnly::new(new_lock!(())))]
+    pub(crate) table_lock: rust_only!(Lock<c::mutex>),
+    /* a topology repair invalidated descendants' is_ancestor bitmaps: */
+    #[c("bool need_table_rebuild")]
+    #[init(AtomicBool::new(false))]
+    pub(crate) need_table_rebuild: AtomicBool,
+    #[c("struct percpu_rw_semaphore create_lock")]
+    #[pin]
+    #[init(new_lock!((), "&c->snapshots.create_lock"))]
+    pub create_lock: Lock<c::percpu_rw_semaphore>,
+    /// Snapshot deletion's state: Rust's alone - snapshots/delete.rs.
+    #[pin]
+    #[init(RustOnly::new(crate::snapshots::delete::SnapshotDelete::init()))]
+    pub(crate) delete: rust_only!(crate::snapshots::delete::SnapshotDelete),
+    #[c("struct work_struct wait_for_pagecache_and_delete_work")]
+    #[pin]
+    pub(crate) wait_for_pagecache_and_delete_work: ReffedWork<delete_unlinked, crate::field!(super.writes)>,
+    /// Subvolumes unlinked and waiting for the delete work: Rust's alone.
+    #[pin]
+    #[init(RustOnly::new(new_lock!(KVVec::new())))]
+    pub(crate) unlinked: rust_only!(Lock<c::mutex, KVVec<u32>>),
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, CStruct)]
+#[c_typedef]
+pub struct subvol_inum {
+    /* we can't have padding in this struct: */
+    pub subvol: u64,
+    pub inum: u64,
+}
