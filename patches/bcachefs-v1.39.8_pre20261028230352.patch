+void bch2_evict_inode(struct inode *vinode)
+{
+	struct bch_fs *c = vinode->i_sb->s_fs_info;
+	struct bch_inode_info *inode = to_bch_ei(vinode);
+	/*
+	 * An unlinked subvolume's root inode reads i_nlink == 0, but its
+	 * deletion belongs to the subvolume deletion path, not us (see
+	 * bch2_inode_is_subvolume_root()): this eviction completing is what
+	 * the subvolume delete work (SubvolDelete, subvolume.rs) is waiting on
+	 * to tombstone the subvolume and hand the keys to the snapshot sweep.
+	 */
+	bool delete = !inode->v.i_nlink && !is_bad_inode(&inode->v) &&
+		!bch2_inode_is_subvolume_root(&inode->ei_inode);
+
+	/*
+	 * evict() has waited for outstanding writeback, we'll do no more IO
+	 * through this inode: it's safe to remove from VFS inode hashtable here
+	 *
+	 * Do that now so that other threads aren't blocked from pulling it back
+	 * in, there's no reason for them to be:
+	 */
+	if (!delete)
+		bch2_inode_hash_remove(c, inode);
+
+	if (IS_ENABLED(CONFIG_BCACHEFS_DEBUG) && delete)
+		write_inode_now(&inode->v, true);
+	/*
+	 * Disabled: bch2_inode_find_by_inum() starts a new btree_trans, but
+	 * eviction can be called from inside an existing transaction — e.g.
+	 * discard_new_inode() from bch2_inode_hash_insert() during a
+	 * lookup. The deadlock detector can't see locks held by the
+	 * outer transaction, so cycles involving both transactions
+	 * go undetected. Observed as a three-way deadlock between
+	 * btree_node_write_work, __bch2_unlink, and bch2_lookup (github
+	 * issue #1046).
+	 */
+#if 0
+	if (verify_i_size_at_evict) {
+		BUG_ON(inode_state_read_once(&inode->v) & I_DIRTY);
+
+		struct bch_inode_unpacked inode_u;
+		if (!is_bad_inode(&inode->v) &&
+		    !bch2_journal_error(&c->journal) &&
+		    !bch2_inode_find_by_inum(c, inode_inum(inode), &inode_u)) {
+			if (inode->v.i_size != inode_u.bi_size) {
+				CLASS(bch_log_msg, msg)(c);
+
+				prt_printf(&msg.m, "vfs i_size mismatch at evict: %llu != %llu (inum %llu)\n",
+					   (u64) inode->v.i_size, inode_u.bi_size, inode_u.bi_inum);
+				bch2_trans_do(c, bch2_inum_to_path(trans, inode_inum(inode), &msg.m));
+				prt_newline(&msg.m);
+				bch2_inode_unpacked_to_text(&msg.m, &inode_u);
+				msg.m.suppress = !bch2_count_fsck_err(c, vfs_i_size_bad, &msg.m);
+			}
+
+			if (inode->v.i_blocks != inode_u.bi_sectors) {
+				CLASS(bch_log_msg, msg)(c);
+
+				prt_printf(&msg.m, "vfs i_sectors mismatch at evict: %llu != %llu (inum %llu)\n",
+					   (u64) inode->v.i_blocks, inode_u.bi_sectors, inode_u.bi_inum);
+				bch2_trans_do(c, bch2_inum_to_path(trans, inode_inum(inode), &msg.m));
+				prt_newline(&msg.m);
+				bch2_inode_unpacked_to_text(&msg.m, &inode_u);
+				msg.m.suppress = !bch2_count_fsck_err(c, vfs_i_sectors_bad, &msg.m);
+			}
+		}
+	}
+#endif
+	truncate_inode_pages_final(&inode->v.i_data);
+
+	cancel_delayed_work_sync(&inode->ei_writeback_timer);
+
+	clear_inode(&inode->v);
+
+	BUG_ON(!is_bad_inode(&inode->v) && inode->ei_quota_reserved);
+
+	if (delete) {
+		if (!test_bit(EI_INODE_SNAPSHOT, &inode->ei_flags)) {
+			bch2_quota_acct(c, inode->ei_qid, Q_SPC, -((s64) inode->v.i_blocks),
+					KEY_TYPE_QUOTA_WARN);
+			bch2_quota_acct(c, inode->ei_qid, Q_INO, -1,
+					KEY_TYPE_QUOTA_WARN);
+		}
+		bch2_inode_rm(c, inode_inum(inode));
+
+		/*
+		 * If we are deleting, we need it present in the vfs hash table
+		 * so that fsck can check if unlinked inodes are still open:
+		 */
+		bch2_inode_hash_remove(c, inode);
+	}
+
+	fast_list_remove(&c->vfs.inodes, inode->ei_inodes_idx);
+	inode->ei_inodes_idx = 0;
+}
+
+void bch2_evict_subvolume_inodes(struct bch_fs *c, snapshot_id_list *s)
+{
+	/*
+	 * Initially, we scan for inodes without I_DONTCACHE, then mark them to
+	 * be pruned with d_mark_dontcache().
+	 *
+	 * Once we've had a clean pass where we didn't find any inodes without
+	 * I_DONTCACHE, we wait for them to be freed.
+	 *
+	 * fast_list_iter tracks position by integer index, so we can drop rcu
+	 * around the dcache work (held safe by our igrab ref) and resume from
+	 * the same slot on the next iteration.
+	 */
+	rcu_read_lock();
+	struct genradix_iter iter;
+	struct bch_inode_info *inode;
+
+	fast_list_for_each(&c->vfs.inodes, iter, inode) {
+		if (!snapshot_list_has_id(s, inode_inum(inode).subvol))
+			continue;
+
+		if (!(inode_state_read_once(&inode->v) & I_DONTCACHE) &&
+		    igrab(&inode->v)) {
+			rcu_read_unlock();
+
+			d_mark_dontcache(&inode->v);
+			d_prune_aliases(&inode->v);
+			iput(&inode->v);
+
+			rcu_read_lock();
+		}
+	}
+
+	bool found = false;
+	do {
+		found = false;
+
+		fast_list_for_each(&c->vfs.inodes, iter, inode) {
+			if (!snapshot_list_has_id(s, inode_inum(inode).subvol))
+				continue;
+
+			found = true;
+
+			struct wait_bit_queue_entry wqe;
+			struct wait_queue_head *wq_head = inode_bit_waitqueue(&wqe, &inode->v, __I_NEW);
+			prepare_to_wait_event(wq_head, &wqe.wq_entry,
+					      TASK_UNINTERRUPTIBLE);
+			rcu_read_unlock();
+
+			schedule();
+			finish_wait(wq_head, &wqe.wq_entry);
+			rcu_read_lock();
+		}
+	} while (found);
+	rcu_read_unlock();
+}
+
+static struct bch_fs *bch2_path_to_fs(const char *path)
+{
+	struct bch_fs *c;
+	dev_t dev;
+	int ret;
+
+	ret = lookup_bdev(path, &dev);
+	if (ret)
+		return ERR_PTR(ret);
+
+	c = bch2_dev_to_fs(dev);
+	if (c)
+		closure_put(&c->cl);
+	return c ?: ERR_PTR(-ENOENT);
+}
+
+/*
+ * bcachefs doesn't currently integrate intwrite freeze protection but the
+ * internal write references serve the same purpose. Therefore reuse the
+ * read-only transition code to perform the quiesce. The caveat is that we don't
+ * currently have the ability to block tasks that want a write reference while
+ * the superblock is frozen. This is fine for now, but we should either add
+ * blocking support or find a way to integrate sb_start_intwrite() and friends.
+ */
+static int bch2_set_super(struct super_block *s, struct fs_context *fc)
+{
+	s->s_fs_info = fc->s_fs_info;
+	return 0;
+}
+
+static int bch2_noset_super(struct super_block *s, struct fs_context *fc)
+{
+	return -EBUSY;
+}
+
+typedef DARRAY(struct bch_fs *) darray_fs;
+
+static int bch2_test_super(struct super_block *s, struct fs_context *fc)
+{
+	struct bch_fs *c = s->s_fs_info;
+	darray_fs *d = fc->s_fs_info;
+
+	if (!c)
+		return false;
+
+	darray_for_each(*d, i)
+		if (c != *i)
+			return false;
+	return true;
+}
+
+static void set_mount_opts(struct bch_fs *c, struct bch_opts *opts)
+{
+	for (enum bch_opt_id id = 0; id < bch2_opts_nr; id++)
+		if (bch2_opt_defined_by_id(opts, id))
+			set_bit(id, c->mount_opts.d);
+}
+
+static int bch2_fs_get_tree(struct fs_context *fc)
+{
+	struct bch_fs *c;
+	struct super_block *sb;
+	struct inode *vinode;
+	struct bch2_opts_parse *opts_parse = fc->fs_private;
+	struct bch_opts opts = opts_parse->opts;
+	darray_fs devs_to_fs = {};
+	int ret;
+
+	opt_set(opts, read_only, (fc->sb_flags & SB_RDONLY) != 0);
+	opt_set(opts, nostart, true);
+
+	/*
+	 * Accumulated by bch2_fs_parse_param() from however many "source"
+	 * parameters we were given, and owned by opts_parse - so it outlives
+	 * this function and is freed by bch2_fs_context_free().
+	 */
+	if (!opts_parse->devs.nr)
+		return invalf(fc, "no device to mount");
+
+	darray_for_each(opts_parse->devs, i) {
+		ret = darray_push(&devs_to_fs, bch2_path_to_fs(*i));
+		if (ret)
+			goto err;
+	}
+
+	/* sget_fc() passes the payload to the callbacks via fc->s_fs_info, and
+	 * takes the sb flags from fc->sb_flags (no flags argument). */
+	fc->s_fs_info = &devs_to_fs;
+	fc->sb_flags |= SB_NOSEC;
+	sb = sget_fc(fc, bch2_test_super, bch2_noset_super);
+	if (!IS_ERR(sb))
+		goto got_sb;
+
+	c = bch2_fs_open(&opts_parse->devs, &opts,
+			 opts_parse->user_key_set ? &opts_parse->user_key : NULL);
+	ret = PTR_ERR_OR_ZERO(c);
+	if (ret)
+		goto err;
+
+	if (opt_defined(opts, discard))
+		set_bit(BCH_FS_discard_mount_opt_set, &c->flags);
+	set_mount_opts(c, &opts);
+
+	/* Some options can't be parsed until after the fs is started: */
+	opts = bch2_opts_empty();
+	ret = bch2_parse_mount_opts(c, &opts, NULL, opts_parse->parse_later.buf, false);
+	if (ret)
+		goto err_stop_fs;
+
+	bch2_opts_apply(&c->opts, opts);
+	set_mount_opts(c, &opts);
+
+	/*
+	 * Both directions of the status channel are scoped to recovery: c->stdio
+	 * must not outlive the reference bch2_fs_context_free() drops on the file
+	 * it points into, and the channel's filesystem must not outlive @c, which
+	 * the error path below is free to tear down.
+	 *
+	 * stdio_user_only describes that redirect, so it dies with it: an online
+	 * fsck later installs its own c->stdio and expects its log traffic to
+	 * reach it, and nothing else ever clears this.
+	 */
+	struct file *status = opts_parse->status_file;
+
+	if (status)
+		bch2_status_fd_attach(status, c);
+
+	ret = bch2_fs_start(c);
+
+	if (status)
+		bch2_status_fd_detach(status, c);
+
+	if (ret)
+		goto err_stop_fs;
+
+	/*
+	 * We might be doing a RO mount because other options required it, or we
+	 * have no alloc info and it's a small image with no room to regenerate
+	 * it
+	 */
+	if (c->opts.read_only)
+		fc->sb_flags |= SB_RDONLY;
+
+	fc->s_fs_info = c;
+	sb = sget_fc(fc, NULL, bch2_set_super);
+	ret = PTR_ERR_OR_ZERO(sb);
+	if (ret)
+		goto err_stop_fs;
+got_sb:
+	c = sb->s_fs_info;
+
+	if (sb->s_root) {
+		if ((fc->sb_flags ^ sb->s_flags) & SB_RDONLY) {
+			ret = -EBUSY;
+			goto err_put_super;
+		}
+		goto out;
+	}
+
+	sb->s_blocksize		= block_bytes(c);
+	sb->s_blocksize_bits	= ilog2(block_bytes(c));
+	sb->s_maxbytes		= MAX_LFS_FILESIZE;
+	sb->s_op		= &bch2_super_ops;
+	sb->s_export_op		= &bch2_export_ops;
+#ifdef CONFIG_BCACHEFS_QUOTA
+	sb->s_qcop		= &bch2_quotactl_operations;
+	sb->s_quota_types	= QTYPE_MASK_USR|QTYPE_MASK_GRP|QTYPE_MASK_PRJ;
+#endif
+	sb->s_xattr		= bch2_xattr_handlers;
+	sb->s_magic		= BCACHEFS_STATFS_MAGIC;
+	sb->s_time_gran		= c->sb.nsec_per_time_unit;
+	sb->s_time_min		= div_s64(S64_MIN, c->sb.time_units_per_sec) + 1;
+	sb->s_time_max		= div_s64(S64_MAX, c->sb.time_units_per_sec);
+	super_set_uuid(sb, c->sb.user_uuid.b, sizeof(c->sb.user_uuid));
+
+	if (c->sb.multi_device)
+		super_set_sysfs_name_uuid(sb);
+	else
+		strscpy(sb->s_sysfs_name, c->name, sizeof(sb->s_sysfs_name));
+
+	sb->s_shrink->seeks	= 0;
+	c->vfs_sb		= sb;
+	strscpy(sb->s_id, c->name, sizeof(sb->s_id));
+
+	ret = super_setup_bdi(sb);
+	if (ret)
+		goto err_put_super;
+
+	sb->s_bdi->ra_pages = bch2_fs_ra_pages(c);
+
+	scoped_guard(rcu) {
+		for_each_online_member_rcu(c, ca) {
+			struct block_device *bdev = ca->disk_sb.bdev;
+
+			/* XXX: create an anonymous device for multi device filesystems */
+			sb->s_bdev	= bdev;
+			sb->s_dev	= bdev->bd_dev;
+			break;
+		}
+	}
+
+	c->dev = sb->s_dev;
+
+	if (c->opts.acl)
+		sb->s_flags	|= SB_POSIXACL;
+
+	sb->s_shrink->seeks = 0;
+
+#if IS_ENABLED(CONFIG_UNICODE)
+	if (!bch2_fs_casefold_enabled(c))
+		sb->s_encoding = c->cf_encoding;
+	/*
+	 * Avoid generic_set_sb_d_ops()'s generic_ci_dentry_ops default:
+	 * directory dentries that need casefold support get utf8 ops installed
+	 * when their inode is attached (see bch2_dentry_set_casefold_ops),
+	 * keeping DCACHE_OP_COMPARE clear on non-casefolded directories.
+	 */
+#endif
+
+	vinode = bch2_vfs_inode_get(c, BCACHEFS_ROOT_SUBVOL_INUM, __func__);
+	ret = PTR_ERR_OR_ZERO(vinode);
+	bch_err_msg(c, ret, "mounting: error getting root inode");
+	if (ret)
+		goto err_put_super;
+
+	sb->s_root = d_make_root(vinode);
+	if (!sb->s_root) {
+		bch_err(c, "error mounting: error allocating root dentry");
+		ret = -ENOMEM;
+		goto err_put_super;
+	}
+
+#if IS_ENABLED(CONFIG_UNICODE)
+	/* Root has no attach site of its own; set its ops from its own inode. */
+	bch2_dentry_set_casefold_ops(sb->s_root, d_inode(sb->s_root));
+#endif
+
+	sb->s_flags |= SB_ACTIVE;
+out:
+	fc->root = dget(sb->s_root);
+err:
+	darray_exit(&devs_to_fs);
+	/*
+	 * errorfc() rather than pr_err() because logfc() falls back to printk
+	 * when there's no fs_context log, so a mount(2) caller still gets this
+	 * in dmesg, and an fsconfig(2) one gets it on the terminal.
+	 */
+	if (ret)
+		errorfc(fc, "%s", bch2_err_str(ret));
+	/*
+	 * On an inconsistency error in recovery we might see an -EROFS derived
+	 * errorcode (from the journal), but we don't want to return that to
+	 * userspace as that causes util-linux to retry the mount RO - which is
+	 * confusing:
+	 */
+	if (bch2_err_matches(ret, EROFS) && ret != -EROFS)
+		ret = -EIO;
+	/*
+	 * Deliberately not bch2_err_class(): mount.bcachefs has to tell our
+	 * errors apart to know what to do about them - whether to put the
+	 * degraded question to the user, whether a refusal is worth escalating.
+	 * Flattening device_splitbrain and insufficient_devices_to_start both to
+	 * EINVAL leaves it nothing to go on but the log text, and prose is not an
+	 * interface.
+	 *
+	 * Safe as a syscall return: an errcode is BCH_ERR_START (2048) plus a
+	 * number pinned in the errcode x-macro, and the largest is far below
+	 * MAX_ERRNO, so IS_ERR_VALUE() still reads it as an error. A caller that
+	 * doesn't know bcachefs gets an unrecognised errno instead of a
+	 * plausible wrong one - which is also why the EROFS remap above stays:
+	 * that is a case where a caller does act on the errno.
+	 */
+	return ret;
+
+err_stop_fs:
+	bch2_fs_exit(c);
+	goto err;
+
+err_put_super:
+	if (!sb->s_root)
+		bch2_fs_stop(c);
+	deactivate_locked_super(sb);
+	goto err;
+}
+
+static void bch2_kill_sb(struct super_block *sb)
+{
+	struct bch_fs *c = sb->s_fs_info;
+
+	generic_shutdown_super(sb);
+	bch2_fs_exit(c);
+}
+
+static void bch2_fs_context_free(struct fs_context *fc)
+{
+	struct bch2_opts_parse *opts = fc->fs_private;
+
+	if (opts) {
+		printbuf_exit(&opts->parse_later);
+		darray_exit_free_item(&opts->devs, kfree);
+		if (opts->status_file)
+			bch2_status_fd_put(opts->status_file);
+
+		memzero_explicit(&opts->user_key, sizeof(opts->user_key));
+		kfree(opts);
+	}
+}
+
+/*
+ * Keep fc->source in step with the devices we've been given: taking the
+ * "source" parameter ourselves means vfs_parse_fs_param_source() never runs,
+ * and fc->source is what /proc/mounts and mountinfo display. It has to end up
+ * looking like what a single colon-separated source would have produced. No
+ * length limit applies here - fsconfig(2)'s 256-byte cap is on what it will
+ * copy in from userspace, not on what we assemble.
+ */
+static int bch2_fc_source_append(struct fs_context *fc, const char *s)
+{
+	char *new = fc->source
+		? kasprintf(GFP_KERNEL, "%s:%s", fc->source, s)
+		: kstrdup(s, GFP_KERNEL);
+	if (!new)
+		return -ENOMEM;
+
+	kfree(fc->source);
+	fc->source = new;
+	return 0;
+}
+
+static int bch2_fs_parse_param(struct fs_context *fc,
+			       struct fs_parameter *param)
+{
+	struct bch2_opts_parse *opts = fc->fs_private;
+	struct bch_fs *c = NULL;
+
+	/*
+	 * struct fs_parameter keeps its value in a union and @type says which
+	 * member is live, but nothing between fsconfig(2) and here checks that
+	 * the two agree - filesystems that go through fs_parse() have it done
+	 * against their parameter spec, and we parse by hand. So settle it once,
+	 * for every parameter below: a value we can read as a string, or a flag
+	 * with no value at all. The rest put a struct filename or a struct file
+	 * in that same member, and reading one of those as a string means
+	 * strlen() over an object that has no reason to contain a NUL.
+	 */
+	switch (param->type) {
+	case fs_value_is_string:
+	case fs_value_is_flag:
+		break;
+	default:
+		return invalf(fc, "%s: expected a string value", param->key);
+	}
+
+	/*
+	 * The devices to mount. We take this rather than leaving it to the VFS
+	 * because fsconfig(2) copies a parameter value with
+	 * strndup_user(_value, 256): a long device list can't be passed as one
+	 * string, so userspace hands them over a few at a time - and
+	 * vfs_parse_fs_param_source() refuses the second one ("Multiple
+	 * sources").
+	 *
+	 * Legacy mount(2) lands here too, via vfs_parse_fs_string(fc, "source",
+	 * name), as a single colon-separated value. Splitting each parameter
+	 * and appending covers both without a second path.
+	 */
+	if (!strcmp(param->key, "source")) {
+		/*
+		 * -EINVAL is an empty device name and nothing else; -ENOMEM is
+		 * the only other failure. Naming it here rather than in
+		 * bch2_split_devs() is the point of taking this parameter at
+		 * all - the value that was wrong is in front of us, and it
+		 * reaches the user through the fs_context log.
+		 */
+		int ret = bch2_split_devs(param->string, &opts->devs);
+		if (ret)
+			return ret == -EINVAL
+				? invalf(fc, "empty device name in source \"%s\"",
+					 param->string)
+				: ret;
+
+		return bch2_fc_source_append(fc, param->string);
+	}
+
+	/*
+	 * Not a mount option: mount.bcachefs's channel to the filesystem coming
+	 * up. The fd number goes back as this fsconfig(2) call's return value,
+	 * which reaches userspace untouched - vfs_parse_fs_param() returns
+	 * anything that isn't -ENOPARAM verbatim, and so does
+	 * vfs_fsconfig_locked().
+	 */
+	if (!strcmp(param->key, "status_fd")) {
+		if (opts->status_file)
+			return invalf(fc, "status_fd requested twice");
+
+		return bch2_status_fd_open(&opts->status_file);
+	}
+
+	/*
+	 * The passphrase-derived key that unwraps the superblock's, for callers
+	 * that already have it. A parameter and not a mount option because
+	 * fsconfig(2) copies it out of our address space: it never reaches
+	 * anyone's ps output the way an -o would.
+	 */
+	if (!strcmp(param->key, "user_key")) {
+		if (!param->string)
+			return invalf(fc, "user_key: no key given");
+
+		size_t len = strlen(param->string);
+		int ret = len == sizeof(opts->user_key) * 2
+			? hex2bin((u8 *) &opts->user_key, param->string,
+				  sizeof(opts->user_key))
+			: -EINVAL;
+
+		/* the VFS frees this with kfree(), not kfree_sensitive() */
+		memzero_explicit(param->string, len);
+
+		if (ret) {
+			memzero_explicit(&opts->user_key, sizeof(opts->user_key));
+			return invalf(fc, "user_key: expected %zu hex digits",
+				      sizeof(opts->user_key) * 2);
+		}
+
+		opts->user_key_set = true;
+		return 0;
+	}
+
+	/* for reconfigure, we already have a struct bch_fs */
+	if (fc->root)
+		c = fc->root->d_sb->s_fs_info;
+
+	CLASS(printbuf, err)();
+	int ret = bch2_parse_one_mount_opt(c, &opts->opts,
+					   &opts->parse_later, param->key,
+					   param->string,
+					   &err);
+	/*
+	 * @err only describes a bad value; the refusals bch2_parse_one_mount_opt()
+	 * returns directly (not a mount option, quota without
+	 * CONFIG_BCACHEFS_QUOTA) leave it empty, which is why this used to print
+	 * a bare "Error parsing option ".
+	 */
+	if (ret)
+		errorfc(fc, "option %s: %s", param->key,
+			err.pos ? err.buf : bch2_err_str(ret));
+
+	return bch2_err_class(ret);
+}
+
+static int bch2_fs_reconfigure(struct fs_context *fc)
+{
+	struct super_block *sb = fc->root->d_sb;
+	struct bch2_opts_parse *opts = fc->fs_private;
+	struct bch_fs *c = sb->s_fs_info;
+	int ret = 0;
+
+	opt_set(opts->opts, read_only, (fc->sb_flags & SB_RDONLY) != 0);
+
+	bch2_reconcile_wakeup(c);
+
+	/*
+	 * If we went read-only without being asked to, we hit an error and went
+	 * emergency read-only, and there's no coming back from that in this
+	 * mount.
+	 *
+	 * Test what was asked for - fc->sb_flags - and not c->opts.read_only:
+	 * emergency ro stops the filesystem without rewriting the mount option,
+	 * so c->opts.read_only still says read-write and the comparison below
+	 * finds nothing to do, reporting success while leaving the filesystem
+	 * read-only.
+	 */
+	if (!(fc->sb_flags & SB_RDONLY) &&
+	    test_bit(BCH_FS_emergency_ro, &c->flags)) {
+		errorfc(fc, "cannot go read-write: filesystem is in emergency read-only");
+		return bch_err_throw(c, emergency_ro);
+	}
+
+	if (opts->opts.read_only != c->opts.read_only) {
+		guard(rwsem_write)(&c->state_lock);
+
+		if (opts->opts.read_only) {
+			try(sync_filesystem(sb));
+
+			bch2_fs_read_only(c);
+
+			sb->s_flags |= SB_RDONLY;
+		} else {
+			/* __bch2_fs_read_write() gates reconcile on this: */
+			c->opts.read_only = false;
+
+			ret = bch2_fs_read_write(c);
+			if (ret) {
+				c->opts.read_only = true;
+				/* bch_err() says which filesystem, errorfc() reaches
+				 * the caller; the throw below discards the errcode. */
+				bch_err(c, "error going read-write: %s", bch2_err_str(ret));
+				errorfc(fc, "error going read-write: %s", bch2_err_str(ret));
+				return bch_err_throw(c, EINVAL_reconfigure_read_write);
+			}
+
+			sb->s_flags &= ~SB_RDONLY;
+		}
+
+		c->opts.read_only = opts->opts.read_only;
+	}
+
+	if (opt_defined(opts->opts, errors))
+		c->opts.errors = opts->opts.errors;
+
+	return bch2_err_class(ret);
+}
+
+static const struct fs_context_operations bch2_context_ops = {
+	.free        = bch2_fs_context_free,
+	.parse_param = bch2_fs_parse_param,
+	.get_tree    = bch2_fs_get_tree,
+	.reconfigure = bch2_fs_reconfigure,
+};
+
+static int bch2_init_fs_context(struct fs_context *fc)
+{
+	struct bch2_opts_parse *opts = kzalloc(sizeof(*opts), GFP_KERNEL);
+
+	if (!opts)
+		return -ENOMEM;
+
+	opts->parse_later = PRINTBUF;
+
+	fc->ops = &bch2_context_ops;
+	fc->fs_private = opts;
+
+	return 0;
+}
+
+void bch2_fs_vfs_exit(struct bch_fs *c)
+{
+	bioset_exit(&c->vfs.dio_write_bioset);
+	bioset_exit(&c->vfs.dio_read_bioset);
+	bioset_exit(&c->vfs.writepage_bioset);
+	bioset_exit(&c->vfs.nocow_flush_bioset);
+	mempool_exit(&c->vfs.writepage_buf_pool);
+
+	if (c->vfs.writeback_wq)
+		destroy_workqueue(c->vfs.writeback_wq);
+	if (c->vfs.inodes_by_inum_table.ht.tbl)
+		rhltable_destroy(&c->vfs.inodes_by_inum_table);
+	if (c->vfs.inodes_table.tbl)
+		rhashtable_destroy(&c->vfs.inodes_table);
+	fast_list_exit(&c->vfs.inodes);
+}
+
+int bch2_fs_vfs_init(struct bch_fs *c)
+{
+	fdm_init(&c->fdm_table);
+	try(fast_list_init(&c->vfs.inodes));
+
+	try(rhashtable_init(&c->vfs.inodes_table, &bch2_vfs_inodes_params));
+	try(rhltable_init(&c->vfs.inodes_by_inum_table, &bch2_vfs_inodes_by_inum_params));
+
+	if (bioset_init(&c->vfs.dio_read_bioset,
+			4, offsetof(struct dio_read, rbio.bio),
+			BIOSET_NEED_BVECS))
+		return bch_err_throw(c, ENOMEM_dio_read_bioset_init);
+
+	return 0;
+}
+
+int bch2_fs_vfs_init_rw(struct bch_fs *c)
+{
+	if (bioset_init(&c->vfs.writepage_bioset,
+			4, offsetof(struct bch_writepage_io, op.wbio.bio),
+			BIOSET_NEED_BVECS))
+		return bch_err_throw(c, ENOMEM_writepage_bioset_init);
+
+	if (mempool_init_kvmalloc_pool(&c->vfs.writepage_buf_pool, 4,
+				       BCH_WRITEPAGE_BUF_BYTES))
+		return bch_err_throw(c, ENOMEM_writepage_buf_pool_init);
+
+	if (bioset_init(&c->vfs.dio_write_bioset,
+			4, offsetof(struct dio_write, op.wbio.bio),
+			BIOSET_NEED_BVECS))
+		return bch_err_throw(c, ENOMEM_dio_write_bioset_init);
+
+	if (bioset_init(&c->vfs.nocow_flush_bioset,
+			1, offsetof(struct nocow_flush, bio), 0))
+		return bch_err_throw(c, ENOMEM_nocow_flush_bioset_init);
+
+	c->vfs.writeback_wq = alloc_workqueue("bcachefs_vfs_writeback",
+					      WQ_MEM_RECLAIM|WQ_FREEZABLE|WQ_UNBOUND, 1);
+	if (!c->vfs.writeback_wq)
+		return bch_err_throw(c, ENOMEM_fs_other_alloc);
+
+	return 0;
+}
+
+static struct file_system_type bcache_fs_type = {
+	.owner			= THIS_MODULE,
+	.name			= "bcachefs",
+	.init_fs_context	= bch2_init_fs_context,
+	.kill_sb		= bch2_kill_sb,
+	.fs_flags		= FS_REQUIRES_DEV | FS_ALLOW_IDMAP | FS_LBS,
+};
+
+MODULE_ALIAS_FS("bcachefs");
+
+void bch2_vfs_exit(void)
+{
+	unregister_filesystem(&bcache_fs_type);
+	kmem_cache_destroy(bch2_inode_cache);
+}
+
+int __init bch2_vfs_init(void)
+{
+	int ret = -ENOMEM;
+
+	bch2_inode_cache = KMEM_CACHE(bch_inode_info, SLAB_RECLAIM_ACCOUNT |
+				      SLAB_ACCOUNT);
+	if (!bch2_inode_cache)
+		goto err;
+
+	ret = register_filesystem(&bcache_fs_type);
+	if (ret)
+		goto err;
+
+	return 0;
+err:
+	bch2_vfs_exit();
+	return ret;
+}
+
+#endif /* NO_BCACHEFS_FS */
diff --git a/fs/bcachefs/vfs/fs.h b/fs/bcachefs/vfs/fs.h
new file mode 100644
index 0000000..9f508f3
--- /dev/null
+++ b/fs/bcachefs/vfs/fs.h
@@ -0,0 +1,166 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_FS_H
+#define _BCACHEFS_FS_H
+
+#include "fs/inode.h"
+#include "fs/str_hash.h"
+#include "fs/quota_gen.h"
+
+#include "util/two_state_shared_lock.h"
+#include "vfs/types_gen.h"
+
+#include <linux/seqlock.h>
+#include <linux/stat.h>
+#include <linux/version.h>
+
+#if !defined(__KERNEL__) || LINUX_VERSION_CODE < KERNEL_VERSION(6,19,0)
+static inline unsigned inode_state_read(struct inode *inode)
+{
+	return inode->i_state;
+}
+
+static inline unsigned inode_state_read_once(struct inode *inode)
+{
+	return READ_ONCE(inode->i_state);
+}
+
+static inline void inode_state_set_raw(struct inode *inode, unsigned flags)
+{
+	WRITE_ONCE(inode->i_state, inode->i_state|flags);
+}
+#endif
+
+/* fileattr's struct, before 6.17: the Rust names it file_kattr too */
+#if defined(__KERNEL__) && LINUX_VERSION_CODE < KERNEL_VERSION(6,17,0)
+#define file_kattr fileattr
+#endif
+
+#include "vfs/fs_gen.h"
+
+#define bch2_pagecache_add_put(i)	bch2_two_state_unlock(&(i)->ei_pagecache_lock, 0)
+#define bch2_pagecache_add_tryget(i)	bch2_two_state_trylock(&(i)->ei_pagecache_lock, 0)
+#define bch2_pagecache_add_get(i)	bch2_two_state_lock(&(i)->ei_pagecache_lock, 0)
+
+#define bch2_pagecache_block_put(i)	bch2_two_state_unlock(&(i)->ei_pagecache_lock, 1)
+#define bch2_pagecache_block_get(i)	bch2_two_state_lock(&(i)->ei_pagecache_lock, 1)
+
+DEFINE_GUARD(bch2_pagecache_add, struct bch_inode_info *,
+	     bch2_pagecache_add_get(_T),
+	     bch2_pagecache_add_put(_T));
+
+DEFINE_GUARD(bch2_pagecache_block, struct bch_inode_info *,
+	     bch2_pagecache_block_get(_T),
+	     bch2_pagecache_block_put(_T));
+
+static inline subvol_inum inode_inum(const struct bch_inode_info *inode)
+{
+	return inode->ei_inum_hash.inum;
+}
+
+#define to_bch_ei(_inode)					\
+	container_of_or_null(_inode, struct bch_inode_info, v)
+
+static inline int ptrcmp(void *l, void *r)
+{
+	return cmp_int(l, r);
+}
+
+#define bch2_lock_inodes(_locks, ...)					\
+do {									\
+	struct bch_inode_info *a[] = { NULL, __VA_ARGS__ };		\
+	unsigned i;							\
+									\
+	bubble_sort(&a[1], ARRAY_SIZE(a) - 1, ptrcmp);			\
+									\
+	for (i = 1; i < ARRAY_SIZE(a); i++)				\
+		if (a[i] != a[i - 1]) {					\
+			if ((_locks) & INODE_PAGECACHE_BLOCK)		\
+				bch2_pagecache_block_get(a[i]);\
+			if ((_locks) & INODE_UPDATE_LOCK)			\
+				mutex_lock_nested(&a[i]->ei_update_lock, i);\
+		}							\
+} while (0)
+
+#define bch2_unlock_inodes(_locks, ...)					\
+do {									\
+	struct bch_inode_info *a[] = { NULL, __VA_ARGS__ };		\
+	unsigned i;							\
+									\
+	bubble_sort(&a[1], ARRAY_SIZE(a) - 1, ptrcmp);			\
+									\
+	for (i = 1; i < ARRAY_SIZE(a); i++)				\
+		if (a[i] != a[i - 1]) {					\
+			if ((_locks) & INODE_PAGECACHE_BLOCK)		\
+				bch2_pagecache_block_put(a[i]);\
+			if ((_locks) & INODE_UPDATE_LOCK)			\
+				mutex_unlock(&a[i]->ei_update_lock);	\
+		}							\
+} while (0)
+
+static inline struct bch_inode_info *file_bch_inode(struct file *file)
+{
+	return to_bch_ei(file_inode(file));
+}
+
+#ifndef NO_BCACHEFS_FS
+
+struct bch_inode_info *
+__bch2_create(struct mnt_idmap *, struct bch_inode_info *,
+	      struct dentry *, umode_t, dev_t, subvol_inum, unsigned);
+
+#include "vfs/attr_gen.h"
+#include "vfs/dentry_gen.h"
+#include "vfs/dir_gen.h"
+#include "vfs/file_gen.h"
+#include "vfs/export_gen.h"
+#include "vfs/inode_gen.h"
+#include "vfs/inode_ops_gen.h"
+#include "vfs/namei_gen.h"
+#include "vfs/super_block_gen.h"
+
+struct bch_inode_info *bch2_vfs_inode_get_trans(struct btree_trans *, subvol_inum, const char *);
+
+/* For Rust's lookup, until the inode cache is Rust: */
+struct bch_inode_info *bch2_inode_hash_find(struct bch_fs *, struct btree_trans *, subvol_inum);
+struct bch_inode_info *bch2_inode_hash_init_insert(struct btree_trans *, subvol_inum,
+						   struct bch_inode_unpacked *,
+						   struct bch_subvolume *);
+struct inode *bch2_vfs_inode_get(struct bch_fs *, subvol_inum, const char *);
+
+/* For Rust's super ops, until the inode cache is Rust: */
+void bch2_evict_inode(struct inode *);
+void bch2_free_inode(struct inode *);
+
+void bch2_fs_vfs_exit(struct bch_fs *);
+int bch2_fs_vfs_init(struct bch_fs *);
+int bch2_fs_vfs_init_rw(struct bch_fs *);
+
+void bch2_vfs_exit(void);
+int bch2_vfs_init(void);
+
+static inline void bch2_dirty_inode(struct bch_fs *c, struct bch_inode_info *inode)
+{
+	if (c->opts.writeback_timeout)
+		queue_delayed_work(c->vfs.writeback_wq, &inode->ei_writeback_timer,
+				   c->opts.writeback_timeout * HZ);
+}
+
+#else
+
+#define bch2_inode_update_after_write(_trans, _inode, _inode_u, _fields)	({ do {} while (0); })
+
+static inline int bch2_inode_or_descendents_is_open(struct btree_trans *trans, struct bpos p) { return 0; }
+
+static inline void bch2_evict_subvolume_inodes(struct bch_fs *c,
+					       snapshot_id_list *s) {}
+
+static inline void bch2_fs_vfs_exit(struct bch_fs *c) {}
+static inline int bch2_fs_vfs_init(struct bch_fs *c) { return 0; }
+static inline int bch2_fs_vfs_init_rw(struct bch_fs *c) { return 0; }
+
+static inline void bch2_vfs_exit(void) {}
+static inline int bch2_vfs_init(void) { return 0; }
+
+#endif /* NO_BCACHEFS_FS */
+
+#endif /* _BCACHEFS_FS_H */
diff --git a/fs/bcachefs/vfs/fs_types.rs b/fs/bcachefs/vfs/fs_types.rs
new file mode 100644
index 0000000..734a9ae
--- /dev/null
+++ b/fs/bcachefs/vfs/fs_types.rs
@@ -0,0 +1,155 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::locking::Lock;
+use crate::types::c_default;
+use crate::util::bitmap::AtomicULong;
+use crate::vfs::vfs_inode::VfsInode;
+use core::ffi::{c_uint, c_ulong};
+#[cfg(not(NO_BCACHEFS_FS))]
+use core::ffi::{c_int, c_void};
+use cstruct_macros::{c_enum, CStruct, TypeInfo};
+#[cfg(not(NO_BCACHEFS_FS))]
+use cstruct_macros::{c_extern, c_typedef};
+
+/*
+ * The VFS's inode, and what we keep beside it. Shared - the kernel and C use it
+ * while Rust has a &InodeInfo - so what Rust touches is typed for that: @v,
+ * the struct inode the kernel writes, a VfsInode; ei_inode a
+ * VolatileInodeUnpacked; ei_update_lock C's mutex, borrowed as a Lock;
+ * ei_quota_lock a Lock over what it protects.
+ */
+#[repr(C)]
+#[derive(CStruct, TypeInfo)]
+#[c_name(bch_inode_info)]
+pub struct InodeInfo {
+    #[c("struct inode v")]
+    pub v: VfsInode,
+    pub hash: c::rhash_head,
+    /*
+     * Read it with inode_inum(); the layout is private so that
+     * bch2_inode_or_descendents_is_open() can walk entries without knowing
+     * about bch_inode_info at all.
+     */
+    pub ei_inum_hash: c::bch_inum_hash_entry,
+
+    /*
+     * Cached extent allocation state for [start, end), for skipping btree
+     * lookups when initializing bch_folio state in sequential buffered
+     * writes.
+     *
+     * Staleness contract: extents may change toward allocated without
+     * notice (worst case we over-reserve); anything that deallocates must
+     * clear the range, under pagecache_block so no fill (under
+     * pagecache_add) can straddle the deallocation. Fillers build their
+     * result in locals and publish it in one go: fillers aren't
+     * serialized against each other (page_mkwrite fills without i_rwsem),
+     * and incremental publishing would let two fills interleave into a
+     * range neither of them scanned.
+     */
+    pub ei_reserved_start: u64,
+    pub ei_reserved_end: u64,
+    pub ei_reserved_replicas: u8,
+    pub ei_reserved_state: u8,
+    pub ei_reserved_lock: c::spinlock_t,
+
+    pub ei_inodes_idx: c_uint,
+    /// bch_inode_info_flags, by bit: C's set_bit() and test_bit()'s, so atomic
+    pub ei_flags: AtomicULong,
+
+    pub ei_update_lock: c::mutex,
+    pub ei_last_dirtied: c_ulong,
+    pub ei_pagecache_lock: c::two_state_lock_t,
+
+    /*
+     * The quota the inode's usage is charged to: i_blocks + ei_quota_reserved
+     * is charged to ei_qid. i_blocks, the VFS inode's, changes under the lock
+     * too. ei_qid changes with ei_update_lock held as well, so C reads it
+     * under either.
+     */
+    #[c_lock("struct mutex ei_quota_lock")]
+    pub ei_quota: Lock<c::mutex, InodeQuota>,
+
+    /*
+     * When we've been doing nocow writes we'll need to issue flushes to the
+     * underlying block devices
+     *
+     * XXX: a device may have had a flush issued by some other codepath. It
+     * would be better to keep for each device a sequence number that's
+     * incremented when we isusue a cache flush, and track here the sequence
+     * number that needs flushing.
+     */
+    pub ei_devs_need_flush: c::bch_devs_mask,
+
+    /*
+     * copy of inode in btree: written after a commit, the inode's btree
+     * position still locked - which serializes its writers, not
+     * ei_update_lock - and read without a lock
+     */
+    #[c("struct bch_inode_unpacked ei_inode")]
+    pub ei_inode: c::VolatileInodeUnpacked,
+
+    pub ei_writeback_timer: c::delayed_work,
+}
+c_default!(InodeInfo);
+
+/// C's name, as FFI declarations spell it.
+pub type bch_inode_info = InodeInfo;
+
+c_enum! {
+    #[closed]
+    pub enum bch_inode_info_flags: u32 {
+        /*
+         * A btree error on this inode: the VFS inode and the btree's may
+         * disagree
+         */
+        EI_INODE_ERROR = 0,
+        /* in a snapshot subvolume, which quotas don't count */
+        EI_INODE_SNAPSHOT = 1,
+        /*
+         * in the inode cache: tested by a lookup and cleared by removal under
+         * i_lock; set before the insert, and cleared if it loses the race,
+         * while the inode is ours alone
+         */
+        EI_INODE_HASHED = 2,
+        /*
+         * set by a truncate of a nonempty file to 0: start writeback on
+         * close - see DOC(replace-in-place) in vfs/file.rs
+         */
+        EI_INODE_FLUSH_ON_CLOSE = 3,
+    }
+}
+
+/// An inode's quota accounting, under ei_quota_lock.
+#[repr(C)]
+#[derive(CStruct, TypeInfo)]
+pub struct InodeQuota {
+    pub ei_qid: c::bch_qid,
+    /// sectors reserved for writes, charged to ei_qid ahead of i_blocks
+    pub ei_quota_reserved: u64,
+}
+
+c_enum! {
+    #[flags]
+    pub enum bch_inode_lock_op: u32 {
+        INODE_PAGECACHE_BLOCK = 1 << 0,
+        INODE_UPDATE_LOCK = 1 << 1,
+    }
+}
+
+/* returns 0 if we want to do the update, or error is passed up */
+#[cfg(not(NO_BCACHEFS_FS))]
+c_typedef! {
+    pub type inode_set_fn = Option<unsafe extern "C" fn(*mut c::btree_trans,
+                                                        *mut c::bch_inode_info,
+                                                        *mut c::bch_inode_unpacked, *mut c_void)
+                                                        -> c_int>;
+}
+
+#[cfg(not(NO_BCACHEFS_FS))]
+c_extern! {
+    pub fn bch2_inode_or_descendents_is_open(trans: *mut c::btree_trans, pos: c::bpos) -> c_int;
+    pub fn bch2_evict_subvolume_inodes(c: *mut c::bch_fs, s: *mut c::snapshot_id_list);
+}
diff --git a/fs/bcachefs/vfs/iattr.rs b/fs/bcachefs/vfs/iattr.rs
new file mode 100644
index 0000000..ebd5c40
--- /dev/null
+++ b/fs/bcachefs/vfs/iattr.rs
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! The VFS's struct iattr, for Rust: what a setattr asks to change, each
+//! field Some where ia_valid has its ATTR_* bit.
+
+use crate::c;
+
+use super::inode::{ATTR_ATIME, ATTR_CTIME, ATTR_GID, ATTR_MODE, ATTR_MTIME, ATTR_SIZE, ATTR_UID};
+
+#[repr(transparent)]
+pub struct Iattr(c::iattr);
+
+/// The fields that are plain values: name, type = its ATTR_*, the field.
+macro_rules! fields {
+    ($($name:ident: $t:ty = $attr:ident, $field:ident;)*) => {$(
+        pub fn $name(&self) -> Option<$t> {
+            self.has($attr).then_some(self.0.$field)
+        }
+    )*};
+}
+
+impl Iattr {
+    pub fn of(attr: &c::iattr) -> &Self {
+        // SAFETY: repr(transparent)
+        unsafe { &*core::ptr::from_ref(attr).cast() }
+    }
+
+    /// ia_valid: the ATTR_* to change.
+    pub fn valid(&self) -> u32 {
+        self.0.ia_valid
+    }
+
+    fn has(&self, attr: u32) -> bool {
+        self.valid() & attr != 0
+    }
+
+    pub fn vfsuid(&self) -> Option<c::vfsuid_t> {
+        // SAFETY: either arm of the union is an id, any value of which is one
+        self.has(ATTR_UID).then(|| unsafe { *self.0.__bindgen_anon_1.ia_vfsuid.as_ref() })
+    }
+
+    pub fn vfsgid(&self) -> Option<c::vfsgid_t> {
+        // SAFETY: as vfsuid()
+        self.has(ATTR_GID).then(|| unsafe { *self.0.__bindgen_anon_2.ia_vfsgid.as_ref() })
+    }
+
+    fields! {
+        mode:  c::umode_t    = ATTR_MODE,  ia_mode;
+        size:  i64           = ATTR_SIZE,  ia_size;
+        atime: c::timespec64 = ATTR_ATIME, ia_atime;
+        mtime: c::timespec64 = ATTR_MTIME, ia_mtime;
+        ctime: c::timespec64 = ATTR_CTIME, ia_ctime;
+    }
+}
diff --git a/fs/bcachefs/vfs/idmap.rs b/fs/bcachefs/vfs/idmap.rs
new file mode 100644
index 0000000..ff33bfd
--- /dev/null
+++ b/fs/bcachefs/vfs/idmap.rs
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A mount's idmap, which maps the ids its users see to the filesystem's:
+//! ownership and permission are as it maps the inode's ids.
+//!
+//! An id comes two ways: as the mount's users see it - vfsuid_t and
+//! vfsgid_t, an iattr's - and as the inode's filesystem has it, kuid_t and
+//! kgid_t. kuid() and kgid() take the first to the second.
+
+use core::ffi::c_int;
+use core::marker::PhantomData;
+use core::mem::ManuallyDrop;
+use core::ptr::read_volatile;
+
+use crate::acl::PosixAcl;
+use crate::c;
+use crate::errcode::{ret_to_result_void as ret_to_result, BchError};
+use crate::util::file::File;
+use crate::vfs::vfs_inode::VfsInode;
+
+/// The idmap of a mount, for 'f: the file opened through it is borrowed - an
+/// open file pins its mount - or the VFS call it was passed to runs.
+#[derive(Clone, Copy)]
+pub struct MntIdmap<'f>(*mut c::mnt_idmap, PhantomData<&'f c::mnt_idmap>);
+
+impl<'f> MntIdmap<'f> {
+    /// # Safety
+    /// @idmap is the mount's, live for 'f.
+    pub unsafe fn borrow_raw(idmap: *mut c::mnt_idmap) -> Self {
+        MntIdmap(idmap, PhantomData)
+    }
+
+    pub fn of(file: &'f File) -> Self {
+        let file = file.as_ptr();
+        // SAFETY: an open file's mount. READ_ONCE(), as mnt_idmap(): the
+        // idmap is published by do_idmap_mount()'s smp_store_release()
+        let idmap = unsafe {
+            // 6.18 made f_path a const union member, __f_path its writable alias
+            #[cfg(linux_ge = "6.18")]
+            let mnt = (*file).__bindgen_anon_1.f_path.mnt;
+            #[cfg(not(linux_ge = "6.18"))]
+            let mnt = (*file).f_path.mnt;
+            read_volatile(&raw const (*mnt).mnt_idmap)
+        };
+        MntIdmap(idmap, PhantomData)
+    }
+
+    pub fn as_ptr(self) -> *mut c::mnt_idmap {
+        self.0
+    }
+
+    pub fn owner_or_capable(self, inode: &VfsInode) -> bool {
+        unsafe { c::inode_owner_or_capable(self.0, inode.as_ptr()) }
+    }
+
+    /// Whether the caller has @mask - MAY_* - on @inode, by the whole VFS
+    /// stack: ACLs and LSMs too.
+    pub fn permission(self, inode: &VfsInode, mask: u32) -> Result<(), BchError> {
+        ret_to_result(unsafe { c::inode_permission(self.0, inode.as_ptr(), mask as c_int) })
+    }
+
+    /// @inode's owner as the mount's users see it, as stat(2) has it: a
+    /// vfsuid_t and vfsgid_t, in the kuid_t and kgid_t they're carried as.
+    pub fn owner(self, inode: &VfsInode) -> (c::kuid_t, c::kgid_t) {
+        let uid = unsafe { c::make_vfsuid(self.0, inode.user_ns(), inode.kuid()) };
+        let gid = unsafe { c::make_vfsgid(self.0, inode.user_ns(), inode.kgid()) };
+        (c::kuid_t { val: uid.val }, c::kgid_t { val: gid.val })
+    }
+
+    pub fn kuid(self, inode: &VfsInode, vfsuid: c::vfsuid_t) -> c::kuid_t {
+        unsafe { c::from_vfsuid(self.0, inode.user_ns(), vfsuid) }
+    }
+
+    pub fn kgid(self, inode: &VfsInode, vfsgid: c::vfsgid_t) -> c::kgid_t {
+        unsafe { c::from_vfsgid(self.0, inode.user_ns(), vfsgid) }
+    }
+
+    /// The mode @inode takes with @acl as its access ACL, into @mode: the
+    /// ACL's permissions, and setgid as setattr_copy() keeps it - and @acl
+    /// None if the mode says all it would.
+    pub fn acl_update_mode(self, inode: &VfsInode, mode: &mut c::umode_t,
+                                  acl: &mut Option<ManuallyDrop<PosixAcl>>) -> Result<(), BchError> {
+        let mut raw = acl.as_deref().map_or(core::ptr::null_mut(), PosixAcl::as_raw);
+        ret_to_result(unsafe { c::posix_acl_update_mode(self.0, inode.as_ptr(), mode, &mut raw) })?;
+        if raw.is_null() {
+            *acl = None;
+        }
+        Ok(())
+    }
+
+    pub fn in_group_or_capable(self, inode: &VfsInode, gid: c::kgid_t) -> bool {
+        unsafe {
+            c::in_group_or_capable(self.0, inode.as_ptr(), c::make_vfsgid(self.0, inode.user_ns(), gid))
+        }
+    }
+}
diff --git a/fs/bcachefs/vfs/inode.rs b/fs/bcachefs/vfs/inode.rs
new file mode 100644
index 0000000..8b928a6
--- /dev/null
+++ b/fs/bcachefs/vfs/inode.rs
@@ -0,0 +1,421 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! The VFS's inode, InodeInfo - C's struct bch_inode_info - for Rust's VFS
+//! entry points. One borrowed for a VFS call is a &InodeInfo: the call holds
+//! a reference on the inode for as long as it runs. InodeRef is one Rust holds
+//! a reference on itself.
+//!
+//! ei_inode, the inode as last written, is read without a lock: its writers
+//! are serialized by the inode's btree position, which a transaction still
+//! holds locked after its commit, through update_after_write().
+//!
+//! Its struct inode is @v, a VfsInode (vfs_inode.rs): what Rust does of the
+//! VFS inode, it does through that.
+//!
+//! ei_update_lock, UpdateLock, serializes what the btree doesn't: a quota
+//! transfer and the inode write that goes with it - set_projid(), setattr's,
+//! rename's and the reinherit ioctl's - so the inode and its quota agree.
+//!
+//! ei_quota_lock, ei_quota, serializes the inode's quota accounting -
+//! reservations and i_sectors_acct, against a transfer. ei_qid changes only
+//! with both held, so either is enough to read it.
+//!
+//! The times go both ways: the btree's writes set them, and
+//! update_after_write() copies them in; the VFS sets them itself - atime on
+//! access, mtime and ctime on a data write - and ->write_inode writes them
+//! back. Every other field is the btree's.
+//!
+//! The VFS's updates reach the btree only at writeback - with lazytime, as
+//! late as sync or eviction - so an inode write made meanwhile has to carry
+//! them, or a crash can keep it and lose them (generic/622): fold_times(),
+//! before the write's own changes, which still win - assigned, not max()ed,
+//! as times can be set backwards. fs/namei.rs's writes peek the inode
+//! themselves: fold_times_trans() writes the folded times first, in the same
+//! transaction.
+
+use arrayvec::ArrayVec;
+use core::ffi::{c_int, c_uint, c_void};
+use core::mem::offset_of;
+use core::ptr::NonNull;
+use core::sync::atomic::Ordering::{Relaxed, SeqCst};
+
+use crate::btree::bkey::pos;
+use crate::btree::iter::{lockrestart_do, BtreeIter, BtreeIterFlags, BtreeTrans, CommitFlags, TransAttempt};
+use crate::c;
+use crate::errcode::{errptr_to_result, ret_to_c, ret_to_result, BchError};
+use crate::fs::Fs;
+use crate::inode;
+use crate::inode_opts::InodeOpt;
+use crate::locking::{Guard, Lock};
+use crate::quota;
+use crate::util::ffi::Opaque;
+use cstruct_macros::{c_export, c_extern};
+use kernel::sync::aref::{ARef, AlwaysRefCounted};
+
+use super::vfs_inode::VfsInode;
+
+pub use c::InodeInfo;
+
+c_extern! {
+    pub fn bch2_vfs_inode_get_trans(trans: *mut c::btree_trans, inum: c::subvol_inum,
+                                    func: *const crate::util::ffi::c_char) -> *mut c::bch_inode_info;
+    fn bch2_vfs_inode_get(c: *mut c::bch_fs, inum: c::subvol_inum,
+                          warn: *const crate::util::ffi::c_char) -> *mut c::inode;
+    // fs.c's inode cache, for lookup:
+    fn bch2_inode_hash_find(c: *mut c::bch_fs, trans: *mut c::btree_trans,
+                            inum: c::subvol_inum) -> *mut c::bch_inode_info;
+    fn bch2_inode_hash_init_insert(trans: *mut c::btree_trans, inum: c::subvol_inum,
+                                   bi: *mut c::bch_inode_unpacked,
+                                   subvol: *mut c::Subvolume) -> *mut c::bch_inode_info;
+}
+
+pub type InodeRef = ARef<InodeInfo>;
+
+// SAFETY: its count is its struct inode's, which is first
+unsafe impl AlwaysRefCounted for InodeInfo {
+    fn inc_ref(&self) {
+        self.vfs().inc_ref()
+    }
+
+    unsafe fn dec_ref(obj: NonNull<Self>) {
+        unsafe { VfsInode::dec_ref(obj.cast()) }
+    }
+}
+
+/// <linux/fs.h>'s ATTR_*: an iattr's ia_valid, and update_after_write()'s
+/// @fields.
+pub const ATTR_MODE:  u32 = 1 << 0;
+pub const ATTR_UID:   u32 = 1 << 1;
+pub const ATTR_GID:   u32 = 1 << 2;
+pub const ATTR_SIZE:  u32 = 1 << 3;
+pub const ATTR_ATIME: u32 = 1 << 4;
+pub const ATTR_MTIME: u32 = 1 << 5;
+pub const ATTR_CTIME: u32 = 1 << 6;
+
+// to_bch_ei(): an InodeInfo is where its struct inode is
+const _: () = assert!(offset_of!(InodeInfo, v) == 0);
+
+// SAFETY: the kernel's inode, shared by every thread with it open or in a VFS
+// call. What Rust reaches through &InodeInfo is atomic, behind a lock, or the
+// VFS inode's, read and written as VfsInode has it. The plain fields -
+// ei_reserved_*, ei_last_dirtied, ei_inodes_idx, the inode cache's hash
+// entries - are C's, under its locks: Rust doesn't touch them.
+unsafe impl Send for InodeInfo {}
+unsafe impl Sync for InodeInfo {}
+
+impl InodeInfo {
+    /// # Safety
+    /// @vinode is one of ours, live for 'a: the VFS holds a reference on it,
+    /// or otherwise keeps it from eviction.
+    pub unsafe fn from_inode<'a>(vinode: *mut c::inode) -> &'a InodeInfo {
+        // SAFETY: the caller's; @v is first
+        unsafe { &*vinode.cast::<InodeInfo>() }
+    }
+
+    /// An inode C returns referenced, or an ERR_PTR(): the reference ours
+    /// now.
+    ///
+    /// # Safety
+    /// @ei is one of ours with a reference the caller hands over, or an
+    /// ERR_PTR().
+    pub(crate) unsafe fn from_c(ei: *mut c::bch_inode_info) -> Result<InodeRef, BchError> {
+        let ei = errptr_to_result(NonNull::new(ei).expect("an inode, or an error"))?;
+        Ok(unsafe { ARef::from_raw(ei) })
+    }
+
+    /// @inum's, looked up in @t, the inode cache first.
+    pub fn get_trans(t: &TransAttempt<'_, '_>, inum: c::subvol_inum) -> Result<InodeRef, BchError> {
+        unsafe { Self::from_c(bch2_vfs_inode_get_trans(t.raw(), inum, crate::c_function_name!().as_ptr().cast())) }
+    }
+
+    /// @inum's, the inode cache first, in a transaction of its own - and no
+    /// warning if it isn't there, as a file handle's may not be.
+    pub(crate) fn get(fs: &Fs, inum: c::subvol_inum) -> Result<InodeRef, BchError> {
+        // @v is an InodeInfo's, first
+        unsafe { Self::from_c(bch2_vfs_inode_get(fs.as_ptr(), inum, core::ptr::null()).cast()) }
+    }
+
+    /// @inum's, if the inode cache has it. It waits out one being evicted,
+    /// unlocking @t: a restart then.
+    pub(crate) fn cache_find(t: &TransAttempt<'_, '_>, inum: c::subvol_inum)
+        -> Result<Option<InodeRef>, BchError>
+    {
+        let ei = unsafe { bch2_inode_hash_find(t.fs().as_ptr(), t.raw(), inum) };
+        if ei.is_null() {
+            return Ok(None);
+        }
+        unsafe { Self::from_c(ei) }.map(Some)
+    }
+
+    /// A new VFS inode for @inum, made from @bi and put in the inode cache -
+    /// or the one already there, if another lookup got there first. No
+    /// restart is taken from here on: commit what the caller has first.
+    pub(crate) fn cache_insert(t: &TransAttempt<'_, '_>, inum: c::subvol_inum,
+                               bi: &mut c::bch_inode_unpacked, subvol: &mut c::Subvolume)
+        -> Result<InodeRef, BchError>
+    {
+        unsafe { Self::from_c(bch2_inode_hash_init_insert(t.raw(), inum, bi, subvol)) }
+    }
+
+    pub fn raw(&self) -> *mut c::bch_inode_info {
+        core::ptr::from_ref(self).cast_mut()
+    }
+
+    pub fn fs(&self) -> &Fs {
+        self.vfs().sb().fs()
+    }
+
+    pub fn vfs(&self) -> &VfsInode {
+        &self.v
+    }
+
+    pub fn inum(&self) -> c::subvol_inum {
+        self.ei_inum_hash.inum
+    }
+
+    /// A copy of ei_inode.
+    pub fn inode(&self) -> c::bch_inode_unpacked {
+        self.ei_inode.get()
+    }
+
+    pub fn flag(&self, f: c::bch_inode_info_flags) -> bool {
+        self.ei_flags.load(Relaxed) & (1 << f as u32) != 0
+    }
+
+    /// Clear flag @f, and whether it was set: C's test_and_clear_bit(),
+    /// fully ordered.
+    pub fn take_flag(&self, f: c::bch_inode_info_flags) -> bool {
+        let bit = 1 << f as u32;
+        self.ei_flags.fetch_and(!bit, SeqCst) & bit != 0
+    }
+
+    /// Update the VFS inode to @bi, just committed in @trans - which still
+    /// holds the inode's btree position locked. @fields: the ATTR_* that
+    /// changed.
+    pub fn update_after_write(&self, trans: &BtreeTrans<'_>, bi: &c::bch_inode_unpacked, fields: u32) {
+        assert_eq!(bi.bi_inum, self.inum().inum, "updating the VFS inode {} to inode {}",
+                   self.inum().inum, bi.bi_inum);
+        trans.assert_pos_locked(c::btree_id::inodes, pos(0, bi.bi_inum));
+
+        let fs = self.fs();
+        let v = self.vfs();
+        v.set_nlink(bi.nlink());
+        v.set_uid(bi.bi_uid);
+        v.set_gid(bi.bi_gid);
+        v.set_mode(bi.bi_mode);
+
+        if fields & ATTR_SIZE != 0 {
+            v.set_size(bi.bi_size as i64);
+        }
+        if fields & ATTR_ATIME != 0 {
+            v.set_atime(fs.time_to_timespec(bi.bi_atime as i64));
+        }
+        if fields & ATTR_MTIME != 0 {
+            v.set_mtime(fs.time_to_timespec(bi.bi_mtime as i64));
+        }
+        if fields & ATTR_CTIME != 0 {
+            v.set_ctime(fs.time_to_timespec(bi.bi_ctime as i64));
+        }
+
+        use c::bch_inode_flags as F;
+        for (on, flag) in [(bi.flag(F::BCH_INODE_sync),      c::S_SYNC),
+                           (bi.flag(F::BCH_INODE_immutable), c::S_IMMUTABLE),
+                           (bi.flag(F::BCH_INODE_append),    c::S_APPEND),
+                           (bi.flag(F::BCH_INODE_noatime),   c::S_NOATIME),
+                           (bi.casefold(fs),                 c::S_CASEFOLD)] {
+            v.set_flag(flag, on);
+        }
+
+        self.ei_inode.set(bi);
+    }
+
+    /// @bi, about to be written, with the VFS's times: see the file comment.
+    pub(crate) fn fold_times(&self, bi: &mut c::bch_inode_unpacked) {
+        let (fs, v) = (self.fs(), self.vfs());
+        bi.bi_atime = fs.timespec_to_time(v.atime()) as u64;
+        bi.bi_mtime = fs.timespec_to_time(v.mtime()) as u64;
+        bi.bi_ctime = fs.timespec_to_time(v.ctime()) as u64;
+    }
+
+    /// fold_times(), written in @t: for a write of this inode later in @t,
+    /// whose peek sees it.
+    pub(crate) fn fold_times_trans(&self, t: &TransAttempt<'_, '_>) -> Result<(), BchError> {
+        let mut iter = BtreeIter::uninit();
+        let mut bi = inode::peek(t, &mut iter, self.inum(), BtreeIterFlags::INTENT)?;
+        self.fold_times(&mut bi);
+        inode::write(t, &mut iter, &mut bi)
+    }
+
+    pub fn update_lock(&self) -> UpdateLock<'_> {
+        UpdateLock { inode: self, _guard: Lock::from_c(&self.ei_update_lock).lock() }
+    }
+
+    /// Take the update locks of @inodes, together: in address order, each
+    /// once, each a lockdep subclass of its own - as C's bch2_lock_inodes()
+    /// does, so the two can't deadlock.
+    pub fn update_lock_all<const N: usize>(mut inodes: [&InodeInfo; N]) -> UpdateLocks<'_, N> {
+        inodes.sort_unstable_by_key(|i| core::ptr::from_ref(*i));
+
+        let mut locks = ArrayVec::new();
+        for (i, inode) in inodes.iter().enumerate() {
+            if i > 0 && core::ptr::eq(*inode, inodes[i - 1]) {
+                continue;
+            }
+            // C's subclasses start at 1
+            let guard = Lock::from_c(&inode.ei_update_lock).lock_nested(i as u32 + 1);
+            locks.push(UpdateLock { inode, _guard: guard });
+        }
+        UpdateLocks(locks)
+    }
+}
+
+pub struct UpdateLocks<'i, const N: usize>(ArrayVec<UpdateLock<'i>, N>);
+
+impl<'i, const N: usize> UpdateLocks<'i, N> {
+    /// @inode's, one of those locked.
+    pub fn get(&self, inode: &InodeInfo) -> &UpdateLock<'i> {
+        self.0.iter().find(|l| core::ptr::eq(l.inode, inode))
+            .expect("UpdateLocks::get() of an inode not locked")
+    }
+}
+
+/// For C's VFS ops, until they're Rust.
+#[c_export]
+pub fn bch2_inode_update_after_write(trans: &BtreeTrans<'_>, inode: &c::bch_inode_info,
+                                     bi: &c::bch_inode_unpacked, fields: c_uint) {
+    inode.update_after_write(trans, bi, fields)
+}
+
+/// ei_update_lock, held.
+pub struct UpdateLock<'i> {
+    inode:  &'i InodeInfo,
+    _guard: Guard<'i, c::mutex>,
+}
+
+impl<'i> UpdateLock<'i> {
+    /// ei_update_lock, held by the caller - C, calling in.
+    ///
+    /// # Safety
+    /// The caller holds @inode's ei_update_lock for 'i.
+    pub unsafe fn held(inode: &'i InodeInfo) -> Self {
+        UpdateLock { inode, _guard: unsafe { Lock::from_c(&inode.ei_update_lock).held() } }
+    }
+
+    /// Move the inode's quota charges - its usage, i_blocks +
+    /// ei_quota_reserved, and the inode itself - to @qid, in the quota types
+    /// of @qtypes that are accounted.
+    pub fn quota_transfer(&self, qid: c::bch_qid, qtypes: u32, mode: c::quota_acct_mode)
+        -> Result<(), BchError>
+    {
+        let inode = self.inode;
+        let fs = inode.fs();
+        let mut q = inode.ei_quota.lock();
+
+        let qtypes = quota::set_qtypes(qtypes & quota::enabled_qtypes(fs))
+            .filter(|&i| qid.q[i] != q.ei_qid.q[i])
+            .fold(0, |m, i| m | 1 << i);
+        if qtypes == 0 {
+            return Ok(());
+        }
+
+        // Quotas don't count snapshot inodes: only the qid changes.
+        if !inode.flag(c::bch_inode_info_flags::EI_INODE_SNAPSHOT) {
+            // blocks(): stable, under ei_quota_lock
+            quota::transfer(fs, qtypes, qid, q.ei_qid, inode.vfs().blocks() + q.ei_quota_reserved, mode)?;
+        }
+
+        for i in quota::set_qtypes(qtypes) {
+            q.ei_qid.q[i] = qid.q[i];
+        }
+        Ok(())
+    }
+
+    /// Move the inode to project @projid, quota and all.
+    pub fn set_projid(&self, projid: u32) -> Result<(), BchError> {
+        let mut qid = self.inode.ei_quota.lock().ei_qid;
+        qid.q[c::quota_types::QTYP_PRJ.0 as usize] = projid;
+
+        self.quota_transfer(qid, 1 << c::quota_types::QTYP_PRJ.0, c::quota_acct_mode::KEY_TYPE_QUOTA_PREALLOC)
+    }
+
+    /// Move the inode to @dir's project, if moving it into @dir would: it has
+    /// no project of its own, and @dir's is different.
+    pub fn inherit_project(&self, dir: &InodeInfo) -> Result<(), BchError> {
+        let project = InodeOpt::of(c::inode_opt_id::Inode_opt_project);
+        let (bi, dir_bi) = (self.inode.inode(), dir.inode());
+        if project.is_own(&bi) || project.get(&dir_bi) == project.get(&bi) {
+            return Ok(());
+        }
+        self.set_projid(dir.ei_quota.lock().ei_qid.q[c::quota_types::QTYP_PRJ.0 as usize])
+    }
+
+    /// Change the inode with @set, in a transaction of its own that's
+    /// committed, then update the VFS inode - @fields, the ATTR_* that
+    /// changed. @set runs in each attempt, on the inode as it is in the btree,
+    /// its times the VFS's.
+    pub fn write_inode<F>(&self, fields: u32, mut set: F) -> Result<(), BchError>
+    where
+        F: FnMut(&TransAttempt<'_, '_>, &mut c::bch_inode_unpacked) -> Result<(), BchError>,
+    {
+        self.write_inode_if(fields, |t, bi| set(t, bi).map(|()| true)).map(|_| ())
+    }
+
+    /// write_inode(), but @set says whether there's anything to write: if
+    /// not, nothing's written or updated. Whether it wrote.
+    pub fn write_inode_if<F>(&self, fields: u32, mut set: F) -> Result<bool, BchError>
+    where
+        F: FnMut(&TransAttempt<'_, '_>, &mut c::bch_inode_unpacked) -> Result<bool, BchError>,
+    {
+        let inode = self.inode;
+        let fs = inode.fs();
+        let trans = crate::btree_trans!(fs);
+        // Outside the attempt: the propagate it starts is finished after the
+        // commit
+        let mut opt_change = c::inode_opt_change::new();
+
+        let wrote = lockrestart_do(&trans, |t| {
+            opt_change = c::inode_opt_change::new();
+
+            let mut iter = BtreeIter::uninit();
+            let mut bi = inode::__peek(t, &mut iter, inode.inum(), BtreeIterFlags::INTENT,
+                                       Some(crate::c_function_name!()))?;
+            let old_r = inode::reconcile_opts_get(fs, &bi);
+
+            inode.fold_times(&mut bi);
+            if !set(t, &mut bi)? {
+                return Ok(false);
+            }
+
+            // iter's snapshot, not bi_snapshot: peek can find the inode at an
+            // ancestor, but it's written here
+            opt_change.record(t, &old_r, &bi, iter.snapshot())?;
+            inode::write(t, &mut iter, &mut bi)?;
+            t.commit(None, CommitFlags::NO_ENOSPC)?;
+
+            inode.update_after_write(t.trans(), &bi, fields);
+            Ok(true)
+        })?;
+
+        if wrote {
+            opt_change.finish(&trans)?;
+        }
+        Ok(wrote)
+    }
+}
+
+/// For C's inode writes, until they're Rust: @set, if not NULL, with @p -
+/// its error, or 0 to write the inode, or positive for nothing to write.
+#[must_use]
+#[c_export]
+pub fn bch2_write_inode(_c: &Opaque<c::bch_fs>, inode: &c::bch_inode_info, set: c::inode_set_fn,
+                        p: *mut c_void, fields: c_uint) -> c_int {
+    // SAFETY: every C caller holds @inode's ei_update_lock
+    let l = unsafe { UpdateLock::held(inode) };
+    ret_to_c(l.write_inode_if(fields, |t, bi| match set {
+        // SAFETY: C's callback, given the transaction it runs in, the
+        // inode, the inode being written, and its @p
+        Some(set) => ret_to_result(unsafe { set(t.raw(), inode.raw(), bi, p) })
+            .map(|r| r == 0),
+        None      => Ok(true),
+    }).map(|_| ()))
+}
