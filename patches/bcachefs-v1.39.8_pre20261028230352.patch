diff --git a/fs/bcachefs/btree/bbpos.h b/fs/bcachefs/btree/bbpos.h
new file mode 100644
index 0000000..f685821
--- /dev/null
+++ b/fs/bcachefs/btree/bbpos.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_BBPOS_H
+#define _BCACHEFS_BBPOS_H
+
+#include "btree/bbpos_gen.h"
+#include "btree/bkey_methods.h"
+#include "btree/cache.h"
+
+static inline int bbpos_cmp(struct bbpos l, struct bbpos r)
+{
+	return cmp_int(l.btree, r.btree) ?: bpos_cmp(l.pos, r.pos);
+}
+
+static inline struct bbpos bbpos_successor(struct bbpos pos)
+{
+	if (bpos_cmp(pos.pos, SPOS_MAX)) {
+		pos.pos = bpos_successor(pos.pos);
+		return pos;
+	}
+
+	if (pos.btree != BTREE_ID_NR) {
+		pos.btree++;
+		pos.pos = POS_MIN;
+		return pos;
+	}
+
+	BUG();
+}
+
+static inline void bch2_bbpos_to_text(struct printbuf *out, struct bbpos pos)
+{
+	bch2_btree_id_to_text(out, pos.btree);
+	prt_char(out, ':');
+	bch2_bpos_to_text(out, pos.pos);
+}
+
+#endif /* _BCACHEFS_BBPOS_H */
diff --git a/fs/bcachefs/btree/bbpos.rs b/fs/bcachefs/btree/bbpos.rs
new file mode 100644
index 0000000..fa9a206
--- /dev/null
+++ b/fs/bcachefs/btree/bbpos.rs
@@ -0,0 +1,96 @@
+use crate::c;
+use core::cmp::Ordering;
+#[cfg(feature = "std")]
+use crate::errcode::{bch_errcode, BchError};
+#[cfg(feature = "std")]
+use core::str::FromStr;
+
+impl PartialEq for c::bbpos {
+    fn eq(&self, other: &Self) -> bool {
+        self.cmp(other) == Ordering::Equal
+    }
+}
+
+impl Eq for c::bbpos {}
+
+impl PartialOrd for c::bbpos {
+    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
+        Some(self.cmp(other))
+    }
+}
+
+impl Ord for c::bbpos {
+    fn cmp(&self, other: &Self) -> Ordering {
+        self.btree.0.cmp(&{ other.btree.0 })
+            .then(self.pos.cmp(&other.pos))
+    }
+}
+
+impl c::bbpos {
+    pub const MIN: Self = c::bbpos { btree: c::btree_id(0), pos: crate::btree::bkey::POS_MIN };
+    /// The last of BTREE_ID_NR - 1.
+    pub const MAX: Self = c::bbpos {
+        btree: c::btree_id(c::BTREE_ID_NR as u32 - 1),
+        pos:   crate::btree::bkey::SPOS_MAX,
+    };
+
+    /// Past the last btree's last, panics.
+    pub fn successor(self) -> Self {
+        if self.pos != crate::btree::bkey::SPOS_MAX {
+            return c::bbpos { pos: self.pos.successor(), ..self };
+        }
+
+        assert!(self.btree.0 != c::BTREE_ID_NR as u32, "no position after the last btree's last");
+        c::bbpos { btree: c::btree_id(self.btree.0 + 1), pos: crate::btree::bkey::POS_MIN }
+    }
+}
+
+/// btree:pos, as bch2_bbpos_to_text().
+impl crate::util::ToText for c::bbpos {
+    fn to_text(&self, out: &mut crate::util::Printbuf) {
+        unsafe { c::bch2_btree_id_to_text(out.as_raw(), self.btree) };
+        crate::prt!(out, ":{}", self.pos);
+    }
+}
+crate::display_via_to_text!(c::bbpos);
+
+#[cfg(feature = "std")]
+impl FromStr for c::bbpos {
+    type Err = BchError;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        let err = || BchError::from(bch_errcode::BCH_ERR_EINVAL_parse_bbpos);
+
+        let (btree_s, pos_s) = s.split_once(':').ok_or_else(err)?;
+
+        let btree: c::btree_id = btree_s.parse().map_err(|_| err())?;
+        let pos: c::bpos = pos_s.parse().map_err(|_| err())?;
+
+        Ok(c::bbpos { btree, pos })
+    }
+}
+
+/// A range of btree positions (start..=end).
+#[cfg(feature = "std")]
+#[derive(Clone, Copy)]
+pub struct BbposRange {
+    pub start: c::bbpos,
+    pub end:   c::bbpos,
+}
+
+/// Parse a bbpos range string "start-end" or just "pos" (start == end).
+#[cfg(feature = "std")]
+pub fn bbpos_range_parse(s: &str) -> Result<BbposRange, BchError> {
+    let (start_s, end_s) = match s.split_once('-') {
+        Some((a, b)) => (a, Some(b)),
+        None => (s, None),
+    };
+
+    let start: c::bbpos = start_s.parse()?;
+    let end: c::bbpos = match end_s {
+        Some(e) => e.parse()?,
+        None => start,
+    };
+
+    Ok(BbposRange { start, end })
+}
diff --git a/fs/bcachefs/btree/bbpos_types.rs b/fs/bcachefs/btree/bbpos_types.rs
new file mode 100644
index 0000000..500b085
--- /dev/null
+++ b/fs/bcachefs/btree/bbpos_types.rs
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use cstruct_macros::{CStruct, Plain, bitfield};
+use nestify::nest;
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, CStruct, Plain)]
+pub struct bbpos {
+    pub btree: c::btree_id,
+    pub pos: c::bpos,
+}
+
+// Torn, a mix of two positions - not necessarily between them: harmless in
+// what reads one racily, a walk's progress, shown
+crate::tear_safe!(bbpos);
+
+/*
+ * Layout is padding-free (bpos is __packed __aligned(4)), so a blbpos can be
+ * used directly as a memcmp/rhashtable key.
+ */
+nest! {
+    #[repr(C)]
+    #[derive(Clone, Copy, Default, CStruct)]
+    pub struct blbpos {
+        #[c_bitfield]
+        #>[bitfield(u16)]
+        pub bits: pub struct blbpos_bits {
+            #[bits(16)] pub btree: c::btree_id,
+        },
+        pub level: u16,
+        pub pos: c::bpos,
+    }
+}
