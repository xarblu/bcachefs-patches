diff --git a/fs/bcachefs/util/six.c b/fs/bcachefs/util/six.c
new file mode 100644
index 0000000..3c5e706
--- /dev/null
+++ b/fs/bcachefs/util/six.c
@@ -0,0 +1,1131 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include "bcachefs.h"
+
+#include <linux/export.h>
+#include <linux/log2.h>
+#include <linux/percpu.h>
+#include <linux/preempt.h>
+#include <linux/rcupdate.h>
+#include <linux/sched.h>
+#include <linux/sched/clock.h>
+#include <linux/sched/rt.h>
+#include <linux/sched/task.h>
+#include <linux/slab.h>
+
+#include <trace/events/lock.h>
+
+#include "six.h"
+#include "btree/types_gen.h"
+
+#define six_acquire(l, t, r, ip)	lock_acquire(l, 0, t, r, 1, NULL, ip)
+#define six_release(l, ip)		lock_release(l, ip)
+
+static void do_six_unlock_type(struct six_lock *lock, enum six_lock_type type);
+
+#define SIX_LOCK_HELD_read_OFFSET	0
+#define SIX_LOCK_HELD_read		~(~0U << 26)
+#define SIX_LOCK_HELD_intent		(1U << 26)
+#define SIX_LOCK_HELD_write		(1U << 27)
+#define SIX_LOCK_WAITING_read		(1U << (28 + SIX_LOCK_read))
+#define SIX_LOCK_WAITING_write		(1U << (28 + SIX_LOCK_write))
+#define SIX_LOCK_NOSPIN			(1U << 31)
+
+struct six_lock_vals {
+	/* Value we add to the lock in order to take the lock: */
+	u32			lock_val;
+
+	/* If the lock has this value (used as a mask), taking the lock fails: */
+	u32			lock_fail;
+
+	/* Mask that indicates lock is held for this type: */
+	u32			held_mask;
+
+	/* Waitlist we wakeup when releasing the lock: */
+	enum six_lock_type	unlock_wakeup;
+};
+
+static const struct six_lock_vals l[] = {
+	[SIX_LOCK_read] = {
+		.lock_val	= 1U << SIX_LOCK_HELD_read_OFFSET,
+		.lock_fail	= SIX_LOCK_HELD_write,
+		.held_mask	= SIX_LOCK_HELD_read,
+		.unlock_wakeup	= SIX_LOCK_write,
+	},
+	[SIX_LOCK_intent] = {
+		.lock_val	= SIX_LOCK_HELD_intent,
+		.lock_fail	= SIX_LOCK_HELD_intent,
+		.held_mask	= SIX_LOCK_HELD_intent,
+		.unlock_wakeup	= SIX_LOCK_intent,
+	},
+	[SIX_LOCK_write] = {
+		.lock_val	= SIX_LOCK_HELD_write,
+		.lock_fail	= SIX_LOCK_HELD_read,
+		.held_mask	= SIX_LOCK_HELD_write,
+		.unlock_wakeup	= SIX_LOCK_read,
+	},
+};
+
+static inline void six_set_bitmask(struct six_lock *lock, u32 mask)
+{
+	if ((atomic_read(&lock->state) & mask) != mask)
+		atomic_or(mask, &lock->state);
+}
+
+static inline void six_clear_bitmask(struct six_lock *lock, u32 mask)
+{
+	if (atomic_read(&lock->state) & mask)
+		atomic_and(~mask, &lock->state);
+}
+
+static inline void six_set_owner(struct six_lock *lock, enum six_lock_type type,
+				 u32 old, struct task_struct *owner)
+{
+	if (type != SIX_LOCK_intent)
+		return;
+
+	if (!(old & SIX_LOCK_HELD_intent)) {
+		EBUG_ON(lock->owner);
+		lock->owner = owner;
+	} else {
+		EBUG_ON(lock->owner != current);
+	}
+}
+
+static void six_lock_record_acquire(struct six_lock *lock, enum six_lock_type type)
+{
+#ifdef CONFIG_BCACHEFS_DEBUG
+	if (type == SIX_LOCK_intent)
+		bch2_save_backtrace(&lock->owner_stack, current, 1, GFP_ATOMIC);
+#endif
+}
+
+static inline unsigned pcpu_read_count(struct six_lock *lock)
+{
+	unsigned read_count = 0;
+	int cpu;
+
+	for_each_possible_cpu(cpu)
+		read_count += *per_cpu_ptr(lock->readers, cpu);
+	return read_count;
+}
+
+/*
+ * __do_six_trylock() - main trylock routine
+ *
+ * Returns 1 on success, 0 on failure
+ *
+ * In percpu reader mode, a failed trylock may cause a spurious trylock failure
+ * for another thread taking the competing lock type, and we may have to do a
+ * wakeup: when a wakeup is required, we return -1 - wakeup_type.
+ */
+static int __do_six_trylock(struct six_lock *lock, enum six_lock_type type,
+			    struct task_struct *task, bool try)
+{
+	int ret;
+	u32 old;
+
+	EBUG_ON(type == SIX_LOCK_write && lock->owner != task);
+	EBUG_ON(type == SIX_LOCK_write &&
+		(try != !(atomic_read(&lock->state) & SIX_LOCK_HELD_write)));
+
+	/*
+	 * Percpu reader mode:
+	 *
+	 * The basic idea behind this algorithm is that you can implement a lock
+	 * between two threads without any atomics, just memory barriers:
+	 *
+	 * For two threads you'll need two variables, one variable for "thread a
+	 * has the lock" and another for "thread b has the lock".
+	 *
+	 * To take the lock, a thread sets its variable indicating that it holds
+	 * the lock, then issues a full memory barrier, then reads from the
+	 * other thread's variable to check if the other thread thinks it has
+	 * the lock. If we raced, we backoff and retry/sleep.
+	 *
+	 * Failure to take the lock may cause a spurious trylock failure in
+	 * another thread, because we temporarily set the lock to indicate that
+	 * we held it. This would be a problem for a thread in six_lock(), when
+	 * they are calling trylock after adding themself to the waitlist and
+	 * prior to sleeping.
+	 *
+	 * Therefore, if we fail to get the lock, and there were waiters of the
+	 * type we conflict with, we will have to issue a wakeup.
+	 *
+	 * Since we may be called under wait_lock (and by the wakeup code
+	 * itself), we return that the wakeup has to be done instead of doing it
+	 * here.
+	 */
+	if (type == SIX_LOCK_intent || !lock->readers) {
+		old = atomic_read(&lock->state);
+		do {
+			ret = !(old & l[type].lock_fail);
+			if (!ret || (type == SIX_LOCK_write && !try)) {
+				smp_mb();
+				break;
+			}
+		} while (!atomic_try_cmpxchg_acquire(&lock->state, &old, old + l[type].lock_val));
+
+		EBUG_ON(ret && !(atomic_read(&lock->state) & l[type].held_mask));
+	} else if (type == SIX_LOCK_read) {
+		guard(preempt)();
+
+		this_cpu_inc(*lock->readers); /* signal that we own lock */
+
+		smp_mb();
+
+		old = atomic_read(&lock->state);
+		ret = !(old & l[type].lock_fail);
+
+		if (!ret) {
+			this_cpu_dec(*lock->readers);
+			smp_mb();
+			if (atomic_read(&lock->state) & SIX_LOCK_WAITING_write)
+				ret = -1 - SIX_LOCK_write;
+		}
+	} else {
+		if (try)
+			atomic_add(SIX_LOCK_HELD_write, &lock->state);
+
+		/*
+		 * Make sure atomic_add happens before pcpu_read_count and
+		 * six_set_bitmask in slow path happens before pcpu_read_count.
+		 *
+		 * Paired with the smp_mb() in read lock fast path (per-cpu mode)
+		 * and the one before atomic_read in read unlock path.
+		 */
+		smp_mb();
+		ret = !pcpu_read_count(lock);
+
+		if (try && !ret) {
+			old = atomic_sub_return(SIX_LOCK_HELD_write, &lock->state);
+			if (old & SIX_LOCK_WAITING_read)
+				ret = -1 - SIX_LOCK_read;
+		}
+	}
+
+	if (ret > 0)
+		six_set_owner(lock, type, old, task);
+
+	EBUG_ON(type == SIX_LOCK_write && try && ret <= 0 &&
+		(atomic_read(&lock->state) & SIX_LOCK_HELD_write));
+
+	return ret;
+}
+
+/*
+ * Trim @nr while the tail is all tombstones. Clamp hint inside [0, nr].
+ * Caller must hold wait_lock.
+ */
+static inline void six_lock_wait_fifo_shrink(struct six_lock_wait_fifo *wf)
+{
+	while (wf->nr > 0 && !wf->data[wf->nr - 1].w)
+		wf->nr--;
+	if (wf->next_free_hint > wf->nr)
+		wf->next_free_hint = wf->nr;
+}
+
+/*
+ * Null out the entry at @idx and update the free-slot hint. Caller must hold
+ * wait_lock. Does not shrink @nr — that's done lazily by the caller when
+ * convenient (e.g. at the end of a wakeup scan).
+ */
+static inline void six_lock_wait_fifo_remove(struct six_lock_wait_fifo *wf, u16 idx)
+{
+	/*
+	 * WRITE_ONCE: the lockless cycle detector reads this slot via
+	 * smp_load_acquire(&.w); clearing to NULL just makes it skip the slot
+	 * (no dependent data, so no release needed), but it's a concurrently
+	 * read shared location, so the store must be marked.
+	 */
+	WRITE_ONCE(wf->data[idx].w, NULL);
+	wf->next_free_hint = min(wf->next_free_hint, idx);
+}
+
+/*
+ * Find a free slot (starting from @next_free_hint) and write the entry.
+ * Returns 0 on success, -ENOMEM if the list is full.
+ * Caller must hold wait_lock.
+ */
+static inline int six_lock_wait_fifo_insert(struct six_lock *lock,
+					    struct six_lock_waiter *wait)
+{
+	struct six_lock_wait_fifo *wf =
+		rcu_dereference_protected(lock->wait_fifo, lockdep_is_held(&lock->wait_lock));
+
+	u16 i = wf->next_free_hint;
+	if (!wf->data[i].w)
+		goto fill;
+
+	for (i = 0; i < wf->nr; i++)
+		if (!wf->data[i].w)
+			goto fill;
+
+	if (wf->nr < wf->size)
+		goto fill;
+
+	return 0;
+fill:
+	/*
+	 * Publish this waiter for the lockless cycle detector
+	 * (bch2_check_for_deadlock), which walks this fifo without taking
+	 * wait_lock, gates each slot on a non-NULL .w, then reads the sibling
+	 * .start_time and follows container_of(.w) -> trans to read the
+	 * waiter's held-lock state.
+	 *
+	 * .w is the publish gate: stored last, with a release that orders the
+	 * sibling slot fields and all of the trans's held-lock state (->paths,
+	 * ->nodes_locked, l[].b) before the slot becomes visible. Pairs with
+	 * the smp_load_acquire(&i->w) in the walk.
+	 *
+	 * This release is *not* the store->load fence that lets two waiters
+	 * closing a cycle see each other - that is the smp_mb() in
+	 * bch2_check_for_deadlock.
+	 */
+	wf->data[i].start_time	= (wait->trans_start_time << SIX_LOCK_WANT_BITS) |
+				  ((u8) wait->lock_want & SIX_LOCK_WANT_MASK);
+	wait->slot_idx		= i;
+	wf->next_free_hint	= (i + 1) & (wf->size - 1);
+	wf->nr			= max(wf->nr, i + 1);
+	smp_store_release(&wf->data[i].w, wait);
+	return 1;
+}
+
+noinline
+static int six_lock_wait_fifo_realloc(struct six_lock *lock,
+				      struct six_lock_waiter *wait,
+				      struct six_lock_wait_fifo **_new_wf)
+{
+	struct six_lock_wait_fifo *old_wf = rcu_dereference_protected(lock->wait_fifo, true);
+	struct six_lock_wait_fifo *new_wf = *_new_wf;
+
+	if (new_wf && new_wf->size == old_wf->size * 2) {
+		memcpy(new_wf->data, old_wf->data, old_wf->nr * sizeof(old_wf->data[0]));
+		new_wf->nr = old_wf->nr;
+		rcu_assign_pointer(lock->wait_fifo, new_wf);
+
+		*_new_wf = old_wf != &lock->inline_fifo ? old_wf : NULL;
+		return six_lock_wait_fifo_insert(lock, wait);
+	}
+
+	unsigned old_size = old_wf->size;
+	if (old_size >= (1 << 15))
+		return -ENOMEM;
+
+	raw_spin_unlock(&lock->wait_lock);
+
+	if (new_wf)
+		kfree(new_wf);
+
+	unsigned new_size = old_size * 2;
+	new_wf = kzalloc(struct_size(new_wf, data, new_size), GFP_KERNEL);
+	if (!new_wf)
+		return -ENOMEM;
+
+	new_wf->size = new_size;
+	*_new_wf = new_wf;
+	return 0;
+}
+
+/*
+ * Wake the single matching waiter with the smallest start_time (oldest
+ * transaction). On release, only that slot is nulled — the rest of the list
+ * remains stable from the lockless cycle detector's perspective.
+ *
+ * For reads: wake all matching waiters, same start-time ordering isn't
+ * relevant since readers don't conflict with each other.
+ */
+static void __six_lock_wakeup(struct six_lock *lock, enum six_lock_type lock_type)
+{
+	struct six_lock_wait_fifo *wf = rcu_dereference_protected(lock->wait_fifo,
+						lockdep_is_held(&lock->wait_lock));
+	struct six_lock_wait_slot *slot;
+	struct task_struct *task;
+	int ret;
+again:
+	ret = 0;
+
+	if (lock_type == SIX_LOCK_read) {
+		/* Readers don't conflict: wake all matching waiters. */
+		for (u16 i = 0; i < wf->nr; i++) {
+			slot = &wf->data[i];
+			if (!slot->w ||
+			    (slot->start_time & SIX_LOCK_WANT_MASK) != lock_type)
+				continue;
+
+			ret = __do_six_trylock(lock, lock_type, slot->w->task, false);
+			if (ret <= 0)
+				goto out;
+
+			/*
+			 * Similar to percpu_rwsem_wake_function(), we need to
+			 * guard against the wakee noticing w->lock_acquired,
+			 * returning, and then exiting before we do the wakeup:
+			 */
+			struct six_lock_waiter *w = slot->w;
+			task = get_task_struct(w->task);
+			six_lock_wait_fifo_remove(wf, i);
+			/*
+			 * Release barrier orders the slot clear before
+			 * setting w->lock_acquired; @w is on the stack of the
+			 * waiting thread and will be reused after it sees
+			 * w->lock_acquired with no other locking: pairs with
+			 * smp_load_acquire() in six_lock_slowpath()
+			 */
+			smp_store_release(&w->lock_acquired, true);
+			wake_up_process(task);
+			put_task_struct(task);
+		}
+	} else {
+		/*
+		 * Intent/write locks have a single holder: prefer the waiter
+		 * whose transaction started earliest. start_time is cached in
+		 * the slot so the scan doesn't deref each waiter.
+		 */
+		struct six_lock_wait_slot *oldest = NULL;
+		u16 oldest_iter = 0;
+		unsigned n_matches = 0;
+
+		for (u16 i = 0; i < wf->nr; i++) {
+			slot = &wf->data[i];
+			if (!slot->w ||
+			    (slot->start_time & SIX_LOCK_WANT_MASK) != lock_type)
+				continue;
+			n_matches++;
+			if (!oldest ||
+			    time_before64(slot->start_time, oldest->start_time)) {
+				oldest = slot;
+				oldest_iter = i;
+			}
+		}
+
+		if (oldest) {
+			ret = __do_six_trylock(lock, lock_type, oldest->w->task, false);
+			if (ret <= 0)
+				goto out;
+
+			struct six_lock_waiter *w = oldest->w;
+			task = get_task_struct(w->task);
+			six_lock_wait_fifo_remove(wf, oldest_iter);
+			smp_store_release(&w->lock_acquired, true);
+			wake_up_process(task);
+			put_task_struct(task);
+
+			/*
+			 * More non-read waiters still queued: leave the
+			 * WAITING bit set so the next unlock re-enters
+			 * __six_lock_wakeup and serves them.
+			 */
+			if (n_matches > 1)
+				goto shrink;
+		}
+	}
+
+	six_clear_bitmask(lock, SIX_LOCK_WAITING_read << lock_type);
+out:
+	if (ret < 0) {
+		lock_type = -ret - 1;
+		goto again;
+	}
+shrink:
+	six_lock_wait_fifo_shrink(wf);
+}
+
+__always_inline
+static void six_lock_wakeup(struct six_lock *lock, u32 state,
+			    enum six_lock_type lock_type)
+{
+	if (lock_type == SIX_LOCK_write && (state & SIX_LOCK_HELD_read))
+		return;
+
+	if (!(state & (SIX_LOCK_WAITING_read << lock_type)))
+		return;
+
+	guard(raw_spinlock)(&lock->wait_lock);
+	__six_lock_wakeup(lock, lock_type);
+}
+
+__always_inline
+static bool do_six_trylock(struct six_lock *lock, enum six_lock_type type, bool try)
+{
+	int ret;
+
+	ret = __do_six_trylock(lock, type, current, try);
+	if (ret < 0) {
+		guard(raw_spinlock)(&lock->wait_lock);
+		__six_lock_wakeup(lock, -ret - 1);
+	}
+
+	return ret > 0;
+}
+
+/**
+ * six_trylock_ip - attempt to take a six lock without blocking
+ * @lock:	lock to take
+ * @type:	SIX_LOCK_read, SIX_LOCK_intent, or SIX_LOCK_write
+ * @ip:		ip parameter for lockdep/lockstat, i.e. _THIS_IP_
+ *
+ * Return: true on success, false on failure.
+ */
+bool six_trylock_ip(struct six_lock *lock, enum six_lock_type type, unsigned long ip)
+{
+	if (!do_six_trylock(lock, type, true))
+		return false;
+
+	if (type != SIX_LOCK_write)
+		six_acquire(&lock->dep_map, 1, type == SIX_LOCK_read, ip);
+	six_lock_record_acquire(lock, type);
+	return true;
+}
+EXPORT_SYMBOL_GPL(six_trylock_ip);
+
+/**
+ * six_relock_ip - attempt to re-take a lock that was held previously
+ * @lock:	lock to take
+ * @type:	SIX_LOCK_read, SIX_LOCK_intent, or SIX_LOCK_write
+ * @seq:	lock sequence number obtained from six_lock_seq() while lock was
+ *		held previously
+ * @ip:		ip parameter for lockdep/lockstat, i.e. _THIS_IP_
+ *
+ * Return: true on success, false on failure.
+ */
+bool six_relock_ip(struct six_lock *lock, enum six_lock_type type,
+		   unsigned seq, unsigned long ip)
+{
+	if (six_lock_seq(lock) != seq || !six_trylock_ip(lock, type, ip))
+		return false;
+
+	if (six_lock_seq(lock) != seq) {
+		six_unlock_ip(lock, type, ip);
+		return false;
+	}
+
+	return true;
+}
+EXPORT_SYMBOL_GPL(six_relock_ip);
+
+#ifdef CONFIG_BCACHEFS_SIX_OPTIMISTIC_SPIN
+
+static inline bool six_owner_running(struct six_lock *lock)
+{
+	/*
+	 * When there's no owner, we might have preempted between the owner
+	 * acquiring the lock and setting the owner field. If we're an RT task
+	 * that will live-lock because we won't let the owner complete.
+	 */
+	guard(rcu)();
+	struct task_struct *owner = READ_ONCE(lock->owner);
+	return owner ? owner_on_cpu(owner) : !rt_or_dl_task(current);
+}
+
+static inline bool six_optimistic_spin(struct six_lock *lock,
+				       struct six_lock_waiter *wait,
+				       enum six_lock_type type)
+{
+	unsigned loop = 0;
+	u64 end_time;
+
+	if (type == SIX_LOCK_write)
+		return false;
+
+	scoped_guard(rcu) {
+		struct six_lock_wait_fifo *wf = rcu_dereference(lock->wait_fifo);
+		/*
+		 * Only spin if we're the sole entry in the wait list. Anything
+		 * more and someone older might get woken ahead of us.
+		 */
+		if (wf->nr != 1 || wf->data[0].w != wait)
+			return false;
+	}
+
+	if (atomic_read(&lock->state) & SIX_LOCK_NOSPIN)
+		return false;
+
+	guard(preempt)();
+	end_time = sched_clock() + 10 * NSEC_PER_USEC;
+
+	while (!need_resched() && six_owner_running(lock)) {
+		/*
+		 * Ensures that writes to the waitlist entry happen after we see
+		 * wait->lock_acquired: pairs with the smp_store_release in
+		 * __six_lock_wakeup
+		 */
+		if (smp_load_acquire(&wait->lock_acquired))
+			return true;
+
+		if (!(++loop & 0xf) && (time_after64(sched_clock(), end_time))) {
+			six_set_bitmask(lock, SIX_LOCK_NOSPIN);
+			break;
+		}
+
+		/*
+		 * The cpu_relax() call is a compiler barrier which forces
+		 * everything in this loop to be re-loaded. We don't need
+		 * memory barriers as we'll eventually observe the right
+		 * values at the cost of a few extra spins.
+		 */
+		cpu_relax();
+	}
+
+	return false;
+}
+
+#else /* CONFIG_LOCK_SPIN_ON_OWNER */
+
+static inline bool six_optimistic_spin(struct six_lock *lock,
+				       struct six_lock_waiter *wait,
+				       enum six_lock_type type)
+{
+	return false;
+}
+
+#endif
+
+__always_inline
+static int __six_lock_slowpath(struct six_lock *lock, enum six_lock_type type,
+			     struct six_lock_waiter *wait,
+			     six_lock_should_sleep_fn should_sleep_fn,
+			     unsigned long ip)
+{
+	struct six_lock_wait_fifo *new_wf = NULL;
+	int ret = 0;
+
+	if (type == SIX_LOCK_write) {
+		EBUG_ON(atomic_read(&lock->state) & SIX_LOCK_HELD_write);
+		atomic_add(SIX_LOCK_HELD_write, &lock->state);
+		smp_mb__after_atomic();
+	}
+
+	trace_contention_begin(lock, 0);
+	lock_contended(&lock->dep_map, ip);
+
+	wait->task		= current;
+	wait->lock_want		= type;
+	wait->lock_acquired	= false;
+retry_relock:
+	raw_spin_lock(&lock->wait_lock);
+
+	/*
+	 * Retry taking the lock after taking waitlist lock, in case we raced
+	 * with an unlock:
+	 */
+	six_set_bitmask(lock, SIX_LOCK_WAITING_read << type);
+	ret = __do_six_trylock(lock, type, current, false);
+	if (unlikely(ret < 0)) {
+		__six_lock_wakeup(lock, -ret - 1);
+		ret = 0;
+	}
+
+	if (!ret) {
+		ret = six_lock_wait_fifo_insert(lock, wait) ?:
+			six_lock_wait_fifo_realloc(lock, wait, &new_wf);
+		if (unlikely(ret <= 0)) {
+			if (!ret)
+				goto retry_relock;
+
+			if (type == SIX_LOCK_write) {
+				six_clear_bitmask(lock, SIX_LOCK_HELD_write);
+				six_lock_wakeup(lock, atomic_read(&lock->state), SIX_LOCK_read);
+			}
+			goto out;
+		}
+		ret = 0;
+	}
+	raw_spin_unlock(&lock->wait_lock);
+
+	if (unlikely(ret > 0)) {
+		ret = 0;
+		goto out;
+	}
+
+	if (six_optimistic_spin(lock, wait, type) ||
+	    smp_load_acquire(&wait->lock_acquired))
+		goto out;
+
+	/* Yield before running the cycle detector: */
+	schedule();
+
+	while (1) {
+		set_current_state(TASK_UNINTERRUPTIBLE);
+
+		/*
+		 * Ensures that writes to the waitlist entry happen after we see
+		 * wait->lock_acquired: pairs with the smp_store_release in
+		 * __six_lock_wakeup
+		 */
+		if (smp_load_acquire(&wait->lock_acquired))
+			break;
+
+		ret = should_sleep_fn ? should_sleep_fn(lock, wait) : 0;
+		if (unlikely(ret)) {
+			/*
+			 * If should_sleep_fn() returns an error, we are
+			 * required to return that error even if we already
+			 * acquired the lock - should_sleep_fn() might have
+			 * modified external state (e.g. when the deadlock cycle
+			 * detector in bcachefs issued a transaction restart)
+			 */
+			raw_spin_lock(&lock->wait_lock);
+			bool acquired = wait->lock_acquired;
+			if (!acquired) {
+				struct six_lock_wait_fifo *wf = rcu_dereference_protected(
+					lock->wait_fifo, lockdep_is_held(&lock->wait_lock));
+
+				six_lock_wait_fifo_remove(wf, wait->slot_idx);
+				six_lock_wait_fifo_shrink(wf);
+			}
+			raw_spin_unlock(&lock->wait_lock);
+
+			if (unlikely(acquired)) {
+				do_six_unlock_type(lock, type);
+			} else if (type == SIX_LOCK_write) {
+				six_clear_bitmask(lock, SIX_LOCK_HELD_write);
+				six_lock_wakeup(lock, atomic_read(&lock->state), SIX_LOCK_read);
+			}
+			break;
+		}
+
+		schedule();
+	}
+
+	__set_current_state(TASK_RUNNING);
+out:
+	if (new_wf)
+		kfree_rcu_mightsleep(new_wf);
+	trace_contention_end(lock, 0);
+
+	return ret;
+}
+
+noinline
+static int six_lock_slowpath(struct six_lock *lock, enum six_lock_type type,
+			     struct six_lock_waiter *wait,
+			     six_lock_should_sleep_fn should_sleep_fn,
+			     unsigned long ip)
+{
+	return __six_lock_slowpath(lock, type, wait, should_sleep_fn, ip);
+}
+
+/**
+ * six_lock_ip_waiter - take a lock, with full waitlist interface
+ * @lock:	lock to take
+ * @type:	SIX_LOCK_read, SIX_LOCK_intent, or SIX_LOCK_write
+ * @wait:	pointer to wait object, which will be added to lock's waitlist
+ * @should_sleep_fn: callback run after adding to waitlist, immediately prior
+ *		to scheduling
+ * @p:		passed through to @should_sleep_fn
+ * @ip:		ip parameter for lockdep/lockstat, i.e. _THIS_IP_
+ *
+ * This is the most general six_lock() variant, with parameters to support full
+ * cycle detection for deadlock avoidance.
+ *
+ * The code calling this function must implement tracking of held locks, and the
+ * @wait object should be embedded into the struct that tracks held locks -
+ * which must also be accessible in a thread-safe way.
+ *
+ * @should_sleep_fn should invoke the cycle detector; it should walk each
+ * lock's waiters, and for each waiter recursively walk their held locks.
+ *
+ * When this function must block, @wait will be added to @lock's waitlist before
+ * calling trylock, and before calling @should_sleep_fn, and @wait will not be
+ * removed from the lock waitlist until the lock has been successfully acquired,
+ * or we abort.
+ *
+ * @wait.trans_start_time orders waiters on the same waitlist (oldest waiter
+ * wins), and may be used as a loop cursor for cycle detection.
+ *
+ * Return: 0 on success, or the return code from @should_sleep_fn on failure.
+ */
+int six_lock_ip_waiter(struct six_lock *lock, enum six_lock_type type,
+		       struct six_lock_waiter *wait,
+		       six_lock_should_sleep_fn should_sleep_fn,
+		       unsigned long ip)
+{
+	int ret;
+
+	if (type != SIX_LOCK_write)
+		six_acquire(&lock->dep_map, 0, type == SIX_LOCK_read, ip);
+
+	ret = do_six_trylock(lock, type, true) ? 0
+		: six_lock_slowpath(lock, type, wait, should_sleep_fn, ip);
+
+	if (ret && type != SIX_LOCK_write)
+		six_release(&lock->dep_map, ip);
+	if (!ret) {
+		lock_acquired(&lock->dep_map, ip);
+		six_lock_record_acquire(lock, type);
+	}
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(six_lock_ip_waiter);
+
+/*
+ * As six_lock_ip_waiter() but skip the initial trylock. The caller has
+ * already attempted (and observed failure) — burning another locked CAS
+ * to recheck would be wasted work. The post-WAITING-bit retry inside
+ * six_lock_slowpath() still covers the unlock-raced-with-us window.
+ */
+int six_lock_contended(struct six_lock *lock, enum six_lock_type type,
+				 struct six_lock_waiter *wait,
+				 six_lock_should_sleep_fn should_sleep_fn,
+				 unsigned long ip)
+{
+	int ret;
+
+	if (type != SIX_LOCK_write)
+		six_acquire(&lock->dep_map, 0, type == SIX_LOCK_read, ip);
+
+	ret = __six_lock_slowpath(lock, type, wait, should_sleep_fn, ip);
+
+	if (ret && type != SIX_LOCK_write)
+		six_release(&lock->dep_map, ip);
+	if (!ret) {
+		lock_acquired(&lock->dep_map, ip);
+		six_lock_record_acquire(lock, type);
+	}
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(six_lock_contended);
+
+__always_inline
+static void do_six_unlock_type(struct six_lock *lock, enum six_lock_type type)
+{
+	u32 state;
+
+	if (type == SIX_LOCK_intent)
+		lock->owner = NULL;
+
+	if (type == SIX_LOCK_read &&
+	    lock->readers) {
+		smp_mb(); /* unlock barrier */
+		this_cpu_dec(*lock->readers);
+		smp_mb(); /* between unlocking and checking for waiters */
+		state = atomic_read(&lock->state);
+	} else {
+		u32 v = l[type].lock_val;
+
+		if (type != SIX_LOCK_read)
+			v += atomic_read(&lock->state) & SIX_LOCK_NOSPIN;
+
+		EBUG_ON(!(atomic_read(&lock->state) & l[type].held_mask));
+		state = atomic_sub_return_release(v, &lock->state);
+	}
+
+	six_lock_wakeup(lock, state, l[type].unlock_wakeup);
+}
+
+/**
+ * six_unlock_ip - drop a six lock
+ * @lock:	lock to unlock
+ * @type:	SIX_LOCK_read, SIX_LOCK_intent, or SIX_LOCK_write
+ * @ip:		ip parameter for lockdep/lockstat, i.e. _THIS_IP_
+ *
+ * When a lock is held multiple times (because six_lock_incement()) was used),
+ * this decrements the 'lock held' counter by one.
+ *
+ * For example:
+ * six_lock_read(&foo->lock);				read count 1
+ * six_lock_increment(&foo->lock, SIX_LOCK_read);	read count 2
+ * six_lock_unlock(&foo->lock, SIX_LOCK_read);		read count 1
+ * six_lock_unlock(&foo->lock, SIX_LOCK_read);		read count 0
+ */
+void six_unlock_ip(struct six_lock *lock, enum six_lock_type type, unsigned long ip)
+{
+	EBUG_ON(type == SIX_LOCK_write &&
+		!(atomic_read(&lock->state) & SIX_LOCK_HELD_intent));
+	EBUG_ON((type == SIX_LOCK_write ||
+		 type == SIX_LOCK_intent) &&
+		lock->owner != current);
+
+	if (type != SIX_LOCK_write)
+		six_release(&lock->dep_map, ip);
+
+	if (type == SIX_LOCK_intent &&
+	    lock->intent_lock_recurse) {
+		--lock->intent_lock_recurse;
+		return;
+	}
+
+	if (type == SIX_LOCK_write &&
+	    lock->write_lock_recurse) {
+		--lock->write_lock_recurse;
+		return;
+	}
+
+	if (type == SIX_LOCK_write)
+		lock->seq++;
+
+	do_six_unlock_type(lock, type);
+}
+EXPORT_SYMBOL_GPL(six_unlock_ip);
+
+/**
+ * six_lock_downgrade - convert an intent lock to a read lock
+ * @lock:	lock to dowgrade
+ *
+ * @lock will have read count incremented and intent count decremented
+ */
+void six_lock_downgrade(struct six_lock *lock)
+{
+	six_lock_increment(lock, SIX_LOCK_read);
+	six_unlock_intent(lock);
+}
+EXPORT_SYMBOL_GPL(six_lock_downgrade);
+
+/**
+ * six_lock_tryupgrade - attempt to convert read lock to an intent lock
+ * @lock:	lock to upgrade
+ *
+ * On success, @lock will have intent count incremented and read count
+ * decremented
+ *
+ * Return: true on success, false on failure
+ */
+bool six_lock_tryupgrade(struct six_lock *lock)
+{
+	u32 old = atomic_read(&lock->state), new;
+
+	do {
+		new = old;
+
+		if (new & SIX_LOCK_HELD_intent)
+			return false;
+
+		if (!lock->readers) {
+			EBUG_ON(!(new & SIX_LOCK_HELD_read));
+			new -= l[SIX_LOCK_read].lock_val;
+		}
+
+		new |= SIX_LOCK_HELD_intent;
+	} while (!atomic_try_cmpxchg_acquire(&lock->state, &old, new));
+
+	if (lock->readers)
+		this_cpu_dec(*lock->readers);
+
+	six_set_owner(lock, SIX_LOCK_intent, old, current);
+
+	return true;
+}
+EXPORT_SYMBOL_GPL(six_lock_tryupgrade);
+
+/**
+ * six_trylock_convert - attempt to convert a held lock from one type to another
+ * @lock:	lock to upgrade
+ * @from:	SIX_LOCK_read or SIX_LOCK_intent
+ * @to:		SIX_LOCK_read or SIX_LOCK_intent
+ *
+ * On success, @lock will have intent count incremented and read count
+ * decremented
+ *
+ * Return: true on success, false on failure
+ */
+bool six_trylock_convert(struct six_lock *lock,
+			 enum six_lock_type from,
+			 enum six_lock_type to)
+{
+	EBUG_ON(to == SIX_LOCK_write || from == SIX_LOCK_write);
+
+	if (to == from)
+		return true;
+
+	if (to == SIX_LOCK_read) {
+		six_lock_downgrade(lock);
+		return true;
+	} else {
+		return six_lock_tryupgrade(lock);
+	}
+}
+EXPORT_SYMBOL_GPL(six_trylock_convert);
+
+/**
+ * six_lock_increment - increase held lock count on a lock that is already held
+ * @lock:	lock to increment
+ * @type:	SIX_LOCK_read or SIX_LOCK_intent
+ *
+ * @lock must already be held, with a lock type that is greater than or equal to
+ * @type
+ *
+ * A corresponding six_unlock_type() call will be required for @lock to be fully
+ * unlocked.
+ */
+void six_lock_increment(struct six_lock *lock, enum six_lock_type type)
+{
+	six_acquire(&lock->dep_map, 0, type == SIX_LOCK_read, _RET_IP_);
+
+	/* XXX: assert already locked, and that we don't overflow: */
+
+	switch (type) {
+	case SIX_LOCK_read:
+		if (lock->readers) {
+			this_cpu_inc(*lock->readers);
+		} else {
+			EBUG_ON(!(atomic_read(&lock->state) &
+				  (SIX_LOCK_HELD_read|
+				   SIX_LOCK_HELD_intent)));
+			atomic_add(l[type].lock_val, &lock->state);
+		}
+		break;
+	case SIX_LOCK_write:
+		lock->write_lock_recurse++;
+		fallthrough;
+	case SIX_LOCK_intent:
+		EBUG_ON(!(atomic_read(&lock->state) & SIX_LOCK_HELD_intent));
+		lock->intent_lock_recurse++;
+		break;
+	}
+}
+EXPORT_SYMBOL_GPL(six_lock_increment);
+
+/**
+ * six_lock_wakeup_all - wake up all waiters on @lock
+ * @lock:	lock to wake up waiters for
+ *
+ * Wakeing up waiters will cause them to re-run should_sleep_fn, which may then
+ * abort the lock operation.
+ *
+ * This function is never needed in a bug-free program; it's only useful in
+ * debug code, e.g. to determine if a cycle detector is at fault.
+ */
+void six_lock_wakeup_all(struct six_lock *lock)
+{
+	u32 state = atomic_read(&lock->state);
+
+	/*
+	 * First, run the normal wakeup machinery for any waiters the lock
+	 * state actually permits to acquire: those slots get removed by
+	 * __six_lock_wakeup and lock_acquired is set on the waiter.
+	 */
+	six_lock_wakeup(lock, state, SIX_LOCK_read);
+	six_lock_wakeup(lock, state, SIX_LOCK_intent);
+	six_lock_wakeup(lock, state, SIX_LOCK_write);
+
+	/*
+	 * Then wake any remaining waiters without removing their slots:
+	 * lock_acquired stays clear, so they'll re-run should_sleep_fn in
+	 * six_lock_slowpath() and self-remove via wait->slot_idx if it
+	 * returns an error. Removing here would corrupt that self-remove.
+	 */
+	raw_spin_lock(&lock->wait_lock);
+	struct six_lock_wait_fifo *wf = rcu_dereference_protected(lock->wait_fifo,
+						lockdep_is_held(&lock->wait_lock));
+	for (u16 i = 0; i < wf->nr; i++)
+		if (wf->data[i].w)
+			wake_up_process(wf->data[i].w->task);
+	raw_spin_unlock(&lock->wait_lock);
+}
+EXPORT_SYMBOL_GPL(six_lock_wakeup_all);
+
+/**
+ * six_lock_counts - return held lock counts, for each lock type
+ * @lock:	lock to return counters for
+ *
+ * Return: the number of times a lock is held for read, intent and write.
+ */
+struct six_lock_count six_lock_counts(struct six_lock *lock)
+{
+	struct six_lock_count ret;
+
+	ret.n[SIX_LOCK_read]	= !lock->readers
+		? atomic_read(&lock->state) & SIX_LOCK_HELD_read
+		: pcpu_read_count(lock);
+	ret.n[SIX_LOCK_intent]	= !!(atomic_read(&lock->state) & SIX_LOCK_HELD_intent) +
+		lock->intent_lock_recurse;
+	ret.n[SIX_LOCK_write]	= !!(atomic_read(&lock->state) & SIX_LOCK_HELD_write);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(six_lock_counts);
+
+/**
+ * six_lock_readers_add - directly manipulate reader count of a lock
+ * @lock:	lock to add/subtract readers for
+ * @nr:		reader count to add/subtract
+ *
+ * When an upper layer is implementing lock reentrency, we may have both read
+ * and intent locks on the same lock.
+ *
+ * When we need to take a write lock, the read locks will cause self-deadlock,
+ * because six locks themselves do not track which read locks are held by the
+ * current thread and which are held by a different thread - it does no
+ * per-thread tracking of held locks.
+ *
+ * The upper layer that is tracking held locks may however, if trylock() has
+ * failed, count up its own read locks, subtract them, take the write lock, and
+ * then re-add them.
+ *
+ * As in any other situation when taking a write lock, @lock must be held for
+ * intent one (or more) times, so @lock will never be left unlocked.
+ */
+void six_lock_readers_add(struct six_lock *lock, int nr)
+{
+	if (lock->readers) {
+		this_cpu_add(*lock->readers, nr);
+	} else {
+		EBUG_ON((int) (atomic_read(&lock->state) & SIX_LOCK_HELD_read) + nr < 0);
+		/* reader count starts at bit 0 */
+		atomic_add(nr, &lock->state);
+	}
+}
+EXPORT_SYMBOL_GPL(six_lock_readers_add);
+
+/**
+ * six_lock_exit - release resources held by a lock prior to freeing
+ * @lock:	lock to exit
+ *
+ * When a lock was initialized in percpu mode (SIX_OLCK_INIT_PCPU), this is
+ * required to free the percpu read counts.
+ */
+void six_lock_exit(struct six_lock *lock)
+{
+	WARN_ON(lock->readers && pcpu_read_count(lock));
+	WARN_ON(atomic_read(&lock->state) & SIX_LOCK_HELD_read);
+
+	free_percpu(lock->readers);
+	lock->readers = NULL;
+
+	struct six_lock_wait_fifo *wf = rcu_dereference_protected(lock->wait_fifo, true);
+	if (wf != (struct six_lock_wait_fifo *) &lock->inline_fifo)
+		kfree(wf);
+	RCU_INIT_POINTER(lock->wait_fifo, NULL);
+#ifdef CONFIG_BCACHEFS_DEBUG
+	darray_exit(&lock->owner_stack);
+#endif
+}
+EXPORT_SYMBOL_GPL(six_lock_exit);
+
+void __six_lock_init(struct six_lock *lock, const char *name,
+		     struct lock_class_key *key, enum six_lock_init_flags flags,
+		     gfp_t gfp)
+{
+	atomic_set(&lock->state, 0);
+	raw_spin_lock_init(&lock->wait_lock);
+	lock->inline_fifo.size		= ARRAY_SIZE(lock->inline_fifo_data);
+	lock->inline_fifo.nr		= 0;
+	lock->inline_fifo.next_free_hint = 0;
+	RCU_INIT_POINTER(lock->wait_fifo,
+			 (struct six_lock_wait_fifo *) &lock->inline_fifo);
+#ifdef CONFIG_DEBUG_LOCK_ALLOC
+	debug_check_no_locks_freed((void *) lock, sizeof(*lock));
+	lockdep_init_map(&lock->dep_map, name, key, 0);
+#endif
+
+	/*
+	 * Don't assume that we have real percpu variables available in
+	 * userspace:
+	 */
+#ifdef __KERNEL__
+	if (flags & SIX_LOCK_INIT_PCPU) {
+		/*
+		 * We don't return an error here on memory allocation failure
+		 * since percpu is an optimization, and locks will work with the
+		 * same semantics in non-percpu mode: callers can check for
+		 * failure if they wish by checking lock->readers, but generally
+		 * will not want to treat it as an error.
+		 */
+		lock->readers = alloc_percpu_gfp(unsigned, gfp);
+	}
+#endif
+}
+EXPORT_SYMBOL_GPL(__six_lock_init);
diff --git a/fs/bcachefs/util/six.h b/fs/bcachefs/util/six.h
new file mode 100644
index 0000000..2154aa0
--- /dev/null
+++ b/fs/bcachefs/util/six.h
@@ -0,0 +1,396 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+
+#ifndef _LINUX_SIX_H
+#define _LINUX_SIX_H
+
+/**
+ * DOC: SIX locks overview
+ *
+ * Shared/intent/exclusive locks: sleepable read/write locks, like rw semaphores
+ * but with an additional state: read/shared, intent, exclusive/write
+ *
+ * The purpose of the intent state is to allow for greater concurrency on tree
+ * structures without deadlocking. In general, a read can't be upgraded to a
+ * write lock without deadlocking, so an operation that updates multiple nodes
+ * will have to take write locks for the full duration of the operation.
+ *
+ * But by adding an intent state, which is exclusive with other intent locks but
+ * not with readers, we can take intent locks at the start of the operation,
+ * and then take write locks only for the actual update to each individual
+ * nodes, without deadlocking.
+ *
+ * Example usage:
+ *   six_lock_read(&foo->lock);
+ *   six_unlock_read(&foo->lock);
+ *
+ * An intent lock must be held before taking a write lock:
+ *   six_lock_intent(&foo->lock);
+ *   six_lock_write(&foo->lock);
+ *   six_unlock_write(&foo->lock);
+ *   six_unlock_intent(&foo->lock);
+ *
+ * Other operations:
+ *   six_trylock_read()
+ *   six_trylock_intent()
+ *   six_trylock_write()
+ *
+ *   six_lock_downgrade()	convert from intent to read
+ *   six_lock_tryupgrade()	attempt to convert from read to intent, may fail
+ *
+ * There are also interfaces that take the lock type as an enum:
+ *
+ *   six_lock_type(&foo->lock, SIX_LOCK_read);
+ *   six_trylock_convert(&foo->lock, SIX_LOCK_read, SIX_LOCK_intent)
+ *   six_lock_type(&foo->lock, SIX_LOCK_write);
+ *   six_unlock_type(&foo->lock, SIX_LOCK_write);
+ *   six_unlock_type(&foo->lock, SIX_LOCK_intent);
+ *
+ * Lock sequence numbers - unlock(), relock():
+ *
+ *   Locks embed sequences numbers, which are incremented on write lock/unlock.
+ *   This allows locks to be dropped and the retaken iff the state they protect
+ *   hasn't changed; this makes it much easier to avoid holding locks while e.g.
+ *   doing IO or allocating memory.
+ *
+ *   Example usage:
+ *     six_lock_read(&foo->lock);
+ *     u32 seq = six_lock_seq(&foo->lock);
+ *     six_unlock_read(&foo->lock);
+ *
+ *     some_operation_that_may_block();
+ *
+ *     if (six_relock_read(&foo->lock, seq)) { ... }
+ *
+ *   If the relock operation succeeds, it is as if the lock was never unlocked.
+ *
+ * Reentrancy:
+ *
+ *   Six locks are not by themselves reentrant, but have counters for both the
+ *   read and intent states that can be used to provide reentrancy by an upper
+ *   layer that tracks held locks. If a lock is known to already be held in the
+ *   read or intent state, six_lock_increment() can be used to bump the "lock
+ *   held in this state" counter, increasing the number of unlock calls that
+ *   will be required to fully unlock it.
+ *
+ *   Example usage:
+ *     six_lock_read(&foo->lock);
+ *     six_lock_increment(&foo->lock, SIX_LOCK_read);
+ *     six_unlock_read(&foo->lock);
+ *     six_unlock_read(&foo->lock);
+ *   foo->lock is now fully unlocked.
+ *
+ *   Since the intent state supercedes read, it's legal to increment the read
+ *   counter when holding an intent lock, but not the reverse.
+ *
+ *   A lock may only be held once for write: six_lock_increment(.., SIX_LOCK_write)
+ *   is not legal.
+ *
+ * should_sleep_fn:
+ *
+ *   There is a six_lock() variant that takes a function pointer that is called
+ *   immediately prior to schedule() when blocking, and may return an error to
+ *   abort.
+ *
+ *   One possible use for this feature is when objects being locked are part of
+ *   a cache and may reused, and lock ordering is based on a property of the
+ *   object that will change when the object is reused - i.e. logical key order.
+ *
+ *   If looking up an object in the cache may race with object reuse, and lock
+ *   ordering is required to prevent deadlock, object reuse may change the
+ *   correct lock order for that object and cause a deadlock. should_sleep_fn
+ *   can be used to check if the object is still the object we want and avoid
+ *   this deadlock.
+ *
+ * Wait list entry interface:
+ *
+ *   There is a six_lock() variant, six_lock_waiter(), that takes a pointer to a
+ *   wait list entry. By embedding six_lock_waiter into another object, and by
+ *   traversing lock waitlists, it is then possible for an upper layer to
+ *   implement full cycle detection for deadlock avoidance.
+ *
+ *   should_sleep_fn should be used for invoking the cycle detector, walking the
+ *   graph of held locks to check for a deadlock. The upper layer must track
+ *   held locks for each thread, and each thread's held locks must be reachable
+ *   from its six_lock_waiter object.
+ *
+ *   six_lock_waiter() will add the wait object to the waitlist re-trying taking
+ *   the lock, and before calling should_sleep_fn, and the wait object will not
+ *   be removed from the waitlist until either the lock has been successfully
+ *   acquired, or we aborted because should_sleep_fn returned an error.
+ *
+ *   Also, six_lock_waiter contains a timestamp, and waiters on a waitlist will
+ *   have timestamps in strictly ascending order - this is so the timestamp can
+ *   be used as a cursor for lock graph traverse.
+ */
+
+#include <linux/lockdep.h>
+#include <linux/sched.h>
+#include <linux/types.h>
+
+#include "util/fifo.h"
+#include "util/util.h"
+
+#include "enum_kind.h"
+#include "util/six_gen.h"
+
+/*
+ * Wait list entry: cached {waiter pointer, start_time + lock_want} pair.
+ * Keeping start_time and lock_want in the slot lets the wakeup scan filter
+ * and pick the oldest matching waiter without dereffing each six_lock_waiter
+ * — only the chosen one is touched via @w.
+ *
+ * Low SIX_LOCK_WANT_BITS bits of @start_time hold lock_want; the remaining
+ * high bits hold trans_start_time shifted up. Time comparisons among waiters
+ * of the same lock_want are unaffected — the low bits are equal — so callers
+ * can compare @start_time directly without masking.
+ */
+#define SIX_LOCK_WANT_BITS	2
+#define SIX_LOCK_WANT_MASK	((1U << SIX_LOCK_WANT_BITS) - 1)
+
+void six_lock_exit(struct six_lock *lock);
+
+void __six_lock_init(struct six_lock *lock, const char *name,
+		     struct lock_class_key *key, enum six_lock_init_flags flags,
+		     gfp_t gfp);
+
+/**
+ * six_lock_init - initialize a six lock
+ * @lock:	lock to initialize
+ * @flags:	optional flags, i.e. SIX_LOCK_INIT_PCPU
+ */
+#define six_lock_init(lock, flags, gfp)					\
+do {									\
+	static struct lock_class_key __key;				\
+									\
+	__six_lock_init((lock), #lock, &__key, flags, gfp);			\
+} while (0)
+
+/**
+ * six_lock_seq - obtain current lock sequence number
+ * @lock:	six_lock to obtain sequence number for
+ *
+ * @lock should be held for read or intent, and not write
+ *
+ * By saving the lock sequence number, we can unlock @lock and then (typically
+ * after some blocking operation) attempt to relock it: the relock will succeed
+ * if the sequence number hasn't changed, meaning no write locks have been taken
+ * and state corresponding to what @lock protects is still valid.
+ */
+static inline u32 six_lock_seq(const struct six_lock *lock)
+{
+	return lock->seq;
+}
+
+bool six_trylock_ip(struct six_lock *lock, enum six_lock_type type, unsigned long ip);
+
+/**
+ * six_trylock_type - attempt to take a six lock without blocking
+ * @lock:	lock to take
+ * @type:	SIX_LOCK_read, SIX_LOCK_intent, or SIX_LOCK_write
+ *
+ * Return: true on success, false on failure.
+ */
+static inline bool six_trylock_type(struct six_lock *lock, enum six_lock_type type)
+{
+	return six_trylock_ip(lock, type, _THIS_IP_);
+}
+
+int six_lock_ip_waiter(struct six_lock *lock, enum six_lock_type type,
+		       struct six_lock_waiter *wait,
+		       six_lock_should_sleep_fn should_sleep_fn,
+		       unsigned long ip);
+
+/*
+ * As six_lock_ip_waiter(), but skip the initial trylock and go straight
+ * to the waitlist slowpath. Use this when the caller has already done a
+ * trylock and observed contention (e.g. btree_node_lock dispatching
+ * to btree_node_lock_nopath after its own fast-path trylock failed) —
+ * avoids burning a second locked CAS on a lock state we already know
+ * is contended.
+ */
+int six_lock_contended(struct six_lock *lock, enum six_lock_type type,
+				 struct six_lock_waiter *wait,
+				 six_lock_should_sleep_fn should_sleep_fn,
+				 unsigned long ip);
+
+/**
+ * six_lock_waiter - take a lock, with full waitlist interface
+ * @lock:	lock to take
+ * @type:	SIX_LOCK_read, SIX_LOCK_intent, or SIX_LOCK_write
+ * @wait:	pointer to wait object, which will be added to lock's waitlist
+ * @should_sleep_fn: callback run after adding to waitlist, immediately prior
+ *		to scheduling
+ * @p:		passed through to @should_sleep_fn
+ *
+ * This is a convenience wrapper around six_lock_ip_waiter(), see that function
+ * for full documentation.
+ *
+ * Return: 0 on success, or the return code from @should_sleep_fn on failure.
+ */
+static inline int six_lock_waiter(struct six_lock *lock, enum six_lock_type type,
+				  struct six_lock_waiter *wait,
+				  six_lock_should_sleep_fn should_sleep_fn)
+{
+	return six_lock_ip_waiter(lock, type, wait, should_sleep_fn, _THIS_IP_);
+}
+
+#if 0
+/**
+ * six_lock_ip - take a six lock lock
+ * @lock:	lock to take
+ * @type:	SIX_LOCK_read, SIX_LOCK_intent, or SIX_LOCK_write
+ * @should_sleep_fn: callback run after adding to waitlist, immediately prior
+ *		to scheduling
+ * @p:		passed through to @should_sleep_fn
+ * @ip:		ip parameter for lockdep/lockstat, i.e. _THIS_IP_
+ *
+ * Return: 0 on success, or the return code from @should_sleep_fn on failure.
+ */
+static inline int six_lock_ip(struct six_lock *lock, enum six_lock_type type,
+			      six_lock_should_sleep_fn should_sleep_fn, void *p,
+			      unsigned long ip)
+{
+	struct six_lock_waiter wait = {};
+
+	return six_lock_ip_waiter(lock, type, &wait, should_sleep_fn, ip);
+}
+
+/**
+ * six_lock_type - take a six lock lock
+ * @lock:	lock to take
+ * @type:	SIX_LOCK_read, SIX_LOCK_intent, or SIX_LOCK_write
+ * @should_sleep_fn: callback run after adding to waitlist, immediately prior
+ *		to scheduling
+ * @p:		passed through to @should_sleep_fn
+ *
+ * Return: 0 on success, or the return code from @should_sleep_fn on failure.
+ */
+static inline int six_lock_type(struct six_lock *lock, enum six_lock_type type,
+				six_lock_should_sleep_fn should_sleep_fn, void *p)
+{
+	struct six_lock_waiter wait;
+
+	return six_lock_ip_waiter(lock, type, &wait, should_sleep_fn, _THIS_IP_);
+}
+#endif
+
+bool six_relock_ip(struct six_lock *lock, enum six_lock_type type,
+		   unsigned seq, unsigned long ip);
+
+/**
+ * six_relock_type - attempt to re-take a lock that was held previously
+ * @lock:	lock to take
+ * @type:	SIX_LOCK_read, SIX_LOCK_intent, or SIX_LOCK_write
+ * @seq:	lock sequence number obtained from six_lock_seq() while lock was
+ *		held previously
+ *
+ * Return: true on success, false on failure.
+ */
+static inline bool six_relock_type(struct six_lock *lock, enum six_lock_type type,
+				   unsigned seq)
+{
+	return six_relock_ip(lock, type, seq, _THIS_IP_);
+}
+
+void six_unlock_ip(struct six_lock *lock, enum six_lock_type type, unsigned long ip);
+
+/**
+ * six_unlock_type - drop a six lock
+ * @lock:	lock to unlock
+ * @type:	SIX_LOCK_read, SIX_LOCK_intent, or SIX_LOCK_write
+ *
+ * When a lock is held multiple times (because six_lock_incement()) was used),
+ * this decrements the 'lock held' counter by one.
+ *
+ * For example:
+ * six_lock_read(&foo->lock);				read count 1
+ * six_lock_increment(&foo->lock, SIX_LOCK_read);	read count 2
+ * six_lock_unlock(&foo->lock, SIX_LOCK_read);		read count 1
+ * six_lock_unlock(&foo->lock, SIX_LOCK_read);		read count 0
+ */
+static inline void six_unlock_type(struct six_lock *lock, enum six_lock_type type)
+{
+	six_unlock_ip(lock, type, _THIS_IP_);
+}
+
+#define __SIX_TRYLOCK(type)						\
+static inline bool six_trylock_ip_##type(struct six_lock *lock, unsigned long ip)\
+{									\
+	return six_trylock_ip(lock, SIX_LOCK_##type, ip);		\
+}									\
+									\
+static inline bool six_trylock_##type(struct six_lock *lock)		\
+{									\
+	return six_trylock_ip(lock, SIX_LOCK_##type, _THIS_IP_);	\
+}
+
+#define __SIX_RELOCK(type)						\
+static inline bool six_relock_ip_##type(struct six_lock *lock, u32 seq, unsigned long ip)\
+{									\
+	return six_relock_ip(lock, SIX_LOCK_##type, seq, ip);		\
+}									\
+									\
+static inline bool six_relock_##type(struct six_lock *lock, u32 seq)	\
+{									\
+	return six_relock_ip(lock, SIX_LOCK_##type, seq, _THIS_IP_);	\
+}
+
+#define __SIX_UNLOCK(type)							\
+										\
+static inline void six_unlock_ip_##type(struct six_lock *lock, unsigned long ip)\
+{										\
+	six_unlock_ip(lock, SIX_LOCK_##type, ip);				\
+}										\
+										\
+static inline void six_unlock_##type(struct six_lock *lock)			\
+{										\
+	six_unlock_ip(lock, SIX_LOCK_##type, _THIS_IP_);			\
+}
+
+#define __SIX_LOCK(type)						\
+static inline int six_lock_ip_waiter_##type(struct six_lock *lock,	\
+			   struct six_lock_waiter *wait,		\
+			   six_lock_should_sleep_fn should_sleep_fn,	\
+			   unsigned long ip)				\
+{									\
+	return six_lock_ip_waiter(lock, SIX_LOCK_##type, wait, should_sleep_fn, ip);\
+}									\
+									\
+static inline int six_lock_ip_##type(struct six_lock *lock,		\
+		    six_lock_should_sleep_fn should_sleep_fn,		\
+		    unsigned long ip)					\
+{									\
+	return six_lock_ip(lock, SIX_LOCK_##type, should_sleep_fn, ip);\
+}									\
+									\
+static inline int six_lock_##type(struct six_lock *lock)		\
+{									\
+	return six_lock_ip_##type(lock, NULL, NULL, _THIS_IP_);		\
+}									\
+
+__SIX_TRYLOCK(read)
+__SIX_TRYLOCK(intent)
+__SIX_TRYLOCK(write)
+
+__SIX_RELOCK(read)
+__SIX_RELOCK(intent)
+__SIX_RELOCK(write)
+
+__SIX_UNLOCK(read)
+__SIX_UNLOCK(intent)
+__SIX_UNLOCK(write)
+#undef __SIX_LOCK
+
+void six_lock_downgrade(struct six_lock *);
+bool six_lock_tryupgrade(struct six_lock *);
+bool six_trylock_convert(struct six_lock *, enum six_lock_type,
+			 enum six_lock_type);
+
+void six_lock_increment(struct six_lock *, enum six_lock_type);
+
+void six_lock_wakeup_all(struct six_lock *);
+
+struct six_lock_count six_lock_counts(struct six_lock *);
+void six_lock_readers_add(struct six_lock *, int);
+
+#endif /* _LINUX_SIX_H */
diff --git a/fs/bcachefs/util/six_types.rs b/fs/bcachefs/util/six_types.rs
new file mode 100644
index 0000000..1c633d3
--- /dev/null
+++ b/fs/bcachefs/util/six_types.rs
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::types::c_default;
+use core::ffi::{c_int, c_uint};
+use core::sync::atomic::AtomicI32;
+use cstruct_macros::{c_const, c_enum, c_typedef, CStruct};
+
+c_enum! {
+    #[closed]
+    pub enum six_lock_type: u32 {
+        SIX_LOCK_read,
+        SIX_LOCK_intent,
+        SIX_LOCK_write,
+    }
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, CStruct)]
+pub struct six_lock_waiter {
+    pub trans_start_time: u64,
+    pub task: *mut c::task_struct,
+    pub lock_want: c::six_lock_type,
+    pub lock_acquired: bool,
+    /* Index in wait_fifo->data[], set on insert, used for O(1) self-remove. */
+    pub slot_idx: u16,
+}
+c_default!(six_lock_waiter);
+
+#[repr(C)]
+#[derive(Clone, Copy, CStruct)]
+pub struct six_lock_wait_slot {
+    pub w: *mut c::six_lock_waiter,
+    pub start_time: u64,
+}
+c_default!(six_lock_wait_slot);
+
+/*
+ * RCU-swappable wait list. Not a FIFO — entries sit at fixed indices from
+ * insertion to removal, so RCU readers (the cycle detector) never observe an
+ * entry moving. Removal writes NULL atomically; insertion finds a free slot
+ * (starting from @next_free_hint) and fills it. @nr is the high-water-mark
+ * index in use and shrinks when trailing slots go tombstone.
+ *
+ * Grown by allocating a new struct, copying fields + entries, then
+ * rcu_assign_pointer'ing the lock's wait_fifo to the new object. Old
+ * heap allocations are kvfree_rcu'd so future lockless readers can
+ * outrun the free.
+ */
+#[repr(C)]
+#[derive(Clone, Copy, Default, CStruct)]
+pub struct six_lock_wait_fifo {
+    pub size: u16,
+    pub nr: u16,
+    pub next_free_hint: u16,
+    pub data: [c::six_lock_wait_slot; 0],
+}
+
+c_const! {
+    #[c_int]
+    pub const SIX_LOCK_INLINE_WAITERS: u32 = 8;
+}
+
+#[repr(C)]
+#[derive(CStruct)]
+pub struct six_lock {
+    pub state: AtomicI32,
+    pub seq: u32,
+    #[c("unsigned __percpu *readers")]
+    pub readers: *mut c_uint,
+    pub intent_lock_recurse: c_uint,
+    pub write_lock_recurse: c_uint,
+    pub owner: *mut c::task_struct,
+    #[cfg(CONFIG_BCACHEFS_DEBUG)]
+    pub owner_stack: c::bch_stacktrace,
+    pub wait_lock: c::raw_spinlock_t,
+
+    #[c("struct six_lock_wait_fifo __rcu *wait_fifo")]
+    pub wait_fifo: *mut c::six_lock_wait_fifo,
+
+    pub inline_fifo: c::six_lock_wait_fifo,
+    pub inline_fifo_data: [c::six_lock_wait_slot; c::SIX_LOCK_INLINE_WAITERS as usize],
+    #[cfg(CONFIG_DEBUG_LOCK_ALLOC)]
+    pub dep_map: c::lockdep_map,
+}
+c_default!(six_lock);
+
+c_typedef! {
+    pub type six_lock_should_sleep_fn = Option<unsafe extern "C" fn(lock: *mut c::six_lock,
+                                                                    *mut c::six_lock_waiter) -> c_int>;
+}
+
+c_enum! {
+    #[flags]
+    pub enum six_lock_init_flags: u32 {
+        SIX_LOCK_INIT_PCPU = 1 << 0,
+    }
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, CStruct)]
+pub struct six_lock_count {
+    pub n: [c_uint; 3],
+}
diff --git a/fs/bcachefs/util/sleep.rs b/fs/bcachefs/util/sleep.rs
new file mode 100644
index 0000000..433df0f
--- /dev/null
+++ b/fs/bcachefs/util/sleep.rs
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! sleep_until(): the loop every wait is - set the task state, check the
+//! condition, schedule() - with the condition a closure, and no wait queue.
+//! Whatever makes the condition true wakes the task itself: through a Waker
+//! it was handed - task_waker(), below - or a futex_wake().
+//!
+//! The state is set before the check, so a wake landing between the check
+//! and schedule() makes schedule() return at once: no wakeup is lost. The
+//! condition runs in that state, not TASK_RUNNING, so it mustn't sleep.
+//!
+//! How a sleep may end is in its type: Sleep<Infallible> - uninterruptible,
+//! no timeout - only ends with the condition true, and sleep_until() says so,
+//! as Result<T, Infallible>: `let Ok(v) = sleep_until(..)`. Interruptible,
+//! killable and timed sleeps are Sleep<SleepError>.
+//!
+//! A timeout is in jiffies, for the whole sleep, not each pass: what
+//! schedule_timeout() returns, the time left, is the next pass's.
+
+use crate::c;
+use core::convert::Infallible;
+use core::ffi::{c_long, c_uint, c_ulong};
+use core::marker::PhantomData;
+use core::task::{RawWaker, RawWakerVTable, Waker};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SleepError {
+    /// A signal, for an interruptible sleep - a fatal one, for a killable
+    Signal,
+    Timeout,
+}
+
+/// How to sleep: the task state, and whether it's counted as waiting on IO.
+/// E is what ending without the condition true is: Infallible when it can't.
+#[derive(Clone, Copy)]
+pub struct Sleep<E = Infallible> {
+    state:   c_uint,
+    io:      bool,
+    timeout: c_long,
+    _e:      PhantomData<E>,
+}
+
+/// MAX_SCHEDULE_TIMEOUT: no timeout
+const FOREVER: c_long = c_long::MAX;
+
+impl<E> Sleep<E> {
+    const fn state(state: u32) -> Self {
+        Sleep { state: state as c_uint, io: false, timeout: FOREVER, _e: PhantomData }
+    }
+
+    pub const fn freezable(self) -> Self {
+        Sleep { state: self.state | c::TASK_FREEZABLE as c_uint, ..self }
+    }
+
+    /// io_schedule(): counted as iowait, as wait_on_bit_io() is.
+    pub const fn io(self) -> Self {
+        Sleep { io: true, ..self }
+    }
+
+    pub const fn timeout(self, jiffies: c_ulong) -> Sleep<SleepError> {
+        let timeout = if jiffies >= FOREVER as c_ulong { FOREVER - 1 } else { jiffies as c_long };
+        Sleep { state: self.state, io: self.io, timeout, _e: PhantomData }
+    }
+}
+
+impl Sleep<Infallible> {
+    pub const UNINTERRUPTIBLE: Self = Self::state(c::TASK_UNINTERRUPTIBLE);
+    /// Uninterruptible, without counting toward the load average or hung
+    /// task warnings: a wait that may be long and is expected to be.
+    pub const IDLE: Self = Self::state(c::TASK_IDLE);
+}
+
+impl Sleep<SleepError> {
+    pub const INTERRUPTIBLE: Self = Self::state(c::TASK_INTERRUPTIBLE);
+    pub const KILLABLE: Self = Self::state(c::TASK_KILLABLE);
+}
+
+/// SleepError, or Infallible: a sleep that can't end early never makes one.
+pub trait SleepEnd: sealed::Sealed {
+    fn early(e: SleepError) -> Self;
+}
+
+mod sealed {
+    pub trait Sealed {}
+    impl Sealed for super::SleepError {}
+    impl Sealed for core::convert::Infallible {}
+}
+
+impl SleepEnd for SleepError {
+    fn early(e: SleepError) -> Self {
+        e
+    }
+}
+
+impl SleepEnd for Infallible {
+    fn early(e: SleepError) -> Self {
+        unreachable!("an uninterruptible sleep with no timeout ended early: {e:?}")
+    }
+}
+
+/// Sleep, as @how says, until @cond returns Some - which it may at once.
+pub fn sleep_until<T, E: SleepEnd>(how: Sleep<E>, mut cond: impl FnMut() -> Option<T>) -> Result<T, E> {
+    #[cfg(kernel)]
+    ::kernel::task::might_sleep();
+
+    let mut left = how.timeout;
+    let ret = loop {
+        // SAFETY: our own state; set before the check
+        unsafe { c::bch2_set_current_state(how.state) };
+        if let Some(v) = cond() {
+            break Ok(v);
+        }
+        if left == 0 {
+            break Err(E::early(SleepError::Timeout));
+        }
+        if unsafe { c::bch2_signal_pending_state(how.state) } {
+            break Err(E::early(SleepError::Signal));
+        }
+        // SAFETY: in a sleeping state we set; a timeout of FOREVER is
+        // returned as is. `as _`: long is isize in the kernel's bindings,
+        // i64 in ours.
+        left = unsafe {
+            if how.io { c::io_schedule_timeout(left as _) } else { c::schedule_timeout(left as _) }
+        } as c_long;
+    };
+    unsafe { c::bch2_set_current_state_running() };
+    ret
+}
+
+/// A Waker for a blocking wait: wakes this task - current - and holds a ref
+/// on it, so whatever wakes it can do so after the waiter may have returned.
+pub fn task_waker() -> Waker {
+    // SAFETY: a ref on ourself, the Waker's
+    unsafe {
+        let task = c::bch2_current();
+        assert!(!task.is_null(), "a blocking wait needs a task - a kthread, in userspace");
+        c::get_task_struct(task);
+        Waker::from_raw(RawWaker::new(task.cast(), &TASK_WAKER))
+    }
+}
+
+static TASK_WAKER: RawWakerVTable = RawWakerVTable::new(task_clone, task_wake, task_wake_by_ref, task_drop);
+
+unsafe fn task_clone(p: *const ()) -> RawWaker {
+    // SAFETY: a task_waker()'s task, a ref held
+    unsafe { c::get_task_struct(p.cast_mut().cast()) };
+    RawWaker::new(p, &TASK_WAKER)
+}
+
+unsafe fn task_wake(p: *const ()) {
+    // SAFETY: an owned Waker: woken, then its ref put
+    unsafe {
+        task_wake_by_ref(p);
+        task_drop(p);
+    }
+}
+
+unsafe fn task_wake_by_ref(p: *const ()) {
+    // SAFETY: a ref held
+    unsafe { c::wake_up_process(p.cast_mut().cast()) };
+}
+
+unsafe fn task_drop(p: *const ()) {
+    // SAFETY: the Waker's ref
+    unsafe { c::put_task_struct(p.cast_mut().cast()) };
+}
+
+/// Wake C's sleepers on @wq - wait_event() and the like: wake_up(), a
+/// function in userspace's shim, a macro the kernel's bindings don't have.
+pub fn wake_up(wq: &c::wait_queue_head_t) {
+    let wq = core::ptr::from_ref(wq).cast_mut();
+    // SAFETY: a waitqueue is woken through a shared pointer, under its own
+    // lock
+    #[cfg(kernel)]
+    unsafe { c::__wake_up(wq, ::kernel::task::TASK_NORMAL, 1, core::ptr::null_mut()) };
+    #[cfg(not(kernel))]
+    unsafe { c::wake_up(wq) };
+}
diff --git a/fs/bcachefs/util/sort.rs b/fs/bcachefs/util/sort.rs
new file mode 100644
index 0000000..a5fe52b
--- /dev/null
+++ b/fs/bcachefs/util/sort.rs
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A sort for the kernel stack. core's sort_unstable() is a quicksort with a
+//! scratch buffer of elements in every level of its recursion: for a big
+//! element - a backpointer key - a frame's 3.5k, and a few levels
+//! overflow a 16k kernel stack. heapsort_by() is the kernel's sort(): in
+//! place, no recursion, O(n log n), not stable.
+
+use core::cmp::Ordering;
+
+/// @v sorted by @cmp, as sort_unstable_by().
+pub fn heapsort_by<T>(v: &mut [T], mut cmp: impl FnMut(&T, &T) -> Ordering) {
+    let mut sift_down = |v: &mut [T], mut node: usize| loop {
+        let mut child = 2 * node + 1;
+        if child >= v.len() {
+            break;
+        }
+        if child + 1 < v.len() && cmp(&v[child], &v[child + 1]) == Ordering::Less {
+            child += 1;
+        }
+        if cmp(&v[node], &v[child]) != Ordering::Less {
+            break;
+        }
+        v.swap(node, child);
+        node = child;
+    };
+
+    for i in (0..v.len() / 2).rev() {
+        sift_down(v, i);
+    }
+    for end in (1..v.len()).rev() {
+        v.swap(0, end);
+        sift_down(&mut v[..end], 0);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::heapsort_by;
+
+    // A wrong sort is silent: the backpointer scan would just walk out of
+    // order.
+    #[test]
+    fn heapsort_by_sorts() {
+        let mut s: u64 = 1;
+        for n in 0..200 {
+            let mut v: Vec<u32> = (0..n).map(|_| {
+                s = s.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+                (s >> 40) as u32 % 50
+            }).collect();
+            let mut want = v.clone();
+            want.sort_unstable_by(|a, b| b.cmp(a));
+            heapsort_by(&mut v, |a, b| b.cmp(a));
+            assert_eq!(v, want, "n = {n}");
+        }
+    }
+}
diff --git a/fs/bcachefs/util/strided.rs b/fs/bcachefs/util/strided.rs
new file mode 100644
index 0000000..dc565be
--- /dev/null
+++ b/fs/bcachefs/util/strided.rs
@@ -0,0 +1,229 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Arrays whose elements are a runtime stride apart, not size_of::<T>():
+//! members_v2's, each member member_bytes - fewer than ours if an older
+//! version wrote it, more if a newer one did.
+//!
+//! Element i is the stride bytes from i * stride, its slot. A slot reads as a
+//! View - zero past the end of a short one, the rest of a long one ignored -
+//! and is the T itself only if it holds all of it. Every slot is in the bytes,
+//! checked at new(): an index past them is None, never a read past the end.
+//!
+//! StridedBuf owns its slots, for a table built and rebuilt in memory -
+//! c->replicas, its entries all the size of the biggest. What a slot holds is
+//! its owner's to read; an index is one the owner has, so past the end is a
+//! bug, as a slice's.
+
+use crate::util::alloc::{flags, AllocError, KVVec};
+use crate::util::projections::View;
+use crate::util::vstructs::{cast_plain_mut, Plain};
+use core::marker::PhantomData;
+
+pub struct Strided<'a, T> {
+    bytes:  &'a [u8],
+    stride: usize,
+    _t:     PhantomData<&'a T>,
+}
+
+pub struct StridedMut<'a, T> {
+    bytes:  &'a mut [u8],
+    stride: usize,
+    _t:     PhantomData<&'a mut T>,
+}
+
+fn slots_len(len: usize, stride: usize) -> Option<usize> {
+    (stride != 0).then(|| len / stride * stride)
+}
+
+impl<'a, T: Plain> Strided<'a, T> {
+    /// None if @stride is 0.
+    pub fn new(bytes: &'a [u8], stride: usize) -> Option<Self> {
+        let len = slots_len(bytes.len(), stride)?;
+        Some(Strided { bytes: &bytes[..len], stride, _t: PhantomData })
+    }
+
+    pub fn len(&self) -> usize {
+        self.bytes.len() / self.stride
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.bytes.is_empty()
+    }
+
+    pub fn stride(&self) -> usize {
+        self.stride
+    }
+
+    pub fn get(&self, i: usize) -> Option<View<'a, T>> {
+        let at = i.checked_mul(self.stride)?;
+        self.bytes.get(at..at + self.stride).map(View::new)
+    }
+}
+
+impl<'a, T: Plain> StridedMut<'a, T> {
+    /// None if @stride is 0.
+    pub fn new(bytes: &'a mut [u8], stride: usize) -> Option<Self> {
+        let len = slots_len(bytes.len(), stride)?;
+        Some(StridedMut { bytes: &mut bytes[..len], stride, _t: PhantomData })
+    }
+
+    /// @nr slots re-laid out from @from bytes apart to @to, top down so none
+    /// is overwritten before it moves, each one's new bytes zeroed.
+    pub fn grow(bytes: &'a mut [u8], nr: usize, from: usize, to: usize) -> Option<Self> {
+        if from == 0 || to < from || nr.checked_mul(to)? > bytes.len() {
+            return None;
+        }
+        for i in (0..nr).rev() {
+            bytes.copy_within(i * from..(i + 1) * from, i * to);
+            bytes[i * to + from..(i + 1) * to].fill(0);
+        }
+        Self::new(&mut bytes[..nr * to], to)
+    }
+
+    pub fn slot_bytes_mut(&mut self, i: usize) -> Option<&mut [u8]> {
+        let at = i.checked_mul(self.stride)?;
+        self.bytes.get_mut(at..at + self.stride)
+    }
+
+    /// Element @i itself, if its slot holds all of it.
+    pub fn into_whole_mut(self, i: usize) -> Option<&'a mut T> {
+        let at = i.checked_mul(self.stride)?;
+        cast_plain_mut(self.bytes.get_mut(at..at + self.stride)?)
+    }
+}
+
+pub struct StridedBuf {
+    bytes:  KVVec<u8>,
+    stride: usize,
+}
+
+impl StridedBuf {
+    pub const fn new() -> Self {
+        StridedBuf { bytes: KVVec::new(), stride: 0 }
+    }
+
+    /// @nr slots of @stride bytes, zeroed.
+    pub fn zeroed(nr: usize, stride: usize) -> Result<Self, AllocError> {
+        let len = nr.checked_mul(stride).ok_or(AllocError)?;
+        Ok(StridedBuf { bytes: KVVec::from_elem(0, len, flags::GFP_KERNEL)?, stride })
+    }
+
+    pub fn len(&self) -> usize {
+        self.bytes.len().checked_div(self.stride).unwrap_or(0)
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.bytes.is_empty()
+    }
+
+    pub fn stride(&self) -> usize {
+        self.stride
+    }
+
+    pub fn slot(&self, i: usize) -> &[u8] {
+        &self.bytes[i * self.stride..(i + 1) * self.stride]
+    }
+
+    pub fn slot_mut(&mut self, i: usize) -> &mut [u8] {
+        &mut self.bytes[i * self.stride..(i + 1) * self.stride]
+    }
+
+    pub fn slots(&self) -> impl Iterator<Item = &[u8]> {
+        (0..self.len()).map(|i| self.slot(i))
+    }
+
+    pub fn swap(&mut self, i: usize, j: usize) {
+        if i != j {
+            let (lo, hi) = (i.min(j), i.max(j));
+            let (a, b) = self.bytes.split_at_mut(hi * self.stride);
+            a[lo * self.stride..(lo + 1) * self.stride].swap_with_slice(&mut b[..self.stride]);
+        }
+    }
+
+    /// Slot @from's bytes, over slot @to's.
+    pub fn copy(&mut self, from: usize, to: usize) {
+        self.bytes.copy_within(from * self.stride..(from + 1) * self.stride, to * self.stride);
+    }
+
+    pub fn truncate(&mut self, nr: usize) {
+        self.bytes.truncate(nr * self.stride);
+    }
+
+    /// A copy, @extra slots more, each @stride bytes - no fewer than ours:
+    /// each slot of ours at the start of its, the rest zero.
+    pub fn restrided(&self, stride: usize, extra: usize) -> Result<Self, AllocError> {
+        assert!(stride >= self.stride);
+        let mut new = Self::zeroed(self.len() + extra, stride)?;
+        for (i, s) in self.slots().enumerate() {
+            new.slot_mut(i)[..s.len()].copy_from_slice(s);
+        }
+        Ok(new)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::util::vstructs::{plain_bytes, plain_bytes_mut};
+
+    #[repr(C)]
+    #[derive(Clone, Copy, Default, Debug, PartialEq, cstruct_macros::Plain)]
+    struct Pair {
+        a: u32,
+        b: u32,
+    }
+
+    /// A short slot reads as zero past its end, a long one's extra bytes are
+    /// skipped, and only a slot that holds all of one is one.
+    #[test]
+    fn strides() {
+        let w: [u32; 3] = [1, 2, 3];
+        let s = Strided::<Pair>::new(plain_bytes(&w[..]), 4).unwrap();
+        assert_eq!(s.get(1).unwrap().get(), Pair { a: 2, b: 0 });
+        assert!(s.get(3).is_none());
+
+        let mut w: [u32; 6] = [1, 2, 9, 3, 4, 9];
+        let s = Strided::<Pair>::new(plain_bytes(&w[..]), 12).unwrap();
+        assert_eq!(s.get(1).unwrap().get(), Pair { a: 3, b: 4 });
+        assert!(Strided::<Pair>::new(plain_bytes(&w[..]), 0).is_none());
+
+        let s = StridedMut::<Pair>::new(plain_bytes_mut(&mut w[..]), 12).unwrap();
+        s.into_whole_mut(1).unwrap().a = 7;
+        assert_eq!(w, [1, 2, 9, 7, 4, 9]);
+        assert!(StridedMut::<Pair>::new(plain_bytes_mut(&mut w[..]), 4).unwrap().into_whole_mut(0).is_none());
+    }
+
+    /// Each slot keeps its bytes, zero past them; past the slots, nothing's
+    /// touched.
+    #[test]
+    fn grow() {
+        let mut w: [u32; 7] = [1, 2, 3, 9, 9, 9, 8];
+        StridedMut::<Pair>::grow(plain_bytes_mut(&mut w[..]), 3, 4, 8).unwrap();
+        assert_eq!(w, [1, 0, 2, 0, 3, 0, 8]);
+
+        let mut w: [u32; 4] = [1, 2, 3, 4];
+        assert!(StridedMut::<Pair>::grow(plain_bytes_mut(&mut w[..]), 3, 4, 8).is_none());
+        assert!(StridedMut::<Pair>::grow(plain_bytes_mut(&mut w[..]), 2, 8, 4).is_none());
+        assert_eq!(w, [1, 2, 3, 4]);
+    }
+
+    /// A restride keeps each slot's bytes at its start, zero after; swap and
+    /// copy move whole slots.
+    #[test]
+    fn buf() {
+        let mut b = StridedBuf::zeroed(3, 2).unwrap();
+        for i in 0..3 {
+            b.slot_mut(i).copy_from_slice(&[i as u8 + 1, 9]);
+        }
+        b.swap(0, 2);
+        b.copy(1, 0);
+        assert!(b.slots().eq([&[2, 9][..], &[2, 9], &[1, 9]]));
+
+        let r = b.restrided(3, 1).unwrap();
+        assert!(r.slots().eq([&[2, 9, 0][..], &[2, 9, 0], &[1, 9, 0], &[0, 0, 0]]));
+
+        b.truncate(1);
+        assert_eq!(b.len(), 1);
+        assert_eq!(StridedBuf::new().len(), 0);
+    }
+}
diff --git a/fs/bcachefs/util/sysfs.rs b/fs/bcachefs/util/sysfs.rs
new file mode 100644
index 0000000..144cb37
--- /dev/null
+++ b/fs/bcachefs/util/sysfs.rs
@@ -0,0 +1,302 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! sysfs files in Rust.
+//!
+//! A directory - a Dir - is a kobject in some object T, a bch_fs or a bch_dev,
+//! and its files. Usually those are a table of Attr<T>: the C struct
+//! attribute sysfs sees (name, mode) with its show and store beside it, the
+//! kernel's kobj_attribute pattern - so the directory's sysfs_ops get from
+//! the attribute sysfs hands them to its handlers by container_of(), and from
+//! the kobject to T by the kobject's offset in T. A directory of one file per
+//! list entry has a ListAttrs instead, and one whose files are something
+//! else's attributes - options' - overrides Dir::show() and store().
+//!
+//! C has the files as `struct attribute *foo_files[]` (Files) and the ops as
+//! a `struct sysfs_ops` (ops()), for init's kobj_types.
+//!
+//! A show writes to a Printbuf, which goes to sysfs's page with a trailing
+//! newline, cut at PAGE_SIZE - 1 - ENOMEM if the printbuf couldn't allocate.
+//! A store gets what was written - with the newline echo leaves - and takes
+//! all of it or fails.
+//!
+//! kernfs won't open a file for a direction its mode doesn't allow - root
+//! included - so a missing show or store is never called.
+
+use core::ffi::CStr;
+
+use crate::c;
+use crate::errcode::{ret_to_result_void, BchError};
+use crate::util::ffi::{c_char, with_cstr};
+use crate::util::Printbuf;
+
+pub type Show<T>  = fn(&T, &mut Printbuf);
+pub type Store<T> = fn(&T, &str) -> Result<(), BchError>;
+
+/// A sysfs file of an object T: its C attribute, and what reading and writing
+/// it do.
+#[repr(C)]
+pub struct Attr<T: 'static> {
+    attr:  c::attribute,
+    show:  Option<Show<T>>,
+    store: Option<Store<T>>,
+}
+
+impl<T> Attr<T> {
+    const fn new(name: &'static CStr, mode: u16, show: Option<Show<T>>, store: Option<Store<T>>) -> Self {
+        // SAFETY: the rest of a struct attribute is lockdep's, zeroed for a
+        // static one
+        let mut attr: c::attribute = unsafe { core::mem::zeroed() };
+        attr.name = name.as_ptr().cast();
+        attr.mode = mode;
+        Attr { attr, show, store }
+    }
+
+    /// 0444
+    pub const fn ro(name: &'static CStr, show: Show<T>) -> Self {
+        Self::new(name, 0o444, Some(show), None)
+    }
+
+    /// 0200
+    pub const fn wo(name: &'static CStr, store: Store<T>) -> Self {
+        Self::new(name, 0o200, None, Some(store))
+    }
+
+    /// 0644
+    pub const fn rw(name: &'static CStr, show: Show<T>, store: Store<T>) -> Self {
+        Self::new(name, 0o644, Some(show), Some(store))
+    }
+}
+
+/// A directory's files as C has them: an array of pointers to each Attr's
+/// attribute, NULL terminated. N is the number of files plus one -
+/// `Files<{ FOO.len() + 1 }>`.
+#[repr(transparent)]
+pub struct Files<const N: usize>([*const c::attribute; N]);
+
+impl<const N: usize> Files<N> {
+    pub const fn new<T>(attrs: &'static [Attr<T>]) -> Self {
+        assert!(attrs.len() + 1 == N);
+
+        let mut files = [core::ptr::null(); N];
+        let mut i = 0;
+        while i < attrs.len() {
+            files[i] = &raw const attrs[i].attr;
+            i += 1;
+        }
+        Files(files)
+    }
+}
+
+/// One file per entry of a list - a counter, a time stat - each alike, so an
+/// attribute and nothing beside it: which entry a file is, from where its
+/// attribute is in the array. A static, for that: a const's copies would be
+/// at other addresses.
+#[repr(transparent)]
+pub struct ListAttrs<const N: usize>([c::attribute; N]);
+
+// SAFETY: its pointers are to static names; nothing writes it
+unsafe impl<const N: usize> Sync for ListAttrs<N> {}
+
+impl<const N: usize> ListAttrs<N> {
+    pub const fn new(names: &[&'static CStr; N], mode: u16) -> Self {
+        Self::with_modes(names, &[mode; N])
+    }
+
+    /// Each entry's file, with a mode of its own.
+    pub const fn with_modes(names: &[&'static CStr; N], modes: &[u16; N]) -> Self {
+        // SAFETY: as Attr::new()'s
+        let mut attrs: [c::attribute; N] = unsafe { core::mem::zeroed() };
+        let mut i = 0;
+        while i < N {
+            attrs[i].name = names[i].as_ptr().cast();
+            attrs[i].mode = modes[i];
+            i += 1;
+        }
+        ListAttrs(attrs)
+    }
+
+    /// Entry @i's attribute.
+    pub fn get(&'static self, i: usize) -> &'static c::attribute {
+        &self.0[i]
+    }
+
+    /// The entry @attr is the file of, if it's one of these.
+    pub fn index(&self, attr: &c::attribute) -> Option<usize> {
+        let i = (core::ptr::from_ref(attr) as usize)
+            .wrapping_sub(self.0.as_ptr() as usize) / size_of::<c::attribute>();
+        (i < N && core::ptr::eq(&self.0[i], attr)).then_some(i)
+    }
+}
+
+impl<const N: usize> Files<N> {
+    /// A ListAttrs' files - M of them, N = M + 1.
+    pub const fn list<const M: usize>(attrs: &'static ListAttrs<M>) -> Self {
+        assert!(M + 1 == N);
+
+        let mut files = [core::ptr::null(); N];
+        let mut i = 0;
+        while i < M {
+            files[i] = &raw const attrs.0[i];
+            i += 1;
+        }
+        Files(files)
+    }
+}
+
+/// A directory: the kobject it is, what it asks of every store, and how its
+/// files read and write - by default, as the Attr<Obj>s they are.
+///
+/// # Safety
+/// ops::<Self>() is only ever the sysfs_ops of the kobject KOBJ bytes into an
+/// Obj; and its files are Attr<Obj>s, unless show and store are overridden.
+pub unsafe trait Dir: 'static {
+    type Obj: 'static;
+
+    /// The directory's kobject's offset in Obj.
+    const KOBJ: usize;
+
+    /// Before any store: may refuse it.
+    fn may_store(_obj: &Self::Obj) -> Result<(), BchError> {
+        Ok(())
+    }
+
+    fn show(obj: &Self::Obj, attr: &c::attribute, out: &mut Printbuf) -> Result<(), BchError> {
+        // SAFETY: the trait's: this is an Attr<Obj>'s
+        unsafe { attr_show(obj, attr, out) }
+    }
+
+    fn store(obj: &Self::Obj, attr: &c::attribute, s: &str) -> Result<(), BchError> {
+        // SAFETY: the trait's: this is an Attr<Obj>'s
+        unsafe { attr_store(obj, attr, s) }
+    }
+}
+
+/// Reading @attr, an Attr<T>'s: Dir's default, for one whose own show()
+/// has some other files too.
+///
+/// # Safety
+/// @attr is an Attr<T>'s.
+pub unsafe fn attr_show<T: 'static>(obj: &T, attr: &c::attribute, out: &mut Printbuf) -> Result<(), BchError> {
+    let attr = unsafe { &*core::ptr::from_ref(attr).cast::<Attr<T>>() };
+    if let Some(show) = attr.show {
+        show(obj, out);
+    }
+    Ok(())
+}
+
+/// Writing @attr, an Attr<T>'s: as attr_show().
+///
+/// # Safety
+/// @attr is an Attr<T>'s.
+pub unsafe fn attr_store<T: 'static>(obj: &T, attr: &c::attribute, s: &str) -> Result<(), BchError> {
+    let attr = unsafe { &*core::ptr::from_ref(attr).cast::<Attr<T>>() };
+    match attr.store {
+        Some(store) => store(obj, s),
+        None        => Err(c::EINVAL.into()),
+    }
+}
+
+/// A Dir's sysfs_ops.
+pub const fn ops<D: Dir>() -> c::sysfs_ops {
+    c::sysfs_ops {
+        show:  Some(show::<D>),
+        store: Some(store::<D>),
+    }
+}
+
+/// The object @kobj is D's kobject in: container_of().
+///
+/// # Safety
+/// @kobj is D's kobject, in a live D::Obj.
+pub unsafe fn obj_of<'a, D: Dir>(kobj: *mut c::kobject) -> &'a D::Obj {
+    unsafe { &*kobj.byte_sub(D::KOBJ).cast::<D::Obj>() }
+}
+
+unsafe extern "C" fn show<D: Dir>(kobj: *mut c::kobject, attr: *mut c::attribute,
+                                  buf: *mut c_char) -> isize {
+    // SAFETY: ops()'s, which only D's kobject has; sysfs's attribute and page
+    unsafe {
+        let obj = obj_of::<D>(kobj);
+        show_page(buf, |out| D::show(obj, &*attr, out))
+    }
+}
+
+unsafe extern "C" fn store<D: Dir>(kobj: *mut c::kobject, attr: *mut c::attribute,
+                                   buf: *const c_char, size: usize) -> isize {
+    // SAFETY: ops()'s, which only D's kobject has
+    let obj = unsafe { obj_of::<D>(kobj) };
+    if let Err(e) = D::may_store(obj) {
+        return e.class() as isize;
+    }
+    // SAFETY: sysfs's attribute, and buffer of @size bytes
+    unsafe { store_buf(buf, size, |s| D::store(obj, &*attr, s)) }
+}
+
+/// A show: what @f writes - into sysfs's page @buf itself, cut off at its end -
+/// or @f's error, as an errno.
+///
+/// # Safety
+/// @buf is a PAGE_SIZE buffer.
+pub unsafe fn show_page(buf: *mut c_char, f: impl FnOnce(&mut Printbuf) -> Result<(), BchError>) -> isize {
+    // SAFETY: the caller's
+    let mut out = unsafe { Printbuf::new_extern(buf, crate::util::kernel::PAGE_SIZE) };
+
+    match f(&mut out) {
+        Ok(()) => {
+            out.ensure_trailing_newline();
+            out.as_bytes().len() as isize
+        }
+        Err(e) => e.class() as isize,
+    }
+}
+
+/// A store: @f given what was written, @size bytes at @buf - all of it taken
+/// if @f succeeds. Not UTF-8 is EINVAL.
+///
+/// # Safety
+/// @buf has @size bytes.
+pub unsafe fn store_buf(buf: *const c_char, size: usize,
+                        f: impl FnOnce(&str) -> Result<(), BchError>) -> isize {
+    // SAFETY: the caller's
+    let bytes = unsafe { core::slice::from_raw_parts(buf.cast::<u8>(), size) };
+    let ret = core::str::from_utf8(bytes)
+        .map_err(|_| BchError::from(c::EINVAL))
+        .and_then(f);
+
+    match ret {
+        Ok(())  => size as isize,
+        Err(e)  => e.class() as isize,
+    }
+}
+
+/// A number with an optional unit suffix - 4k, 1M: bch2_strtoull_h().
+pub fn parse_human_u64(s: &str) -> Result<u64, BchError> {
+    let mut v = 0;
+    with_cstr(s, |s| ret_to_result_void(unsafe { c::bch2_strtoull_h(s.as_ptr().cast(), &mut v) }))??;
+    Ok(v)
+}
+
+/// Add @attr's file to @kobj - one made at runtime, not in its kobj_type's
+/// groups: sysfs_create_file().
+///
+/// # Safety
+/// @kobj is live and added, and its sysfs_ops handle @attr.
+pub unsafe fn create_file(kobj: *mut c::kobject, attr: &'static c::attribute) -> Result<(), BchError> {
+    ret_to_result_void(unsafe { c::bch2_sysfs_create_file(kobj, attr) })
+}
+
+/// What a store writes as a number: kstrto*(), base 10 - one trailing newline
+/// allowed, ERANGE if it doesn't fit @T.
+pub fn parse_int<T>(s: &str) -> Result<T, BchError>
+    where T: core::str::FromStr<Err = core::num::ParseIntError>
+{
+    use core::num::IntErrorKind;
+
+    s.strip_suffix('\n').unwrap_or(s)
+        .parse()
+        .map_err(|e: core::num::ParseIntError| match e.kind() {
+            IntErrorKind::PosOverflow |
+            IntErrorKind::NegOverflow => c::ERANGE.into(),
+            _                         => c::EINVAL.into(),
+        })
+}
diff --git a/fs/bcachefs/util/task.rs b/fs/bcachefs/util/task.rs
new file mode 100644
index 0000000..3215393
--- /dev/null
+++ b/fs/bcachefs/util/task.rs
@@ -0,0 +1,1188 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! An async executor: spawn() a future as a task on a workqueue, and await
+//! its JoinHandle - or join_sync() it from a thread - for what it returns.
+//! What's spawned is what makes the future, `move || work(fs, x)`: it's
+//! made in place, in the task's allocation, and never moved after - so a big
+//! one is never on the spawner's stack, which may be deep in a write path.
+//! An awaited future isn't: rustc makes it on the stack of whoever polls,
+//! and moves it into its awaiter. So what's big is the spawned future's own
+//! - its locals, made in place with stack_pin_init!() - and what it awaits
+//! borrows it.
+//!
+//! Every await says where its task resumes: what we await - a Gather's
+//! wait(), a JoinHandle - isn't a Future until .resume_on() makes it one:
+//!
+//! ```ignore
+//! let ret = g.wait().resume_on(Resume::Queue(wq)).await;
+//! ```
+//!
+//! Resume::Queue resumes the task on that workqueue; Resume::Thread on the
+//! task's own kthread - spawn_thread()'s, kept for its life, for work that
+//! blocks, seen in ps by its name; Resume::Spawned where it was spawned, for
+//! a future that may be spawned either way - an UpdateTask, on a run queue or
+//! a queue. Resume::Inline resumes it right where it's woken - in the waker's context, an endio's - as C's
+//! continue_at(cl, fn, NULL) does: no hop through a workqueue, for a
+//! continuation that's cheap and safe there. What runs inline is everything
+//! up to the next await, and the drops of the task's locals if it ends
+//! there: none of it may sleep, or take a lock that isn't irqsave - as for
+//! a C continuation with no workqueue, unchecked.
+//!
+//! How: the Waker a task is polled with points at it. Inline is a tag bit
+//! in that pointer, so each wake carries its own - under join!(), a wake
+//! that isn't inline never resumes the task in an endio. A Queue is
+//! recorded in the task by the await, while it's pending: a wake without
+//! the tag dispatches there - or, for a future we didn't write, awaited
+//! without resume_on(), to where it was spawned. A thread's dispatch is a
+//! flag and wake_up_process(): safe from an endio, as queue_work() is.
+//!
+//! A RunQueue's tasks run only when its owner calls run() - in its waits - so
+//! on the owner's thread, between its own steps, rather than competing with
+//! it from a workqueue: a mover's updates are its tasks. A dispatch
+//! pushes the task on a lockless stack - from any context, an endio's - and
+//! wakes the queue's EventCount; run() takes the stack whole and runs it
+//! oldest first, in the order the tasks were woken.
+//!
+//! A task's state is one word: SCHEDULED, RUNNING, NOTIFIED, COMPLETE, and
+//! a refcount. It's what keeps a task from being polled twice at once - not
+//! the workqueue's non-reentrancy, which an inline wake doesn't go through.
+//! A wake that finds it idle schedules it; one that finds it running marks
+//! it NOTIFIED, and the poll in progress repolls when it's done - in place,
+//! if the wake was inline or the poll is running where the task's to
+//! resume; otherwise it dispatches it there.
+//!
+//! A task holds a ref on itself until it completes: dropping its Wakers
+//! never drops it, so its future is never dropped from a waker's context. A
+//! task pending forever with nothing to wake it - a lost wakeup - is leaked,
+//! not freed. Its memory is kmalloc()'d: the last ref may be dropped in an
+//! endio. It's dropped there, and freed a grace period later, by
+//! kvfree_rcu() - safe anywhere - so what's in a task may be found under RCU:
+//! a data update's key in the in-flight table, by a lookup that read it
+//! before it left.
+//!
+//! Or a task's made in its home - spawn_home() - one allocation with what it's
+//! the task of, held from outside by a TaskHome: a ref on the task, so the
+//! two go with the last of them, and the task's free to run in its home to
+//! the end, its owner gone or not.
+//!
+//! What a task returns is the JoinHandle's; dropped, the task's detached,
+//! and what it returns is dropped when it completes, in its context. The
+//! JoinHandle's wait is a Gather - the task holds one ref, put when it
+//! completes.
+
+use crate::c;
+use crate::errcode::{errptr_to_result, BchError};
+use crate::util::alloc::{flags, kalloc_pinned_gfp, AllocError, Flags};
+use crate::util::futex::EventCount;
+use crate::util::gather::{Gather, GatherRef};
+use crate::util::kthread::Kthread;
+use crate::util::sleep::{sleep_until, Sleep};
+use crate::util::workqueue::Queue;
+use crate::util::Printbuf;
+use core::cell::UnsafeCell;
+use core::ffi::{c_int, c_void};
+use core::fmt;
+use core::future::Future;
+use core::marker::PhantomPinned;
+use core::mem::{ManuallyDrop, MaybeUninit};
+use core::pin::Pin;
+use core::ptr::NonNull;
+use core::sync::atomic::{AtomicPtr, AtomicUsize, Ordering};
+use core::task::{Context, Poll, RawWaker, RawWakerVTable, Waker};
+use pin_init::{pin_data, pin_init, PinInit};
+
+/// Where a task resumes, once what it awaits is done.
+#[derive(Clone, Copy)]
+pub enum Resume<'a> {
+    /// In the waker's context - an endio's, perhaps: see the module notes.
+    Inline,
+    Queue(&'a Queue),
+    /// On the task's own kthread: a task spawn_thread() made.
+    Thread,
+    /// Where it was spawned - its Queue, its thread, its RunQueue.
+    Spawned,
+}
+
+/// What's awaited once it's said where to resume: resume_on() makes it a
+/// Future. Ours - Gather::wait(), JoinHandle - aren't Futures otherwise; any
+/// Future is one too, so resume_on() is how every await reads.
+pub trait Resumable {
+    type Output;
+
+    fn poll_resume(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output>;
+
+    fn resume_on(self, r: Resume<'_>) -> Resumed<'_, Self>
+    where
+        Self: Sized,
+    {
+        Resumed { inner: self, target: r, recorded: None }
+    }
+}
+
+impl<F: Future> Resumable for F {
+    type Output = F::Output;
+
+    fn poll_resume(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<F::Output> {
+        Future::poll(self, cx)
+    }
+}
+
+/// A Resumable, awaitable: resume_on()'s.
+#[must_use = "a future does nothing unless awaited"]
+pub struct Resumed<'r, A> {
+    inner:    A,
+    target:   Resume<'r>,
+    /// The task, and where we recorded it's to resume, to clear when we're
+    /// done.
+    recorded: Option<(NonNull<Header>, usize)>,
+}
+
+// SAFETY: @recorded is a task's header - atomics - and only touched while
+// the task's alive, which we're part of
+unsafe impl<A: Send> Send for Resumed<'_, A> {}
+unsafe impl<A: Sync> Sync for Resumed<'_, A> {}
+
+impl<A: Resumable> Future for Resumed<'_, A> {
+    type Output = A::Output;
+
+    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<A::Output> {
+        // SAFETY: @inner is structurally pinned - never moved out, dropped in
+        // place - and the rest isn't
+        let this = unsafe { self.get_unchecked_mut() };
+        let inner = unsafe { Pin::new_unchecked(&mut this.inner) };
+
+        // Not one of our tasks - block_on()'s, say: nowhere to record it
+        let Some(task) = header_of(cx.waker()) else {
+            return inner.poll_resume(cx);
+        };
+
+        // SAFETY: we're being polled by it: it's alive
+        let hr = unsafe { task.as_ref() };
+        let tag = match this.target {
+            Resume::Inline => INLINE,
+            r => {
+                let at = match r {
+                    Resume::Queue(q) => core::ptr::from_ref(q) as usize,
+                    Resume::Thread => {
+                        assert!(!hr.thread.is_null(), "Resume::Thread in a task without a thread: spawn_thread() it");
+                        THREAD
+                    }
+                    Resume::Spawned => hr.spawned,
+                    Resume::Inline => unreachable!(),
+                };
+                hr.next.store(at, Ordering::Release);
+                this.recorded = Some((task, at));
+                0
+            }
+        };
+        // SAFETY: borrowed for the poll, never dropped: a clone is a ref
+        let waker = ManuallyDrop::new(unsafe { waker_raw(task, tag) });
+        inner.poll_resume(&mut Context::from_waker(&waker))
+    }
+}
+
+impl<A> Drop for Resumed<'_, A> {
+    fn drop(&mut self) {
+        // Done with: an untagged wake mustn't find our queue - it's only
+        // borrowed - unless an await since has recorded it again
+        if let Some((task, q)) = self.recorded {
+            // SAFETY: we're in its future: it's alive
+            let _ = unsafe { task.as_ref() }.next.compare_exchange(q, 0, Ordering::Release,
+                                                                    Ordering::Relaxed);
+        }
+    }
+}
+
+/* The state word: */
+/// Dispatched - queued, or being run inline - and not yet running.
+const SCHEDULED:       usize = 1 << 0;
+const RUNNING:         usize = 1 << 1;
+/// Woken while being polled, by a wake that wasn't inline.
+const NOTIFIED:        usize = 1 << 2;
+/// Woken while being polled, inline.
+const NOTIFIED_INLINE: usize = 1 << 3;
+const COMPLETE:        usize = 1 << 4;
+/// The JoinHandle's still there: what's returned is its.
+const JOIN:            usize = 1 << 5;
+/// One ref: the task's own until it completes, the JoinHandle's, each Waker's.
+const REF:             usize = 1 << 6;
+
+/// The Waker tag for Resume::Inline: tasks are aligned well past it.
+const INLINE: usize = 1;
+
+/// Where a task's to resume, or was spawned, or is: a Queue's address, or
+/// this - no Queue's - for its kthread, or a RunQueue's address tagged RUNQ.
+const THREAD: usize = 1;
+const RUNQ:   usize = 2;
+
+/// What every task is, whatever its future: its work first, so a
+/// work_struct pointer is one to it - and, once the task's dropped, the
+/// rcu_head kvfree_rcu() frees it with.
+#[repr(C)]
+struct Header {
+    work:     c::work_struct,
+    state:    AtomicUsize,
+    /// Where a wake that isn't inline resumes it: what the await in
+    /// progress recorded, or 0 for @spawned.
+    next:     AtomicUsize,
+    /// A Queue, THREAD, or a RunQueue | RUNQ.
+    spawned:  usize,
+    /// Its kthread, if spawn_thread() made it, and a ref on it.
+    thread:   *mut c::task_struct,
+    /// Dispatched to its thread: the thread runs it.
+    thread_go: core::sync::atomic::AtomicBool,
+    /// Under it on a RunQueue's stack, while it's dispatched there.
+    rq_next:  AtomicPtr<Header>,
+    vtable:   &'static TaskVTable,
+}
+
+/// A task's own, by its future's type.
+struct TaskVTable {
+    /// Poll the future once; Ready, the task's complete - and maybe freed.
+    poll:    unsafe fn(NonNull<Header>, &mut Context<'_>) -> Poll<()>,
+    /// Drop and free it, never started: Unstarted's Drop.
+    discard: unsafe fn(NonNull<Header>),
+    dealloc: unsafe fn(NonNull<Header>),
+}
+
+/// The header and what a JoinHandle<T> reads, without the future's type.
+#[repr(C)]
+#[pin_data]
+struct TaskHead<T> {
+    header: Header,
+    /// The JoinHandle's wait: put once it's done.
+    #[pin]
+    done:   Gather<()>,
+    /// The task's ref on @done.
+    done_ref: UnsafeCell<Option<GatherRef<()>>>,
+    output: UnsafeCell<MaybeUninit<T>>,
+}
+
+#[repr(C)]
+#[pin_data]
+struct Task<F: Future> {
+    #[pin]
+    head:   TaskHead<F::Output>,
+    /// Made in place, pinned. Live until it returns - then dropped in place -
+    /// or, for a task never started, until it's discarded.
+    #[pin]
+    future: MaybeUninit<F>,
+}
+
+impl<F: Future> Task<F> {
+    const VTABLE: TaskVTable = TaskVTable {
+        poll:    Self::poll,
+        discard: Self::discard,
+        dealloc: Self::dealloc,
+    };
+
+    fn future_ptr(task: *mut Self) -> *mut F {
+        // SAFETY: a field of the task, by place
+        unsafe { (&raw mut (*task).future).cast() }
+    }
+
+    /// The future, pinned in the task.
+    ///
+    /// # Safety
+    /// @task is live, and its future live and ours: the task is RUNNING, or
+    /// was never started.
+    unsafe fn future<'a>(task: *mut Self) -> Pin<&'a mut F> {
+        // SAFETY: the caller's; made in the task, which never moves
+        unsafe { Pin::new_unchecked(&mut *Self::future_ptr(task)) }
+    }
+
+    /// # Safety
+    /// @h is a Task<F>'s, and we're its one poller: RUNNING is ours.
+    unsafe fn poll(h: NonNull<Header>, cx: &mut Context<'_>) -> Poll<()> {
+        let task = h.cast::<Self>().as_ptr();
+        // SAFETY: the caller's - and run() polls only what isn't COMPLETE
+        let f = unsafe { Self::future(task) };
+        match f.poll(cx) {
+            Poll::Pending => Poll::Pending,
+            Poll::Ready(v) => {
+                // SAFETY: returned: dropped, where it is, and never polled again
+                unsafe { core::ptr::drop_in_place(Self::future_ptr(task)) };
+                // SAFETY: ours, and never polled again
+                unsafe {
+                    (*(*task).head.output.get()).write(v);
+                    Self::complete(h);
+                }
+                Poll::Ready(())
+            }
+        }
+    }
+
+    /// The future returned: its output's the JoinHandle's - or dropped, if
+    /// there's none - the JoinHandle's woken, and the task's own ref dropped.
+    ///
+    /// # Safety
+    /// @h is a Task<F>'s, RUNNING ours, and its output just stored.
+    unsafe fn complete(h: NonNull<Header>) {
+        let task = h.cast::<Self>().as_ptr();
+        // SAFETY: the caller's
+        let hr = unsafe { h.as_ref() };
+
+        let mut s = hr.state.load(Ordering::Acquire);
+        loop {
+            let new = (s & !(RUNNING|NOTIFIED|NOTIFIED_INLINE)) | COMPLETE;
+            match hr.state.compare_exchange_weak(s, new, Ordering::AcqRel, Ordering::Acquire) {
+                Ok(_)    => break,
+                Err(cur) => s = cur,
+            }
+        }
+        if s & JOIN == 0 {
+            // SAFETY: complete, and the JoinHandle's gone: nobody takes it
+            unsafe { (*(*task).head.output.get()).assume_init_drop() };
+        }
+
+        // After COMPLETE: a JoinHandle woken by it, its output taken and it
+        // dropped, must find it complete - else we'd drop the output too
+        // SAFETY: the task's ref, taken once
+        unsafe { drop((*(*task).head.done_ref.get()).take()) };
+        if !hr.thread.is_null() {
+            // done: its thread exits - it has its own ref
+            // SAFETY: the task's ref on its thread
+            unsafe { c::wake_up_process(hr.thread) };
+        }
+        // SAFETY: the task's own ref
+        unsafe { put_ref(h) };
+    }
+
+    /// Its future dropped, unpolled, and its refs - its own, its JoinHandle's,
+    /// its thread's - put: freed, unless its home's still held.
+    ///
+    /// # Safety
+    /// @h is a Task<F>'s, made and never started, and Unstarted's.
+    unsafe fn discard(h: NonNull<Header>) {
+        let task = h.cast::<Self>().as_ptr();
+        // SAFETY: the caller's; its thread, if it has one, never woken: stopped,
+        // it exits without touching the task
+        unsafe {
+            let thread = (*task).head.header.thread;
+            if !thread.is_null() {
+                c::bch2_kthread_stop(thread);
+                c::put_task_struct(thread);
+                (*task).head.header.thread = core::ptr::null_mut();
+                put_ref(h);
+            }
+            core::ptr::drop_in_place(Self::future_ptr(task));
+            drop((*(*task).head.done_ref.get()).take());
+            put_ref(h);
+            put_ref(h);
+        }
+    }
+
+    /// Dropped now, freed after a grace period: see the top of the file.
+    ///
+    /// # Safety
+    /// @h is a Task<F>'s, and its last ref's gone.
+    unsafe fn dealloc(h: NonNull<Header>) {
+        let task = h.cast::<Self>().as_ptr();
+        // SAFETY: the caller's; kalloc_pinned()'s - kmalloc()'d, or in
+        // userspace malloc()'d, which kvfree_rcu() frees - with nothing after
+        // the drop reading its first bytes, the rcu_head
+        unsafe {
+            core::ptr::drop_in_place(task);
+            c::rust_kvfree_rcu(task.cast());
+        }
+    }
+}
+
+// ── A task in its home ──────────────────────────────────────────────────
+
+/// A task made in what it's the task of - one allocation, @home first - for
+/// something outside the task that holds @home while the task runs in it:
+/// TaskHome, a ref on the task. Freed with the last ref, @home's or the task's
+/// own - so a home outlives its task's last run, and a task its home's owner.
+#[repr(C)]
+#[pin_data]
+struct WithTask<H, F: Future> {
+    #[pin]
+    home: H,
+    #[pin]
+    task: Task<F>,
+}
+
+impl<H, F: Future> WithTask<H, F> {
+    const VTABLE: TaskVTable = TaskVTable {
+        poll:    Task::<F>::poll,
+        discard: Task::<F>::discard,
+        dealloc: Self::dealloc,
+    };
+
+    /// Dropped, @home and all, now; freed after a grace period, as a task is.
+    ///
+    /// # Safety
+    /// @h is the task's of a WithTask<H, F>, and its last ref's gone.
+    unsafe fn dealloc(h: NonNull<Header>) {
+        // SAFETY: the caller's: the header is first in the task, at @task
+        unsafe {
+            let w = h.as_ptr().byte_sub(core::mem::offset_of!(Self, task)).cast::<Self>();
+            core::ptr::drop_in_place(w);
+            c::rust_kvfree_rcu(w.cast());
+        }
+    }
+}
+
+/// A task's home, owned: @H, pinned, with a ref on the task it's in - see
+/// WithTask. Dropped, the ref's put; @H itself is dropped with the last, where
+/// that is - the task's last run, perhaps.
+pub struct TaskHome<H> {
+    home: NonNull<H>,
+    task: NonNull<Header>,
+}
+
+// SAFETY: it's shared, &H - and dropped, perhaps, where the last ref goes:
+// what's Send and Sync is anyone's; and the ref is an atomic's
+unsafe impl<H: Send + Sync> Send for TaskHome<H> {}
+unsafe impl<H: Send + Sync> Sync for TaskHome<H> {}
+
+impl<H> TaskHome<H> {
+    pub fn as_pin(&self) -> Pin<&H> {
+        // SAFETY: made in place, and never moved: freed only with the last ref
+        unsafe { Pin::new_unchecked(self.home.as_ref()) }
+    }
+}
+
+impl<H> core::ops::Deref for TaskHome<H> {
+    type Target = H;
+
+    fn deref(&self) -> &H {
+        // SAFETY: our ref keeps it
+        unsafe { self.home.as_ref() }
+    }
+}
+
+impl<H> Drop for TaskHome<H> {
+    fn drop(&mut self) {
+        // SAFETY: our ref
+        unsafe { put_ref(self.task) };
+    }
+}
+
+/// spawn_unstarted(), the task made in one allocation with @home - which it
+/// can borrow: @make makes its future from it - for the TaskHome that holds
+/// it from outside.
+///
+/// # Safety
+/// spawn_unstarted()'s, but for @home: the future's dropped before it is.
+pub unsafe fn spawn_home<'h, H, M, F>(at: Spawn<'_>, home: impl PinInit<H, BchError>, make: M, gfp: Flags)
+    -> Result<(TaskHome<H>, Unstarted<F::Output>), BchError>
+where
+    H: Send + Sync + 'h,
+    M: FnOnce(&'h H) -> F,
+    F: Future + Send,
+    F::Output: Send,
+{
+    let made = core::cell::Cell::new(None);
+    let mk = |spawned| {
+        // SAFETY: @slot is the WithTask's, ours to write: @home first, then
+        // the task, whose future may borrow it - so @home's there to borrow
+        let init = unsafe {
+            pin_init::pin_init_from_closure(move |slot: *mut WithTask<H, F>| {
+                crate::util::alloc::init_at(home, &raw mut (*slot).home)?;
+                let future = make(&*(&raw const (*slot).home));
+                let future = pin_init::pin_init_from_closure(move |f: *mut F| {
+                    f.write(future);
+                    Ok::<(), core::convert::Infallible>(())
+                });
+                let task = task_init(spawned, future, &WithTask::<H, F>::VTABLE, 1);
+                crate::util::alloc::init_at(task, &raw mut (*slot).task).map_err(|e| match e {})
+            })
+        };
+        let w = kalloc_pinned_gfp::<WithTask<H, F>, BchError>(init, gfp)?;
+        // SAFETY: just made: nobody else has it
+        let task = unsafe {
+            let task = &raw mut (*w).task;
+            finish(task);
+            task
+        };
+        made.set(Some(w));
+        Ok(task)
+    };
+    // SAFETY: the caller's
+    match unsafe { spawn_init(at, mk) } {
+        Ok((unstarted, _)) => {
+            let w = made.get().expect("a task made");
+            // SAFETY: just made, with a ref for its home: this
+            let home = unsafe {
+                TaskHome { home: NonNull::new_unchecked(&raw mut (*w).home),
+                           task: NonNull::new_unchecked((&raw mut (*w).task).cast()) }
+            };
+            Ok((home, unstarted))
+        }
+        Err(e) => {
+            // made, then discarded - its thread failed: freed with its home's ref
+            if let Some(w) = made.get() {
+                // SAFETY: the home's ref, never handed out
+                unsafe { put_ref(NonNull::new_unchecked((&raw mut (*w).task).cast())) };
+            }
+            Err(e)
+        }
+    }
+}
+
+/// Spawn the future @make makes on @wq - first polled there, and resumed
+/// there by a wake that hasn't said where - for its JoinHandle.
+pub fn spawn<M, F>(wq: &'static Queue, make: M) -> Result<JoinHandle<F::Output>, BchError>
+where
+    M: FnOnce() -> F + Send + 'static,
+    F: Future + Send + 'static,
+    F::Output: Send,
+{
+    // SAFETY: 'static: it borrows nothing
+    Ok(unsafe { spawn_unstarted(Spawn::Queue(wq), make) }?.start())
+}
+
+/// Spawn the future @make makes on a kthread of its own, named @name - first
+/// polled there, and resumed there by Resume::Thread, or a wake that hasn't
+/// said where. The thread's the task's till it's done, sleeping while it runs
+/// elsewhere.
+pub fn spawn_thread<M, F>(name: fmt::Arguments<'_>, make: M) -> Result<JoinHandle<F::Output>, BchError>
+where
+    M: FnOnce() -> F + Send + 'static,
+    F: Future + Send + 'static,
+    F::Output: Send,
+{
+    // SAFETY: 'static: it borrows nothing
+    Ok(unsafe { spawn_unstarted(Spawn::Thread { name, freezable: false }, make) }?.start())
+}
+
+/// Where a spawned task's first polled, and resumed by a wake that hasn't
+/// said where: spawn()'s, or spawn_thread()'s.
+#[derive(Clone, Copy)]
+pub enum Spawn<'a> {
+    Queue(&'a Queue),
+    /// Run by the queue's owner, when it calls run().
+    Run(Pin<&'a RunQueue>),
+    /// A kthread of its own, named; freezable, for a task that freezes in
+    /// place - see Kthread::set_freezable().
+    Thread { name: fmt::Arguments<'a>, freezable: bool },
+}
+
+/// A task made, to be started - or, dropped, discarded: its future dropped
+/// unpolled, its thread stopped unwoken.
+pub struct Unstarted<T> {
+    head: NonNull<TaskHead<T>>,
+}
+
+// SAFETY: as JoinHandle's: what it holds is a task, its output a T
+unsafe impl<T: Send> Send for Unstarted<T> {}
+
+impl<T> Unstarted<T> {
+    /// Dispatched, for its JoinHandle.
+    pub fn start(self) -> JoinHandle<T> {
+        let head = ManuallyDrop::new(self).head;
+        // SAFETY: made, not started: ours to dispatch
+        unsafe { dispatch(NonNull::new_unchecked(&raw mut (*head.as_ptr()).header), false) };
+        JoinHandle { head, wait: None, taken: false }
+    }
+}
+
+impl<T> Drop for Unstarted<T> {
+    fn drop(&mut self) {
+        // SAFETY: made, not started, and ours alone
+        unsafe {
+            let h = NonNull::new_unchecked(&raw mut (*self.head.as_ptr()).header);
+            (h.as_ref().vtable.discard)(h);
+        }
+    }
+}
+
+/// A task for the future @make makes, made - its thread too, if it's to have
+/// one - to be started.
+///
+/// # Safety
+/// What @make and its future borrow, and @at's Queue or RunQueue, outlive the task:
+/// whoever made it joins it - or drops it unstarted - before they're gone.
+/// spawn() and spawn_thread() are this for what's 'static.
+pub unsafe fn spawn_unstarted<M, F>(at: Spawn<'_>, make: M) -> Result<Unstarted<F::Output>, BchError>
+where
+    M: FnOnce() -> F + Send,
+    F: Future + Send,
+    F::Output: Send,
+{
+    // written straight into the task, by @make: never on our stack
+    // SAFETY: @slot is the future's place in the task, ours to write
+    let init = unsafe {
+        pin_init::pin_init_from_closure(move |slot: *mut F| {
+            slot.write(make());
+            Ok::<(), core::convert::Infallible>(())
+        })
+    };
+    // SAFETY: the caller's
+    unsafe { spawn_init(at, |spawned| self::make(spawned, init, flags::GFP_KERNEL)) }.map(|(task, _)| task)
+}
+
+/// spawn_unstarted(), with the future made in place by @init, for the
+/// spawner to finish setting up before the task starts: for a future C
+/// points into before its first poll.
+///
+/// # Safety
+/// spawn_unstarted()'s.
+pub unsafe fn spawn_unstarted_in_place<F>(at: Spawn<'_>, init: impl PinInit<F>, gfp: Flags)
+    -> Result<UnstartedInPlace<F>, BchError>
+where
+    F: Future + Send,
+    F::Output: Send,
+{
+    // SAFETY: the caller's
+    let (task, future) = unsafe { spawn_init(at, |spawned| self::make(spawned, init, gfp)) }?;
+    Ok(UnstartedInPlace { task, future })
+}
+
+/// From spawn_unstarted_in_place(): the future is the spawner's until the
+/// task starts. What C is left pointing into after that is between C and the
+/// future.
+pub struct UnstartedInPlace<F: Future> {
+    task:   Unstarted<F::Output>,
+    future: NonNull<F>,
+}
+
+impl<F: Future> UnstartedInPlace<F> {
+    pub fn future(&mut self) -> Pin<&mut F> {
+        // SAFETY: pinned in the task, which isn't started: ours alone
+        unsafe { Pin::new_unchecked(self.future.as_mut()) }
+    }
+
+    pub fn start(self) -> JoinHandle<F::Output> {
+        self.task.start()
+    }
+}
+
+/// The task @mk makes, given where it's spawned - its thread too, if it's to
+/// have one.
+///
+/// # Safety
+/// spawn_unstarted()'s.
+unsafe fn spawn_init<F>(at: Spawn<'_>, mk: impl FnOnce(usize) -> Result<*mut Task<F>, BchError>)
+    -> Result<(Unstarted<F::Output>, NonNull<F>), BchError>
+where
+    F: Future + Send,
+    F::Output: Send,
+{
+    let task = match at {
+        Spawn::Queue(wq) => mk(core::ptr::from_ref(wq) as usize)?,
+        Spawn::Run(rq) => mk(core::ptr::from_ref(rq.get_ref()) as usize | RUNQ)?,
+        Spawn::Thread { name, freezable } => {
+            let mut name_buf = Printbuf::new();
+            write!(name_buf, "{name}");
+
+            let task = mk(THREAD)?;
+            // SAFETY: just made; the thread's data, from when it's woken - and
+            // if it's stopped unwoken, it doesn't touch it
+            let thread = unsafe {
+                let h = &raw mut (*task).head.header;
+                let run = if freezable { run_thread::<true> } else { run_thread::<false> };
+                c::bch2_kthread_create(Some(run), h.cast(), name_buf.as_c_str().as_ptr().cast())
+            };
+            match errptr_to_result(NonNull::new(thread).expect("kthread_create() gives a task or an error")) {
+                // SAFETY: just made, and nobody else has it
+                Err(e) => unsafe {
+                    Task::<F>::discard(NonNull::new_unchecked(&raw mut (*task).head.header));
+                    return Err(e);
+                },
+                // SAFETY: a ref on the thread, the task's; and one on the task,
+                // the thread's; both before it can run
+                Ok(thread) => unsafe {
+                    c::get_task_struct(thread.as_ptr());
+                    let h = &raw mut (*task).head.header;
+                    (*h).thread = thread.as_ptr();
+                    (*h).state.fetch_add(REF, Ordering::Relaxed);
+                    task
+                },
+            }
+        }
+    };
+    // SAFETY: just made
+    unsafe {
+        Ok((Unstarted { head: NonNull::new_unchecked(&raw mut (*task).head) },
+            NonNull::new_unchecked(Task::<F>::future_ptr(task))))
+    }
+}
+
+/// A task, not yet started: its own ref and its JoinHandle's, and @refs more -
+/// its home's, for one made in a home.
+fn task_init<F>(spawned: usize, future: impl PinInit<F>, vtable: &'static TaskVTable, refs: usize)
+    -> impl PinInit<Task<F>>
+where
+    F: Future + Send,
+    F::Output: Send,
+{
+    // SAFETY: @slot is the future's place, a MaybeUninit<F> laid out as F
+    let future = unsafe {
+        pin_init::pin_init_from_closure(move |slot: *mut MaybeUninit<F>| {
+            crate::util::alloc::init_at(future, slot.cast::<F>())
+        })
+    };
+    pin_init!(Task::<F> {
+        head <- pin_init!(TaskHead {
+            header: Header {
+                // SAFETY: plain C; finish() initializes it
+                work:      unsafe { core::mem::zeroed() },
+                // dispatched by start()
+                state:     AtomicUsize::new((2 + refs) * REF | JOIN | SCHEDULED),
+                next:      AtomicUsize::new(0),
+                spawned,
+                thread:    core::ptr::null_mut(),
+                thread_go: core::sync::atomic::AtomicBool::new(false),
+                rq_next:   AtomicPtr::new(core::ptr::null_mut()),
+                vtable,
+            },
+            done <- Gather::new(),
+            done_ref: UnsafeCell::new(None),
+            output: UnsafeCell::new(MaybeUninit::uninit()),
+        }),
+        future <- future,
+    })
+}
+
+/// task_init()'s, finished in place: its ref on @done, and its work.
+///
+/// # Safety
+/// @task is just made, and nobody else has it.
+unsafe fn finish<F: Future>(task: *mut Task<F>) {
+    // SAFETY: the caller's
+    unsafe {
+        let head = &raw mut (*task).head;
+        *(*head).done_ref.get() = Some((*head).done.get());
+        c::bch2_init_work(&raw mut (*head).header.work, Some(run_work));
+    }
+}
+
+/// A task made, not yet started: its own ref and its JoinHandle's.
+fn make<F>(spawned: usize, future: impl PinInit<F>, gfp: Flags) -> Result<*mut Task<F>, BchError>
+where
+    F: Future + Send,
+    F::Output: Send,
+{
+    let init = task_init(spawned, future, &Task::<F>::VTABLE, 0);
+    // kmalloc()'d: the last ref may go in an endio. Its error - there's
+    // none - made the allocation's
+    // SAFETY: @init's own
+    let init = unsafe {
+        pin_init::pin_init_from_closure(move |slot| {
+            crate::util::alloc::init_at(init, slot).map_err(|e: core::convert::Infallible| match e {})
+        })
+    };
+    let task = kalloc_pinned_gfp::<Task<F>, AllocError>(init, gfp)?;
+    // SAFETY: just made
+    unsafe { finish(task) };
+    Ok(task)
+}
+
+/* Running a task: */
+
+/// Where a poll is running.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Here {
+    /// In a waker's context.
+    Inline,
+    /// Where a target says: a Queue, the task's thread, a RunQueue.
+    At(usize),
+}
+
+/// Where a wake that isn't inline resumes it.
+fn target(h: &Header) -> usize {
+    match h.next.load(Ordering::Acquire) {
+        0 => h.spawned,
+        q => q,
+    }
+}
+
+/// Run it, just SCHEDULED by us: polled here, if @inline, or queued.
+///
+/// # Safety
+/// @h is a live task's, and SCHEDULED by the caller.
+unsafe fn dispatch(h: NonNull<Header>, inline: bool) {
+    // SAFETY: the caller's
+    let hr = unsafe { h.as_ref() };
+    if inline {
+        // SAFETY: the caller's
+        unsafe { run(h, Here::Inline) };
+    } else {
+        let at = target(hr);
+        if at == THREAD {
+            hr.thread_go.store(true, Ordering::Release);
+            // SAFETY: the task's ref on its thread
+            unsafe { c::wake_up_process(hr.thread) };
+        } else if at & RUNQ != 0 {
+            // SAFETY: the RunQueue it was spawned on - only Resume::Spawned
+            // records one - which outlives it, spawn_unstarted()'s contract;
+            // SCHEDULED, so not on its stack already
+            unsafe { (*((at & !RUNQ) as *const RunQueue)).push(h) };
+        } else {
+            // SAFETY: a queue an await recorded, borrowed till it's done, or
+            // the task's 'static one; the work's the task's, alive till it's
+            // done - and SCHEDULED, so not on a queue already
+            unsafe { (*(at as *const Queue)).queue_work(h.as_ptr().cast()) };
+        }
+    }
+}
+
+unsafe extern "C" fn run_work(work: *mut c::work_struct) {
+    // SAFETY: a task's work, first in it, queued by dispatch() - to where
+    // it's to resume, which only a poll changes, and it's not been polled
+    let h = unsafe { NonNull::new_unchecked(work.cast::<Header>()) };
+    let here = Here::At(target(unsafe { h.as_ref() }));
+    unsafe { run(h, here) };
+}
+
+/// A task's kthread: runs it when it's dispatched here, till it's done -
+/// wherever that is. Holds a ref on it.
+unsafe extern "C" fn run_thread<const FREEZABLE: bool>(data: *mut c_void) -> c_int {
+    // Discarded, stopped before it was woken: the task's not ours to touch -
+    // in userspace, a stopped kthread runs anyway
+    if Kthread::should_stop() {
+        return 0;
+    }
+    let idle = if FREEZABLE {
+        Kthread::set_freezable();
+        Sleep::IDLE.freezable()
+    } else {
+        Sleep::IDLE
+    };
+    // SAFETY: spawn_unstarted()'s, and our ref keeps it
+    let h = unsafe { NonNull::new_unchecked(data.cast::<Header>()) };
+    let hr = unsafe { h.as_ref() };
+    loop {
+        // woken by a dispatch here, or by the task completing
+        let Ok(go) = sleep_until(idle, || {
+            if hr.thread_go.swap(false, Ordering::AcqRel) {
+                Some(true)
+            } else {
+                (hr.state.load(Ordering::Acquire) & COMPLETE != 0).then_some(false)
+            }
+        });
+        if !go {
+            break;
+        }
+        // SAFETY: dispatched here: SCHEDULED for us
+        unsafe { run(h, Here::At(THREAD)) };
+    }
+    // SAFETY: the thread's ref
+    unsafe { put_ref(h) };
+    0
+}
+
+/// Poll the task, until it's done or idle - or wants to run elsewhere.
+///
+/// # Safety
+/// @h is a live task's, and SCHEDULED for us.
+unsafe fn run(h: NonNull<Header>, here: Here) {
+    // SAFETY: the caller's
+    let hr = unsafe { h.as_ref() };
+
+    let mut s = hr.state.load(Ordering::Acquire);
+    loop {
+        debug_assert!(s & (SCHEDULED|RUNNING|COMPLETE) == SCHEDULED);
+        let new = (s & !(SCHEDULED|NOTIFIED|NOTIFIED_INLINE)) | RUNNING;
+        match hr.state.compare_exchange_weak(s, new, Ordering::AcqRel, Ordering::Acquire) {
+            Ok(_)    => break,
+            Err(cur) => s = cur,
+        }
+    }
+
+    loop {
+        // SAFETY: borrowed for the poll: a clone is a ref
+        let waker = ManuallyDrop::new(unsafe { waker_raw(h, 0) });
+        // SAFETY: RUNNING is ours; Ready, it's complete, and may be gone
+        if unsafe { (hr.vtable.poll)(h, &mut Context::from_waker(&waker)) }.is_ready() {
+            return;
+        }
+
+        // Pending: idle, unless woken meanwhile
+        let mut s = hr.state.load(Ordering::Acquire);
+        let repoll = loop {
+            let (new, repoll) = if s & NOTIFIED != 0 {
+                if here == Here::At(target(hr)) {
+                    (s & !(NOTIFIED|NOTIFIED_INLINE), true)
+                } else {
+                    // to run where it's to resume, not here
+                    ((s & !(RUNNING|NOTIFIED|NOTIFIED_INLINE)) | SCHEDULED, false)
+                }
+            } else if s & NOTIFIED_INLINE != 0 {
+                (s & !NOTIFIED_INLINE, true)
+            } else {
+                (s & !RUNNING, false)
+            };
+            match hr.state.compare_exchange_weak(s, new, Ordering::AcqRel, Ordering::Acquire) {
+                Ok(_) if repoll => break true,
+                Ok(_) => {
+                    if new & SCHEDULED != 0 {
+                        // SAFETY: SCHEDULED by us
+                        unsafe { dispatch(h, false) };
+                    }
+                    break false;
+                }
+                Err(cur) => s = cur,
+            }
+        };
+        if !repoll {
+            return;
+        }
+    }
+}
+
+/// # Safety
+/// @h is a live task's, and the caller has a ref to put.
+unsafe fn put_ref(h: NonNull<Header>) {
+    // SAFETY: the caller's
+    let hr = unsafe { h.as_ref() };
+    if hr.state.fetch_sub(REF, Ordering::AcqRel) & !(REF - 1) == REF {
+        if !hr.thread.is_null() {
+            // SAFETY: the task's ref on its thread - exited, or exiting
+            unsafe { c::put_task_struct(hr.thread) };
+        }
+        // SAFETY: the last ref
+        unsafe { (hr.vtable.dealloc)(h) };
+    }
+}
+
+/// Wake it: schedule it to run, if it's idle - inline, here, if @inline.
+///
+/// # Safety
+/// @h is a live task's.
+unsafe fn wake(h: NonNull<Header>, inline: bool) {
+    // SAFETY: the caller's
+    let hr = unsafe { h.as_ref() };
+
+    let mut s = hr.state.load(Ordering::Acquire);
+    loop {
+        let new = if s & (COMPLETE|SCHEDULED) != 0 {
+            return;
+        } else if s & RUNNING != 0 {
+            s | if inline { NOTIFIED_INLINE } else { NOTIFIED }
+        } else {
+            s | SCHEDULED
+        };
+        match hr.state.compare_exchange_weak(s, new, Ordering::AcqRel, Ordering::Acquire) {
+            Ok(_) => {
+                if new & SCHEDULED != 0 {
+                    // SAFETY: SCHEDULED by us; our caller's ref keeps it
+                    // alive, and so does its own till it's complete
+                    unsafe { dispatch(h, inline) };
+                }
+                return;
+            }
+            Err(cur) => s = cur,
+        }
+    }
+}
+
+/* Wakers: a task pointer, tagged INLINE or not. */
+
+static VTABLE: RawWakerVTable = RawWakerVTable::new(waker_clone, waker_wake, waker_wake_by_ref, waker_drop);
+
+/// The task a Waker of ours wakes, untagged.
+fn header_of(w: &Waker) -> Option<NonNull<Header>> {
+    core::ptr::eq(w.vtable(), &VTABLE).then(|| untag(w.data()).0)
+}
+
+/// # Safety
+/// @h is a live task's; the Waker owns a ref - or, borrowed, never drops.
+unsafe fn waker_raw(h: NonNull<Header>, tag: usize) -> Waker {
+    // SAFETY: the vtable's contract: below
+    unsafe { Waker::from_raw(RawWaker::new((h.as_ptr() as usize | tag) as *const (), &VTABLE)) }
+}
+
+fn untag(p: *const ()) -> (NonNull<Header>, bool) {
+    let p = p as usize;
+    (NonNull::new((p & !INLINE) as *mut Header).unwrap(), p & INLINE != 0)
+}
+
+unsafe fn waker_clone(p: *const ()) -> RawWaker {
+    let (h, _) = untag(p);
+    // SAFETY: a Waker's: the task's alive
+    unsafe { h.as_ref() }.state.fetch_add(REF, Ordering::Relaxed);
+    RawWaker::new(p, &VTABLE)
+}
+
+unsafe fn waker_wake(p: *const ()) {
+    // SAFETY: an owned Waker: woken, then its ref put
+    unsafe {
+        waker_wake_by_ref(p);
+        waker_drop(p);
+    }
+}
+
+unsafe fn waker_wake_by_ref(p: *const ()) {
+    let (h, inline) = untag(p);
+    // SAFETY: a Waker's: the task's alive
+    unsafe { wake(h, inline) };
+}
+
+unsafe fn waker_drop(p: *const ()) {
+    // SAFETY: an owned Waker's ref
+    unsafe { put_ref(untag(p).0) };
+}
+
+/* Run queues */
+
+/// Pinned, as its tasks hold its address. Its owner joins them all before
+/// it's gone.
+pub struct RunQueue {
+    /// What's dispatched here, newest first, through rq_next.
+    head:    AtomicPtr<Header>,
+    /// Woken by every dispatch here: what the owner sleeps on.
+    events:  EventCount,
+    _pinned: PhantomPinned,
+}
+
+// SAFETY: a null stack and a zero count: an empty queue, as its owner's
+// zeroed init makes it
+unsafe impl ::pin_init::Zeroable for RunQueue {}
+
+impl RunQueue {
+    /// Woken by every dispatch, and whatever else the owner wakes it with.
+    pub fn events(&self) -> &EventCount {
+        &self.events
+    }
+
+    pub fn has_ready(&self) -> bool {
+        !self.head.load(Ordering::Acquire).is_null()
+    }
+
+    /// # Safety
+    /// @h is a live task's, SCHEDULED for here.
+    unsafe fn push(&self, h: NonNull<Header>) {
+        // SAFETY: the caller's: SCHEDULED, ours till it's run
+        let hr = unsafe { h.as_ref() };
+        let mut head = self.head.load(Ordering::Relaxed);
+        loop {
+            hr.rq_next.store(head, Ordering::Relaxed);
+            match self.head.compare_exchange_weak(head, h.as_ptr(), Ordering::Release, Ordering::Relaxed) {
+                Ok(_)    => break,
+                Err(cur) => head = cur,
+            }
+        }
+        self.events.wake();
+    }
+
+    /// Only one thread may run it. What's dispatched meanwhile waits for the
+    /// next run().
+    pub fn run(self: Pin<&Self>) {
+        let mut next = self.head.swap(core::ptr::null_mut(), Ordering::Acquire);
+
+        // pushed newest first: reversed, for the order they were woken
+        let mut oldest = core::ptr::null_mut::<Header>();
+        while let Some(h) = NonNull::new(next) {
+            // SAFETY: on our stack: dispatched here, and ours to run
+            let hr = unsafe { h.as_ref() };
+            next = hr.rq_next.load(Ordering::Relaxed);
+            hr.rq_next.store(oldest, Ordering::Relaxed);
+            oldest = h.as_ptr();
+        }
+
+        let here = Here::At(core::ptr::from_ref(self.get_ref()) as usize | RUNQ);
+        while let Some(h) = NonNull::new(oldest) {
+            // SAFETY: as above; read before it's run, and maybe freed
+            oldest = unsafe { h.as_ref() }.rq_next.load(Ordering::Relaxed);
+            // SAFETY: SCHEDULED for here, by its dispatch
+            unsafe { self::run(h, here) };
+        }
+    }
+}
+
+impl Drop for RunQueue {
+    fn drop(&mut self) {
+        assert!(!self.has_ready(), "RunQueue dropped with tasks dispatched to it");
+    }
+}
+
+/* JoinHandle */
+
+/// A spawned task's: what it returns. Dropped, the task's detached.
+pub struct JoinHandle<T> {
+    head:  NonNull<TaskHead<T>>,
+    /// An await in progress.
+    wait:  Option<crate::util::gather::Wait<'static, ()>>,
+    taken: bool,
+}
+
+// SAFETY: what it reads is the task's output, a T, from wherever it was
+// made; the task's header is atomics
+unsafe impl<T: Send> Send for JoinHandle<T> {}
+
+impl<T> JoinHandle<T> {
+    fn done(&self) -> &'static Gather<()> {
+        // SAFETY: in the task, which our ref keeps
+        unsafe { &(*self.head.as_ptr()).done }
+    }
+
+    /// # Safety
+    /// The task's complete: @done waited on.
+    unsafe fn take(&mut self) -> T {
+        self.taken = true;
+        // SAFETY: the caller's; it's only taken once, here
+        unsafe { (*(*self.head.as_ptr()).output.get()).assume_init_read() }
+    }
+
+    /// Wait for what it returns, sleeping TASK_IDLE: for a thread, not a
+    /// task.
+    pub fn join_sync(self) -> T {
+        self.join_sync_state(false)
+    }
+
+    /// join_sync(), freezable: for a task that freezes in place, whose
+    /// joiner must too.
+    pub fn join_sync_freezable(self) -> T {
+        self.join_sync_state(true)
+    }
+
+    fn join_sync_state(mut self, freezable: bool) -> T {
+        // an await of it begun: its borrow of the wait ended first
+        self.wait = None;
+        if freezable {
+            self.done().wait_sync_freezable();
+        } else {
+            self.done().wait_sync();
+        }
+        // SAFETY: waited on
+        unsafe { self.take() }
+    }
+}
+
+impl<T> Resumable for JoinHandle<T> {
+    type Output = T;
+
+    fn poll_resume(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<T> {
+        let this = self.get_mut();
+        let done = this.done();
+        let wait = this.wait.get_or_insert_with(|| done.wait());
+        match Pin::new(wait).poll_resume(cx) {
+            Poll::Pending => Poll::Pending,
+            Poll::Ready(()) => {
+                this.wait = None;
+                // SAFETY: waited on
+                Poll::Ready(unsafe { this.take() })
+            }
+        }
+    }
+}
+
+impl<T> Drop for JoinHandle<T> {
+    fn drop(&mut self) {
+        // its Waker taken back, before the task can be freed
+        self.wait = None;
+
+        // SAFETY: our ref keeps it
+        let h = unsafe { NonNull::new_unchecked(&raw mut (*self.head.as_ptr()).header) };
+        let hr = unsafe { h.as_ref() };
+
+        let mut s = hr.state.load(Ordering::Acquire);
+        loop {
+            match hr.state.compare_exchange_weak(s, s & !JOIN, Ordering::AcqRel, Ordering::Acquire) {
+                Ok(_)    => break,
+                Err(cur) => s = cur,
+            }
+        }
+        if s & COMPLETE != 0 && !self.taken {
+            // complete before we let go: what it returned is ours to drop
+            // SAFETY: complete, and not taken
+            unsafe { (*(*self.head.as_ptr()).output.get()).assume_init_drop() };
+        }
+        // SAFETY: our ref
+        unsafe { put_ref(h) };
+    }
+}
diff --git a/fs/bcachefs/util/thread_with_file.rs b/fs/bcachefs/util/thread_with_file.rs
new file mode 100644
index 0000000..ab8ad33
--- /dev/null
+++ b/fs/bcachefs/util/thread_with_file.rs
@@ -0,0 +1,506 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A kthread whose handle is a file descriptor: userspace talks to it by
+//! reading and writing the fd, and closing the fd stops it.
+//!
+//! Two layers. ThreadWithFile<T> is a kthread running on a T, behind a file
+//! whose ops are T's own (util/file.rs) - the data job's progress file.
+//! Stdio<T> makes the file a stream: a StdioRedirect between file and
+//! thread, for fsck - and for mounting's status fd, a stdio file with no
+//! thread, the mounting task printing to it itself.
+//!
+//! Lifetimes. The file owns everything, in Inner: the thread first, so it
+//! drops first. release() closes the redirect, which wakes a thread blocked
+//! on it, stops the thread - kthread_stop() waits for it to exit - and only
+//! then drops what it ran on. What the thread's function owns, a filesystem
+//! it opened or a ref, it drops when it returns; if the file couldn't be
+//! made, the function is dropped unrun. A file with no thread has nothing
+//! for release() to wait on, so whoever prints to it holds a ref on the
+//! file for as long as they may.
+//!
+//! Startup: the thread's made stopped, the fd reserved and the file built,
+//! the thread woken, and only then the fd installed - from which moment
+//! userspace may close it, so nothing's touched after.
+//!
+//! The redirect, keeping C's semantics:
+//!
+//!  - Two buffers, input and output. Userspace writes input and the thread
+//!    reads it; the thread writes output and userspace reads it. The
+//!    thread is input's only reader: a line it's seen stays till it takes it.
+//!  - done: the thread's finished, or the file's closing. It closes both
+//!    ways: reads drain what's left, then get EOF; writes get EPIPE. What
+//!    the thread returned is what close(2) returns.
+//!  - The soft limit, STDIO_REDIRECT_BUFSIZE: a write may go past it rather
+//!    than split a line the thread is waiting for - waiting_for_line - and
+//!    the thread's own messages go in whole or not at all.
+//!  - Under the lock, a spinlock: each buffer is a Fifo<u8>, grown with
+//!    GFP_NOWAIT, or reserved before the lock where it mustn't fail. Copies
+//!    to and from userspace are made there too, copy_*_user_nofault() after
+//!    faulting in: what doesn't copy stays where it was, and a copy is only
+//!    of what was faulted in - past that, it could fail every time.
+//!  - The published length: each buffer's, set by its guard, BufGuard, as
+//!    the lock's released, whatever was done to it. Waits and poll() read it
+//!    without the lock.
+//!  - Waits and wakes: every change to a buffer - data in, room made, done -
+//!    wakes its EventCount, and its PollQueue for poll(). A wait's condition
+//!    reads the published length; readline's looks for a whole line under
+//!    the lock instead, so one wait carries the whole timeout. A condition
+//!    runs in the sleep's task state, which a spinlock keeps and an rtlock
+//!    saves. readline sleeps TASK_IDLE: someone typing is no hung task.
+
+use crate::c;
+use crate::errcode::BchError;
+use crate::locking::{Guard, Lock};
+use crate::new_lock;
+use crate::types::Fifo;
+use crate::util::alloc::{flags, kbox_pin_init, KBox, KVVec};
+use crate::util::ffi::c_char;
+use crate::util::file::{file_data, File, FileData, FileOps, NewFile, PollQueue, PollTable, UserBuf};
+use crate::util::futex::EventCount;
+use crate::util::kernel::current_comm;
+use crate::util::kthread::Kthread;
+use crate::util::projections::Volatile;
+use crate::util::sleep::Sleep;
+use core::ops::{Deref, DerefMut};
+use core::pin::Pin;
+use core::ptr::NonNull;
+use core::sync::atomic::{AtomicBool, AtomicI32, Ordering};
+use cstruct_macros::vtable;
+use kernel::ffi::{c_int, c_long, c_uint, c_ulong};
+use pin_init::{pin_data, pin_init, pinned_drop, PinInit};
+
+/* ThreadWithFile */
+
+pub trait ThreadFile: FileOps {
+    /// At close, before the thread's stopped: wake it from whatever it's
+    /// blocked on that only the file would end.
+    fn closing(&self) {}
+}
+
+#[pin_data(PinnedDrop)]
+pub struct Inner<T: ThreadFile> {
+    thread: Option<Kthread>,
+    #[pin]
+    data:   T,
+}
+
+#[pinned_drop]
+impl<T: ThreadFile> PinnedDrop for Inner<T> {
+    fn drop(self: Pin<&mut Self>) {
+        self.data.closing();
+    }
+}
+
+impl<T: ThreadFile> FileData for Inner<T> {
+    type Ops = T;
+
+    fn ops(&self) -> &T {
+        &self.data
+    }
+}
+
+/// Freed if dropped before run() or get_fd() gives it to a file.
+pub struct ThreadWithFile<T: ThreadFile>(Pin<KBox<Inner<T>>>);
+
+impl<T: ThreadFile> ThreadWithFile<T> {
+    pub fn new(data: impl PinInit<T, BchError>) -> Result<Self, BchError> {
+        let init = pin_init!(Inner::<T> { thread: None, data <- data }? BchError);
+        Ok(ThreadWithFile(kbox_pin_init(init)?))
+    }
+
+    pub fn data(&self) -> &T {
+        &self.0.data
+    }
+
+    /// The kthread's named for the caller.
+    pub fn run(mut self, f: impl FnOnce(&T) + Send + 'static) -> Result<c_int, BchError> {
+        // SAFETY: the thread runs only while the file lives - release()
+        // stops it before the data's dropped - or not at all: if there's no
+        // file, it's stopped unrun, as the data is dropped
+        let data: &'static T = unsafe { &*(&raw const self.0.data) };
+
+        let thread = Kthread::create(format_args!("{}", current_comm()), move |_| f(data))?;
+        *self.0.as_mut().project().thread = Some(thread);
+
+        let file = NewFile::new(self.0)?;
+        if let Some(t) = &file.data().thread {
+            t.wake();
+        }
+        Ok(file.install())
+    }
+
+    /// # Safety
+    /// @file is an open ThreadWithFile<T>'s.
+    pub unsafe fn from_file<'a>(file: *mut c::file) -> &'a T {
+        unsafe { file_data::<Inner<T>>(file) }.ops()
+    }
+}
+
+/* StdioRedirect */
+
+const STDIO_REDIRECT_BUFSIZE: usize = 4096;
+
+#[derive(Default)]
+struct Buf {
+    data:             Fifo<u8>,
+    waiting_for_line: bool,
+}
+
+#[pin_data]
+struct StdioBuf {
+    #[pin]
+    buf:  Lock<c::spinlock_t, Buf, Volatile<usize>>,
+    events: EventCount,
+    #[pin]
+    poll: PollQueue,
+}
+
+impl StdioBuf {
+    fn new() -> impl PinInit<Self> {
+        pin_init!(StdioBuf {
+            buf  <- new_lock!(Buf::default(), ::pin_init::zeroed()),
+            events: EventCount::new(),
+            poll <- PollQueue::new(),
+        })
+    }
+
+    fn len(&self) -> usize {
+        self.buf.get()
+    }
+
+    fn lock(&self) -> BufGuard<'_> {
+        BufGuard(self.buf.lock())
+    }
+
+    fn wake(&self) {
+        self.events.wake();
+        self.poll.wake();
+    }
+
+    fn wait_interruptible(&self, mut cond: impl FnMut() -> bool) -> Result<(), BchError> {
+        self.events.wait_until(Sleep::INTERRUPTIBLE, || cond().then_some(()))
+            .map_err(|_| BchError::from(c::ERESTARTSYS))
+    }
+}
+
+struct BufGuard<'a>(Guard<'a, c::spinlock_t, Buf, Volatile<usize>>);
+
+impl Deref for BufGuard<'_> {
+    type Target = Buf;
+
+    fn deref(&self) -> &Buf {
+        &self.0
+    }
+}
+
+impl DerefMut for BufGuard<'_> {
+    fn deref_mut(&mut self) -> &mut Buf {
+        &mut self.0
+    }
+}
+
+impl Drop for BufGuard<'_> {
+    fn drop(&mut self) {
+        let len = self.0.data.len();
+        self.0.published().set(len);
+    }
+}
+
+#[pin_data]
+pub struct StdioRedirect {
+    #[pin]
+    input:  StdioBuf,
+    #[pin]
+    output: StdioBuf,
+    done:   AtomicBool,
+}
+
+impl StdioRedirect {
+    fn new() -> impl PinInit<Self> {
+        pin_init!(StdioRedirect {
+            input  <- StdioBuf::new(),
+            output <- StdioBuf::new(),
+            done:     AtomicBool::new(false),
+        })
+    }
+
+    pub fn as_c(&self) -> *mut c::stdio_redirect {
+        core::ptr::from_ref(self).cast_mut().cast()
+    }
+
+    /// # Safety
+    /// @p is as_c()'s, of a redirect that's live for 'a.
+    pub unsafe fn from_c<'a>(p: *mut c::stdio_redirect) -> &'a Self {
+        unsafe { &*p.cast::<Self>() }
+    }
+
+    fn done(&self) -> bool {
+        self.done.load(Ordering::Acquire)
+    }
+
+    pub fn set_done(&self) {
+        self.done.store(true, Ordering::Release);
+        self.input.wake();
+        self.output.wake();
+    }
+
+    fn has_data(&self, buf: &StdioBuf) -> bool {
+        buf.len() != 0 || self.done()
+    }
+
+    fn has_room(&self, buf: &StdioBuf) -> bool {
+        buf.len() < STDIO_REDIRECT_BUFSIZE || self.done()
+    }
+
+    /// The thread's output, written: @msg in whole, or an error - EPIPE if
+    /// the file's closed, and if @nonblocking, EAGAIN rather than wait for
+    /// the reader to make room.
+    pub fn write(&self, nonblocking: bool, msg: &[u8]) -> Result<(), BchError> {
+        let out = &self.output;
+        loop {
+            if self.done() {
+                return Err(c::EPIPE.into());
+            }
+
+            let wrote = {
+                let mut b = out.lock();
+                b.data.reserve(msg.len(), flags::GFP_NOWAIT).is_ok() &&
+                    b.data.extend_from_slice(msg).is_ok()
+            };
+
+            if wrote {
+                out.wake();
+                return Ok(());
+            }
+
+            if nonblocking {
+                return Err(c::EAGAIN.into());
+            }
+
+            out.wait_interruptible(|| self.has_room(out))?;
+        }
+    }
+
+    /// A line of input, newline and all, into @line - waiting at most
+    /// @timeout jiffies, MAX_SCHEDULE_TIMEOUT being forever: ETIME if it runs
+    /// out, EPIPE if the file's closed.
+    pub fn readline_timeout(&self, line: &mut KVVec<u8>, timeout: c_ulong) -> Result<(), BchError> {
+        let input = &self.input;
+        loop {
+            let n = input.events.wait_until(Sleep::IDLE.timeout(timeout as _), || {
+                if self.done() {
+                    return Some(None);
+                }
+                let mut b = input.lock();
+                let nl = b.data.iter().position(|&ch| ch == b'\n');
+                if nl.is_none() {
+                    b.waiting_for_line = true;
+                }
+                nl.map(|nl| Some(nl + 1))
+            }).map_err(|_| BchError::from(c::ETIME))?.ok_or(BchError::from(c::EPIPE))?;
+
+            if n > line.capacity() {
+                line.clear();
+                line.reserve(n, flags::GFP_KERNEL)?;
+                continue;
+            }
+
+            line.clear();
+            let mut b = input.lock();
+            b.data.drain_with(n, |s| line.extend_from_slice(s, flags::GFP_NOWAIT).is_ok());
+            b.waiting_for_line = false;
+            drop(b);
+
+            input.wake();
+            return Ok(());
+        }
+    }
+
+    fn read_user(&self, u: &mut UserBuf, nonblock: bool) -> Result<(), BchError> {
+        let out = &self.output;
+
+        if !nonblock {
+            out.wait_interruptible(|| self.has_data(out))?;
+        } else if !self.has_data(out) {
+            return Err(c::EAGAIN.into());
+        }
+
+        while u.len() != 0 && out.len() != 0 {
+            let writeable = u.fault_in_writeable();
+            if writeable == 0 {
+                return Err(c::EFAULT.into());
+            }
+
+            let n = out.lock().data.drain_with(writeable, |s| u.copy_to_nofault(s));
+
+            if n != 0 {
+                out.wake();
+            }
+        }
+        Ok(())
+    }
+
+    fn write_user(&self, u: &mut UserBuf, nonblock: bool) -> Result<(), BchError> {
+        let input = &self.input;
+
+        while u.len() != 0 {
+            if self.done() {
+                return Err(c::EPIPE.into());
+            }
+
+            let readable = u.fault_in_readable();
+            if readable == 0 {
+                return Err(c::EFAULT.into());
+            }
+
+            let n = {
+                let mut b = input.lock();
+                let mut makeroom = readable;
+                if !b.waiting_for_line || b.data.iter().any(|&ch| ch == b'\n') {
+                    makeroom = makeroom.min(STDIO_REDIRECT_BUFSIZE.saturating_sub(b.data.len()));
+                }
+                let _ = b.data.reserve(makeroom, flags::GFP_NOWAIT);
+
+                let n = readable.min(b.data.free());
+                // SAFETY: a stretch copied is filled
+                unsafe { b.data.fill_with(n, |d| u.copy_from_nofault(d)) };
+                n
+            };
+
+            if n != 0 {
+                input.wake();
+            } else if nonblock {
+                return Err(c::EAGAIN.into());
+            } else {
+                input.wait_interruptible(|| self.has_room(input))?;
+            }
+        }
+        Ok(())
+    }
+
+    fn poll(&self, file: &File, pt: &PollTable<'_>) -> u32 {
+        pt.wait(file, &self.output.poll);
+        pt.wait(file, &self.input.poll);
+
+        let mut mask = 0;
+        if self.has_data(&self.output) {
+            mask |= c::EPOLLIN;
+        }
+        if self.has_room(&self.input) {
+            mask |= c::EPOLLOUT;
+        }
+        if self.done() {
+            mask |= c::EPOLLHUP | c::EPOLLERR;
+        }
+        mask
+    }
+}
+
+/* Stdio: a ThreadWithFile on a StdioRedirect */
+
+pub trait StdioFile: Send + Sync + 'static {
+    fn ioctl(&self, _cmd: c_uint, _arg: c_ulong) -> c_long {
+        -(c::ENOTTY as c_long)
+    }
+}
+
+impl StdioFile for () {}
+
+#[pin_data]
+pub struct Stdio<T> {
+    #[pin]
+    pub redirect: StdioRedirect,
+    ret:          AtomicI32,
+    #[pin]
+    pub data:     T,
+}
+
+#[vtable]
+impl<T: StdioFile> FileOps for Stdio<T> {
+    fn read(&self, file: &File, buf: &mut UserBuf) -> Result<(), BchError> {
+        self.redirect.read_user(buf, file.nonblock())
+    }
+
+    fn write(&self, file: &File, buf: &mut UserBuf) -> Result<(), BchError> {
+        self.redirect.write_user(buf, file.nonblock())
+    }
+
+    fn poll(&self, file: &File, pt: PollTable<'_>) -> u32 {
+        self.redirect.poll(file, &pt)
+    }
+
+    fn flush(&self, _file: &File) -> c_int {
+        self.ret.load(Ordering::Relaxed)
+    }
+
+    fn unlocked_ioctl(&self, _file: &File, cmd: c_uint, arg: c_ulong) -> c_long {
+        self.data.ioctl(cmd, arg)
+    }
+}
+
+impl<T: StdioFile> ThreadFile for Stdio<T> {
+    fn closing(&self) {
+        self.redirect.set_done();
+    }
+}
+
+impl<T: StdioFile> ThreadWithFile<Stdio<T>> {
+    pub fn new_stdio(data: impl PinInit<T, BchError>) -> Result<Self, BchError> {
+        Self::new(pin_init!(Stdio::<T> {
+            redirect <- StdioRedirect::new(),
+            ret:        AtomicI32::new(0),
+            data     <- data,
+        }? BchError))
+    }
+
+    pub fn stdio(&self) -> &StdioRedirect {
+        &self.data().redirect
+    }
+
+    pub fn run_stdio(self, f: impl FnOnce(&T, &StdioRedirect) -> c_int + Send + 'static)
+        -> Result<c_int, BchError>
+    {
+        self.run(move |s: &Stdio<T>| {
+            s.ret.store(f(&s.data, &s.redirect), Ordering::Relaxed);
+            s.redirect.set_done();
+        })
+    }
+
+    /// No thread: the caller prints, and calls stdio().set_done() when it's
+    /// finished. The fd, and the file ref to hold while it may print.
+    pub fn get_fd(self) -> Result<(c_int, NonNull<c::file>), BchError> {
+        let file = NewFile::new(self.0)?;
+        let r = file.get_file();
+        Ok((file.install(), r))
+    }
+}
+
+/* For C's prints */
+
+/// # Safety
+/// @stdio is a live redirect's, @buf @len bytes.
+#[cstruct_macros::c_export]
+pub unsafe extern "C" fn bch2_stdio_redirect_write(stdio: *mut c::stdio_redirect, nonblocking: bool,
+                                                   buf: *const c_char, len: usize) -> isize {
+    let stdio = unsafe { StdioRedirect::from_c(stdio) };
+    let msg = unsafe { core::slice::from_raw_parts(buf.cast::<u8>(), len) };
+    match stdio.write(nonblocking, msg) {
+        Ok(())  => len as isize,
+        Err(e)  => -(e.raw() as isize),
+    }
+}
+
+/// The fsck question's answer, a line into @line: 0, or a -errcode - ETIME
+/// if @timeout jiffies passed first.
+///
+/// # Safety
+/// @stdio is a live redirect's; @line a darray.
+#[cstruct_macros::c_export]
+pub unsafe extern "C" fn bch2_stdio_redirect_readline_timeout(stdio: *mut c::stdio_redirect,
+                                                              line: *mut c::darray_char,
+                                                              timeout: c_ulong) -> c_int {
+    let stdio = unsafe { StdioRedirect::from_c(stdio) };
+    // SAFETY: C's darray, its buffer kvmalloc()'d
+    let mut line = unsafe { crate::util::alloc::DArrayLoan::new(&mut *line) };
+    crate::errcode::ret_to_c(stdio.readline_timeout(&mut line, timeout))
+}
