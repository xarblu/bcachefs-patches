diff --git a/fs/bcachefs/data/move_data.rs b/fs/bcachefs/data/move_data.rs
new file mode 100644
index 0000000..b2f88e8
--- /dev/null
+++ b/fs/bcachefs/data/move_data.rs
@@ -0,0 +1,594 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! The mover's walks, which find what to move: move_data_btree() walks a
+//! btree's levels, and the phys walk - the evacuates, scrub - a device's
+//! backpointers. Each key a predicate picks is moved by move_extent(): an
+//! extent's data update (moving_update.rs), a btree node's rewrite, or a
+//! scrub's read of one replica.
+//!
+//! A predicate (Pred) is given the key and its io options, fills in the
+//! move's options and says whether to move it; with its name, for the
+//! data_update_pred trace. Before it, the key's reconcile options are brought
+//! up to date and committed, lazily: a commit restarts, and the key is peeked
+//! again with them.
+//!
+//! The walks run their own attempts and don't commit: a move unlocks the
+//! transaction to issue its read. They ratelimit() between keys, skip a key
+//! whose update failed (data_update_fail), and stop on what going on won't
+//! help: the filesystem going read-only, an IO error, the device gone.
+//!
+//! The phys walk resolves every backpointer it passes, moving its key or not:
+//! resolving is what repairs a dangling one (backpointer_to_missing_ptr,
+//! autofix). And the audit of each bucket's backpointers against its alloc
+//! key, check_one_bucket_backpointer_mismatch(), run as the walk passes the
+//! bucket, can only see missing backpointers once the dangling ones are gone:
+//! a dangling one still counts its data_type, gen and length in the sums,
+//! hiding the mismatch forever - and copygc livelocks, its is_movable
+//! approving the bucket, evacuation skipping every backpointer and moving
+//! nothing. A walk that finishes audits the buckets past its last
+//! backpointer; one that stopped doesn't - it didn't skip them, it stopped,
+//! and the audit is slow enough to be what someone who hit ctrl-C waits on.
+//!
+//! A stripe isn't moved: the phys walk of a scrub checks its blocks against
+//! their checksums instead (ec/repair.rs's scrub_stripe_block()).
+
+use crate::alloc::backpointers::{backpointer_get_key, BackpointerPos};
+use crate::alloc::capacity::DiskReservation;
+use crate::alloc::check_backpointers::check_one_bucket_backpointer_mismatch;
+use crate::btree::bkey::prelude::*;
+use crate::btree::bkey::{pos, BkeyI, BkeySC};
+use crate::btree::bkey_buf::BkeyBuf;
+use crate::btree::iter::{is_restart, BtreeIter, BtreeIterFlags, BtreeLevels, CommitFlags, CommitOpts, TransAttempt};
+use crate::btree::write_buffer::WbMaybeFlush;
+use crate::c;
+use crate::c::bch_errcode as err;
+use crate::data::ec::repair::scrub_stripe_block;
+use crate::data::moving::{key_sectors, MoveStats, Moving, MovingCtxt};
+use crate::data::moving_update;
+use crate::data::ptrs::{BkeyVPtrs, Ptrs};
+use crate::data::reconcile::needs_reconcile::update_reconcile_opts;
+use crate::data::update::{fail_should_trace, is_scrub};
+use crate::errcode::{ret_to_c, BchError};
+use crate::fs::{writepoint_hashed, Fs};
+use crate::inode_opts::{get_io_opts, PerSnapshotIoOpts};
+use crate::sb::counters::events;
+use crate::util::ffi::Opaque;
+use crate::util::kernel::current_id;
+use crate::util::Printbuf;
+use crate::{bch_err_msg, warn_once};
+use core::ffi::{c_int, c_uint};
+use core::ops::Range;
+use core::ptr::NonNull;
+use cstruct_macros::c_export;
+
+/// What to move: of @k, in @btree, with @io_opts, the move's options filled
+/// in, and whether to. In the walk's attempt, so it can look things up - an
+/// error, or a restart, is the walk's.
+pub type Pred<'p> = dyn FnMut(&TransAttempt<'_, '_>, c::btree_id, BkeySC<'_>, &c::bch_inode_opts,
+                              &mut c::data_update_opts) -> Result<bool, BchError> + 'p;
+
+// ── Moving a key ─────────────────────────────────────────────────────────
+
+/// A btree node rewrite has no data_update, whose exit traces an extent's
+/// move: so a btree node's is traced here. @k is a copy - the rewrite frees
+/// the node the key was in.
+#[cold]
+fn move_btree_node_trace(fs: &Fs, opts: &c::bch_inode_opts, data_opts: &c::data_update_opts, k: BkeySC<'_>,
+                         ret: Result<(), BchError>) {
+    let sectors = fs.btree_sectors().into();
+    let msg = |out: &mut Printbuf| {
+        write!(out, "{}\n", k.to_text(fs));
+        fs.data_update_opts_to_text(out, opts, data_opts);
+    };
+    match ret {
+        Ok(()) => fs.event_add_trace(events::data_update, sectors, msg),
+        Err(e) if fail_should_trace(data_opts.type_, e) => fs.event_add_trace(events::data_update_fail, sectors, |out| {
+            msg(out);
+            write!(out, "\nret:\t{e}\n");
+        }),
+        Err(_) => {}
+    }
+}
+
+impl<'a> Moving<'a> {
+    /// Start moving @k, at @iter's position in the context's transaction, as
+    /// @data_opts say - returning once the read is issued: an extent's data
+    /// update, a btree node's rewrite, or a scrub's read. Past this the
+    /// attempt has no commit left to make: an extent's move unlocks to issue
+    /// its read, @k copied first. The read retries itself - restarts in its
+    /// erasure coded fallback - which aren't the attempt's.
+    ///
+    /// The move holds a count on @bucket until it's done.
+    pub fn move_extent(
+        &self,
+        t:         &TransAttempt<'_, 'a>,
+        bucket:    Option<&c::move_bucket>,
+        opts:      &c::bch_inode_opts,
+        data_opts: &c::data_update_opts,
+        iter:      &BtreeIter<'_>,
+        level:     u32,
+        k:         BkeySC<'_>,
+    ) -> Result<(), BchError> {
+        let fs = t.fs();
+
+        if is_scrub(data_opts.type_) && !fs.dev_idx_is_online(data_opts.read_dev) {
+            return fs.throw(err::BCH_ERR_device_offline);
+        }
+
+        let ret = if !k.k.is_btree_ptr() {
+            moving_update::move_extent(self, t, bucket, iter, k, opts, data_opts)
+        } else if !is_scrub(data_opts.type_) {
+            self.move_btree_node(t, opts, data_opts, iter, level, k)
+        } else if data_opts.type_ == c::bch_data_update_types::BCH_DATA_UPDATE_scrub {
+            t.btree_node_scrub(iter.btree(), level, k, data_opts.read_dev)
+        } else {
+            // scrub_no_repair: node scrub repairs, and the journal scrub
+            // checks nodes itself with a report callback - scrub_journal_node()
+            // - so nothing should send one here
+            warn_once!(true, fs, "move_extent(): a btree node with scrub_no_repair");
+            fs.throw(err::BCH_ERR_invalid)
+        };
+        t.restarts_handled();
+
+        match ret {
+            // wait for some IO to finish, and retry
+            Err(e) if e.matches(c::ENOMEM) => {
+                self.wait_for_io();
+                Err(t.restart(err::BCH_ERR_transaction_restart_nested))
+            }
+            r => r,
+        }
+    }
+
+    fn move_btree_node(&self, t: &TransAttempt<'_, 'a>, opts: &c::bch_inode_opts, data_opts: &c::data_update_opts,
+                       iter: &BtreeIter<'_>, level: u32, k: BkeySC<'_>) -> Result<(), BchError> {
+        use c::bch_watermark as wm;
+        let fs = t.fs();
+
+        if data_opts.type_ != c::bch_data_update_types::BCH_DATA_UPDATE_copygc {
+            if let Err(e) = t.can_do_data_update(opts, data_opts, k, None) {
+                if !is_restart(&e) {
+                    move_btree_node_trace(fs, opts, data_opts, k, Err(e));
+                }
+                return Err(e);
+            }
+        }
+
+        let node_key = BkeyBuf::from_key(k);
+
+        let mut flags = CommitOpts::from(data_opts.commit_flags);
+        if data_opts.commit_flags.bits() & c::BCH_WATERMARK_MASK == wm::BCH_WATERMARK_copygc as u32 {
+            flags = flags.watermark_hipri();
+        }
+
+        let ret = t.btree_node_rewrite_pos(iter.btree(), level, k.k.p, data_opts.target.into(), flags,
+                                           data_opts.write_flags);
+
+        // ENOMEM becomes a restart, retried: not an outcome
+        if !matches!(&ret, Err(e) if is_restart(e) || e.matches(c::ENOMEM)) {
+            move_btree_node_trace(fs, opts, data_opts, BkeySC::from(&node_key), ret);
+        }
+        ret
+    }
+}
+
+/// For the journal scrub, until it's Rust - its walk's progress counted here,
+/// as C's was.
+///
+/// # Safety
+/// @ctxt's transaction is in an attempt, at @iter.
+#[c_export]
+pub unsafe fn bch2_move_extent(ctxt: &Opaque<c::moving_context>, bucket: Option<&c::move_bucket>,
+                               opts: &c::bch_inode_opts, data_opts: &c::data_update_opts, iter: &BtreeIter<'_>,
+                               level: c_uint, k: BkeySC<'_>) -> c_int {
+    let moving = Moving::from_c(ctxt);
+    // SAFETY: the caller's
+    let t = unsafe { moving.trans().attempt_in_progress() };
+    let sectors = key_sectors(t.fs(), k);
+    let ret = moving.move_extent(&t, bucket, opts, data_opts, iter, level, k);
+    if !matches!(&ret, Err(e) if is_restart(e)) {
+        if let Some(stats) = moving.stats_opt() {
+            stats.walked(iter, sectors);
+        }
+    }
+    ret_to_c(ret)
+}
+
+/// What a walk moves with: the context, the bucket each move holds a count on,
+/// and the predicate, named for the data_update_pred trace.
+struct Mover<'a, 'p> {
+    moving: &'a Moving<'a>,
+    bucket: Option<&'a c::move_bucket>,
+    name:   &'a str,
+    pred:   &'a mut Pred<'p>,
+}
+
+impl Mover<'_, '_> {
+    /// @k moved, if it's data the predicate picks: its io options - cached
+    /// across a walk in key order by @s - and reconcile options, committed
+    /// first.
+    fn move_key(&mut self, t: &TransAttempt<'_, '_>, mut s: Option<&mut c::per_snapshot_io_opts>,
+                iter: &BtreeIter<'_>, level: u32, k: BkeySC<'_>) -> Result<(), BchError> {
+        if !k.k.extent_is_direct_data() {
+            return Ok(());
+        }
+
+        let fs = t.fs();
+        let opts = get_io_opts(t, s.as_deref_mut(), k)?;
+        update_reconcile_opts(t, s, &opts, iter, level, k, c::set_needs_reconcile_ctx::SET_NEEDS_RECONCILE_other)?;
+        t.commit_lazy(Some(&DiskReservation::new(fs)), CommitFlags::NO_ENOSPC)?;
+
+        let mut data_opts = c::data_update_opts { read_dev: u32::MAX, ..Default::default() };
+        let ret = (self.pred)(t, iter.btree(), k, &opts, &mut data_opts);
+
+        fs.event_add_trace(events::data_update_pred, k.k.size.into(), |out| {
+            match ret {
+                Ok(m) => write!(out, "{}: {}\n", self.name, i32::from(m)),
+                Err(e) => write!(out, "{}: {e}\n", self.name),
+            };
+            write!(out, "{}\n", k.to_text(fs));
+            fs.data_update_opts_to_text(out, &opts, &data_opts);
+        });
+
+        if !ret? {
+            return Ok(());
+        }
+        self.moving.move_extent(t, self.bucket, &opts, &data_opts, iter, level, k)
+    }
+}
+
+// ── A btree's keys ───────────────────────────────────────────────────────
+
+impl Moving<'_> {
+    /// Start moving what @pred picks of @btree, at @levels, @start to @end -
+    /// returning once the moves are issued.
+    pub fn move_data_btree(&self, btree: c::btree_id, levels: Range<u32>, start: c::bpos, end: c::bpos,
+                           name: &str,
+                           mut pred: impl FnMut(&TransAttempt<'_, '_>, c::btree_id, BkeySC<'_>, &c::bch_inode_opts,
+                                                &mut c::data_update_opts) -> Result<bool, BchError>)
+        -> Result<(), BchError>
+    {
+        let trans = self.trans();
+        let fs = trans.fs();
+        let mut s = PerSnapshotIoOpts::new(fs);
+        let mut mover = Mover { moving: self, bucket: None, name, pred: &mut pred };
+
+        if let Some(stats) = self.stats_opt() {
+            stats.at.data_type.set(c::bch_data_type::BCH_DATA_user);
+            stats.set_pos(c::bbpos { btree, pos: start });
+        }
+
+        BtreeLevels { btree, levels, start, end }.for_each(trans, |t, iter, level, k| {
+            let sectors = key_sectors(fs, k);
+
+            match mover.move_key(t, Some(&mut s), iter, level, k) {
+                Ok(()) => {}
+                // failure for this key: go on
+                Err(e) if e.matches(err::BCH_ERR_data_update_fail) => {}
+                // a topology error, a btree node read error
+                Err(e) if is_restart(&e) || e.matches(c::EROFS) || e.matches(c::EIO) => return Err(e),
+                Err(e) => {
+                    warn_once!(!e.matches(c::EAGAIN), fs, "unhandled error from move_extent: {e}");
+                }
+            }
+            if let Some(stats) = self.stats_opt() {
+                stats.walked(iter, sectors);
+            }
+            // between keys: it unlocks, and @k is done with
+            self.ratelimit()
+        })
+    }
+}
+
+// ── A device's backpointers ──────────────────────────────────────────────
+
+/// The backpointers a phys walk walks.
+#[derive(Clone, Copy)]
+enum BpWalk {
+    /// A device's, in BTREE_ID_backpointers
+    Dev(u32),
+    /// Of block @block of stripe @idx, whose device was removed, in
+    /// BTREE_ID_stripe_backpointers: their extents' pointers are
+    /// BCH_SB_MEMBER_INVALID, still holding the stripe
+    EcOrphan { idx: u64, block: u32 },
+}
+
+struct PhysWalk {
+    bps:            BpWalk,
+    /// Sectors @start..@end
+    start:          u64,
+    end:            u64,
+    /// Bit per data type to move
+    data_types:     u32,
+    /// Scrub: check the device's stripe blocks against their checksums
+    verify_stripes: bool,
+    /// Copygc's: the audit schedules its repair ratelimited
+    copygc:         bool,
+}
+
+impl PhysWalk {
+    /// Every data type, no stripe scrub, no copygc.
+    fn new(bps: BpWalk, start: u64, end: u64) -> Self {
+        PhysWalk { bps, start, end, data_types: !0, verify_stripes: false, copygc: false }
+    }
+}
+
+/// A phys walk under way.
+struct PhysWalker<'a, 'p> {
+    mover:        Mover<'a, 'p>,
+    w:            &'a PhysWalk,
+    /// The device, for a walk of a device's backpointers: it's audited
+    ca:           Option<&'a c::bch_dev>,
+    last_flushed: WbMaybeFlush,
+    /// Buckets below it audited
+    audited:      u64,
+}
+
+impl PhysWalker<'_, '_> {
+    /// The buckets up to @bucket audited.
+    fn audit_to(&mut self, bucket: u64) {
+        let Some(ca) = self.ca else { return };
+        while self.audited < bucket {
+            let _ = check_one_bucket_backpointer_mismatch(self.mover.moving.trans(), ca, self.audited, self.w.copygc,
+                                                          self.last_flushed.borrow());
+            self.audited += 1;
+        }
+    }
+
+    /// Backpointer @bp's key resolved - and moved, if it's of a data type
+    /// moved and the predicate picks it. An error stops the walk.
+    fn bp(&mut self, t: &TransAttempt<'_, '_>, bp: &BkeyI<c::Backpointer>) -> Result<(), BchError> {
+        let fs = t.fs();
+        let moving = self.mover.moving;
+        let v = &bp.v;
+        let moved = self.w.data_types & (1 << v.data_type) != 0;
+
+        if let Some(stats) = moving.stats_opt() {
+            stats.at.offset.set(bp.k.p.offset >> fs.sb.extent_bp_shift.get());
+        }
+
+        let mut iter = BtreeIter::uninit();
+        let Some((iter, k)) = backpointer_get_key(t, BkeySC::from(bp), &mut iter, BtreeIterFlags::empty(),
+                                                  self.last_flushed.borrow())? else { return Ok(()) };
+
+        if v.level == 0 && c::btree_id(v.btree_id.into()) == c::btree_id::stripes {
+            return match self.ca.filter(|_| self.w.verify_stripes && moved) {
+                None => Ok(()),
+                Some(ca) => scrub_stripe_block(moving, t, ca, BkeySC::from(bp), k),
+            };
+        }
+
+        // not moving these: resolving them still verified them
+        if !moved {
+            return Ok(());
+        }
+
+        let bucket_len = { v.bucket_len };
+        let ret = self.mover.move_key(t, None, iter, v.level.into(), k);
+        if matches!(&ret, Err(e) if is_restart(e)) {
+            return ret;
+        }
+        if let Some(stats) = moving.stats_opt() {
+            stats.walked(iter, bucket_len.into());
+        }
+        match ret {
+            Ok(()) => Ok(()),
+            // failure for this key: go on
+            Err(e) if e.matches(err::BCH_ERR_data_update_fail) => Ok(()),
+            Err(e) if e.matches(c::EAGAIN) || e.matches(c::EROFS) || e.matches(c::EIO) ||
+                      e.matches(err::BCH_ERR_device_offline) => Err(e),
+            Err(e) => {
+                warn_once!(true, fs, "unhandled error from move_extent: {e}");
+                Ok(())
+            }
+        }
+    }
+}
+
+/// The evacuates' predicate: the pointers @kill picks moved, to the
+/// background target.
+fn evacuate_ptrs(t: &TransAttempt<'_, '_>, k: BkeySC<'_>, io_opts: &c::bch_inode_opts,
+                 data_opts: &mut c::data_update_opts, mut kill: impl FnMut(&c::extent_ptr_decoded) -> bool)
+    -> Result<bool, BchError>
+{
+    data_opts.target = io_opts.background_target;
+    if let Some(k) = k.arm::<Ptrs>() {
+        for (i, d) in k.ptrs_decoded(t.fs()).enumerate() {
+            if kill(&d.p) {
+                data_opts.ptrs_kill |= 1 << i;
+            }
+        }
+    }
+    Ok(data_opts.ptrs_kill != 0)
+}
+
+impl Moving<'_> {
+    fn move_data_phys(&self, bucket: Option<&c::move_bucket>, w: &PhysWalk, name: &str, pred: &mut Pred<'_>)
+        -> Result<(), BchError>
+    {
+        let trans = self.trans();
+        let fs = trans.fs();
+
+        let (bp_btree, bp_dev, ca) = match w.bps {
+            // userspace might have supplied @dev
+            BpWalk::Dev(dev) => (c::btree_id::backpointers, dev.into(), fs.dev_get(dev)),
+            BpWalk::EcOrphan { idx, block } =>
+                (c::btree_id::stripe_backpointers, BackpointerPos::ec_removed_dev(idx, block), None),
+        };
+
+        let end = ca.as_ref().map_or(w.end, |ca| w.end.min(ca.bucket_to_sector(ca.mi.get().nbuckets)));
+        let shift = fs.sb.extent_bp_shift.get();
+        let bp_end = pos(bp_dev, end << shift);
+
+        let mut walker = PhysWalker {
+            mover:        Mover { moving: self, bucket, name, pred },
+            w,
+            ca:           ca.as_deref(),
+            last_flushed: WbMaybeFlush::new().map_err(|_| BchError::from(c::ENOMEM))?,
+            audited:      ca.as_ref().map_or(0, |ca| ca.sector_to_bucket(w.start)),
+        };
+
+        // not run where transaction restarts are handled
+        trans.begin_raw();
+        let mut bp_iter = BtreeIter::new(trans, bp_btree, pos(bp_dev, w.start << shift), BtreeIterFlags::empty());
+
+        match trans.write_buffer_tryflush() {
+            Err(e) if e.matches(c::EROFS) => return Err(e),
+            r => bch_err_msg!(fs, r, "flushing btree write buffer")?,
+        }
+
+        bp_iter.for_each_max(trans, bp_end, |t, _, k| {
+            // the buckets before this backpointer's, which the audit runs
+            // transactions of its own for: then the same position again
+            let bucket = walker.ca.map(|ca| BackpointerPos::from_bpos(fs, k.k.p).bucket(ca).offset);
+            if let Some(bucket) = bucket.filter(|&b| walker.audited < b) {
+                return Err(t.close(CommitFlags::empty(), |_| {
+                    walker.audit_to(bucket);
+                    Ok(())
+                }));
+            }
+
+            if let Some(bp) = BkeyI::<c::Backpointer>::from_key(k) {
+                walker.bp(t, &bp)?;
+            }
+            // between backpointers: it unlocks, and @k is done with
+            self.ratelimit()
+        })?;
+
+        if let Some(ca) = walker.ca {
+            walker.audit_to(ca.sector_to_bucket(end));
+        }
+        Ok(())
+    }
+
+    /// Start moving the data in sectors @start..@end of device @dev off it,
+    /// found by backpointer - to the extents' background target - returning
+    /// once the moves are issued.
+    pub fn evacuate_data(&self, dev: u32, start: u64, end: u64) -> Result<(), BchError> {
+        self.move_data_phys(None, &PhysWalk::new(BpWalk::Dev(dev), start, end), "evacuate_pred",
+                            &mut |t, _, k, io_opts, d| {
+            evacuate_ptrs(t, k, io_opts, d, |p| u32::from(p.ptr.dev()) == dev)
+        })
+    }
+
+    /// evacuate_data(), for block @block of stripe @idx, on a device that's
+    /// been removed: its extents found by their stripe_backpointers, the
+    /// pointers moved those that point to the block.
+    pub fn evacuate_ec_orphan(&self, idx: u64, block: u32, start: u64, end: u64) -> Result<(), BchError> {
+        let w = PhysWalk::new(BpWalk::EcOrphan { idx, block }, start, end);
+        // Every removed device's pointers are BCH_SB_MEMBER_INVALID: the
+        // block's are the ones whose stripe pointer is to it
+        self.move_data_phys(None, &w, "evacuate_ec_orphan_pred", &mut |t, _, k, io_opts, d| {
+            evacuate_ptrs(t, k, io_opts, d, |p| {
+                u32::from(p.ptr.dev()) == c::BCH_SB_MEMBER_INVALID && p.has_ec &&
+                    p.ec.idx() == idx && u32::from(p.ec.block()) == block
+            })
+        })
+    }
+
+    /// Start moving everything off @key's bucket, while it's that
+    /// generation, as @data_opts say: its backpointers walked, each extent's
+    /// move issued - returning once the reads are. Each move holds a count on
+    /// @bucket_in_flight until its update is done.
+    ///
+    /// # Safety
+    /// @bucket_in_flight stays valid, where it is, until its count is back
+    /// to what it was.
+    pub unsafe fn evacuate_bucket(&self, bucket_in_flight: NonNull<c::move_bucket>, key: c::move_bucket_key,
+                                  data_opts: c::data_update_opts) -> Result<(), BchError> {
+        let fs = self.trans().fs();
+        let bucket = key.bucket;
+        let generation = key.generation as i32;
+
+        // userspace might have supplied @dev
+        let Some(ca) = fs.dev_get(bucket.inode as u32) else { return Ok(()) };
+
+        let w = PhysWalk {
+            copygc: true,
+            ..PhysWalk::new(BpWalk::Dev(bucket.inode as u32), ca.bucket_to_sector(bucket.offset),
+                            ca.bucket_to_sector(bucket.offset + 1))
+        };
+        let mut name = Printbuf::new();
+        write!(name, "evacuate_bucket_pred gen={generation}");
+        let mut sectors = 0u32;
+        // SAFETY: the caller's
+        let ret = self.move_data_phys(Some(unsafe { bucket_in_flight.as_ref() }), &w, name.as_str(),
+                                      &mut |t, _, k, io_opts, d| {
+            *d = data_opts;
+            d.read_dev = u32::MAX;
+            evacuate_ptrs(t, k, io_opts, d, |p| {
+                let kill = u64::from(p.ptr.dev()) == bucket.inode &&
+                    (generation < 0 || generation == i32::from(p.ptr.generation())) &&
+                    p.ptr.cached() == 0;
+                if kill {
+                    sectors += p.crc.compressed_size;
+                }
+                kill
+            })
+        });
+
+        fs.event_inc_trace(events::evacuate_bucket, |out| {
+            write!(out, "bucket: {bucket} gen: {generation} ret {}\n", BchError::from_raw(ret_to_c(ret)));
+            write!(out, "{sectors}/{} sectors\n", { ca.mi.get().bucket_size });
+        });
+        ret
+    }
+}
+
+// ── Data jobs ────────────────────────────────────────────────────────────
+
+/// Scrub: one replica on @arg's device read and checked - of a btree node,
+/// any; of an extent, a checksummed one.
+fn scrub(fs: &Fs, stats: &MoveStats, arg: c::bch_ioctl_data_scrub) -> Result<(), BchError> {
+    let ctxt = MovingCtxt::new(fs, stats, writepoint_hashed(current_id()), false)
+        .map_err(|_| BchError::from(c::ENOMEM))?;
+    stats.at.data_type.set(c::bch_data_type(c::DATA_PROGRESS_DATA_TYPE_phys));
+
+    let _ = ctxt.trans().write_buffer_flush_sync();
+
+    let dev = arg.dev;
+    let w = PhysWalk {
+        data_types:     arg.data_types,
+        verify_stripes: true,
+        ..PhysWalk::new(BpWalk::Dev(dev), 0, u64::MAX)
+    };
+    ctxt.move_data_phys(None, &w, "scrub_pred", &mut |t, _, k, _, data_opts| {
+        if k.k.key_type() != c::bch_bkey_type::KEY_TYPE_btree_ptr_v2 {
+            if let Some(kp) = k.arm::<Ptrs>() {
+                if let Some(d) = kp.ptrs_decoded(t.fs()).find(|d| u32::from(d.p.ptr.dev()) == dev) {
+                    if d.p.crc.csum_type == 0 {
+                        return Ok(false);
+                    }
+                }
+            }
+        }
+
+        data_opts.type_ = c::bch_data_update_types::BCH_DATA_UPDATE_scrub;
+        data_opts.read_dev = dev;
+        data_opts.read_flags = c::bch_read_flags::BCH_READ_hard_require_read_device;
+        Ok(true)
+    })
+}
+
+macro_rules! data_op_names {
+    ($(($name:tt, $n:tt)),* $(,)?) => { const DATA_OP_NAMES: &[&str] = &[$(stringify!($name),)*]; };
+}
+c::BCH_DATA_OPS!(data_op_names);
+
+/// The ioctl's data job @op, counted into @stats. Scrub is the only op.
+pub fn data_job(fs: &Fs, stats: &MoveStats, op: &c::bch_ioctl_data) -> Result<(), BchError> {
+    let Some(name) = DATA_OP_NAMES.get(usize::from(op.op)) else {
+        return fs.throw(err::BCH_ERR_EINVAL_data_job_bad_op);
+    };
+    stats.reset(name);
+
+    match u32::from(op.op) {
+        c::BCH_DATA_OP_scrub => {
+            // so tests don't fail spuriously: every btree node that needs
+            // repair is seen
+            fs.btree_interior_updates_flush();
+            scrub(fs, stats, op.scrub())
+        }
+        _ => Err(c::EINVAL.into()),
+    }
+}
diff --git a/fs/bcachefs/data/move_defs.rs b/fs/bcachefs/data/move_defs.rs
new file mode 100644
index 0000000..21b9ade
--- /dev/null
+++ b/fs/bcachefs/data/move_defs.rs
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::types::c_default;
+use crate::data::moving::InFlightUpdate;
+use crate::types::Fifo;
+use core::cell::{Cell, UnsafeCell};
+use crate::util::task::RunQueue;
+use core::sync::atomic::{AtomicI32, AtomicPtr};
+use crate::util::ffi::Opaque;
+use cstruct_macros::CStruct;
+
+/*
+ * Tracks in-flight data movement IO for ratelimiting.
+ *
+ * Four atomic counters track sectors and IOs in flight:
+ *  - read_sectors/read_ios: extent read submit -> its task taking the
+ *    completed read
+ *  - write_sectors/write_ios: then -> write completion
+ *
+ * Moving::ratelimit() blocks the caller until all counters are below
+ * c->opts.move_bytes_in_flight / move_ios_in_flight.
+ *
+ * Moves (Moving::move_extent()) and stripe repairs (ec/repair.rs)
+ * both account through these counters.
+ *
+ * Lifetime: every in-flight IO holds closure_get(&ctxt->cl).
+ * bch2_moving_ctxt_flush_all() waits for all IO via closure_sync(),
+ * and bch2_moving_ctxt_exit() asserts all counters are zero.
+ */
+#[repr(C)]
+#[derive(CStruct)]
+pub struct moving_context {
+    pub trans: *mut c::btree_trans,
+    /* on c->moving_context_list, which other contexts' adds and dels write */
+    #[c("struct list_head list")]
+    pub list: Opaque<c::list_head>,
+
+    /* set racily, read by the listing */
+    #[c("struct bch_move_stats *stats")]
+    pub stats: AtomicPtr<c::bch_move_stats>,
+    pub wp: c::write_point_specifier,
+    pub wait_on_copygc: bool,
+
+    /* For waiting on outstanding reads and writes: */
+    #[c("struct closure cl")]
+    pub cl: Opaque<c::closure>,
+
+    pub io: moving_io_counts,
+
+    /*
+     * Its updates' tasks, run in its waits - data/moving_update.rs - whose
+     * EventCount every completion wakes: Moving::wake()
+     */
+    pub runq: RunQueue,
+    /*
+     * Its data updates in flight, in the order they were issued, by seq - an
+     * update's index in it - and the first whose write hasn't started. The
+     * mover's thread's alone: data/moving.rs
+     */
+    pub updates: UnsafeCell<Fifo<InFlightUpdate, u64>>,
+    pub write_next: Cell<u64>,
+}
+c_default!(moving_context);
+
+/* In flight: what ratelimit() throttles on, and flush_all() waits out */
+#[repr(C)]
+#[derive(CStruct, Default)]
+pub struct moving_io_counts {
+    pub read_sectors: AtomicI32,
+    pub write_sectors: AtomicI32,
+    pub read_ios: AtomicI32,
+    pub write_ios: AtomicI32,
+}
diff --git a/fs/bcachefs/data/move_types.rs b/fs/bcachefs/data/move_types.rs
new file mode 100644
index 0000000..3636eda
--- /dev/null
+++ b/fs/bcachefs/data/move_types.rs
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::types::{DArray, c_default};
+use crate::util::projections::Volatile;
+use core::ffi::{c_int, c_uint};
+use core::sync::atomic::{AtomicI32, AtomicI64};
+use cstruct_macros::{CStruct, c_typedef, TypeInfo};
+use nestify::nest;
+
+nest! {
+    /// What moves count into - whoever issues them, and their completions,
+    /// on any thread - and what the moving contexts' listing and a data job's
+    /// progress read as it goes. Shared throughout, so every field is a
+    /// Volatile, written one writer at a time, or an atomic, by many.
+    #[derive(CStruct, TypeInfo)]*
+    #[repr(C)]*
+    #[c_name(bch_move_stats)]
+    pub struct MoveStats {
+        #[c("char name[32]")]
+        pub name: [Volatile<u8>; 32],
+        #[c("enum bch_ioctl_data_event_ret ret")]
+        pub ret: Volatile<c::bch_ioctl_data_event_ret>,
+
+        /* Where the walk is: data_type and pos, or for phys, dev and offset */
+        #[c_anon]
+        pub at: pub struct bch_move_stats_at {
+            #[c("enum bch_data_type data_type")]
+            pub data_type: Volatile<c::bch_data_type>,
+            #[c("struct bbpos pos")]
+            pub pos: Volatile<c::bbpos>,
+            pub dev: Volatile<c_uint>,
+            pub offset: Volatile<u64>,
+        },
+
+        pub keys_moved: AtomicI64,
+        pub keys_raced: AtomicI64,
+        pub sectors_seen: AtomicI64,
+        pub sectors_moved: AtomicI64,
+        pub sectors_raced: AtomicI64,
+        pub sectors_error_corrected: AtomicI64,
+        pub sectors_error_uncorrected: AtomicI64,
+        #[c("struct bch_devs_mask devs_error_uncorrected")]
+        pub devs_error_uncorrected: c::AtomicDevsMask,
+    }
+}
+c_default!(MoveStats);
+
+/// C's name, as FFI declarations and the structs pointing at one spell it.
+pub type bch_move_stats = MoveStats;
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, PartialEq, Eq, Hash, CStruct)]
+pub struct move_bucket_key {
+    pub bucket: c::bpos,
+    pub generation: c_uint,
+}
+
+/*
+ * A bucket copygc's evacuating, as the moves see it: each holds a count until
+ * its update is done. The rest of what copygc keeps of it is Rust's,
+ * data/copygc.rs.
+ */
+#[repr(C)]
+#[derive(CStruct)]
+pub struct move_bucket {
+    pub count: AtomicI32,
+}
+
+/*
+ * What the journal scrub found wrong with an extent, for
+ * bch2_scrub_journal_do_repairs() once we're rw: the scrub runs with journal
+ * keys frozen, so it can neither repair nor record damage itself.
+ *
+ * @bad_devs is a mask of pointers by their position in @k, like ptrs_io_error,
+ * not of device indices. @read_err is set when reading them failed outright,
+ * rather than a replica being found bad on a read that succeeded.
+ *
+ * @level is 0 for an extent; for a btree node pointer it's the level @k lives
+ * at, one above the node's.
+ */
+#[repr(C)]
+#[derive(CStruct)]
+#[c_typedef]
+pub struct scrub_journal_repair {
+    pub btree_id: c::btree_id,
+    pub level: c_uint,
+    pub bad_devs: c_uint,
+    pub read_err: c_int,
+    pub k: c::bkey_i,
+    pub k_pad: [u64; c::BKEY_EXTENT_VAL_U64s_MAX],
+}
+c_default!(scrub_journal_repair);
+
+c_typedef! {
+    pub type darray_scrub_journal_repair = DArray<c::scrub_journal_repair>;
+}
diff --git a/fs/bcachefs/data/moving.rs b/fs/bcachefs/data/moving.rs
new file mode 100644
index 0000000..520c937
--- /dev/null
+++ b/fs/bcachefs/data/moving.rs
@@ -0,0 +1,584 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A moving context: what a mover's moves are issued and counted in - the
+//! walks that issue them are move_data.rs. A move is asynchronous: move_extent()
+//! returns once the read is issued, and the rest runs in the update's task
+//! (moving_update.rs) on the context's run queue. The run queue runs only in
+//! the context's waits, so all of a mover's updates run on its own thread,
+//! between its own steps. The waits sleep on the run queue's EventCount,
+//! woken by a task becoming ready and by every completion counted in the
+//! context.
+//!
+//! The context's updates are a fifo, in the order they were issued: an
+//! update's seq is its index there. It's what orders their writes - each
+//! starts once every update issued before it has started its - and what
+//! IoMark is: an update's seq, done once everything issued before it is. The
+//! mover's thread's alone, issuing and finishing, so not locked.
+//!
+//! The context is pinned - it's on c->moving_context_list, its closure waited
+//! on in place - and owns its transaction, trans(), which ratelimit(),
+//! flush_all() and move_extent() unlock: keys borrowed from it are stale
+//! after, as after any unlock. MovingCtxt owns one; moving through it is
+//! Moving's, a borrow - of a MovingCtxt, or of a context C hands Rust. IO that
+//! outlives the borrow, counted in the context, is a MovingIo.
+
+use crate::btree::bkey::BkeySC;
+use crate::btree::iter::{BtreeIter, BtreeTrans, TransFnName};
+use crate::c;
+use crate::c::bch_errcode;
+use crate::data::copygc::bch2_copygc_wait_not_running;
+use crate::errcode::BchError;
+use crate::fs::Fs;
+use crate::function_name;
+use crate::locking::Lock;
+use crate::prt;
+use crate::util::alloc::{alloc_pinned, free_pinned, AllocError, Flags};
+use crate::util::list::List;
+use crate::util::closure::ClosureRef;
+use crate::util::ffi::Opaque;
+use crate::util::{HumanReadable, Printbuf, ToText};
+use crate::util::refcount::Refcount;
+use crate::util::kthread::Kthread;
+use crate::util::task::RunQueue;
+use crate::util::sleep::Sleep;
+use crate::types::Fifo;
+use crate::util::gather::GatherRef;
+use core::marker::PhantomData;
+use core::ptr::NonNull;
+use core::sync::atomic::{AtomicI32, AtomicPtr};
+use core::sync::atomic::Ordering::Relaxed;
+use cstruct_macros::c_export;
+
+pub use c::MoveStats;
+
+impl MoveStats {
+    /// Zeroed, and named @name for the moving contexts' listing, as
+    /// bch2_move_stats_init() - field by field, as it may be read meanwhile.
+    pub fn reset(&self, name: &str) {
+        let name = name.as_bytes();
+        let len = name.len().min(self.name.len() - 1);
+        for (i, b) in self.name.iter().enumerate() {
+            b.set(if i < len { name[i] } else { 0 });
+        }
+        self.ret.set(c::bch_ioctl_data_event_ret(0));
+        self.at.data_type.set(c::bch_data_type::BCH_DATA_user);
+        self.at.pos.set(c::bbpos::default());
+        self.at.dev.set(0);
+        self.at.offset.set(0);
+
+        for n in [&self.keys_moved, &self.keys_raced, &self.sectors_seen, &self.sectors_moved,
+                  &self.sectors_raced, &self.sectors_error_corrected, &self.sectors_error_uncorrected] {
+            n.store(0, Relaxed);
+        }
+        self.devs_error_uncorrected.store(&Default::default());
+    }
+
+    pub fn sectors_seen(&self) -> u64 {
+        self.sectors_seen.load(Relaxed) as u64
+    }
+
+    pub fn add_sectors_seen(&self, sectors: u64) {
+        self.sectors_seen.fetch_add(sectors as i64, Relaxed);
+    }
+
+    pub fn sectors_moved(&self) -> u64 {
+        self.sectors_moved.load(Relaxed) as u64
+    }
+
+    /// Where whoever's moving through it is, for the listing.
+    pub fn set_pos(&self, pos: c::bbpos) {
+        self.at.pos.set(pos);
+    }
+
+    /// A walk's progress: at @iter's key, @sectors more seen.
+    pub fn walked(&self, iter: &BtreeIter<'_>, sectors: u64) {
+        self.set_pos(c::bbpos { btree: iter.btree(), pos: iter.pos() });
+        self.add_sectors_seen(sectors);
+    }
+
+    /// For the moving contexts' listing.
+    #[cold]
+    pub fn to_text(&self, out: &mut Printbuf) {
+        let mut name = [0u8; 32];
+        for (b, n) in name.iter_mut().zip(&self.name) {
+            *b = n.get();
+        }
+        let len = name.iter().position(|&b| b == 0).unwrap_or(name.len());
+        write!(out, "{}: data type==", core::str::from_utf8(&name[..len]).unwrap_or("(invalid name)"));
+        self.at.data_type.get().to_text(out);
+        write!(out, " pos={}\n", self.at.pos.get());
+
+        let mut out = out.indent(2);
+        write!(out, "keys moved:\t{}\n", self.keys_moved.load(Relaxed));
+        write!(out, "keys raced:\t{}\n", self.keys_raced.load(Relaxed));
+        let sectors = [("seen", &self.sectors_seen), ("moved", &self.sectors_moved), ("raced", &self.sectors_raced)];
+        for (what, n) in sectors {
+            prt!(out, "bytes {what}:\t{}\n", HumanReadable((n.load(Relaxed) as u64) << 9));
+        }
+    }
+}
+
+/// @k's sectors, for a walk's progress: an extent's size, a btree node
+/// pointer's node's.
+pub fn key_sectors(fs: &Fs, k: BkeySC<'_>) -> u64 {
+    if k.k.is_btree_ptr() { fs.btree_sectors().into() } else { k.k.size.into() }
+}
+
+/// A point in a context's IO: io_done() says whether everything issued
+/// before it has completed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct IoMark(u64);
+
+/// A data update in flight in its context, in the context's updates fifo.
+#[derive(Default)]
+pub struct InFlightUpdate {
+    /// What holds its turn to write, till every update issued before it has
+    /// started its write
+    turn:    Option<GatherRef<()>>,
+    started: bool,
+    done:    bool,
+}
+
+/// Freed - once what's in flight is done - when it's dropped.
+pub struct MovingCtxt<'a> {
+    ctxt: NonNull<c::moving_context>,
+    life: PhantomData<(&'a Fs, &'a MoveStats)>,
+}
+
+#[repr(transparent)]
+pub struct Moving<'a>(c::moving_context, PhantomData<(&'a Fs, &'a MoveStats)>);
+
+/// A read or a write in flight: counted in the context's read or write
+/// counts, which ratelimit() throttles on, with a ref on the context's
+/// closure, which flush_all() and the context's teardown wait for. Dropping
+/// it ends the IO: it gives the counts back, wakes the context's waiters, and
+/// puts the ref.
+#[must_use = "the IO is done as soon as it's dropped"]
+pub struct MovingIo {
+    ctxt:    NonNull<c::moving_context>,
+    write:   bool,
+    sectors: u32,
+    /// Dropped last: once it's put, the context may be gone
+    _cl:     ClosureRef,
+}
+
+// SAFETY: it touches only the context's counters, which are atomics, its wait
+// queue and its closure: any thread's. Its closure ref keeps the context.
+unsafe impl Send for MovingIo {}
+
+// SAFETY: evacuate_bucket()'s callers keep a bucket in flight until its count
+// is back to zero - copygc's InFlight, until done()
+unsafe impl Refcount for c::move_bucket {
+    fn inc(&self) {
+        self.count.fetch_add(1, Relaxed);
+    }
+
+    unsafe fn dec(&self) {
+        self.count.fetch_sub(1, core::sync::atomic::Ordering::Release);
+    }
+}
+
+fn io_counts(io: &c::moving_io_counts, write: bool) -> (&AtomicI32, &AtomicI32) {
+    if write { (&io.write_sectors, &io.write_ios) } else { (&io.read_sectors, &io.read_ios) }
+}
+
+impl Drop for MovingIo {
+    fn drop(&mut self) {
+        // SAFETY: our closure ref keeps the context
+        let moving = unsafe { Moving::from_raw(self.ctxt.as_ptr()) };
+        let (sectors, ios) = io_counts(moving.io(), self.write);
+        sectors.fetch_sub(self.sectors as i32, Relaxed);
+        ios.fetch_sub(1, Relaxed);
+        moving.wake();
+    }
+}
+
+impl<'a> MovingCtxt<'a> {
+    /// Moves counted into @stats, written to @wp; with @wait_on_copygc,
+    /// ratelimit() waits while copygc runs.
+    pub fn new(fs: &'a Fs, stats: &'a MoveStats, wp: c::write_point_specifier, wait_on_copygc: bool)
+        -> Result<MovingCtxt<'a>, AllocError>
+    {
+        // SAFETY: bch2_moving_ctxt_init() initializes all of it, in place
+        let init = unsafe {
+            ::pin_init::pin_init_from_closure(move |slot: *mut c::moving_context| {
+                bch2_moving_ctxt_init(slot, fs, core::ptr::from_ref(stats).cast_mut(), wp, wait_on_copygc);
+                Ok::<(), AllocError>(())
+            })
+        };
+        let ctxt = alloc_pinned(init)?;
+        Ok(MovingCtxt { ctxt: NonNull::new(ctxt).expect("alloc_pinned() returns its allocation"), life: PhantomData })
+    }
+}
+
+/// c->moving_context_list, for the listing: every context, from init to exit.
+type ContextList = List<c::moving_context, { core::mem::offset_of!(c::moving_context, list) }>;
+
+impl Fs {
+    /// The moving contexts, @f's alone - under moving_context_lock - while it
+    /// runs.
+    fn moving_contexts<R>(&self, f: impl FnOnce(&mut ContextList) -> R) -> R {
+        let _lock = Lock::from_c(&self.moving_context_lock).lock();
+        // SAFETY: the list, locked, and no other borrow of it in Rust: they're
+        // all here, and @f can't reenter, as the lock isn't
+        f(unsafe { ContextList::from_c((&raw const self.moving_context_list).cast_mut()) })
+    }
+}
+
+/// A moving context at @ctxt: its moves counted into @stats, written to @wp,
+/// and with @wait_on_copygc, ratelimit() waiting while copygc runs.
+///
+/// # Safety
+/// @ctxt doesn't move until bch2_moving_ctxt_exit(), and @stats - null, or
+/// not - outlives it.
+#[c_export]
+pub unsafe fn bch2_moving_ctxt_init(ctxt: *mut c::moving_context, c: &Fs, stats: *mut c::bch_move_stats,
+                                    wp: c::write_point_specifier, wait_on_copygc: bool) {
+    static FN: TransFnName = TransFnName::new();
+    // SAFETY: the caller's. Zeroed, a context is empty: what's left zero is
+    // valid so
+    unsafe {
+        ctxt.write_bytes(0, 1);
+        (*ctxt).trans = c::__bch2_trans_get(c.as_ptr(), FN.idx(function_name!()));
+        (*ctxt).stats = AtomicPtr::new(stats);
+        (*ctxt).wp = wp;
+        (*ctxt).wait_on_copygc = wait_on_copygc;
+        c::closure_init_stack((*ctxt).cl.as_ptr());
+    }
+
+    // SAFETY: @ctxt stays where it is till exit() takes it off, under the lock
+    c.moving_contexts(|l| unsafe { l.push_back(&*ctxt) });
+}
+
+/// bch2_moving_ctxt_init() undone, once what's in flight is done.
+///
+/// # Safety
+/// @ctxt is bch2_moving_ctxt_init()'s, and nothing else uses it meanwhile.
+#[c_export]
+pub unsafe fn bch2_moving_ctxt_exit(ctxt: *mut c::moving_context) {
+    // SAFETY: the caller's
+    let trans = unsafe {
+        let moving = Moving::from_raw(ctxt);
+        moving.flush_all();
+
+        #[cfg(CONFIG_BCACHEFS_DEBUG)]
+        {
+            let io = moving.io();
+            for n in [&io.read_sectors, &io.write_sectors, &io.read_ios, &io.write_ios] {
+                assert!(n.load(Relaxed) == 0, "a moving context's IO still counted at exit");
+            }
+        }
+
+        // on this list, if any
+        moving.trans().fs().moving_contexts(|l| l.remove(&*ctxt));
+        (*ctxt).trans
+    };
+
+    // Putting a transaction mid-restart is an unhandled restart, but a mover
+    // can be told to exit before it's retried: so begin first
+    // SAFETY: the context's, no longer borrowed; zeroed, it's as init()
+    // found it, its fifo's buffer freed first
+    unsafe {
+        c::bch2_trans_begin(trans);
+        c::bch2_trans_put(trans);
+        drop(core::mem::take(&mut *(*ctxt).updates.get()));
+        ctxt.write_bytes(0, 1);
+    }
+}
+
+impl<'a> core::ops::Deref for MovingCtxt<'a> {
+    type Target = Moving<'a>;
+
+    fn deref(&self) -> &Moving<'a> {
+        // SAFETY: ours, live and pinned until we're dropped
+        unsafe { Moving::from_raw(self.ctxt.as_ptr()) }
+    }
+}
+
+impl<'a> Moving<'a> {
+    /// # Safety
+    /// @ctxt is initialized, and outlives the borrow, and its filesystem and
+    /// stats live for 'a.
+    pub unsafe fn from_raw<'r>(ctxt: *mut c::moving_context) -> &'r Self {
+        // SAFETY: the caller's; repr(transparent) over it
+        unsafe { &*ctxt.cast() }
+    }
+
+    /// For an entry point C calls with its context: safe, as an Opaque is
+    /// always a live one.
+    pub fn from_c(ctxt: &'a Opaque<c::moving_context>) -> &'a Self {
+        // SAFETY: as above
+        unsafe { Self::from_raw(ctxt.as_ptr()) }
+    }
+
+    /// For C that takes the context: stripe repair, which moves through it.
+    pub(crate) fn raw(&self) -> *mut c::moving_context {
+        core::ptr::from_ref(&self.0).cast_mut()
+    }
+
+    /// A read or write of @sectors, in flight in this context until the
+    /// MovingIo's dropped.
+    pub fn io_start(&self, write: bool, sectors: u32) -> MovingIo {
+        let (s, ios) = io_counts(self.io(), write);
+        s.fetch_add(sectors as i32, Relaxed);
+        ios.fetch_add(1, Relaxed);
+        MovingIo { ctxt: NonNull::from(&self.0), write, sectors, _cl: self.0.cl.get() }
+    }
+
+    pub fn trans(&self) -> &BtreeTrans<'a> {
+        // SAFETY: the context's, live as long as it is
+        unsafe { BtreeTrans::borrow_raw(self.0.trans) }
+    }
+
+    /// Count moves from here on into @stats - as the listing has it, which
+    /// reads the pointer racily, as it does in C.
+    pub fn set_stats(&self, stats: &'a MoveStats) {
+        self.0.stats.store(core::ptr::from_ref(stats).cast_mut(), Relaxed)
+    }
+
+    pub fn stats(&self) -> &MoveStats {
+        self.stats_opt().expect("a Rust moving context has stats")
+    }
+
+    /// A context C made may have no stats.
+    pub(crate) fn stats_opt(&self) -> Option<&MoveStats> {
+        // SAFETY: null, or set from a &'a MoveStats
+        unsafe { self.0.stats.load(Relaxed).as_ref() }
+    }
+
+    pub(crate) fn io(&self) -> &c::moving_io_counts {
+        &self.0.io
+    }
+
+    pub(crate) fn write_point(&self) -> c::write_point_specifier {
+        self.0.wp
+    }
+
+    fn with_updates<R>(&self, f: impl FnOnce(&mut Fifo<InFlightUpdate, u64>) -> R) -> R {
+        // SAFETY: the mover's thread's alone, and not reentered: @f is
+        // ours, and touches nothing of the context's but the fifo
+        f(unsafe { &mut *self.0.updates.get() })
+    }
+
+    /// Room for one more update, for update_issue().
+    pub(crate) fn updates_reserve(&self, gfp: Flags) -> Result<(), AllocError> {
+        self.with_updates(|f| f.reserve(1, gfp))
+    }
+
+    /// An update issued: its seq. @turn holds its turn to write till every
+    /// update issued before it has started its write.
+    pub(crate) fn update_issue(&self, turn: GatherRef<()>) -> u64 {
+        let w = self.0.write_next.get();
+        self.with_updates(|f| {
+            let seq = f.back_idx();
+            let turn = if seq == w {
+                turn.put(());
+                None
+            } else {
+                Some(turn)
+            };
+            if f.push_back(InFlightUpdate { turn, ..Default::default() }).is_err() {
+                unreachable!("an update issued without updates_reserve()");
+            }
+            seq
+        })
+    }
+
+    /// Update @seq's write starting - or, at exit, never to: the next update's
+    /// turn, if every update before it has started.
+    pub(crate) fn update_write_start(&self, seq: u64) {
+        let mut w = self.0.write_next.get();
+        self.with_updates(|f| {
+            f.get_mut(seq).expect("an update not in flight").started = true;
+            while f.get(w).is_some_and(|u| u.started) {
+                w += 1;
+            }
+            if let Some(turn) = f.get_mut(w).and_then(|u| u.turn.take()) {
+                turn.put(());
+            }
+        });
+        self.0.write_next.set(w);
+    }
+
+    /// Update @seq done: off the fifo, once everything issued before it is.
+    pub(crate) fn update_done(&self, seq: u64) {
+        self.update_write_start(seq);
+        self.with_updates(|f| {
+            f.get_mut(seq).expect("an update not in flight").done = true;
+            while f.peek_front().is_some_and(|u| u.done) {
+                f.pop_front();
+            }
+        });
+    }
+
+    /// No update in flight.
+    pub(crate) fn updates_idle(&self) -> bool {
+        self.with_updates(|f| f.is_empty())
+    }
+
+    pub(crate) fn wake(&self) {
+        self.runq().events().wake()
+    }
+
+    /// Wait until fewer than the filesystem's limits are in flight - and, if
+    /// it waits on copygc, until copygc isn't running: errors if the
+    /// filesystem's going read-only, or the thread's stopping.
+    pub fn ratelimit(&self) -> Result<(), BchError> {
+        let fs = self.trans().fs();
+        if self.0.wait_on_copygc && fs.copygc.running.get() {
+            self.flush_all();
+            bch2_copygc_wait_not_running(fs);
+        }
+
+        if Kthread::should_stop() {
+            return fs.throw(bch_errcode::BCH_ERR_kthread_cancelled);
+        }
+        if fs.flag(c::bch_fs_flags::BCH_FS_going_ro) {
+            return fs.throw(bch_errcode::BCH_ERR_erofs_no_writes);
+        }
+        if Kthread::freezing() {
+            self.trans().unlock_long();
+            Kthread::try_to_freeze();
+        }
+
+        // XXX: these limits really ought to be per device, SSDs and hard
+        // drives will want different limits
+        let opts = fs.opts();
+        let (sectors, ios) = (opts.move_bytes_in_flight >> 9, opts.move_ios_in_flight);
+        // compared unsigned, so a count gone negative is over the limit
+        let under = |n: &core::sync::atomic::AtomicI32, max: u32| (n.load(Relaxed) as u32) < max;
+        let io = self.io();
+        self.wait_until(|| {
+            (under(&io.write_sectors, sectors) && under(&io.read_sectors, sectors) &&
+             under(&io.write_ios, ios) && under(&io.read_ios, ios)).then_some(())
+        });
+        Ok(())
+    }
+
+    pub fn wait_for_io(&self) {
+        let w = &self.io().write_sectors;
+        let pending = w.load(Relaxed);
+        self.wait_until(|| {
+            let now = w.load(Relaxed);
+            (now == 0 || now != pending).then_some(())
+        })
+    }
+
+    /// Waits for everything in flight in the context, including reads waiting
+    /// their turn to write, and the closure refs of anything else moving
+    /// through it.
+    pub fn flush_all(&self) {
+        let io = self.io();
+        // Waited for freezably: the closure_sync() after only covers the
+        // closure_put() that follows each completion's wakeup
+        self.wait_until(|| {
+            (io.read_ios.load(Relaxed) == 0 && io.write_ios.load(Relaxed) == 0 &&
+             self.updates_idle()).then_some(())
+        });
+        self.trans().unlock_long();
+        // SAFETY: the context's closure, which this thread owns
+        unsafe { c::closure_sync(self.0.cl.as_ptr()) };
+    }
+
+    /// Waits until @cond, running the context's tasks as they become ready and
+    /// sleeping with the transaction unlocked. @cond is called once per wake,
+    /// so it may be a trylock.
+    pub fn wait_until<T>(&self, mut cond: impl FnMut() -> Option<T>) -> T {
+        let runq = self.runq();
+        let events = runq.events();
+        loop {
+            // A task may run a transaction of its own - an EC allocation
+            // failure parks its extent - which mustn't wait on ours
+            if runq.has_ready() {
+                self.trans().unlock_long();
+                runq.run();
+            }
+            // before @cond, so a wake after it isn't missed
+            let seen = events.snapshot();
+            if let Some(v) = cond() {
+                return v;
+            }
+            self.trans().unlock_long();
+
+            if !runq.has_ready() {
+                let Ok(()) = events.wait(seen, Sleep::UNINTERRUPTIBLE.freezable());
+            }
+        }
+    }
+
+    pub(crate) fn runq(&self) -> core::pin::Pin<&RunQueue> {
+        // SAFETY: the context's, pinned - it's on c->moving_context_list -
+        // and live while borrowed
+        unsafe { core::pin::Pin::new_unchecked(&self.0.runq) }
+    }
+
+    #[cold]
+    fn to_text(&self, out: &mut Printbuf) {
+        let opts = self.trans().fs().opts();
+        let (ios, sectors) = (opts.move_ios_in_flight, opts.move_bytes_in_flight >> 9);
+
+        if out.nr_tabstops() == 0 {
+            out.tabstop_push(32);
+        }
+        if let Some(stats) = self.stats_opt() {
+            stats.to_text(out);
+        }
+
+        let io = self.io();
+        let mut out = out.indent(2);
+        write!(out, "reads: ios {}/{ios} sectors {}/{sectors}\n",
+               io.read_ios.load(Relaxed), io.read_sectors.load(Relaxed));
+        write!(out, "writes: ios {}/{ios} sectors {}/{sectors}\n",
+               io.write_ios.load(Relaxed), io.write_sectors.load(Relaxed));
+    }
+
+    pub fn io_mark(&self) -> IoMark {
+        IoMark(self.with_updates(|f| f.back_idx()))
+    }
+
+    /// Whether everything issued before @mark has completed.
+    pub fn io_done(&self, mark: IoMark) -> bool {
+        self.with_updates(|f| f.front_idx()) >= mark.0
+    }
+}
+
+impl Fs {
+    /// The moving contexts' listing: every context, its stats and IO in flight.
+    #[cold]
+    pub fn moving_ctxts_to_text(&self, out: &mut Printbuf) {
+        self.moving_contexts(|l| {
+            let mut cursor = l.cursor_mut();
+            while let Some(ctxt) = cursor.current() {
+                // SAFETY: on the list from init() to exit(), which takes it
+                // off under the lock
+                unsafe { Moving::from_raw(core::ptr::from_ref(ctxt).cast_mut()) }.to_text(out);
+                cursor.move_next();
+            }
+        })
+    }
+}
+
+impl c::data_update {
+    /// The moving context the update is in flight in, if it's a mover's.
+    pub(crate) fn moving(&self) -> Option<&Moving<'_>> {
+        // SAFETY: an update is in flight in its context from init() to exit(),
+        // and the context's flush_all() waits for it before the context goes
+        NonNull::new(self.ctxt).map(|c| unsafe { Moving::from_raw(c.as_ptr()) })
+    }
+}
+
+#[c_export]
+pub fn bch2_moving_ctxt_flush_all(ctxt: &Opaque<c::moving_context>) {
+    Moving::from_c(ctxt).flush_all()
+}
+
+impl Drop for MovingCtxt<'_> {
+    fn drop(&mut self) {
+        // SAFETY: ours, from new(); bch2_moving_ctxt_exit() waits for what's
+        // in flight before taking it off the list and putting the transaction
+        unsafe {
+            bch2_moving_ctxt_exit(self.ctxt.as_ptr());
+            free_pinned(self.ctxt.as_ptr());
+        }
+    }
+}
