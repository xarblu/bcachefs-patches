+// SPDX-License-Identifier: GPL-2.0
+
+//! Snapshot fsck: the passes over the snapshots and snapshot_trees btrees.
+//!
+//! check_snapshot_trees: every tree key names a live root and master subvol.
+//!
+//! check_snapshots: per node - check_state() recovers the state field itself;
+//! check_has_data() and check_deleted() hold a non-live state up against the
+//! accounting, the child snapshots and the subvolume; then the topology checks
+//! (edges, tree pointer, depth, skiplists, subvol backref).
+//!
+//! reconstruct_snapshots: rebuild missing nodes from the keys that reference
+//! them.
+//!
+//! check_key_has_snapshot: per-key repair for keys whose snapshot is missing
+//! or dead; also called at runtime, through bch2_check_key_has_snapshot().
+//!
+//! Before repairing a state, enumerate which writers can produce it.
+//! Unconstructible combinations are rejected at commit
+//! (bch2_snapshot_validate()); real damage is repaired toward what the rest of
+//! the metadata agrees on - the child snapshots, the subvolume (deletion
+//! tombstones it in the transaction that condemns its snapshot), the
+//! per-snapshot accounting (nothing we write deletes a node with data).
+//! Ambiguity fail-stops rather than guessing.
+//!
+//! The node being checked is a CowKey: one copy, read by every check and
+//! written by every repair, so one repair can't lose another's.
+
+use crate::btree::bkey::prelude::*;
+use crate::accounting;
+use crate::btree::bkey::{pos, BkeyI, BkeySC, POS_MAX, POS_MIN, SPOS_MAX};
+use crate::btree::cow_key::CowKey;
+use crate::btree::iter::{
+    commit_do, BtreeIter, BtreeIterFlags, BtreeTrans, CommitFlags, TransAttempt, TransBkey,
+    UpdateTriggerFlags,
+};
+use crate::c;
+use crate::c::bch_recovery_pass::*;
+use crate::c::snapshot_id_state as IdState;
+use crate::check;
+use crate::errcode::{bch_errcode, BchError, Found};
+use crate::fs::Fs;
+use crate::init::error::id;
+use crate::init::passes;
+use crate::init::progress::Progress;
+use crate::inode;
+use crate::snapshots::{delete, snapshot, subvolume};
+use crate::util::alloc::{flags::GFP_KERNEL, KVVec};
+use crate::util::{Join, Printbuf, ToText};
+use crate::{bch_err, bch_err_fn, fsck_err, fsck_err_on, fsck_err_report, inode_fsck_err, prt};
+use core::fmt;
+use cstruct_macros::c_export;
+
+/// Snapshot node @id's key, None if there's none: fsck can't assume a node
+/// exists, and absence as a value can't be returned as an error by mistake.
+/// The whole key: the topology checks print nodes they didn't start from.
+fn lookup_node(t: &TransAttempt<'_, '_>, id: u32) -> Result<Option<BkeyI<c::Snapshot>>, BchError> {
+    snapshot::lookup_key(t, id).found()
+}
+
+/// Snapshot node @id's key, as a mutable copy queued for the commit.
+fn get_mut_node<'a, 't>(t: &TransAttempt<'a, 't>, id: u32)
+    -> Result<TransBkey<'a, 't, c::Snapshot>, BchError>
+{
+    t.bkey_get_mut(c::btree_id::snapshots, pos(0, id as u64), BtreeIterFlags::empty(),
+                   UpdateTriggerFlags::empty())
+}
+
+/// The id - offset - of the first key in @btree @pred accepts: for the
+/// btrees keyed by id, subvolumes and snapshot trees.
+fn find_key(
+    t:        &TransAttempt<'_, '_>,
+    btree:    c::btree_id,
+    mut pred: impl FnMut(BkeySC<'_>) -> bool,
+) -> Result<Option<u32>, BchError> {
+    let mut iter = BtreeIter::new(t, btree, POS_MIN, BtreeIterFlags::empty());
+    Ok(iter.find_max_norestart(t, SPOS_MAX, |_, k| Ok(pred(k)))?
+       .map(|k| k.k.p.offset as u32))
+}
+
+/// A subvolume claiming snapshot @id - to restore a wiped backref.
+fn subvol_claiming(t: &TransAttempt<'_, '_>, id: u32) -> Result<Option<u32>, BchError> {
+    find_key(t, c::btree_id::subvolumes,
+             |k| subvolume::val(k).is_some_and(|s| s.snapshot() == id))
+}
+
+/// A state field by name; "(invalid state)" if it isn't one.
+struct StateName(Option<c::bch_snapshot_state>);
+
+impl fmt::Display for StateName {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self.0 {
+            Some(s) => write!(f, "{s}"),
+            None    => f.write_str("(invalid state)"),
+        }
+    }
+}
+
+/* check_snapshot_trees: */
+
+/// A subvolume for snapshot tree @root to name as its master: a
+/// non-snapshot subvolume in the tree, or failing that the oldest one, made a
+/// non-snapshot subvolume. None if the tree has none.
+fn tree_master_subvol(t: &TransAttempt<'_, '_>, root: u32) -> Result<Option<u32>, BchError> {
+    let fs = t.fs();
+
+    let found = find_key(t, c::btree_id::subvolumes, |k| {
+        subvolume::val(k).is_some_and(|s| snapshot::is_ancestor(t, s.snapshot(), root) && !s.snap())
+    })?;
+    if found.is_some() {
+        return Ok(found);
+    }
+
+    let Some(oldest) = fs.snapshots.oldest_subvol(root) else { return Ok(None) };
+    let Some(mut u) = t.bkey_get_mut::<c::Subvolume>(c::btree_id::subvolumes, pos(0, oldest as u64),
+                                                     BtreeIterFlags::empty(),
+                                                     UpdateTriggerFlags::empty()).found()? else {
+        return Ok(None);
+    };
+    u.v_mut().set_snap(false);
+    Ok(Some(oldest))
+}
+
+/// Tree key @k must name a root that points back, or it's deleted; and its
+/// master must be a non-snapshot subvolume in the tree, or it's corrected.
+fn check_snapshot_tree<'t>(
+    t:    &TransAttempt<'_, 't>,
+    iter: &BtreeIter<'t>,
+    k:    BkeySC<'_>,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    let Some(k) = k.arm::<c::SnapshotTree>() else { return Ok(()) };
+    let st = k.v();
+    let root_id = st.root_snapshot.get();
+
+    let root = match snapshot::lookup_key(t, root_id) {
+        Err(e) if !e.matches(c::ENOENT) => return Err(e),
+        r => r,
+    };
+
+    let bad = match &root {
+        Err(_) => true,
+        Ok(r)  => root_id != fs.snapshots.root(root_id) || k.k.p.offset as u32 != r.v.tree(),
+    };
+    if bad {
+        let mut found = Printbuf::new();
+        match &root {
+            Err(e) => write!(found, "({})", e.msg()),
+            Ok(r)  => prt!(&mut found, "{}", r.to_text(fs)),
+        }
+        if fsck_err!(t, id::snapshot_tree_to_missing_snapshot,
+                     "snapshot tree points to missing/incorrect snapshot:\n{}\n{}",
+                     k.to_text(fs), found)? {
+            return t.delete_at(iter, UpdateTriggerFlags::empty());
+        }
+    }
+
+    let master = st.master_subvol.get();
+    if master == 0 {
+        return Ok(());
+    }
+
+    let repair = match subvolume::get(t, master, false).found()? {
+        None => fsck_err!(t, id::snapshot_tree_to_missing_subvol,
+                          "snapshot tree points to missing subvolume:\n{}", k.to_text(fs))?,
+        Some(s) =>
+            fsck_err_on!(t, !snapshot::is_ancestor(t, s.snapshot(), root_id),
+                         id::snapshot_tree_to_wrong_subvol,
+                         "snapshot tree points to subvolume that does not point to snapshot in this tree:\n{}",
+                         k.to_text(fs))? ||
+            fsck_err_on!(t, s.snap(), id::snapshot_tree_to_snapshot_subvol,
+                         "snapshot tree points to snapshot subvolume:\n{}", k.to_text(fs))?,
+    };
+    if !repair {
+        return Ok(());
+    }
+
+    let Some(subvol) = bch_err_fn!(fs, tree_master_subvol(t, root_id))? else {
+        return Ok(());   /* nothing to be done here */
+    };
+
+    let mut u = t.bkey_make_mut(iter, k, UpdateTriggerFlags::empty())?;
+    u.v_mut().master_subvol = subvol.into();
+    Ok(())
+}
+
+fn check_snapshot_trees(fs: &Fs) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+    let mut iter = BtreeIter::new(&trans, c::btree_id::snapshot_trees, POS_MIN,
+                                  BtreeIterFlags::PREFETCH);
+    iter.for_each_commit(&trans, None, CommitFlags::NO_ENOSPC,
+                         |t, iter, k| check_snapshot_tree(t, iter, k))
+}
+
+crate::recovery_pass!(bch2_check_snapshot_trees => check_snapshot_trees);
+
+/* check_snapshots: */
+
+/// The node being checked.
+impl CowKey<'_, '_, '_, '_, c::Snapshot> {
+    fn id(&self) -> u32 {
+        self.pos().offset as u32
+    }
+}
+
+/// Whether anything points at node @s, @id: a subvolume, its parent, or a
+/// child. For a garbage state field: a referenced node must be live.
+fn referenced(t: &TransAttempt<'_, '_>, s: &c::Snapshot, id: u32) -> Result<bool, BchError> {
+    if s.subvol() != 0 &&
+       subvolume::get(t, s.subvol(), false).found()?.is_some_and(|sv| sv.snapshot() == id) {
+        return Ok(true);
+    }
+
+    if s.parent() != 0 &&
+       lookup_node(t, s.parent())?.is_some_and(|p| points_at(&p.v, Role::Parent, id)) {
+        return Ok(true);
+    }
+
+    for child in s.children() {
+        if child != 0 &&
+           lookup_node(t, child)?.is_some_and(|ch| points_at(&ch.v, Role::Child, id)) {
+            return Ok(true);
+        }
+    }
+
+    Ok(false)
+}
+
+/// Recover the state field itself: stamp it from the legacy flags when
+/// unset, decode a corrupted value back to the nearest codeword, and correct
+/// a state left stale by a legacy flags-only tombstone.
+fn check_state<'a, 't>(
+    t: &TransAttempt<'a, 't>,
+    n: &mut CowKey<'_, '_, 'a, 't, c::Snapshot>,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    // Predates the state field, or was wiped: the legacy flags, which old kernels
+    // dual-wrote, are authoritative - past the upgrade too, for keys never
+    // migrated. Silent mid-upgrade, autofix after.
+    if n.v().state().get() == 0 {
+        let upgrading = fs.version_upgrade_complete() <
+            c::bcachefs_metadata_version::per_dev_fragmentation_lru;
+        if upgrading ||
+           fsck_err!(t, id::snapshot_state_bad,
+                     "snapshot state unset, recovering from legacy flags:\n{}", n.to_text(fs))? {
+            let state = n.v().state_from_flags();
+            n.v_mut(t)?.state = state.0.into();
+        }
+    }
+
+    // The repairs below go by the state, so it has to be readable first.
+    if n.v().state_field().is_none() {
+        let raw = n.v().state().get();
+        let (nearest, dist) = snapshot::state_nearest(raw);
+
+        // Codewords are >= 14 bits apart: within 6 bits, the nearest is the
+        // original. Within 2 is a bitflip, counted apart so failing hardware shows;
+        // further than 6 can't be trusted.
+        let fix = if dist <= 2 {
+            fsck_err!(t, id::snapshot_state_bitflip,
+                      "snapshot state {raw:#x} is a {dist}-bit flip of {nearest} - correcting:\n{}",
+                      n.to_text(fs))?.then_some(nearest)
+        } else if dist <= 6 {
+            fsck_err!(t, id::snapshot_state_bad,
+                      "snapshot state {raw:#x} is {dist} bits from {nearest} - correcting:\n{}",
+                      n.to_text(fs))?.then_some(nearest)
+        } else if referenced(t, n.v(), n.id())? {
+            // Too far to decode, but if anything references it, it must be live
+            fsck_err!(t, id::snapshot_state_bad,
+                      "snapshot state {raw:#x} is garbage, but the node is referenced - marking live:\n{}",
+                      n.to_text(fs))?.then_some(c::bch_snapshot_state::SNAPSHOT_STATE_live)
+        } else {
+            // An unreferenced garbage node we can't place: fail-stop.
+            fsck_err_report!(fs, id::snapshot_state_bad,
+                             "snapshot has invalid state {raw:#x} (nearest codeword {nearest} is {dist} bits away, node unreferenced):\n{}",
+                             n.to_text(fs));
+            return Err(fs.err(bch_errcode::BCH_ERR_fsck_repair_unimplemented));
+        };
+
+        if let Some(state) = fix {
+            n.v_mut(t)?.set_state(state);
+        }
+    }
+
+    // A valid state contradicting the legacy flags: only a legacy flags-only
+    // writer does that, so the flags are the fresher write. But they're single
+    // unprotected bits: trust them only on a node shaped like a legacy
+    // bch2_snapshot_node_delete() tombstone - tree == 0, which nothing else ever
+    // has. Left stale, the interior-deletion collector tombstones the node and the
+    // edge checks fail-stop on its breadcrumb, wedging every mount (2026-07-20
+    // field report; snapshot-inject/stale_state_tombstone).
+    let v = n.v();
+    if fsck_err_on!(t,
+                    v.state().get() != c::bch_snapshot_state::SNAPSHOT_STATE_deleted.0 &&
+                    v.deleted_obsolete() &&
+                    v.tree == 0,
+                    id::snapshot_state_stale_tombstone,
+                    "snapshot spliced out by a legacy kernel (tombstone shape, legacy deleted flag)\n\
+                     but the state field is stale at {} - correcting to deleted:\n{}",
+                    StateName(v.state_field()), n.to_text(fs))? {
+        n.v_mut(t)?.set_state(c::bch_snapshot_state::SNAPSHOT_STATE_deleted);
+    }
+
+    Ok(())
+}
+
+/// Data first: nothing we write deletes a node with keys still accounted to
+/// it, so data means the state field is the lie. Settled here, every check
+/// after - and every edge repair a parent runs against this node - sees a
+/// state held up against the accounting.
+///
+/// deleted was spliced out of the tree, so reviving it undoes the splice;
+/// no_keys is only ever marked, so setting it live is the whole repair.
+fn check_has_data<'a, 't>(
+    t: &TransAttempt<'a, 't>,
+    n: &mut CowKey<'_, '_, 'a, 't, c::Snapshot>,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+    let state = n.v().state_field();
+
+    if state != Some(c::bch_snapshot_state::SNAPSHOT_STATE_deleted) && state != Some(c::bch_snapshot_state::SNAPSHOT_STATE_no_keys) {
+        return Ok(());
+    }
+    let no_keys = state == Some(c::bch_snapshot_state::SNAPSHOT_STATE_no_keys);
+
+    let acct = fs.snapshots.accounting(n.id());
+
+    if !fsck_err_on!(t, !acct.is_empty(), id::snapshot_deleted_but_has_data,
+                     "{} snapshot node has data accounted - {}:{}\n{}",
+                     StateName(state),
+                     if no_keys { "clearing state" } else { "undeleting" },
+                     acct, n.to_text(fs))? {
+        return Ok(());
+    }
+
+    if no_keys {
+        n.v_mut(t)?.set_state(c::bch_snapshot_state::SNAPSHOT_STATE_live);
+        Ok(())
+    } else {
+        undelete_owns_data(t, n.u(t)?)
+    }
+}
+
+/// A non-live state, checked against the child snapshots and the
+/// subvolume. True if the node is a settled tombstone: no further checking.
+fn check_deleted<'a, 't>(
+    t: &TransAttempt<'a, 't>,
+    n: &mut CowKey<'_, '_, 'a, 't, c::Snapshot>,
+) -> Result<bool, BchError> {
+    let fs = t.fs();
+    let id = n.id();
+
+    if n.v().state().get() == c::bch_snapshot_state::SNAPSHOT_STATE_live.0 {
+        return Ok(false);
+    }
+
+    // A non-live node can't have two live children pointing back at it: two
+    // subtrees still depend on it as their common ancestor. Revive it - before
+    // the deleted early-out, falling through to the edge, depth and tree checks.
+    // One live child is legal: a no_keys node keeps its one descendant so
+    // ancestry resolves. A child no longer naming us is a splice breadcrumb, not
+    // counted.
+    let mut nr_live_children = 0;
+    for child in n.v().children() {
+        if child != 0 &&
+           lookup_node(t, child)?.is_some_and(|ch| ch.v.state_decoded() == Some(c::bch_snapshot_state::SNAPSHOT_STATE_live) &&
+                                                      points_at(&ch.v, Role::Child, id)) {
+            nr_live_children += 1;
+        }
+    }
+
+    if fsck_err_on!(t, nr_live_children == 2, id::snapshot_deleted_has_live_children,
+                    "snapshot marked {} but has two live children - reviving:\n{}",
+                    StateName(n.v().state_field()), n.to_text(fs))? {
+        n.v_mut(t)?.set_state(c::bch_snapshot_state::SNAPSHOT_STATE_live);
+    }
+
+    // Deletion tombstones the subvolume in the transaction that marks its
+    // snapshot, so a non-live leaf whose subvolume is live and points back has a
+    // bad state field - including one check_state() stamped from a corrupt legacy
+    // flag. (A tombstoned subvolume reads as ENOENT: normal mid-deletion.)
+    let v = n.v();
+    if v.children()[0] == 0 && v.subvol() != 0 {
+        let subvol_live = subvolume::get(t, v.subvol(), false).found()?.is_some_and(|sv|
+            sv.state_decoded() == Some(c::bch_subvolume_state::SUBVOLUME_STATE_live) && sv.snapshot() == id);
+
+        if subvol_live &&
+           fsck_err!(t, id::snapshot_deleted_but_subvol_live,
+                     "snapshot marked {} but its subvolume is live - reviving:\n{}",
+                     StateName(v.state_field()), n.to_text(fs))? {
+            n.v_mut(t)?.set_state(c::bch_snapshot_state::SNAPSHOT_STATE_live);
+        }
+    }
+
+    Ok(n.v().state().get() == c::bch_snapshot_state::SNAPSHOT_STATE_deleted.0)
+}
+
+/* Parent <-> child edge checks and repair:
+ *
+ * An edge is repaired only if the surviving pointer and the two nodes' id
+ * ordering, tree and depth all agree (those are checked before the
+ * depth/skip autofixes rewrite them). If they don't, fail-stop: a wrong join
+ * or split moves keys between subvolume visibilities. Never write "I don't
+ * know" to disk: a node with a zeroed parent masquerades as a tree root and
+ * gets consumed by the tree-pointer repair or the deletion machinery.
+ * Repairs commit and restart, so decisions only see settled state. The
+ * in-memory snapshot table serves as the reverse index (live nodes only: a
+ * tombstone's child pointer is a splice breadcrumb, not a claim).
+ */
+
+/// A node's end of a parent/child edge - and so which of its pointers names
+/// the other end: a parent's children, a child's parent.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Role {
+    Parent,
+    Child,
+}
+
+impl Role {
+    fn other(self) -> Self {
+        match self {
+            Role::Parent => Role::Child,
+            Role::Child  => Role::Parent,
+        }
+    }
+
+    /// What this end's pointer is called.
+    fn ptr_name(self) -> &'static str {
+        match self {
+            Role::Parent => "child",
+            Role::Child  => "parent",
+        }
+    }
+}
+
+/// Whether @s, as @role, points at @other.
+fn points_at(s: &c::Snapshot, role: Role, other: u32) -> bool {
+    match role {
+        Role::Parent => s.children().contains(&other),
+        Role::Child  => s.parent() == other,
+    }
+}
+
+/// Point @s's @role pointer at @old to @new instead - 0 clears a child slot
+/// - keeping the children in order.
+fn set_ptr(s: &mut c::Snapshot, role: Role, old: u32, new: u32) {
+    match role {
+        Role::Child  => s.parent = new.into(),
+        Role::Parent => {
+            if let Some(child) = s.children.iter_mut().find(|c| (**c).get() == old) {
+                *child = new.into();
+            }
+            if s.children()[0] < s.children()[1] {
+                s.children.swap(0, 1);
+            }
+        }
+    }
+}
+
+/// Whether @s, @id, as @role, and @o, @o_id, are shaped like the two ends of
+/// one edge: the parent's id above the child's, the same tree, and the
+/// child one deeper.
+fn parent_child_consistent(s: &c::Snapshot, id: u32, role: Role,
+                           o: &c::Snapshot, o_id: u32) -> bool {
+    let ((pa, pa_id), (ch, ch_id)) = match role {
+        Role::Parent => ((s, id), (o, o_id)),
+        Role::Child  => ((o, o_id), (s, id)),
+    };
+
+    ch_id < pa_id && pa.tree == ch.tree && pa.depth().get().checked_add(1) == Some(ch.depth().get())
+}
+
+/// Whether node @n, @n_id, as @role, has a pointer slot that's empty, or
+/// whose current target doesn't reciprocate - and if so, the value that
+/// would be displaced. Empty slots first, so a stale pointer keeps its own
+/// shot at repair when its node is visited.
+fn ptr_available(t: &TransAttempt<'_, '_>, n: &c::Snapshot, n_id: u32, role: Role)
+    -> Result<Option<u32>, BchError>
+{
+    let parent = [n.parent()];
+    let children = n.children();
+    let ptrs: &[u32] = match role {
+        Role::Child  => &parent,
+        Role::Parent => &children,
+    };
+
+    if ptrs.contains(&0) {
+        return Ok(Some(0));
+    }
+
+    for &p in ptrs {
+        if !lookup_node(t, p)?.is_some_and(|n| points_at(&n.v, role.other(), n_id)) {
+            return Ok(Some(p));
+        }
+    }
+
+    Ok(None)
+}
+
+/// Whether snapshot @id owns anything: any nonzero counter in any snapshotted
+/// btree. Keys as well as sectors: a snapshot of only dirents or xattrs has no
+/// sectors.
+fn has_accounting(fs: &Fs, id: u32) -> bool {
+    accounting::snapshot_btrees(fs, id).any(|v| v.iter().any(|&x| x != 0))
+}
+
+/// Commit an edge repair, have the table rebuilt, and restart: decisions
+/// only see settled state. The commit first - the restart would discard the
+/// repair.
+fn edge_repair_commit(t: &TransAttempt<'_, '_>) -> Result<(), BchError> {
+    let fs = t.fs();
+    t.commit(None, CommitFlags::NO_ENOSPC)?;
+    fs.snapshots.set_need_table_rebuild();
+    Err(t.restart(bch_errcode::BCH_ERR_transaction_restart_nested))
+}
+
+/// Put a node the accounting says is alive, @u, back into the tree. With two
+/// children it was never spliced out: setting it live is the whole repair,
+/// and node_undelete() rejects that shape. Otherwise it relinks through the
+/// parent, which has to be live first.
+fn undelete_owns_data<'t>(t: &TransAttempt<'_, 't>, u: &mut TransBkey<'_, 't, c::Snapshot>)
+    -> Result<(), BchError>
+{
+    let s = u.v_mut();
+    if s.children()[1] != 0 {
+        s.set_state(c::bch_snapshot_state::SNAPSHOT_STATE_live);
+        return Ok(());
+    }
+
+    undelete_ancestors(t, s.parent())?;
+    delete::node_undelete(t, u)
+}
+
+/// The highest dead node from @id up: the one whose own parent is still in
+/// the tree.
+fn topmost_dead_ancestor(t: &TransAttempt<'_, '_>, mut id: u32) -> Result<Option<u32>, BchError> {
+    let mut topmost = None;
+
+    while id != 0 {
+        // a missing parent is undelete's to report, against the node naming it
+        let Some(s) = lookup_node(t, id)? else { break };
+        if s.v.state_decoded() != Some(c::bch_snapshot_state::SNAPSHOT_STATE_deleted) {
+            break;
+        }
+
+        topmost = Some(id);
+
+        let parent = s.v.parent();
+        if parent <= id {
+            break;
+        }
+        id = parent;
+    }
+
+    Ok(topmost)
+}
+
+/// Undelete relinks through the parent, so undelete @id's dead ancestors first,
+/// the topmost per commit - the chain is unbounded. Refusing would make a
+/// repairable filesystem go emergency read-only. Nothing corroborates them;
+/// they stay because the node below ends up live. Depth and skiplists are left
+/// for snapshot_bad_depth/snapshot_bad_skiplist.
+fn undelete_ancestors(t: &TransAttempt<'_, '_>, id: u32) -> Result<(), BchError> {
+    let Some(topmost) = topmost_dead_ancestor(t, id)? else { return Ok(()) };
+
+    let mut u = get_mut_node(t, topmost)?;
+    undelete_owns_data(t, &mut u)?;
+    edge_repair_commit(t)
+}
+
+/// Recreate missing child @id of @parent_id, as a leaf. Nothing we write
+/// removes a node with keys still accounted to it, so it was destroyed, and
+/// its keys are still reachable from every view below it. A leaf is what
+/// @parent_id's pointer justifies; descendants, if any, come back through
+/// their own parent pointers on a later pass. A subvolume claiming @id comes
+/// back with it.
+fn resurrect_child(t: &TransAttempt<'_, '_>, parent_id: u32, id: u32) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    let Some(parent) = lookup_node(t, parent_id)? else {
+        return Err(fs.err(bch_errcode::BCH_ERR_EINVAL_snapshot_edge_to_missing_node));
+    };
+
+    let mut n = t.bkey_alloc_typed::<c::Snapshot>()?;
+    n.k_mut().p = pos(0, id as u64);
+
+    let v = n.v_mut();
+    v.parent    = parent_id.into();
+    v.tree      = parent.v.tree;
+    v.depth     = fs.snapshots.depth(parent_id).into();
+    v.btime.lo  = fs.current_time().into();
+    for skip in &mut v.skip {
+        *skip = fs.snapshots.skiplist_get(parent_id).into();
+    }
+    v.skip.sort_unstable_by_key(|s| (*s).get());
+    v.subvol    = subvol_claiming(t, id)?.unwrap_or(0).into();
+    v.set_state(c::bch_snapshot_state::SNAPSHOT_STATE_live);
+
+    fs.snapshots.table_make_room(id)?;
+    t.insert(c::btree_id::snapshots, n, UpdateTriggerFlags::empty())
+}
+
+/// The nodes an edge repair is between, keys and all: which pointer is wrong
+/// is only decidable across both, so the message shows both.
+struct EdgeNodes<'n, 'f> {
+    fs:       &'f Fs,
+    node:     BkeySC<'n>,
+    target:   Option<&'n BkeyI<c::Snapshot>>,
+    claimant: Option<&'n BkeyI<c::Snapshot>>,
+}
+
+impl<'n, 'f> EdgeNodes<'n, 'f> {
+    fn new(
+        fs:       &'f Fs,
+        node:     &'n CowKey<'_, '_, '_, '_, c::Snapshot>,
+        target:   Option<&'n BkeyI<c::Snapshot>>,
+        claimant: Option<&'n BkeyI<c::Snapshot>>,
+    ) -> Self {
+        EdgeNodes { fs, node: node.key(), target, claimant }
+    }
+}
+
+impl ToText for EdgeNodes<'_, '_> {
+    fn to_text(&self, out: &mut Printbuf) {
+        prt!(out, "\nnode:     {}", self.node.to_text(self.fs));
+        if let Some(t) = self.target {
+            prt!(out, "\ntarget:   {}", t.to_text(self.fs));
+        }
+        if let Some(c) = self.claimant {
+            prt!(out, "\nclaimant: {}", c.to_text(self.fs));
+        }
+    }
+}
+
+/// Walking from deleted node @s past the deleted nodes beyond it, in the
+/// direction @role's pointer goes: the nearest one that isn't deleted, 0 if
+/// they all are - None if the chain is too long to be anything but damage.
+fn past_deleted(t: &TransAttempt<'_, '_>, s: &c::Snapshot, role: Role)
+    -> Result<Option<u32>, BchError>
+{
+    let next = |s: &c::Snapshot| match role {
+        Role::Child  => s.parent(),
+        Role::Parent => s.children()[0],
+    };
+
+    let mut id = next(s);
+    for _ in 0..c::BTREE_MAX_DEPTH * 64 {
+        if id == 0 {
+            return Ok(Some(0));
+        }
+        match lookup_node(t, id)? {
+            None => return Ok(Some(0)),
+            Some(s) if s.v.state_decoded() != Some(c::bch_snapshot_state::SNAPSHOT_STATE_deleted) => return Ok(Some(id)),
+            Some(s) => id = next(&s.v),
+        }
+    }
+    Ok(None)   /* damaged chain, cycle? don't guess */
+}
+
+/// What to do about a broken edge, decided by edge_repair().
+enum EdgeRepair {
+    /// Undelete this node: it's deleted, but still owns data.
+    Undelete(u32),
+    /// Aim our pointer at this node instead - 0 to clear it.
+    Retarget(u32),
+    /// The target's pointer slot that should name us, empty or stale: aim it
+    /// at us.
+    Complete(u32),
+    /// Recreate the missing child as a leaf.
+    Resurrect,
+}
+
+/// Check the edge between node @n, as @role, and @other_id, which its
+/// pointer names: a repair, if it needs one and fsck says to make it.
+fn edge_repair(
+    t:        &TransAttempt<'_, '_>,
+    n:        &CowKey<'_, '_, '_, '_, c::Snapshot>,
+    role:     Role,
+    other_id: u32,
+) -> Result<Option<EdgeRepair>, BchError> {
+    let fs = t.fs();
+    let id = n.id();
+    let ptr = role.ptr_name();
+
+    let other = lookup_node(t, other_id)?;
+
+    // The live tree must be closed over nodes that aren't deleted: an edge into a
+    // tombstone is left by an interrupted deletion, so rewrite ours past it - up
+    // the tombstone's retained parents or down its retained children - to the
+    // nearest node that isn't deleted. The tombstone itself is untouched.
+    //
+    // Only a tombstone without data. check_deleted() can't have ruled on it yet:
+    // we walk down from POS_MAX and ids descend from the root, so a parent
+    // reaches a deleted child's edge before the child is visited.
+    if let Some(o) = other.as_ref().filter(|o| o.v.state_decoded() == Some(c::bch_snapshot_state::SNAPSHOT_STATE_deleted)) {
+        // A deleted node with data has a lying state, and routing around it would
+        // strand the keys: undelete it, and leave our edge to its own visit.
+        let acct = fs.snapshots.accounting(other_id);
+        if !acct.is_empty() {
+            let fix = fsck_err!(t, id::snapshot_deleted_but_has_data,
+                                "snapshot {id} {ptr} pointer {other_id} is deleted but has {} keys, \
+                                 {} sectors accounted - undeleting rather than splicing past it:{}",
+                                acct.keys(), acct.sectors(), EdgeNodes::new(fs, n, Some(o), None))?;
+            return Ok(fix.then_some(EdgeRepair::Undelete(other_id)));
+        }
+
+        let Some(repl) = past_deleted(t, &o.v, role)? else { return Ok(None) };
+        let fix = fsck_err!(t, id::snapshot_deleted_but_linked,
+                            "snapshot {id} {ptr} pointer {other_id} is a deleted node - {} {repl}{}",
+                            if repl != 0 { "re-linking past it to" } else { "clearing, dead in that direction:" },
+                            EdgeNodes::new(fs, n, Some(o), None))?;
+        return Ok(fix.then_some(EdgeRepair::Retarget(repl)));
+    }
+
+    if other.as_ref().is_some_and(|o| points_at(&o.v, role.other(), id)) {
+        return Ok(None);
+    }
+
+    // Our pointer completes the edge if the target's slot toward us is empty
+    // or holds a stale pointer - never a tombstone's, handled above.
+    if let Some(o) = &other {
+        if parent_child_consistent(n.v(), id, role, &o.v, other_id) {
+            if let Some(old) = ptr_available(t, &o.v, other_id, role.other())? {
+                if fsck_err!(t, id::snapshot_edge_bad,
+                             "snapshot {id} {ptr} pointer {other_id} is not reciprocated, but is corroborated by\n\
+                              tree and depth and the target's position ({old}) is unattested - completing the edge{}",
+                             EdgeNodes::new(fs, n, Some(o), None))? {
+                    return Ok(Some(EdgeRepair::Complete(old)));
+                }
+            }
+        }
+    }
+
+    // Or another node claims the edge and tree and depth agree - re-aim ours:
+    if let Some(repl) = fs.snapshots.table_find_edge(n.v(), id, role == Role::Child) {
+        if let Some(r) = lookup_node(t, repl)? {
+            if parent_child_consistent(n.v(), id, role, &r.v, repl) &&
+               fsck_err!(t, id::snapshot_edge_bad,
+                         "snapshot {id} {ptr} pointer {other_id} is broken (target {}), but node {repl} claims the\n\
+                          edge, corroborated by tree and depth - repairing{}",
+                         if other.is_some() { "does not reciprocate" } else { "does not exist" },
+                         EdgeNodes::new(fs, n, other.as_ref(), Some(&r)))? {
+                return Ok(Some(EdgeRepair::Retarget(repl)));
+            }
+        }
+    }
+
+    // A child pointer to a node that isn't there: keys accounted to it mean it
+    // was destroyed, and recreating it keeps them reachable. With none, clear the
+    // pointer - so a garbage id doesn't conjure a snapshot.
+    if role == Role::Parent && other.is_none() {
+        let [c0, c1] = n.v().children();
+        let sibling = if c0 == other_id { c1 } else { c0 };
+
+        if has_accounting(fs, other_id) {
+            let fix = fsck_err!(t, id::snapshot_child_missing_but_accounted,
+                                "snapshot {id} child pointer {other_id} does not exist, but keys are\n\
+                                 accounted to {other_id} - recreating it as a leaf so they stay reachable{}",
+                                EdgeNodes::new(fs, n, None, None))?;
+            return Ok(fix.then_some(EdgeRepair::Resurrect));
+        }
+
+        if sibling != 0 &&
+           fsck_err!(t, id::snapshot_edge_bad,
+                     "snapshot {id} child pointer {other_id} does not exist: nothing claims {id} as\n\
+                      parent and nothing is accounted to it - clearing{}",
+                     EdgeNodes::new(fs, n, None, None))? {
+            return Ok(Some(EdgeRepair::Retarget(0)));
+        }
+    }
+
+    // One stomped field leaves the other side's pointer for the repairs above, so
+    // this is multiple corruptions or a destroyed node: report and stop.
+    bch_err!(fs, "snapshot topology damage is beyond single-corruption repair:\n\
+                  node {id}'s {ptr} pointer names {other_id}, which {}\n\
+                  no other node passes the parent/child consistency checks for this edge{}\n\
+                  not repairing: run fsck; if damage is extensive, reconstruct_snapshots rebuilds topology from key evidence",
+             if other.is_some() {
+                 "exists but does not point back, and tree/depth do not identify them as parent and child"
+             } else {
+                 "does not exist"
+             },
+             EdgeNodes::new(fs, n, other.as_ref(), None));
+
+    Err(fs.err(match (&other, role) {
+        (None, _)          => bch_errcode::BCH_ERR_EINVAL_snapshot_edge_to_missing_node,
+        (_, Role::Child)   => bch_errcode::BCH_ERR_EINVAL_snapshot_parent_missing_child_ptr,
+        (_, Role::Parent)  => bch_errcode::BCH_ERR_EINVAL_snapshot_child_bad_parent,
+    }))
+}
+
+/// Check, and repair, the edge between node @n, as @role, and @other_id,
+/// which its pointer names.
+fn check_edge<'a, 't>(
+    t:        &TransAttempt<'a, 't>,
+    n:        &mut CowKey<'_, '_, 'a, 't, c::Snapshot>,
+    role:     Role,
+    other_id: u32,
+) -> Result<(), BchError> {
+    let Some(repair) = edge_repair(t, n, role, other_id)? else { return Ok(()) };
+
+    match repair {
+        EdgeRepair::Undelete(id) =>
+            undelete_owns_data(t, &mut get_mut_node(t, id)?)?,
+        EdgeRepair::Retarget(new) =>
+            set_ptr(n.v_mut(t)?, role, other_id, new),
+        EdgeRepair::Complete(old) =>
+            set_ptr(get_mut_node(t, other_id)?.v_mut(), role.other(), old, n.id()),
+        EdgeRepair::Resurrect =>
+            resurrect_child(t, n.id(), other_id)?,
+    }
+    edge_repair_commit(t)
+}
+
+/// Whether @id's tree pointer, @tree, names a tree that exists and whose
+/// root @id descends from.
+fn tree_ptr_good(t: &TransAttempt<'_, '_>, id: u32, tree: u32) -> Result<bool, BchError> {
+    let Some(st) = snapshot::tree_lookup(t, tree).found()? else { return Ok(false) };
+    Ok(t.fs().snapshots.is_ancestor_early(id, st.root_snapshot.get()))
+}
+
+/// Snapshot node @n's tree pointer was wrong: make sure its root's is right -
+/// creating a tree if there isn't one for it - and point @n at that.
+fn tree_ptr_repair<'a, 't>(
+    t: &TransAttempt<'a, 't>,
+    n: &mut CowKey<'_, '_, 'a, 't, c::Snapshot>,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+    let id = n.id();
+    let root_id = fs.snapshots.root(id);
+
+    let mut tree_id = if root_id == id {
+        n.v().tree()
+    } else {
+        snapshot::lookup_key(t, root_id)?.v.tree()
+    };
+
+    let tree = snapshot::tree_lookup(t, tree_id).found()?;
+    if tree.is_none_or(|st| st.root_snapshot.get() != root_id) {
+        let mut new = snapshot::tree_create(t)?;
+        let v = new.v_mut();
+        v.master_subvol = fs.snapshots.oldest_subvol(root_id).unwrap_or(0).into();
+        v.root_snapshot = root_id.into();
+        tree_id = new.k().p.offset as u32;
+
+        if root_id != id {
+            get_mut_node(t, root_id)?.v_mut().tree = tree_id.into();
+        }
+    }
+
+    if n.v().tree() != tree_id {
+        n.v_mut(t)?.tree = tree_id.into();
+    }
+    Ok(())
+}
+
+/// Depth is derived from the parent - and the parent was visited first.
+fn check_depth<'a, 't>(
+    t: &TransAttempt<'a, 't>,
+    n: &mut CowKey<'_, '_, 'a, 't, c::Snapshot>,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+    let parent_id = n.v().parent();
+
+    // No parent to derive depth from, and 0 would flatten an interior node to a
+    // root. check_edge() reported the pointer; leave depth until it's fixed.
+    // Likewise a parent at the maximum depth: that's damage, reported at the
+    // parent, and still there if it wasn't repaired (fsck -n).
+    let real_depth = if parent_id == 0 {
+        0
+    } else {
+        let Some(parent) = lookup_node(t, parent_id)? else { return Ok(()) };
+        let Some(depth) = parent.v.depth().get().checked_add(1) else { return Ok(()) };
+        depth
+    };
+
+    if fsck_err_on!(t, n.v().depth() != real_depth, id::snapshot_bad_depth,
+                    "snapshot with incorrect depth field, should be {real_depth}:\n{}",
+                    n.to_text(fs))? {
+        n.v_mut(t)?.depth = real_depth.into();
+    }
+    Ok(())
+}
+
+/// Every skiplist entry is an ancestor - none, for a root.
+fn check_skiplists<'a, 't>(
+    t: &TransAttempt<'a, 't>,
+    n: &mut CowKey<'_, '_, 'a, 't, c::Snapshot>,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+    let id = n.id();
+
+    for i in 0..n.v().skip.len() {
+        let parent_id = n.v().parent();
+        let skip = (n.v().skip[i]).get();
+
+        let bad = if parent_id == 0 { skip != 0 } else { !fs.snapshots.is_ancestor_early(id, skip) };
+        if !bad {
+            continue;
+        }
+
+        let mut msg = Printbuf::new();
+        prt!(&mut msg, "snapshot with bad skiplist pointer {skip}:\n{}\n", n.to_text(fs));
+        if skip != 0 {
+            let mut iter = BtreeIter::new(t, c::btree_id::snapshots, pos(0, skip as u64),
+                                          BtreeIterFlags::empty());
+            let skip_k = iter.peek_slot(t)?.expect("a slot always has a key");
+            prt!(&mut msg, "points to\n  {}\n", skip_k.to_text(fs));
+        }
+
+        if fsck_err!(t, id::snapshot_bad_skiplist, "{msg}")? {
+            n.v_mut(t)?.skip[i] = fs.snapshots.skiplist_get(parent_id).into();
+        }
+    }
+
+    // Kept sorted: is_ancestor() tries the highest first.
+    if n.has_update() {
+        n.v_mut(t)?.skip.sort_unstable_by_key(|s| (*s).get());
+    }
+    Ok(())
+}
+
+/// The subvolume backref, against the subvolume it names.
+fn check_to_subvol<'a, 't>(
+    t: &TransAttempt<'a, 't>,
+    n: &mut CowKey<'_, '_, 'a, 't, c::Snapshot>,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+    let id = n.id();
+
+    let state = n.v().state_field();
+    let snap_deleting = state == Some(c::bch_snapshot_state::SNAPSHOT_STATE_will_delete);
+    let should_have_subvol = n.v().children()[0] == 0 &&
+        (state == Some(c::bch_snapshot_state::SNAPSHOT_STATE_live) || snap_deleting);
+
+    if n.v().subvol() != 0 {
+        let subvol_id = n.v().subvol();
+
+        // A raw read: subvolume::get() reports deleted subvolumes as ENOENT,
+        // and the message should show what's actually there.
+        let mut iter = BtreeIter::new(t, c::btree_id::subvolumes, pos(0, subvol_id as u64),
+                                      BtreeIterFlags::empty());
+        let subvol_k = iter.peek_slot(t)?.expect("a slot always has a key");
+        let subvol = subvolume::val(subvol_k);
+
+        // Only here can a missing subvolume be rebuilt: a snapshot with a subvol
+        // backref is a leaf, which reconstruct_subvol() needs and an inode's or
+        // dirent's snapshot can't promise. Not while the snapshot is deleting: that's
+        // a tombstoned deletion in flight.
+        if subvol.is_none() && !snap_deleting {
+            match check::reconstruct_subvol_root(t, id, subvol_id, None) {
+                Ok(root) => return check::reconstruct_subvol(t, id, subvol_id, root),
+                // couldn't find a root inode for it - fall through and report
+                Err(e) if e.matches(bch_errcode::BCH_ERR_fsck_repair_unimplemented) => {}
+                Err(e) => return Err(e),
+            }
+        }
+
+        // Wrong backref, or not rebuildable: the repair belongs to the pass after
+        // check_subvols. Report only - an error would break mounts mid-deletion.
+        let subvol = match subvol {
+            Some(s) if s.snapshot() == id => s,
+            Some(_) => {
+                fsck_err_report!(fs, id::snapshot_subvol_backref_wrong,
+                                 "snapshot's subvolume doesn't point back at it:\n{}\n{}",
+                                 n.to_text(fs), subvol_k.to_text(fs));
+                return Ok(());
+            }
+            None => {
+                fsck_err_report!(fs, id::snapshot_subvol_backref_wrong,
+                                 "snapshot points to missing subvolume {subvol_id}:\n{}",
+                                 n.to_text(fs));
+                return Ok(());
+            }
+        };
+
+        // Deletion couples one bit on each side: will_delete iff the subvolume is
+        // tombstoned. The subvolume decides - the reverse would have to guess live or
+        // unlinked.
+        let subvol_deleted = subvol.state_decoded() == Some(c::bch_subvolume_state::SUBVOLUME_STATE_deleted);
+        if fsck_err_on!(t, snap_deleting != subvol_deleted, id::snapshot_subvol_state_mismatch,
+                        "snapshot {} but its subvolume is {}:\n{}\n{}",
+                        if snap_deleting { "will_delete" } else { "live" },
+                        if subvol_deleted { "deleted" } else { "not deleted" },
+                        n.to_text(fs), subvol_k.to_text(fs))? {
+            n.v_mut(t)?.set_state(if subvol_deleted {
+                c::bch_snapshot_state::SNAPSHOT_STATE_will_delete
+            } else {
+                c::bch_snapshot_state::SNAPSHOT_STATE_live
+            });
+        }
+    } else if should_have_subvol && state == Some(c::bch_snapshot_state::SNAPSHOT_STATE_live) {
+        // No backref: if a subvolume points here it was wiped - restore it (a second
+        // claimant still hits check_subvols' fail-stop). No claimant is an orphan
+        // leaf, unrepaired.
+        if let Some(subvol) = subvol_claiming(t, id)? {
+            if fsck_err!(t, id::snapshot_subvol_backref_wrong,
+                         "snapshot leaf missing subvol backref, subvolume {subvol} points at it - restoring:\n{}",
+                         n.to_text(fs))? {
+                let v = n.v_mut(t)?;
+                v.subvol = subvol.into();
+                v.set_subvol_obsolete(true);
+            }
+        }
+    }
+
+    if fsck_err_on!(t, n.v().subvol() != 0 && !should_have_subvol, id::snapshot_should_not_have_subvol,
+                    "snapshot should not point to subvol:\n{}", n.to_text(fs))? {
+        if n.v().children()[0] != 0 {
+            return Err(fs.err(bch_errcode::BCH_ERR_fsck_repair_unimplemented));
+        }
+
+        // XXX: DANGEROUS
+        n.v_mut(t)?.subvol = 0.into();
+    }
+
+    // Live nodes only: set_state() clears SUBVOL_OBSOLETE for every non-live
+    // state, backref or not, so old kernels don't read a dying snapshot as a live
+    // subvolume leaf.
+    let v = n.v();
+    if v.state().get() == c::bch_snapshot_state::SNAPSHOT_STATE_live.0 && v.subvol_obsolete() != (v.subvol() != 0) {
+        let mut msg = Printbuf::new();
+        prt!(&mut msg, "snapshot node {id} has wrong subvol flag:\n{}", n.to_text(fs));
+
+        if v.subvol() != 0 {
+            let mut iter = BtreeIter::new(t, c::btree_id::subvolumes, pos(0, v.subvol() as u64),
+                                          BtreeIterFlags::empty());
+            let subvol_k = iter.peek_slot(t)?.expect("a slot always has a key");
+            prt!(&mut msg, "\n{}", subvol_k.to_text(fs));
+        }
+
+        if fsck_err!(t, id::snapshot_subvol_flag_wrong, "{msg}")? {
+            let has_subvol = n.v().subvol() != 0;
+            n.v_mut(t)?.set_subvol_obsolete(has_subvol);
+        }
+    }
+
+    Ok(())
+}
+
+fn check_snapshot<'a, 't>(
+    t:    &TransAttempt<'a, 't>,
+    iter: &BtreeIter<'t>,
+    k:    BkeySC<'_>,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    let Some(mut n) = CowKey::<c::Snapshot>::new(iter, k) else { return Ok(()) };
+
+    check_state(t, &mut n)?;
+    check_has_data(t, &mut n)?;
+
+    if check_deleted(t, &mut n)? {
+        return Ok(());
+    }
+
+    let parent = n.v().parent();
+    if parent != 0 {
+        check_edge(t, &mut n, Role::Child, parent)?;
+    }
+    for child in n.v().children() {
+        if child != 0 {
+            check_edge(t, &mut n, Role::Parent, child)?;
+        }
+    }
+
+    if !tree_ptr_good(t, n.id(), n.v().tree())? &&
+       fsck_err!(t, id::snapshot_to_bad_snapshot_tree,
+                 "snapshot points to missing/incorrect tree:\n{}", n.to_text(fs))? {
+        tree_ptr_repair(t, &mut n)?;
+    }
+
+    check_depth(t, &mut n)?;
+    check_skiplists(t, &mut n)?;
+    check_to_subvol(t, &mut n)
+}
+
+/// check_snapshots, in @trans: also for snapshot deletion, which runs it
+/// before deleting interior nodes.
+pub(crate) fn check_snapshots_trans(trans: &BtreeTrans<'_>) -> Result<(), BchError> {
+    // Backwards: fixing a node's depth needs its parent's to be right already.
+    let mut iter = BtreeIter::new(trans, c::btree_id::snapshots, POS_MAX, BtreeIterFlags::PREFETCH);
+    iter.for_each_reverse_commit(trans, POS_MIN, None, CommitFlags::NO_ENOSPC,
+                                 |t, iter, k| check_snapshot(t, iter, k))?;
+
+    snapshot::table_rebuild_if_needed(trans)
+}
+
+fn check_snapshots(fs: &Fs) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+    check_snapshots_trans(&trans)?;
+
+    // A clean pass lets check_key_has_snapshot trust the in-memory table
+    if !fs.flag(c::bch_fs_flags::BCH_FS_error) {
+        passes::set_btree_clean(fs, c::btree_id::snapshots);
+    }
+    Ok(())
+}
+
+crate::recovery_pass!(bch2_check_snapshots => check_snapshots);
+
+/* reconstruct_snapshots: */
+
+/// Which snapshot ids belong to the same tree, from the keys: every version
+/// of one inode is in one tree.
+struct TreeReconstruct {
+    btree:   c::btree_id,
+    cur_pos: c::bpos,
+    /// The current inode's snapshot ids.
+    cur_ids: KVVec<u32>,
+    /// The trees so far; merged-away ones are left empty.
+    trees:   KVVec<KVVec<u32>>,
+}
+
+impl TreeReconstruct {
+    /// Whether @pos is the current inode.
+    fn same_inode(&self, pos: c::bpos) -> bool {
+        if self.btree == c::btree_id::inodes {
+            self.cur_pos.offset == pos.offset
+        } else {
+            self.cur_pos.inode == pos.inode
+        }
+    }
+
+    /// Done with the current inode: its ids and every tree they overlap
+    /// become one tree.
+    fn next(&mut self) -> Result<(), BchError> {
+        if self.cur_ids.is_empty() {
+            return Ok(());
+        }
+
+        let mut tree = core::mem::replace(&mut self.cur_ids, KVVec::new());
+        for t in self.trees.iter_mut() {
+            if t.iter().any(|id| tree.contains(id)) {
+                for &id in t.iter() {
+                    add_nodup(&mut tree, id)?;
+                }
+                t.clear();
+            }
+        }
+
+        self.trees.push(tree, GFP_KERNEL)?;
+        Ok(())
+    }
+
+    fn add(&mut self, pos: c::bpos) -> Result<(), BchError> {
+        if !self.same_inode(pos) {
+            self.next()?;
+        }
+        self.cur_pos = pos;
+        add_nodup(&mut self.cur_ids, pos.snapshot)
+    }
+}
+
+fn add_nodup(ids: &mut KVVec<u32>, id: u32) -> Result<(), BchError> {
+    if !ids.contains(&id) {
+        ids.push(id, GFP_KERNEL)?;
+    }
+    Ok(())
+}
+
+/// Recreate missing node @id, a tree to itself: with a tree key, if there
+/// isn't one with it as the root.
+fn recreate_node(t: &TransAttempt<'_, '_>, id: u32) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    let tree_id = find_key(t, c::btree_id::snapshot_trees, |k| {
+        k.arm::<c::SnapshotTree>().map(|k| k.v()).is_some_and(|st| st.root_snapshot.get() == id)
+    })?;
+
+    let tree_id = match tree_id {
+        Some(tree_id) => tree_id,
+        None => {
+            let mut tree = snapshot::tree_create(t)?;
+            tree.v_mut().root_snapshot = id.into();
+            tree.k().p.offset as u32
+        }
+    };
+
+    let mut n = t.bkey_alloc_typed::<c::Snapshot>()?;
+    n.k_mut().p = pos(0, id as u64);
+
+    let v = n.v_mut();
+    v.tree     = tree_id.into();
+    v.btime.lo = fs.current_time().into();
+    v.subvol   = subvol_claiming(t, id)?.unwrap_or(0).into();
+    v.set_state(c::bch_snapshot_state::SNAPSHOT_STATE_live);
+
+    fs.snapshots.table_make_room(id)?;
+    t.insert(c::btree_id::snapshots, n, UpdateTriggerFlags::empty())
+}
+
+/// Recreate node @id of @tree if it's missing - only if it's a tree to
+/// itself: one we can't place.
+fn reconstruct_node(t: &TransAttempt<'_, '_>, id: u32, tree: &[u32]) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    if fsck_err_on!(t, fs.snapshots.id_state(id) == IdState::SNAPSHOT_ID_empty,
+                    id::snapshot_node_missing,
+                    "snapshot node {id} from tree {} missing, recreate?", Join(" ", tree.iter()))? {
+        if tree.len() > 1 {
+            bch_err!(fs, "cannot reconstruct snapshot trees with multiple nodes");
+            return Err(fs.err(bch_errcode::BCH_ERR_fsck_repair_unimplemented));
+        }
+
+        return recreate_node(t, id);
+    }
+
+    Ok(())
+}
+
+fn reconstruct_snapshots(fs: &Fs) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+
+    let mut btrees: KVVec<c::btree_id> = KVVec::new();
+    for &btree in crate::BTREE_IDS_KNOWN {
+        if crate::BTREE_HAS_SNAPSHOTS_MASK & (1 << btree.0) != 0 {
+            btrees.push(btree, GFP_KERNEL)?;
+        }
+    }
+    let progress = Progress::recovery(fs, c"bch2_reconstruct_snapshots", &btrees, &[]);
+
+    let mut r = TreeReconstruct {
+        btree:   c::btree_id::extents,
+        cur_pos: POS_MIN,
+        cur_ids: KVVec::new(),
+        trees:   KVVec::new(),
+    };
+
+    for &btree in btrees.iter() {
+        r.btree = btree;
+
+        let mut iter = BtreeIter::new(&trans, btree, POS_MIN,
+                                      BtreeIterFlags::ALL_SNAPSHOTS | BtreeIterFlags::PREFETCH);
+        iter.for_each_attempt(&trans, |t, iter, k| {
+            progress.update(t, iter)?;
+            r.add(k.k.p)
+        })?;
+
+        r.next()?;
+    }
+
+    for tree in r.trees.iter() {
+        for &id in tree.iter() {
+            commit_do(&trans, None, CommitFlags::NO_ENOSPC, |t| reconstruct_node(t, id, tree))?;
+        }
+    }
+
+    Ok(())
+}
+
+crate::recovery_pass!(bch2_reconstruct_snapshots => reconstruct_snapshots);
+
+/* check_key_has_snapshot - per-key repair, also called at runtime: */
+
+/// A key moved from a deleted snapshot to its live descendant @snapshot needs
+/// an inode there, or the next deletion strands it again: copy one down if
+/// it's only inherited. A missing inode is left for full fsck.
+fn key_has_inode_in_snapshot(
+    t:        &TransAttempt<'_, '_>,
+    btree:    c::btree_id,
+    inum:     u64,
+    snapshot: u32,
+) -> Result<(), BchError> {
+    match btree {
+        c::btree_id::extents | c::btree_id::dirents | c::btree_id::xattrs => {}
+        _ => return Ok(()),
+    }
+
+    let Some(mut inode) = inode::find_by_inum_snapshot(t, inum, snapshot,
+                                                       BtreeIterFlags::empty()).found()? else {
+        return Ok(());
+    };
+    if inode.bi_snapshot == snapshot {
+        return Ok(());
+    }
+
+    inode.bi_snapshot = snapshot;
+    inode::fsck_write(t, &mut inode)
+}
+
+/// Key @k is in a snapshot that's missing or dead: repair it - deleted, or
+/// moved to a live descendant - true if so, for the caller to skip it. With
+/// no @iter - the promote path - it can't be repaired, and is just skipped.
+pub(crate) fn check_key_has_snapshot<'a>(
+    t:    &TransAttempt<'a, '_>,
+    iter: Option<&BtreeIter<'a>>,
+    k:    BkeySC<'_>,
+) -> Result<bool, BchError> {
+    let fs = t.fs();
+    let state = fs.snapshots.id_state(k.k.p.snapshot);
+
+    let Some(iter) = iter else { return Ok(true) };
+
+    if state == IdState::SNAPSHOT_ID_live {
+        return Ok(false);
+    }
+
+    let mut buf = Printbuf::new();
+    let mut ret = Ok(());
+    let mut keep = |r: Result<(), BchError>| if r.is_err() { ret = r };
+
+    // The deletion that stranded this key almost certainly stranded others across
+    // the content btrees: schedule their passes now, before copygc or reconcile
+    // trips over them. Only a rewind returns an error, deferring this key.
+    // skip_if_complete: if they ran and the key's still here they can't fix it,
+    // and rescheduling would force fsck on every mount.
+    for pass in [BCH_RECOVERY_PASS_check_inodes, BCH_RECOVERY_PASS_check_extents,
+                 BCH_RECOVERY_PASS_check_dirents, BCH_RECOVERY_PASS_check_xattrs] {
+        keep(passes::run_explicit(fs, &mut buf, pass,
+                                  c::bch_run_recovery_pass_flags::RUN_RECOVERY_PASS_skip_if_complete));
+    }
+
+    // A key in a deleted snapshot means it has data, and check_snapshot()
+    // undeletes a node with data: the state is the lie. We're seeing the key, so
+    // that hasn't happened yet - require check_snapshots before deleting or
+    // migrating it, both irreversible. require() rewinds if we're past it; if it
+    // ran and left the node deleted, it returns Ok and the repair proceeds.
+    if state == IdState::SNAPSHOT_ID_deleted {
+        keep(passes::require(fs, &mut buf, BCH_RECOVERY_PASS_check_snapshots));
+    }
+
+    // Both repairs act on the in-memory table: trust it only if the snapshots and
+    // subvolumes btrees were checked clean and not changed since - not just
+    // checked this mount. Otherwise schedule the passes and defer.
+    if !passes::btree_is_clean(fs, c::btree_id::snapshots) ||
+       !passes::btree_is_clean(fs, c::btree_id::subvolumes) {
+        keep(passes::require(fs, &mut buf, BCH_RECOVERY_PASS_check_snapshots));
+        keep(passes::require(fs, &mut buf, BCH_RECOVERY_PASS_check_subvols));
+    }
+
+    ret?;
+
+    prt!(&mut buf, "{} {}", iter.btree(), k.to_text(fs));
+
+    if state == IdState::SNAPSHOT_ID_deleted {
+        // At runtime - data moves, bch2_data_update_init() - not in fsck, where
+        // check_allocations rebuilds the accounting first and check_snapshots
+        // undeletes a node with keys (fsck-inject test_deleted_interior_has_data).
+        //
+        // No live descendant: nothing can see the key, so delete it. A live
+        // descendant still sees it by inheritance: migrate it there - deletion keeps a
+        // child pointer for live_descendent() to find. An error finding it, on a
+        // table just checked clean, is real damage: report it, keep the key.
+        match fs.snapshots.live_descendent(k.k.p.snapshot)? {
+            None => if inode_fsck_err!(t, k.k.p, id::bkey_in_deleted_snapshot,
+                                       "key in deleted snapshot {buf}, delete?")? {
+                t.delete_at(iter, UpdateTriggerFlags::INTERNAL_SNAPSHOT_NODE)?;
+                return Ok(true);
+            },
+            Some(live_child) => if fsck_err!(t, id::bkey_in_deleted_interior_snapshot,
+                                             "key in deleted interior snapshot {buf}, migrating to live descendant {live_child}")? {
+                let (btree, inum) = (iter.btree(), k.k.p.inode);
+                delete::delete_dead_key(t, iter, k, live_child)?;
+                key_has_inode_in_snapshot(t, btree, inum, live_child)?;
+                return Ok(true);
+            },
+        }
+    } else if inode_fsck_err!(t, k.k.p, id::bkey_in_missing_snapshot,
+                              "key in missing snapshot {buf}, delete?")? {
+        t.delete_at(iter, UpdateTriggerFlags::INTERNAL_SNAPSHOT_NODE)?;
+        return Ok(true);
+    }
+
+    Ok(false)
+}
+
+/// check_key_has_snapshot(), for C's bch2_check_key_has_snapshot(): 1 if @k
+/// was repaired or can't be, for the caller to skip it.
+///
+/// # Safety
+/// @iter NULL - the promote path - or the iterator @k was read from.
+#[c_export]
+pub unsafe extern "C" fn __bch2_check_key_has_snapshot<'t>(
+    trans: &'t BtreeTrans<'t>,
+    iter:  Option<&BtreeIter<'t>>,
+    k:     BkeySC<'_>,
+) -> core::ffi::c_int {
+    match check_key_has_snapshot(&unsafe { trans.attempt_in_progress() }, iter, k) {
+        Ok(handled) => handled as core::ffi::c_int,
+        Err(e)      => -e.raw(),
+    }
+}
diff --git a/fs/bcachefs/snapshots/delete.rs b/fs/bcachefs/snapshots/delete.rs
new file mode 100644
index 0000000..8dc9ccb
--- /dev/null
+++ b/fs/bcachefs/snapshots/delete.rs
@@ -0,0 +1,1523 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Snapshot deletion.
+//!
+//! Snapshot trees:
+//!
+//! A node in a snapshot tree references keys with that snapshot ID, and all
+//! keys with ancestor snapshot IDs not overwritten by a descendent snapshot.
+//!
+//! When a subvolume is deleted, we now have dead and redundant snapshot nodes
+//! that must be cleaned up.
+//!
+//! - Dead:
+//!
+//!   A snapshot node with no children, and without a subvolume pointing to it,
+//!   is unreferenced and can be deleted
+//!
+//! - Redundant:
+//!
+//!   Interior snapshot nodes (nodes with children) are only referenced by their
+//!   child snapshot nodes. An interior node with only one child is redundant;
+//!   we can clean it up by moving all non-overwritten keys to the child
+//!   snapshot and removing it from the snapshot tree.
+//!
+//! Snapshot node states:
+//!
+//! - WILL_DELETE: this doesn't need to be a separate state bit. Indicates a
+//!   leaf node that's no longer referenced by a subvolume
+//!   (bch_snapshot.subvol == 0), so it's pending deletion
+//!
+//! - NO_KEYS: We can't remove interior nodes from the snapshot tree at
+//!   runtime, because that can require changing bch_snapshot.depth on
+//!   arbitrarily many children, and we can't do that atomically.
+//!
+//!   So instead, at runtime we'll do the heavy lifting of removing all keys
+//!   that reference that snapshot ID, leave it in a half dead state, and the
+//!   next time we start up we'll remove it from the snapshot tree.
+//!
+//!   Technically, we could, because the codepaths where this matters use the
+//!   RCU-protected snapshot table - but there's a lot of work that has to be
+//!   done for deleting interior snapshot nodes; parent/child pointers need to
+//!   be updated, skiplists need to be adjusted, and if we get any of this
+//!   wrong things can and will go horrifically wrong.
+//!
+//!   But if we defer it until recovery, when we're not yet running
+//!   multithreaded, we can also run the check_snapshots recovery pass
+//!   afterwards, for extra safety.
+//!
+//! Locking: runs are serialized by recovery.run_lock. A run collects its
+//! lists privately, then publishes the ones sysfs shows (DeleteNodes) under
+//! an RwSem and holds it for read until it's done; the progress indicator is
+//! outside it, with its own lock.
+
+use crate::alloc::capacity::DiskReservation;
+use crate::btree::bkey::{pos, spos, BkeyI, BkeySC, Typed, POS_MIN};
+use crate::btree::bkey::prelude::*;
+use crate::btree::iter::{
+    commit_do, lockrestart_do, BtreeIter, BtreeIterFlags, BtreeTrans, CommitFlags, TransAttempt,
+    TransBkey, UpdateTriggerFlags,
+};
+use crate::c;
+use crate::c::bch_recovery_pass::*;
+use crate::errcode::{bch_errcode, BchError};
+use crate::fs::Fs;
+use crate::init::damage;
+use crate::init::error::id;
+use crate::init::passes;
+use crate::locking::Lock;
+use crate::new_lock;
+use crate::snapshots::check_snapshots;
+use crate::snapshots::snapshot;
+use crate::util::alloc::{flags::GFP_KERNEL, KVVec};
+use crate::util::eytzinger::Eytzinger1;
+use crate::util::log::{self, LogLevel, LogMsg};
+use crate::util::Printbuf;
+use crate::{bch_err, bch_err_msg, bch_info, bch_notice, fs_inconsistent, fsck_err, prt,
+            trans_inconsistent};
+use core::fmt;
+use core::sync::atomic::{AtomicU32, Ordering};
+use pin_init::{pin_data, pin_init, PinInit};
+
+crate::module_param! {
+    /// Stop the key sweep after the extents/dirents/xattrs/damage pass and
+    /// before the inodes are deleted, so a test can construct the state an
+    /// interrupted deletion actually leaves: content gone for the dying
+    /// snapshots, the inodes that indexed it still there, nodes still live.
+    ///
+    /// That boundary and not another one: the inodes btree is the index the
+    /// sweep scans through, so it is the last point at which anything the
+    /// sweep missed is still findable.
+    pub(crate) static snapshot_delete_bail_before_inodes: bool = false;
+    #[cfg(CONFIG_BCACHEFS_DEBUG)]
+    perm = 0o644, desc = "Cancel snapshot deletion before the inode keys are deleted";
+}
+
+// ── State ────────────────────────────────────────────────────────────────
+
+/// An interior node being deleted, and the live child its keys migrate to -
+/// or, in Run::dying, a leaf, with live_child 0.
+#[derive(Clone, Copy, Default)]
+struct InteriorDelete {
+    id:         u32,
+    live_child: u32,
+}
+
+impl fmt::Display for InteriorDelete {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}->{}", self.id, self.live_child)
+    }
+}
+
+fn live_child_of(l: &[InteriorDelete], id: u32) -> Option<u32> {
+    l.iter().find(|i| i.id == id).map(|i| i.live_child)
+}
+
+#[derive(Default)]
+struct DeleteNodes {
+    deleting_from_trees: KVVec<u32>,
+    delete_leaves:       KVVec<u32>,
+    delete_interior:     KVVec<InteriorDelete>,
+}
+
+#[pin_data]
+pub(crate) struct SnapshotDelete {
+    /// None when no deletion is running. The deletion holds it for read
+    /// across its btree work, so it's never taken for write with btree
+    /// locks held: lockdep sees the cycle.
+    #[pin]
+    nodes:    Lock<c::rw_semaphore, Option<DeleteNodes>>,
+    /// Which sweep the progress describes: 1 or 2.
+    version:  AtomicU32,
+    progress: c::progress_indicator,
+}
+
+impl SnapshotDelete {
+    pub(crate) fn init() -> impl PinInit<Self> {
+        pin_init!(Self {
+            nodes    <- new_lock!(None),
+            version:  AtomicU32::new(0),
+            progress: ::pin_init::Zeroable::zeroed(),
+        })
+    }
+
+    fn start_sweep(&self, fs: &Fs, msg: &'static core::ffi::CStr, mask: u64, version: u32) {
+        self.progress.init_mask(fs, msg, mask, 0);
+        self.progress.set_silent();
+        self.version.store(version, Ordering::Relaxed);
+    }
+}
+
+struct Run<'r> {
+    nodes:   &'r DeleteNodes,
+    no_keys: &'r [InteriorDelete],
+    /// Every node being emptied, interior and leaf, in Eytzinger1 order
+    /// (slot 0 unused): what the sweep looks each key's snapshot up in.
+    dying:   &'r [InteriorDelete],
+}
+
+// ── Status ───────────────────────────────────────────────────────────────
+
+fn list_to_text<T: fmt::Display>(out: &mut Printbuf, name: &str, l: &[T], limit: usize) {
+    let _ = write!(out, "{name}");
+    for i in l.iter().take(limit) {
+        let _ = write!(out, " {i}");
+    }
+    if l.len() > limit {
+        let _ = write!(out, " (many)");
+    }
+    let _ = writeln!(out);
+}
+
+#[cold]
+fn nodes_to_text(out: &mut Printbuf, nodes: Option<&DeleteNodes>, full: bool) {
+    let limit = if full { usize::MAX } else { 10 };
+    let empty = DeleteNodes::default();
+    let d = nodes.unwrap_or(&empty);
+
+    list_to_text(out, "deleting from trees", &d.deleting_from_trees, limit);
+    list_to_text(out, "deleting leaves",     &d.delete_leaves,       limit);
+    list_to_text(out, "interior",            &d.delete_interior,     limit);
+}
+
+impl Fs {
+    #[cold]
+    pub fn snapshot_delete_status_to_text(&self, out: &mut Printbuf) {
+        let d = &self.snapshots.delete;
+
+        let nodes = d.nodes.read();
+        let Some(nodes) = nodes.as_ref() else {
+            let _ = write!(out, "(not running)");
+            return;
+        };
+
+        let _ = writeln!(out, "Snapshot deletion v{}", d.version.load(Ordering::Relaxed));
+        prt!(out, "Progress: {}\n", d.progress);
+        nodes_to_text(out, Some(nodes), false);
+    }
+}
+
+// ── Node state ───────────────────────────────────────────────────────────
+
+/// Node @id's key, queued for update; missing is an inconsistency.
+fn get_mut_node<'a, 't>(t: &TransAttempt<'a, 't>, id: u32)
+    -> Result<TransBkey<'a, 't, c::Snapshot>, BchError>
+{
+    t.bkey_get_mut(c::btree_id::snapshots, pos(0, id as u64), BtreeIterFlags::empty(),
+                   UpdateTriggerFlags::empty())
+        .inspect_err(|e| if e.matches(c::ENOENT) {
+            fs_inconsistent!(t.fs(), "missing snapshot {id}");
+        })
+}
+
+/// Missing is an inconsistency.
+fn lookup_node(t: &TransAttempt<'_, '_>, id: u32) -> Result<BkeyI<c::Snapshot>, BchError> {
+    snapshot::lookup_key(t, id)
+        .inspect_err(|e| if e.matches(c::ENOENT) {
+            fs_inconsistent!(t.fs(), "missing snapshot {id}");
+        })
+}
+
+/// The raw field: 0 on keys that predate it, which matches no state - so a
+/// legacy node is never == deleted, and always != live. What the node
+/// actually is: state_compat().
+fn state(v: &c::Snapshot) -> c::bch_snapshot_state {
+    c::bch_snapshot_state(v.state().get())
+}
+
+/// The node's child, if it has exactly one: then it's redundant, and its keys
+/// move to the child.
+fn only_child(v: &c::Snapshot) -> Option<u32> {
+    match v.children() {
+        [c, 0] | [0, c] if c != 0 => Some(c),
+        _                         => None,
+    }
+}
+
+/// Node @id's subvolume is being deleted: mark it will_delete, if it's live.
+pub fn node_set_deleted(t: &TransAttempt<'_, '_>, id: u32) -> Result<(), BchError> {
+    let mut s = get_mut_node(t, id)?;
+
+    if state(s.v()) != c::bch_snapshot_state::SNAPSHOT_STATE_live {
+        return Ok(());
+    }
+
+    // The backref is retained: it now points at the subvolume's tombstone,
+    // and deletion checks it - a will_delete leaf without a subvolume
+    // pointing back is an invalid state (check_should_delete_leaf):
+    s.v_mut().set_state(c::bch_snapshot_state::SNAPSHOT_STATE_will_delete);
+    Ok(())
+}
+
+/// Keys stranded in @btrees: schedule the content pass for each, which is what
+/// repairs the cause (a key with no inode at its own snapshot) and so lets
+/// the next deletion find them.
+fn schedule_content_passes(fs: &Fs, msg: &mut Printbuf, btrees: u64) -> Result<(), BchError> {
+    let mut ret = Ok(());
+
+    for (btree, pass) in [(c::btree_id::extents, BCH_RECOVERY_PASS_check_extents),
+                          (c::btree_id::inodes,  BCH_RECOVERY_PASS_check_inodes),
+                          (c::btree_id::dirents, BCH_RECOVERY_PASS_check_dirents),
+                          (c::btree_id::xattrs,  BCH_RECOVERY_PASS_check_xattrs)] {
+        if btrees & (1u64 << btree.0) != 0 {
+            let r = passes::run_explicit(fs, msg, pass, c::bch_run_recovery_pass_flags::empty());
+            if r.is_err() {
+                ret = r;
+            }
+        }
+    }
+    ret
+}
+
+/// After a pass's error that doesn't stop the refusal: at runtime the passes
+/// can't rewind - but the requirement was persisted to the superblock before
+/// cannot_rewind_recovery was returned, so they run at next mount and the
+/// refusal is the complete runtime response.
+fn rewind_is_fine(ret: Result<(), BchError>) -> Result<(), BchError> {
+    match ret {
+        Err(e) if e.matches(bch_errcode::BCH_ERR_cannot_rewind_recovery) => Ok(()),
+        r => r,
+    }
+}
+
+/// Refuse - with a repair scheduled - to empty or delete node @id while it
+/// still has data accounted to it.
+///
+/// The deletion scan should already have migrated or removed every key in
+/// this snapshot; this verifies it did. If not, either the accounting is
+/// wrong, or the inodes btree is missing an entry: the scan finds keys
+/// through "an extent/dirent/xattr in snapshot X implies an inode in snapshot
+/// X", so a missing inode strands that snapshot's keys.
+///
+/// @op is the operation we were performing - set_no_keys, leaf delete, or
+/// interior delete - which the node key does not tell you, and which is the
+/// first thing you need: whether we were emptying a node whose keys should
+/// already have migrated down, or splicing out an interior.
+///
+/// The node is printed too, because operation and shape are independent and
+/// their disagreement is the signal: an interior delete refused on a node
+/// that still reads as a leaf means something quite different from a leaf
+/// delete refused on a redundant interior whose migration was interrupted
+/// partway.
+fn check_no_data(t: &TransAttempt<'_, '_>, id: u32, op: &str, run: Option<&Run<'_>>)
+    -> Result<(), BchError>
+{
+    let fs = t.fs();
+
+    let acct = fs.snapshots.accounting(id);
+    if acct.is_empty() {
+        return Ok(());
+    }
+
+    let s = lookup_node(t, id)?;
+
+    // Whether an interior has a single live child is what the deletion
+    // recorded when it built its lists, not something to re-derive from the
+    // snapshot table: live_child is the migration target the deletion
+    // actually used, so if the two ever disagreed the list is the one that
+    // describes what happened.
+    let live_child = run.and_then(|r| live_child_of(&r.nodes.delete_interior, id)
+                                      .or_else(|| live_child_of(r.no_keys, id)));
+
+    let shape = if s.v().children()[0] == 0 {
+        "leaf"
+    } else if live_child.is_some() {
+        "redundant interior"
+    } else {
+        "interior"
+    };
+
+    let mut msg = Printbuf::new();
+    let _ = writeln!(msg, "{op} snapshot node {id} ({shape}) still has {} keys / {} sectors accounted to it - refusing, to prevent data loss; scheduling repair:{acct}",
+                     acct.keys(), acct.sectors());
+    prt!(&mut msg, "  {}\n", (&s).to_text(fs));
+
+    // The content passes, per btree, because their key_has_snapshot repairs
+    // are what can remove stranded keys - check_inodes alone can't repair a
+    // stranded dirent. And check_allocations, since the count itself may be
+    // what's wrong:
+    let mut ret = passes::run_explicit(fs, &mut msg, BCH_RECOVERY_PASS_check_allocations,
+                                       c::bch_run_recovery_pass_flags::empty());
+
+    let r = schedule_content_passes(fs, &mut msg, acct.btrees());
+    if r.is_err() {
+        ret = r;
+    }
+
+    bch_err!(fs, "{}", msg.as_str());
+
+    rewind_is_fine(ret)?;
+    fs.throw(bch_errcode::BCH_ERR_EINVAL_snapshot_delete_with_data)
+}
+
+/// Every node we're about to delete, and what it holds going in - the same
+/// counters check_no_data reads on the way out, so whatever is still there at
+/// the end is what the migration didn't move.
+struct NodesData<'a> {
+    fs:    &'a Fs,
+    nodes: &'a DeleteNodes,
+}
+
+impl fmt::Display for NodesData<'_> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "snapshot deletion, data accounted per node:")?;
+
+        let leaves = self.nodes.delete_leaves.iter().map(|&id| InteriorDelete { id, live_child: 0 });
+        for i in leaves.chain(self.nodes.delete_interior.iter().copied()) {
+            let acct = self.fs.snapshots.accounting(i.id);
+
+            match i.live_child {
+                0  => write!(f, "\n  leaf {}", i.id)?,
+                lc => write!(f, "\n  interior {} -> {lc}", i.id)?,
+            }
+            write!(f, ": {} keys, {} sectors{acct}", acct.keys(), acct.sectors())?;
+        }
+        Ok(())
+    }
+}
+
+/// Inodes excluded: those are what we're about to delete, accounted until we
+/// do.
+///
+/// Pre-per_dev_fragmentation_lru the key counters aren't populated yet, so
+/// this sees sectors only - a dirents- or xattrs-only stranding is invisible
+/// there.
+fn snapshot_content_empty(fs: &Fs, id: u32, msg: &mut Printbuf, bad_btrees: &mut u64) {
+    let acct = fs.snapshots.accounting(id);
+
+    let btrees = acct.btrees() & !(1u64 << c::btree_id::inodes.0);
+    if btrees == 0 {
+        return;
+    }
+
+    if *bad_btrees == 0 {
+        let _ = write!(msg, "content still accounted to dying snapshots - refusing to \
+                             delete their inode keys, which is how the deletion scan finds \
+                             these keys at all:");
+    }
+
+    *bad_btrees |= btrees;
+    let _ = write!(msg, "\n  snapshot {id}:{acct}");
+}
+
+/// Which content btrees still have keys accounted to a dying snapshot, as a
+/// mask. Nothing may remain in them by the time we delete the inode keys -
+/// see the caller.
+fn dying_snapshots_content_btrees(fs: &Fs, nodes: &DeleteNodes, msg: &mut Printbuf) -> u64 {
+    let mut bad_btrees = 0;
+
+    for &i in nodes.delete_leaves.iter() {
+        snapshot_content_empty(fs, i, msg, &mut bad_btrees);
+    }
+    for i in nodes.delete_interior.iter() {
+        snapshot_content_empty(fs, i.id, msg, &mut bad_btrees);
+    }
+    bad_btrees
+}
+
+fn node_set_no_keys(t: &TransAttempt<'_, '_>, id: u32, run: &Run<'_>) -> Result<(), BchError> {
+    /* Before the get_mut below queues anything - see check_deletable() */
+    check_no_data(t, id, "set_no_keys", Some(run))?;
+
+    let mut s = get_mut_node(t, id)?;
+    s.v_mut().set_state(c::bch_snapshot_state::SNAPSHOT_STATE_no_keys);
+    Ok(())
+}
+
+fn normalize_child_pointers(s: &mut c::Snapshot) {
+    let [a, b] = s.children();
+    if a < b {
+        s.children.swap(0, 1);
+    }
+}
+
+/// Every reason we decline to delete a snapshot node, decided without
+/// touching anything.
+///
+/// These have to be answered before the deletion starts, never partway
+/// through it. bkey_get_mut() queues its update the moment it's called, so a
+/// refusal after the first one leaves the transaction holding a fragment of a
+/// deletion, which the caller then drops on the floor.
+///
+/// And callers commit work ahead of the deletion that assumes it will happen:
+/// delete_dead_interior_snapshots() rewrites every child's depth and skip[]
+/// for the tree shape the deletion is going to produce, and commits that,
+/// before it deletes a single node. A node refused after that leaves the tree
+/// describing a deletion that never happened: depths one too small,
+/// skiplists stepping over a node that's still there. Ancestry queries are
+/// still correct (a skip still lands on a real ancestor), and
+/// check_snapshots() recomputes depth; until it does,
+/// snapshot_parent_child_consistent() can't corroborate those edges, and
+/// won't repair real damage on them.
+///
+/// So this is separable from the deletion on purpose: a caller that is about
+/// to commit to a set of nodes asks first, and drops the refused ones.
+///
+/// The refusals that want the tree shown say so to the caller, which prints
+/// them after the attempt: see refusal_to_text().
+fn check_deletable(t: &TransAttempt<'_, '_>, id: u32, delete_interior: bool, run: Option<&Run<'_>>)
+    -> Result<(), BchError>
+{
+    let fs = t.fs();
+
+    check_no_data(t, id, if delete_interior { "interior delete" } else { "leaf delete" }, run)?;
+
+    let s = lookup_node(t, id)?;
+    let v = s.v();
+
+    if state(v) == c::bch_snapshot_state::SNAPSHOT_STATE_deleted {
+        trans_inconsistent!(t, "deleting snapshot node {id}: already in state deleted");
+        return fs.throw(bch_errcode::BCH_ERR_EINVAL_snapshot_delete_already_deleted);
+    }
+
+    if v.children()[1] != 0 {
+        return fs.throw(bch_errcode::BCH_ERR_EINVAL_snapshot_delete_has_two_children);
+    }
+
+    if v.subvol() != 0 {
+        // Raw lookup, as in check_should_delete_leaf()
+        let subvol: c::Subvolume = t.bkey_get_val(c::btree_id::subvolumes, pos(0, v.subvol() as u64),
+                                                  BtreeIterFlags::CACHED)?;
+
+        if v.children()[0] != 0 ||
+           (subvol.state().get() != c::bch_subvolume_state::SUBVOLUME_STATE_deleted.0 &&
+            fs.version_upgrade_complete().0 >=
+            c::bcachefs_metadata_version::bcachefs_metadata_version_per_dev_fragmentation_lru.0) {
+            let mut msg = LogMsg::new(fs);
+            let _ = writeln!(msg, "deleting node with bad subvolume pointer:");
+            prt!(&mut msg, "{}", (&s).to_text(fs));
+            return fs.throw(bch_errcode::BCH_ERR_EINVAL_snapshot_delete_bad_subvol);
+        }
+    }
+
+    if v.children()[0] != 0 && !delete_interior {
+        return fs.throw(bch_errcode::BCH_ERR_EINVAL_snapshot_delete_interior_at_runtime);
+    }
+
+    Ok(())
+}
+
+/// check_deletable()'s refusals of node @id that show the tree, printed
+/// after its attempt: the tree dump is attempts of its own.
+#[cold]
+fn refusal_to_text(trans: &BtreeTrans<'_>, ret: &Result<(), BchError>, id: u32, run: Option<&Run<'_>>) {
+    let fs = trans.fs();
+    let Err(e) = ret else { return };
+
+    let mut msg = if *e == bch_errcode::BCH_ERR_EINVAL_snapshot_delete_has_two_children.into() {
+        let mut msg = LogMsg::new(fs);
+        let _ = writeln!(msg, "deleting node with two children:");
+        msg
+    } else if *e == bch_errcode::BCH_ERR_EINVAL_snapshot_delete_interior_at_runtime.into() {
+        let mut msg = LogMsg::new(fs);
+        let _ = writeln!(msg, "deleting interior node {id} with child {} at runtime:",
+                         fs.snapshots.first_child(id));
+        msg
+    } else {
+        return;
+    };
+
+    let _ = snapshot::tree_keys_to_text(&mut msg, trans, id);
+    nodes_to_text(&mut msg, run.map(|r| r.nodes), true);
+}
+
+/// Splice node @id out of its tree, and tombstone it. Callers are
+/// responsible for check_deletable() first: from here on we only fail on
+/// errors that take the whole thing down, never on a refusal.
+fn node_delete(t: &TransAttempt<'_, '_>, id: u32) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    let mut s = get_mut_node(t, id)?;
+
+    if s.v().subvol() != 0 {
+        t.delete(c::btree_id::subvolumes, pos(0, s.v().subvol() as u64),
+                 UpdateTriggerFlags::empty())?;
+    }
+
+    let parent_id = s.v().parent();
+    let child_id  = s.v().children()[0];
+
+    if parent_id != 0 {
+        let mut parent = get_mut_node(t, parent_id)?;
+
+        let Some(i) = parent.v().children().iter().position(|&c| c == id) else {
+            fs_inconsistent!(fs, "snapshot {parent_id} missing child pointer to {id}");
+            return fs.throw(bch_errcode::BCH_ERR_ENOENT_snapshot);
+        };
+
+        parent.v_mut().children[i] = child_id.into();
+        normalize_child_pointers(parent.v_mut());
+    }
+
+    if child_id != 0 {
+        let mut child = get_mut_node(t, child_id)?;
+        child.v_mut().parent = parent_id.into();
+    }
+
+    if parent_id == 0 {
+        // We're deleting the root of a snapshot tree: update the
+        // snapshot_tree entry to point to the new root, or delete it if this
+        // is the last snapshot ID in this tree:
+        let mut s_t: TransBkey<'_, '_, c::SnapshotTree> =
+            t.bkey_get_mut(c::btree_id::snapshot_trees, pos(0, s.v().tree() as u64),
+                           BtreeIterFlags::empty(), UpdateTriggerFlags::empty())?;
+
+        if child_id != 0 {
+            s_t.v_mut().root_snapshot = child_id.into();
+        } else {
+            s_t.set_deleted();
+        }
+    }
+
+    if fs.request_incompat_feature(
+            c::bcachefs_metadata_version::bcachefs_metadata_version_snapshot_deletion_v2).is_ok() {
+        // Retain parent/child pointers; don't destroy information if we have
+        // to repair:
+        let v = s.v_mut();
+        v.subvol = 0u32.into();
+        v.depth  = 0u32.into();
+        v.skip   = [0u32.into(); 3];
+        v.set_state(c::bch_snapshot_state::SNAPSHOT_STATE_deleted);
+    } else {
+        s.set_deleted();
+    }
+
+    // Nothing here touches this snapshot's accounting. Accounting is
+    // derived: the triggers on the keys we just deleted are what took the
+    // counters to zero. A counter still nonzero here is a bug to find, not a
+    // number to correct - and check_no_data() above has already refused the
+    // deletion if that's the case.
+    Ok(())
+}
+
+/// Can we relink to this node? Only a deleted node has been spliced out of
+/// the tree. no_keys is an emptied interior - kept in the tree until the next
+/// remount precisely so ancestry still resolves - and carries child pointers
+/// like any other node, so it is a perfectly ordinary neighbour to attach to.
+fn in_tree(v: &c::Snapshot) -> bool {
+    v.state_compat() != c::bch_snapshot_state::SNAPSHOT_STATE_deleted
+}
+
+/// Where to splice back in from below.
+///
+/// children[0] records where our splice took us out - but that node may have
+/// been spliced out since, and each tombstone down there retains the child it
+/// had when it died. So the node to reattach to is the nearest descendant
+/// still in the tree, and the tombstones in between are our own splice being
+/// undone one step at a time.
+///
+/// 0 when the chain runs out - nothing below us is in the tree, and the
+/// caller relinks through the parent instead, as for a node that never had a
+/// child.
+///
+/// Child ids are always below their parent's (bch2_snapshot_validate,
+/// snapshot_child_bad), so the walk strictly descends and can't loop; a chain
+/// that doesn't descend is corruption, and stops it.
+fn relink_target(t: &TransAttempt<'_, '_>, mut child_id: u32) -> Result<u32, BchError> {
+    while child_id != 0 {
+        let child = match snapshot::lookup_key(t, child_id) {
+            Err(e) if e.matches(c::ENOENT) => break,
+            r => r?,
+        };
+
+        if in_tree(child.v()) {
+            return Ok(child_id);
+        }
+
+        let next = child.v().children()[0];
+        if next >= child_id {
+            break;
+        }
+        child_id = next;
+    }
+    Ok(0)
+}
+
+/// Node @id's key queued for update, if it exists.
+fn get_mut_node_opt<'a, 't>(t: &TransAttempt<'a, 't>, id: u32)
+    -> Result<Option<TransBkey<'a, 't, c::Snapshot>>, BchError>
+{
+    match t.bkey_get_mut(c::btree_id::snapshots, pos(0, id as u64),
+                         BtreeIterFlags::empty(), UpdateTriggerFlags::empty()) {
+        Err(e) if e.matches(c::ENOENT) => Ok(None),
+        r => r.map(Some),
+    }
+}
+
+fn cannot_undelete<T>(fs: &Fs, msg: &mut LogMsg<'_>, why: &str) -> Result<T, BchError> {
+    let _ = write!(msg, "cannot undelete: {why}");
+    fs.throw(bch_errcode::BCH_ERR_fsck_repair_unimplemented)
+}
+
+/// Reinsert an undeleted node into the live tree: the inverse of the splice
+/// in node_delete(). The tombstone retained its pointers as history: if the
+/// parent's child slot (or the snapshot_tree root, for a deleted root)
+/// currently holds the node relink_target() found below us, that's where the
+/// splice took us out - take the slot back and take the child back. If the
+/// slot holds us already, the deletion never got that far and there's
+/// nothing to relink. If the topology has moved on, or an old wiped tombstone
+/// retained nothing, the node revives unlinked and the tree pointer checks
+/// handle it downstream.
+pub fn node_undelete<'t>(t: &TransAttempt<'_, 't>, u: &mut TransBkey<'_, 't, c::Snapshot>)
+    -> Result<(), BchError>
+{
+    let fs = t.fs();
+    let id = u.k().p.offset as u32;
+
+    let mut msg = LogMsg::new(fs);
+    prt!(&mut msg, "{}\n", u.to_text(fs));
+
+    if u.v().children()[1] != 0 {
+        bch_err!(fs, "cannot undelete a node with two children");
+        return fs.throw(bch_errcode::BCH_ERR_fsck_repair_unimplemented);
+    }
+
+    let child_id = relink_target(t, u.v().children()[0])?;
+
+    if child_id == 0 {
+        // Nothing below us to splice in above: either we never had a child,
+        // or the whole chain under us is out of the tree too. Either way our
+        // retained parent pointer is what's left, so relink through it.
+        // Handle the simple case, parent still live: revive in place, and if
+        // our slot in the parent was cleared, the edge repairs complete it
+        // from our side. A dead parent would need undeleting too -
+        // unexpected, so fail rather than guess.
+        //
+        // A childless root has no parent to relink through and no children
+        // to take back: it is the entire tree, so setting it live is the
+        // whole repair. That is the shape of a filesystem that has never
+        // been snapshotted, where refusing means refusing to mount at all.
+        // Whether a snapshot_tree still points at it is the tree pointer
+        // checks' business, as for any node that revives unlinked.
+        let parent_id = u.v().parent();
+        if parent_id != 0 {
+            let Some(mut parent) = get_mut_node_opt(t, parent_id)? else {
+                return cannot_undelete(fs, &mut msg, "parent no longer exists");
+            };
+
+            if !in_tree(parent.v()) {
+                return cannot_undelete(fs, &mut msg, "parent is itself deleted");
+            }
+
+            let pc = parent.v().children();
+            if !pc.contains(&id) {
+                let Some(i) = pc.iter().position(|&c| c == 0) else {
+                    return cannot_undelete(fs, &mut msg, "parent's child slots are full");
+                };
+
+                parent.v_mut().children[i] = id.into();
+                normalize_child_pointers(parent.v_mut());
+            }
+        }
+
+        u.v_mut().set_state(c::bch_snapshot_state::SNAPSHOT_STATE_live);
+        return Ok(());
+    }
+
+    let Some(mut child) = get_mut_node_opt(t, child_id)? else {
+        bch_err!(fs, "cannot undelete: child no longer exists");
+        return fs.throw(bch_errcode::BCH_ERR_fsck_repair_unimplemented);
+    };
+
+    prt!(&mut msg, "attaching to child  {}\n", child.to_text(fs));
+
+    let parent_id = child.v().parent();
+    if parent_id != 0 && parent_id <= id {
+        return cannot_undelete(fs, &mut msg, "parent of child < node to undelete");
+    }
+
+    child.v_mut().parent = id.into();
+
+    if parent_id != 0 {
+        let Some(mut parent) = get_mut_node_opt(t, parent_id)? else {
+            return cannot_undelete(fs, &mut msg, "parent no longer exists");
+        };
+
+        prt!(&mut msg, "attaching to parent {}\n", parent.to_text(fs));
+
+        if !in_tree(parent.v()) {
+            return cannot_undelete(fs, &mut msg, "parent is itself deleted");
+        }
+
+        if let Some(i) = parent.v().children().iter().position(|&c| c == child_id) {
+            parent.v_mut().children[i] = id.into();
+            normalize_child_pointers(parent.v_mut());
+        }
+    } else if child.v().tree() != 0 {
+        match t.bkey_get_mut::<c::SnapshotTree>(
+                c::btree_id::snapshot_trees, pos(0, child.v().tree() as u64),
+                BtreeIterFlags::empty(), UpdateTriggerFlags::empty()) {
+            Err(e) if e.matches(c::ENOENT) => {}
+            Err(e) => return Err(e),
+            Ok(mut s_t) => if s_t.v().root_snapshot.get() == child_id {
+                s_t.v_mut().root_snapshot = id.into();
+                prt!(&mut msg, "updated tree {}\n", s_t.to_text(fs));
+            },
+        }
+    }
+
+    let tree = child.v().tree;
+    let v = u.v_mut();
+    v.parent = parent_id.into();
+    v.tree   = tree;
+    v.set_state(c::bch_snapshot_state::SNAPSHOT_STATE_live);
+
+    v.depth = fs.snapshots.depth(parent_id).into();
+    let mut skip: [u32; 3] = core::array::from_fn(|_| fs.snapshots.skiplist_get(parent_id));
+    skip.sort_unstable();
+    v.skip = skip.map(Into::into);
+
+    Ok(())
+}
+
+// If we have an unlinked inode in an internal snapshot node, and the inode
+// really has been deleted in all child snapshots, how does this get cleaned
+// up?
+//
+// first there is the problem of how keys that have been overwritten in all
+// child snapshots get deleted (unimplemented?), but inodes may perhaps be
+// special?
+//
+// also: unlinked inode in internal snapshot appears to not be getting deleted
+// correctly if inode doesn't exist in leaf snapshots
+//
+// solution:
+//
+// for a key in an interior snapshot node that needs work to be done that
+// requires it to be mutated: iterate over all descendent leaf nodes and copy
+// that key to snapshot leaf nodes, where we can mutate it
+
+// ── The key sweep ────────────────────────────────────────────────────────
+
+/// @id's entry, if this run is emptying it.
+fn snapshot_id_dying<'r>(run: &Run<'r>, id: u32) -> Option<&'r InteriorDelete> {
+    let ret = Eytzinger1::find_by(run.dying, |d| d.id.cmp(&id)).map(|i| &run.dying[i]);
+
+    #[cfg(CONFIG_BCACHEFS_DEBUG)]
+    match ret {
+        None => {
+            assert!(!run.nodes.delete_leaves.contains(&id));
+            assert!(live_child_of(&run.nodes.delete_interior, id).is_none());
+        }
+        Some(d) if d.live_child == 0 => assert!(run.nodes.delete_leaves.contains(&id)),
+        Some(d) => assert!(live_child_of(&run.nodes.delete_interior, id) == Some(d.live_child)),
+    }
+
+    ret
+}
+
+/// Remove a key from a dying/deleted snapshot node, migrating it to that
+/// node's live descendant first when there is one (@live_child != 0): the key
+/// is still visible to the descendant via inheritance, so dropping it
+/// outright would lose data. Only copy it down if the descendant doesn't
+/// already have its own key at that position. With no live descendant (a
+/// leaf) the key is just deleted.
+///
+/// Shared by the deletion pass (process_key()) and the fsck repair
+/// (check_key_has_snapshot()).
+pub fn delete_dead_key<'a, 't>(
+    t:          &TransAttempt<'a, 't>,
+    iter:       &BtreeIter<'a>,
+    k:          BkeySC<'_>,
+    live_child: u32,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    if live_child != 0 {
+        assert!(fs.snapshots.exists(live_child), "migrating to missing snapshot {live_child}");
+
+        let btree = iter.btree();
+        let dst = c::bpos { snapshot: live_child, ..k.k.p };
+
+        let mut dst_iter = BtreeIter::new(t, btree, dst,
+                                          BtreeIterFlags::ALL_SNAPSHOTS | BtreeIterFlags::INTENT);
+        let damage = c::bch_bkey_type::KEY_TYPE_damage;
+
+        match dst_iter.peek_slot(t)? {
+            Some(dst_k) if btree == c::btree_id::damage &&
+                           k.k.key_type() == damage && dst_k.k.key_type() == damage => {
+                // Damage entries merge instead of dropping: the dying key can
+                // hold counts recorded after the descendant's key was created,
+                // so "descendant overwrote it" never applies:
+                let new = damage::keys_merge(t, dst, dst_k, k)?;
+                t.update(&dst_iter, &new, UpdateTriggerFlags::INTERNAL_SNAPSHOT_NODE)?;
+            }
+            Some(dst_k) if !dst_k.k.is_deleted() => {}
+            _ => {
+                let mut new = t.bkey_make_mut_noupdate(k)?;
+                new.k_mut().p = dst;
+                t.update(&dst_iter, &new, UpdateTriggerFlags::INTERNAL_SNAPSHOT_NODE)?;
+            }
+        }
+    }
+
+    t.delete_at(iter, UpdateTriggerFlags::INTERNAL_SNAPSHOT_NODE)
+}
+
+fn process_key<'a>(t: &TransAttempt<'a, '_>, iter: &BtreeIter<'a>, k: BkeySC<'_>, run: &Run<'_>)
+    -> Result<(), BchError>
+{
+    let fs = t.fs();
+
+    if !fs.snapshots.exists(k.k.p.snapshot) &&
+       check_snapshots::check_key_has_snapshot(t, Some(iter), k)? {
+        return t.commit_lazy(None, CommitFlags::NO_ENOSPC);
+    }
+
+    let Some(dying) = snapshot_id_dying(run, k.k.p.snapshot) else {
+        return Ok(());
+    };
+
+    delete_dead_key(t, iter, k, dying.live_child)
+}
+
+fn delete_dead_snapshot_keys_v1_btree(trans: &BtreeTrans<'_>, btree: c::btree_id, run: &Run<'_>)
+    -> Result<(), BchError>
+{
+    let fs = trans.fs();
+    let d = &fs.snapshots.delete;
+    let res = DiskReservation::new(fs);
+
+    let mut iter = BtreeIter::new(trans, btree, POS_MIN,
+                                  BtreeIterFlags::PREFETCH | BtreeIterFlags::ALL_SNAPSHOTS);
+    iter.for_each_commit(trans, Some(&res), CommitFlags::NO_ENOSPC, |t, iter, k| {
+        let _ = d.progress.update(t, iter);
+
+        res.put();
+        process_key(t, iter, k, run)
+    })
+}
+
+fn delete_dead_snapshot_keys_v1(trans: &BtreeTrans<'_>, run: &Run<'_>) -> Result<(), BchError> {
+    let fs = trans.fs();
+
+    fs.snapshots.delete.start_sweep(fs, c"delete_dead_snapshot_keys_v1",
+                                    crate::BTREE_HAS_SNAPSHOTS_MASK, 1);
+
+    let inodes = c::btree_id::inodes;
+    for btree in crate::btrees_in(crate::BTREE_HAS_SNAPSHOTS_MASK & !(1u64 << inodes.0)) {
+        delete_dead_snapshot_keys_v1_btree(trans, btree, run)?;
+    }
+
+    // fsck assumes that we'll process the inodes btree last:
+    delete_dead_snapshot_keys_v1_btree(trans, inodes, run)
+}
+
+fn delete_dead_snapshot_keys_range(
+    trans: &BtreeTrans<'_>,
+    res:   &DiskReservation<'_>,
+    btree: c::btree_id,
+    start: c::bpos,
+    end:   c::bpos,
+    run:   &Run<'_>,
+) -> Result<(), BchError> {
+    let flags = BtreeIterFlags::PREFETCH | BtreeIterFlags::ALL_SNAPSHOTS;
+    let mut iter = BtreeIter::new(trans, btree, start, flags);
+    iter.for_each_max_commit(trans, end, flags, Some(res), CommitFlags::NO_ENOSPC, |t, iter, k| {
+        res.put();
+        process_key(t, iter, k, run)
+    })
+}
+
+fn delete_dead_snapshot_keys_v2(trans: &BtreeTrans<'_>, run: &Run<'_>) -> Result<(), BchError> {
+    let fs = trans.fs();
+    let d = &fs.snapshots.delete;
+    let res = DiskReservation::new(fs);
+
+    d.start_sweep(fs, c"delete_dead_snapshot_keys_v2", 1u64 << c::btree_id::inodes.0, 2);
+
+    let mut iter = BtreeIter::new(trans, c::btree_id::inodes, POS_MIN,
+                                  BtreeIterFlags::PREFETCH | BtreeIterFlags::ALL_SNAPSHOTS);
+
+    // First, delete extents/dirents/xattrs and damage keys
+    //
+    // If an extent/dirent/xattr is present in a given snapshot ID an inode
+    // must also be present in that same snapshot ID (and a damage key has an
+    // inode at its exact position - enforced by check_damage), so we can use
+    // this to greatly accelerate scanning:
+    loop {
+        let p = lockrestart_do(trans, |t| {
+            let p = iter.peek(t)?.map(|k| k.k.p);
+            if p.is_some() {
+                let _ = d.progress.update(t, &iter);
+            }
+            Ok(p)
+        })?;
+        let Some(p) = p else { break };
+
+        if snapshot_id_dying(run, p.snapshot).is_some() {
+            let start = pos(p.offset, 0);
+            let end   = pos(p.offset, u64::MAX);
+
+            delete_dead_snapshot_keys_range(trans, &res, c::btree_id::extents, start, end, run)?;
+            delete_dead_snapshot_keys_range(trans, &res, c::btree_id::dirents, start, end, run)?;
+            delete_dead_snapshot_keys_range(trans, &res, c::btree_id::xattrs, start, end, run)?;
+            delete_dead_snapshot_keys_range(trans, &res, c::btree_id::damage,
+                                            pos(0, p.offset), spos(0, p.offset, u32::MAX), run)?;
+
+            iter.set_pos(pos(0, p.offset + 1));
+        } else {
+            iter.advance();
+        }
+    }
+
+    // The scan above located keys through the inodes btree, so deleting
+    // inode keys destroys the index it used: anything left in the other
+    // btrees at a dying snapshot becomes unfindable, by this pass and by every
+    // later one. Check while it's still repairable - the check_no_data
+    // licenses at the end of deletion only fire once the inodes are already
+    // gone.
+    let mut msg = Printbuf::new();
+    let mut bad_btrees = dying_snapshots_content_btrees(fs, run.nodes, &mut msg);
+
+    if bad_btrees != 0 {
+        // Accounting is derived from the keys themselves, so it doesn't go
+        // through the index above and can see what that scan missed. The v1
+        // scan doesn't use the index either - rescan with it, on the btrees
+        // accounting named and no others.
+        let _ = write!(msg, "\nfalling back to the v1 scan");
+        log::print_str(fs, LogLevel::NOTICE, &mut msg);
+
+        // Retarget the progress indicator: it was initialized for the inodes
+        // btree, which is not what we're about to walk. Nothing after this
+        // loop updates progress, so this is the last word, and version says
+        // the run degraded.
+        d.start_sweep(fs, c"delete_dead_snapshot_keys_v2", bad_btrees, 1);
+
+        for btree in crate::btrees_in(bad_btrees) {
+            delete_dead_snapshot_keys_v1_btree(trans, btree, run)?;
+        }
+
+        msg = Printbuf::new();
+        bad_btrees = dying_snapshots_content_btrees(fs, run.nodes, &mut msg);
+    }
+
+    if bad_btrees != 0 {
+        // v1 found nothing and the keys are still accounted, so nothing is
+        // hiding behind a missing inode - the count is what's wrong. No
+        // content passes: their key_has_snapshot repairs exist to uphold the
+        // invariant v1 doesn't need. Refuse anyway - the inode keys below are
+        // the only way left to find anything that is in fact stranded.
+        let ret = passes::run_explicit(fs, &mut msg, BCH_RECOVERY_PASS_check_allocations,
+                                       c::bch_run_recovery_pass_flags::empty());
+
+        bch_err!(fs, "{}", msg.as_str());
+
+        rewind_is_fine(ret)?;
+        return fs.throw(bch_errcode::BCH_ERR_EINVAL_snapshot_delete_with_data);
+    }
+
+    if snapshot_delete_bail_before_inodes.get() {
+        bch_notice!(fs, "delete_dead_snapshot_keys_v2: cancelling before inode deletion (module param)");
+        return fs.throw(bch_errcode::BCH_ERR_snapshot_delete_cancelled);
+    }
+
+    /* Then the inodes */
+
+    let mut iter = BtreeIter::new(trans, c::btree_id::inodes, POS_MIN,
+                                  BtreeIterFlags::PREFETCH | BtreeIterFlags::ALL_SNAPSHOTS);
+    iter.for_each_commit(trans, Some(&res), CommitFlags::NO_ENOSPC, |t, iter, k| {
+        res.put();
+        process_key(t, iter, k, run)
+    })
+}
+
+// ── Choosing what to delete ──────────────────────────────────────────────
+
+#[derive(Default)]
+struct Collection {
+    nodes:   DeleteNodes,
+    no_keys: KVVec<InteriorDelete>,
+}
+
+fn check_should_delete_leaf(t: &TransAttempt<'_, '_>, k: BkeySC<'_>, v: &c::Snapshot)
+    -> Result<bool, BchError>
+{
+    let fs = t.fs();
+
+    let mut buf = Printbuf::new();
+    prt!(&mut buf, "{}", k.to_text(fs));
+
+    match state(v) {
+        c::bch_snapshot_state::SNAPSHOT_STATE_live => Ok(false),
+        c::bch_snapshot_state::SNAPSHOT_STATE_will_delete if v.subvol() == 0 => {
+            // A will_delete leaf with no subvolume backref is safe to delete
+            // once check_subvols has confirmed no live subvolume points at a
+            // non-live snapshot (it halts recovery if one does). Require
+            // that pass - it can run online - rather than scanning the
+            // subvolumes btree here, or trusting the filesystem version,
+            // which can't distinguish a legacy will_delete leaf from real
+            // corruption.
+            passes::require(fs, &mut buf, BCH_RECOVERY_PASS_check_subvols)?;
+            Ok(true)
+        }
+        c::bch_snapshot_state::SNAPSHOT_STATE_will_delete => {
+            // Raw lookup, not subvolume::get(): this is the deletion path,
+            // the one caller that must see the deleted tombstone rather than
+            // have it reported as ENOENT.
+            let subvol: c::Subvolume = t.bkey_get_val(c::btree_id::subvolumes,
+                                                      pos(0, v.subvol() as u64),
+                                                      BtreeIterFlags::CACHED)?;
+
+            if subvol.state().get() != c::bch_subvolume_state::SUBVOLUME_STATE_deleted.0 {
+                fs_inconsistent!(fs, "snapshot marked for deletion but subvolume not marked for deletion\n{}",
+                                 buf.as_str());
+                return Ok(false);
+            }
+
+            if subvol.snapshot() as u64 != k.k.p.offset {
+                fs_inconsistent!(fs, "snapshot marked for deletion but subvolume does not point back\n{}",
+                                 buf.as_str());
+                return Ok(false);
+            }
+            Ok(true)
+        }
+        c::bch_snapshot_state::SNAPSHOT_STATE_no_keys => {
+            // An emptied interior node whose children have all been deleted
+            // is normally reaped in the same pass that deletes its last child
+            // - each node deletion is its own commit, so a childless no_keys
+            // node is what a crash in between leaves. Shouldn't occur
+            // otherwise; handle it gracefully - it's empty by construction
+            // and node_delete re-verifies no-data:
+            fsck_err!(t, id::snapshot_no_keys_childless,
+                      "childless no_keys snapshot node, deleting:\n{}", buf.as_str())
+        }
+        _ => {
+            fs_inconsistent!(fs, "snapshot leaf in invalid state\n{}", buf.as_str());
+            Ok(false)
+        }
+    }
+}
+
+fn add_nodup(fs: &Fs, list: &mut KVVec<u32>, id: u32) -> Result<(), BchError> {
+    if !list.contains(&id) {
+        list.push(id, GFP_KERNEL).inspect_err(|_| {
+            bch_err!(fs, "error reallocating snapshot_id_list (size {})", list.capacity());
+        })?;
+    }
+    Ok(())
+}
+
+/// Sort one node: dead (no live descendant - keys are dropped) or redundant
+/// (exactly one live child - keys migrate to live_child). Two live children:
+/// nothing to do.
+///
+/// The caller scans in ascending id order and a node's id is always below
+/// its parent's, so children are sorted before parents. Both cases need that:
+///
+/// - A node whose children are all already on delete_leaves is itself dead
+///   and joins them, so a dead subtree accumulates bottom-up. It's torn down
+///   in that same order later, each node childless by its turn because
+///   deleting a child splices this node's pointer to zero.
+///
+/// - A child that's itself redundant already has its own live_child
+///   recorded, so the lookup below returns the terminal of the whole collapse
+///   chain rather than the next node down, and keys move there in one hop.
+fn check_should_delete_snapshot(t: &TransAttempt<'_, '_>, k: BkeySC<'_>, coll: &mut Collection)
+    -> Result<(), BchError>
+{
+    let Some(v) = snapshot::val(k) else { return Ok(()) };
+    let fs = t.fs();
+    let id = k.k.p.offset as u32;
+
+    if state(&v) == c::bch_snapshot_state::SNAPSHOT_STATE_deleted {
+        return Ok(());
+    }
+
+    if v.children()[0] == 0 && !check_should_delete_leaf(t, k, &v)? {
+        return Ok(());
+    }
+
+    // The loop's per-key commit can restart after the pushes below and
+    // replay this body - the lists aren't transactional, so every push must
+    // be idempotent, or collection double-adds on replay. (Repairs invalidate
+    // collected state differently: the deletion path resets the lists
+    // wholesale and rescans.)
+    let (mut live_child, mut nr_live_children) = (0, 0);
+
+    for child in v.children() {
+        if child != 0 && !coll.nodes.delete_leaves.contains(&child) {
+            nr_live_children += 1;
+
+            live_child = live_child_of(&coll.nodes.delete_interior, child)
+                .or_else(|| live_child_of(&coll.no_keys, child))
+                .unwrap_or(child);
+        }
+    }
+
+    if nr_live_children == 2 {
+        return Ok(());
+    }
+
+    // The resolved live child is about to license key migration and a
+    // splice: if it isn't in the table, is self-referential, or isn't a
+    // descendant, the topology is damaged - schedule repair and bail out of
+    // deletion, which runs again once check_snapshots has fixed it:
+    if live_child != 0 &&
+       (live_child == id ||
+        !fs.snapshots.exists(live_child) ||
+        !snapshot::is_ancestor(t, live_child, id)) {
+        let mut msg = LogMsg::new(fs);
+
+        let _ = writeln!(msg, "snapshot deletion found damaged topology (resolved live child {live_child}):");
+        prt!(&mut msg, "{}", k.to_text(fs));
+
+        passes::run_explicit(fs, &mut msg, BCH_RECOVERY_PASS_check_snapshots,
+                             c::bch_run_recovery_pass_flags::empty())?;
+        return fs.throw(bch_errcode::BCH_ERR_EINVAL_snapshot_delete_bad_topology);
+    }
+
+    let no_keys = state(&v) == c::bch_snapshot_state::SNAPSHOT_STATE_no_keys;
+
+    if !no_keys {
+        add_nodup(fs, &mut coll.nodes.deleting_from_trees, fs.snapshots.tree(id))?;
+    }
+
+    if nr_live_children == 0 {
+        add_nodup(fs, &mut coll.nodes.delete_leaves, id)?;
+    } else {
+        let n = InteriorDelete { id, live_child };
+
+        // We're not doing any processing for NO_KEYS snapshot nodes, but we
+        // still track them so that we can find the correct live_child when
+        // deleting parents, above:
+        let list = if !no_keys { &mut coll.nodes.delete_interior } else { &mut coll.no_keys };
+        if live_child_of(list, n.id).is_none() {
+            list.push(n, GFP_KERNEL)?;
+        }
+    }
+
+    Ok(())
+}
+
+/// @id's @n'th ancestor, counting none of the nodes in @skip.
+fn nth_parent_skip(fs: &Fs, mut id: u32, n: u32, skip: &[InteriorDelete]) -> u32 {
+    let parent = |id| fs.snapshots.parent(id).unwrap_or(0);
+    let skipped = |id| live_child_of(skip, id).is_some();
+
+    while skipped(id) {
+        id = parent(id);
+    }
+
+    for _ in 0..n {
+        loop {
+            id = parent(id);
+            if !skipped(id) {
+                break;
+            }
+        }
+    }
+    id
+}
+
+/// Node @k's depth and skiplist, for the tree shape deleting @deleted
+/// produces.
+fn fix_child_of_deleted_snapshot(
+    t:       &TransAttempt<'_, '_>,
+    iter:    &BtreeIter<'_>,
+    k:       BkeySC<'_>,
+    deleted: &[InteriorDelete],
+) -> Result<(), BchError> {
+    let fs = t.fs();
+    let id = k.k.p.offset as u32;
+
+    let Typed::snapshot(k) = k.typed() else { return Ok(()) };
+
+    if live_child_of(deleted, id).is_some() {
+        return Ok(());
+    }
+
+    let mut s = t.bkey_make_mut_noupdate(k)?;
+
+    let nr_deleted_ancestors = deleted.iter()
+        .filter(|i| fs.snapshots.same_tree(id, i.id) && snapshot::is_ancestor(t, id, i.id))
+        .count() as u32;
+
+    if nr_deleted_ancestors == 0 {
+        return Ok(());
+    }
+
+    let v = s.v_mut();
+    let depth = v.depth.get().wrapping_sub(nr_deleted_ancestors);
+    v.depth = depth.into();
+
+    if depth == 0 {
+        v.skip = [0u32.into(); 3];
+    } else {
+        let parent = fs.snapshots.parent(id).unwrap_or(0);
+
+        let mut skip = v.skip.map(|s| s.get());
+        for s in &mut skip {
+            if live_child_of(deleted, *s).is_some() {
+                let n = if depth > 1 {
+                    crate::util::kernel::random_u64_below((depth - 1) as u64) as u32
+                } else {
+                    0
+                };
+                *s = nth_parent_skip(fs, parent, n, deleted);
+            }
+        }
+        skip.sort_unstable();
+        v.skip = skip.map(Into::into);
+    }
+
+    t.update(iter, &s, UpdateTriggerFlags::empty())
+}
+
+// ── Deletion ─────────────────────────────────────────────────────────────
+
+fn delete_dead_snapshots_locked(fs: &Fs) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+    let d = &fs.snapshots.delete;
+
+    // For every snapshot node: If we have no live children and it's not
+    // pointed to by a subvolume, delete it.
+    //
+    // The per-key commit is for the childless-no_keys fsck_err: its fix is
+    // out-of-band (the node is only collected here, deleted later), but the
+    // fsck_err queues its repair log entry on this trans - which would
+    // otherwise never commit, only be dropped at the next trans_begin (the
+    // iter.c dropped-updates WARN):
+    let mut coll = Collection::default();
+    let mut iter = BtreeIter::new(&trans, c::btree_id::snapshots, POS_MIN, BtreeIterFlags::empty());
+    iter.for_each_commit(&trans, None, CommitFlags::empty(), |t, _, k| {
+        check_should_delete_snapshot(t, k, &mut coll)
+    })?;
+
+    if coll.nodes.delete_leaves.is_empty() && coll.nodes.delete_interior.is_empty() {
+        return Ok(());
+    }
+
+    // Eytzinger trees with 1-based indexing are faster than 0-based indexing
+    // due to better cacheline alignment:
+    let mut dying = KVVec::new();
+    dying.push(InteriorDelete::default(), GFP_KERNEL)?;
+    dying.extend_from_slice(&coll.nodes.delete_interior, GFP_KERNEL)?;
+    for &id in coll.nodes.delete_leaves.iter() {
+        dying.push(InteriorDelete { id, live_child: 0 }, GFP_KERNEL)?;
+    }
+    Eytzinger1::sort_by(&mut dying, |l, r| l.id.cmp(&r.id));
+
+    // The walk's btree locks go first: see nodes
+    trans.unlock();
+    *d.nodes.write() = Some(coll.nodes);
+    let nodes = d.nodes.read();
+    let run = Run {
+        nodes:   nodes.as_ref().expect("just published"),
+        no_keys: &coll.no_keys,
+        dying:   &dying,
+    };
+
+    let mut buf = Printbuf::new();
+    nodes_to_text(&mut buf, Some(run.nodes), false);
+    commit_do(&trans, None, CommitFlags::empty(), |t| t.log_msg(&mut buf))?;
+
+    bch_info!(fs, "{}", NodesData { fs, nodes: run.nodes });
+
+    if fs.request_incompat_feature(
+            c::bcachefs_metadata_version::bcachefs_metadata_version_snapshot_deletion_v2).is_ok() {
+        delete_dead_snapshot_keys_v2(&trans, &run)?;
+    } else {
+        delete_dead_snapshot_keys_v1(&trans, &run)?;
+    }
+
+    // Refusals first, and a refusal stops the whole deletion: nodes go one
+    // commit at a time, so refusing partway leaves the ones already deleted
+    // describing a tree shape the rest of the deletion no longer produces.
+    // The refusal schedules its own repair - deletion runs again after it.
+    //
+    // This can't precede the migration above: what the check reads is
+    // whether the keys that were supposed to move actually did.
+    for &i in run.nodes.delete_leaves.iter() {
+        lockrestart_do(&trans, |t| check_no_data(t, i, "leaf delete", Some(&run)))?;
+    }
+
+    for i in run.nodes.delete_interior.iter() {
+        lockrestart_do(&trans, |t| check_no_data(t, i.id, "set_no_keys", Some(&run)))?;
+    }
+
+    for &i in run.nodes.delete_leaves.iter() {
+        let ret = commit_do(&trans, None, CommitFlags::empty(), |t| {
+            check_deletable(t, i, false, Some(&run))?;
+            node_delete(t, i)
+        });
+        refusal_to_text(&trans, &ret, i, Some(&run));
+        ret?;
+    }
+
+    for i in run.nodes.delete_interior.iter() {
+        commit_do(&trans, None, CommitFlags::empty(), |t| node_set_no_keys(t, i.id, &run))?;
+    }
+
+    Ok(())
+}
+
+/// A refusal means "repair first, then retry", not failure: the check that
+/// refused has scheduled the passes that fix what it found, and deletion is
+/// rescheduled the next time a dying snapshot is seen (bch2_mark_snapshot,
+/// check_snapshot_needs_deletion()). Nothing has been done, so there is
+/// nothing wrong with the filesystem that going read-only would protect.
+///
+/// These run as recovery passes, and bch2_run_recovery_passes() returns the
+/// first pass error it sees - which at startup fails the mount. So the
+/// refusals stop here.
+fn refused(ret: Result<(), BchError>) -> Result<(), BchError> {
+    match ret {
+        Err(e) if e == bch_errcode::BCH_ERR_EINVAL_snapshot_delete_with_data.into() ||
+                  e == bch_errcode::BCH_ERR_EINVAL_snapshot_delete_bad_topology.into() => Ok(()),
+        r => r,
+    }
+}
+
+/// Delete dead snapshots, regardless of the auto_snapshot_deletion option:
+/// for sysfs's force-trigger.
+///
+/// Serialization is recovery.run_lock: the delete_dead_snapshots pass runs
+/// under it (the framework holds run_lock while running passes), and the
+/// sysfs force-trigger takes it explicitly. So no separate lock is needed,
+/// and passes never run this concurrently.
+pub fn delete_dead_snapshots_forced(fs: &Fs) -> Result<(), BchError> {
+    let d = &fs.snapshots.delete;
+
+    passes::assert_run_lock_held(fs);
+
+    d.progress.reset();
+
+    let ret = refused(delete_dead_snapshots_locked(fs));
+
+    *d.nodes.write() = None;
+
+    passes::set_no_ratelimit(fs, BCH_RECOVERY_PASS_check_snapshots);
+
+    ret
+}
+
+fn delete_dead_snapshots(fs: &Fs) -> Result<(), BchError> {
+    if fs.opts().auto_snapshot_deletion == 0 {
+        return Ok(());
+    }
+
+    delete_dead_snapshots_forced(fs)
+}
+
+crate::recovery_pass!(bch2_delete_dead_snapshots => delete_dead_snapshots);
+
+fn get_dead_interior_snapshots(k: BkeySC<'_>, delete: &mut KVVec<InteriorDelete>) -> Result<(), BchError> {
+    let Some(v) = snapshot::val(k) else { return Ok(()) };
+
+    if state(&v) != c::bch_snapshot_state::SNAPSHOT_STATE_no_keys {
+        return Ok(());
+    }
+    let Some(child) = only_child(&v) else { return Ok(()) };
+
+    let live_child = live_child_of(delete, child).unwrap_or(child);
+    delete.push(InteriorDelete { id: k.k.p.offset as u32, live_child }, GFP_KERNEL)?;
+    Ok(())
+}
+
+fn collect_dead_interior_snapshots(trans: &BtreeTrans<'_>) -> Result<KVVec<InteriorDelete>, BchError> {
+    let mut delete = KVVec::new();
+    let mut iter = BtreeIter::new(trans, c::btree_id::snapshots, POS_MIN, BtreeIterFlags::empty());
+    iter.for_each(trans, |_, _, k| get_dead_interior_snapshots(k, &mut delete))?;
+    Ok(delete)
+}
+
+fn delete_dead_interior_snapshots(fs: &Fs) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+
+    let mut delete = collect_dead_interior_snapshots(&trans)?;
+
+    if !delete.is_empty() {
+        {
+            let mut msg = LogMsg::with_level(fs, LogLevel::NOTICE);
+
+            let _ = writeln!(msg, "Deleting interior snapshot nodes forces check_snapshots:");
+            passes::run_explicit(fs, &mut msg, BCH_RECOVERY_PASS_check_snapshots,
+                                 c::bch_run_recovery_pass_flags::empty())?;
+        }
+
+        // This is also what makes the non-atomic depth rewrite below safe to
+        // retry: check_snapshots re-derives every depth from the parent
+        // chain. If we crashed partway through that rewrite, the surviving
+        // children carry decremented depths while their parent pointers are
+        // still untouched - so this restores them, and the decrement lands
+        // exactly once per run.
+        check_snapshots::check_snapshots_trans(&trans)?;
+
+        // check_snapshots is licensed to change node states (e.g. repairing a
+        // stale-state legacy tombstone to deleted), so the pre-check
+        // collection is only good for deciding whether to run it - re-collect
+        // for the authoritative delete list:
+        delete = collect_dead_interior_snapshots(&trans)?;
+    }
+
+    if !delete.is_empty() {
+        // Refusals first: the fixup below commits every surviving child's new
+        // depth and skip[] for the tree shape these deletions produce, so a
+        // node refused after it leaves the children describing a deletion
+        // that never happened - skip[] pointing above parent, which
+        // validation rejects on the next write.
+        for i in delete.iter() {
+            let ret = lockrestart_do(&trans, |t| check_deletable(t, i.id, true, None));
+            refusal_to_text(&trans, &ret, i.id, None);
+            ret?;
+        }
+
+        // Fixing children of deleted snapshots can't be done completely
+        // atomically, if we crash between here and when we delete the
+        // interior nodes some depth fields will be off - the check_snapshots
+        // above is what puts them back on the next run.
+        //
+        // So for the whole span between this loop and the delete loop below,
+        // a child carries its new depth and its old parent pointer: depth !=
+        // parent's depth + 1 is a state this pass passes through, not an
+        // invariant.
+        let mut iter = BtreeIter::new(&trans, c::btree_id::snapshots, POS_MIN, BtreeIterFlags::INTENT);
+        iter.for_each_commit(&trans, None, CommitFlags::NO_ENOSPC, |t, iter, k| {
+            fix_child_of_deleted_snapshot(t, iter, k, &delete)
+        })?;
+
+        for i in delete.iter() {
+            let ret = commit_do(&trans, None, CommitFlags::empty(), |t| node_delete(t, i.id));
+            if !ret.is_err_and(|e| e.matches(c::EROFS)) {
+                let _ = bch_err_msg!(fs, ret, "deleting snapshot {}", i.id);
+            }
+            ret?;
+        }
+    }
+
+    Ok(())
+}
+
+fn delete_dead_interior_snapshots_pass(fs: &Fs) -> Result<(), BchError> {
+    if fs.opts().auto_snapshot_deletion == 0 {
+        return Ok(());
+    }
+
+    refused(delete_dead_interior_snapshots(fs))
+}
+
+crate::recovery_pass!(bch2_delete_dead_interior_snapshots => delete_dead_interior_snapshots_pass);
+
+/// For snapshots_read()'s walk: count the emptied interior nodes, and
+/// schedule deletion for a node that needs it.
+pub(crate) fn check_snapshot_needs_deletion(t: &TransAttempt<'_, '_>, k: BkeySC<'_>, nr_empty_interior: &mut u32) {
+    let Some(v) = snapshot::val(k) else { return };
+
+    let needs_delete = match v.state_compat() {
+        c::bch_snapshot_state::SNAPSHOT_STATE_deleted     => false,
+        c::bch_snapshot_state::SNAPSHOT_STATE_no_keys     => { *nr_empty_interior += 1; false }
+        c::bch_snapshot_state::SNAPSHOT_STATE_will_delete => true,
+        _                                                 => only_child(&v).is_some(),
+    };
+
+    if needs_delete {
+        // Schedule the deleter through the recovery-pass machinery, like
+        // bch2_mark_snapshot - this catches the interior single-child case,
+        // which mark_snapshot (will_delete only) doesn't. Ephemeral +
+        // best-effort: ignore the return.
+        let mut buf = Printbuf::new();
+        let _ = passes::run_explicit(t.fs(), &mut buf, BCH_RECOVERY_PASS_delete_dead_snapshots,
+                                     c::bch_run_recovery_pass_flags::RUN_RECOVERY_PASS_ephemeral);
+    }
+}
diff --git a/fs/bcachefs/snapshots/format.rs b/fs/bcachefs/snapshots/format.rs
new file mode 100644
index 0000000..ec567c9
--- /dev/null
+++ b/fs/bcachefs/snapshots/format.rs
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::types::{Le32, Le64};
+use cstruct_macros::{c_bitmask, c_const, c_enum, c_xmacro, grown, CStruct, Plain, TypeInfo, View, SizedVal};
+
+c_const! {
+    #[c_int]
+    pub const BCACHEFS_ROOT_SUBVOL: u32 = 1;
+}
+
+#[grown(from = creation_parent, bkey)]
+#[repr(C)]
+#[derive(Clone, Copy, Default, CStruct, Plain, TypeInfo)]
+#[c_name(bch_subvolume)]
+pub struct Subvolume {
+    pub v: c::bch_val,
+    pub flags: Le32,
+    pub snapshot: Le32,
+    pub inode: Le64,
+    /*
+     * Snapshot subvolumes form a tree, separate from the snapshot nodes
+     * tree - if this subvolume is a snapshot, this is the ID of the
+     * subvolume it was created from:
+     *
+     * This is _not_ necessarily the subvolume of the directory containing
+     * this subvolume:
+     */
+    pub creation_parent: Le32,
+    pub fs_path_parent: Le32,
+    pub otime: c::bch_le128,
+
+    pub state: Le32,
+    pub pad: Le32,
+}
+
+c_xmacro! {
+    /*
+     * Subvolume lifecycle state: same codeword scheme as Snapshot.state
+     * (below), additionally >= 14 bit flips from every snapshot state so a value
+     * copied across key types reads as garbage, not a legal state:
+     *
+     * unlinked: unlinked from filesystem tree but still has open files
+     * deleted:  no longer referenced, delete_dead_snapshots may delete
+     */
+    BCH_SUBVOLUME_STATES(x) {
+        (live, 0x4ad5447e),
+        (unlinked, 0x2d358e8f),
+        (deleted, 0x3c6b2d4c),
+    }
+}
+
+c_enum! {
+    #[open]
+    pub enum bch_subvolume_state: u32 {
+        BCH_SUBVOLUME_STATES(n, v) => SUBVOLUME_STATE_ ## n = v,
+    }
+}
+
+c_bitmask! {
+    LE32_BITMASK(struct Subvolume<Validated>, flags), strip BCH_SUBVOLUME_ {
+        BCH_SUBVOLUME_RO(0, 1),
+        /*
+         * We need to know whether a subvolume is a snapshot so we can know whether we
+         * can delete it (or whether it should just be rm -rf'd)
+         */
+        BCH_SUBVOLUME_SNAP(1, 2),
+        /* Obsolete */
+        BCH_SUBVOLUME_UNLINKED_OBSOLETE(2, 3),
+    }
+}
+
+#[grown(from = depth, bkey)]
+#[repr(C)]
+#[derive(Clone, Copy, Default, CStruct, Plain, TypeInfo)]
+#[c_name(bch_snapshot)]
+pub struct Snapshot {
+    pub v: c::bch_val,
+    pub flags: Le32,
+    pub parent: Le32,
+    pub children: [Le32; 2],
+    pub subvol: Le32,
+    /* corresponds to a SnapshotTree in BTREE_ID_snapshot_trees */
+    pub tree: Le32,
+    pub depth: Le32,
+    pub skip: [Le32; 3],
+    pub btime: c::bch_le128,
+
+    pub state: Le32,
+    pub pad: Le32,
+}
+
+c_xmacro! {
+    /*
+     * WILL_DELETE: leaf node that's no longer referenced by a subvolume, still has
+     * keys, will be deleted by delete_dead_snapshots
+     *
+     * SUBVOL: true if a subvol points to this snapshot (why do we have this?
+     * subvols are nonzero)
+     *
+     * DELETED: we never delete snapshot keys, we mark them as deleted so that we
+     * can distinguish between a key for a missing snapshot (and we have no idea
+     * what happened) and a key for a deleted snapshot (delete_dead_snapshots() missed
+     * something, key should be deleted)
+     *
+     * NO_KEYS: we don't remove interior snapshot nodes from snapshot trees at
+     * runtime, since we can't do the adjustements for the depth/skiplist field
+     * atomically - and that breaks e.g. is_ancestor(). Instead, we mark it to be
+     * deleted at the next remount; this tells us that we don't need to run the full
+     * delete_dead_snapshots().
+     *
+     *
+     * XXX - todo item:
+     *
+     * We should guard against a bitflip causing us to delete a snapshot incorrectly
+     * by cross checking with the subvolume btree: delete_dead_snapshots() can take
+     * out more data than any other codepath if it runs incorrectly
+     */
+    /*
+     * The state field licenses the most destructive thing the filesystem can do -
+     * deleting user data - so corruption of it must be detectable, never
+     * misinterpretable. Every state is a randomly generated codeword: a stray
+     * memory stomper almost never lands on a legal state (4 legal values in a
+     * 2^32 space; zero and all-ones are illegal, so a wiped field is detected,
+     * not misread), and any two states are >= 14 bit flips apart (enforced
+     * below), so sparse bit corruption can't turn one legal state into another.
+     */
+    BCH_SNAPSHOT_STATES(x) {
+        (live, 0x757c47a2),
+        (will_delete, 0x3316a8d2),
+        (no_keys, 0x372b5a01),
+        (deleted, 0x7cd4a225),
+    }
+}
+
+c_enum! {
+    #[open]
+    pub enum bch_snapshot_state: u32 {
+        BCH_SNAPSHOT_STATES(n, v) => SNAPSHOT_STATE_ ## n = v,
+    }
+}
+
+// The state codewords' distances, as the comment on BCH_SNAPSHOT_STATES
+// says: every snapshot and subvolume state at least 14 bit flips from every
+// other, of either kind, and 14 to 18 from a zeroed field and from an
+// all-ones one. Every pair, from the lists - a state added is checked.
+macro_rules! codewords {
+    ([] $(($n:tt, $v:expr)),* $(,)?) => { &[$($v),*] };
+}
+const _: () = {
+    let lists: [&[u32]; 2] = [BCH_SNAPSHOT_STATES!(codewords []), BCH_SUBVOLUME_STATES!(codewords [])];
+    let mut a = 0;
+    while a < lists.len() {
+        let mut i = 0;
+        while i < lists[a].len() {
+            let v = lists[a][i];
+            assert!(v.count_ones() >= 14 && v.count_ones() <= 18,
+                    "a state codeword within 14 bit flips of zero or of all ones");
+            let mut b = a;
+            while b < lists.len() {
+                let mut j = if b == a { i + 1 } else { 0 };
+                while j < lists[b].len() {
+                    assert!((v ^ lists[b][j]).count_ones() >= 14,
+                            "two state codewords within 14 bit flips of each other");
+                    j += 1;
+                }
+                b += 1;
+            }
+            i += 1;
+        }
+        a += 1;
+    }
+};
+
+c_bitmask! {
+    LE32_BITMASK(struct Snapshot<Validated>, flags), strip BCH_SNAPSHOT_ {
+        /* Obsolete */
+        BCH_SNAPSHOT_WILL_DELETE_OBSOLETE(0, 1),
+        BCH_SNAPSHOT_SUBVOL_OBSOLETE(1, 2),
+        BCH_SNAPSHOT_DELETED_OBSOLETE(2, 3),
+        BCH_SNAPSHOT_NO_KEYS_OBSOLETE(3, 4),
+    }
+}
+
+/*
+ * Snapshot trees:
+ *
+ * The snapshot_trees btree gives us persistent indentifier for each tree of
+ * Snapshot nodes, and allow us to record and easily find the root/master
+ * subvolume that other snapshots were created from:
+ */
+#[repr(C)]
+#[derive(Clone, Copy, Default, CStruct, Plain, TypeInfo, View, SizedVal)]
+#[c_name(bch_snapshot_tree)]
+pub struct SnapshotTree {
+    pub v: c::bch_val,
+    pub master_subvol: Le32,
+    pub root_snapshot: Le32,
+}
