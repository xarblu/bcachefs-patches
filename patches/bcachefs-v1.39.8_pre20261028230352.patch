+					(_journal_seq), (_commit_flags)))
+
+struct bkey_s_c bch2_btree_iter_peek_and_restart_outlined(struct btree_iter *);
+
+#define for_btree_root_key_at_level(_trans, _iter, _btree_id, _level, _k, _do)		\
+	lockrestart_do(trans, ({							\
