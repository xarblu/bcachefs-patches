diff --git a/fs/bcachefs/util/refcount.rs b/fs/bcachefs/util/refcount.rs
new file mode 100644
index 0000000..4af8bd5
--- /dev/null
+++ b/fs/bcachefs/util/refcount.rs
@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Refcounts, and refs on them.
+//!
+//! Refcount<K> is a count on a T. A count that's a type of its own -
+//! EnumeratedRef, c->writes and ca->io_ref[]; a closure's; an open bucket's
+//! pins - is Refcount<()>, K's default. One that isn't, yet, is a count K on
+//! the T that has it, K a marker type naming which: c->ro_ref is Fs's
+//! Refcount<RoRefs>.
+//!
+//! A ref keeps what it counts alive - and what that's in: its owner waits
+//! the count out before it frees it. That's what a refcount is, and it's
+//! Refcount's contract, so a ref is all it takes to have the T: a RefGuard
+//! has no lifetime, and goes wherever it's needed - into a bio in flight,
+//! beside the box that owns what it counts.
+//!
+//! get() takes a ref that can't fail. A TryRefcount can also be tried for:
+//! tryget() fails once the count is dead - or has never started.
+//! tryget_live() is for a count that's killed in two steps, as a percpu_ref
+//! is: it fails as soon as killing begins, where tryget() still succeeds
+//! until the count is dead - for what must finish once it's begun. A count
+//! killed in one step has nothing to tell them apart: tryget_live() is
+//! tryget().
+//!
+//! A count with nothing to try - an open bucket's pins, the first made with
+//! the bucket, the rest from one that's held - is a Refcount and not a
+//! TryRefcount, rather than having a tryget() that can't fail.
+//!
+//! Refs are RefGuards: a RefGuard<T, K> is a ref on T's count K, and derefs
+//! to the T - the count itself, for a count that's a type of its own.
+//! Cloning one takes another, dropping it puts it.
+//! They're had from the trait's get() and tryget()s, or - for a T with
+//! more than one count, where those would be ambiguous - from the guard's,
+//! named by an alias: RoRef::tryget(fs). What an implementation
+//! supplies are the raw counting - inc(), dec(), try_inc() - which the
+//! guards are made from.
+//!
+//! A ref handed across without a guard - into a C list, as an open bucket's
+//! pins are, or to a work item queued (ReffedWork, util/workqueue.rs) - is
+//! leak()ed and adopt()ed back, by what does the handing: the run adopts its
+//! ref, put as the run ends.
+//!
+//! What's counted may be valid only while a ref is held - an open bucket,
+//! held open by its pins; a device, whose removal waits for its io refs - so
+//! a guard hands out its T only for as long as the guard is borrowed, and
+//! leak() gives back nothing.
+
+use core::marker::PhantomData;
+use core::ops::Deref;
+use core::ptr::NonNull;
+
+/// # Safety
+/// inc() takes a ref that's held until dec() gives it back - and while one
+/// is, the T isn't freed, nor what it's in.
+pub unsafe trait Refcount<K = ()> {
+    fn inc(&self);
+
+    /// # Safety
+    /// The caller holds a ref, and gives it up.
+    unsafe fn dec(&self);
+
+    fn get(&self) -> RefGuard<Self, K> {
+        RefGuard::get(self)
+    }
+}
+
+/// # Safety
+/// A try_inc() or try_inc_live() that returns true takes a ref, as inc().
+pub unsafe trait TryRefcount<K = ()>: Refcount<K> {
+    fn try_inc(&self) -> bool;
+
+    fn try_inc_live(&self) -> bool {
+        self.try_inc()
+    }
+
+    fn tryget(&self) -> Option<RefGuard<Self, K>> {
+        RefGuard::tryget(self)
+    }
+
+    fn tryget_live(&self) -> Option<RefGuard<Self, K>> {
+        RefGuard::tryget_live(self)
+    }
+}
+
+/// A ref on T's count K: T, kept by it.
+#[must_use = "the ref is put as soon as it's dropped"]
+pub struct RefGuard<T: Refcount<K> + ?Sized, K = ()> {
+    t:  NonNull<T>,
+    _k: PhantomData<fn() -> K>,
+}
+
+// SAFETY: a &T, for as long as the ref keeps T: Send and Sync as &T is
+unsafe impl<T: Refcount<K> + ?Sized + Sync, K> Send for RefGuard<T, K> {}
+unsafe impl<T: Refcount<K> + ?Sized + Sync, K> Sync for RefGuard<T, K> {}
+
+impl<T: Refcount<K> + ?Sized, K> RefGuard<T, K> {
+    pub fn get(t: &T) -> Self {
+        t.inc();
+        RefGuard { t: NonNull::from(t), _k: PhantomData }
+    }
+
+    /// A ref taken without a guard, handed over.
+    ///
+    /// # Safety
+    /// The caller holds a ref on @t's count K, and gives it up to this.
+    pub(crate) unsafe fn adopt(t: &T) -> Self {
+        RefGuard { t: NonNull::from(t), _k: PhantomData }
+    }
+
+    /// Its ref handed over without a guard, to be adopt()ed - not put.
+    pub(crate) fn leak(self) {
+        core::mem::forget(self);
+    }
+}
+
+impl<T: TryRefcount<K> + ?Sized, K> RefGuard<T, K> {
+    // then(), lazily: a guard made when the try failed would put a ref on
+    // its drop that nothing took
+    pub fn tryget(t: &T) -> Option<Self> {
+        t.try_inc().then(|| RefGuard { t: NonNull::from(t), _k: PhantomData })
+    }
+
+    pub fn tryget_live(t: &T) -> Option<Self> {
+        t.try_inc_live().then(|| RefGuard { t: NonNull::from(t), _k: PhantomData })
+    }
+}
+
+impl<T: Refcount<K> + ?Sized, K> Deref for RefGuard<T, K> {
+    type Target = T;
+
+    fn deref(&self) -> &T {
+        // SAFETY: our ref keeps it - Refcount's contract
+        unsafe { self.t.as_ref() }
+    }
+}
+
+impl<T: Refcount<K> + ?Sized, K> Clone for RefGuard<T, K> {
+    fn clone(&self) -> Self {
+        RefGuard::get(&**self)
+    }
+}
+
+impl<T: Refcount<K> + ?Sized, K> Drop for RefGuard<T, K> {
+    fn drop(&mut self) {
+        // SAFETY: ours, from inc(), a try_inc() that succeeded, or adopt();
+        // the ref keeps T till it's put
+        unsafe { self.t.as_ref().dec() }
+    }
+}
diff --git a/fs/bcachefs/util/rhashtable.rs b/fs/bcachefs/util/rhashtable.rs
new file mode 100644
index 0000000..9ff3b4c
--- /dev/null
+++ b/fs/bcachefs/util/rhashtable.rs
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! An rhashtable's read side, under RCU, a bucket at a time. struct
+//! bucket_table is opaque - the kernel's bindings only declare it - so its
+//! size and slots come from C (util.c); chains are walked here: a slot's bit
+//! 0 is its lock, and a chain ends at an odd "nulls" pointer. During a
+//! resize it's the old table, as rht_for_each_entry_rcu() reads it.
+
+use core::marker::PhantomData;
+use core::sync::atomic::{AtomicPtr, Ordering};
+
+use crate::c;
+use crate::util::rcu::ReadGuard;
+
+pub struct RhtRead<'g, T> {
+    tbl:         *const c::bucket_table,
+    head_offset: usize,
+    _entries:    PhantomData<(&'g T, &'g ReadGuard)>,
+}
+
+/// # Safety
+/// @ht's entries are Ts, linked by their rhash_head at @head_offset, whose
+/// memory stays valid for an RCU section that finds them: freed after a
+/// grace period, or never while the table's in use.
+pub unsafe fn read<'g, T>(ht: &'g c::rhashtable, head_offset: usize, _rcu: &'g ReadGuard)
+    -> RhtRead<'g, T>
+{
+    RhtRead {
+        tbl: unsafe { c::bch2_rht_table(ht) },
+        head_offset,
+        _entries: PhantomData,
+    }
+}
+
+impl<'g, T> RhtRead<'g, T> {
+    pub fn nr_buckets(&self) -> usize {
+        unsafe { c::bch2_rht_nr_buckets(self.tbl) as usize }
+    }
+
+    /// rht_for_each_entry_rcu().
+    pub fn bucket(&self, i: usize) -> impl Iterator<Item = &'g T> + use<'g, T> {
+        assert!(i < self.nr_buckets());
+
+        // the slot and links change as we read: rcu_dereference()d
+        let slot = unsafe { c::bch2_rht_bucket(self.tbl, i as u32) };
+        let first = unsafe { AtomicPtr::from_ptr(slot) }.load(Ordering::Acquire);
+        let mut pos = (first as usize & !1) as *mut c::rhash_head;
+        let head_offset = self.head_offset;
+
+        core::iter::from_fn(move || {
+            // empty, or the end: a nulls marker
+            if pos.is_null() || pos as usize & 1 != 0 {
+                return None;
+            }
+            // SAFETY: read()'s
+            unsafe {
+                let entry = &*pos.byte_sub(head_offset).cast::<T>();
+                pos = AtomicPtr::from_ptr(&raw mut (*pos).next).load(Ordering::Acquire);
+                Some(entry)
+            }
+        })
+    }
+}
diff --git a/fs/bcachefs/util/seq_file.rs b/fs/bcachefs/util/seq_file.rs
new file mode 100644
index 0000000..b961905
--- /dev/null
+++ b/fs/bcachefs/util/seq_file.rs
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A seq_file being written: what a show() op - show_options(),
+//! show_devname() - prints to. The kernel crate's SeqFile prints through its
+//! own fmt adapter; this writes bytes, which every Display of ours can make.
+
+use crate::c;
+use crate::util::ffi::Opaque;
+
+#[repr(transparent)]
+pub struct SeqFile(Opaque<c::seq_file>);
+
+impl SeqFile {
+    /// # Safety
+    /// @m is a seq_file being written by this thread, for 'a.
+    pub unsafe fn from_raw<'a>(m: *mut c::seq_file) -> &'a SeqFile {
+        unsafe { &*m.cast::<SeqFile>() }
+    }
+
+    /// Past the buffer's end, it's dropped: seq_file retries the show() with
+    /// a bigger one.
+    pub fn write(&self, b: &[u8]) {
+        unsafe { c::seq_write(self.0.as_ptr(), b.as_ptr().cast(), b.len()) };
+    }
+}
diff --git a/fs/bcachefs/util/siphash.rs b/fs/bcachefs/util/siphash.rs
new file mode 100644
index 0000000..701bca2
--- /dev/null
+++ b/fs/bcachefs/util/siphash.rs
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2013 Andre Oppermann <andre@FreeBSD.org>
+
+//! SipHash-c-d, Aumasson and Bernstein's keyed hash ("SipHash: a fast
+//! short-input PRF"): c compression rounds per 8 byte block, d finalization
+//! rounds, a 128 bit key and a 64 bit result. The round counts are the type's:
+//! str_hash's SipHash24, the full strength, and SipHash13 - hsiphash()'s
+//! rounds on 64-bit - for hash tables, util/cuckoo.rs's.
+//!
+//! Translated from util/siphash.c, OpenBSD's siphash.c 1.3, which it replaces -
+//! and like it, not quite SipHash when one input comes in several updates. An
+//! update that finishes a part filled block copies what's left after it to
+//! where the block was filled to, not to its start, and the end then zeroes
+//! from there: so the last block hashes stale bytes and loses some of the tail.
+//! xattr names hash as two updates, their type and then the name, so an xattr
+//! name of seven bytes or more hashes this way on disk, unless what it has past
+//! the seventh byte is a multiple of eight. The result is the format: kept as
+//! is, and checked against util/siphash.c before that went. One update hashes
+//! as SipHash does - every dirent, and the cuckoo table's. A tail that doesn't
+//! fit where it's put - C wrote it into the byte count - is a bounds check
+//! here: the one hash in two updates, an xattr's, puts one byte in the block
+//! first, which leaves room for any tail.
+//!
+//! As a core::hash::Hasher - what a hash table's key is hashed into, a write
+//! per field - it's SipHash proper, whatever the writes: a key whose fields
+//! lost bytes to the above would hash alike under every key.
+
+/// SipHash with @C compression and @D finalization rounds, as it runs.
+#[derive(Clone)]
+pub struct SipHasher<const C: usize, const D: usize> {
+    v:     [u64; 4],
+    buf:   [u8; 8],
+    bytes: u32,
+}
+
+pub type SipHash24 = SipHasher<2, 4>;
+pub type SipHash13 = SipHasher<1, 3>;
+
+/// A SipHash key, as a core::hash::BuildHasher: what a keyed table hashes
+/// with, hash_one() - drawn when the table's made, and again on a rehash.
+#[derive(Clone, Copy)]
+pub struct SipKey<const C: usize, const D: usize>([u64; 2]);
+
+pub type SipHash13Key = SipKey<1, 3>;
+
+impl<const C: usize, const D: usize> From<[u64; 2]> for SipKey<C, D> {
+    fn from(k: [u64; 2]) -> Self {
+        Self(k)
+    }
+}
+
+impl<const C: usize, const D: usize> core::hash::BuildHasher for SipKey<C, D> {
+    type Hasher = SipHasher<C, D>;
+
+    fn build_hasher(&self) -> SipHasher<C, D> {
+        SipHasher::new(self.0[0], self.0[1])
+    }
+}
+
+impl<const C: usize, const D: usize> SipHasher<C, D> {
+    pub fn new(k0: u64, k1: u64) -> Self {
+        Self {
+            v: [0x736f6d6570736575 ^ k0, 0x646f72616e646f6d ^ k1,
+                0x6c7967656e657261 ^ k0, 0x7465646279746573 ^ k1],
+            buf:   [0; 8],
+            bytes: 0,
+        }
+    }
+
+    fn rounds(&mut self, n: usize) {
+        let [mut v0, mut v1, mut v2, mut v3] = self.v;
+        for _ in 0..n {
+            v0 = v0.wrapping_add(v1);
+            v2 = v2.wrapping_add(v3);
+            v1 = v1.rotate_left(13);
+            v3 = v3.rotate_left(16);
+
+            v1 ^= v0;
+            v3 ^= v2;
+            v0 = v0.rotate_left(32);
+
+            v2 = v2.wrapping_add(v1);
+            v0 = v0.wrapping_add(v3);
+            v1 = v1.rotate_left(17);
+            v3 = v3.rotate_left(21);
+
+            v1 ^= v2;
+            v3 ^= v0;
+            v2 = v2.rotate_left(32);
+        }
+        self.v = [v0, v1, v2, v3];
+    }
+
+    fn block(&mut self, m: u64) {
+        self.v[3] ^= m;
+        self.rounds(C);
+        self.v[0] ^= m;
+    }
+
+    /// @data, as the format hashes it: see the top of the file.
+    pub fn update(&mut self, data: &[u8]) {
+        self.absorb(data, false)
+    }
+
+    /// @data; the tail after a block @data finished goes where the format puts
+    /// it, past where that block had been filled to, unless @exact.
+    fn absorb(&mut self, mut data: &[u8], exact: bool) {
+        if data.is_empty() {
+            return;
+        }
+
+        let used = self.bytes as usize % 8;
+        self.bytes = self.bytes.wrapping_add(data.len() as u32);
+        let mut at = used;
+
+        if used > 0 {
+            let left = 8 - used;
+            if data.len() < left {
+                self.buf[used..used + data.len()].copy_from_slice(data);
+                return;
+            }
+            self.buf[used..].copy_from_slice(&data[..left]);
+            self.block(u64::from_le_bytes(self.buf));
+            data = &data[left..];
+            if exact {
+                at = 0;
+            }
+        }
+
+        let mut blocks = data.chunks_exact(8);
+        for b in &mut blocks {
+            self.block(u64::from_le_bytes(b.try_into().expect("8 bytes")));
+        }
+        let tail = blocks.remainder();
+        self.buf[at..at + tail.len()].copy_from_slice(tail);
+    }
+
+    pub fn end(mut self) -> u64 {
+        let used = self.bytes as usize % 8;
+        self.buf[used..7].fill(0);
+        self.buf[7] = self.bytes as u8;
+        self.block(u64::from_le_bytes(self.buf));
+
+        self.v[2] ^= 0xff;
+        self.rounds(D);
+        self.v.into_iter().fold(0, |h, v| h ^ v)
+    }
+
+    /// @data's hash, in one update.
+    pub fn hash(k0: u64, k1: u64, data: &[u8]) -> u64 {
+        let mut h = Self::new(k0, k1);
+        h.update(data);
+        h.end()
+    }
+}
+
+impl<const C: usize, const D: usize> core::hash::Hasher for SipHasher<C, D> {
+    fn write(&mut self, bytes: &[u8]) {
+        self.absorb(bytes, true)
+    }
+
+    fn finish(&self) -> u64 {
+        self.clone().end()
+    }
+}
diff --git a/fs/bcachefs/util/siphash_types.rs b/fs/bcachefs/util/siphash_types.rs
