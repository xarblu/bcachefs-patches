+     * marking it as completed before it's reachable would be incorrect:
+     */
+    pub will_make_reachable: c_ulong,
+
+    pub ob: cs::open_buckets,
+
+    /* lru list */
+    pub list: cs::list_head,
+
+    pub cache_state: cs::btree_node_cache_state,
+}
