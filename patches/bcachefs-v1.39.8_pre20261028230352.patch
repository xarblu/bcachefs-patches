+    fn group(name: &str, parent: u32, deleted: bool) -> c::bch_disk_group {
+        let mut g = c::bch_disk_group { label: label(name), ..Default::default() };
+        g.set_bch_group_parent(parent.into());
+        g.set_bch_group_deleted(deleted);
