+
+impl StripeNew {
+    /// A new stripe of @nr_data data blocks and @nr_parity parity of
+    /// @blocksize sectors, in @disk_label, by @algorithm, on @devs - and its
+    /// task, made - open: ec_new_stripe_alloc(). Its one io ref is its
+    /// maker's, in @maker.
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn alloc(fs: &Fs, devs: c::bch_devs_mask, watermark: c::bch_watermark, disk_label: u32, algorithm: u32,
+             nr_data: u32, nr_parity: u32, blocksize: u32) -> Result<StripeNewBox, BchError> {
+        let init = pin_init!(StripeNew {
+            // SAFETY: its head and new_stripes, which own it, are emptied
+            // going read-only, and its task's last run, which it lasts to,
+            // is drained with stripe_create_wq as the filesystem's freed
+            fs:         unsafe { BackRef::new(fs) },
+            start_time: local_clock(),
+            idx:        AtomicU64::new(0),
+            io_refs:    AtomicI32::new(0),
+            in_flight_ref: GatherRefSlot::new(),
+            in_flight   <- Gather::new(),
+            seq:        AtomicU64::new(0),
+            err:        FirstErr::new(),
+            state:      AtomicU32::new(State::EC_STRIPE_NEW_open as u32),
+            internal    <- new_lock!(<- Internal::new(devs, watermark), ::pin_init::zeroed(), "stripe_new.internal"),
+        }? BchError);
+
+        // SAFETY: what the task borrows outlives it - see the file comment -
+        // and the stripe, which it's in, outlives its future. Its state's
+        // interior: it's shared from here
+        let (b, task) = unsafe {
+            spawn_home(Spawn::Queue(&fs.ec.stripe_create_wq), init,
+                       |s| stripe_task(fs, BackRef::new(s)), GFP_KERNEL)
+        }?;
+        {
+            let mut s = b.lock();
+            new_stripe_key(fs, &mut s.new_stripe, algorithm as u8, nr_data as u8, nr_parity as u8,
+                           blocksize as u16, disk_label as u8);
+            s.task = Some(task);
+            s.maker = Some(IoRef::get(&b));
+        }
+
+        b.in_flight_ref.set(b.in_flight.get());
+        Ok(b)
+    }
+
+    /// # Safety
+    /// @p is an open bucket's ->ec: a StripeNew, live while it's borrowed.
+    pub(crate) unsafe fn from_c<'a>(p: *const c::ec_stripe_new) -> &'a StripeNew {
+        // SAFETY: the caller's
+        unsafe { &*p.cast::<StripeNew>() }
+    }
+
+    pub(crate) fn as_c(&self) -> *mut c::ec_stripe_new {
+        core::ptr::from_ref(self).cast_mut().cast()
+    }
+
+    /// Its filesystem, for reserve_parity().
+    pub(crate) fn fs_ref(&self) -> &BackRef<Fs> {
+        &self.fs
+    }
+
+    /// Never held across an await
+    /// - a mutex is released by the task that took it, and its task resumes
+    /// on any worker - and, once it's launched, never long.
+    pub(crate) fn lock(&self) -> InternalGuard<'_> {
+        self.internal.lock()
+    }
+
+    fn state(&self) -> State {
+        State::from_bits(self.state.load(Ordering::Relaxed))
+    }
+
+    /// Its task started, unless it has been, and its slot published - @s its
+    /// internal state, locked: from here on, writers may have it.
+    pub(crate) fn launch(&self, s: &mut Internal) {
+        if let Some(t) = s.task.take() {
+            self.idx.store(s.new_stripe.idx(), Ordering::Relaxed);
+            // detached: it removes itself from new_stripes when it's done
+            drop(t.start());
+        }
+    }
+
+    /// Filling: its task started, and its maker's io ref put - the maker's last
+    /// touch of it. @_v, new_stripes, locked, and it's in them: so its task,
+    /// which takes it out to free it, can't before we're done.
+    pub(crate) fn fill(&self, _v: &NewStripes) {
+        self.state.store(State::EC_STRIPE_NEW_filling as u32, Ordering::Relaxed);
+        let maker = {
+            let mut i = self.lock();
+            self.launch(&mut i);
+            i.maker.take().expect("a stripe handed on twice")
+        };
+        drop(maker);
+    }
+}
+
+/// A stripe being made's io refs: see the file comment.
+pub(crate) enum IoRefs {}
+
+/// An io ref on a stripe being made.
+pub(crate) type IoRef = RefGuard<StripeNew, IoRefs>;
+
+// SAFETY: @io_refs counts them. The last dec() puts the io refs' ref on
+// @in_flight, the last touch: the task may free the stripe after it - while
+// dec()'s &self is still on the stack, as Gather::put()'s is.
+unsafe impl Refcount<IoRefs> for StripeNew {
+    fn inc(&self) {
+        self.io_refs.fetch_add(1, Ordering::Relaxed);
+    }
+
+    /// The last takes it in flight - its seq the next, the flushes woken -
+    /// and has its task go on to create it.
+    unsafe fn dec(&self) {
+        let fs = &*self.fs;
+        let v = self.io_refs.fetch_sub(1, Ordering::AcqRel);
+        assert!(v > 0, "stripe {} io ref put with none held", self.idx.load(Ordering::Relaxed));
+        if v != 1 {
+            return;
+        }
+
+        // Every bucket is back: the data is all in. This is the filling ->
+        // in_flight transition, after which the stripe completes without
+        // needing anything from a writer; seq is the commit-ready marker
+        // fs_ec_flush_outstanding() waits on.
+        self.state.store(State::EC_STRIPE_NEW_in_flight as u32, Ordering::Relaxed);
+        self.seq.store(fs.ec.stripe_new_seq.fetch_add(1, Ordering::Relaxed) as u64 + 1, Ordering::Release);
+        fs.ec.new_stripes_changed.wake();
+        self.in_flight_ref.take().expect("the io refs' ref on its in flight, put once").put(());
+    }
+}
+
+impl Internal {
+    /// Open, on @devs, at @watermark: its keys zeroed, for new_stripe_key().
+    fn new(devs: c::bch_devs_mask, watermark: c::bch_watermark) -> impl PinInit<Self> {
+        pin_init!(Internal {
+            write:               None,
+            task:                None,
+            maker:               None,
+            devs,
+            watermark,
+            allocated:           false,
+            blocks:              Default::default(),
+            res:                 None,
+            buckets:             ArrayVec::new(),
+            new_stripe           <- pin_init::init_zeroed(),
+            new_buf:             None,
+            slot_claim:          None,
+            reuse:               None,
+        })
+    }
+
+    pub(crate) fn nr_data(&self) -> u32 {
+        self.new_stripe.stripe().v().nr_data()
+    }
+
+    /// Its blocks that have one: a bucket, or the old stripe's in place.
+    pub(crate) fn gotten(&self) -> c::StripeBlockMask {
+        let mut m = c::StripeBlockMask::default();
+        for (i, b) in self.blocks.iter().enumerate() {
+            if b.gotten() {
+                m.set(i);
+            }
+        }
+        m
+    }
+
+    /// The old stripe's blocks it carries forward, by new block: block i is
+    /// the old stripe's old_block_map()[i].
+    pub(crate) fn old_block_map(&self) -> ArrayVec<u8, MAX_BLOCKS> {
+        self.blocks.iter().map_while(Slot::old).collect()
+    }
+
+    /// Its parity's disk reservation: the stripe's sectors for each parity
+    /// block, which a full stripe's data was reserved without.
+    pub(crate) fn reserve_parity(&mut self, stripe_fs: &BackRef<Fs>, flags: c::bch_reservation_flags)
+        -> Result<(), BchError>
+    {
+        let v = self.new_stripe.stripe().v();
+        let (sectors, nr_parity) = (v.sectors.get().into(), v.nr_redundant.into());
+        // SAFETY: into a stripe being made - an Internal is only ever a
+        // StripeNew's - which the filesystem drains before it goes
+        self.res.get_or_insert_with(|| DiskReservation::new(unsafe { stripe_fs.get() })).add(sectors, nr_parity, flags)
+    }
+
+    /// Its blocks' buckets into ec.stripes_new_buckets, for reconcile to
+    /// leave alone while it's made: none of them, on an error.
+    pub(crate) fn buckets_add(&mut self, fs: &Fs) -> Result<(), BchError> {
+        let nr = self.new_stripe.stripe().v().nr_blocks.into();
+
+        for b in self.blocks[..nr].iter().filter_map(Slot::bucket) {
+            let id = b.id();
+            let bucket = bucket_to_u64(pos(id.dev().into(), id.bucket()));
+
+            match fs.ec.stripes_new_buckets.insert_new(bucket) {
+                Ok(Ok(())) => self.buckets.push(bucket),
+                Ok(Err(_)) => panic!("bucket {}:{} in two stripes being made", id.dev(), id.bucket()),
+                Err(AllocError) => {
+                    self.buckets_del(fs);
+                    return fs.throw(bch_errcode::BCH_ERR_ENOMEM_stripe_new_bucket);
+                }
+            }
+        }
+        Ok(())
+    }
+
+    /// buckets_add()'s buckets out.
+    fn buckets_del(&mut self, fs: &Fs) {
+        for b in self.buckets.drain(..) {
+            fs.ec.stripes_new_buckets.remove(&b);
+        }
+    }
+}
+
+impl StripeNew {
+    /// What it holds of the filesystem's given back: its blocks' buckets,
+    /// its disk reservation, its buckets in the new stripes' bucket table,
+    /// its slot claim and old stripe - bch2_ec_stripe_new_free() and
+    /// stripe_repair_rebuild_abort() - and a repair's writes, done. By its
+    /// task's teardown, before it's out of new_stripes - its memory goes with
+    /// the task's last run, after its write ref, which going read-only waits
+    /// on - and by its drop, for one discarded.
+    pub(crate) fn release(&self) {
+        let fs = &*self.fs;
+        let mut s = self.lock();
+
+        s.blocks = Default::default();
+        s.res = None;
+        s.buckets_del(fs);
+
+        if let Some(claim) = s.slot_claim.take() {
+            claim.put(fs);
+        }
+        if let Some(r) = s.reuse.take() {
+            r.put(fs);
+        }
+        drop(s.write.take());
+    }
+}
+
+#[pinned_drop]
+impl PinnedDrop for StripeNew {
+    /// release()d, if teardown hasn't; its buffers go with it.
+    fn drop(self: Pin<&mut Self>) {
+        assert!(self.lock().maker.is_none(), "stripe {} freed holding its maker's io ref",
+                self.idx.load(Ordering::Relaxed));
+        self.release();
+    }
+}
+
+/// @b, never launched, freed: a repair's rebuild that failed, or a head's
+/// stripe at shutdown. Only its own io ref is held - no writer has a block -
+/// and its task, never started, goes first: unstarted, its refs keep @b.
+pub(crate) fn discard(b: StripeNewBox) {
+    let task = b.lock().task.take();
+    assert!(task.is_some(), "discarding stripe {} with its task started", b.idx.load(Ordering::Relaxed));
+    drop(task);
+    // given up without its put: never launched, it's not taken in flight
+    b.lock().maker.take().expect("discarding a stripe handed on").leak();
+    let v = b.io_refs.swap(0, Ordering::Relaxed);
+    assert_eq!(v, 1, "discarding stripe {} with writers' io refs", b.idx.load(Ordering::Relaxed));
+    b.in_flight_ref.take().expect("the io refs' ref on its in flight").put(());
+    drop(b);
+}
+
+pub(crate) fn new_stripes_take(fs: &Fs, p: NonNull<StripeNew>) -> StripeNewBox {
+    fs.ec.new_stripes.lock().take(p)
+}
+
+// ── Its writers' ───────────────────────────────────────────────────────────
+
+impl OpenBucketRef {
+    /// The stripe being made it's a block of, if a writer's claimed it for
+    /// one.
+    pub fn stripe(&self) -> Option<&StripeNew> {
+        let s = self.ec.load(Ordering::Relaxed);
+        // SAFETY: its ->ec holds an io ref on the stripe while it's open,
+        // which it is while it's borrowed
+        (!s.is_null()).then(|| unsafe { StripeNew::from_c(s) })
+    }
+}
+
+impl StripeNew {
+    /// A writer's io ref put: its open bucket's, at its last pin's put.
+    ///
+    /// # Safety
+    /// The caller has the io ref - claim_bucket()'s, leaked to the open
+    /// bucket's ->ec - and gives it up.
+    pub(crate) unsafe fn put_io(&self) {
+        // SAFETY: the caller's
+        drop(unsafe { IoRef::adopt(self) });
+    }
+
+    /// Whether it has a block on device @dev - or had: BlockDevs.
+    pub(crate) fn has_dev(&self, dev: u32) -> bool {
+        self.internal.block_devs.get().test(dev as usize)
+    }
+}
+
+/// Where @wp's write goes in its stripe's buffer, if one of its open buckets
+/// is a block of a stripe being made: NULL if none is.
+///
+/// # Safety
+/// @wp is a write point, locked.
+#[c_export]
+pub unsafe fn bch2_writepoint_ec_buf(c: &Opaque<c::bch_fs>, wp: &c::write_point) -> *mut c_void {
+    let fs = Fs::from_c(c);
+    // SAFETY: the caller's
+    let wp = unsafe { wp.alloc.lock.held() };
+    // the write point's pins, which its lock keeps
+    let Some((ob, s)) = wp.ptrs.iter(fs).find_map(|ob| Some((ob, ob.stripe()?))) else {
+        return core::ptr::null_mut()
+    };
+
+    let offset = u32::from(ob.ca().mi.get().bucket_size) - ob.sectors_free.get();
+    let mut s = s.lock();
+    let buf = s.new_buf.as_mut().expect("a stripe with blocks claimed has its buffer");
+    // its writer's to write, at its write point's free space
+    buf.block_mut(usize::from(ob.ec_idx.get()))[(offset as usize) << 9..].as_mut_ptr().cast()
+}
+
+
+// ── Waiting for them ─────────────────────────────────────────────────────
+
+impl Fs {
+    /// Sleep until @done, checked with new_stripes locked - so not in the
+    /// sleep's state, as the lock may sleep.
+    fn new_stripes_wait(&self, mut done: impl FnMut(&[StripeNewBox]) -> bool) {
+        loop {
+            let seen = self.ec.new_stripes_changed.snapshot();
+            if done(&self.ec.new_stripes.lock()) {
+                return;
+            }
+            let Ok(()) = self.ec.new_stripes_changed.wait(seen, Sleep::UNINTERRUPTIBLE);
+        }
+    }
+}
+
+impl Fs {
+    /// Wait for every stripe being made to be done with.
+    pub fn ec_flush(&self) {
+        self.new_stripes_wait(|v| v.is_empty())
+    }
+
+    /// Wait for every stripe that had gone in flight - its io refs drained,
+    /// its seq assigned - when we were called to finish committing. Those
+    /// still filling (seq 0) are skipped: they either complete after us, a
+    /// later seq, or get cancelled via their io refs, which we shouldn't
+    /// block on from under state_lock - the caller's own teardown
+    /// (stripe_heads_stop(), say) cancels them before this.
+    pub fn ec_flush_outstanding(&self) {
+        let wait_seq = self.ec.stripe_new_seq.load(Ordering::Relaxed) as u64;
+        self.new_stripes_wait(|v| !v.iter().any(|s| {
+            let seq = s.seq.load(Ordering::Acquire);
+            seq != 0 && seq <= wait_seq
+        }))
+    }
+}
+
+#[c_export]
+pub fn bch2_fs_ec_flush(c: &Opaque<c::bch_fs>) {
+    Fs::from_c(c).ec_flush()
+}
+
+#[c_export]
+pub fn bch2_fs_ec_flush_outstanding(c: &Opaque<c::bch_fs>) {
+    Fs::from_c(c).ec_flush_outstanding()
+}
+
+/// At shutdown, with no stripe being made but the heads': @b, a head's
+/// stripe, taken from it, freed.
+pub(crate) fn head_stripe_free(fs: &Fs, b: StripeNewBox) {
+    fs.ec.new_stripes.lock().release_for_head();
+    discard(b);
+}
+
+// ── To text ──────────────────────────────────────────────────────────────
+
+/// @s: its key, its blocks, and how long it's been being made:
+/// bch2_new_stripe_to_text(). Blocks are listed when handed out, not when
+/// full, so per claimed block: is its bucket still checked out, and how much
+/// room is left?
+#[cold]
+pub(crate) fn new_stripe_to_text(out: &mut Printbuf, fs: &Fs, s: &StripeNew) {
+    let i = s.lock();
+    let v = i.new_stripe.stripe().v();
+    prt!(out, "\tidx {} blocks {}+{} allocated {} ref {} {} {} obs",
+         i.new_stripe.idx(), v.nr_data(), v.nr_redundant,
+         i.blocks[..v.nr_data() as usize].iter().filter(|b| b.allocated()).count(),
+         s.io_refs.load(Ordering::Relaxed), i.watermark, s.state());
+
+    for b in i.blocks[..usize::from(v.nr_blocks)].iter().filter(|b| b.gotten()) {
+        prt!(out, " {}", b.bucket().map_or(0, |ob| ob.idx().get()));
+
+        let Slot::Bucket(StripeBlock::Claimed(ob)) = b else { continue };
+        let bucket_size = u32::from(ob.ca().mi.get().bucket_size);
+        prt!(out, "(pin {} {}/{})", ob.pin.load(Ordering::Relaxed), bucket_size - ob.sectors_free.get(), bucket_size);
+    }
+    out.newline();
+    prt!(out, "{}\n", i.new_stripe.stripe().to_text(fs));
+    prt!(out, "age:\t{}\n", Nsecs(local_clock() - s.start_time));
+}
+
+impl Fs {
+    /// Stripe buffer memory, the stripe heads, and the stripes being made.
+    #[cold]
+    pub fn new_stripes_to_text(&self, out: &mut Printbuf) {
+        let (in_use, limit) = self.stripe_buf_mem();
+        prt!(out, "stripe buf memory: {}/{}\n", HumanReadable(in_use as u64), HumanReadable(limit as u64));
+
+        crate::data::ec::head::stripe_heads_to_text(out, self);
+
+        prt!(out, "in flight:\n");
+        for s in self.ec.new_stripes.lock().iter().filter(|s| s.state() != State::EC_STRIPE_NEW_open) {
+            new_stripe_to_text(out, self, s);
+        }
+    }
+}
diff --git a/fs/bcachefs/data/ec/stripe_new_blocks.rs b/fs/bcachefs/data/ec/stripe_new_blocks.rs
new file mode 100644
index 0000000..e13e9cf
--- /dev/null
+++ b/fs/bcachefs/data/ec/stripe_new_blocks.rs
@@ -0,0 +1,476 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A stripe being made's blocks: their buckets - allocated new, or carried
+//! and moved from an old stripe it reuses (stripe_new_reuse.rs) - and its
+//! slot.
+
+use crate::btree::bkey::{bkey_gt, bpos_max, pos};
+use crate::btree::iter::{is_restart, BtreeIter, BtreeIterFlags, LoopFlow, TransAttempt};
+use crate::c;
+use crate::data::copygc;
+use crate::data::ec::open::OpenStripe;
+use crate::data::ec::stripe::StripeKey;
+use crate::data::ec::stripe_new::{BlockDevsWriter, Internal, InternalGuard, Slot, StripeBlock};
+use crate::data::ec::stripe_new_reuse::{should_reuse_stripe, try_stripe_reuse};
+use crate::data::ec::trigger::ec_stripe_mem_alloc;
+use crate::errcode::{bch_errcode, BchError};
+use crate::fs::Fs;
+use crate::types::Align8U64;
+use crate::util::backref::BackRef;
+use crate::util::bitmap::Bitmap;
+use crate::util::rcu::read_lock;
+use crate::util::vstructs::Validated;
+use core::ffi::c_uint;
+use core::sync::atomic::Ordering;
+
+// ── A new stripe's buckets ───────────────────────────────────────────────
+//
+// A new stripe's blocks are buckets the allocator opens for it, parity
+// first, then data, one at a time - each as near as it can be to the
+// centroid, where the stripe's other blocks are on average as fractions of
+// their devices, so a stripe's blocks are at the same place on each device.
+// Their pins are the stripe's, in blocks[], by block. With too few devices
+// to fill it, a stripe may shrink to the blocks it got.
+
+/// The centroid of @v's blocks so far, those of @blocks that have one:
+/// stripe_blocks_centroid(). 0 for none.
+fn blocks_centroid(fs: &Fs, v: &c::Stripe<Validated>, blocks: &[Slot]) -> u64 {
+    let rcu = read_lock();
+    let (sum, nr) = blocks.iter().enumerate()
+        .filter(|(i, b)| *i < usize::from(v.nr_blocks) && b.gotten())
+        .map(|(i, _)| v.block_ptrs()[i])
+        .filter(|p| u32::from(p.dev()) != c::BCH_SB_MEMBER_INVALID)
+        .filter_map(|p| fs.dev_rcu(p.dev().into(), &rcu).map(|ca| ca.offset_to_frac(p.offset())))
+        .fold((0u64, 0u64), |(sum, nr), f| (sum.wrapping_add(f), nr + 1));
+    if nr != 0 { sum / nr } else { 0 }
+}
+
+/// Blocks @slots of @v, for @want of them, of @data_type, from @stripe's
+/// spreading: one at a time, the centroid moving as they're placed.
+#[allow(clippy::too_many_arguments)]
+fn alloc_blocks(t: &TransAttempt<'_, '_>, req: &mut c::alloc_request, stripe: &mut c::dev_stripe_state,
+                v: &mut c::Stripe<Validated>, blocks: &mut [Slot], block_devs: &BlockDevsWriter,
+                data_type: c::bch_data_type, slots: core::ops::Range<usize>, have: &mut usize)
+    -> Result<(), BchError>
+{
+    let fs = t.fs();
+    while *have < slots.len() {
+        // the caller's, saved: not ours to put
+        req.ptrs.nr = 0;
+        req.nr_replicas = (*have + 1) as u8;
+        req.nr_effective = *have as c_uint;
+        req.data_type = data_type;
+        req.target_frac = blocks_centroid(fs, v, blocks);
+
+        let ret = t.bucket_alloc_set(req, stripe);
+        for ob in req.ptrs.drain(fs) {
+            let j = slots.clone().find(|&j| !blocks[j].gotten()).expect("a block left to fill");
+            req.devs_may_alloc.d.clear(ob.id().dev().into());
+            v.block_ptrs_mut()[j] = ob.ptr();
+            block_devs.add(ob.id().dev().into());
+            blocks[j].fill(StripeBlock::Pinned(ob));
+            *have += 1;
+        }
+        ret?;
+    }
+    Ok(())
+}
+
+/// The buckets @s hasn't got, parity first, @stripes its label's spreading
+/// of them, their lock held: __new_stripe_alloc_buckets(). For erasure
+/// coding, distinct failure domains are a hard requirement, not a
+/// preference: the allocator won't use a device sharing a domain with a
+/// block already placed.
+fn alloc_buckets(t: &TransAttempt<'_, '_>, req: &mut c::alloc_request, stripes: &mut c::DevStripes,
+                 s: &mut InternalGuard<'_>) -> Result<(), BchError> {
+    let fs = t.fs();
+    let (s, block_devs) = s.parts();
+    let v = s.new_stripe.stripe_mut();
+    let (nr_blocks, nr_parity) = (usize::from(v.nr_blocks), usize::from(v.nr_redundant));
+    let nr_data = v.nr_data() as usize;
+
+    req.bits.set_new_stripe_alloc(true);
+    req.bits.set_failure_domains_required(true);
+    // rebuilt from the blocks it has: a request can come twice - a full
+    // stripe, then stripe reuse - and the first's released buckets would
+    // wrongly exclude their devices' domains
+    req.devs_chosen = c::bch_devs_mask::default();
+    // as the sector allocator, which we bypass, would
+    req.devs_may_alloc.d.and(&fs.allocator.rw_devs[c::bch_data_type::BCH_DATA_user.0 as usize].load());
+
+    let (mut have_data, mut have_parity) = (0, 0);
+    for i in (0..nr_blocks).filter(|&i| s.blocks[i].gotten()) {
+        let dev = v.block_ptrs()[i].dev();
+        // a block on a failed or removed device isn't repaired here: that
+        // needs its extents updated, by backpointer
+        if u32::from(dev) != c::BCH_SB_MEMBER_INVALID {
+            req.devs_may_alloc.d.clear(dev.into());
+            // the new blocks away from these' domains
+            req.devs_chosen.d.set(dev.into());
+        }
+        if i < nr_data { have_data += 1 } else { have_parity += 1 }
+    }
+    assert!(have_data <= nr_data && have_parity <= nr_parity,
+            "new stripe with {have_data}/{nr_data} data blocks and {have_parity}/{nr_parity} parity");
+
+    let blocks = &mut s.blocks;
+    alloc_blocks(t, req, &mut stripes.parity_stripe, v, blocks, block_devs, c::bch_data_type::BCH_DATA_parity,
+                 nr_data..nr_blocks, &mut have_parity)?;
+    alloc_blocks(t, req, &mut stripes.block_stripe, v, blocks, block_devs, c::bch_data_type::BCH_DATA_user,
+                 0..nr_data, &mut have_data)
+}
+
+/// Once every block's allocated, the centroid's settled: each new block far
+/// from it - by the mean absolute deviation of the others - tried again,
+/// nearer, and kept if that halves its distance.
+/// Only the new ones: those @had - a reused stripe's, carried over - are
+/// anchors, and those a writer's claimed (Slot::allocated()) can't move. Best
+/// effort, so it never makes things worse: an allocation that fails keeps the
+/// original - but a restart, which ends the attempt.
+fn reallocate_outliers(t: &TransAttempt<'_, '_>, req: &mut c::alloc_request, s: &mut InternalGuard<'_>,
+                       had: &Bitmap) -> Result<(), BchError> {
+    const MAX: usize = c::BCH_BKEY_PTRS_MAX as usize;
+    let fs = t.fs();
+    let (s, block_devs) = s.parts();
+
+    // as device fractions: devices' sizes may differ
+    let mut frac = [None::<u64>; MAX];
+    {
+        let v = s.new_stripe.stripe().v();
+        let rcu = read_lock();
+        for i in (0..MAX).filter(|&i| s.blocks[i].gotten()) {
+            let Some(p) = v.block_ptrs().get(i) else { continue };
+            if u32::from(p.dev()) != c::BCH_SB_MEMBER_INVALID {
+                frac[i] = fs.dev_rcu(p.dev().into(), &rcu).map(|ca| ca.offset_to_frac(p.offset()));
+            }
+        }
+    }
+    let nr = frac.iter().flatten().count() as u64;
+    if nr < 3 {
+        return Ok(());
+    }
+    let mut sum = frac.iter().flatten().fold(0u64, |sum, &f| sum.wrapping_add(f));
+
+    let flags = req.flags;
+    req.flags |= c::bch_write_flags::BCH_WRITE_alloc_nowait;
+    let mut ret = Ok(());
+
+    for i in 0..MAX {
+        let Some(fi) = frac[i] else { continue };
+        if had.test(i) || s.blocks[i].allocated() {
+            continue;
+        }
+
+        // the others' centroid and deviation: one large outlier inflates a
+        // deviation of all of them enough to mask itself
+        let centroid = sum.wrapping_sub(fi) / (nr - 1);
+        let mad = frac.iter().enumerate()
+            .filter_map(|(j, f)| f.filter(|_| j != i))
+            .fold(0u64, |mad, f| mad.wrapping_add(f.abs_diff(centroid))) / (nr - 1);
+        let dist = fi.abs_diff(centroid);
+        if dist <= mad.wrapping_mul(2) {
+            continue;
+        }
+
+        let dev = s.new_stripe.stripe().v().block_ptrs()[i].dev();
+        let Some(ca) = fs.dev_get(dev.into()) else { continue };
+        // nothing nearer, within a bucket
+        if dist <= ca.offset_to_frac(ca.mi.get().bucket_size.into()) {
+            continue;
+        }
+
+        req.target_frac = centroid;
+        let ob = match t.bucket_alloc(req, &ca) {
+            Ok(ob) => ob,
+            Err(e) if is_restart(&e) => {
+                ret = Err(e);
+                break;
+            }
+            Err(_) => continue,
+        };
+        let new_ptr = ob.ptr();
+        let new_frac = ca.offset_to_frac(new_ptr.offset());
+
+        // nothing's written to a new block yet: swapping it is a put and a
+        // new bucket
+        if new_frac.abs_diff(centroid) < dist / 2 {
+            block_devs.add(ob.id().dev().into());
+            let old = core::mem::replace(&mut s.blocks[i], Slot::Bucket(StripeBlock::Pinned(ob)));
+            assert!(matches!(old, Slot::Bucket(_)), "reallocating a stripe block that isn't a new bucket");
+            sum = sum.wrapping_add(new_frac).wrapping_sub(fi);
+            frac[i] = Some(new_frac);
+            s.new_stripe.stripe_mut().block_ptrs_mut()[i] = new_ptr;
+        }
+    }
+
+    req.flags = flags;
+    req.target_frac = 0;
+    ret
+}
+
+/// Whether copygc will run on any of @devs - would free buckets there:
+/// copygc_can_run_on_devs().
+fn copygc_can_run_on_devs(fs: &Fs, devs: &c::bch_devs_mask) -> bool {
+    let _mark = fs.mark_lock().read();
+    let rcu = read_lock();
+    let any = fs.devs_rcu_in(devs.d.iter(), &rcu).any(|ca| copygc::dev_wait_amount(ca).0 <= 0);
+    any
+}
+
+/// Whether @s won't get the rest of its buckets: copygc is what's asking, or
+/// won't run on the devices that had none - which this leaves in
+/// req.devs_may_alloc.
+fn will_not_allocate(fs: &Fs, req: &mut c::alloc_request, s: &Internal) -> bool {
+    req.devs_may_alloc.d.not_and(&s.devs.d);
+
+    req.watermark == c::bch_watermark::BCH_WATERMARK_copygc || !copygc_can_run_on_devs(fs, &req.devs_may_alloc)
+}
+
+/// @s cut down to the blocks it got, of @nr_blocks with @nr_parity: its data
+/// blocks, and the parity it got moved down after them. Past its new
+/// pointers the key is zero: checksums are written at creation.
+fn shrink_to_gotten(s: &mut Internal, nr_blocks: usize, nr_parity: usize) {
+    let old_nr_data = nr_blocks - nr_parity;
+    let parity_gotten = s.blocks[old_nr_data..nr_blocks].iter().filter(|b| b.gotten()).count();
+    let new_nr_data = s.blocks.iter().filter(|b| b.gotten()).count() - parity_gotten;
+    let new_nr_blocks = new_nr_data + parity_gotten;
+
+    // The data blocks it got are a prefix - the old stripe's first, all of
+    // them with their buckets, as they're allocated lowest first - so what's
+    // past them is empty
+    assert!(s.blocks[new_nr_data..old_nr_data].iter().all(|b| matches!(b, Slot::Empty)),
+            "shrinking a new stripe to {new_nr_data} data blocks, with a block past them");
+
+    // down, in order: each to a block that's empty
+    for k in 0..parity_gotten {
+        s.blocks[new_nr_data + k] = core::mem::take(&mut s.blocks[old_nr_data + k]);
+    }
+    assert!(s.blocks[new_nr_blocks..].iter().all(|b| matches!(b, Slot::Empty)),
+            "shrinking a new stripe to {new_nr_blocks} blocks, with a block past them");
+
+    let v = s.new_stripe.stripe_mut();
+    v.block_ptrs_mut().copy_within(old_nr_data..old_nr_data + parity_gotten, new_nr_data);
+    v.block_ptrs_mut()[new_nr_blocks..].fill(c::bch_extent_ptr::from_bits(Align8U64(0)));
+    v.nr_blocks = new_nr_blocks as u8;
+    v.nr_redundant = parity_gotten as u8;
+
+    let mut devs = c::bch_devs_list::default();
+    for (b, p) in s.blocks.iter().zip(v.block_ptrs()) {
+        let ob_dev = b.bucket().map(|b| u32::from(b.id().dev()));
+        assert!(ob_dev.is_none_or(|d| d == u32::from(p.dev())), "a shrunk stripe's block not on its bucket's device");
+        assert!(!devs.has(p.dev()), "a shrunk stripe with two blocks on device {}", p.dev());
+        devs.add(p.dev());
+    }
+}
+
+/// The buckets @s hasn't got, @dev_stripe its label's spreading of them:
+/// new_stripe_alloc_buckets(). With @may_shrink, if the devices it needs are
+/// full and copygc won't free buckets there, a stripe that got enough
+/// shrinks to what it got - else it's stripe_insufficient_devices, for the
+/// write to fall back to replication. The request's left as it was.
+pub(crate) fn new_stripe_alloc_buckets(t: &TransAttempt<'_, '_>, req: &mut c::alloc_request,
+                                       dev_stripe: &c::ec_dev_stripe_state, s: &mut InternalGuard<'_>,
+                                       may_shrink: bool)
+    -> Result<(), BchError>
+{
+    let fs = t.fs();
+    let gotten = |s: &Internal, n: usize| s.blocks[..n].iter().filter(|b| b.gotten()).count();
+    let (nr_blocks, nr_parity) = {
+        let v = s.new_stripe.stripe().v();
+        (usize::from(v.nr_blocks), usize::from(v.nr_redundant))
+    };
+    if gotten(s, nr_blocks) == nr_blocks {
+        return Ok(());
+    }
+
+    let had = s.gotten();
+    let mut shrunk = false;
+    let saved = t.alloc_zeroed::<ReqSaved>()?;
+    saved.save(req);
+
+    req.devs_may_alloc = s.devs;
+    if req.watermark == c::bch_watermark::BCH_WATERMARK_copygc {
+        req.flags |= c::bch_write_flags::BCH_WRITE_alloc_nowait;
+    }
+
+    let mut ret = dev_stripe.lock.lock_trans(t).and_then(|mut g| alloc_buckets(t, req, g.protected(), s));
+
+    // as C's: the errors themselves, not their classes
+    let blocked = BchError::from(bch_errcode::BCH_ERR_bucket_alloc_blocked);
+    let full = ret.err()
+        .filter(|&e| may_shrink && (e == blocked || e == BchError::from(bch_errcode::BCH_ERR_freelist_empty)))
+        .filter(|_| will_not_allocate(fs, req, s));
+    if let Some(err) = full {
+        let moving = s.blocks.iter().filter(|b| b.moving()).count();
+        // a data block at least, unless a block's being moved - and two, or
+        // replication does better
+        let need = moving + nr_parity + usize::from(moving == 0) + usize::from(s.old_block_map().is_empty());
+
+        if s.blocks.iter().filter_map(Slot::bucket).count() >= need {
+            shrink_to_gotten(s, nr_blocks, nr_parity);
+            ret = Ok(());
+            shrunk = true;
+        } else {
+            if err == blocked {
+                fs.alloc_waiters_unpark();
+            }
+            ret = fs.throw(bch_errcode::BCH_ERR_stripe_insufficient_devices);
+        }
+    }
+
+    // not after shrinking, which moved blocks under @had: and a stripe we
+    // could barely allocate has no spare buckets to do better with
+    if ret.is_ok() && !shrunk && gotten(s, nr_blocks) == nr_blocks {
+        ret = reallocate_outliers(t, req, s, &had);
+    }
+
+    saved.restore(req);
+    req.target_frac = 0;
+    ret
+}
+
+/// What new_stripe_alloc_buckets() changes in the caller's request, to put
+/// back: in the transaction's memory, not the stack - the mask is a bit per
+/// member, and this is the bottom of a write path.
+#[derive(::pin_init::Zeroable)]
+struct ReqSaved {
+    flags:          c::bch_write_flags,
+    data_type:      c::bch_data_type,
+    ptrs:           c::open_buckets,
+    nr_replicas:    u8,
+    nr_effective:   c_uint,
+    devs_may_alloc: c::bch_devs_mask,
+}
+
+impl ReqSaved {
+    fn save(&mut self, req: &c::alloc_request) {
+        self.flags          = req.flags;
+        self.data_type      = req.data_type;
+        self.ptrs           = req.ptrs;
+        self.nr_replicas    = req.nr_replicas;
+        self.nr_effective   = req.nr_effective;
+        self.devs_may_alloc = req.devs_may_alloc;
+    }
+
+    fn restore(&self, req: &mut c::alloc_request) {
+        req.flags          = self.flags;
+        req.data_type      = self.data_type;
+        req.ptrs           = self.ptrs;
+        req.nr_replicas    = self.nr_replicas;
+        req.nr_effective   = self.nr_effective;
+        req.devs_may_alloc = self.devs_may_alloc;
+    }
+}
+
+/// A new stripe's key in @buf: @nr_data and @nr_parity blocks of @sectors,
+/// in @disk_label, by @algorithm - ec_stripe_key_init(). Its can_widen is
+/// against the label's RW members, so a new stripe - a repair's replacement
+/// too - is one widening finds, not stuck at 0 until a stripes scan or fsck
+/// visits it. Checksums are per encoded_extent_max, or coarser if that's too
+/// many for a key.
+pub(crate) fn new_stripe_key(fs: &Fs, key: &mut StripeKey, algorithm: u8, nr_data: u8, nr_parity: u8, sectors: u16,
+                             disk_label: u8) {
+    let mut v = c::Stripe::default();
+    v.sectors = sectors.into();
+    v.bits.set_algorithm(algorithm);
+    v.nr_blocks = nr_data + nr_parity;
+    v.nr_redundant = nr_parity;
+    v.csum_granularity_bits = (fs.opts().encoded_extent_max >> 9).ilog2() as u8;
+    v.csum_type = c::bch_csum_type::BCH_CSUM_crc32c.0 as u8;
+    v.disk_label = disk_label;
+    let can_widen = v.want_can_widen(fs.ec_rw_member_devs_nr(disk_label, sectors),
+                                     fs.opts().ec_max_data_blocks.into());
+    v.bits.set_can_widen(can_widen);
+
+    while v.val_u64s() as usize > c::BKEY_VAL_U64s_MAX {
+        assert!(1u32 << v.csum_granularity_bits < u32::from(sectors) && v.csum_granularity_bits != u8::MAX,
+                "a new stripe of {sectors} sectors too big for a key, at checksum granularity {}",
+                v.csum_granularity_bits);
+        v.csum_granularity_bits += 1;
+    }
+    key.init(&v);
+}
+
+// ── A new stripe ─────────────────────────────────────────────────────────
+
+/// A slot for @s's new stripe - the first free one from the hint, wrapping
+/// round once - held open, its slot_claim, and its key put there, with gc's
+/// copy allocated. ENOSPC_stripe_create if none's free below U32_MAX.
+///
+/// XXX: we're going to need a bitrange btree of free stripes
+pub(crate) fn stripe_idx_alloc(t: &TransAttempt<'_, '_>, s: &mut Internal) -> Result<(), BchError> {
+    let fs = t.fs();
+    let min_pos = pos(0, 1);
+    let mut start = bpos_max(min_pos, pos(0, fs.ec.stripe_hint.load(Ordering::Relaxed)));
+
+    let mut iter = BtreeIter::new(t, c::btree_id::stripes, start, BtreeIterFlags::SLOTS | BtreeIterFlags::INTENT);
+    iter.for_each_norestart(t, |iter, k| {
+        fs.ec.stripe_hint.store(iter.pos().offset, Ordering::Relaxed);
+
+        if bkey_gt(k.k.p, pos(0, u32::MAX.into())) {
+            if start == min_pos {
+                return fs.throw(bch_errcode::BCH_ERR_ENOSPC_stripe_create);
+            }
+            start = min_pos;
+            return Ok(LoopFlow::ContinueFrom(min_pos));
+        }
+
+        if k.k.is_deleted() {
+            if let Some(h) = OpenStripe::tryget(fs, k.k.p.offset)? {
+                ec_stripe_mem_alloc(t, iter)?;
+                assert!(s.slot_claim.is_none(), "a stripe being made with two slots");
+                s.slot_claim = Some(h.into_claim());
+                s.new_stripe.k_mut().p = iter.pos();
+                return Ok(LoopFlow::Break(()));
+            }
+        }
+        Ok(LoopFlow::Continue)
+    })
+}
+
+/// @s's buckets: a full stripe of new ones if they can be had without
+/// waiting; else packed into an old stripe, and the rest waited for - the
+/// stripe shrunk to what it got, if they can't be had. Packed first, where
+/// devices are low on space.
+fn alloc_or_reuse_buckets(t: &TransAttempt<'_, '_>, req: &mut c::alloc_request, dev_stripe: &c::ec_dev_stripe_state,
+                          s: &mut InternalGuard<'_>) -> Result<(), BchError> {
+    if s.reuse.is_none() && should_reuse_stripe(t.fs(), s) {
+        try_stripe_reuse(t, s)?;
+    }
+
+    let saved = (req.watermark, req.flags);
+    req.watermark = c::bch_watermark::BCH_WATERMARK_stripe;
+    req.flags |= c::bch_write_flags::BCH_WRITE_alloc_nowait;
+    let ret = new_stripe_alloc_buckets(t, req, dev_stripe, s, false);
+    (req.watermark, req.flags) = saved;
+
+    match ret {
+        Err(e) if !is_restart(&e) && !e.matches(c::ENOMEM) => {}
+        ret => return ret,
+    }
+
+    if s.reuse.is_none() {
+        try_stripe_reuse(t, s)?;
+    }
+    new_stripe_alloc_buckets(t, req, dev_stripe, s, true)
+}
+
+/// @s, unless it is already: a slot, buckets from @dev_stripe, the disk
+/// reservation for its parity, and its buckets in the table of new stripes'.
+pub(crate) fn stripe_alloc_or_reuse(t: &TransAttempt<'_, '_>, req: &mut c::alloc_request,
+                                    dev_stripe: &c::ec_dev_stripe_state, s: &mut InternalGuard<'_>,
+                                    stripe_fs: &BackRef<Fs>) -> Result<(), BchError> {
+    if s.slot_claim.is_none() {
+        stripe_idx_alloc(t, s)?;
+    }
+    alloc_or_reuse_buckets(t, req, dev_stripe, s)?;
+
+    if s.res.as_ref().is_none_or(|r| r.sectors() == 0) {
+        // NOFAIL: it doesn't fail
+        let _ = s.reserve_parity(stripe_fs, c::bch_reservation_flags::BCH_DISK_RESERVATION_NOFAIL);
+    }
+
+    s.buckets_add(t.fs())?;
+    s.allocated = true;
+    Ok(())
+}
diff --git a/fs/bcachefs/data/ec/stripe_new_reuse.rs b/fs/bcachefs/data/ec/stripe_new_reuse.rs
new file mode 100644
index 0000000..83ce1b6
--- /dev/null
+++ b/fs/bcachefs/data/ec/stripe_new_reuse.rs
@@ -0,0 +1,251 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A stripe being made's old stripe, which it reuses - Reuse - and finding
+//! one to reuse.
+//!
+//! A new stripe can be packed into an old one instead of being cut whole from
+//! new buckets: where the devices are low on space, or a full stripe of new
+//! buckets can't be had. The stripe lru has the stripes with the most room -
+//! empty data blocks, and blocks they could be widened by - first. The old
+//! stripe's live data blocks come forward: carried, in place, if their device
+//! is good, moved to a new bucket if not. Its empty blocks and its parity are
+//! left behind, and new buckets fill out the rest.
+//!
+//! The old stripe is held open from when it's picked - its Reuse's claim,
+//! put by the new stripe's teardown - so the stripe trigger and other
+//! reusers stay off it. Its blocks are read, and the carried ones folded into
+//! the new stripe, by the new stripe's task: stripe_new_tasks.rs.
+//!
+//! A repair's rebuild reuses the stripe it replaces the same way, with every
+//! data block it can keep carried or moved: repair.rs.
+
+use crate::alloc::lru::{LruId, LruPos};
+use crate::btree::bkey::{pos, BkeySC, BkeyV, BkeyVMut};
+use crate::btree::iter::{is_restart, BtreeIter, BtreeIterFlags, CommitFlags, TransAttempt, UpdateTriggerFlags};
+use crate::c;
+use crate::data::ec::buf::{blocks_in, StripeBuf};
+use crate::data::ec::open::{OpenStripe, StripeClaim};
+use crate::data::ec::repair::StripeBlocks;
+use crate::data::ec::stripe::{StripeKey, STRIPE_LRU_POS_EMPTY};
+use crate::data::ec::stripe_new::{Internal, Slot};
+use crate::errcode::{bch_errcode, BchError};
+use crate::fs::Fs;
+use crate::util::alloc::{kbox_into_inner, kbox_pin_init, KBox};
+use crate::util::vstructs::Validated;
+use core::ops::ControlFlow;
+use core::pin::Pin;
+use pin_init::{init, init_zeroed, Init};
+
+/// The old stripe a stripe being made reuses - a stripe it's packed into, or
+/// the one a repair rebuilds: held open, its key, and its buffer, which the
+/// carried blocks are folded in from. Which of its blocks come forward is in
+/// the new stripe's slots - Slot::Carried and Moving.
+///
+/// Boxed: it's mostly the key, kilobytes, and Some(Reuse) made by value would
+/// be a copy through the stack of the allocation path. The box is only there
+/// because pin-init can't initialize an Option in place.
+pub(crate) struct Reuse {
+    pub(crate) stripe: StripeKey,
+    /// The old stripe held open: put with the stripe being made
+    open:              StripeClaim,
+    pub(crate) buf:    Option<KBox<StripeBuf>>,
+    pub(crate) read:   OldRead,
+}
+
+/// What's been read of the old stripe.
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) enum OldRead {
+    /// Nothing, and no buffer for it yet
+    NoBuf,
+    /// Its buffer's allocated: the task reads it, and folds the carried
+    /// blocks in
+    ToRead,
+    /// Every block's in its buffer, read: a repair's, which carried them
+    Read,
+}
+
+impl Reuse {
+    /// @old, held open by @open: nothing of it read yet - or the claim
+    /// back, for the caller to put, if it can't be allocated.
+    pub(crate) fn new(old: BkeySC<'_, c::Stripe<Validated>>, open: StripeClaim)
+        -> Result<KBox<Self>, StripeClaim>
+    {
+        // the initializer runs only once there's memory for it: until then
+        // the claim's ours to give back
+        let mut open = Some(open);
+        let claim = &mut open;
+        let init = init!(Reuse {
+            stripe <- init_zeroed(),
+            open:   claim.take().expect("a claim, taken once"),
+            buf:    None,
+            read:   OldRead::NoBuf,
+        }? BchError).chain(|r| {
+            r.stripe.set(old);
+            Ok(())
+        });
+        match kbox_pin_init(init) {
+            Ok(r) => Ok(Pin::into_inner(r)),
+            Err(_) => Err(open.expect("a claim the initializer didn't run to take")),
+        }
+    }
+
+    pub(crate) fn put(self: KBox<Self>, fs: &Fs) {
+        let Reuse { open, .. } = kbox_into_inner(self);
+        open.put(fs);
+    }
+}
+
+// ── Finding one ───────────────────────────────────────────────────────────
+
+/// Whether @s may be packed into @old, @b its blocks: the same disk label,
+/// algorithm, redundancy and size; room for one new block past its live ones;
+/// and, the devices of the blocks it would carry taken out of @s's, more
+/// devices left than parity blocks. may_reuse_stripe().
+fn may_reuse_stripe(s: &Internal, old: &c::Stripe<Validated>, b: StripeBlocks) -> bool {
+    let new = s.new_stripe.stripe().v();
+    if old.disk_label != new.disk_label ||
+       old.bits.algorithm() != new.bits.algorithm() ||
+       old.nr_redundant != new.nr_redundant ||
+       old.sectors != new.sectors {
+        return false;
+    }
+
+    let mut devs = s.devs;
+    for i in blocks_in(b.live & !b.bad) {
+        devs.d.clear(old.block_ptrs()[i].dev().into());
+    }
+
+    b.live.count_ones() < new.nr_data() && devs.d.weight() > new.nr_redundant.into()
+}
+
+/// Stripe @idx, if @s may be packed into it: opened, with its key, as @s's
+/// Reuse - and its blocks. None if it's gone - the lru races with the write
+/// buffer - can't be reused, or is open already. get_old_stripe().
+///
+/// An empty one that isn't open is deleted, and one whose can_widen is too
+/// high is demoted: each a commit, and transaction_restart_commit, for the
+/// caller's walk to pick up from.
+fn get_old_stripe(t: &TransAttempt<'_, '_>, s: &mut Internal, idx: u64)
+    -> Result<Option<StripeBlocks>, BchError>
+{
+    let fs = t.fs();
+    // intent locked until it's open: the stripe trigger deletes empty
+    // stripes that aren't open, and can't open them
+    let mut iter = BtreeIter::new(t, c::btree_id::stripes, pos(0, idx),
+                                  BtreeIterFlags::INTENT | BtreeIterFlags::NOPRESERVE);
+    let (iter, k) = iter.peek_slot_shared(t)?;
+    let Some(old) = k.arm::<c::Stripe>() else { return Ok(None) };
+    let v = old.v();
+
+    if v.lru_pos() == STRIPE_LRU_POS_EMPTY {
+        // the trigger doesn't always delete them: a stripe may still have
+        // been open when the last of its data went
+        if fs.stripe_is_open(idx) {
+            return Ok(None);
+        }
+        t.delete_at(iter, UpdateTriggerFlags::empty())?;
+        return t.commit_lazy(None, CommitFlags::NO_ENOSPC).map(|()| None);
+    }
+
+    // A can_widen gone stale-high - its label's RW members shrank since the
+    // last stripes scan - would keep a stripe that can't be widened at the
+    // front of the lru, ahead of real candidates. Only demoted here:
+    // promotion, devices added or going RW, is the scan's. Against the RW
+    // members online or not, as the scan's is, so devices coming and going
+    // don't churn every stripe's.
+    let want = v.want_can_widen(fs.ec_rw_member_devs_nr(v.disk_label, v.sectors.get()),
+                                fs.opts().ec_max_data_blocks.into());
+    if v.can_widen() > want {
+        t.bkey_make_mut(iter, old, UpdateTriggerFlags::empty())?.v_mut().bits.set_can_widen(want);
+        return t.commit_lazy(None, CommitFlags::NO_ENOSPC).map(|()| None);
+    }
+
+    let b = StripeBlocks::get(fs, old)?;
+    if !may_reuse_stripe(s, v, b) {
+        return Ok(None);
+    }
+    let Some(h) = OpenStripe::tryget_existing(t, iter)? else { return Ok(None) };
+    assert!(s.reuse.is_none(), "a stripe being made with two old stripes");
+    match Reuse::new(old, h.into_claim()) {
+        Ok(r) => s.reuse = Some(r),
+        Err(claim) => {
+            claim.put(fs);
+            return fs.throw(bch_errcode::BCH_ERR_ENOMEM_ec_new_stripe_alloc);
+        }
+    }
+    Ok(Some(b))
+}
+
+/// Lay @s out from its old stripe: data blocks in @carry come forward in
+/// place, data blocks in @move_ get new buckets, any other block is left
+/// behind - and the buckets @s had are put, as they may clash with the old
+/// stripe's. A repair may carry every data block; reuse leaves room for a new
+/// one.
+pub(crate) fn init_new_stripe_from_old(s: &mut Internal, carry: u32, move_: u32, repair: bool) {
+    let old_stripe = s.reuse.as_ref().expect("a new stripe laid out from an old one it doesn't have").stripe.stripe();
+    let new = s.new_stripe.stripe().v();
+    let (nr_blocks, nr_data) = (usize::from(new.nr_blocks), new.nr_data());
+    assert_eq!(old_stripe.v().nr_redundant, new.nr_redundant, "a new stripe from an old one of other redundancy");
+    debug_assert!(carry & move_ == 0, "blocks {:#x} both carried and moved", carry & move_);
+
+    for b in &mut s.blocks[..nr_blocks] {
+        assert!(matches!(b, Slot::Empty | Slot::Bucket(_)), "a new stripe laid out from an old one twice");
+        *b = Slot::Empty;
+    }
+
+    for (j, i) in blocks_in(carry | move_).enumerate() {
+        let b = old_stripe.data_block(i).unwrap_or_else(|| {
+            let idx = old_stripe.k.p.offset;
+            panic!("a new stripe laid out from block {i} of stripe {idx}, not one of its data blocks")
+        });
+        assert!(j as u32 + 1 + u32::from(!repair) <= nr_data,
+                "a new stripe of {nr_data} data blocks, from {} of an old one", j + 1);
+
+        let old = b.idx();
+        s.blocks[j] = if carry & 1 << i != 0 { Slot::Carried { old } } else { Slot::Moving { old, bucket: None } };
+        s.new_stripe.stripe_mut().block_ptrs_mut()[j] = b.ptr();
+    }
+}
+
+/// Pack @s into the first stripe in the stripe lru it may be packed into:
+/// stripe_alloc_blocked if there's none.
+fn stripe_reuse(t: &TransAttempt<'_, '_>, s: &mut Internal) -> Result<(), BchError> {
+    let fs = t.fs();
+    let lru = LruPos::range(LruId::Stripes);
+    let mut iter = BtreeIter::new(t, c::btree_id::lru, lru.start().to_bpos(), BtreeIterFlags::empty());
+    let found = iter.for_each_max_norestart(t, lru.end().to_bpos(), |_, k| {
+        Ok(match get_old_stripe(t, s, k.k.p.offset)? {
+            Some(b) => ControlFlow::Break(Some(b)),
+            None    => ControlFlow::Continue(()),
+        })
+    })?;
+
+    let Some(b) = found else { return fs.throw(bch_errcode::BCH_ERR_stripe_alloc_blocked) };
+    init_new_stripe_from_old(s, b.live & !b.bad, b.live & b.bad, false);
+    Ok(())
+}
+
+/// stripe_reuse(), which is an optimization: what can't be reused can be
+/// allocated. Only an error that means allocating can't work either - a
+/// restart, going read-only - is returned.
+pub(crate) fn try_stripe_reuse(t: &TransAttempt<'_, '_>, s: &mut Internal) -> Result<(), BchError> {
+    match stripe_reuse(t, s) {
+        Err(e) if is_restart(&e) || e.matches(c::EROFS) => Err(e),
+        _ => Ok(()),
+    }
+}
+
+/// Whether @s should be packed into an old stripe before trying for buckets:
+/// if it can't have its nr_blocks on devices that aren't low on space, a new
+/// stripe could only come out of space that is about to be scarce.
+/// ec_should_reuse_stripe(). Where every device is a member of every stripe,
+/// one device short of room is enough.
+///
+/// low_on_space, not wants_space: the latter is exactly copygc's own trigger,
+/// so gating on it would mean we only start packing once copygc already has
+/// work - work made of the half-empty stripes we would not have cut.
+pub(crate) fn should_reuse_stripe(fs: &Fs, s: &Internal) -> bool {
+    let mut avail = s.devs;
+    avail.d.andnot(&fs.copygc.low_on_space.load());
+    avail.d.weight() < s.new_stripe.stripe().v().nr_blocks.into()
+}
diff --git a/fs/bcachefs/data/ec/stripe_new_tasks.rs b/fs/bcachefs/data/ec/stripe_new_tasks.rs
new file mode 100644
index 0000000..15fa63c
--- /dev/null
+++ b/fs/bcachefs/data/ec/stripe_new_tasks.rs
@@ -0,0 +1,438 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A stripe being made's task: folding in an old stripe's carried blocks,
+//! waiting to be in flight, creating the stripe, and tearing it down - see
+//! stripe_new.rs.
+
+use crate::alloc::capacity::DiskReservation;
+use crate::btree::bkey::{BkeyI, BkeySC, BkeyV};
+use crate::btree::iter::{commit_do, trans_commit_do, BtreeIter, BtreeIterFlags, CommitFlags, CommitOpts, TransAttempt,
+                         UpdateTriggerFlags, Watermark};
+use crate::c;
+use crate::data::ec::buf::{blocks_good, blocks_in, generate_checksums, generate_ec, validate_msg, StripeBuf, POST, PRE};
+use crate::data::ec::delete::stripe_delete;
+use crate::data::ec::io::BlockIo;
+use crate::data::ec::repair::record_lost_blocks;
+use crate::data::ec::stripe::{StripeKey, MAX_BLOCKS};
+use crate::data::ec::stripe_new::{new_stripes_take, Internal, StripeNew};
+use crate::data::ec::stripe_new_reuse::{OldRead, Reuse};
+use crate::data::ec::update::{create_watermark, stripe_update_extents};
+use crate::errcode::{bch_errcode, BchError};
+use crate::fs::Fs;
+use crate::sb::counters::events;
+use crate::sb::members::DevIoRef;
+use crate::util::alloc::KBox;
+use crate::util::backref::BackRef;
+use crate::util::rcu::read_lock;
+use crate::util::refcount::Refcount;
+use crate::util::task::{Resumable, Resume};
+use crate::util::vstructs::Validated;
+use crate::{bch_err, btree_trans, fs_inconsistent, inode_opts, logged_ops, prt};
+use arrayvec::ArrayVec;
+use core::ptr::NonNull;
+use pin_init::{init, init_zeroed, stack_pin_init, Init};
+
+// ── Its task ─────────────────────────────────────────────────────────────
+
+/// The old stripe's read, failed: its error, and the carried blocks it cost
+/// us - the data the failure lost.
+struct OldStripeLost {
+    err:    BchError,
+    blocks: u32,
+}
+
+pub(crate) async fn stripe_task(fs: &Fs, p: BackRef<StripeNew>) {
+    let at = Resume::Queue(&fs.ec.stripe_create_wq);
+    stack_pin_init!(let w = Working::new());
+    let w = w.get_mut();
+
+    let s: &StripeNew = &p;
+
+    // set before its start, by its head or repair
+    let to_read = s.lock().reuse.as_ref().is_some_and(|r| r.read == OldRead::ToRead);
+    let fold = if to_read { old_stripe_fold(fs, s, w, at).await } else { Ok(()) };
+
+    s.in_flight.wait().resume_on(at).await;
+
+    // As C's, whatever state writes are in: a stripe goes in flight while
+    // they're stopped too - bch2_open_buckets_stop(), in
+    // __bch2_fs_read_only(), puts the last buckets of full stripes after
+    // c->writes is drained.
+    let _w = fs.writes.get();
+
+    let ret = create(fs, s, w, fold, at).await;
+    create_done(fs, s, ret);
+    // SAFETY: in flight
+    unsafe { teardown(fs, p) };
+}
+
+/// Only the blocks we carry forward have to be good - everything else in the
+/// old stripe is discarded at the fold, parity included, and regenerated at
+/// create.
+fn old_stripe_required(s: &Internal) -> u32 {
+    s.old_block_map().iter().fold(0, |m, &b| m | 1 << b)
+}
+
+/// The old stripe's blocks we're carrying forward, in @old, checked out: take
+/// them - their buffers swapped into the new stripe's, whose carried slots
+/// are no writer's, as they're Slot::Carried or Moving.
+pub(crate) fn old_stripe_carry(s: &mut Internal, old: &mut StripeBuf) {
+    let map = s.old_block_map();
+    let new = s.new_buf.as_mut().expect("a new stripe's buffer");
+    assert_eq!((new.offset, new.size), (old.offset, old.size),
+               "carrying blocks between stripe buffers of other sizes");
+
+    for (i, &j) in map.iter().enumerate() {
+        core::mem::swap(&mut new.data[i], &mut old.data[usize::from(j)]);
+    }
+}
+
+/// Fold the blocks we're carrying forward into the new stripe as soon as the
+/// old stripe's read lands, instead of at create: ec_old_stripe_read() and
+/// ec_old_stripe_fold(). The carried blocks are Slot::Carried or Moving, so
+/// the sector allocator will never hand one to a writer, and the data we
+/// swap in can't be overwritten while the rest of the stripe fills.
+///
+/// Only the carried blocks are read. If one of them is bad, the rest are
+/// read so it can be reconstructed: then the old stripe's validated,
+/// reconstructing what's bad if it can be, and its blocks carried - or the
+/// ones we wanted that are lost said, for create to record damage against.
+async fn old_stripe_fold(fs: &Fs, s: &StripeNew, w: &mut Working, at: Resume<'_>) -> Result<(), OldStripeLost> {
+    // The old stripe, its key and buffer, to read with across the awaits;
+    // back after
+    let required = {
+        let mut i = s.lock();
+        core::mem::swap(&mut w.reuse, &mut i.reuse);
+        old_stripe_required(&i)
+    };
+
+    let r = w.reuse.as_deref_mut().expect("a stripe it reuses");
+    let buf = r.buf.as_mut().expect("the old stripe's buffer");
+    let ret = old_stripe_read(fs, &r.stripe, buf, required, at).await;
+
+    let mut i = s.lock();
+    if ret.is_ok() {
+        old_stripe_carry(&mut i, buf);
+    }
+    core::mem::swap(&mut w.reuse, &mut i.reuse);
+    ret
+}
+
+/// The old stripe's @required blocks, into @buf - and the rest if one's bad,
+/// to reconstruct it: whether they're good.
+async fn old_stripe_read(fs: &Fs, old: &StripeKey, buf: &mut StripeBuf, required: u32, at: Resume<'_>)
+    -> Result<(), OldStripeLost>
+{
+    let all = ((1u64 << old.stripe().v().nr_blocks) - 1) as u32;
+
+    {
+        stack_pin_init!(let io = BlockIo::read(fs, buf));
+        for i in blocks_in(required) {
+            io.as_mut().submit(old.stripe(), i);
+        }
+        io.as_mut().wait(at).await;
+    }
+
+    if !blocks_good(old.stripe(), buf, required) {
+        {
+            stack_pin_init!(let io = BlockIo::read(fs, buf));
+            for i in blocks_in(all & !required) {
+                io.as_mut().submit(old.stripe(), i);
+            }
+            io.as_mut().wait(at).await;
+        }
+
+        if let Err(err) = validate_msg(fs, old.stripe(), buf, true, required, c"ec_old_stripe_read_done") {
+            // Reconstruct either couldn't run - too many failures, so
+            // everything that failed to read is lost - or ran and left blocks
+            // that still don't check out:
+            let e = if err == BchError::from(bch_errcode::BCH_ERR_stripe_reconstruct_insufficient_blocks) { PRE } else { POST };
+            return Err(OldStripeLost { err, blocks: buf.failed_mask(e) & required });
+        }
+    }
+    Ok(())
+}
+
+/// Whether a device of @v's is being removed.
+fn stripe_has_removing_dev(fs: &Fs, v: &c::Stripe<Validated>) -> bool {
+    let rcu = read_lock();
+    v.block_ptrs().iter().any(|p| fs.dev_rcu(p.dev().into(), &rcu).is_some_and(|ca| ca.removing()))
+}
+
+/// The new stripe's key, to commit: its reconcile state set, and no key at
+/// its slot already.
+fn stripe_key_update(t: &TransAttempt<'_, '_>, k: BkeySC<'_, c::Stripe<Validated>>) -> Result<(), BchError> {
+    let fs = t.fs();
+    let mut new = t.bkey_make_mut_noupdate(k)?;
+
+    let opts = inode_opts::get_fs(fs, false);
+    new.set_needs_reconcile(t, None, &opts, c::set_needs_reconcile_ctx::SET_NEEDS_RECONCILE_foreground, 0)?;
+
+    let mut iter = BtreeIter::new(t, c::btree_id::stripes, k.k.p, BtreeIterFlags::INTENT);
+    let old = iter.peek_slot(t)?.expect("a slot always has a key");
+    if old.k.type_ != 0 {
+        fs_inconsistent!(fs, "error creating stripe: got existing key\n{}", old.to_text(fs));
+        return fs.throw(bch_errcode::BCH_ERR_EINVAL_ec_stripe_create_existing_key);
+    }
+    t.update(&iter, &new, UpdateTriggerFlags::empty())
+}
+
+/// What the task works on: its stripe's keys and buffers, and what create
+/// needs of its internal state - out from under its lock, for the IO, which
+/// is awaited, and back after. The task's own, made in place: see the file
+/// comment.
+struct Working {
+    new_stripe:      StripeKey,
+    new_buf:         Option<KBox<StripeBuf>>,
+    reuse:           Option<KBox<Reuse>>,
+    res:             Option<DiskReservation<'static>>,
+    /// The new blocks moved from the old stripe, to be written
+    moving:          c::StripeBlockMask,
+    old_block_map:   ArrayVec<u8, MAX_BLOCKS>,
+    allocated:       bool,
+    watermark:       c::bch_watermark,
+}
+
+impl Working {
+    /// Nothing yet: the fold and take() fill it.
+    fn new() -> impl Init<Self> {
+        init!(Working {
+            new_stripe      <- init_zeroed(),
+            new_buf:        None,
+            reuse:          None,
+            res:            None,
+            moving          <- init_zeroed(),
+            old_block_map:  ArrayVec::new(),
+            allocated:      false,
+            watermark       <- init_zeroed(),
+        })
+    }
+
+    /// @i's, out from under its lock: its keys copied, and what it says of
+    /// them; its buffers and reservation swapped in.
+    fn take(&mut self, i: &mut Internal) {
+        self.new_stripe.copy_from(&i.new_stripe);
+        self.moving          = Default::default();
+        for (j, b) in i.blocks.iter().enumerate() {
+            if b.moving() {
+                self.moving.set(j);
+            }
+        }
+        self.old_block_map   = i.old_block_map();
+        self.allocated       = i.allocated;
+        self.watermark       = i.watermark;
+        self.swap(i);
+    }
+
+    /// Back to @i: the new key, as create edited it, and the buffers and
+    /// what's left of the reservation.
+    fn put_back(&mut self, i: &mut Internal) {
+        i.new_stripe.copy_from(&self.new_stripe);
+        self.swap(i);
+    }
+
+    fn swap(&mut self, i: &mut Internal) {
+        core::mem::swap(&mut self.new_buf, &mut i.new_buf);
+        core::mem::swap(&mut self.reuse, &mut i.reuse);
+        core::mem::swap(&mut self.res, &mut i.res);
+    }
+}
+
+/// Data buckets of the new stripe all written: create the stripe, with the
+/// device io refs it'll make references to - guarding against racing with
+/// device removal.
+async fn create(fs: &Fs, s: &StripeNew, w: &mut Working, fold: Result<(), OldStripeLost>, at: Resume<'_>)
+    -> Result<(), BchError>
+{
+    w.take(&mut s.lock());
+    let ret = create_iorefs(fs, s, w, fold, at).await;
+    w.put_back(&mut s.lock());
+    ret
+}
+
+async fn create_iorefs(fs: &Fs, s: &StripeNew, w: &mut Working, fold: Result<(), OldStripeLost>,
+                       at: Resume<'_>) -> Result<(), BchError> {
+    // Kept by device, not by c->devs[idx]: dev_remove may clear that slot
+    // while our io ref still pins the device.
+    let mut cas: ArrayVec<DevIoRef<c::bch_dev_write_ref>, MAX_BLOCKS> = ArrayVec::new();
+    for ptr in w.new_stripe.stripe().v().block_ptrs() {
+        let Some(ca) = fs.dev_get_ioref::<c::bch_dev_write_ref>(ptr.dev().into()) else {
+            return fs.throw(bch_errcode::BCH_ERR_stripe_create_device_offline);
+        };
+        cas.push(ca);
+    }
+
+    create_with_iorefs(fs, s, w, fold, at).await
+}
+
+async fn create_with_iorefs(fs: &Fs, s: &StripeNew, w: &mut Working, fold: Result<(), OldStripeLost>,
+                            at: Resume<'_>) -> Result<(), BchError>
+{
+    if let Some(e) = s.err.get() {
+        if !e.matches(c::EROFS) {
+            bch_err!(fs, "error creating stripe: error writing data buckets");
+        }
+        return Err(e);
+    }
+
+    // bch2_dev_remove() sets ->removing before its data drop, then flushes
+    // outstanding creates, so checking before we commit is enough. Only the
+    // new key's pointers matter: blocks being moved off the device get fresh
+    // buckets, and reading it during the drop is how their data moves. What
+    // must not commit is a pointer copied while the device was healthy - a
+    // reused stripe's - after the removal walk has passed it.
+    if stripe_has_removing_dev(fs, w.new_stripe.stripe().v()) {
+        return fs.throw(bch_errcode::BCH_ERR_stripe_create_device_removing);
+    }
+
+    let (nr_data, nr_blocks) = {
+        let v = w.new_stripe.stripe().v();
+        (v.nr_data() as usize, usize::from(v.nr_blocks))
+    };
+    let Working { new_stripe, new_buf, reuse, moving, old_block_map, allocated, watermark, res } = w;
+    let buf = new_buf.as_mut().expect("a new stripe's buffer");
+
+    stack_pin_init!(let io = BlockIo::write(fs, buf));
+
+    // the rest of each data bucket zeroed: zero_out_rest_of_ec_bucket()
+    for i in old_block_map.len()..nr_data {
+        // its writer done with it
+        let Some((dev, sectors_free)) = s.lock().blocks[i].bucket().map(|b| (u32::from(b.id().dev()), b.sectors_free.get())) else {
+            continue
+        };
+        if sectors_free == 0 {
+            continue;
+        }
+        let offset = {
+            let rcu = read_lock();
+            let ca = fs.dev_rcu(dev, &rcu).expect("an open bucket's device");
+            u32::from(ca.mi.get().bucket_size) - sectors_free
+        };
+        let start = (offset as usize) << 9;
+        io.as_mut().buf().block_mut(i)[start..start + ((sectors_free as usize) << 9)].fill(0);
+        io.as_mut().submit_range(new_stripe.stripe(), i, offset, sectors_free);
+    }
+
+    // The fold was awaited before we were in flight: its error is settled.
+    // The reuse is abandoned, so the old stripe stays as it is and nothing
+    // else discovers the loss until someone reads one of those files:
+    if let Err(lost) = &fold {
+        io.as_mut().wait(at).await;
+
+        // Too few blocks to reconstruct: the lost blocks' buffers still hold
+        // what we read, and an extent that checks out against it isn't lost
+        // - a block fails on one bad granule. After a reconstruct they hold
+        // its output instead, which says nothing about what's on disk.
+        let as_read = lost.err == BchError::from(bch_errcode::BCH_ERR_stripe_reconstruct_insufficient_blocks);
+        let trans = btree_trans!(fs);
+        let r = reuse.as_ref().expect("a fold's old stripe");
+        record_lost_blocks(&trans, r.stripe.stripe(), lost.blocks,
+                           c::bch_sb_error_id::BCH_FSCK_ERR_stripe_reconstruct_failed, false,
+                           r.buf.as_deref().filter(|_| as_read));
+        return Err(lost.err);
+    }
+
+    assert!(*allocated, "creating stripe {}, not allocated", new_stripe.idx());
+
+    generate_ec(new_stripe.stripe(), io.as_mut().buf());
+    generate_checksums(new_stripe, io.as_mut().buf());
+
+    // write out data blocks that moved
+    for i in 0..old_block_map.len() {
+        if moving.test(i) {
+            io.as_mut().submit(new_stripe.stripe(), i);
+        }
+    }
+
+    // write p/q:
+    for i in nr_data..nr_blocks {
+        io.as_mut().submit(new_stripe.stripe(), i);
+    }
+    io.as_mut().wait(at).await;
+
+    if io.as_mut().buf().failed_mask(PRE) != 0 {
+        bch_err!(fs, "error creating stripe: error writing redundancy buckets");
+        return fs.throw(bch_errcode::BCH_ERR_ec_block_write);
+    }
+
+    let new = new_stripe.stripe();
+    let old_idx = reuse.as_ref().map_or(0, |r| r.stripe.idx());
+    let new_idx = new_stripe.idx();
+
+    let mut op = BkeyI::<c::LoggedOpStripeUpdate>::new();
+    op.v.old_idx       = old_idx.into();
+    op.v.new_idx       = new_idx.into();
+    op.v.old_blocks_nr = old_block_map.len() as u8;
+    op.v.old_block_map[..old_block_map.len()].copy_from_slice(old_block_map);
+
+    let watermark: Watermark = create_watermark(*watermark).into();
+    let opts = CommitOpts::new().watermark(watermark).flags(CommitFlags::NO_CHECK_RW | CommitFlags::NO_ENOSPC);
+
+    let res = match res.take() {
+        Some(res) => res,
+        None      => DiskReservation::new(fs),
+    };
+    trans_commit_do(fs, Some(&res), opts, |t| {
+        stripe_key_update(t, new)?;
+        logged_ops::start(t, op.as_mut())
+    })?;
+
+    let trans = btree_trans!(fs);
+    let map = &old_block_map[..];
+    // no old stripe, if it isn't a reuse: nothing's carried from it
+    let old = match reuse {
+        Some(r) if !map.is_empty() => r.stripe.stripe(),
+        _ => new,
+    };
+    let ret = stripe_update_extents(&trans, old, new, map, watermark);
+    logged_ops::finish(&trans, op.as_ref(), ret, CommitOpts::new().watermark(watermark))?;
+
+    // The trigger and the delete worker skip open stripes, and both of ours
+    // may have emptied while we held them:
+    commit_do(&trans, None, opts, |t| {
+        if old_idx != 0 && old_idx != new_idx {
+            stripe_delete(t, old_idx, true)?;
+        }
+        stripe_delete(t, new_idx, true)
+    })
+}
+
+/// What creating @s came to, counted and traced.
+fn create_done(fs: &Fs, s: &StripeNew, ret: Result<(), BchError>) {
+    let i = s.lock();
+    let new = i.new_stripe.stripe();
+    match ret {
+        Err(e) => {
+            s.err.set(e);
+            fs.event_inc_trace(events::stripe_create_fail, |out| {
+                prt!(out, "error {e}\n{}", new.to_text(fs));
+            });
+        }
+        Ok(()) if i.reuse.is_some() => fs.event_inc_trace(events::stripe_reuse, |out| {
+            let ov = i.reuse.as_ref().expect("just seen").stripe.stripe();
+            prt!(out, "Reused {}/{} data blocks\n", i.old_block_map().len(), ov.v().nr_data());
+            prt!(out, "\nOld: {}", ov.to_text(fs));
+            prt!(out, "\nNew: {}", new.to_text(fs));
+        }),
+        Ok(()) => fs.event_inc_trace(events::stripe_create, |out| {
+            prt!(out, "\n{}", new.to_text(fs));
+        }),
+    }
+}
+
+/// What it holds given back - its writers done: the blocks they claimed
+/// closed, the rest put; a repair's writes done with it - and it out of
+/// new_stripes, then the flushes woken. Its memory goes with this task's last
+/// run. @p is the task's, given up: what borrowed the stripe from it can't be
+/// used after.
+///
+/// # Safety
+/// It's in flight: every writer's io ref put, so nothing else has it.
+unsafe fn teardown(fs: &Fs, p: BackRef<StripeNew>) {
+    p.release();
+
+    let s = NonNull::from(&*p);
+    drop(p);
+    drop(new_stripes_take(fs, s));
+    fs.ec.new_stripes_changed.wake();
+}
diff --git a/fs/bcachefs/data/ec/trigger.c b/fs/bcachefs/data/ec/trigger.c
new file mode 100644
index 0000000..5a145c8
--- /dev/null
+++ b/fs/bcachefs/data/ec/trigger.c
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-2.0
+
+/*
+ * erasure coding: opening an existing stripe - the open stripes table is
+ * Rust's, in trigger.rs; this is here until Rust has btree node locks
+ */
+
+#include "bcachefs.h"
+
+#include "btree/iter.h"
+#include "btree/locking.h"
+
+#include "data/ec/trigger.h"
+
+/* Intent-locked existing key: 1 opened, 0 busy, negative error/restart. */
+int bch2_stripe_tryget_existing(struct btree_iter *iter)
+{
+	struct btree_trans *trans = iter->trans;
+	u64 idx = iter->pos.offset;
+
+	EBUG_ON(iter->btree_id != BTREE_ID_stripes);
+	BUG_ON(!btree_node_intent_locked(btree_iter_path(trans, iter), 0));
+
+	if (bch2_stripe_is_open(trans->c, idx))
+		return 0;
+
+	/*
+	 * The stripe trigger and device invalidation act on stripes that
+	 * aren't open, and their decision can outlive a lock drop: commit
+	 * relocks and retries without re-running triggers. Cycling a write
+	 * lock advances the lock sequence, so that relock fails.
+	 *
+	 * The lock to cycle is the key cache entry: anything updating this key
+	 * holds it, and an entry is only freed under its write lock - so if
+	 * there's no entry, they're already invalidated. Our leaf intent lock
+	 * keeps one from being created meanwhile (the fill write locks the
+	 * leaf).
+	 */
+	CLASS(btree_iter, ck_iter)(trans, BTREE_ID_stripes, iter->pos,
+				   BTREE_ITER_intent|
+				   BTREE_ITER_cached|
+				   BTREE_ITER_cached_nofill);
+	try(bch2_btree_iter_traverse(&ck_iter));
+
+	struct btree_path *ck_path = btree_iter_path(trans, &ck_iter);
+	if (!ck_path->l[0].b)
+		return bch2_stripe_tryget(trans->c, idx);
+
+	/* Take the lock before opening, so a restart can't leak an open stripe: */
+	try(bch2_btree_node_lock_write(trans, ck_path, &ck_path->l[0].b->c));
+	int ret = bch2_stripe_tryget(trans->c, idx);
+	bch2_btree_node_unlock_write(trans, ck_path, ck_path->l[0].b);
+	return ret;
+}
diff --git a/fs/bcachefs/data/ec/trigger.h b/fs/bcachefs/data/ec/trigger.h
new file mode 100644
index 0000000..336f058
--- /dev/null
+++ b/fs/bcachefs/data/ec/trigger.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_DATA_EC_TRIGGER_H
+#define _BCACHEFS_DATA_EC_TRIGGER_H
+#include "data/ec/open_gen.h"
+#include "data/ec/stripe_gen.h"
+#include "data/ec/trigger_gen.h"
+
+#define bch2_bkey_ops_stripe ((struct bkey_ops) {	\
+	.key_validate	= bch2_stripe_validate,		\
+	.val_to_text	= bch2_stripe_to_text,		\
+	.swab		= bch2_ptr_swab,		\
+	.trigger	= bch2_trigger_stripe,		\
+	.check_repair	= bch2_check_fix_ptrs,		\
+})
+
+/*
+ * A stripe's block counts, for btree/check.c's gc until it converts: the
+ * layout is trigger.rs's.
+ */
+
+static inline unsigned stripe_csums_per_device(const struct bch_stripe *s)
+{
+	return DIV_ROUND_UP(le16_to_cpu(s->sectors),
+			    1 << s->csum_granularity_bits);
+}
+
+/*
+ * Checksum types are not validated - a stripe written by a newer version may
+ * use one we don't know - so this is the only place the table is indexed, and
+ * an unknown type takes the widest checksum we have, as bch2_csum_to_text()
+ * does. The offsets that result are still bounded by the caller against
+ * bkey_val_bytes().
+ */
+static inline unsigned stripe_csum_bytes(const struct bch_stripe *s)
+{
+	return s->csum_type < BCH_CSUM_NR ? bch_crc_bytes[s->csum_type] : 16;
+}
+
+static inline unsigned stripe_csum_offset(const struct bch_stripe *s,
+					  unsigned dev, unsigned csum_idx)
+{
+	unsigned csum_bytes = stripe_csum_bytes(s);
+
+	return sizeof(struct bch_stripe) +
+		sizeof(struct bch_extent_ptr) * s->nr_blocks +
+		(dev * stripe_csums_per_device(s) + csum_idx) * csum_bytes;
+}
+
+static inline unsigned stripe_blockcount_offset(const struct bch_stripe *s,
+						unsigned idx)
+{
+	return stripe_csum_offset(s, s->nr_blocks, 0) +
+		sizeof(u16) * idx;
+}
+
+static inline unsigned stripe_blockcount_get(const struct bch_stripe *s,
+					     unsigned idx)
+{
+	return le16_to_cpup((void *) s + stripe_blockcount_offset(s, idx));
+}
+
+static inline void stripe_blockcount_set(struct bch_stripe *s,
+					 unsigned idx, unsigned v)
+{
+	__le16 *p = (void *) s + stripe_blockcount_offset(s, idx);
+
+	*p = cpu_to_le16(v);
+}
+
+#endif /* _BCACHEFS_DATA_EC_TRIGGER_H */
+
diff --git a/fs/bcachefs/data/ec/trigger.rs b/fs/bcachefs/data/ec/trigger.rs
new file mode 100644
index 0000000..daa24d1
--- /dev/null
+++ b/fs/bcachefs/data/ec/trigger.rs
@@ -0,0 +1,508 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! The stripe key's trigger - ec/trigger.c's - and gc's copy of the stripes.
+//!
+//! A stripe update's trigger owns: each block's bucket - a parity block's
+//! sectors, every block's stripe_refcount and bucket_to_stripe entry - and
+//! its backpointer; parity replicas, reconcile work and fragmentation
+//! accounting; the stripe lru, whose position (lru_pos()) the deleter and
+//! stripe reuse walk; and deleting a stripe gone empty, unless it's open.
+//! Its data blocks' sectors are their extents', counted from the extent
+//! side, trigger_stripe_ptr() in alloc/buckets.rs - which updates the stripe
+//! key, running this.
+
+use crate::alloc::backpointers::{bucket_backpointer_mod, extent_ptr_to_bp};
+use crate::alloc::buckets::bucket_to_u64;
+use crate::alloc::lru::{lru_change, LruId};
+use crate::alloc::replicas::{bkey_replicas_acct, bkey_replicas_padded, entry_acct};
+use crate::btree::bkey::{pos, BkeyS, BkeySC, BkeyV, BkeyVMut};
+use crate::btree::bkey_methods::TriggerOp;
+use crate::btree::iter::{BtreeIter, BtreeIterFlags, TransAttempt, UpdateTriggerFlags};
+use crate::c;
+use crate::data::ec::stripe::{StripeK, STRIPE_LRU_POS_EMPTY};
+use crate::data::ptrs::BkeyVPtrs;
+use crate::data::reconcile::trigger::data_to_rb_work_pos;
+use crate::errcode::{bch_errcode, BchError};
+use crate::fs::Fs;
+use crate::init::error::id;
+use crate::init::passes;
+use crate::util::alloc::AllocError;
+use crate::util::ffi::Opaque;
+use crate::util::log::LogMsg;
+use crate::util::vstructs::plain_bytes;
+use crate::{accounting, bch_err, fs_inconsistent, fsck_err_on, prt};
+use arrayvec::ArrayVec;
+use core::ops::ControlFlow;
+use cstruct_macros::c_export;
+
+// ── A bucket's stripes ───────────────────────────────────────────────────
+
+impl TransAttempt<'_, '_> {
+    /// How many stripes have a block in @bucket, by bucket_to_stripe.
+    pub fn bucket_nr_stripes(&self, bucket: c::bpos) -> Result<u32, BchError> {
+        let b = bucket_to_u64(bucket);
+        let mut nr = 0;
+        BtreeIter::new(self, c::btree_id::bucket_to_stripe, pos(b, 0), BtreeIterFlags::empty())
+            .for_each_max_norestart(self, pos(b, u64::MAX), |_, _| {
+                nr += 1;
+                Ok(ControlFlow::<()>::Continue(()))
+            })?;
+        Ok(nr)
+    }
+}
+
+// ── gc's stripes ─────────────────────────────────────────────────────────
+
+impl c::bch_fs_ec {
+    /// gc's copy of stripe @idx, if it has one.
+    pub fn gc_stripe(&self, idx: u64) -> Option<&c::gc_stripe> {
+        // SAFETY: an entry - a Lock, all of whose state is behind its lock
+        self.gc_stripes.get_raw(idx as usize).map(|m| unsafe { m.as_ref() })
+    }
+
+    /// gc_stripe(), allocated - zeroed, not alive - if it wasn't.
+    pub fn gc_stripe_alloc(&self, idx: u64, gfp: c::gfp_t) -> Result<&c::gc_stripe, AllocError> {
+        self.gc_stripes.prealloc(idx as usize, gfp)?;
+        Ok(self.gc_stripe(idx).expect("an entry, allocated"))
+    }
+}
+
+#[c_export]
+pub fn bch2_gc_stripe_get(c: &Opaque<c::bch_fs>, idx: u64) -> *mut c::gc_stripe {
+    Fs::from_c(c).ec.gc_stripe(idx).map_or(core::ptr::null_mut(), |m| core::ptr::from_ref(m).cast_mut())
+}
+
+/// # Safety
+/// gc is done with them: gc.pos is back to not_running. Not fenced from a
+/// commit's gc trigger that saw it running - as reflink's gc table isn't:
+/// see ReflinkGc.
+#[c_export]
+pub unsafe fn bch2_gc_stripes_free(c: &Opaque<c::bch_fs>) {
+    unsafe { Fs::from_c(c).ec.gc_stripes.free() }
+}
+
+// ── The trigger ──────────────────────────────────────────────────────────
+
+/// @k's stripe, if it's one - not a deletion.
+fn stripe_of(k: BkeySC<'_>) -> Option<StripeK<'_>> {
+    k.arm::<c::Stripe>()
+}
+
+/// Its time in the stripe lru - none for no stripe.
+fn lru_pos(s: Option<StripeK<'_>>) -> u64 {
+    s.map_or(0, |s| s.v().lru_pos())
+}
+
+fn needs_reconcile(s: Option<StripeK<'_>>) -> i64 {
+    s.map_or(0, |s| s.v().needs_reconcile().into())
+}
+
+/// Whether going from @old to @new changes no block's bucket or backpointer.
+fn blocks_unchanged(old: StripeK<'_>, new: StripeK<'_>) -> bool {
+    let (o, n) = (old.v(), new.v());
+
+    o.needs_reconcile() == n.needs_reconcile() &&
+        o.nr_blocks == n.nr_blocks &&
+        o.nr_redundant == n.nr_redundant &&
+        plain_bytes(o.block_ptrs()) == plain_bytes(n.block_ptrs())
+}
+
+/// Refresh @new's can_widen from the RW members its disk label has now,
+/// before lru_pos() reads it: else an update committing after reconcile's
+/// stripes scan passed the stripe would keep a stale one, and the scan's
+/// cookie be cleared with it wrong.
+fn refresh_can_widen(fs: &Fs, new: &mut BkeyS<'_>) {
+    let Some(mut s) = new.as_s().arm::<c::Stripe>() else { return };
+    let v = s.v();
+    let want = v.want_can_widen(fs.ec_rw_member_devs_nr(v.disk_label, v.sectors.get()),
+                                fs.opts().ec_max_data_blocks.into());
+    if v.can_widen() != want {
+        s.v_mut().bits.set_can_widen(want);
+    }
+}
+
+/// stripe_frag accounting - [data sectors, empty sectors], by how many of
+/// its data blocks are empty - for @s, added (@sign 1) or taken away (-1):
+/// two mods rather than one delta, as the position changes when the number
+/// of empty blocks does.
+fn stripe_frag_acct(t: &TransAttempt<'_, '_>, s: Option<StripeK<'_>>, gc: bool, sign: i64) -> Result<(), BchError> {
+    let Some(s) = s else { return Ok(()) };
+    let sectors = i64::from(s.v().sectors.get());
+    let nr_data = s.data_blocks().count() as i64;
+    let nr_empty = s.data_blocks().filter(|b| b.sectors() == 0).count();
+
+    let acct = c::disk_accounting_pos::from_arm(c::bch_acct_stripe_frag { nr_empty: nr_empty as u8 });
+    accounting::add(t, &acct, &[sign * nr_data * sectors, sign * nr_empty as i64 * sectors], gc)
+}
+
+/// dev_stripe_frag accounting - each device's [data sectors, empty sectors]
+/// - from @old to @new: summed by device first, so an unchanged block nets to
+/// zero, and the common case is one mod, not one per block.
+fn dev_stripe_frag_acct(t: &TransAttempt<'_, '_>, old: Option<StripeK<'_>>, new: Option<StripeK<'_>>, gc: bool)
+    -> Result<(), BchError>
+{
+    type Deltas = ArrayVec<(u8, i64, i64), { 2 * c::BCH_BKEY_PTRS_MAX as usize }>;
+
+    fn add(d: &mut Deltas, s: Option<StripeK<'_>>, sign: i64) {
+        let Some(s) = s else { return };
+        let sectors = i64::from(s.v().sectors.get());
+
+        for b in s.data_blocks() {
+            let dev = b.ptr().dev();
+            let i = match d.iter().position(|e| e.0 == dev) {
+                Some(i) => i,
+                None    => { d.push((dev, 0, 0)); d.len() - 1 }
+            };
+            d[i].1 += sign * sectors;
+            d[i].2 += if b.sectors() == 0 { sign * sectors } else { 0 };
+        }
+    }
+
+    let mut d = Deltas::new();
+    add(&mut d, old, -1);
+    add(&mut d, new, 1);
+
+    for (dev, data, empty) in d {
+        if data != 0 || empty != 0 {
+            let acct = c::disk_accounting_pos::from_arm(c::bch_acct_dev_stripe_frag { dev });
+            accounting::add(t, &acct, &[data, empty], gc)?;
+        }
+    }
+    Ok(())
+}
+
+/// The alloc key and bucket_to_stripe disagree: we're adding a stripe
+/// reference to a bucket whose refcount is already saturated, or dropping
+/// one from a bucket that has none.
+///
+/// Saturate rather than wrap, because alloc_data_type() derives data_type
+/// from the refcount - so wrapping changes what the bucket *is*, in both
+/// directions:
+///
+///   0 - 1 makes an empty bucket BCH_DATA_stripe, which the alloc trigger
+///   sees as a bucket going nonempty outside an open bucket, and takes the
+///   filesystem read-only.
+///
+///   U32_MAX + 1 is quieter and worse. A stripe block holding no live
+///   extents has no sectors of its own - the refcount is the whole
+///   reservation - so zero reads as empty, and nothing stops the bucket
+///   being discarded and handed out again while the stripe still points at
+///   it.
+///
+/// check_alloc_info recounts stripe_refcount from bucket_to_stripe
+/// (alloc_key_stripe_refcount_wrong, FSCK_AUTOFIX), so leave the true value
+/// to it rather than guessing here.
+#[cold]
+fn stripe_refcount_saturated(fs: &Fs, bucket: c::bpos, stripe: u64, overflow: bool) {
+    let mut msg = LogMsg::new(fs);
+    prt!(&mut msg, "stripe_refcount {} at bucket {}:{} {} stripe {stripe}\n",
+         if overflow { "overflow" } else { "underflow" }, { bucket.inode }, { bucket.offset },
+         if overflow { "adding ref to" } else { "dropping ref to" });
+
+    let _ = passes::run_explicit(fs, &mut msg, c::bch_recovery_pass::BCH_RECOVERY_PASS_check_alloc_info,
+                                 c::bch_run_recovery_pass_flags::from_bits_retain(0));
+}
+
+/// Block @i's part of @a, the alloc key of its bucket @bucket, for @s going
+/// in or (@deleting) out: __mark_stripe_bucket(). A parity block's sectors
+/// are the stripe's; a data block's are its extents', which their triggers
+/// count.
+#[allow(clippy::too_many_arguments)]
+fn mark_stripe_bucket_alloc(t: &TransAttempt<'_, '_>, ca: &c::bch_dev, s: StripeK<'_>, i: u32, deleting: bool,
+                            bucket: c::bpos, a: &mut c::AllocV4, flags: UpdateTriggerFlags) -> Result<(), BchError> {
+    use c::bch_data_type as D;
+    let fs = t.fs();
+    let v = s.v();
+    let ptr = &s.v().block_ptrs()[i as usize];
+    let parity = i >= v.nr_data();
+    let data_type = if parity { D::BCH_DATA_parity } else { D::BCH_DATA_stripe };
+
+    let sectors = if parity { i64::from(v.sectors.get()) } else { 0 };
+    if sectors != 0 {
+        let sectors = if deleting { -sectors } else { sectors };
+        let (generation, mut bucket_data_type) = (a.generation, a.data_type);
+        let ret = t.bucket_ref_update(ca, s.untyped(), ptr, sectors, data_type, generation, &mut bucket_data_type,
+                                      &mut a.dirty_sectors);
+        // as C's, even on error
+        a.data_type = bucket_data_type;
+        ret?;
+    }
+
+    if flags.contains(UpdateTriggerFlags::TRANSACTIONAL) {
+        t.bit_mod(c::btree_id::bucket_to_stripe, pos(bucket_to_u64(bucket), s.k.p.offset), !deleting)?;
+    }
+
+    if !deleting {
+        match a.stripe_refcount.checked_add(1) {
+            Some(n) => a.stripe_refcount = n,
+            None    => stripe_refcount_saturated(fs, bucket, s.k.p.offset, true),
+        }
+    } else {
+        match a.stripe_refcount.checked_sub(1) {
+            Some(n) => a.stripe_refcount = n,
+            None    => stripe_refcount_saturated(fs, bucket, s.k.p.offset, false),
+        }
+    }
+
+    let inconsistent = |a: &c::AllocV4| (a.stripe_refcount == 0) != (a.dirty_sectors == 0);
+    if parity && inconsistent(a) {
+        // XXX: with gc this runs under the gc bucket's lock - gc_bucket_mod()
+        // - and a btree walk and an fsck error can sleep. As C's.
+        let nr_stripes = t.bucket_nr_stripes(bucket)?;
+
+        if fsck_err_on!(t, a.stripe_refcount != nr_stripes, id::alloc_key_stripe_refcount_wrong,
+                        "bucket {}:{} with incorrect stripe_refcount, should be {nr_stripes}",
+                        { bucket.inode }, { bucket.offset })? {
+            a.stripe_refcount = nr_stripes;
+        }
+
+        if inconsistent(a) {
+            let mut msg = LogMsg::new(fs);
+            prt!(&mut msg, "Parity bucket with dirty_sectors/stripe_refcount inconsistency at {}:{}\n",
+                 { bucket.inode }, { bucket.offset });
+            prt!(&mut msg, "stripe_refcount {} but dirty_sectors {}\n", a.stripe_refcount, a.dirty_sectors);
+
+            let flags = c::bch_run_recovery_pass_flags::from_bits_retain(0);
+            let _ = passes::run_explicit(fs, &mut msg, c::bch_recovery_pass::BCH_RECOVERY_PASS_check_allocations, flags);
+            let _ = passes::run_explicit(fs, &mut msg, c::bch_recovery_pass::BCH_RECOVERY_PASS_check_alloc_info, flags);
+
+            // so the bucket isn't reused until it's repaired
+            a.stripe_refcount = a.stripe_refcount.max(1);
+            a.dirty_sectors   = a.dirty_sectors.max(1);
+        }
+    }
+
+    a.set_data_type(if a.stripe_refcount != 0 { data_type } else { D::BCH_DATA_user });
+    Ok(())
+}
+
+/// Block @i's bucket, for @s going in or (@deleting) out: its alloc key, and
+/// gc's copy with gc.
+fn mark_stripe_bucket(t: &TransAttempt<'_, '_>, s: StripeK<'_>, i: u32, deleting: bool, flags: UpdateTriggerFlags)
+    -> Result<(), BchError>
+{
+    let fs = t.fs();
+    let ptr = &s.v().block_ptrs()[i as usize];
+    let dev = u32::from(ptr.dev());
+
+    // C's bch2_dev_bkey_tryget() drops the error of scheduling the repair
+    // of a missing device it reports
+    let Some(ca) = fs.dev_bkey_tryget(s.untyped(), dev).unwrap_or(None) else {
+        if dev != c::BCH_SB_MEMBER_INVALID && !flags.contains(UpdateTriggerFlags::OVERWRITE) {
+            return fs.throw(bch_errcode::BCH_ERR_mark_stripe);
+        }
+        return Ok(());
+    };
+    let bucket = ca.ptr_bucket_pos(ptr);
+
+    if flags.contains(UpdateTriggerFlags::TRANSACTIONAL) {
+        let mut a = t.start_alloc_update(bucket, UpdateTriggerFlags::empty())?;
+        mark_stripe_bucket_alloc(t, &ca, s, i, deleting, bucket, a.v_mut(), flags)?;
+    }
+
+    if flags.contains(UpdateTriggerFlags::GC) {
+        let Some(g) = ca.gc_bucket(bucket.offset) else {
+            fs_inconsistent!(fs, "reference to invalid bucket on device {dev}\n{}", s.to_text(fs));
+            return fs.throw(bch_errcode::BCH_ERR_mark_stripe);
+        };
+        t.gc_bucket_mod(&ca, g, flags, |a| mark_stripe_bucket_alloc(t, &ca, s, i, deleting, bucket, a, flags))?;
+    }
+    Ok(())
+}
+
+/// Block @i's backpointer, inserted or deleted - none for a block on no
+/// device.
+fn mark_stripe_bp(t: &TransAttempt<'_, '_>, s: StripeK<'_>, i: u32, insert: bool) -> Result<(), BchError> {
+    let fs = t.fs();
+    let d = s.ptrs_decoded(fs).nth(i as usize).expect("a block of the stripe's");
+    if u32::from(d.p.ptr.dev()) == c::BCH_SB_MEMBER_INVALID {
+        return Ok(());
+    }
+
+    let mut bp = extent_ptr_to_bp(fs, c::btree_id::stripes, 0, s.untyped(), &d);
+    bucket_backpointer_mod(t, s.untyped(), &mut bp, insert)
+}
+
+/// Each block whose pointer changed: its bucket - the new one's in, the old
+/// one's out - and its backpointer, which a change in needs_reconcile moves
+/// too (the backpointer carries the reconcile phys bits).
+fn mark_stripe_buckets(t: &TransAttempt<'_, '_>, old: Option<StripeK<'_>>, new: Option<StripeK<'_>>,
+                       flags: UpdateTriggerFlags) -> Result<(), BchError> {
+    fn block<'a>(s: Option<StripeK<'a>>, i: u32) -> Option<&'a c::bch_extent_ptr> {
+        s.and_then(|s| s.v().block_ptrs().get(i as usize))
+    }
+    let nr_blocks = |s: Option<StripeK<'_>>| s.map_or(0, |s| u32::from(s.v().nr_blocks));
+    let reconcile_changed = needs_reconcile(old) != needs_reconcile(new);
+
+    for i in 0..nr_blocks(old).max(nr_blocks(new)) {
+        let (old_ptr, new_ptr) = (block(old, i), block(new, i));
+        let changing = match (old_ptr, new_ptr) {
+            (Some(o), Some(n)) => plain_bytes(o) != plain_bytes(n),
+            _                  => true,
+        };
+
+        if changing {
+            if let (Some(n), Some(_)) = (new, new_ptr) {
+                mark_stripe_bucket(t, n, i, false, flags)?;
+            }
+            if let (Some(o), Some(_)) = (old, old_ptr) {
+                mark_stripe_bucket(t, o, i, true, flags)?;
+            }
+        }
+
+        if (changing || reconcile_changed) && flags.contains(UpdateTriggerFlags::TRANSACTIONAL) {
+            if let (Some(o), Some(_)) = (old, old_ptr) {
+                mark_stripe_bp(t, o, i, false)?;
+            }
+            if let (Some(n), Some(_)) = (new, new_ptr) {
+                mark_stripe_bp(t, n, i, true)?;
+            }
+        }
+    }
+    Ok(())
+}
+
+/// The stripe key's trigger: bch2_trigger_stripe().
+///
+/// Transactional: the new key's can_widen refreshed; an empty stripe that
+/// isn't open deleted; its place in the stripe lru, and its reconcile_hipri
+/// bit. With gc as well: reconcile work, fragmentation and parity replicas
+/// accounting - gc's copy of the stripe made - and each changed block's
+/// bucket and backpointer. Atomic: a stripe gone empty kicks the deleter.
+fn trigger(t: &TransAttempt<'_, '_>, op: &mut TriggerOp<'_>) -> Result<(), BchError> {
+    use UpdateTriggerFlags as F;
+    let fs = t.fs();
+    let flags = op.flags;
+    let gc = flags.contains(F::GC);
+    let idx = op.new.k.p.offset;
+
+    // before anything reads the new key: its csum check, below, doesn't
+    // look at can_widen
+    if flags.contains(F::TRANSACTIONAL) {
+        refresh_can_widen(fs, &mut op.new);
+    }
+
+    let old = stripe_of(op.old);
+    let new = stripe_of(BkeySC::from(&op.new));
+
+    if let Some(s) = old {
+        s.v().csum_type_check(fs)?;
+    }
+    if let Some(s) = new {
+        s.v().csum_type_check(fs)?;
+    }
+    if let (Some(o), Some(n)) = (old, new) {
+        let (o, n) = (o.v(), n.v());
+        assert!(n.sectors.get() == o.sectors.get() && n.nr_blocks == o.nr_blocks && n.nr_redundant == o.nr_redundant,
+                "a stripe update changing its shape");
+    }
+
+    let needs_reconcile_delta = needs_reconcile(new) - needs_reconcile(old);
+
+    if flags & (F::ATOMIC | F::GC) == F::ATOMIC && new.is_some() && lru_pos(new) == STRIPE_LRU_POS_EMPTY {
+        fs.do_stripe_deletes();
+    }
+
+    if flags.contains(F::TRANSACTIONAL) {
+        let (old_lru, new_lru) = (lru_pos(old), lru_pos(new));
+
+        // stripes is key-cached: deleted by an update, which goes through
+        // the key cache's flush - editing @op.new into a deletion would
+        // bypass it, and trip the commit's assert. The btree's delete runs
+        // this trigger again, which cleans up after it.
+        if new_lru == STRIPE_LRU_POS_EMPTY && !fs.stripe_is_open(idx) {
+            return t.delete(c::btree_id::stripes, op.new.k.p, F::OVERWRITE_TRIGGERED);
+        }
+
+        lru_change(t, LruId::Stripes, idx, old_lru, new_lru)?;
+
+        if needs_reconcile_delta != 0 {
+            t.bit_mod_buffered(c::btree_id::reconcile_hipri, data_to_rb_work_pos(c::btree_id::stripes, op.new.k.p),
+                               needs_reconcile_delta > 0)?;
+        }
+    }
+
+    if !flags.intersects(F::TRANSACTIONAL | F::GC) {
+        return Ok(());
+    }
+
+    if needs_reconcile_delta != 0 {
+        let s = old.map(|s| s.v()).or(new.map(|s| s.v())).expect("a stripe, if needs_reconcile changed");
+        let acct = c::disk_accounting_pos::from_arm(c::bch_acct_reconcile_work {
+            type_: c::bch_reconcile_accounting_type::BCH_RECONCILE_ACCOUNTING_stripes.0 as u8,
+        });
+        let sectors = i64::from(s.nr_blocks) * i64::from(s.sectors.get()) * needs_reconcile_delta;
+        accounting::add(t, &acct, &[sectors, 0], gc)?;
+    }
+
+    // above the unchanged return: block counts change without the pointers
+    // changing, and they're what this counts
+    stripe_frag_acct(t, old, gc, -1)?;
+    stripe_frag_acct(t, new, gc, 1)?;
+    dev_stripe_frag_acct(t, old, new, gc)?;
+
+    if old.zip(new).is_some_and(|(o, n)| blocks_unchanged(o, n)) {
+        return Ok(());
+    }
+
+    // XXX: wrong when runtime gc comes back, which should unmark the old key
+    // and mark the new - with locking
+    let m = if gc {
+        let new = new.expect("gc marks keys going in");
+        let Ok(m) = fs.ec.gc_stripe_alloc(idx, c::GFP_KERNEL) else {
+            bch_err!(fs, "error allocating memory for gc_stripes, idx {idx}");
+            return fs.throw(bch_errcode::BCH_ERR_ENOMEM_mark_stripe);
+        };
+
+        let v = new.v();
+        let mut d = m.lock.lock();
+        d.set_alive(1);
+        d.sectors      = v.sectors.get();
+        d.nr_blocks    = v.nr_blocks;
+        d.nr_redundant = v.nr_redundant;
+        for (i, p) in v.block_ptrs().iter().enumerate() {
+            d.ptrs[i] = *p;
+        }
+        // gc counts them from the stripe pointers
+        d.block_sectors = Default::default();
+        Some(m)
+    } else {
+        None
+    };
+
+    let parity = c::bch_data_type::BCH_DATA_parity;
+    if let Some(n) = new {
+        let r = bkey_replicas_padded(fs, n.untyped());
+        let sectors = i64::from(n.v().sectors.get()) * i64::from(n.v().nr_redundant);
+        // SAFETY: any bytes are an entry's
+        accounting::add(t, &entry_acct(unsafe { &r.bytes }, parity), &[sectors], gc)?;
+        if let Some(m) = m {
+            m.lock.lock().r = r;
+        }
+    }
+    if let Some(o) = old {
+        let sectors = -(i64::from(o.v().sectors.get()) * i64::from(o.v().nr_redundant));
+        accounting::add(t, &bkey_replicas_acct(fs, o.untyped(), parity), &[sectors], gc)?;
+    }
+
+    mark_stripe_buckets(t, old, new, flags)
+}
+
+crate::key_trigger!(bch2_trigger_stripe => trigger);
+
+// ── gc's copy, before the commit ─────────────────────────────────────────
+
+/// While gc's running, its copy of the stripe at @iter, allocated - the
+/// transaction's locks dropped, if they have to be - before the commit its
+/// trigger fills it in.
+pub fn ec_stripe_mem_alloc(t: &TransAttempt<'_, '_>, iter: &BtreeIter<'_>) -> Result<(), BchError> {
+    let fs = t.fs();
+    let idx = iter.pos().offset;
+
+    t.allocate_dropping_locks(|gfp| {
+        if fs.gc.phase() != c::gc_phase::GC_PHASE_not_running && fs.ec.gc_stripe_alloc(idx, gfp).is_err() {
+            return fs.throw(bch_errcode::BCH_ERR_ENOMEM_ec_stripe_mem_alloc);
+        }
+        Ok(())
+    })
+}
