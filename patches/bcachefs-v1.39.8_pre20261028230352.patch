+    let mut iter = BtreeIter::new(&trans, c::btree_id::xattrs, spos(0, 0, u32::MAX), BtreeIterFlags::empty());
+    iter.for_each_max(&trans, pos(0, u64::MAX), |_, _, _| Ok(()))?;
+    Ok(())
