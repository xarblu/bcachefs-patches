+static inline void bch2_trans_iter_init_common(struct btree_trans *trans,
+					  struct btree_iter *iter,
+					  enum btree_id btree, struct bpos pos,
+					  unsigned locks_want,
+					  unsigned depth,
+					  enum btree_iter_update_trigger_flags flags,
+					  unsigned long ip)
+{
+	iter->trans		= trans;
+	iter->update_path	= 0;
+	iter->key_cache_path	= 0;
