+// SPDX-License-Identifier: GPL-2.0
+//! The macros for types defined in Rust that C shares - see fs/types/lib.rs.
+//!
+//! Each parses its input with fs/types/cstruct.rs - the parser
+//! rust_types_gen uses for the same text - so a mistake is a compile error
+//! here, at the item, rather than bad C later. Each expands to its Rust side
+//! and to its record: built with --cfg bch_cstruct_records, a static in the
+//! .discard.bch_cstruct section, with the item's source as text and, for a struct,
+//! its layout. Without that cfg, the record is compiled out.
+//!
+//!   #[derive(CStruct)]   a #[repr(C)] struct or union; no Rust side
+//!   #[bitfield(uN)]      bitfield_struct::bitfield, recorded: the struct
+//!                        that holds one in a #[c_bitfield] field declares
+//!                        its members in C
+//!   c_verbatim!(r#".."#) C carried as is; no Rust side
+//!   c_xmacro! { .. }     an x-macro list: Rust gets NAME!(cb), handing cb!
+//!                        the whole list
+//!   c_xmacro_from_c!(..) a list C still defines, read from its header: the
+//!                        same NAME!(cb), no record (xmacro_from_c.rs)
+//!   xmacro_select!       NAME!(xmacro_select [TOKEN => cb]): cb! handed
+//!                        the rows with TOKEN in them - a flag in a flags
+//!                        column
+//!   c_bitmask! { .. }    bitfields in a flags word: Rust gets a getter and
+//!                        a setter on the struct for each
+//!   c_ioctl! { .. }      ioctl numbers: C gets the _IO*() #defines, Rust a
+//!                        marker type for each, its opcode and argument type
+//!   c_enum! { .. }       an enum, #[open], #[closed] or #[flags]: Rust gets
+//!                        the type that is, and its values as constants
+//!   c_const! { .. }      integer constants: C gets a #define each
+//!   c_typedef! { .. }    a type alias: C gets a typedef
+//!   c_rcu_array! { .. }  an RcuArray C reads: C gets the struct of its
+//!                        buffer, a field of it a __rcu pointer to one
+//!   c_same! { .. }       a Rust type with a C type's layout: checked in C
+//!   c_extern! { .. }     what Rust calls of a C header: C gets the
+//!                        prototypes, which its own must agree with
+//!   #[c_export]          a Rust fn C calls: C gets the prototype; Rust,
+//!                        unless it's extern "C", a definition with C's
+//!                        signature, calling the fn
+//!   tagged_union! { .. } a tagged union with a stable representation: C's
+//!                        storage, the tag a Determinant of it, arms from an
+//!                        x-macro list, read as an enum (tagged_union.rs)
+//!   #[derive(TypeInfo)]  runtime type information, for kvdb: no record, no
+//!                        C (typeinfo.rs)
+//!   #[derive(Plain)]     util/vstructs.rs's Plain, checked at compile time;
+//!                        a #[bitfield] is Plain too, and #[counted_by] on a
+//!                        CStruct's trailing [T; 0] is its FlexArray
+//!                        (vstructs.rs)
+//!   #[derive(View)]      a projection for each field on a View of the type:
+//!                        its fields read as zero past a short value's end
+//!                        (vstructs.rs)
+//!   #[unsized_vstruct]   on C's struct ending in a flexible array: a family
+//!                        of definitions, one per state, and X<S> picking
+//!                        one (vstructs.rs)
+//!   #[grown(from = F)]   on C's struct of a type that grew: its family - the
+//!                        whole struct, and the floor and the bytes there
+//!                        are (vstructs.rs)
+//!   __prt!(..)           message!()'s and prt!()'s format strings, written
+//!                        into a printbuf - a ToText argument to_text()'d
+//!                        into it; nothing C sees (prt.rs)
+//!
+//! Zero dependencies: the kernel build compiles this with a bare rustc.
+
+use proc_macro::{Delimiter, Group, Punct, Spacing, Span, TokenStream, TokenTree};
+
+// A proc-macro crate may export only its macros: the parser's pub items go in
+// a private module - pub for rust_types_gen, which include!s it too.
+#[allow(unreachable_pub)]
+mod cstruct {
+    include!("../../types/cstruct.rs");
+}
+use cstruct::{bitfield_type, enum_text, expand_enum_list, parse_c_export, parse_cstruct, parse_items, rust_ident,
+              CEnumDef, CEnumKind, CEnumVariant, CItem, CXEntry};
+
+mod fieldwise;
+mod options;
+mod init;
+mod place;
+mod prt;
+mod tagged_union;
+mod to_text;
+mod typeinfo;
+mod vstructs;
+mod xmacro_from_c;
+
+/// A tagged union with a stable representation: see tagged_union.rs.
+#[proc_macro]
+pub fn tagged_union(input: TokenStream) -> TokenStream {
+    expand("tagged_union!", || tagged_union::tagged_union(input))
+}
+
+/// tagged_union!'s callback from its list, with the list's entries.
+#[doc(hidden)]
+#[proc_macro]
+pub fn __tagged_union(input: TokenStream) -> TokenStream {
+    expand("tagged_union!", || tagged_union::from_list(input))
+}
+
+/// message!()'s format string written into a printbuf, ToText arguments
+/// to_text()'d into it: see prt.rs.
+#[doc(hidden)]
+#[proc_macro]
+pub fn __prt(input: TokenStream) -> TokenStream {
+    expand("message!", || prt::prt(input))
+}
+
+fn compile_error(msg: &str) -> TokenStream {
+    format!("::core::compile_error!({msg:?});").parse().unwrap()
+}
+
+/// A macro's expansion, @f, or its error as compile_error!, @what naming the
+/// macro: every macro here is expand("name!", || ..).
+fn expand(what: &str, f: impl FnOnce() -> Result<TokenStream, String>) -> TokenStream {
+    f().unwrap_or_else(|e| compile_error(&format!("{what}: {e}")))
+}
+
+/// Rust code a macro made, as tokens: it always parses, or the macro has a bug.
+fn tokens(code: &str) -> TokenStream {
+    code.parse().unwrap()
+}
+
+/// A record's first numbers, as every type's has them: @ty's size and
+/// alignment.
+fn size_align(ty: &str) -> Vec<String> {
+    vec![format!("::core::mem::size_of::<{ty}>() as u64"),
+         format!("::core::mem::align_of::<{ty}>() as u64")]
+}
+
+/// The #[cfg(..)] on an item, if it has one.
+fn cfg_attr(cfg: &Option<cstruct::Cfg>) -> String {
+    cfg.as_ref().map(|c| format!("#[cfg({})] ", c.to_rust())).unwrap_or_default()
+}
+
+/// For a type C knows as @c_name: kCFI hashes an extern "C" fn's repr(C)
+/// struct by its Rust name, and an enum or a transparent newtype as its
+/// integer - neither what C's prototype says. In the kernel only, where the
+/// feature's allowed (mod.rs).
+fn cfi_encoding(c_name: &str) -> String {
+    format!("#[cfg_attr(kernel, cfi_encoding = \"{}{c_name}\")]\n", c_name.len())
+}
+
+/// The record of @text, and @nums: Rust expressions, the numbers that go
+/// with it - see fs/types/lib.rs.
+fn record(text: &str, nums: &[String]) -> String {
+    format!(
+        "#[cfg(bch_cstruct_records)]\n\
+         const _: () = {{\n\
+             const TEXT: &str = {text:?};\n\
+             const NUMS: &[u64] = &[{}];\n\
+             const LEN: usize = crate::types::record_len(::core::file!(), TEXT, NUMS.len());\n\
+             #[used]\n\
+             #[link_section = \".discard.bch_cstruct\"]\n\
+             static RECORD: [u8; LEN] =\n\
+                 crate::types::record::<LEN>(::core::file!(), ::core::line!(), TEXT, NUMS);\n\
+         }};\n",
+        nums.join(", "))
+}
+
+/// @decl through @list - LIST!(@callback [decl]) - which calls @callback back
+/// with its entries: { [decl] (entry), (entry), ... }. The declaration goes as
+/// tokens, not text, so what's defined in it keeps its spans.
+fn through_list(list: &str, callback: &str, decl: TokenStream) -> TokenStream {
+    let mut cb = tokens(callback);
+    cb.extend([TokenTree::Group(Group::new(Delimiter::Bracket, decl))]);
+    let mut out = tokens(&format!("crate::cstructs::c::{list}!"));
+    out.extend([TokenTree::Group(Group::new(Delimiter::Parenthesis, cb)),
+                TokenTree::Punct(Punct::new(';', Spacing::Alone))]);
+    out
+}
+
+/// What a list hands through_list()'s callback - { [decl] (entry), (entry),
+/// ... }: the declaration, and each entry as text.
+fn list_callback(input: TokenStream) -> Result<(TokenStream, Vec<String>), String> {
+    let mut trees = input.into_iter();
+    let decl = match trees.next() {
+        Some(TokenTree::Group(g)) if g.delimiter() == Delimiter::Bracket => g.stream(),
+        _ => return Err("expected [declaration] then the list's entries".into()),
+    };
+    let entries = trees
+        .filter_map(|t| match t {
+            TokenTree::Group(g) if g.delimiter() == Delimiter::Parenthesis => Some(g.stream().to_string()),
+            _ => None,
+        })
+        .collect();
+    Ok((decl, entries))
+}
+
+/// @text, which must parse as one item of the kind @is_kind accepts: @what
+/// names that kind for the error.
+fn one_item(text: &str, what: &str, is_kind: fn(&CItem) -> bool) -> Result<CItem, String> {
+    let mut items = parse_items(text)?;
+    match items.pop() {
+        Some(item) if items.is_empty() && is_kind(&item) => Ok(item),
+        _ => Err(format!("expected {what}")),
+    }
+}
+
+/// one_item() of kind CItem::$kind, as what it holds - or return the error.
+macro_rules! one_item {
+    ($text:expr, $kind:ident, $what:expr) => {
+        match one_item($text, $what, |i| matches!(i, CItem::$kind(_)))? {
+            CItem::$kind(x) => x,
+            _ => unreachable!(),
+        }
+    };
+}
+
+/// `#[c("...")]` is the field's C declaration, name included; `#[c_anon("...")]`
+/// a C declaration that doesn't name it. A bare `#[c_anon]` is the field's
+/// type written in its place, unnamed - C's anonymous struct or union - and
+/// `#[c_inline]` the same, named; `#[c_struct_group]` as the kernel's
+/// struct_group(); `#[c_lock("u8 lock")]` on a Lock<R, G, P>, the lock's C
+/// declaration, G's members and P's after it. `#[c_bitfield]` marks a field of a
+/// #[bitfield] type, whose members C declares in its place. `#[counted_by(FIELD)]` on a trailing
+/// `[T; 0]`: FIELD is its length - the struct's FlexArray (vstructs.rs).
+/// `#[c_typedef]` on the struct: C has it as a typedef - `typedef struct {
+/// ... } name`, or with `#[c_typedef(NAME)]`, `typedef struct name { ... }
+/// NAME`. `#[c_name(NAME)]` on the struct: C's name for it, where Rust's
+/// differs - a family's C definition (vstructs.rs).
+/// bch_opts' options, a field each: options.rs.
+#[proc_macro_derive(Options, attributes(opt))]
+pub fn derive_options(input: TokenStream) -> TokenStream {
+    expand("#[derive(Options)]", || options::derive(input))
+}
+
+#[proc_macro_derive(CStruct, attributes(c, c_anon, c_bitfield, c_inline, c_lock, c_name, c_packed, c_struct_group,
+                                        c_typedef, counted_by))]
+pub fn derive_cstruct(input: TokenStream) -> TokenStream {
+    expand("#[derive(CStruct)]", || cstruct_expand(input))
+}
+
+/// `#[derive(TypeInfo)]`: runtime type information for a struct or union C
+/// shares - see typeinfo.rs.
+#[proc_macro_derive(TypeInfo, attributes(c_name))]
+pub fn derive_type_info(input: TokenStream) -> TokenStream {
+    expand("#[derive(TypeInfo)]", || typeinfo::derive(input))
+}
+
+/// `#[derive(Init)]`: `T::init()`, an initializer that zeroes every field but
+/// those with `#[init(EXPR)]` - see init.rs.
+#[proc_macro_derive(Init, attributes(init, init_args, placed_at))]
+pub fn derive_init(input: TokenStream) -> TokenStream {
+    expand("#[derive(Init)]", || init::derive(input))
+}
+
+/// `#[derive(Fieldwise)]`: each method `#[fieldwise(...)]` names, applied to
+/// every field - see fieldwise.rs.
+#[proc_macro_derive(Fieldwise, attributes(fieldwise))]
+pub fn derive_fieldwise(input: TokenStream) -> TokenStream {
+    expand("#[derive(Fieldwise)]", || fieldwise::derive(input))
+}
+
+/// `#[derive(ToText)]`: a fieldless enum printed as its variant's name, or
+/// its `#[label("..")]` - see to_text.rs.
+#[proc_macro_derive(ToText, attributes(label))]
+pub fn derive_to_text(input: TokenStream) -> TokenStream {
+    expand("#[derive(ToText)]", || to_text::derive(input))
+}
+
+/// `#[derive(Plain)]`: util/vstructs.rs's Plain, checked at compile time -
+/// see vstructs.rs.
+#[proc_macro_derive(Plain)]
+pub fn derive_plain(input: TokenStream) -> TokenStream {
+    expand("#[derive(Plain)]", || vstructs::derive_plain(input))
+}
+
+/// `#[derive(SizedVal)]`: a key value that's itself in place, any bytes of it
+/// a valid one - btree/bkey/types.rs's SizedVal, what a sized key type's
+/// value is.
+#[proc_macro_derive(SizedVal)]
+pub fn derive_sized_val(input: TokenStream) -> TokenStream {
+    expand("#[derive(SizedVal)]", || vstructs::derive_sized_val(input))
+}
+
+/// `#[derive(View)]`: a projection for each field, on util/vstructs.rs's
+/// View and ViewMut of the type - see vstructs.rs.
+#[proc_macro_derive(View)]
+pub fn derive_view(input: TokenStream) -> TokenStream {
+    expand("#[derive(View)]", || vstructs::derive_view(input))
+}
+
+fn cstruct_expand(input: TokenStream) -> Result<TokenStream, String> {
+    let text = format!("#[derive(CStruct)] {input}");
+    let def = parse_cstruct(&text)?;
+    if !def.repr_c() {
+        return Err(format!("{} must be #[repr(C)]: C shares it", def.name));
+    }
+
+    let name = def.rust_ident();
+    let inst = def.rust_type();
+    let inst = inst.as_str();
+    // A #[c_bitfield] field's members, on the struct: its type's forwarders
+    // (#[bitfield]), by the type's own path. Not a Volatile one's: that's a
+    // word, read and written whole.
+    let mut forward = String::new();
+    for f in def.fields.iter().filter(|f| f.bitfield && bitfield_type(&f.ty) == f.ty.trim()) {
+        let ty = f.ty.trim();
+        let (path, ty) = ty.rsplit_once("::").map_or(("", ty), |(p, t)| (p, t));
+        let path = if path.is_empty() { String::new() } else { format!("{path}::") };
+        forward.push_str(&format!("{path}__{ty}_forward!({inst}, {});\n", f.rust_name()));
+    }
+    let mut nums = size_align(inst);
+    for f in &def.fields {
+        let field = f.rust_name();
+        let proj = format!("|p: *const {inst}| unsafe {{ ::core::ptr::addr_of!((*p).{field}) }}");
+        nums.push(format!("::core::mem::offset_of!({inst}, {field}) as u64"));
+        nums.push(format!("crate::types::field_size({proj})"));
+        nums.push(format!("crate::types::field_align({proj})"));
+    }
+    // a #[c_lock] field's, after every field's: the lock's size, and where
+    // in the Lock what it protects and what it publishes are
+    for f in def.fields.iter().filter(|f| f.lock.is_some()) {
+        let [r, ..] = cstruct::lock_args(&f.ty)?.expect("checked when parsed");
+        nums.push(format!("::core::mem::size_of::<{r}>() as u64"));
+        nums.push(format!("<{}>::PROTECTED_OFFSET as u64", f.ty));
+        nums.push(format!("<{}>::PUBLISHED_OFFSET as u64", f.ty));
+    }
+    // a pointer field C reads is a thin one: as c_extern!'s parameters
+    let thin: String = def.fields.iter()
+        .map(|f| thin_pointers(name, &f.cfg, &[(f.rust_name(), static_lifetimes(&f.ty, &def.lifetimes))], None))
+        .collect();
+    let flex = vstructs::flex_array(&def)?;
+    let zeroable = maybe_zeroable(&def);
+    Ok(tokens(&format!("{forward}{flex}{zeroable}const _: () = {{\n{thin}}};\n{}",
+                       record(&text, &nums))))
+}
+
+/// Zeroable when every field is - as bindgen's C structs are, deriving
+/// pin_init::MaybeZeroable, and the same way: the for<'__dummy> makes each
+/// bound a condition on the impl, not an error where it doesn't hold. So a
+/// struct holding a Rust type with invariants - a RustOnly - isn't, and
+/// #[derive(Init)] can't zero it. core's atomics are, as their integers are,
+/// though pin_init has no impl for them, and the orphan rule allows none
+/// here: their fields aren't bounds.
+fn maybe_zeroable(def: &cstruct::CStructDef) -> String {
+    let bounds: Vec<String> = def.fields.iter()
+        .filter(|f| !is_core_atomic(&f.ty))
+        .map(|f| format!("{}: for<'__dummy> ::pin_init::Zeroable", f.ty))
+        .collect();
+    let whr = if bounds.is_empty() { String::new() } else { format!("where {}", bounds.join(",\n")) };
+    let (generics, ty) = def.impl_generics();
+    format!("// SAFETY: every field is Zeroable, and padding may be zero\n\
+             #[automatically_derived]\n\
+             unsafe impl{generics} ::pin_init::Zeroable for {ty} {whr} {{}}\n")
+}
+
+/// One of core::sync::atomic's integer, bool or pointer atomics, by any path
+/// - or an array of one - or util/bitmap.rs's AtomicULong, AtomicUsize as C's
+/// unsigned long.
+pub(crate) fn is_core_atomic(ty: &str) -> bool {
+    let ty = ty.trim();
+    let ty = ty.strip_prefix('[').and_then(|t| t.split(';').next()).unwrap_or(ty);
+    let name = ty.trim().split('<').next().unwrap_or("").rsplit("::").next().unwrap_or("").trim();
+    matches!(name, "AtomicBool" | "AtomicPtr" | "AtomicU8" | "AtomicI8" | "AtomicU16" | "AtomicI16" |
+                   "AtomicU32" | "AtomicI32" | "AtomicU64" | "AtomicI64" | "AtomicUsize" | "AtomicIsize" |
+                   "AtomicULong")
+}
+
+/// bitfield_struct::bitfield, recorded - and __NAME_forward!(STRUCT, field),
+/// which #[derive(CStruct)] invokes for a #[c_bitfield] field of this type:
+/// each member's getter and setter on the struct that holds it, as C has a
+/// bitfield's members on its struct. Not `_` members: those are padding.
+///
+/// Members are written as bilge has them, the type giving the width:
+///
+///   #[bitfield(u64, ty = u32)]
+///   pub struct foo_bits { type_: u2, offset: u40, cached: bool, __pad: u3, .. }
+///
+/// `name: uN` is N bits, read and written as N rounded up to an integer -
+/// offset above is a u64; `name: bool` is one bit. A member of any other type -
+/// an enum - gives its width, #[bits(N)], as bitfield-struct has it; a uN or
+/// bool member's #[bits(..)] gives only its options, as #[bits(default = 1)]
+/// does. Members are pub, as C's are, unless written otherwise, and their
+/// forwarders the same - pub(self), for one only its own module may set, has
+/// none. ty is C's declared type of the integer members, which C lays the
+/// bitfield out by - the storage type if not given: the generator's, not
+/// passed on.
+///
+/// With #[derive(CStruct)], the bitfield is itself the C struct - C's
+/// `struct bch_extent_ptr { __u64 type:1, ...; }` - and C's attributes go on
+/// it as on any: #[c_packed], and `align = 8` for __aligned(8), which a u64
+/// bitfield needs said on i386 (Align8U64). It's recorded as the struct and
+/// #[c_bitfield] member the generator knows - as `NAME { bits: NAME_bits }`.
+#[proc_macro_attribute]
+pub fn bitfield(attr: TokenStream, item: TokenStream) -> TokenStream {
+    expand("#[bitfield]", || bitfield_expand(attr, item))
+}
+
+/// `#[vtable]`, on an impl of a trait whose methods are optional - one with
+/// `const HAS_FOO: bool = false` for each method foo: `const HAS_FOO: bool =
+/// true` for each the impl defines, unless it says otherwise itself. So a
+/// table of C function pointers made from the trait leaves out what isn't
+/// implemented. The kernel crate's #[vtable] does this too, but from 7.3 its
+/// impls name crate::LocalModule, which only a module!() crate has.
+#[proc_macro_attribute]
+pub fn vtable(attr: TokenStream, item: TokenStream) -> TokenStream {
+    expand("#[vtable]", || {
+        if !attr.is_empty() {
+            return Err("takes no arguments".into());
+        }
+        let mut head: Vec<TokenTree> = item.into_iter().collect();
+        let body = match head.pop() {
+            Some(TokenTree::Group(g)) if g.delimiter() == Delimiter::Brace => g.stream(),
+            _ => return Err("on an impl".into()),
+        };
+
+        // The body's own fns and consts - not those inside a method's body,
+        // which is a group of its own
+        let items: Vec<TokenTree> = body.clone().into_iter().collect();
+        let mut fns = Vec::new();
+        let mut consts = Vec::new();
+        for w in items.windows(2) {
+            if let (TokenTree::Ident(kw), TokenTree::Ident(name)) = (&w[0], &w[1]) {
+                match kw.to_string().as_str() {
+                    "fn"    => fns.push(name.to_string()),
+                    "const" => consts.push(name.to_string()),
+                    _       => {}
+                }
+            }
+        }
+
+        let has: String = fns.iter()
+            .map(|f| format!("HAS_{}", f.to_uppercase()))
+            .filter(|c| !consts.contains(c))
+            .map(|c| format!("const {c}: bool = true;\n"))
+            .collect();
+        let head: TokenStream = head.into_iter().collect();
+        Ok(tokens(&format!("{head} {{ {body} {has} }}")))
+    })
+}
+
+/// `#[placed(Base.field)]`, ahead of `#[pin_data]` and the derives, on a
+/// struct that lives only at Base's field: its At, the field util/place.rs's
+/// Placed is had by, which `#[derive(Init)]` then gives its init() - see
+/// place.rs.
+#[proc_macro_attribute]
+pub fn placed(attr: TokenStream, item: TokenStream) -> TokenStream {
+    expand("#[placed]", || place::placed(attr, item))
+}
+
+/// `#[unsized_vstruct]`, on C's definition of a struct ending in a flexible
+/// array - or `#[unsized_vstruct(tail = [E])]`, `tail = NAME: [E]`, saying
+/// what follows its header: the family of its definitions, one per state -
+/// C's, renamed X__head, and each state's, a DST of the header and its tail -
+/// and X<S>, a generic struct over the one for S. See vstructs.rs.
+#[proc_macro_attribute]
+pub fn unsized_vstruct(attr: TokenStream, item: TokenStream) -> TokenStream {
+    expand("#[unsized_vstruct]", || vstructs::unsized_vstruct(attr, item))
+}
+
+/// `#[grown(from = FIELD)]`, on the definition of a type that grew between
+/// format versions, FIELD the first field an older value may lack: X<S>, a
+/// generic struct - X<Whole>, X, the whole struct; X<Validated>, the floor
+/// and the bytes there are, at the value's length. See vstructs.rs.
+#[proc_macro_attribute]
+pub fn grown(attr: TokenStream, item: TokenStream) -> TokenStream {
+    expand("#[grown]", || vstructs::grown(attr, item))
+}
+
+/// `#[counted]`, `#[counted(PATH)]`, `#[counted(PATH, tail = [E])]` or
+/// `tail = NAME: [E]`, on C's definition of a header and an array it counts
+/// in elements: its family, the count private in each state's definition -
+/// see vstructs.rs.
+#[proc_macro_attribute]
+pub fn counted(attr: TokenStream, item: TokenStream) -> TokenStream {
+    expand("#[counted]", || vstructs::counted(attr, item))
+}
+
+/// `#[whole]`, on C's definition of a type every valid value of which has
+/// all of it - a superblock section or journal entry of fixed fields: its
+/// family, every state all of it, at the value's length - see vstructs.rs.
+#[proc_macro_attribute]
+pub fn whole(attr: TokenStream, item: TokenStream) -> TokenStream {
+    expand("#[whole]", || vstructs::whole(attr, item))
+}
+
+fn bitfield_expand(attr: TokenStream, item: TokenStream) -> Result<TokenStream, String> {
+    let args = bitfield_args(attr)?;
+    let s = bitfield_struct(item)?;
+    let name = &s.name;
+    if args.align8 && !s.c_struct {
+        return Err(format!("{name}: align = 8 is a C struct's - #[derive(CStruct)]"));
+    }
+
+    // The bitfield's record: a member of a struct in C - when it's the struct
+    // itself, of the struct recorded below, as NAME_bits.
+    let rec_args = match &args.ty {
+        Some(ty) => format!("{}, ty = {ty}", args.storage),
+        None     => args.storage.clone(),
+    };
+    let text = if s.c_struct {
+        format!("#[bitfield({rec_args})] pub struct {name}_bits {}", s.body)
+    } else {
+        format!("#[bitfield({rec_args})] pub struct {name} {}", s.body)
+    };
+    let bf = one_item!(&text, Bitfield, "a bitfield struct");
+    let mut out = record(&text, &[]);
+
+    // update_x(f): set_x(f(x())), each member's, as visible as its setter -
+    // bitfield_struct's, which has the getter and setter but not this.
+    // XXX Deprecated when real field projections arrive: x op= v through a
+    // projected place instead.
+    let mut update = String::new();
+    for (m, ty, _) in &bf.fields {
+        let m = rust_ident(m);
+        if m.starts_with('_') {
+            continue;
+        }
+        let vis = s.vis.iter().find(|(n, _)| *n == m).map_or("pub", |(_, v)| v.as_str());
+        update.push_str(&format!(
+            "#[allow(dead_code)]\n\
+             {vis} fn update_{m}(&mut self, f: impl FnOnce({ty}) -> {ty}) {{ self.set_{m}(f(self.{m}())) }}\n"));
+    }
+    out.push_str(&format!("impl {name} {{\n{update}}}\n"));
+
+    if s.c_struct {
+        let repr = if args.align8 { "#[repr(C, align(8))]" } else { "#[repr(C)]" };
+        let packed = if s.packed { "#[c_packed]" } else { "" };
+        let text = format!("{repr} #[derive(CStruct)] {packed} \
+                            pub struct {name} {{ #[c_bitfield] pub bits: {name}_bits, }}");
+        one_item!(&text, Struct, "a struct");
+        // the member's: the whole struct
+        let mut nums = size_align(name);
+        nums.insert(2, "0".into());
+        nums.extend(size_align(name));
+        out.push_str(&record(&text, &nums));
+    } else {
+        // A member of a C struct: its getters and setters for that struct
+        let mut fns = String::new();
+        for (m, ty, _) in &bf.fields {
+            let m = rust_ident(m);
+            let vis = s.vis.iter().find(|(n, _)| *n == m).map_or("pub", |(_, v)| v.as_str());
+            // pub(self): its module's, which has the bitfield itself
+            if !m.starts_with('_') && vis.replace(' ', "") != "pub(self)" {
+                fns.push_str(&format!(
+                    "{vis} fn {m}(&self) -> {ty} {{ let b = self.$field; b.{m}() }}\n\
+                     {vis} fn set_{m}(&mut self, v: {ty}) {{ let mut b = self.$field; b.set_{m}(v); self.$field = b; }}\n\
+                     {vis} fn update_{m}(&mut self, f: impl FnOnce({ty}) -> {ty}) {{\n\
+                         let mut b = self.$field; b.set_{m}(f(b.{m}())); self.$field = b;\n\
+                     }}\n"));
+            }
+        }
+        out.push_str(&format!(
+            "#[allow(unused_macros)]\n\
+             macro_rules! __{name}_forward {{ ($s:ty, $field:ident) => {{ impl $s {{\n{fns}}} }} }}\n\
+             #[allow(unused_imports)]\npub(crate) use __{name}_forward;\n"));
+    }
+
+    let mut bs_args = vec![args.storage.clone()];
+    bs_args.extend(args.rest.iter().map(|a| a.iter().cloned().collect::<TokenStream>().to_string()));
+    if args.align8 {
+        bs_args.extend(["repr = crate::types::Align8U64", "from = crate::types::Align8U64::from_u64",
+                        "into = crate::types::Align8U64::to_u64"].map(String::from));
+    }
+    // What it holds - its repr, else the storage integer - and nothing else:
+    // so it's Plain
+    let held = if args.align8 {
+        "crate::types::Align8U64".to_string()
+    } else {
+        args.rest.iter()
+            .find_map(|a| key_value(a).filter(|(k, _)| k == "repr").map(|(_, v)| v))
+            .unwrap_or_else(|| args.storage.clone())
+    };
+    // The struct as tokens, not text: an error in a member points at it
+    let mut out = tokens(&out);
+    out.extend(tokens(&format!("#[::bitfield_struct::bitfield({})]", bs_args.join(", "))));
+    out.extend(s.item.clone());
+    out.extend(tokens(&typeinfo::info(name, "Struct", "")));
+    out.extend(tokens(&vstructs::plain(name, &[&held])));
+    out.extend(tokens(&format!(
+        "// SAFETY: Plain - its integer, any bytes of which are one\n\
+         unsafe impl ::pin_init::Zeroable for {name} {{}}\n")));
+    Ok(out)
+}
+
+/// @ts's top-level comma separated items - commas in a type's <..> aren't -
+/// less empty ones: a trailing comma's.
+fn comma_list(ts: TokenStream) -> Vec<Vec<TokenTree>> {
+    let mut items = vec![Vec::new()];
+    let mut depth = 0;
+    // a '>' of => or -> closes nothing
+    let mut arrow = false;
+    for t in ts {
+        let joint_arrow = matches!(&t, TokenTree::Punct(p)
+                                   if matches!(p.as_char(), '=' | '-') && p.spacing() == Spacing::Joint);
+        match &t {
+            TokenTree::Punct(p) if p.as_char() == '<' => depth += 1,
+            TokenTree::Punct(p) if p.as_char() == '>' && !arrow => depth -= 1,
+            TokenTree::Punct(p) if p.as_char() == ',' && depth == 0 => {
+                items.push(Vec::new());
+                arrow = false;
+                continue;
+            }
+            _ => {}
+        }
+        arrow = joint_arrow;
+        items.last_mut().unwrap().push(t);
+    }
+    items.retain(|i| !i.is_empty());
+    items
+}
+
+/// `KEY = VALUE`: KEY, and VALUE as text.
+fn key_value(toks: &[TokenTree]) -> Option<(String, String)> {
+    match toks {
+        [TokenTree::Ident(k), TokenTree::Punct(eq), v @ ..] if eq.as_char() == '=' && !v.is_empty() =>
+            Some((k.to_string(), v.iter().cloned().collect::<TokenStream>().to_string())),
+        _ => None,
+    }
+}
+
+/// @span's location, as the macro's: an error points there, while what's
+/// generated from it - bitfield-struct's with_type__checked() of a member
+/// type_ - isn't linted as written code.
+fn at(span: Span) -> Span {
+    Span::call_site().located_at(span)
+}
+
+/// @ts, every token at(@span): for what a macro makes in place of what's
+/// written.
+fn respan(ts: TokenStream, span: Span) -> TokenStream {
+    let span = at(span);
+    ts.into_iter().map(|t| match t {
+        TokenTree::Group(g) => {
+            let mut n = Group::new(g.delimiter(), respan(g.stream(), span));
+            n.set_span(span);
+            n.into()
+        }
+        mut t => { t.set_span(span); t }
+    }).collect()
+}
+
+/// #[bitfield]'s arguments: bitfield-struct's, its storage first, and ours.
+struct BitfieldArgs {
+    storage: String,
+    /// The rest of bitfield-struct's
+    rest:    Vec<Vec<TokenTree>>,
+    /// `ty = T`: C's declared type of the integer members
+    ty:      Option<String>,
+    /// `align = 8`: C's __aligned(8), on a u64 bitfield that's a C struct
+    align8:  bool,
+}
+
+fn bitfield_args(attr: TokenStream) -> Result<BitfieldArgs, String> {
+    let mut rest = comma_list(attr);
+    let storage = match rest.first().map(Vec::as_slice) {
+        Some([TokenTree::Ident(s)]) => s.to_string(),
+        _ => return Err("expected the storage type first: #[bitfield(uN, ..)]".into()),
+    };
+    rest.remove(0);
+    let mut ty = None;
+    let mut align = None;
+    rest.retain(|a| match key_value(a) {
+        Some((k, v)) if k == "ty"    => { ty = Some(v); false }
+        Some((k, v)) if k == "align" => { align = Some(v); false }
+        _ => true,
+    });
+    let align8 = match align.as_deref() {
+        None => false,
+        Some("8") if storage == "u64" => true,
+        Some(n) => return Err(format!("align = {n}: there's only align = 8, on u64 storage")),
+    };
+    Ok(BitfieldArgs { storage, rest, ty, align8 })
+}
+
+/// A #[bitfield] struct, its attributes that are ours taken out: CStruct and
+/// TypeInfo from its derive - C's struct, and we give the TypeInfo - and
+/// #[c_packed].
+struct BitfieldStruct {
+    name:     String,
+    /// The struct, for bitfield-struct: its members canonical
+    item:     TokenStream,
+    /// Its body, those members - for the record
+    body:     TokenStream,
+    /// #[derive(CStruct)]: the bitfield is C's struct, not a member of one
+    c_struct: bool,
+    /// #[c_packed]: C's is __packed
+    packed:   bool,
+    /// Each member's name and visibility
+    vis:      Vec<(String, String)>,
+}
+
+fn bitfield_struct(item: TokenStream) -> Result<BitfieldStruct, String> {
+    let mut s = BitfieldStruct { name: String::new(), item: TokenStream::new(),
+                                 body: TokenStream::new(), c_struct: false, packed: false,
+                                 vis: Vec::new() };
+    let mut toks = item.into_iter().peekable();
+    while let Some(t) = toks.next() {
+        match t {
+            TokenTree::Punct(p) if p.as_char() == '#' => {
+                let Some(TokenTree::Group(attr)) = toks.next() else {
+                    return Err("expected an attribute after #".into());
+                };
+                if let Some(attr) = attr_less_ours(attr, &mut s) {
+                    s.item.extend([TokenTree::Punct(p), attr.into()]);
+                }
+            }
+            TokenTree::Ident(i) if i.to_string() == "struct" => {
+                if let Some(TokenTree::Ident(n)) = toks.peek() {
+                    s.name = n.to_string();
+                }
+                s.item.extend([TokenTree::Ident(i)]);
+            }
+            TokenTree::Group(g) if g.delimiter() == Delimiter::Brace => {
+                let (members, vis) = bitfield_members(g.stream())?;
+                s.vis = vis;
+                let mut body = Group::new(Delimiter::Brace, members);
+                body.set_span(g.span());
+                s.body.extend([TokenTree::Group(body.clone())]);
+                s.item.extend([TokenTree::Group(body)]);
+            }
+            t => s.item.extend([t]),
+        }
+    }
+    if s.name.is_empty() {
+        return Err("expected a struct".into());
+    }
+    if s.packed && !s.c_struct {
+        return Err(format!("{}: #[c_packed] is a C struct's - #[derive(CStruct)]", s.name));
+    }
+    Ok(s)
+}
+
+/// @attr, one #[..]'s brackets, less what's ours - see BitfieldStruct - or
+/// None if nothing's left.
+fn attr_less_ours(attr: Group, s: &mut BitfieldStruct) -> Option<Group> {
+    let inner: Vec<TokenTree> = attr.stream().into_iter().collect();
+    match inner.as_slice() {
+        [TokenTree::Ident(a)] if a.to_string() == "c_packed" => {
+            s.packed = true;
+            None
+        }
+        [TokenTree::Ident(a), TokenTree::Group(list)] if a.to_string() == "derive" => {
+            let kept: Vec<Vec<TokenTree>> = comma_list(list.stream()).into_iter()
+                .filter(|path| match path.last().map(|t| t.to_string()).as_deref() {
+                    Some("CStruct") => { s.c_struct = true; false }
+                    Some("TypeInfo") => false,
+                    _ => true,
+                })
+                .collect();
+            if kept.is_empty() {
+                return None;
+            }
+            let list = kept.into_iter().map(|p| p.into_iter().collect::<TokenStream>().to_string())
+                .collect::<Vec<_>>().join(", ");
+            Some(Group::new(Delimiter::Bracket, respan(tokens(&format!("derive({list})")), a.span())))
+        }
+        _ => Some(attr),
+    }
+}
+
+/// A bitfield struct's members, as bitfield-struct has them - see bitfield() -
+/// and each one's name and visibility, for its forwarders.
+fn bitfield_members(body: TokenStream) -> Result<(TokenStream, Vec<(String, String)>), String> {
+    let mut out = TokenStream::new();
+    let mut vis = Vec::new();
+    for m in comma_list(body) {
+        let (member, name, v) = bitfield_member(&m)?;
+        out.extend(member);
+        out.extend([TokenTree::Punct(Punct::new(',', Spacing::Alone))]);
+        vis.push((name, v));
+    }
+    Ok((out, vis))
+}
+
+/// One member: `name: uN` and `name: bool` with their #[bits(N)] and Rust
+/// type, at the span of the type they replace, so an error points there - a
+/// #[bits(..)] of bitfield-struct's options only, default = .., gets the width
+/// put first; one with #[bits(N, ..)] as written. Its visibility as written,
+/// pub if none. With its name and that visibility.
+fn bitfield_member(m: &[TokenTree]) -> Result<(TokenStream, String, String), String> {
+    let mut attrs = 0;
+    // #[bits(..)]: where it is, and its arguments
+    let mut bits: Option<(usize, TokenStream)> = None;
+    while let [TokenTree::Punct(p), TokenTree::Group(g), ..] = &m[attrs..] {
+        if p.as_char() != '#' || g.delimiter() != Delimiter::Bracket {
+            break;
+        }
+        if let [TokenTree::Ident(a), TokenTree::Group(args)] = &g.stream().into_iter().collect::<Vec<_>>()[..] {
+            if a.to_string() == "bits" {
+                bits = Some((attrs, args.stream()));
+            }
+        }
+        attrs += 2;
+    }
+    let mut rest = &m[attrs..];
+    if matches!(rest.first(), Some(TokenTree::Ident(v)) if v.to_string() == "pub") {
+        rest = &rest[1..];
+        if matches!(rest.first(), Some(TokenTree::Group(g)) if g.delimiter() == Delimiter::Parenthesis) {
+            rest = &rest[1..];
+        }
+    }
+    let vis: TokenStream = m[attrs..m.len() - rest.len()].iter().cloned().collect();
+    let [TokenTree::Ident(name), TokenTree::Punct(colon), ty @ ..] = rest else {
+        return Err(format!("expected a member, `name: type`: `{}`", m.iter().cloned().collect::<TokenStream>()));
+    };
+    if colon.as_char() != ':' || ty.is_empty() {
+        return Err(format!("{name}: expected `name: type`"));
+    }
+
+    let width_given = bits.as_ref()
+        .is_some_and(|(_, args)| matches!(args.clone().into_iter().next(), Some(TokenTree::Literal(_))));
+    let mut out = TokenStream::new();
+    let ty: TokenStream = if width_given {
+        out.extend(m[..attrs].iter().cloned());
+        ty.iter().cloned().collect()
+    } else {
+        let [TokenTree::Ident(t)] = ty else {
+            return Err(format!("{name}: a member without #[bits(N)] is uN or bool"));
+        };
+        let (width, rust_ty) = bilge_width(&t.to_string())
+            .ok_or_else(|| format!("{name}: {t}: a member without #[bits(N)] is uN or bool"))?;
+        // the other attributes, then #[bits(N)] with its options
+        for (i, a) in m[..attrs].chunks(2).enumerate() {
+            if bits.as_ref().is_none_or(|(at, _)| *at != i * 2) {
+                out.extend(a.iter().cloned());
+            }
+        }
+        let opts = bits.map(|(_, args)| format!(", {args}")).unwrap_or_default();
+        out.extend(respan(tokens(&format!("#[bits({width}{opts})]")), t.span()));
+        respan(tokens(&rust_ty), t.span())
+    };
+    let vis = if vis.is_empty() { respan(tokens("pub"), name.span()) } else { vis };
+    let vis_text = vis.to_string();
+    out.extend(vis);
+    let mut name = name.clone();
+    name.set_span(at(name.span()));
+    out.extend([TokenTree::Ident(name.clone()), TokenTree::Punct(colon.clone())]);
+    out.extend(ty);
+    Ok((out, name.to_string(), vis_text))
+}
+
+/// A bilge member type's width and the Rust type it's read as: bool, and uN
+/// for N bits as N rounded up to an integer.
+fn bilge_width(t: &str) -> Option<(u32, String)> {
+    if t == "bool" {
+        return Some((1, t.to_string()));
+    }
+    let n: u32 = t.strip_prefix('u')?.parse().ok().filter(|n| (1..=128).contains(n))?;
+    let int = [8, 16, 32, 64, 128].into_iter().find(|w| *w >= n)?;
+    Some((n, format!("u{int}")))
+}
+
+/// C carried as is: c_verbatim!(r#"..."#).
+#[proc_macro]
+pub fn c_verbatim(input: TokenStream) -> TokenStream {
+    expand("c_verbatim!", || {
+        let text = format!("c_verbatim!({input})");
+        one_item!(&text, Verbatim, "one string");
+        Ok(tokens(&record(&text, &[])))
+    })
+}
+
+/// An x-macro list: c_xmacro! { NAME(x) { (args), ... } }. Rust gets
+/// NAME!(cb), which expands to cb! { (args), ... } - and NAME!(cb [..]),
+/// to cb! { [..] (args), ... }: a c_enum! built from lists passes on the
+/// variants so far. cb may be a path.
+///
+/// An entry can be another list, SUB(), or another list through a mapping
+/// macro, SUB(MAP(params) => (args)) - C's #define MAP(params) x(args). Then
+/// NAME!(cb) is a chain of macros, one per list it splices in: each is SUB!
+/// handed the entries so far, which adds SUB's, mapped, and those after,
+/// and calls the next; the last calls cb!. They're named by path, through
+/// crate::cstructs::c - NAME is expanded wherever it's used.
+#[proc_macro]
+pub fn c_xmacro(input: TokenStream) -> TokenStream {
+    expand("c_xmacro!", || xmacro(input, true))
+}
+
+/// An x-macro list C defines, for Rust until its header is converted:
+/// c_xmacro_from_c!(NAME, "header") is c_xmacro! of the header's
+/// #define NAME(), unrecorded - see xmacro_from_c.rs.
+#[proc_macro]
+pub fn c_xmacro_from_c(input: TokenStream) -> TokenStream {
+    expand("c_xmacro_from_c!", || {
+        let (list, path) = xmacro_from_c::read(input)?;
+        let list = list.parse::<TokenStream>().map_err(|_| format!("{list}: not Rust tokens"))?;
+        let mut out = tokens(&format!("const _: &[u8] = include_bytes!({path:?});"));
+        out.extend(xmacro(list, false)?);
+        Ok(out)
+    })
+}
+
+/// An x-macro list's rows, selected: NAME!(xmacro_select [TOKEN => cb])
+/// expands to cb! { (args), ... } of the rows with the identifier TOKEN among
+/// their own tokens - a flag in a flags column, as BKEY_TYPE_ptrs is in
+/// BCH_BKEY_TYPES(). cb may be a path; [TOKEN => cb { args }] hands it args
+/// before the rows, cb! { args (args), ... }. Selecting in a macro_rules!
+/// muncher instead nests an expansion per token, which runs into the
+/// recursion limit as lists grow.
+#[proc_macro]
+pub fn xmacro_select(input: TokenStream) -> TokenStream {
+    expand("xmacro_select!", || {
+        let mut input = input.into_iter();
+        let Some(TokenTree::Group(pre)) = input.next().filter(|t| matches!(t,
+            TokenTree::Group(g) if g.delimiter() == Delimiter::Bracket)) else {
+            return Err("expected [TOKEN => cb] before the list".into());
+        };
+        let pre: Vec<TokenTree> = pre.stream().into_iter().collect();
+        let (token, cb) = match pre.as_slice() {
+            [TokenTree::Ident(token), TokenTree::Punct(eq), TokenTree::Punct(gt), cb @ ..]
+                if eq.as_char() == '=' && gt.as_char() == '>' && !cb.is_empty() => (token.to_string(), cb),
+            _ => return Err("expected [TOKEN => cb] before the list".into()),
+        };
+        let (cb, args) = match cb {
+            [cb @ .., TokenTree::Group(g)] if g.delimiter() == Delimiter::Brace => (cb, g.stream().to_string()),
+            cb => (cb, String::new()),
+        };
+        let cb = cb.iter().cloned().collect::<TokenStream>();
+
+        let mut rows = Vec::new();
+        for t in input {
+            match t {
+                TokenTree::Group(g) if g.delimiter() == Delimiter::Parenthesis => {
+                    if g.stream().into_iter().any(|t| matches!(&t, TokenTree::Ident(i) if i.to_string() == token)) {
+                        rows.push(g.to_string());
+                    }
+                }
+                TokenTree::Punct(p) if p.as_char() == ',' => {}
+                t => return Err(format!("expected a list of (args) rows, found {t}")),
+            }
+        }
+        Ok(tokens(&format!("{cb}! {{ {args} {} }}", rows.join(", "))))
+    })
+}
+
+/// c_xmacro!, its record only if @recorded: a list C defines has none.
+fn xmacro(input: TokenStream, recorded: bool) -> Result<TokenStream, String> {
+    let text = format!("c_xmacro! {{ {input} }}");
+    let x = one_item!(&text, XMacro, "NAME(x) { (args), ... }");
+    let name = &x.name;
+    // The list: the brace group after NAME(x), past any attributes - its
+    // entries, as text.
+    let list = input.into_iter()
+        .filter_map(|t| match t {
+            TokenTree::Group(g) if g.delimiter() == Delimiter::Brace => Some(g.stream()),
+            _ => None,
+        })
+        .last()
+        .expect("parse_items found the list");
+    let entries: Vec<String> = comma_list(list).into_iter()
+        .map(|e| e.into_iter().collect::<TokenStream>().to_string())
+        .collect();
+
+    let mut out = if recorded { record(&text, &[]) } else { String::new() };
+    let subs: Vec<usize> = x.entries.iter().enumerate()
+        .filter(|(_, e)| matches!(e, CXEntry::Sub { .. }))
+        .map(|(i, _)| i)
+        .collect();
+
+    if subs.is_empty() {
+        let list = entries.join(", ");
+        out.push_str(&format!(
+            "#[allow(unused_macros)]\n\
+             macro_rules! {name} {{ ($($cb:ident)::+ $([$($pre:tt)*])?) => {{ $($cb)::+! {{ $([$($pre)*])? {list} }} }} }}\n\
+             #[allow(unused_imports)]\npub(crate) use {name};\n"));
+        return Ok(tokens(&out));
+    }
+
+    // The plain entries before the first list spliced in, between each and
+    // the next, and after the last.
+    let lits = |from: usize, to: usize| -> String {
+        entries[from..to].iter().map(|e| format!("{e}, ")).collect()
+    };
+    let path = "crate::cstructs::c";
+    let carry = "($($cb)::+) ($($pre)?)";
+    for (n, &i) in subs.iter().enumerate() {
+        let CXEntry::Sub { map, .. } = &x.entries[i] else { unreachable!() };
+        let (pattern, mapped) = match map {
+            None => ("($($e:tt)*)".to_string(), "($($e)*)".to_string()),
+            Some(m) => {
+                let pattern = format!("({})", m.params.iter().map(|p| format!("${p}:tt")).collect::<Vec<_>>().join(", "));
+                // The template: params are $p, A##p is pasted.
+                let arg = |a: &str| -> String {
+                    let parts: Vec<String> = a.split("##").map(|p| {
+                        let p = p.trim();
+                        if m.params.iter().any(|q| q == p) { format!("${p}") } else { p.to_string() }
+                    }).collect();
+                    if parts.len() == 1 { parts[0].clone() } else { format!("[<{}>]", parts.join(" ")) }
+                };
+                (pattern, format!("({})", m.template.split(',').map(arg).collect::<Vec<_>>().join(", ")))
+            }
+        };
+        let after = lits(i + 1, subs.get(n + 1).copied().unwrap_or(entries.len()));
+        let acc = format!("$($acc)* $({mapped},)* {after}");
+        let next = match subs.get(n + 1) {
+            Some(&j) => {
+                let CXEntry::Sub { list: next_list, .. } = &x.entries[j] else { unreachable!() };
+                format!("{path}::{next_list}!({path}::__{name}_{} [{carry} {acc}]);", n + 1)
+            }
+            None => format!("$($cb)::+! {{ $($pre)? {acc} }}"),
+        };
+        out.push_str(&format!(
+            "#[allow(unused_macros)]\n\
+             macro_rules! __{name}_{n} {{\n\
+                 ([($($cb:ident)::+) ($($pre:tt)?) $($acc:tt)*] $({pattern}),* $(,)?) => {{ ::paste::paste! {{ {next} }} }};\n\
+             }}\n\
+             #[allow(unused_imports)]\npub(crate) use __{name}_{n};\n"));
+    }
+    // The callback's [pre] bracketed, as the plain list's: an optional single
+    // tt after a path callback is ambiguous with its `::`.
+    let CXEntry::Sub { list: first, .. } = &x.entries[subs[0]] else { unreachable!() };
+    out.push_str(&format!(
+        "#[allow(unused_macros)]\n\
+         macro_rules! {name} {{ ($($cb:ident)::+ $([$($pre:tt)*])?) => {{ {path}::{first}!({path}::__{name}_0 [($($cb)::+) ($([$($pre)*])?) {}]); }} }}\n\
+         #[allow(unused_imports)]\npub(crate) use {name};\n",
+        lits(0, subs[0])));
+    Ok(tokens(&out))
+}
+
+/// An enum, and what its values can be (fs/enum_kind.h):
+///
+///   c_enum! { #[open] pub enum btree_id: u32 { BTREE_ID_extents = 0, ... } }
+///
+/// Each value is also a constant of the module, of the integer type - C's
+/// enum constants are all one namespace, and C refers to them by bare name:
+/// in other enums' values, array lengths. The type is built on those:
+///
+///   #[closed]  a Rust enum
+///   #[open]    a newtype over the integer, the values its constants: a value
+///              from outside can be anything, so it's Plain, and a word a
+///              Volatile can hold
+///   #[flags]   a bitflags type
+///
+/// Any of them can be a #[bitfield]'s member, as C's `enum btree_id
+/// btree_id:8`: it has the const into_bits() bitfield-struct converts with,
+/// and from_bits() - for #[flags], bitflags' from_bits() is the checked one,
+/// so a member names `from = T::from_bits_retain`. A #[closed] enum's member
+/// only ever holds one of its values, as its type says; from_bits() of
+/// anything else is memory corruption, and panics.
+///
+/// `_` for the name: an anonymous enum, the constants alone. A variant with
+/// no value is the one before it plus one, as in C.
+#[proc_macro]
+pub fn c_enum(input: TokenStream) -> TokenStream {
+    expand("c_enum!", || {
+        let text = format!("c_enum! {{ {input} }}");
+        let e = one_item!(&text, Enum, C_ENUM_SYNTAX);
+        Ok(match e.from.first() {
+            Some((_, f)) => through_list(&f.list, "cstruct_macros::__c_enum", input),
+            None => c_enum_gen(&e, &text),
+        })
+    })
+}
+
+const C_ENUM_SYNTAX: &str = "#[open|closed|flags] pub enum NAME: REPR { ... }";
+
+/// c_enum!'s list's callback: { [decl] (entry), (entry), ... } - the enum
+/// with its first list's variants in their place: through the next list, if
+/// it has another, or recorded so.
+#[doc(hidden)]
+#[proc_macro]
+pub fn __c_enum(input: TokenStream) -> TokenStream {
+    expand("c_enum!", || {
+        let (decl, entries) = list_callback(input)?;
+        let mut e = one_item!(&format!("c_enum! {{ {decl} }}"), Enum, C_ENUM_SYNTAX);
+        expand_enum_list(&mut e, &entries)
+            .map_err(|err| format!("{}: {err}", e.name.as_deref().unwrap_or("_")))?;
+        let decl = enum_text(&e);
+        Ok(match e.from.first() {
+            Some((_, f)) => through_list(&f.list, "cstruct_macros::__c_enum", tokens(&decl)),
+            None => c_enum_gen(&e, &format!("c_enum! {{ {decl} }}")),
+        })
+    })
+}
+
+/// c_enum! @e's Rust, and its record, of @text.
+fn c_enum_gen(e: &CEnumDef, text: &str) -> TokenStream {
+    let repr = &e.repr;
+
+    // A variant with no value counts from the last that has one - not from
+    // the one before it, which would make a const chain as long as the enum:
+    // too deep for rustc, at bch_persistent_counters' hundreds.
+    let mut out = String::new();
+    let mut base: Option<&str> = None;
+    let mut n = 0;
+    for CEnumVariant { name: v, value, .. } in &e.variants {
+        let value = match (value, base) {
+            (Some(x), _) => {
+                base = Some(v);
+                n = 0;
+                x.clone()
+            }
+            (None, Some(b)) => format!("{b} + {n}"),
+            (None, None) => format!("{n}"),
+        };
+        out.push_str(&format!("#[allow(non_upper_case_globals, dead_code)]\npub const {v}: {repr} = {value};\n"));
+        n += 1;
+    }
+
+    let names: Vec<&str> = e.variants.iter().map(|v| v.name.as_str()).collect();
+    let ty = match &e.name {
+        Some(n) => n.clone(),
+        None => repr.clone(),
+    };
+    if let Some(name) = &e.name {
+        let cfi = cfi_encoding(name);
+        match e.kind {
+            CEnumKind::Closed => {
+                out.push_str(&format!(
+                    "#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, crate::util::ToText)]\n\
+                     #[repr({repr})]\n{cfi}pub enum {name} {{\n"));
+                for v in &e.variants {
+                    // what it prints as: its list's name for it, as C's string table has it
+                    if let Some(l) = &v.label {
+                        out.push_str(&format!("    #[label({l:?})]\n"));
+                    }
+                    out.push_str(&format!("    {0} = {0},\n", v.name));
+                }
+                out.push_str(&format!("}}\nimpl {name} {{\n    pub const fn from_bits(v: {repr}) -> Self {{\n        match v {{\n"));
+                for v in &names {
+                    out.push_str(&format!("            x if x == Self::{v} as {repr} => Self::{v},\n"));
+                }
+                out.push_str(&format!(
+                    "            _ => panic!(\"{name}::from_bits(): not a {name}\"),\n        }}\n    }}\n\
+                     pub const fn into_bits(self) -> {repr} {{ self as {repr} }}\n}}\n"));
+            }
+            CEnumKind::Open => {
+                out.push_str(&format!(
+                    "#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Hash)]\n\
+                     #[repr(transparent)]\n{cfi}pub struct {name}(pub {repr});\n\
+                     #[allow(non_upper_case_globals)]\nimpl {name} {{\n"));
+                for v in &names {
+                    out.push_str(&format!("    pub const {v}: Self = Self({v});\n"));
+                }
+                out.push_str(&format!("    pub const fn from_bits(v: {repr}) -> Self {{ Self(v) }}\n"));
+                out.push_str(&format!("    pub const fn into_bits(self) -> {repr} {{ self.0 }}\n}}\n"));
+                out.push_str(&format!("// SAFETY: its integer, every value of which is one\n\
+                                       unsafe impl crate::util::vstructs::Plain for {name} {{}}\n\
+                                       // SAFETY: its integer's atomic, which zeroes are a value of\n\
+                                       unsafe impl crate::util::projections::AtomicWord for {name} {{\n\
+                                       \x20   type Atomic = <{repr} as crate::util::projections::AtomicWord>::Atomic;\n\
+                                       \x20   fn load(a: &Self::Atomic) -> Self {{\n\
+                                       \x20       Self(<{repr} as crate::util::projections::AtomicWord>::load(a))\n\
+                                       \x20   }}\n\
+                                       \x20   fn store(a: &Self::Atomic, v: Self) {{\n\
+                                       \x20       <{repr} as crate::util::projections::AtomicWord>::store(a, v.0)\n\
+                                       \x20   }}\n\
+                                       }}\n"));
+            }
+            CEnumKind::Flags => {
+                out.push_str(&format!(
+                    "::bitflags::bitflags! {{\n\
+                     #[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Hash)]\n\
+                     #[repr(transparent)]\n{cfi}pub struct {name}: {repr} {{\n"));
+                for v in &names {
+                    out.push_str(&format!("    #[allow(non_upper_case_globals)]\n    const {v} = {v};\n"));
+                }
+                out.push_str(&format!(
+                    "}}\n}}\n\
+                     impl {name} {{\n    pub const fn into_bits(self) -> {repr} {{ self.bits() }}\n}}\n"));
+            }
+        }
+    }
+
+    if let Some(name) = &e.name {
+        out.push_str(&names_gen(e, name));
+        out.push_str(&typeinfo::info(name, "Enum", ""));
+
+        // Zeroed is a value of it - so a struct holding one can be Zeroable:
+        // any integer is an open enum's or flags', a closed enum's only if a
+        // variant is 0 - as written, or the first, counting from 0
+        let has_zero = e.kind != CEnumKind::Closed || e.variants.iter().enumerate()
+            .any(|(i, v)| match &v.value {
+                None    => i == 0,
+                Some(x) => x.trim() == "0",
+            });
+        if has_zero {
+            out.push_str(&format!(
+                "// SAFETY: zero is a {name}\n\
+                 unsafe impl ::pin_init::Zeroable for {name} {{}}\n"));
+        }
+    }
+
+    let mut nums = size_align(&ty);
+    nums.extend(names.iter().map(|v| format!("{v} as u64")));
+    out.push_str(&record(text, &nums));
+    tokens(&out)
+}
+
+/// An enum from an x-macro list - with labelled variants - is named by the
+/// list: util/names.rs's Names, its labelled variants' names and values, a
+/// flags type's bits. An open or flags one prints through it - ToText, and
+/// Display through that - unless it's #[own_to_text]; a closed one derives
+/// ToText.
+fn names_gen(e: &CEnumDef, name: &str) -> String {
+    let labelled: Vec<(&str, &str)> = e.variants.iter()
+        .filter_map(|v| v.label.as_deref().map(|l| (l, v.name.as_str())))
+        .collect();
+    if labelled.is_empty() {
+        return String::new();
+    }
+
+    let n = "crate::util::names";
+    let index = |v: &str| match e.kind {
+        CEnumKind::Flags => format!("{n}::bit({v} as u64)"),
+        _                => format!("{v} as u64"),
+    };
+    let entries: Vec<String> = labelled.iter().map(|(l, v)| format!("({l:?}, {})", index(v))).collect();
+
+    let mut out = format!(
+        "impl {n}::Names for {name} {{\n\
+         \x20   const ENTRIES: &'static [(&'static str, u64)] = &[{}];\n\
+         }}\n",
+        entries.join(", "));
+
+    let to_text = match e.kind {
+        _ if e.own_to_text => None,
+        CEnumKind::Closed  => None,
+        CEnumKind::Open    => Some(format!(
+            "{n}::prt_name(out, <Self as {n}::Names>::ENTRIES, self.0 as u64)")),
+        CEnumKind::Flags   => Some(format!(
+            "{n}::prt_flags(out, <Self as {n}::Names>::ENTRIES, self.bits() as u64)")),
+    };
+    // A closed enum's derive gives it name(); an open one's is here
+    if e.kind == CEnumKind::Open && !e.own_to_text {
+        out.push_str(&format!(
+            "impl {name} {{\n\
+             \x20   /// Its name: None for a value this version has none for.\n\
+             \x20   #[inline]\n\
+             \x20   pub fn name(self) -> Option<&'static str> {{ {n}::name_of(<Self as {n}::Names>::ENTRIES, self.0 as u64) }}\n\
+             }}\n"));
+    }
+    if let Some(body) = to_text {
+        out.push_str(&format!(
+            "impl crate::util::ToText for {name} {{\n\
+             \x20   #[inline]\n\
+             \x20   fn to_text(&self, out: &mut crate::util::Printbuf) {{ {body} }}\n\
+             }}\n\
+             crate::display_via_to_text!({name});\n"));
+    }
+    out
+}
+
+/// A type alias - C's typedef: c_typedef! { pub type NAME = TYPE; }, with
+/// #[c("...")] for the C declarator where TYPE's canonical rendering isn't it.
+#[proc_macro]
+pub fn c_typedef(input: TokenStream) -> TokenStream {
+    expand("c_typedef!", || {
+        let text = format!("c_typedef! {{ {input} }}");
+        let t = one_item!(&text, Typedef, "pub type NAME = TYPE;");
+        Ok(tokens(&format!("#[allow(non_camel_case_types)]\npub type {} = {};\n{}",
+                           t.name, t.ty, record(&text, &[]))))
+    })
+}
+
+/// An array published under RCU that C reads:
+///
+///   c_rcu_array! { pub type DiskGroups = RcuArray<c::bch_disk_group_cpu>
+///                  as struct bch_disk_groups_cpu { nr, entries }; }
+///
+/// Rust gets the alias; C the struct its buffer is - `struct NAME { struct
+/// rcu_head rcu; size_t NR; [H's fields;] T ELEMS[]; }`, H's in place, H a
+/// #[repr(C)] struct of the same file - checked against RcuArray's layout. A
+/// field of the alias's type is, to C, `struct NAME __rcu *`.
+#[proc_macro]
+pub fn c_rcu_array(input: TokenStream) -> TokenStream {
+    expand("c_rcu_array!", || {
+        let text = format!("c_rcu_array! {{ {input} }}");
+        let a = one_item!(&text, RcuArray, "pub type ALIAS = RcuArray<T[, H]> as struct NAME { NR, ELEMS };");
+        let nums: Vec<String> = ["NR", "HEAD", "TAIL"].iter()
+            .map(|n| format!("<{}>::{n} as u64", a.ty))
+            .collect();
+        Ok(tokens(&format!("#[allow(non_camel_case_types)]\npub type {} = {};\n{}",
+                           a.alias, a.ty, record(&text, &nums))))
+    })
+}
+
+/// A Rust type with the layout of a C type:
+///
+///   c_same! { struct bkey_s_c == BkeySC<'static> { k, v } }
+///
+/// Only a record: the generator asserts the C type has the Rust type's size
+/// and alignment, and the listed fields its offsets - so Rust can pass one
+/// where C has the other.
+#[proc_macro]
+pub fn c_same(input: TokenStream) -> TokenStream {
+    expand("c_same!", || {
+        let text = format!("c_same! {{ {input} }}");
+        let s = one_item!(&text, Same, "struct NAME == TYPE { fields }");
+        let ty = &s.rust_ty;
+        let mut nums = size_align(ty);
+        nums.extend(s.fields.iter().map(|f| format!("::core::mem::offset_of!({ty}, {f}) as u64")));
+        Ok(tokens(&record(&text, &nums)))
+    })
+}
+
+/// What Rust calls of a C header:
+///
+///   c_extern! {
+///       pub fn bch2_trans_begin(trans: *mut c::btree_trans) -> u32;
+///       pub static bch2_bkey_ops: [c::bkey_ops; 0];
+///   }
+///
+/// Rust gets the extern "C" block; C the prototypes, generated into the
+/// header the C ones are in - see CExtern. A static that isn't mut is C's
+/// const, and [T; 0] its unsized array: `extern const struct bkey_ops
+/// bch2_bkey_ops[];`.
+#[proc_macro]
+pub fn c_extern(input: TokenStream) -> TokenStream {
+    expand("c_extern!", || {
+        let text = format!("c_extern! {{ {input} }}");
+        let ex = one_item!(&text, Extern, "fns and statics");
+
+        let mut decls = String::new();
+        let mut asserts = String::new();
+        for f in &ex.fns {
+            let mut params: Vec<String> = f.params.iter().map(|(n, ty)| format!("{n}: {ty}")).collect();
+            if f.variadic {
+                params.push("...".into());
+            }
+            let ret = f.ret.as_ref().map(|r| format!(" -> {r}")).unwrap_or_default();
+            let must_use = if f.must_use { "#[must_use] " } else { "" };
+            let cold = if f.cold { "#[cold] " } else { "" };
+            decls.push_str(&format!("{}{must_use}{cold}pub fn {}({}){ret};\n", cfg_attr(&f.cfg), f.name,
+                                    params.join(", ")));
+            asserts.push_str(&thin_pointers(&f.name, &f.cfg, &f.params, f.ret.as_deref()));
+        }
+        for s in &ex.statics {
+            let m = if s.mutable { "mut " } else { "" };
+            decls.push_str(&format!("{}pub static {m}{}: {};\n", cfg_attr(&s.cfg), s.name, s.ty));
+        }
+        let cfg = cfg_attr(&ex.cfg);
+        Ok(tokens(&format!("{cfg}unsafe extern \"C\" {{\n{decls}}}\n\
+                            {cfg}const _: () = {{\n{asserts}}};\n\
+                            {}", record(&text, &[]))))
+    })
+}
+
+/// @ty, a field's type, with @lifetimes - its struct's - 'static: for a check
+/// outside the struct's generics, of what no lifetime changes.
+fn static_lifetimes(ty: &str, lifetimes: &[String]) -> String {
+    let mut out = String::new();
+    let mut rest = ty;
+    while let Some(i) = rest.find('\'') {
+        out.push_str(&rest[..i]);
+        let after = &rest[i + 1..];
+        let len = after.find(|ch: char| !(ch.is_alphanumeric() || ch == '_')).unwrap_or(after.len());
+        let lt = &rest[i..i + 1 + len];
+        out.push_str(if lifetimes.iter().any(|l| l == lt) { "'static" } else { lt });
+        rest = &after[len..];
+    }
+    out.push_str(rest);
+    out
+}
+
+/// That each pointer fn @name passes C - parameters @params, return type
+/// @ret - is one: a compile error if it's fat, a pointer to an unsized type,
+/// whose metadata C has nowhere for. improper_ctypes can't say so: rustc
+/// doesn't report it in what a proc macro generates. A pointer to an unsized
+/// vstruct is to its header, Head<T>, which is C's struct.
+fn thin_pointers(name: &str, cfg: &Option<cstruct::Cfg>, params: &[(String, String)], ret: Option<&str>) -> String {
+    params.iter()
+        .map(|(n, ty)| (n.as_str(), ty.as_str()))
+        .chain(ret.map(|r| ("its return", r)))
+        .filter(|(_, ty)| ty.trim_start().starts_with(['*', '&']))
+        .map(|(n, ty)| format!(
+            "{}assert!(::core::mem::size_of::<{ty}>() == ::core::mem::size_of::<*const u8>(),\n\
+                     \"{name}: {n}'s {ty} is a fat pointer, which C has no place for - \
+                      a pointer to an unsized vstruct T is to Head<T>\");\n",
+            cfg_attr(cfg)))
+        .collect()
+}
+
+/// A Rust fn C calls:
+///
+///   #[c_export]
+///   pub fn bch2_xattr_validate(c: &Opaque<c::bch_fs>, k: BkeySC<'_>,
+///                              from: &c::bkey_validate_context) -> c_int { .. }
+///
+/// C gets the prototype, as c_extern!'s, from the fn's signature - in
+/// foo/bar_gen.h, for a fn in foo/bar.rs - each Rust type as C's
+/// (cstruct.rs, c_export_type()): &Opaque<bch_fs> is struct bch_fs *,
+/// BkeySC struct bkey_s_c. An extern "C" fn is the symbol C calls, made
+/// #[no_mangle]. Any other is called through a definition with exactly C's
+/// signature, made here, which transmutes what isn't C's type: kCFI checks
+/// every call through a pointer against a hash of the callee's type, and a fn
+/// in Rust's types (&Opaque<bch_fs>, BkeySC) never hashes as C's prototype
+/// does.
+///
+/// And a static C reads - an ops table:
+///
+///   #[c_export]
+///   pub static bch2_xattr_handlers: [*const c::xattr_handler; 6] = [..];
+///
+/// C gets its extern declaration, `extern const struct xattr_handler *const
+/// bch2_xattr_handlers[6];`; Rust a CStatic<T>, which derefs to the T. A fn
+/// pointer in one has to be to an extern "C" fn in C's types, for kCFI.
+/// #[c("...")] after #[c_export] is the declaration, where the Rust type
+/// doesn't say it - or C's isn't const, as attribute_group's attrs aren't.
+#[proc_macro_attribute]
+pub fn c_export(attr: TokenStream, item: TokenStream) -> TokenStream {
+    expand("#[c_export]", || c_export_expand(attr, item))
+}
+
+/// @toks without their #[@name(..)] attributes.
+fn without_attr(toks: &[TokenTree], name: &str) -> TokenStream {
+    let is_attr = |t: &TokenTree| matches!(t, TokenTree::Group(g)
+        if g.delimiter() == Delimiter::Bracket &&
+           matches!(g.stream().into_iter().next(), Some(TokenTree::Ident(i)) if i.to_string() == name));
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i < toks.len() {
+        if matches!(&toks[i], TokenTree::Punct(p) if p.as_char() == '#') && toks.get(i + 1).is_some_and(is_attr) {
+            i += 2;
+        } else {
+            out.push(toks[i].clone());
+            i += 1;
+        }
+    }
+    out.into_iter().collect()
+}
+
+fn c_export_expand(attr: TokenStream, item: TokenStream) -> Result<TokenStream, String> {
+    if !attr.is_empty() {
+        return Err("takes no arguments".into());
+    }
+    if item.clone().into_iter().any(|t| matches!(&t, TokenTree::Ident(i) if i.to_string() == "static")) {
+        return c_export_static(item);
+    }
+    // What the record has: the signature, the body dropped - and $crate,
+    // from a macro_rules!, as the crate this is.
+    let mut sig: Vec<TokenTree> = item.clone().into_iter().collect();
+    if !matches!(sig.pop(), Some(TokenTree::Group(g)) if g.delimiter() == Delimiter::Brace) {
+        return Err("on a fn".into());
+    }
+    let text = |sig: TokenStream| format!("#[c_export] {sig} {{}}").replace("$crate", "crate");
+
+    let e = parse_c_export(&text(sig.iter().cloned().collect()))?;
+    let f = &e.ex.fns[0];
+    let cfg = cfg_attr(&f.cfg);
+    // The record is under the fn's #[cfg], so it exists only where that holds,
+    // and its text has none - which C would get as an #if: before rustc 1.89,
+    // an attribute macro is passed the #[cfg] in front of it, already true,
+    // and in C #[cfg(kernel)] is defined(kernel) - never.
+    let record = format!("{cfg}{}", record(&text(without_attr(&sig, "cfg")), &[]));
+
+    // extern "C": the fn is C's symbol itself
+    if e.extern_c {
+        let mut out = tokens("#[no_mangle]");
+        out.extend(item);
+        out.extend(tokens(&record));
+        return Ok(out);
+    }
+
+    let params: Vec<String> = f.params.iter().map(|(n, ty)| format!("{n}: {ty}")).collect();
+    let args: Vec<String> = f.params.iter().zip(&e.params)
+        .map(|((n, c), r)| match r {
+            Some(r) => format!("::core::mem::transmute::<{c}, {r}>({n})"),
+            None    => n.clone(),
+        })
+        .collect();
+    let call = format!("self::{}({})", f.name, args.join(", "));
+    let (ret, call) = match (&f.ret, &e.ret) {
+        (Some(c), Some(r)) => (format!(" -> {c}"), format!("::core::mem::transmute::<{r}, {c}>({call})")),
+        (Some(c), None)    => (format!(" -> {c}"), call),
+        (None, _)          => (String::new(), call),
+    };
+    let thin = thin_pointers(&f.name, &None, &f.params, f.ret.as_deref());
+    let def = format!(
+        "{cfg}const _: () = {{\n\
+             #[allow(unused_imports)]\n\
+             use crate::c;\n\
+             #[no_mangle]\n\
+             #[allow(unused_unsafe, clippy::transmute_ptr_to_ref)]\n\
+             unsafe extern \"C\" fn {name}({params}){ret} {{\n\
+                 unsafe {{ {call} }}\n\
+             }}\n\
+             const _: () = {{\n{thin}}};\n\
+         }};\n\
+         {record}",
+        name = f.name, params = params.join(", "));
+
+    let mut out = item;
+    out.extend(tokens(&def));
+    Ok(out)
+}
+
+/// A #[c_export] static: the symbol C reads - #[no_mangle], in a CStatic,
+/// Sync for the pointers C's structs hold - and C's extern declaration of it,
+/// as a c_extern! static's: `extern const struct foo NAME;`.
+fn c_export_static(item: TokenStream) -> Result<TokenStream, String> {
+    let toks: Vec<TokenTree> = item.into_iter().collect();
+    let text_of = |t: &[TokenTree]| t.iter().cloned().collect::<TokenStream>().to_string();
+    let is_punct = |t: &TokenTree, c: char| matches!(t, TokenTree::Punct(p) if p.as_char() == c);
+
+    let s = toks.iter().position(|t| matches!(t, TokenTree::Ident(i) if i.to_string() == "static"))
+        .ok_or("on a fn or a static")?;
+    let (name, colon) = match &toks[s + 1..] {
+        [TokenTree::Ident(n), c, ..] if is_punct(c, ':') && n.to_string() != "mut" => (n.to_string(), s + 2),
+        _ => return Err("expected static NAME: TYPE = EXPR; - not mut".into()),
+    };
+    let eq = (colon + 1..toks.len()).find(|&i| is_punct(&toks[i], '='))
+        .ok_or("a static needs a value")?;
+    if !toks.last().is_some_and(|t| is_punct(t, ';')) {
+        return Err("expected static NAME: TYPE = EXPR;".into());
+    }
+
+    let ty = text_of(&toks[colon + 1..eq]);
+    let expr = text_of(&toks[eq + 1..toks.len() - 1]);
+
+    let text = |prefix: TokenStream|
+        format!("#[c_export] {prefix} static {name}: {ty};").replace("$crate", "crate");
+    let e = cstruct::parse_c_export(&text(toks[..s].iter().cloned().collect()))?;
+    // As a fn's record: under the static's #[cfg], not with it
+    let record = format!("{}{}", cfg_attr(&e.ex.statics[0].cfg),
+                         record(&text(without_attr(&toks[..s], "cfg")), &[]));
+
+    // #[c("...")], C's declaration where the Rust type doesn't say it, is the
+    // record's alone
+    let rust_prefix = without_attr(&toks[..s], "c");
+
+    // SAFETY, of the CStatic: a static C reads is immutable, and its only
+    // parts that aren't Sync are its pointers - to other statics, and fns
+    Ok(tokens(&format!(
+        "#[no_mangle]\n\
+         #[allow(non_upper_case_globals)]\n\
+         {rust_prefix} static {name}: crate::types::CStatic<{ty}> =\n\
+             unsafe {{ crate::types::CStatic::new({expr}) }};\n\
+         {record}")))
+}
+
+/// Integer constants - C's #defines: c_const! { pub const NAME: u32 = EXPR; ... }
+/// Each #define has its type's C type (`5U`); #[c_int] before one, int's, for
+/// a constant C had as a plain number and Rust wants unsigned. The record is
+/// the block's, with each constant's value, in order.
+#[proc_macro]
+pub fn c_const(input: TokenStream) -> TokenStream {
+    expand("c_const!", || {
+        let text = format!("c_const! {{ {input} }}");
+        let consts: Vec<_> = parse_items(&text)?.into_iter()
+            .map(|i| match i { CItem::Const(c) => Some(c), _ => None })
+            .collect::<Option<_>>()
+            .filter(|c: &Vec<_>| !c.is_empty())
+            .ok_or("expected pub const NAME: TYPE = EXPR;")?;
+        let mut out = String::new();
+        let mut nums = Vec::new();
+        for c in &consts {
+            out.push_str(&format!("#[allow(non_upper_case_globals, dead_code)]\npub const {}: {} = {};\n",
+                                  c.name, c.ty, c.value));
+            nums.push(format!("{} as u64", c.name));
+        }
+        Ok(tokens(&format!("{out}{}", record(&text, &nums))))
+    })
+}
+
+/// ioctl numbers, C's _IO*() #defines:
+///
+///   c_ioctl! {
+///       BCH_IOCTL_DISK_ADD = _IOW(0xbc, 4, c::bch_ioctl_disk),
+///       #[c("const char __user *")]
+///       BCHFS_IOC_REINHERIT_ATTRS = _IOR(0xbc, 64, *const core::ffi::c_char),
+///   }
+///
+/// Rust gets a marker type for each, named as the #define, implementing
+/// util::ioctl::Ioctl: the opcode, made by util::ioctl's _IO*() from the
+/// target's own constants, and the argument type. The record carries the
+/// opcodes, and the generated header asserts C's are the same.
+#[proc_macro]
+pub fn c_ioctl(input: TokenStream) -> TokenStream {
+    expand("c_ioctl!", || {
+        let text = format!("c_ioctl! {{ {input} }}");
+        let io = one_item!(&text, Ioctl, "NAME = _IOW(type, nr, ARG), ...");
+
+        let mut out = String::new();
+        let mut opcodes = Vec::new();
+        for e in &io.entries {
+            let (name, dir, ty, nr) = (&e.name, &e.dir, &e.ty, &e.nr);
+            let (arg, opcode) = match &e.arg {
+                Some(a) => (a.as_str(), format!("crate::util::ioctl::{dir}::<{a}>({ty}, {nr})")),
+                None => ("()", format!("crate::util::ioctl::_IO({ty}, {nr})")),
+            };
+            // _IOWR -> dir::WR, _IO -> dir::IO
+            let dir_ty = dir.strip_prefix("_IO").filter(|d| !d.is_empty()).unwrap_or("IO");
+            out.push_str(&format!(
+                "#[allow(non_camel_case_types)]\n\
+                 pub struct {name};\n\
+                 impl crate::util::ioctl::Ioctl for {name} {{\n\
+                     const OPCODE: u32 = {opcode};\n\
+                     type Arg = {arg};\n\
+                     type Dir = crate::util::ioctl::dir::{dir_ty};\n\
+                 }}\n"));
+            opcodes.push(format!("<{name} as crate::util::ioctl::Ioctl>::OPCODE as u64"));
+        }
+        Ok(tokens(&format!("{out}{}", record(&text, &opcodes))))
+    })
+}
+
+/// Bitfields in a flags word: c_bitmask! { LE64_BITMASK(struct foo, field),
+/// strip PREFIX_ { NAME(start, end), ... } }. Rust gets, on foo, name() and
+/// set_name() for each - NAME without PREFIX_, lowercased - as C's NAME() and
+/// SET_NAME(): the bits [start, end) of field, as a u64.
+#[proc_macro]
+pub fn c_bitmask(input: TokenStream) -> TokenStream {
+    expand("c_bitmask!", || bitmask_expand(input))
+}
+
+fn bitmask_expand(input: TokenStream) -> Result<TokenStream, String> {
+    let text = format!("c_bitmask! {{ {input} }}");
+    let b = one_item!(&text, Bitmask, "LE64_BITMASK(struct foo, field), strip PREFIX_ { NAME(start, end), ... }");
+
+    // An LE*_BITMASK field is a little-endian integer - Le32, Le64 - read and
+    // written with get() and set(); a BITMASK one, native.
+    let field = &b.field;
+    let (get, set) = if b.macro_name == "BITMASK" {
+        (format!("self.{field} as u64"), format!("self.{field} = new as _"))
+    } else {
+        (format!("u64::from(self.{field}.get())"), format!("self.{field}.set(new as _)"))
+    };
+
+    // The runtime table of them (typeinfo.rs's BitmaskField): this struct
+    // field's, as a const named for them - bch_sb_flags_0_BITMASKS - which
+    // typeinfo.rs's registry must list, so that a new one can't be left out.
+    let c_struct = b.c_type.trim_start_matches("struct ").trim();
+    let table = format!("{c_struct}_{}_BITMASKS",
+                        field.replace(|c: char| !c.is_alphanumeric(), "_").trim_end_matches('_'));
+    // Each entry's struct as typeinfo names it, C's name: its TypeInfo's - a
+    // family's type in a state has it as X<Whole>
+    let info_ty = match b.rust_type.split_once('<') {
+        Some((x, _)) => format!("{x}<crate::util::vstructs::Whole>"),
+        None         => b.rust_type.clone(),
+    };
+    let struct_name = format!("<{info_ty} as crate::typeinfo::TypeInfo>::INFO.name");
+    let mut table_entries = String::new();
+
+    let mut methods = String::new();
+    let mut setters = String::new();
+    for e in &b.entries {
+        let m = b.method(&e.name);
+        // set_128_bit_macs: the setter's set_ makes it a name already
+        let set_m = match m.strip_prefix('_') {
+            Some(s) if s.starts_with(|c: char| c.is_ascii_digit()) => s,
+            _ => m.as_str(),
+        };
+        let (start, end) = (&e.start, &e.end);
+        table_entries.push_str(&format!(
+            "crate::typeinfo::BitmaskField {{ struct_name: {struct_name}, field: {field:?}, name: {set_m:?}, \
+             lo: ({start}) as u8, hi: ({end}) as u8 }},\n"));
+        // C's LE*_BITMASK() defines NAME_MAX: the largest value it holds
+        methods.push_str(&format!(
+            "#[allow(dead_code)]\n\
+             pub const {}_MAX: u64 = u64::MAX >> (64 - (({end}) - ({start})));\n",
+            m.to_uppercase()));
+        // One bit is a flag: bool, as the accessors on bindgen's structs had it.
+        let one_bit = matches!((start.parse::<u32>(), end.parse::<u32>()), (Ok(s), Ok(e)) if e == s + 1);
+        let (ty, from, to) = if one_bit { ("bool", " != 0", " as u64") } else { ("u64", "", "") };
+        methods.push_str(&format!(
+            "#[allow(dead_code)]\n\
+             pub fn {m}(&self) -> {ty} {{\n\
+                 (({get} >> ({start})) & (u64::MAX >> (64 - (({end}) - ({start}))))){from}\n\
+             }}\n"));
+        // update_x(f): set_x(f(x())). XXX Deprecated when real field
+        // projections arrive: x op= v through a projected place instead.
+        setters.push_str(&format!(
+            "#[allow(dead_code)]\n\
+             pub fn set_{set_m}(&mut self, v: {ty}) {{\n\
+                 let mask = (u64::MAX >> (64 - (({end}) - ({start})))) << ({start});\n\
+                 let new = ({get} & !mask) | (((v{to}) << ({start})) & mask);\n\
+                 {set};\n\
+             }}\n\
+             #[allow(dead_code)]\n\
+             pub fn update_{set_m}(&mut self, f: impl FnOnce({ty}) -> {ty}) {{\n\
+                 self.set_{set_m}(f(self.{m}()))\n\
+             }}\n"));
+    }
+
+    // A family's C struct, X__head: its state definitions, which have C's
+    // fields inline and no DerefMut to it, get the setters too - the getters
+    // they reach through their Deref
+    let state_setters = match b.rust_type.strip_suffix("__head") {
+        Some(family) => format!("__{family}__state_impls! {{\n{setters}}}\n"),
+        None => String::new(),
+    };
+
+    Ok(tokens(&format!(
+        "{}impl {} {{\n{methods}{setters}}}\n\
+         {state_setters}\
+         #[allow(non_upper_case_globals)]\n\
+         pub const {table}: &[crate::typeinfo::BitmaskField] = &[\n{table_entries}];\n\
+         const _: () = assert!(crate::typeinfo::bitmasks_listed({table:?}),\n\
+                               \"{table}: not in typeinfo.rs's BITMASKS - add it\");\n",
+        record(&text, &[]), b.rust_type)))
+}
diff --git a/fs/bcachefs/cstruct-macros/src/options.rs b/fs/bcachefs/cstruct-macros/src/options.rs
new file mode 100644
index 0000000..c2be8b3
--- /dev/null
+++ b/fs/bcachefs/cstruct-macros/src/options.rs
@@ -0,0 +1,373 @@
+// SPDX-License-Identifier: GPL-2.0
+//! `#[derive(Options)]`: bch_opts, the options - a field each, described by
+//! its `#[opt(...)]` and its doc comment, the option's help:
+//!
+//! ```text
+//! /// Filesystem block size
+//! #[opt(uint(512, 1 << 15), flags = fs | format | human_readable, sb = bch_sb::block_size,
+//!       default = 4 << 10, hint = "size")]
+//! pub block_size: u16,
+//! ```
+//!
+//! The type first: `bool`, `uint(min, max)`, `str(Enum)`, `str_nolimit(Enum)`,
+//! `bitfield(Enum[, allowed])`, `with(OPT_FN)`, `str_member(member_field)` -
+//! a string or bitfield option's choices are its enum's Names. Then, each
+//! optional: `flags`, the OPT_* when it may be set, lowercase; `sb`, its
+//! superblock field's getter, `struct::getter`, its setter set_getter, or
+//! `struct::getter / setter`; `default`; `hint`.
+//!
+//! It makes, from the fields in order - each one's id, Opt_name:
+//!
+//! ```text
+//! bch_opt_id               the ids, and bch2_opts_nr - a c_enum!, for C too
+//! bch_opts::TABLE          each option's Opt (opts.rs), by id
+//! bch_opts::DEFAULTS       each one's default, all defined
+//! get(), set(), defined(), apply()   by id; set() sets it defined, in the
+//!                          field `defined`, a bch_opts_mask
+//! name(), set_name()       each option's value - a bool option's as bool, a
+//!                          string option's as its enum - and setting it,
+//!                          defined
+//! name_or_default()        its value, or its default if it isn't defined
+//! ```
+//!
+//! A field without #[opt] isn't an option: `defined`.
+
+use proc_macro::{Delimiter, TokenStream, TokenTree};
+
+use crate::tokens;
+
+struct Field {
+    name: String,
+    ty:   String,
+    opt:  Option<Vec<Vec<TokenTree>>>,
+    doc:  Vec<String>,
+}
+
+/// @ts split at its top level commas.
+fn split_commas(ts: TokenStream) -> Vec<Vec<TokenTree>> {
+    let mut out = vec![Vec::new()];
+    for t in ts {
+        match &t {
+            TokenTree::Punct(p) if p.as_char() == ',' => out.push(Vec::new()),
+            _ => out.last_mut().unwrap().push(t),
+        }
+    }
+    out.retain(|v| !v.is_empty());
+    out
+}
+
+fn text(ts: &[TokenTree]) -> String {
+    ts.iter().cloned().collect::<TokenStream>().to_string()
+}
+
+/// A doc comment's string literal, as the string it is.
+fn unescape(lit: &str) -> Result<String, String> {
+    let s = lit.strip_prefix('"').and_then(|s| s.strip_suffix('"'))
+        .ok_or_else(|| format!("doc comment {lit}: not a plain string literal"))?;
+    let mut out = String::new();
+    let mut chars = s.chars();
+    while let Some(c) = chars.next() {
+        if c != '\\' {
+            out.push(c);
+            continue;
+        }
+        match chars.next() {
+            Some('n')  => out.push('\n'),
+            Some('t')  => out.push('\t'),
+            Some('\\') => out.push('\\'),
+            Some('"')  => out.push('"'),
+            Some('\'') => out.push('\''),
+            other => return Err(format!("doc comment {lit}: escape \\{other:?}")),
+        }
+    }
+    Ok(out)
+}
+
+fn parse_fields(input: TokenStream) -> Result<(String, Vec<Field>), String> {
+    let mut trees = input.into_iter().peekable();
+    let name = loop {
+        match trees.next() {
+            Some(TokenTree::Ident(i)) if i.to_string() == "struct" => match trees.next() {
+                Some(TokenTree::Ident(n)) => break n.to_string(),
+                _ => return Err("expected the struct's name".into()),
+            },
+            Some(_) => {}
+            None => return Err("for a struct".into()),
+        }
+    };
+    let body = trees.find_map(|t| match t {
+        TokenTree::Group(g) if g.delimiter() == Delimiter::Brace => Some(g.stream()),
+        _ => None,
+    }).ok_or("a struct with named fields")?;
+
+    let mut fields = Vec::new();
+    for f in split_commas(body) {
+        let mut opt = None;
+        let mut doc = Vec::new();
+        let mut i = 0;
+        while let (Some(TokenTree::Punct(p)), Some(TokenTree::Group(g))) = (f.get(i), f.get(i + 1)) {
+            if p.as_char() != '#' || g.delimiter() != Delimiter::Bracket {
+                break;
+            }
+            let attr: Vec<TokenTree> = g.stream().into_iter().collect();
+            match attr.as_slice() {
+                [TokenTree::Ident(n), TokenTree::Group(args)] if n.to_string() == "opt" =>
+                    opt = Some(split_commas(args.stream())),
+                [TokenTree::Ident(n), TokenTree::Punct(eq), TokenTree::Literal(l)]
+                    if n.to_string() == "doc" && eq.as_char() == '=' =>
+                    doc.push(unescape(&l.to_string())?),
+                _ => {}
+            }
+            i += 2;
+        }
+        // past the visibility, to `name: type`
+        let rest = &f[i..];
+        let colon = rest.iter().position(|t| matches!(t, TokenTree::Punct(p) if p.as_char() == ':'))
+            .ok_or("a field without a type")?;
+        let Some(TokenTree::Ident(n)) = rest.get(colon - 1) else {
+            return Err("a field without a name".into());
+        };
+        fields.push(Field { name: n.to_string(), ty: text(&rest[colon + 1..]), opt, doc });
+    }
+    Ok((name, fields))
+}
+
+/// An option's Opt, and what its set and get are.
+fn option(f: &Field, args: &[Vec<TokenTree>]) -> Result<String, String> {
+    let name = &f.name;
+    let err = |e: &str| format!("{name}: #[opt]: {e}");
+    let o = "crate::opts";
+
+    // the type: kind(args), or a bare kind
+    let (kind, kargs) = match args.first().map(Vec::as_slice) {
+        Some([TokenTree::Ident(k)]) => (k.to_string(), Vec::new()),
+        Some([TokenTree::Ident(k), TokenTree::Group(g)]) if g.delimiter() == Delimiter::Parenthesis =>
+            (k.to_string(), split_commas(g.stream()).iter().map(|a| text(a)).collect()),
+        _ => return Err(err("the type first: bool, uint(min, max), str(Enum), ...")),
+    };
+    let names = |t: &str| format!("crate::names_by_value!(c::{t})");
+    let (ty, min, max) = match (kind.as_str(), kargs.as_slice()) {
+        ("bool", []) => (format!("{o}::OptType::Bool"), "0".into(), "1".into()),
+        ("uint", [min, max]) => (format!("{o}::OptType::Uint"), format!("({min}) as u64"), format!("({max}) as u64")),
+        ("str", [t]) => (format!("{o}::OptType::Str({})", names(t)), "0".into(),
+                         format!("({}.len() - 1) as u64", names(t))),
+        ("str_nolimit", [t]) => (format!("{o}::OptType::Str({})", names(t)), "0".into(), "u64::MAX".into()),
+        ("bitfield", [t]) => (format!("{o}::OptType::Bitfield {{ choices: {}, allowed: u64::MAX }}", names(t)),
+                              "0".into(), "0".into()),
+        ("bitfield", [t, allowed]) => (format!("{o}::OptType::Bitfield {{ choices: {}, allowed: ({allowed}) as u64 }}",
+                                               names(t)), "0".into(), "0".into()),
+        ("with", [f]) => (format!("{o}::OptType::Fn(&{f})"), "0".into(), "0".into()),
+        ("str_member", [m]) => (format!("{o}::OptType::StrMember {{\n\
+                                            get: |m| &m.{m},\n\
+                                            get_mut: |m| &mut m.{m},\n\
+                                            size: {o}::size_of_field::<c::bch_member, _>(|m| &m.{m}),\n\
+                                         }}"), "0".into(), "0".into()),
+        _ => return Err(err(&format!("{kind}({}): not an option type", kargs.join(", ")))),
+    };
+
+    let mut flags = "0".to_string();
+    let mut sb = "None".to_string();
+    let mut hint = "None".to_string();
+    for a in &args[1..] {
+        let [TokenTree::Ident(k), TokenTree::Punct(eq), v @ ..] = a.as_slice() else {
+            return Err(err(&format!("{}: expected key = value", text(a))));
+        };
+        if eq.as_char() != '=' || v.is_empty() {
+            return Err(err(&format!("{}: expected key = value", text(a))));
+        }
+        match k.to_string().as_str() {
+            "flags" => {
+                let fl: Result<Vec<String>, String> = v.split(|t| matches!(t, TokenTree::Punct(p) if p.as_char() == '|'))
+                    .map(|f| match f {
+                        [TokenTree::Ident(f)] => Ok(format!("OPT_{}", f.to_string().to_uppercase())),
+                        f => Err(err(&format!("flags: {}: not a flag", text(f)))),
+                    })
+                    .collect();
+                flags = fl?.join(" | ");
+            }
+            "sb" => {
+                // host::getter [/ setter]
+                let (get, set) = match v.iter().position(|t| matches!(t, TokenTree::Punct(p) if p.as_char() == '/')) {
+                    Some(i) => (&v[..i], Some(text(&v[i + 1..]))),
+                    None    => (v, None),
+                };
+                let [TokenTree::Ident(host), TokenTree::Punct(_), TokenTree::Punct(_), TokenTree::Ident(getter)] = get else {
+                    return Err(err(&format!("sb = {}: expected struct::getter", text(v))));
+                };
+                let host = match host.to_string().as_str() {
+                    // the head: what either state of a superblock has its fields on
+                    "bch_sb" => "bch_sb__head".to_string(),
+                    h        => h.to_string(),
+                };
+                let set = set.unwrap_or_else(|| format!("set_{getter}"));
+                sb = format!("Some(&{o}::Field::<c::{host}, _> {{ get: |t| t.{getter}(), set: |t, v| t.{set}(v) }} \
+                              as &dyn {o}::SbOpt)");
+            }
+            "default" => {}
+            "hint" => hint = format!("Some({})", text(v)),
+            k => return Err(err(&format!("{k}: not an #[opt] key"))),
+        }
+    }
+
+    let help = match f.doc.is_empty() {
+        true  => "None".to_string(),
+        false => {
+            let lines: Vec<&str> = f.doc.iter().map(|l| l.strip_prefix(' ').unwrap_or(l)).collect();
+            format!("Some({:?})", lines.join("\n"))
+        }
+    };
+
+    Ok(format!(
+        "{o}::Opt {{\n\
+             id:    bch_opt_id::Opt_{name},\n\
+             name:  {name:?},\n\
+             flags: c::opt_flags::from_bits_retain({flags}),\n\
+             ty:    {ty},\n\
+             min:   {min},\n\
+             max:   {max},\n\
+             sb:    {sb},\n\
+             hint:  {hint},\n\
+             help:  {help},\n\
+         }}"))
+}
+
+enum Accessor {
+    Bool,
+    /// A string option's choices' enum, through c_enum!'s from_bits() and
+    /// into_bits(): a closed enum's from_bits() panics on a value that isn't
+    /// one, and a string option's value is an index into its choices - so
+    /// one, unless something set it around the parser.
+    Enum(String),
+    Field,
+}
+
+/// What an option's accessors take and give: a bool option's a bool, a
+/// string option's its enum, the rest the field's own type.
+fn accessor_type(args: &[Vec<TokenTree>]) -> Accessor {
+    match args.first().map(Vec::as_slice) {
+        Some([TokenTree::Ident(k)]) if k.to_string() == "bool" => Accessor::Bool,
+        Some([TokenTree::Ident(k), TokenTree::Group(g)])
+            if matches!(k.to_string().as_str(), "str" | "str_nolimit") =>
+            Accessor::Enum(text(&g.stream().into_iter().collect::<Vec<_>>())),
+        _ => Accessor::Field,
+    }
+}
+
+/// The option's default, from its #[opt]: 0 without one.
+fn default(f: &Field, args: &[Vec<TokenTree>]) -> String {
+    args[1..].iter()
+        .find_map(|a| match a.as_slice() {
+            [TokenTree::Ident(k), TokenTree::Punct(_), v @ ..] if k.to_string() == "default" => Some(text(v)),
+            _ => None,
+        })
+        .map_or_else(|| "0".to_string(), |d| format!("({d}) as {}", f.ty))
+}
+
+pub(crate) fn derive(input: TokenStream) -> Result<TokenStream, String> {
+    let (name, fields) = parse_fields(input)?;
+    let opts: Vec<(&Field, &Vec<Vec<TokenTree>>)> = fields.iter()
+        .filter_map(|f| f.opt.as_ref().map(|o| (f, o)))
+        .collect();
+
+    let ids: String = opts.iter().map(|(f, _)| format!("#[label(\"{0}\")] Opt_{0},\n", f.name)).collect();
+    let table: Result<Vec<String>, String> = opts.iter().map(|(f, a)| option(f, a)).collect();
+    let table = table?.join(",\n");
+    let defaults: String = opts.iter().map(|(f, a)| format!("opts.{} = {};\n", f.name, default(f, a))).collect();
+
+    let arms = |body: &dyn Fn(&Field) -> String| -> String {
+        opts.iter().map(|(f, _)| format!("bch_opt_id::Opt_{} => {},\n", f.name, body(f))).collect()
+    };
+    let get = arms(&|f| format!("self.{} as u64", f.name));
+    let set = arms(&|f| format!("self.{} = v as {}", f.name, f.ty));
+    let apply: String = opts.iter().map(|(f, _)| format!(
+        "if src.defined.test(bch_opt_id::Opt_{0}) {{\n\
+             self.{0} = src.{0};\n\
+             self.defined.set(bch_opt_id::Opt_{0});\n\
+         }}\n", f.name)).collect();
+    let accessors: String = opts.iter().map(|(f, a)| {
+        // what the accessors take and give, and the field from and to it
+        let acc = accessor_type(a);
+        let ty = match &acc {
+            Accessor::Bool    => "bool".to_string(),
+            Accessor::Enum(e) => format!("c::{e}"),
+            Accessor::Field   => f.ty.clone(),
+        };
+        let get = |x: &str| match &acc {
+            Accessor::Bool    => format!("{x} != 0"),
+            Accessor::Enum(e) => format!("c::{e}::from_bits({x} as _)"),
+            Accessor::Field   => x.to_string(),
+        };
+        let set = match &acc {
+            Accessor::Bool    => format!("v as {}", f.ty),
+            Accessor::Enum(_) => format!("v.into_bits() as {}", f.ty),
+            Accessor::Field   => "v".to_string(),
+        };
+        let n = &f.name;
+        format!("pub fn {n}(&self) -> {ty} {{ {} }}\n\
+                 pub fn {n}_or_default(&self) -> {ty} {{\n\
+                     if self.defined(bch_opt_id::Opt_{n}) {{ self.{n}() }} else {{ {} }}\n\
+                 }}\n\
+                 pub fn set_{n}(&mut self, v: {ty}) {{\n\
+                     self.{n} = {set};\n\
+                     self.defined.set(bch_opt_id::Opt_{n});\n\
+                 }}\n", get(&format!("self.{n}")), get(&format!("Self::DEFAULTS.{n}")))
+    }).collect();
+    let nr = opts.len();
+
+    Ok(tokens(&format!(
+        "c_enum! {{\n\
+             #[open]\n\
+             pub enum bch_opt_id: u32 {{\n\
+                 {ids}\
+                 bch2_opts_nr,\n\
+             }}\n\
+         }}\n\
+         \n\
+         const _: () = assert!({nr} <= BCH_OPTS_MAX as usize, \"more options than BCH_OPTS_MAX\");\n\
+         \n\
+         impl {name} {{\n\
+             /// Each option, by bch_opt_id.\n\
+             pub const TABLE: [crate::opts::Opt; {nr}] = [{table}];\n\
+         \n\
+             /// Each option's default, all defined.\n\
+             pub const DEFAULTS: Self = {{\n\
+                 // SAFETY: integers, and the defined bits'\n\
+                 let mut opts: Self = unsafe {{ core::mem::zeroed() }};\n\
+                 {defaults}\
+                 let mut i = 0;\n\
+                 while i < {nr} {{\n\
+                     opts.defined.set(bch_opt_id(i as u32));\n\
+                     i += 1;\n\
+                 }}\n\
+                 opts\n\
+             }};\n\
+         \n\
+             /// Its value for @id - defined or not.\n\
+             pub fn get(&self, id: bch_opt_id) -> u64 {{\n\
+                 match id {{\n\
+                     {get}\
+                     _ => panic!(\"not an option: {{}}\", id.0),\n\
+                 }}\n\
+             }}\n\
+         \n\
+             /// Set, and defined.\n\
+             pub fn set(&mut self, id: bch_opt_id, v: u64) {{\n\
+                 match id {{\n\
+                     {set}\
+                     _ => panic!(\"not an option: {{}}\", id.0),\n\
+                 }}\n\
+                 self.defined.set(id);\n\
+             }}\n\
+         \n\
+             pub fn defined(&self, id: bch_opt_id) -> bool {{\n\
+                 self.defined.test(id)\n\
+             }}\n\
+         \n\
+             /// Those @src defines, set: bch2_opts_apply().\n\
+             pub fn apply(&mut self, src: &Self) {{\n\
+                 {apply}\
+             }}\n\
+         \n\
+             {accessors}\
+         }}\n")))
+}
diff --git a/fs/bcachefs/cstruct-macros/src/place.rs b/fs/bcachefs/cstruct-macros/src/place.rs
new file mode 100644
index 0000000..d60a299
--- /dev/null
+++ b/fs/bcachefs/cstruct-macros/src/place.rs
@@ -0,0 +1,270 @@
+// SPDX-License-Identifier: GPL-2.0
+//! The macro side of util/place.rs - a value's place, the field of a parent
+//! it lives at.
+//!
+//! `#[placed(Base.field)]`, or `#[placed(Base.field[], index = NAME: TYPE)]`
+//! for an element of that array, ahead of `#[pin_data]` and the derives, is
+//! all a placed type says, and all its parent needs - `[..]` for an element
+//! of the Container there is below. It gives the struct:
+//!
+//! - its At field, `#[placed_at]` - `_placed_at`, zero bytes, char[0] to C;
+//!   or an element's index, NAME, its AtIndex C's TYPE - for the derives
+//!   after it to see as any other field: `#[derive(Init)]` gives its init()
+//!   the At to put there;
+//! - Placed - its parent, and its At;
+//! - InitAt for Base's field - its init(), the At from at(), or for an
+//!   array each element's from at_index() - which Base's `#[derive(Init)]`
+//!   picks for the field: so an At is made only for the field it names, and
+//!   nothing is written on the parent;
+//! - its #[cfg]s, on all of these;
+//! - no drop of its own: its container() would see a parent partly dropped.
+//!   A #[pin_data] struct can't impl Drop, and #[pin_data(PinnedDrop)] is
+//!   refused; a struct without #[pin_data] gets an empty Drop, for one of its
+//!   own to conflict with.
+//!
+//! For an element of a Container, it gives the struct its AtIn field, and
+//! PlacedIn, and Base's InitAt for the field - the Container, by
+//! util/place.rs's container() - but neither Placed nor a container() - an
+//! element's place is for the guarantee it never outlives its Base - nor
+//! any rule on its drop. The At field's attributes, #[placed_at] and #[c],
+//! are #[derive(Init)]'s and #[derive(CStruct)]'s, so it has them only if it
+//! has those.
+//!
+//! And `#[derive(Init)]` (init.rs) makes a Field<N> for each field of the
+//! structs it's on, N its name's hash - a field as a type, for the children
+//! placed at it - and initializes one without #[init] with field_init(): its
+//! InitAt, if a placed type lives there, else zeroed.
+
+use proc_macro::{Delimiter, Group, TokenStream, TokenTree};
+
+use crate::cstruct::CFieldDef;
+use crate::tokens;
+
+/// Where #[placed] says a type lives: at Base.field; as an element of the
+/// array there, holding its index as @0, of integer type @1; or as an
+/// element of the Container there.
+enum Kind {
+    Field,
+    Array(String, String),
+    Container,
+}
+
+struct PlaceAttr {
+    base:  String,
+    field: String,
+    kind:  Kind,
+}
+
+fn parse_attr(attr: TokenStream) -> Result<PlaceAttr, String> {
+    let usage = "takes Base.field; Base.field[], index = NAME: TYPE, for an element of the array there, its index \
+                 the field NAME of integer TYPE; or Base.field[..], for an element of the Container there";
+    let attr: String = attr.to_string().chars().filter(|c| !c.is_whitespace()).collect();
+    let (path, index) = match attr.split_once(',') {
+        Some((path, rest)) => {
+            let (name, ty) = rest.strip_prefix("index=").and_then(|r| r.split_once(':'))
+                .ok_or_else(|| format!("{usage} - not {attr:?}"))?;
+            (path, Some((name.to_string(), ty.to_string())))
+        }
+        None => (attr.as_str(), None),
+    };
+    let (path, kind) = if let Some(p) = path.strip_suffix("[..]") {
+        (p, Kind::Container)
+    } else if let Some(p) = path.strip_suffix("[]") {
+        let (name, ty) = index.clone()
+            .ok_or_else(|| format!("{usage}: an array's element names its index - not {attr:?}"))?;
+        (p, Kind::Array(name, ty))
+    } else {
+        (path, Kind::Field)
+    };
+    if index.is_some() && !matches!(kind, Kind::Array(..)) {
+        return Err(format!("{usage}: only an array's element has an index - not {attr:?}"));
+    }
+    let (base, field) = path.rsplit_once('.')
+        .filter(|(b, f)| !b.is_empty() && !f.is_empty() && f.chars().all(|c| c == '_' || c.is_ascii_alphanumeric()))
+        .ok_or_else(|| format!("{usage} - not {attr:?}"))?;
+    Ok(PlaceAttr { base: base.into(), field: field.into(), kind })
+}
+
+/// `#[placed(...)]`: the struct, its At field added, and its impls.
+pub(crate) fn placed(attr: TokenStream, item: TokenStream) -> Result<TokenStream, String> {
+    let PlaceAttr { base, field, kind } = parse_attr(attr)?;
+
+    let mut trees: Vec<TokenTree> = item.into_iter().collect();
+
+    // Its outer attributes - #[pin_data], its derives, its #[cfg]s - then the
+    // struct keyword and its name
+    let mut pin_data: Option<bool> = None;  // whether PinnedDrop
+    let mut cstruct = false;                // whether C has it
+    let mut init = false;                   // whether #[derive(Init)]'s
+    let mut cfgs = String::new();           // for its impls too
+    let mut i = 0;
+    while let (Some(TokenTree::Punct(p)), Some(TokenTree::Group(g))) = (trees.get(i), trees.get(i + 1)) {
+        if p.as_char() != '#' || g.delimiter() != Delimiter::Bracket {
+            break;
+        }
+        let a: String = g.stream().to_string().chars().filter(|c| !c.is_whitespace()).collect();
+        let path = a.split('(').next().unwrap_or_default();
+        if path == "pin_data" || path.ends_with("::pin_data") {
+            pin_data = Some(a.contains("PinnedDrop"));
+        }
+        if path == "derive" {
+            cstruct |= a.contains("CStruct");
+            init |= a.contains("Init");
+        }
+        if path == "cfg" {
+            cfgs.push_str(&format!("#[{}]\n", g.stream()));
+        }
+        i += 2;
+    }
+    let kw = trees[i..].iter()
+        .position(|t| matches!(t, TokenTree::Ident(id) if id.to_string() == "struct"))
+        .map(|k| k + i)
+        .ok_or("is for a struct with named fields")?;
+    let name = match trees.get(kw + 1) {
+        Some(TokenTree::Ident(id)) => id.to_string(),
+        _ => return Err("is for a struct with named fields".into()),
+    };
+    if matches!(trees.get(kw + 2), Some(TokenTree::Punct(p)) if p.as_char() == '<') {
+        return Err(format!("{name}: a placed type has no generics"));
+    }
+
+    // Its At, and the field it's in: an element's index, as C names it, or
+    // a field of no bytes
+    let n = format!("{{ crate::util::place::name({field:?}) }}");
+    let (at, at_field, at_decl) = match &kind {
+        Kind::Field => (
+            format!("crate::util::place::At<{base}, {n}>"),
+            AT_FIELD.to_string(),
+            format!("char {AT_FIELD}[0]"),
+        ),
+        Kind::Array(idx, ty) => {
+            let c_ty = match crate::cstruct::field_type(ty)? {
+                crate::cstruct::FieldType::Named { c: Some(c), .. } => c,
+                _ => return Err(format!("{name}: its index, {idx}: {ty}, isn't an integer C has")),
+            };
+            (format!("crate::util::place::AtIndex<{base}, {n}, {ty}>"), idx.clone(), format!("{c_ty} {idx}"))
+        }
+        Kind::Container => (
+            format!("crate::util::place::AtIn<{name}>"),
+            AT_FIELD.to_string(),
+            format!("char {AT_FIELD}[0]"),
+        ),
+    };
+
+    // The At field, last
+    let body = match trees.last() {
+        Some(TokenTree::Group(g)) if g.delimiter() == Delimiter::Brace => g.stream(),
+        _ => return Err(format!("{name}: is for a struct with named fields")),
+    };
+    let sep = match body.clone().into_iter().last() {
+        None => "",
+        Some(TokenTree::Punct(p)) if p.as_char() == ',' => "",
+        _ => ",",
+    };
+    // #[derive(Init)]'s init() takes the At, and C has a declaration of it -
+    // if they're there: the attributes are theirs
+    let init_attr = if init { "#[placed_at]" } else { "" };
+    let c_attr = if cstruct { format!("#[c(\"{at_decl}\")]") } else { String::new() };
+    let body = tokens(&format!("{body}{sep} {init_attr} {c_attr} pub(crate) {at_field}: {at},"));
+    *trees.last_mut().unwrap() = TokenTree::Group(Group::new(Delimiter::Brace, body));
+    let item: TokenStream = trees.into_iter().collect();
+
+    let init_at = |init: &str| format!(
+        "{cfgs}#[automatically_derived]\n\
+         // SAFETY: init() is Base's for {field}, which {base}'s #[derive(Init)]\n\
+         // runs it into, the field it's for\n\
+         unsafe impl crate::util::place::InitAt<{n}> for {base} {{\n\
+             unsafe fn init() -> impl ::pin_init::PinInit<\n\
+                 <Self as crate::util::place::Field<{n}>>::Type,\n\
+                 crate::errcode::BchError>\n\
+             {{\n\
+                 // SAFETY: the caller's\n\
+                 unsafe {{ {init} }}\n\
+             }}\n\
+         }}\n");
+
+    // A field's or an array element's: Placed, its InitAt, and no drop of
+    // its own. A container's element: PlacedIn, its container's InitAt -
+    // and its drop is its own, the container whole while it runs
+    let impls = match &kind {
+        Kind::Field | Kind::Array(..) => {
+            if pin_data == Some(true) {
+                return Err(format!("{name}: a placed type has no drop of its own - its container() would see a \
+                                    parent partly dropped - so not #[pin_data(PinnedDrop)]"));
+            }
+            let init = match &kind {
+                Kind::Field => format!("crate::util::place::at({name}::init)"),
+                _ => format!("::pin_init::pin_init_array_from_fn(|i| unsafe {{ \
+                              crate::util::place::at_index(i, {name}::init) }})"),
+            };
+            // #[pin_data]'s own check refuses a Drop; without it, this is the
+            // one a Drop of its own would conflict with
+            let no_drop = match pin_data {
+                Some(_) => String::new(),
+                None => format!("{cfgs}#[automatically_derived]\n\
+                                 impl Drop for {name} {{\n\
+                                     fn drop(&mut self) {{}}\n\
+                                 }}\n"),
+            };
+            format!(
+                "{cfgs}#[automatically_derived]\n\
+                 // SAFETY: its At field, which its init() takes - given by InitAt's,\n\
+                 // from at() or at_index(), for the place the At names\n\
+                 unsafe impl crate::util::place::Placed for {name} {{\n\
+                     type Parent = {base};\n\
+                     type At = {at};\n\
+                     unsafe fn placed_at_raw(p: *const Self) -> *const Self::At {{\n\
+                         // SAFETY: the caller's\n\
+                         unsafe {{ &raw const (*p).{at_field} }}\n\
+                     }}\n\
+                 }}\n\
+                 {}{no_drop}", init_at(&init))
+        }
+        Kind::Container => format!(
+            "{cfgs}#[automatically_derived]\n\
+             // SAFETY: its AtIn field, which only its container's insert() makes\n\
+             unsafe impl crate::util::place::PlacedIn for {name} {{\n\
+                 type Base = {base};\n\
+             }}\n\
+             {}", init_at(&format!("crate::util::place::container::<Self, {n}, {name}, _>()"))),
+    };
+
+    Ok(tokens(&format!("{item}\n{impls}")))
+}
+
+/// The At field #[placed] adds, where there's no index for it to be.
+const AT_FIELD: &str = "_placed_at";
+
+/// Whether @f is a place's At: the field #[placed] added.
+pub(crate) fn is_at_field(f: &CFieldDef) -> bool {
+    f.placed_at
+}
+
+/// Whether @f is an At of no bytes - not an element's index - which
+/// TypeInfo doesn't describe.
+pub(crate) fn is_empty_at_field(f: &CFieldDef) -> bool {
+    f.placed_at && f.name == AT_FIELD
+}
+
+/// Field<N> for field @name, of type @ty, of @inst_ty - @impl_lts its
+/// lifetimes, @cfg the field's #[cfg].
+pub(crate) fn field_impl(cfg: &str, impl_lts: &str, inst_ty: &str, name: &str, ty: &str) -> String {
+    format!(
+        "{cfg}#[automatically_derived]\n\
+         // SAFETY: its field {name}, by offset_of!()\n\
+         unsafe impl{impl_lts} crate::util::place::Field<{{ crate::util::place::name({name:?}) }}> for {inst_ty} {{\n\
+             type Type = {ty};\n\
+             const OFFSET: usize = ::core::mem::offset_of!({inst_ty}, {name});\n\
+         }}\n")
+}
+
+/// The initializer for field @name, without #[init]: InitAt's, if a placed
+/// type lives there, else zeroed - util/place.rs's Pick.
+pub(crate) fn field_init(name: &str) -> String {
+    format!(
+        "{{\n\
+             use crate::util::place::{{PickPlaced as _, PickZeroed as _}};\n\
+             // SAFETY: run into field {name}, by pin_init!()\n\
+             unsafe {{ (&crate::util::place::Pick::<Self, {{ crate::util::place::name({name:?}) }}>::new()).pick() }}\n\
+         }}")
+}
diff --git a/fs/bcachefs/cstruct-macros/src/prt.rs b/fs/bcachefs/cstruct-macros/src/prt.rs
new file mode 100644
index 0000000..1db976b
--- /dev/null
+++ b/fs/bcachefs/cstruct-macros/src/prt.rs
@@ -0,0 +1,349 @@
+// SPDX-License-Identifier: GPL-2.0
+//! message!()'s format string, written into a printbuf piece by piece: what
+//! format_args!() would format, except that an argument that's ToText is
+//! to_text()'d into the printbuf itself - not formatted through Display, into
+//! a printbuf of its own on the stack, and copied in.
+//!
+//!   __prt!(CRATE, OUT, "fmt", args..)
+//!
+//! CRATE is the caller's $crate; OUT an expression that derefs to the
+//! Printbuf. The literal text between placeholders is written with write!(),
+//! so its escapes and {{ }} mean what they mean in any format string. A
+//! placeholder with no spec - {}, {0}, {name}, {x} - goes through
+//! printbuf::prt_arg, which picks ToText over Display at compile time; one
+//! with a spec - {:x}, {:>10}, {:?} - is write!()'s.
+//!
+//! As format_args!(): each argument evaluated once, and one never used is an
+//! error. Not supported: a spec taking its width or precision from an argument
+//! ($ or *).
+//!
+//! The arguments' tokens go into the expansion as they came: called from
+//! message!(), a macro_rules macro, code made from text would resolve names
+//! in its expansion, where the caller's locals aren't - so an inline {x}'s
+//! ident takes the format string's span, as format_args!()'s does.
+
+use proc_macro::{Delimiter, Group, Ident, Literal, Spacing, TokenStream, TokenTree};
+
+/// What a placeholder names: a positional argument - {} numbered in order, as
+/// format_args!() numbers them - or a name, a named argument's or the
+/// caller's variable.
+#[derive(Debug, PartialEq)]
+enum ArgRef {
+    Index(usize),
+    Name(String),
+}
+
+#[derive(Debug, PartialEq)]
+enum Piece {
+    /// Source text, as it was in the literal: escapes and {{ }} as written
+    Lit(String),
+    Arg { arg: ArgRef, spec: String },
+}
+
+/// The format string's literal source, its opening and closing quotes
+/// (r#" "# for a raw one), and its pieces.
+fn split_fmt(src: &str) -> Result<(String, String, Vec<Piece>), String> {
+    let (open, close, body, raw) = if let Some(r) = src.strip_prefix('r') {
+        let hashes = r.len() - r.trim_start_matches('#').len();
+        let open = format!("r{}\"", "#".repeat(hashes));
+        let close = format!("\"{}", "#".repeat(hashes));
+        let body = src.strip_prefix(open.as_str()).and_then(|b| b.strip_suffix(close.as_str()))
+            .ok_or("the format string isn't a string literal")?;
+        (open, close, body, true)
+    } else {
+        let body = src.strip_prefix('"').and_then(|b| b.strip_suffix('"'))
+            .ok_or("the format string isn't a string literal")?;
+        ("\"".to_string(), "\"".to_string(), body, false)
+    };
+
+    let mut pieces = Vec::new();
+    let mut lit = String::new();
+    let mut next = 0;
+    let mut chars = body.chars().peekable();
+
+    while let Some(ch) = chars.next() {
+        match ch {
+            // an escape, whole: \u{..}'s braces are no placeholder
+            '\\' if !raw => {
+                lit.push(ch);
+                if let Some(next) = chars.next() {
+                    lit.push(next);
+                    if next == 'u' && chars.peek() == Some(&'{') {
+                        for c in chars.by_ref() {
+                            lit.push(c);
+                            if c == '}' {
+                                break;
+                            }
+                        }
+                    }
+                }
+            }
+            '{' if chars.peek() == Some(&'{') => {
+                chars.next();
+                lit.push_str("{{");
+            }
+            '}' if chars.peek() == Some(&'}') => {
+                chars.next();
+                lit.push_str("}}");
+            }
+            '}' => return Err("unmatched `}` in the format string".into()),
+            '{' => {
+                let mut ph = String::new();
+                loop {
+                    match chars.next() {
+                        Some('}') => break,
+                        Some(c)   => ph.push(c),
+                        None      => return Err("unterminated `{` in the format string".into()),
+                    }
+                }
+                let (arg, spec) = ph.split_once(':').unwrap_or((&ph, ""));
+                let arg = arg.trim();
+                if spec.contains('$') || spec.contains('*') {
+                    return Err(format!("{{{ph}}}: a width or precision from an argument isn't supported"));
+                }
+                let arg = if arg.is_empty() {
+                    next += 1;
+                    ArgRef::Index(next - 1)
+                } else if let Ok(i) = arg.parse() {
+                    ArgRef::Index(i)
+                } else {
+                    ArgRef::Name(arg.to_string())
+                };
+
+                if !lit.is_empty() {
+                    pieces.push(Piece::Lit(core::mem::take(&mut lit)));
+                }
+                pieces.push(Piece::Arg { arg, spec: spec.to_string() });
+            }
+            _ => lit.push(ch),
+        }
+    }
+    if !lit.is_empty() {
+        pieces.push(Piece::Lit(lit));
+    }
+    Ok((open, close, pieces))
+}
+
+/// @ts split at its top level commas - a turbofish's included, whose angle
+/// brackets aren't a group. A trailing comma makes no empty last piece.
+fn split_commas(ts: TokenStream) -> Vec<Vec<TokenTree>> {
+    let mut out = vec![Vec::new()];
+    let mut angle = 0usize;
+    let mut prev_colons = false;
+
+    for tt in ts {
+        let colons = matches!(&tt, TokenTree::Punct(p) if p.as_char() == ':');
+        match &tt {
+            TokenTree::Punct(p) if p.as_char() == ',' && angle == 0 => {
+                out.push(Vec::new());
+                prev_colons = false;
+                continue;
+            }
+            TokenTree::Punct(p) if p.as_char() == '<' && (prev_colons || angle > 0) => angle += 1,
+            TokenTree::Punct(p) if p.as_char() == '>' && angle > 0 => angle -= 1,
+            _ => {}
+        }
+        prev_colons = colons;
+        out.last_mut().unwrap().push(tt);
+    }
+    if out.last().is_some_and(|l| l.is_empty()) {
+        out.pop();
+    }
+    out
+}
+
+/// A macro_rules fragment ($x:literal, $x:expr) comes as a group of its own,
+/// with no delimiters: what's in it.
+fn unwrap_none(tt: &TokenTree) -> Option<TokenTree> {
+    match tt {
+        TokenTree::Group(g) if g.delimiter() == Delimiter::None => {
+            let mut inner = g.stream().into_iter();
+            match (inner.next(), inner.next()) {
+                (Some(t), None) => unwrap_none(&t).or(Some(t)),
+                _ => None,
+            }
+        }
+        _ => None,
+    }
+}
+
+fn code(s: &str) -> TokenStream {
+    s.parse().unwrap()
+}
+
+fn paren(ts: TokenStream) -> TokenTree {
+    TokenTree::Group(Group::new(Delimiter::Parenthesis, ts))
+}
+
+/// ::core::write!(__bch_out, @lit, @arg);
+fn write_call(lit: Literal, arg: Option<TokenStream>) -> TokenStream {
+    let mut args = code("__bch_out,");
+    args.extend([TokenTree::Literal(lit)]);
+    if let Some(arg) = arg {
+        args.extend(code(","));
+        args.extend(arg);
+    }
+    let mut ts = code("::core::write!");
+    ts.extend([paren(args)]);
+    ts.extend(code(";"));
+    ts
+}
+
+pub(crate) fn prt(input: TokenStream) -> Result<TokenStream, String> {
+    let mut parts = split_commas(input).into_iter();
+    let krate: TokenStream = parts.next().ok_or("no crate")?.into_iter().collect();
+    let out: TokenStream = parts.next().ok_or("no printbuf")?.into_iter().collect();
+
+    let fmt_part = parts.next().ok_or("no format string")?;
+    let fmt_tt = match fmt_part.as_slice() {
+        [tt] => unwrap_none(tt).unwrap_or_else(|| tt.clone()),
+        _    => return Err("the format string must be a string literal".into()),
+    };
+    let TokenTree::Literal(fmt_lit) = &fmt_tt else {
+        return Err("the format string must be a string literal".into());
+    };
+    let fmt_span = fmt_lit.span();
+    let (open, close, pieces) = split_fmt(&fmt_lit.to_string())?;
+
+    // The arguments, positional then named - bound as __bch_argN, N their
+    // place here - and whether each is used
+    let mut args: Vec<(Option<String>, TokenStream)> = Vec::new();
+    for a in parts {
+        match a.as_slice() {
+            [TokenTree::Ident(name), TokenTree::Punct(eq), rest @ ..]
+                if eq.as_char() == '=' && eq.spacing() == Spacing::Alone && !rest.is_empty() =>
+                args.push((Some(name.to_string()), rest.iter().cloned().collect())),
+            _ => args.push((None, a.into_iter().collect())),
+        }
+    }
+    let nr_positional = args.iter().take_while(|(name, _)| name.is_none()).count();
+    let mut used = vec![false; args.len()];
+
+    let path = |rest: &str| -> TokenStream {
+        let mut ts = krate.clone();
+        ts.extend(code(rest));
+        ts
+    };
+
+    let mut body = TokenStream::new();
+
+    // let __bch_out: &mut CRATE::util::Printbuf = &mut *(OUT);
+    body.extend(code("let __bch_out: &mut"));
+    body.extend(path("::util::Printbuf"));
+    body.extend(code("= &mut *"));
+    body.extend([paren(out)]);
+    body.extend(code(";"));
+
+    body.extend(code("#[allow(unused_imports)] use"));
+    body.extend(path("::util::printbuf::prt_arg::{ViaText as _, ViaDisplay as _};"));
+
+    for p in pieces {
+        match p {
+            Piece::Lit(s) => {
+                let mut lit: Literal = format!("{open}{s}{close}").parse().unwrap();
+                lit.set_span(fmt_span);
+                body.extend(write_call(lit, None));
+            }
+            Piece::Arg { arg, spec } => {
+                // the argument, as a reference: an argument's binding, or an
+                // inline capture - the caller's name, at the caller's span
+                let mut bound = |i: usize| {
+                    used[i] = true;
+                    code(&format!("__bch_arg{i}"))
+                };
+                let arg_ts = match arg {
+                    ArgRef::Index(i) if i < nr_positional => bound(i),
+                    ArgRef::Index(i) => return Err(format!("format string refers to argument {i}, \
+                                                            but there are {nr_positional}")),
+                    ArgRef::Name(n) => match args.iter().position(|(name, _)| name.as_ref() == Some(&n)) {
+                        Some(i) => bound(i),
+                        None => {
+                            let mut ts = code("&");
+                            ts.extend([TokenTree::Ident(Ident::new(&n, fmt_span))]);
+                            ts
+                        }
+                    },
+                };
+
+                if spec.is_empty() {
+                    // (&CRATE::util::printbuf::prt_arg::Arg(ARG)).prt(__bch_out);
+                    let mut call = code("&");
+                    call.extend(path("::util::printbuf::prt_arg::Arg"));
+                    call.extend([paren(arg_ts)]);
+                    body.extend([paren(call)]);
+                    body.extend(code(".prt(__bch_out);"));
+                } else {
+                    let mut lit: Literal = format!("\"{{:{spec}}}\"").parse()
+                        .map_err(|_| format!("bad format spec `{spec}`"))?;
+                    lit.set_span(fmt_span);
+                    body.extend(write_call(lit, Some(arg_ts)));
+                }
+            }
+        }
+    }
+
+    if let Some(i) = used.iter().position(|u| !u) {
+        return Err(match &args[i].0 {
+            Some(name) => format!("named argument `{name}` is never used"),
+            None       => format!("argument {i} is never used"),
+        });
+    }
+
+    // Each argument evaluated once, as format_args!() does it: borrowed in a
+    // match's scrutinee, so the temporaries in it - k.to_text(fs)'s key - live
+    // until the writes are done.
+    //   match (&(A0), &(A1), ..) { (__bch_arg0, __bch_arg1, ..) => { body } }
+    let mut scrutinee = TokenStream::new();
+    let mut pattern = TokenStream::new();
+    for (i, (_, a)) in args.into_iter().enumerate() {
+        scrutinee.extend(code("&"));
+        scrutinee.extend([paren(a)]);
+        scrutinee.extend(code(","));
+        pattern.extend(code(&format!("__bch_arg{i},")));
+    }
+
+    let mut ts = code("match");
+    ts.extend([paren(scrutinee)]);
+    let mut arm = TokenStream::new();
+    arm.extend([paren(pattern)]);
+    arm.extend(code("=>"));
+    arm.extend([TokenTree::Group(Group::new(Delimiter::Brace, body))]);
+    ts.extend([TokenTree::Group(Group::new(Delimiter::Brace, arm))]);
+    Ok(ts)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn lit(s: &str) -> Piece {
+        Piece::Lit(s.into())
+    }
+
+    fn arg(arg: ArgRef, spec: &str) -> Piece {
+        Piece::Arg { arg, spec: spec.into() }
+    }
+
+    #[test]
+    fn pieces() {
+        let (_, _, p) = split_fmt(r#""a {} b {x} c {0:>4}{} {{d}} \u{1F600}\n""#).unwrap();
+        assert_eq!(p, vec![lit("a "), arg(ArgRef::Index(0), ""), lit(" b "),
+                           arg(ArgRef::Name("x".into()), ""), lit(" c "),
+                           arg(ArgRef::Index(0), ">4"), arg(ArgRef::Index(1), ""),
+                           lit(r" {{d}} \u{1F600}\n")]);
+    }
+
+    #[test]
+    fn raw() {
+        let (open, close, p) = split_fmt(r###"r#"\{}"#"###).unwrap();
+        assert_eq!((open.as_str(), close.as_str()), ("r#\"", "\"#"));
+        assert_eq!(p, vec![lit(r"\"), arg(ArgRef::Index(0), "")]);
+    }
+
+    #[test]
+    fn errors() {
+        assert!(split_fmt(r#""a } b""#).is_err());
+        assert!(split_fmt(r#""a { b""#).is_err());
+        assert!(split_fmt(r#""{:1$}""#).is_err());
+    }
+}
diff --git a/fs/bcachefs/cstruct-macros/src/tagged_union.rs b/fs/bcachefs/cstruct-macros/src/tagged_union.rs
new file mode 100644
index 0000000..9b6adfa
--- /dev/null
+++ b/fs/bcachefs/cstruct-macros/src/tagged_union.rs
@@ -0,0 +1,929 @@
+// SPDX-License-Identifier: GPL-2.0
+//! tagged_union!: a tagged union with a stable representation.
+//!
+//!   tagged_union! {
+//!       /// ...
+//!       pub struct disk_accounting_pos {
+//!           tag type_: u8 = disk_accounting_type,
+//!           arms from BCH_DISK_ACCOUNTING_TYPES(f, nr, ..) => f: bch_acct_ ## f = nr,
+//!           pad: c::bpos,
+//!           size: pad,
+//!           packed,
+//!       }
+//!   }
+//!
+//!   tagged_union! {
+//!       pub union jset_entry in c::jset_entry {
+//!           tag type_: u8 = c::bch_jset_entry_type,
+//!           arm btree_keys: c::jset_entry = ..,
+//!           ...
+//!           size: header,
+//!       }
+//!   }
+//!
+//! A type whose bytes come from outside - disk, or C - with a tag that says
+//! which of its arms it holds, and that may be one this version doesn't know.
+//! The layout is given, not chosen: the storage is the C, plain #[repr(C)]
+//! data - a `struct` is the tag, then a union of the arms, overlaid with the
+//! pad.
+//!
+//! `size:` says what its size is a function of, and what's generated follows
+//! from that: nothing, a constant - `size: pad`, a struct, every value the
+//! pad's size, a value of plain data; its header's count - `size: header`,
+//! a union over another's storage, below, a view of bytes as long as the
+//! header says; or its tag - `size: arm`, a value as long as the arm its tag
+//! selects, below.
+//!
+//! `packed` is C's __packed: for an on-disk struct, the payload right after
+//! the tag, whatever the arms' alignment - a struct of the tag and the union
+//! otherwise puts the union at its alignment, and a new arm could move every
+//! payload.
+//!
+//! The tag is a function of the whole value: a crate::types::Determinant,
+//! stabby's idea (docs.rs/stabby), n-way - generated, returning the tag
+//! field, `tag NAME`. It's handed out as TAG_ENUM, `tag NAME: TYPE =
+//! TAG_ENUM`, a newtype over an integer the tag widens to - or with none,
+//! `tag NAME: TYPE`, as it is.
+//!
+//! Generated, for the first declaration:
+//!
+//!  - `union disk_accounting_pos__ffi`: the storage, what C and disk see -
+//!    C's struct disk_accounting_pos; Plain, its pad being every byte of
+//!    it;
+//!  - `disk_accounting_pos<S>`, the storage in a state, Validated unless
+//!    named, as a family's types are (util/vstructs.rs): Unvalidated, bytes
+//!    from outside - `from_bytes()`; Validated, what validate passed, or
+//!    what's made here from an arm. One generic newtype, not a definition
+//!    per state: the states differ only in what get() does with an arm
+//!    that doesn't fit.
+//!  - `enum DiskAccountingPos`, an arm by value, and `enum
+//!    DiskAccountingPosRef<'_, St>`, an arm by reference: one of the arm
+//!    types the block declares, plain data, a reference to it; another's -
+//!    the replicas entry, a header and the devices it counts - its
+//!    #[counted] family's type, X<St>, in the storage's state, as long as
+//!    its own header says (CountedHead, ArmAt);
+//!  - `get()`: the arm the tag selects. Unvalidated, an error if the tag
+//!    isn't one of ours or the arm's header says it's longer than the
+//!    storage holds (ArmError); Validated, Err(the tag), and an arm that
+//!    doesn't fit a bug. Shared references only: through a `&mut` to an
+//!    arm, a tag in the arm's own bits could change under whoever holds it.
+//!  - `new()`, and `from_arm()` by the arm's type, Validated: the payload into
+//!    zeroed storage, then Determinant::set() marks it - stabby's order, so a
+//!    tag that's bits of the payload is the last thing written, not
+//!    overwritten by it. Never a typed copy, which leaves the bytes past a
+//!    short payload undefined. `from_arm_tailed()` writes an arm's flexible
+//!    array too.
+//!  - crate::types::ArmOf for each arm's type, which from_arm() goes by;
+//!  - `type_()`, the tag, known or not; `as_bytes()`, `as_ffi()`;
+//!  - C: the same storage, its offsets asserted against the Rust's.
+//!
+//! A struct C hands over in memory - a request, not a record off disk - can
+//! say so, with either or both of:
+//!
+//!  - `tag NAME: enum TYPE`: the tag's a closed C enum, the storage holds it
+//!    as one - C keeps its enum type, its switches their -Wswitch - and the
+//!    arms' values are its variants, compared as themselves. A value from
+//!    outside could hold one that isn't a variant, so there's no Unvalidated
+//!    view, no from_bytes(); and the storage isn't Plain. new() starts from
+//!    zeroes: a const asserts 0 is a variant.
+//!  - `plain`: every arm is plain data, so an arm type not defined in the
+//!    block - a typedef of an integer, for C's `.device` where a struct
+//!    would make it `.device.dev` - is one of its own, not a #[counted]
+//!    family's head.
+//!
+//! The storage's bytes are always all written: they come from C or disk, from
+//! from_bytes(), or from new(), which starts from zeroes - so get() and
+//! as_bytes() can read any of them. A literal of the storage could leave
+//! some unwritten, as could an arm with padding; nothing makes either.
+//!
+//! Or, `union NAME in STORAGE { .., size: header }`, the storage is
+//! another's: a header its arms embed and run past, as far as its count
+//! says - a journal entry's, a superblock field's: an unsized vstruct
+//! (util/vstructs.rs), each reference to which has its arm's bytes, and its
+//! own C. Then what's generated is the Ref enum, ArmOf, and on the storage
+//! in each state - X<Unvalidated>, X<Validated> - typed(): the arm its tag
+//! selects, over its bytes, in the storage's state - every arm type has a
+//! family (util/vstructs.rs), so an Unvalidated storage's arms are
+//! Unvalidated. An arm may be shorter than its type - written by an older
+//! version, before the type grew - so it's what its definition's ArmRef says:
+//! a grown type's at the arm's length, its later fields zero
+//! past the end. An arm that's the storage itself - a journal entry of keys -
+//! is the storage, in its state. arm::<A>() is typed() for one arm, if the
+//! tag is A's - A in the storage's state, X<Unvalidated> for an Unvalidated
+//! one - and arm_mut::<A>() the same, to edit.
+//!
+//! Or, `union NAME in HEAD { .., size: arm }`, each value is as long as the
+//! arm its tag selects - an ACL's entries: no count to step by, so a tag this
+//! version doesn't know is one there's no stepping past. HEAD is what every
+//! arm starts with, the tag in it, and the arms are plain data, packed: an
+//! on-disk type asks no alignment of where it is, so a value is read at any
+//! offset. Arms may share a type, the variant saying which. What's generated
+//! is the enum, the arm by value, and on it read(),
+//! from bytes, an error if the tag isn't ours or the bytes are fewer than
+//! its arm (crate::util::vstructs::ArmSized); bytes(), its arm's size;
+//! head(), the fields every arm shares; name(), its arm's; write(), its
+//! arm's bytes then its tag; walk(), over a run of them (ArmWalk). No C:
+//! HEAD and the arms have their own.
+//!
+//! The arms come from an x-macro list: tagged_union! hands the declaration to
+//! it - LIST!(cstruct_macros::__tagged_union [decl]) - and the list calls
+//! back with its entries, each bound to the params, `..` the rest, and
+//! `A ## B` pasting - spaced, as Rust 2021 lexes `a##b` as a reserved prefix.
+//!
+//! The arms' types can be defined in the block, each next to the others, as
+//! a Rust enum's variants are - comments and all:
+//!
+//!   tagged_union! {
+//!       #[derive(Clone, Copy, CStruct, TypeInfo)]*
+//!       #[c_typedef]*
+//!       pub struct disk_accounting_pos {
+//!           tag type_: u8 = disk_accounting_type,
+//!           arms from BCH_DISK_ACCOUNTING_TYPES(f, nr, ..) => f: bch_acct_ ## f = nr,
+//!           ...
+//!           /* Metadata accounting per btree id: ... */
+//!           #[repr(C, packed)]
+//!           pub struct bch_acct_btree {
+//!               pub id: u32,
+//!           },
+//!       }
+//!   }
+//!
+//! Each goes to nestify::nest!, so it can nest types of its own, with the
+//! declaration's `#[...]*` - nestify's propagating attributes, for each arm
+//! type and what it nests, not for the storage. The list still says what the
+//! arms are; a type defined here that isn't one's is an error. The
+//! declaration reaches the list as tokens, so an error in a definition is
+//! reported where it's written.
+
+use proc_macro::{Delimiter, Group, TokenStream, TokenTree};
+
+use crate::cstruct::{parse_items, tagged_union_arms, tagged_union_record_text, CItem, CTaggedArm,
+                     CTaggedSize, CTaggedUnion};
+use crate::{comma_list, list_callback, record, through_list, tokens};
+
+/// tagged_union!: the arms from a list go through the list; written-out
+/// arms are generated directly. The declaration goes to the list as tokens,
+/// not text: an arm type defined in it keeps its spans, so an error in one
+/// is reported where it is.
+pub(crate) fn tagged_union(input: TokenStream) -> Result<TokenStream, String> {
+    let tu = parse(&input)?;
+    match &tu.from {
+        Some(f) => Ok(through_list(&f.list, "cstruct_macros::__tagged_union", input)),
+        None => generate(&input, &tu, &tu.arms),
+    }
+}
+
+/// The declaration's `#[...]*`s, and the arm types defined in its block -
+/// as the tokens they were written as, spans and all.
+fn arm_attrs_and_defs(decl: &TokenStream) -> (TokenStream, Vec<TokenStream>) {
+    let trees: Vec<TokenTree> = decl.clone().into_iter().collect();
+    let mut attrs = TokenStream::new();
+    let mut k = 0;
+    while let (Some(TokenTree::Punct(p)), Some(TokenTree::Group(g))) = (trees.get(k), trees.get(k + 1)) {
+        if p.as_char() != '#' || g.delimiter() != Delimiter::Bracket {
+            break;
+        }
+        if let Some(TokenTree::Punct(star)) = trees.get(k + 2).filter(|t| matches!(t, TokenTree::Punct(s) if s.as_char() == '*')) {
+            attrs.extend(trees[k..k + 2].iter().cloned());
+            attrs.extend([TokenTree::Punct(star.clone())]);
+            k += 3;
+        } else {
+            k += 2;
+        }
+    }
+    let body = trees.iter().rev().find_map(|t| match t {
+        TokenTree::Group(g) if g.delimiter() == Delimiter::Brace => Some(g.stream()),
+        _ => None,
+    });
+    let items = body.map(comma_list).unwrap_or_default();
+    // [#[..]]... [pub [(..)]] struct|union NAME { .. }
+    let is_def = |item: &[TokenTree]| {
+        let mut j = 0;
+        while matches!(item.get(j), Some(TokenTree::Punct(p)) if p.as_char() == '#') {
+            j += 2;
+        }
+        if matches!(item.get(j), Some(TokenTree::Ident(i)) if i.to_string() == "pub") {
+            j += 1;
+            if matches!(item.get(j), Some(TokenTree::Group(g)) if g.delimiter() == Delimiter::Parenthesis) {
+                j += 1;
+            }
+        }
+        matches!((item.get(j), item.get(j + 1), item.get(j + 2)),
+                 (Some(TokenTree::Ident(kw)), Some(TokenTree::Ident(_)), Some(TokenTree::Group(g)))
+                 if (kw.to_string() == "struct" || kw.to_string() == "union")
+                    && g.delimiter() == Delimiter::Brace)
+    };
+    let defs = items.into_iter()
+        .filter(|item| is_def(item))
+        .map(|item| item.into_iter().collect())
+        .collect();
+    (attrs, defs)
+}
+
+/// The list's callback: its arms are the list's entries.
+pub(crate) fn from_list(input: TokenStream) -> Result<TokenStream, String> {
+    let (decl, entries) = list_callback(input)?;
+    let tu = parse(&decl)?;
+    let arms = tagged_union_arms(&tu, &entries).map_err(|e| format!("{}: {e}", tu.name))?;
+    generate(&decl, &tu, &arms)
+}
+
+fn parse(input: &TokenStream) -> Result<CTaggedUnion, String> {
+    let mut items = parse_items(&format!("tagged_union! {{ {input} }}"))?;
+    match (items.pop(), items.is_empty()) {
+        (Some(CItem::TaggedUnion(tu)), true) => Ok(tu),
+        _ => Err("expected struct NAME { tag ..., arms ..., pad ... }".into()),
+    }
+}
+
+/// The declaration's attributes - its doc comment, a cfg - and visibility, as
+/// source, for what's generated.
+fn attrs_and_vis(decl: &TokenStream) -> (String, String) {
+    let trees: Vec<TokenTree> = decl.clone().into_iter().collect();
+    let mut attrs = String::new();
+    let mut k = 0;
+    while let (Some(TokenTree::Punct(p)), Some(TokenTree::Group(g))) = (trees.get(k), trees.get(k + 1)) {
+        if p.as_char() != '#' || g.delimiter() != Delimiter::Bracket {
+            break;
+        }
+        k += 2;
+        // `#[...]*` is the arm types', not the storage's
+        if let Some(TokenTree::Punct(star)) = trees.get(k) {
+            if star.as_char() == '*' {
+                k += 1;
+                continue;
+            }
+        }
+        attrs.push_str(&format!("#{g}\n"));
+    }
+    let mut vis = String::new();
+    if let Some(TokenTree::Ident(i)) = trees.get(k) {
+        if i.to_string() == "pub" {
+            vis.push_str("pub");
+            if let Some(TokenTree::Group(g)) = trees.get(k + 1) {
+                if g.delimiter() == Delimiter::Parenthesis {
+                    vis.push_str(&g.to_string());
+                }
+            }
+        }
+    }
+    (attrs, vis)
+}
+
+/// foo_bar -> FooBar.
+fn camel(name: &str) -> String {
+    name.split('_')
+        .filter(|s| !s.is_empty())
+        .map(|s| {
+            let mut c = s.chars();
+            c.next().map(|f| f.to_uppercase().chain(c).collect::<String>()).unwrap_or_default()
+        })
+        .collect()
+}
+
+fn generate(decl: &TokenStream, tu: &CTaggedUnion, arms: &[CTaggedArm]) -> Result<TokenStream, String> {
+    if arms.is_empty() {
+        return Err(format!("{}: no arms", tu.name));
+    }
+    if let Some(d) = tu.defs.iter().find(|d| !arms.iter().any(|a| a.ty.trim() == d.name)) {
+        return Err(format!("{}: {} is defined here but isn't an arm's type", tu.name, d.name));
+    }
+    // The arm types defined in the block: nestify::nest!, given the
+    // declaration's `#[...]*` - propagating, for any types nested in them -
+    // as the tokens they were written as.
+    let (arm_attrs, def_tokens) = arm_attrs_and_defs(decl);
+    let mut defs = TokenStream::new();
+    for d in def_tokens {
+        let mut body = arm_attrs.clone();
+        body.extend(d);
+        defs.extend(tokens("::nestify::nest!"));
+        defs.extend([TokenTree::Group(Group::new(Delimiter::Brace, body))]);
+    }
+    let (attrs, vis) = attrs_and_vis(decl);
+    let name = &tu.name;
+    let en = camel(name);
+    let (tag, tag_ty) = (&tu.tag_field, &tu.tag_ty);
+    // The tag as handed out: its enum, a newtype over an integer the tag
+    // widens to - or with none, the tag as it is
+    let tag_enum = if tu.tag_enum.is_empty() { tag_ty } else { &tu.tag_enum };
+    let wrap_tag = |x: &str| if tu.tag_enum.is_empty() {
+        x.to_string()
+    } else {
+        format!("{tag_enum}({x} as _)")
+    };
+    let t_tag = wrap_tag("t");
+    // A value as the tag: an enum tag's values are its variants, as they are
+    let as_tag = |v: &str| if tu.tag_is_enum { format!("({v})") } else { format!("({v}) as {tag_ty}") };
+    let det_trait = "crate::types::Determinant";
+    let arm_of = "crate::types::ArmOf";
+    let vs = "crate::util::vstructs";
+    // The storage: the type the views are of
+    // A sized storage's is C's struct, {name}__ffi: {name} is its state's
+    let s_ty = tu.storage.clone().unwrap_or_else(|| format!("{name}__ffi"));
+    let s_size = format!("::core::mem::size_of::<{s_ty}>()");
+
+    // The storage, as C has it: the tag then the arms' union (with types of
+    // their own, C's anonymous struct and union), overlaid with the pad. Or
+    // none, the storage being another's - an unsized union's.
+    let arm_fields: String = arms.iter()
+        .map(|a| format!("    {vis} {}: {},\n", a.name, a.ty))
+        .collect();
+    let pad_field = tu.pad.as_ref().map(|p| format!("    {vis} _pad: {p},\n")).unwrap_or_default();
+    let storage_attrs = "#[allow(non_camel_case_types)]\n#[repr(C)]\n#[derive(Clone, Copy)]\n";
+    // `packed`: where C has __packed - the arms' union and the tag's struct
+    let packed_attrs = if tu.packed {
+        "#[allow(non_camel_case_types)]\n#[repr(C, packed)]\n#[derive(Clone, Copy)]\n"
+    } else {
+        storage_attrs
+    };
+    // An unsized vstruct's storage is a family: each state its own
+    // definition, named - what its tag is read from
+    let states: Vec<(&str, String)> = if tu.size == CTaggedSize::Header {
+        ["Unvalidated", "Validated"].iter()
+            .map(|st| (*st, format!("{s_ty}__{}", st.to_lowercase())))
+            .collect()
+    } else {
+        vec![("", s_ty.clone())]
+    };
+    let (storage, payload_offset, determinant) = if tu.storage.is_some() {
+        // another's storage, a union: its tag is its own field, by value, as
+        // a packed struct's must be
+        let det = format!("{name}__tag");
+        let impls: String = states.iter()
+            .map(|(_, s)| format!(
+                "impl {det_trait}<{s}> for {det} {{\n\
+                     type Tag = {tag_ty};\n\
+                     fn get(u: &{s}) -> {tag_ty} {{\n\
+                         <{tag_ty}>::from({{ u.{tag} }})\n\
+                     }}\n\
+                     fn set(u: &mut {s}, tag: {tag_ty}) {{\n\
+                         u.{tag} = tag.into();\n\
+                     }}\n\
+                 }}\n"))
+            .collect();
+        (format!("/// {name}'s tag: the storage's {tag}.\n\
+                  #[doc(hidden)]\n\
+                  #[allow(non_camel_case_types)]\n\
+                  {vis} struct {det};\n\
+                  \n\
+                  {impls}"),
+         "0".to_string(),
+         det)
+    } else {
+        let det = format!("{name}__tag");
+        (format!("#[doc(hidden)]\n{packed_attrs}{vis} union {name}__arms {{\n{arm_fields}}}\n\
+                  \n\
+                  #[doc(hidden)]\n{packed_attrs}{vis} struct {name}__tagged {{\n\
+                      {vis} {tag}: {tag_ty},\n\
+                      {vis} u: {name}__arms,\n\
+                  }}\n\
+                  \n\
+                  {attrs}#[c_name({name})]\n{storage_attrs}{vis} union {s_ty} {{\n\
+                      {vis} t: {name}__tagged,\n\
+                      {pad_field}\
+                  }}\n\
+                  \n\
+                  /// {name}'s tag: its field.\n\
+                  #[doc(hidden)]\n\
+                  #[allow(non_camel_case_types)]\n\
+                  {vis} struct {det};\n\
+                  \n\
+                  impl {det_trait}<{s_ty}> for {det} {{\n\
+                      type Tag = {tag_ty};\n\
+                      fn get(u: &{s_ty}) -> {tag_ty} {{\n\
+                          // SAFETY: the tag is plain data, the struct's first field\n\
+                          unsafe {{ u.t.{tag} }}\n\
+                      }}\n\
+                      fn set(u: &mut {s_ty}, tag: {tag_ty}) {{\n\
+                          #[allow(unused_unsafe)]\n\
+                          // SAFETY: a write of plain data\n\
+                          unsafe {{ u.t.{tag} = tag }}\n\
+                      }}\n\
+                  }}\n"),
+         format!("::core::mem::offset_of!({name}__tagged, u)"),
+         det)
+    };
+    let det = format!("<{determinant} as {det_trait}<{s_ty}>>");
+
+    let by_value: String = arms.iter().map(|a| format!("    {}({}),\n", a.name, a.ty)).collect();
+    // An arm type this declares is plain data: a reference to it, whatever
+    // the storage's state - and with `plain`, every arm's. Another's is a
+    // #[counted] family's head - a replicas entry's, as C's union holds it -
+    // the family's type in the storage's state, as long as its own header
+    // says (CountedHead, ArmAt).
+    let declared = |a: &CTaggedArm| tu.plain || tu.defs.iter().any(|d| d.name == a.ty.trim());
+    let stated = arms.iter().any(|a| !declared(a));
+    let st_param = if stated { format!(", St: {vs}::State = {vs}::Validated") } else { String::new() };
+    let st_arg = |st: &str| if stated { format!(", {vs}::{st}") } else { String::new() };
+    let by_ref: String = arms.iter()
+        .map(|a| if declared(a) {
+            format!("    {}(&'a {}),\n", a.name, a.ty)
+        } else {
+            format!("    {}(&'a <{} as {vs}::CountedHead>::Of<St>),\n", a.name, a.ty.trim())
+        })
+        .collect();
+    // get()'s arms, in state @st: @bad, what an arm whose header says it's
+    // longer than the storage holds is
+    let gets = |st: &str, bad: &str| -> String {
+        arms.iter()
+            .map(|a| {
+                let arm = if declared(a) {
+                    format!("// SAFETY: an arm this declares is plain data, in the storage\n\
+                             // and aligned there: asserted below\n\
+                             unsafe {{ &*b.as_ptr().cast::<{}>() }}", a.ty)
+                } else {
+                    format!("match <<{} as {vs}::CountedHead>::Of<{vs}::{st}> as {vs}::ArmAt>::arm_at(b) {{\n\
+                                 Ok(arm) => arm,\n\
+                                 Err(err) => {bad},\n\
+                             }}", a.ty.trim())
+                };
+                format!("if t == {} {{\n\
+                             return Ok({en}Ref::{}({arm}));\n\
+                         }}\n", as_tag(&a.value), a.name)
+            })
+            .collect()
+    };
+    let news: String = arms.iter()
+        .map(|a| format!("{en}::{}(x) => Self::from_arm(x),\n", a.name))
+        .collect();
+    // An arm that's the storage itself - a journal entry of keys - isn't a
+    // type of its own to go by
+    let arms_of: String = arms.iter()
+        .filter(|a| a.ty.trim() != s_ty.trim())
+        .map(|a| format!("impl {arm_of}<{s_ty}> for {} {{\n\
+                              type Tag = {tag_ty};\n\
+                              const TAG: {tag_ty} = {};\n\
+                          }}\n",
+                         a.ty, as_tag(&a.value)))
+        .collect();
+    // Where get() finds an arm: in the storage, aligned for it
+    let arm_asserts: String = arms.iter()
+        .map(|a| format!("const _: () = assert!({payload_offset} + ::core::mem::size_of::<{ty}>() <= {s_size},\n\
+                              \"tagged_union! {name}: arm {arm} doesn't fit in the storage\");\n\
+                          const _: () = assert!(({payload_offset}) % ::core::mem::align_of::<{ty}>() == 0 &&\n\
+                                                ::core::mem::align_of::<{s_ty}>() >= ::core::mem::align_of::<{ty}>(),\n\
+                              \"tagged_union! {name}: arm {arm} isn't aligned in the storage\");\n",
+                         ty = a.ty, arm = a.name))
+        .collect();
+    // packed: an arm aligned more than 1 would be an unaligned reference -
+    // say so by name, not as rustc's E0793 at the list
+    let packed_asserts: String = arms.iter()
+        .filter(|_| tu.packed)
+        .map(|a| format!("const _: () = assert!(::core::mem::align_of::<{}>() == 1,\n\
+                          \"tagged_union! {name}: arm {} is aligned more than 1, so in a packed \
+                          union get() can't hand out a reference to it - pack the arm\");\n",
+                         a.ty, a.name))
+        .collect();
+    // Plain - C's struct of a family is: its pad is every byte of it, and
+    // Plain, and the arms are plain data. Not with an enum tag, which isn't
+    // any bytes: but new() starts from zeroes, so zero must be one of its
+    // variants - a const that isn't fails to evaluate.
+    let pad_assert = tu.pad.as_ref()
+        .map(|p| {
+            let plain = if tu.tag_is_enum {
+                format!("// SAFETY: 0 is one of its variants - or this, a const, fails to evaluate\n\
+                         const _: {tag_ty} = unsafe {{ ::core::mem::zeroed() }};\n")
+            } else {
+                format!("// SAFETY: its pad is every byte of it - asserted above - and Plain,\n\
+                         // and its arms are plain data, any bytes one\n\
+                         unsafe impl {vs}::Plain for {s_ty} {{}}\n")
+            };
+            format!("const _: () = assert!({s_size} == ::core::mem::size_of::<{p}>(),\n\
+                     \"tagged_union! {name}: bigger than its pad\");\n\
+                     {plain}\
+                     const _: () = {vs}::assert_plain::<{p}>();\n")
+        })
+        .unwrap_or_default();
+    // The C: another's storage has its own
+    let c_record = if tu.storage.is_none() {
+        let nums = [
+            format!("::core::mem::size_of::<{s_ty}>() as u64"),
+            format!("::core::mem::align_of::<{s_ty}>() as u64"),
+            format!("{payload_offset} as u64"),
+        ];
+        record(&tagged_union_record_text(tu, arms), &nums)
+    } else {
+        String::new()
+    };
+
+    if tu.size == CTaggedSize::Arm {
+        // Each value as long as the arm its tag selects - the variant, by
+        // value - read off bytes and written back to them: ArmSized, and
+        // ArmWalk over a run of them. The tag is the head's, so every arm
+        // starts with the head, its tag where the head has it; and every arm
+        // is plain data, read and written by copying, at any alignment.
+        // No ArmOf: arms may share a type, the variant saying which.
+        let head = s_ty.trim();
+        let tag_of_raw = wrap_tag("self.tag_raw()");
+        let reads: String = arms.iter()
+            .map(|a| format!(
+                "if t == ({value}) as {tag_ty} {{\n\
+                     return {vs}::cast_plain::<{ty}>(b).copied().map(Self::{arm})\n\
+                         .ok_or({vs}::ArmError::Bad {{\n\
+                             tag: {t_tag},\n\
+                             err: {vs}::VStructError::Overrun {{\n\
+                                 ty:   ::core::any::type_name::<{ty}>(),\n\
+                                 want: ::core::mem::size_of::<{ty}>(),\n\
+                                 have: b.len(),\n\
+                             }},\n\
+                         }});\n\
+                 }}\n",
+                value = a.value, ty = a.ty, arm = a.name))
+            .collect();
+        let tags: String = arms.iter()
+            .map(|a| format!("Self::{}(_) => ({}) as {tag_ty},\n", a.name, a.value))
+            .collect();
+        let sizes: String = arms.iter()
+            .map(|a| format!("Self::{}(_) => ::core::mem::size_of::<{}>(),\n", a.name, a.ty))
+            .collect();
+        let arm_bytes: String = arms.iter()
+            .map(|a| format!("Self::{}(x) => {vs}::plain_bytes(x),\n", a.name))
+            .collect();
+        let names: String = arms.iter()
+            .map(|a| format!("Self::{0}(_) => \"{0}\",\n", a.name))
+            .collect();
+        let asserts: String = arms.iter()
+            .map(|a| format!(
+                "const _: () = {vs}::assert_plain::<{ty}>();\n\
+                 const _: () = assert!(::core::mem::size_of::<{ty}>() >= ::core::mem::size_of::<{head}>() &&\n\
+                                       ::core::mem::offset_of!({ty}, {tag}) == ::core::mem::offset_of!({head}, {tag}),\n\
+                     \"tagged_union! {name}: arm {arm} doesn't start with the head - its {tag} \
+                     where the head has it\");\n\
+                 const _: () = assert!(::core::mem::align_of::<{ty}>() == 1,\n\
+                     \"tagged_union! {name}: arm {arm} has an alignment - it's read where it \
+                     is, at any offset: #[repr(C, packed)]\");\n",
+                ty = a.ty, arm = a.name))
+            .collect();
+        return with_defs(defs, name, &format!(
+            "{storage}\
+             const _: () = {vs}::assert_plain::<{head}>();\n\
+             const _: () = assert!(::core::mem::align_of::<{head}>() == 1,\n\
+                 \"tagged_union! {name}: its head has an alignment - it's read where it is, \
+                 at any offset: #[repr(C, packed)]\");\n\
+             {asserts}\
+             \n\
+             /// One of {name}'s arms, by value, as long as it is - the variant is\n\
+             /// the tag: what read() gives, and write() writes, its arm's own\n\
+             /// {tag} with it.\n\
+             #[allow(non_camel_case_types, dead_code)]\n\
+             #[derive(Clone, Copy)]\n\
+             {vis} enum {en} {{\n{by_value}}}\n\
+             \n\
+             impl {en} {{\n\
+                 fn tag_raw(&self) -> {tag_ty} {{\n\
+                     match self {{\n{tags}}}\n\
+                 }}\n\
+                 \n\
+                 fn arm_bytes(&self) -> &[u8] {{\n\
+                     match self {{\n{arm_bytes}}}\n\
+                 }}\n\
+                 \n\
+                 /// Its tag: its variant's.\n\
+                 #[allow(dead_code)]\n\
+                 {vis} fn {tag}(&self) -> {tag_enum} {{\n\
+                     {tag_of_raw}\n\
+                 }}\n\
+                 \n\
+                 /// Its head, which every arm starts with: the fields they share.\n\
+                 #[allow(dead_code)]\n\
+                 {vis} fn head(&self) -> {head} {{\n\
+                     *{vs}::cast_plain(self.arm_bytes()).expect(\"an arm starts with the head\")\n\
+                 }}\n\
+                 \n\
+                 /// Its arm's name.\n\
+                 #[allow(dead_code)]\n\
+                 {vis} fn name(&self) -> &'static str {{\n\
+                     match self {{\n{names}}}\n\
+                 }}\n\
+                 \n\
+                 /// Write it at the start of @out - its arm's bytes, then its tag,\n\
+                 /// last, as a sized union's new() marks it - and give back the rest\n\
+                 /// of @out. Panics if @out is shorter than it: bytes() sizes @out.\n\
+                 #[allow(dead_code)]\n\
+                 {vis} fn write<'o>(&self, out: &'o mut [u8]) -> &'o mut [u8] {{\n\
+                     let b = self.arm_bytes();\n\
+                     let (to, rest) = out.split_at_mut(b.len());\n\
+                     to.copy_from_slice(b);\n\
+                     {det}::set({vs}::cast_plain_mut(to).expect(\"an arm starts with the head\"),\n\
+                                self.tag_raw());\n\
+                     rest\n\
+                 }}\n\
+                 \n\
+                 /// The values @b holds, one after another: ArmWalk.\n\
+                 #[allow(dead_code)]\n\
+                 {vis} fn walk(b: &[u8]) -> {vs}::ArmWalk<'_, Self> {{\n\
+                     {vs}::ArmWalk::new(b)\n\
+                 }}\n\
+             }}\n\
+             \n\
+             impl {vs}::ArmSized for {en} {{\n\
+                 type Tag = {tag_enum};\n\
+                 \n\
+                 fn read(b: &[u8]) -> Result<Self, {vs}::ArmError<{tag_enum}>> {{\n\
+                     let Some(h) = {vs}::cast_plain::<{head}>(b) else {{\n\
+                         return Err({vs}::ArmError::Short({vs}::VStructError::Overrun {{\n\
+                             ty:   ::core::any::type_name::<{head}>(),\n\
+                             want: ::core::mem::size_of::<{head}>(),\n\
+                             have: b.len(),\n\
+                         }}));\n\
+                     }};\n\
+                     let t: {tag_ty} = {det}::get(h);\n\
+                     {reads}\
+                     Err({vs}::ArmError::Unknown({t_tag}))\n\
+                 }}\n\
+                 \n\
+                 fn bytes(&self) -> usize {{\n\
+                     match self {{\n{sizes}}}\n\
+                 }}\n\
+             }}\n"));
+    }
+
+    if tu.size == CTaggedSize::Header {
+        // An unsized vstruct, its arms running past its header as far as its
+        // count says - each reference to one has them: typed() and arm(), on
+        // each state's definition of the storage. An arm there may be an
+        // older, shorter version of its type: as its ArmRef has it, over the
+        // storage's bytes. Or the storage itself - a journal entry of keys -
+        // in its state.
+        //
+        // Every arm has a family - #[unsized_vstruct], #[grown], #[whole] -
+        // so each is named in the storage's state: a member of an Unvalidated
+        // one is Unvalidated, all the way down.
+        let vs = "crate::util::vstructs";
+        let own = |a: &CTaggedArm| a.ty.trim() == s_ty.trim();
+        let by_ref: String = arms.iter()
+            .map(|a| if own(a) {
+                format!("    {}(&'a {s_ty}<St>),\n", a.name)
+            } else {
+                format!("    {}(&'a {}<St>),\n", a.name, a.ty.trim())
+            })
+            .collect();
+        // ArmOf by state - the storage's, X<St>, for the arm's definition in
+        // that state, which the arm's X<St> has it by: an arm of an
+        // Unvalidated storage is Unvalidated
+        let arms_of_by_state: String = states.iter()
+            .flat_map(|(st, _)| {
+                let (lower, s_ty) = (st.to_lowercase(), &s_ty);
+                arms.iter().filter(|a| !own(a)).map(move |a| format!(
+                    "impl {arm_of}<{s_ty}<{vs}::{st}>> for {}__{lower} {{\n\
+                         type Tag = {tag_ty};\n\
+                         const TAG: {tag_ty} = ({}) as {tag_ty};\n\
+                     }}\n",
+                    a.ty.trim(), a.value))
+            })
+            .collect();
+        let impls: String = states.iter()
+            .map(|(st, s)| {
+                let det = format!("<{determinant} as {det_trait}<{s}>>");
+                let tag_of_self = wrap_tag(&format!("{det}::get(&self.repr)"));
+                let selects: String = arms.iter()
+                    .map(|a| format!("if t == ({}) as {tag_ty} {{\n\
+                                          return {};\n\
+                                      }}\n",
+                                     a.value,
+                                     if own(a) {
+                                         format!("Ok({en}Ref::{}(self))", a.name)
+                                     } else {
+                                         format!("<{}<{vs}::{st}> as {vs}::ArmRef>::arm_ref(self.as_bytes())\n\
+                                                      .map({en}Ref::{}).ok_or({t_tag})",
+                                                 a.ty.trim(), a.name)
+                                     }))
+                    .collect();
+                let ref_args = format!("<'_, {vs}::{st}>");
+                format!(
+                    "impl {s_ty}<{vs}::{st}> {{\n\
+                         /// The tag, whether this version knows it or not.\n\
+                         #[allow(dead_code)]\n\
+                         {vis} fn {tag}(&self) -> {tag_enum} {{\n\
+                             {tag_of_self}\n\
+                         }}\n\
+                         \n\
+                         /// The arm its tag selects, over its bytes - as many as its count\n\
+                         /// says, as its ArmRef has it: Err(the tag) if it isn't one of\n\
+                         /// ours, or the bytes are fewer than any valid one's. One shorter\n\
+                         /// than its type is an older version, its missing fields zero.\n\
+                         #[allow(dead_code)]\n\
+                         {vis} fn typed(&self) -> Result<{en}Ref{ref_args}, {tag_enum}> {{\n\
+                             let t: {tag_ty} = {det}::get(&self.repr);\n\
+                             {selects}\
+                             Err({t_tag})\n\
+                         }}\n\
+                         \n\
+                         /// The arm, if the tag is @A's: typed(), for one arm.\n\
+                         #[allow(dead_code)]\n\
+                         {vis} fn arm<A>(&self) -> Option<&A>\n\
+                         where\n\
+                             A: {arm_of}<Self, Tag = {tag_ty}> + {vs}::ArmRef + ?Sized,\n\
+                         {{\n\
+                             if {det}::get(&self.repr) != A::TAG {{\n\
+                                 return None;\n\
+                             }}\n\
+                             A::arm_ref(self.as_bytes())\n\
+                         }}\n\
+                         \n\
+                         /// arm(), to edit: as its ArmRef has it.\n\
+                         #[allow(dead_code)]\n\
+                         {vis} fn arm_mut<A>(&mut self) -> Option<&mut A>\n\
+                         where\n\
+                             A: {arm_of}<Self, Tag = {tag_ty}> + {vs}::ArmRef + ?Sized,\n\
+                         {{\n\
+                             if {det}::get(&self.repr) != A::TAG {{\n\
+                                 return None;\n\
+                             }}\n\
+                             A::arm_mut(self.as_bytes_mut())\n\
+                         }}\n\
+                     }}\n\
+                     \n")
+            })
+            .collect();
+        return with_defs(defs, name, &format!(
+            "{storage}\
+             /// One of {name}'s arms, with the bytes its header says are its - as\n\
+             /// many as there are, for one written before its type grew: what\n\
+             /// {name}'s typed() gives.\n\
+             #[allow(non_camel_case_types, dead_code)]\n\
+             #[derive(Clone, Copy)]\n\
+             {vis} enum {en}Ref<'a, St: {vs}::State = {vs}::Validated> {{\n{by_ref}}}\n\
+             \n\
+             {impls}\
+             {arms_of_by_state}"));
+    }
+
+    let tag_of_storage = wrap_tag(&format!("{det}::get(&self.0)"));
+    let ref_doc = if stated {
+        format!("/// One of {name}'s arms, by reference, in its state: what {name}::get()\n\
+                 /// gives - an arm that's another's type as long as its own header says.\n")
+    } else {
+        format!("/// One of {name}'s arms, by reference: what {name}::get() gives.\n")
+    };
+    // Bytes from outside: not with an enum tag, which they could hold a value
+    // of that isn't one of its variants
+    let unvalidated_impl = if tu.tag_is_enum {
+        String::new()
+    } else {
+        format!(
+            "impl {name}<{vs}::Unvalidated> {{\n\
+                 /// From its bytes, as C and disk have them.\n\
+                 #[allow(dead_code)]\n\
+                 {vis} fn from_bytes(b: &[u8; {s_size}]) -> Self {{\n\
+                     // SAFETY: the storage is plain data: any bytes are a valid {name}\n\
+                     Self(unsafe {{ b.as_ptr().cast::<{s_ty}>().read_unaligned() }}, ::core::marker::PhantomData)\n\
+                 }}\n\
+                 \n\
+                 /// The arm the tag selects: Err if the tag isn't one of ours, or the\n\
+                 /// arm's header says it's longer than the storage holds.\n\
+                 #[allow(dead_code)]\n\
+                 {vis} fn get(&self) -> Result<{en}Ref<'_{unvalidated}>, {vs}::ArmError<{tag_enum}>> {{\n\
+                     let t: {tag_ty} = {det}::get(&self.0);\n\
+                     let b = &self.as_bytes()[{payload_offset}..];\n\
+                     {gets_unvalidated}\
+                     Err({vs}::ArmError::Unknown({t_tag}))\n\
+                 }}\n\
+             }}\n\
+             \n",
+            unvalidated = st_arg("Unvalidated"),
+            gets_unvalidated = gets("Unvalidated",
+                &format!("return Err({vs}::ArmError::Bad {{ tag: {t_tag}, err }})")))
+    };
+    with_defs(defs, name, &format!(
+        "{storage}\
+         \n\
+         /// {name}, in state S - Validated unless named: over C's struct, {s_ty}.\n\
+         /// Unvalidated, bytes from outside - from the kernel, off a device - each\n\
+         /// arm checked against the storage as get() hands it out; Validated,\n\
+         /// what validate passed, or what's made here from an arm.\n\
+         #[allow(non_camel_case_types)]\n\
+         #[repr(transparent)]\n\
+         {vis} struct {name}<S = {vs}::Validated>({s_ty}, ::core::marker::PhantomData<S>);\n\
+         \n\
+         impl<S> Clone for {name}<S> {{\n\
+             fn clone(&self) -> Self {{\n\
+                 *self\n\
+             }}\n\
+         }}\n\
+         \n\
+         impl<S> Copy for {name}<S> {{}}\n\
+         \n\
+         /// One of {name}'s arms, by value: what {name}::new() takes.\n\
+         #[allow(non_camel_case_types, dead_code)]\n\
+         {vis} enum {en} {{\n{by_value}}}\n\
+         \n\
+         {ref_doc}\
+         #[allow(non_camel_case_types, dead_code)]\n\
+         #[derive(Clone, Copy)]\n\
+         {vis} enum {en}Ref<'a{st_param}> {{\n{by_ref}}}\n\
+         \n\
+         impl<S> {name}<S> {{\n\
+             /// The tag, whether this version knows it or not.\n\
+             #[allow(dead_code)]\n\
+             {vis} fn {tag}(&self) -> {tag_enum} {{\n\
+                 {tag_of_storage}\n\
+             }}\n\
+             \n\
+             /// Its bytes, as C and disk have them.\n\
+             #[allow(dead_code)]\n\
+             {vis} fn as_bytes(&self) -> &[u8; {s_size}] {{\n\
+                 // SAFETY: plain data, every byte of it written: it came from C or disk,\n\
+                 // from_bytes() or new(), which starts from zeroes\n\
+                 unsafe {{ &*(self as *const Self).cast::<[u8; {s_size}]>() }}\n\
+             }}\n\
+             \n\
+             /// For C.\n\
+             #[allow(dead_code)]\n\
+             {vis} fn as_ffi(&self) -> *const {s_ty} {{\n\
+                 &self.0\n\
+             }}\n\
+             \n\
+             /// For C, to edit.\n\
+             #[allow(dead_code)]\n\
+             {vis} fn as_ffi_mut(&mut self) -> *mut {s_ty} {{\n\
+                 &mut self.0\n\
+             }}\n\
+         }}\n\
+         \n\
+         {unvalidated_impl}\
+         impl {name}<{vs}::Validated> {{\n\
+             /// The arm the tag selects - Err(the tag) if it isn't one of ours.\n\
+             /// Validated, every arm fits in the storage.\n\
+             #[allow(dead_code)]\n\
+             {vis} fn get(&self) -> Result<{en}Ref<'_{validated}>, {tag_enum}> {{\n\
+                 let t: {tag_ty} = {det}::get(&self.0);\n\
+                 let b = &self.as_bytes()[{payload_offset}..];\n\
+                 {gets_validated}\
+                 Err({t_tag})\n\
+             }}\n\
+             \n\
+             /// From an arm: new(), by the arm's type.\n\
+             #[allow(dead_code)]\n\
+             {vis} fn from_arm<A: {arm_of}<{s_ty}, Tag = {tag_ty}>>(arm: A) -> Self {{\n\
+                 let mut s = Self::with_payload(arm);\n\
+                 {det}::set(&mut s, A::TAG);\n\
+                 Self(s, ::core::marker::PhantomData)\n\
+             }}\n\
+             \n\
+             /// From an arm ending in a flexible array, and that array - as many\n\
+             /// elements as the arm's header says: an error if the storage can't\n\
+             /// hold them.\n\
+             #[allow(dead_code)]\n\
+             {vis} fn from_arm_tailed<A>(arm: A, tail: &[A::Elem]) -> Result<Self, {vs}::VStructError>\n\
+             where A: {arm_of}<{s_ty}, Tag = {tag_ty}> + {vs}::FlexArray\n\
+             {{\n\
+                 assert_eq!(arm.nr(), tail.len(), \"{{}}: its header's count, and the elements given\",\n\
+                            ::core::any::type_name::<A>());\n\
+                 let at = {payload_offset} + A::TAIL;\n\
+                 let len = ::core::mem::size_of_val(tail);\n\
+                 if at + len > {s_size} {{\n\
+                     return Err({vs}::VStructError::Overrun {{ ty: ::core::any::type_name::<A>(),\n\
+                                                               want: A::TAIL + len,\n\
+                                                               have: {s_size} - {payload_offset} }});\n\
+                 }}\n\
+                 let mut s = Self::with_payload(arm);\n\
+                 // SAFETY: in bounds, as checked above, and the elements are plain data\n\
+                 unsafe {{\n\
+                     ::core::ptr::copy_nonoverlapping(tail.as_ptr().cast::<u8>(),\n\
+                         (&mut s as *mut {s_ty}).cast::<u8>().add(at), len);\n\
+                 }}\n\
+                 {det}::set(&mut s, A::TAG);\n\
+                 Ok(Self(s, ::core::marker::PhantomData))\n\
+             }}\n\
+             \n\
+             /// From an arm: its payload into zeroed storage, then the determinant marks\n\
+             /// it - stabby's order, so a tag that's bits of the payload is written last.\n\
+             #[allow(dead_code)]\n\
+             {vis} fn new(v: {en}) -> Self {{\n\
+                 match v {{\n{news}}}\n\
+             }}\n\
+             \n\
+             /// Zeroed storage holding @arm's payload, not yet marked as holding it.\n\
+             fn with_payload<A: {arm_of}<{s_ty}>>(arm: A) -> {s_ty} {{\n\
+                 // SAFETY: zeroes are a valid {name}: plain data, or its tag an enum\n\
+                 // with a zero variant - asserted below\n\
+                 let mut s: {s_ty} = unsafe {{ ::core::mem::zeroed() }};\n\
+                 // SAFETY: only arms are ArmOf, and each is plain data, in bounds - asserted\n\
+                 // below\n\
+                 unsafe {{\n\
+                     (&mut s as *mut {s_ty}).cast::<u8>().add({payload_offset}).cast::<A>()\n\
+                         .write_unaligned(arm);\n\
+                 }}\n\
+                 s\n\
+             }}\n\
+         }}\n\
+         \n\
+         {arms_of}\
+         {pad_assert}\
+         {arm_asserts}\
+         {packed_asserts}\
+         {c_record}",
+        validated = st_arg("Validated"),
+        gets_validated = gets("Validated",
+            &format!("panic!(\"{name}<Validated>: {{err}} - an arm that doesn't fit, in one \\
+                      validate passed or made from an arm\")"))))
+}
+
+/// @code, after @defs: the arm types defined in the block, then the rest.
+fn with_defs(mut defs: TokenStream, name: &str, code: &str) -> Result<TokenStream, String> {
+    let rest = code.parse::<TokenStream>()
+        .map_err(|e| format!("{name}: generated code doesn't parse: {e}"))?;
+    defs.extend(rest);
+    Ok(defs)
+}
diff --git a/fs/bcachefs/cstruct-macros/src/to_text.rs b/fs/bcachefs/cstruct-macros/src/to_text.rs
new file mode 100644
index 0000000..9859975
--- /dev/null
+++ b/fs/bcachefs/cstruct-macros/src/to_text.rs
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-2.0
+//! `#[derive(ToText)]`: a fieldless enum, printed as its variant's name -
+//! util/printbuf.rs's, here because this is the crate our macros live in.
+//!
+//! A variant prints as its own name, or as `#[label("..")]` names it: c_enum!
+//! labels the variants an x-macro makes with the name the list gives each, as
+//! C's string tables have them. It makes
+//!
+//! ```text
+//! pub const fn name(&self) -> &'static str
+//! impl ToText, writing name()
+//! impl Display, through ToText
+//! ```
+//!
+//! An enum with generics, or a variant with fields, has nothing it could
+//! print as a name alone: an error.
+
+use proc_macro::{Delimiter, Punct, Spacing, TokenStream, TokenTree};
+
+use crate::tokens;
+
+pub(crate) fn derive(input: TokenStream) -> Result<TokenStream, String> {
+    let mut trees = input.into_iter();
+
+    // past its attributes and visibility, to `enum NAME`
+    let name = loop {
+        match trees.next() {
+            Some(TokenTree::Ident(i)) if i.to_string() == "enum" => match trees.next() {
+                Some(TokenTree::Ident(n)) => break n.to_string(),
+                _ => return Err("expected the enum's name".into()),
+            },
+            Some(TokenTree::Ident(i)) if ["struct", "union"].contains(&i.to_string().as_str()) =>
+                return Err("for an enum".into()),
+            Some(_) => {}
+            None => return Err("expected an enum".into()),
+        }
+    };
+    let body = match trees.next() {
+        Some(TokenTree::Group(g)) if g.delimiter() == Delimiter::Brace => g.stream(),
+        _ => return Err(format!("{name}: a generic enum has no one set of names")),
+    };
+
+    let mut arms = String::new();
+    let mut variant: Vec<TokenTree> = Vec::new();
+    for t in body.into_iter().chain([TokenTree::Punct(Punct::new(',', Spacing::Alone))]) {
+        match t {
+            TokenTree::Punct(p) if p.as_char() == ',' => {
+                if !variant.is_empty() {
+                    arms.push_str(&arm(&name, &variant)?);
+                }
+                variant.clear();
+            }
+            t => variant.push(t),
+        }
+    }
+
+    Ok(tokens(&format!(
+        "#[automatically_derived]\n\
+         impl {name} {{\n\
+         \x20   /// What it prints as.\n\
+         \x20   pub const fn name(&self) -> &'static str {{\n\
+         \x20       match *self {{\n{arms}        }}\n\
+         \x20   }}\n\
+         }}\n\
+         #[automatically_derived]\n\
+         impl crate::util::ToText for {name} {{\n\
+         \x20   fn to_text(&self, out: &mut crate::util::Printbuf) {{\n\
+         \x20       out.write_fmt(::core::format_args!(\"{{}}\", self.name()))\n\
+         \x20   }}\n\
+         }}\n\
+         crate::display_via_to_text!({name});\n")))
+}
+
+/// One variant's match arm: its tokens, attributes first.
+fn arm(enum_name: &str, toks: &[TokenTree]) -> Result<String, String> {
+    let mut label = None;
+    let mut i = 0;
+    while let (Some(TokenTree::Punct(p)), Some(TokenTree::Group(g))) = (toks.get(i), toks.get(i + 1)) {
+        if p.as_char() != '#' || g.delimiter() != Delimiter::Bracket {
+            break;
+        }
+        let attr: Vec<TokenTree> = g.stream().into_iter().collect();
+        if let [TokenTree::Ident(n), TokenTree::Group(args)] = &attr[..] {
+            if n.to_string() == "label" {
+                match &args.stream().into_iter().collect::<Vec<_>>()[..] {
+                    [TokenTree::Literal(l)] if l.to_string().starts_with('"') => label = Some(l.to_string()),
+                    _ => return Err(format!("{enum_name}: #[label(\"name\")] takes a string")),
+                }
+            }
+        }
+        i += 2;
+    }
+
+    let Some(TokenTree::Ident(v)) = toks.get(i) else {
+        return Err(format!("{enum_name}: expected a variant name"));
+    };
+    match toks.get(i + 1) {
+        None => {}
+        Some(TokenTree::Punct(p)) if p.as_char() == '=' => {}
+        Some(_) => return Err(format!("{enum_name}::{v}: a variant with fields has no name to print")),
+    }
+    let label = label.unwrap_or_else(|| format!("\"{v}\""));
+    Ok(format!("            Self::{v} => {label},\n"))
+}
diff --git a/fs/bcachefs/cstruct-macros/src/typeinfo.rs b/fs/bcachefs/cstruct-macros/src/typeinfo.rs
new file mode 100644
index 0000000..bb55713
--- /dev/null
+++ b/fs/bcachefs/cstruct-macros/src/typeinfo.rs
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: GPL-2.0
+//! `#[derive(TypeInfo)]`: a `crate::typeinfo::TypeInfo` impl for a type C
+//! shares - the runtime type information kvdb introspects values with.
+//!
+//! INFO describes every field: name, offset (`offset_of!`, so the compiler
+//! guarantees it) and kind. The fields are cstruct.rs's parse - every struct
+//! deriving TypeInfo is a CStruct - and a field's kind is read from the C it
+//! renders as, cstruct::field_type(): a field's TypeInfo can't disagree with
+//! its generated C declaration.
+//!
+//! Field types it can't describe - pointers, function pointers, generics,
+//! kernel-internal structs - are Opaque rather than an error, so deriving it
+//! on a large in-memory struct is harmless. Unions get their size and no
+//! fields, as do the enums and bitfields the other macros here give TypeInfo.
+//! A field whose type is one of derives_type_info()'s names is described by
+//! reference to that type's own INFO, so that type must have TypeInfo too, or
+//! the `<T as TypeInfo>` bound fails to resolve (a loud, actionable error).
+
+use proc_macro::TokenStream;
+
+use crate::cstruct::{field_type, parse_cstruct, CKind, FieldType};
+use crate::tokens;
+
+const OPAQUE: &str = "crate::typeinfo::FieldKind::Opaque";
+
+/// The type names a field kind may reference as `<T as TypeInfo>::INFO`:
+/// each must have TypeInfo itself.
+fn derives_type_info(name: &str) -> bool {
+    name.starts_with("bch_") || matches!(name, "bpos" | "bkey" | "bversion")
+}
+
+/// By C's name: a family's C definition, X__head, is struct X to C.
+pub(crate) fn derive(input: TokenStream) -> Result<TokenStream, String> {
+    let def = parse_cstruct(&input.to_string())?;
+    let name = &def.name;
+    let inst = def.rust_ident();
+
+    let shape = match def.kind {
+        CKind::Struct => "Struct",
+        CKind::Union  => "Union",
+    };
+
+    let mut fields = String::new();
+    if def.kind == CKind::Struct {
+        // a place's At is zero bytes of nothing: not described
+        let described: Vec<_> = def.fields.iter().filter(|f| !crate::place::is_empty_at_field(f)).collect();
+        let last = described.len().saturating_sub(1);
+        for (i, f) in described.into_iter().enumerate() {
+            let field = f.rust_name();
+            fields.push_str(&format!(
+                "crate::typeinfo::FieldInfo {{ \
+                     name: \"{field}\", \
+                     offset: ::core::mem::offset_of!({inst}, {field}), \
+                     kind: {} \
+                 }},\n", kind(&f.ty, i == last)?));
+        }
+    }
+
+    Ok(tokens(&info_of(inst, name, shape, &fields)))
+}
+
+/// The TypeInfo impl for @name: @fields its FieldInfo entries - none for a
+/// type described by its size alone.
+pub(crate) fn info(name: &str, shape: &str, fields: &str) -> String {
+    info_of(name, name, shape, fields)
+}
+
+/// info(), for Rust type @ty, which C names @name.
+fn info_of(ty: &str, name: &str, shape: &str, fields: &str) -> String {
+    format!(
+        "#[automatically_derived]\n\
+         impl crate::typeinfo::TypeInfo for {ty} {{\n\
+             const INFO: &'static crate::typeinfo::StructInfo = &crate::typeinfo::StructInfo {{\n\
+                 name: \"{name}\",\n\
+                 size: ::core::mem::size_of::<{ty}>(),\n\
+                 shape: crate::typeinfo::Shape::{shape},\n\
+                 fields: &[{fields}],\n\
+             }};\n\
+         }}\n")
+}
+
+/// The `FieldKind` expression for a field of Rust type @ty; @last: it's the
+/// struct's last field, where `[T; 0]` is C's flexible array member, x[] -
+/// as long as the value.
+fn kind(ty: &str, last: bool) -> Result<String, String> {
+    Ok(match field_type(ty)? {
+        FieldType::Array { elem, n } => {
+            let elem_kind = kind(&elem, false)?;
+            let stride = format!("::core::mem::size_of::<{elem}>()");
+            if last && n == "0" {
+                format!("crate::typeinfo::FieldKind::VarTail {{ elem: &{elem_kind}, stride: {stride} }}")
+            } else {
+                format!("crate::typeinfo::FieldKind::Array {{ elem: &{elem_kind}, n: {n}, stride: {stride} }}")
+            }
+        }
+        FieldType::Opaque => OPAQUE.into(),
+        FieldType::Named { c, name } => match c.as_deref().and_then(int) {
+            Some((bytes, endian, signed)) => {
+                let bytes = match bytes {
+                    Some(b) => format!("{b}u8"),
+                    None    => format!("::core::mem::size_of::<{ty}>() as u8"),
+                };
+                format!("crate::typeinfo::FieldKind::Int {{ \
+                             bytes: {bytes}, \
+                             endian: crate::typeinfo::Endian::{endian}, \
+                             signed: {signed} \
+                         }}")
+            }
+            None if derives_type_info(&name) =>
+                format!("crate::typeinfo::FieldKind::Struct(<{ty} as crate::typeinfo::TypeInfo>::INFO)"),
+            None => OPAQUE.into(),
+        },
+    })
+}
+
+/// A C integer type, as canon_base() names Rust's: its size - None for the
+/// platform width, which the compiler supplies - endianness and signedness.
+fn int(c: &str) -> Option<(Option<u8>, &'static str, bool)> {
+    Some(match c {
+        "u8"  | "bool"                => (Some(1), "Native", false),
+        "u16" | "unsigned short"      => (Some(2), "Native", false),
+        "u32" | "unsigned"            => (Some(4), "Native", false),
+        "u64" | "unsigned long long"  => (Some(8), "Native", false),
+        "s8"  | "char"                => (Some(1), "Native", true),
+        "s16" | "short"               => (Some(2), "Native", true),
+        "s32" | "int"                 => (Some(4), "Native", true),
+        "s64" | "long long"           => (Some(8), "Native", true),
+        "__le16"                      => (Some(2), "Little", false),
+        "__le32"                      => (Some(4), "Little", false),
+        "__le64"                      => (Some(8), "Little", false),
+        "__be16"                      => (Some(2), "Big",    false),
+        "__be32"                      => (Some(4), "Big",    false),
+        "__be64"                      => (Some(8), "Big",    false),
+        "size_t"  | "unsigned long"   => (None,    "Native", false),
+        "ssize_t" | "long"            => (None,    "Native", true),
+        _ => return None,
+    })
+}
diff --git a/fs/bcachefs/cstruct-macros/src/vstructs.rs b/fs/bcachefs/cstruct-macros/src/vstructs.rs
new file mode 100644
index 0000000..3c107eb
--- /dev/null
+++ b/fs/bcachefs/cstruct-macros/src/vstructs.rs
@@ -0,0 +1,1285 @@
+// SPDX-License-Identifier: GPL-2.0
+//! What util/vstructs.rs's traits need of a type C shares, from its
+//! definition: #[derive(Plain)] - and #[bitfield], every one of which is -
+//! #[counted_by(FIELD)], a CStruct's FlexArray, #[derive(View)], its
+//! fields' projections on a View of it, and the families of definitions,
+//! one per state: #[unsized_vstruct], an unsized vstruct's; #[grown], a type
+//! that grew between format versions.
+//!
+//! Plain is a promise: every bit pattern of the type's bytes is a value of
+//! it, and every byte is a field's. These impls check it at compile time,
+//! rather than take it on trust: each field's type is Plain, and the fields'
+//! sizes add up to the type's, so there's no padding - zerocopy's FromBytes,
+//! for the types we define.
+
+use proc_macro::{Delimiter, Ident, TokenStream, TokenTree};
+
+use crate::cstruct::{field_type, parse_cstruct, parse_family_args, CFieldDef, CKind, CStructDef, FieldType};
+use crate::{cfi_encoding, tokens};
+
+/// #[derive(Plain)], on a struct - not a union, whose bytes past a short
+/// arm's end are no field's. An unsized vstruct's states aren't: they're its
+/// C definition's - #[unsized_vstruct]'s X__head - and then its tail's
+/// elements, Plain too, as the attribute checks.
+pub(crate) fn derive_plain(input: TokenStream) -> Result<TokenStream, String> {
+    let def = parse_cstruct(&input.to_string())?;
+    if def.kind != CKind::Struct {
+        return Err(format!("{}: Plain is for structs", def.name));
+    }
+    let tys: Vec<&str> = def.fields.iter().map(|f| f.ty.as_str()).collect();
+    Ok(tokens(&plain(def.rust_ident(), &tys)))
+}
+
+/// #[derive(SizedVal)]: the marker, for a key value - as an on-disk value,
+/// any bytes of it are one.
+pub(crate) fn derive_sized_val(input: TokenStream) -> Result<TokenStream, String> {
+    let def = parse_cstruct(&input.to_string())?;
+    let name = def.rust_ident();
+    // the same struct in every state, but from outside: OfSized
+    Ok(tokens(&format!("// SAFETY: an on-disk value, any bytes of which are one\n\
+                        unsafe impl crate::btree::bkey::SizedVal for {name} {{}}\n\
+                        impl {VS}::InState for {name} {{\n\
+                            type In<S: {VS}::State> = S::OfSized<Self>;\n\
+                            type State = {VS}::Validated;\n\
+                        }}\n")))
+}
+
+/// Plain for @name, whose fields are of types @tys: the impl, and the
+/// checks that make it sound - a compile error if it isn't. Native too, as
+/// itself.
+pub(crate) fn plain(name: &str, tys: &[&str]) -> String {
+    let fields: String = tys.iter()
+        .map(|ty| format!("crate::util::vstructs::assert_plain::<{ty}>();\n"))
+        .collect();
+    let sizes: String = tys.iter()
+        .map(|ty| format!(" + ::core::mem::size_of::<{ty}>()"))
+        .collect();
+    // and Native as itself: a struct reads as a struct. In-kernel, the
+    // kernel's own FromBytes and AsBytes - what uaccess's UserSlice reads and
+    // writes - whose conditions are Plain's: any bytes are one, every byte is
+    // a field's, and no field is a cell
+    format!(
+        "unsafe impl crate::util::vstructs::Plain for {name} {{}}\n\
+         #[cfg(kernel)]\n\
+         unsafe impl ::kernel::transmute::FromBytes for {name} {{}}\n\
+         #[cfg(kernel)]\n\
+         unsafe impl ::kernel::transmute::AsBytes for {name} {{}}\n\
+         impl crate::util::vstructs::Native for {name} {{\n\
+             type Native = Self;\n\
+             fn to_native(self) -> Self {{ self }}\n\
+             fn from_native(n: Self) -> Self {{ n }}\n\
+         }}\n\
+         const _: () = {{\n\
+             {fields}\
+             assert!(::core::mem::size_of::<{name}>() == 0{sizes},\n\
+                     \"{name}: padding between its fields - it isn't Plain\");\n\
+         }};\n")
+}
+
+/// A View's own methods, which a field's projection can't be named.
+const VIEW_METHODS: &[&str] = &["new", "get", "set", "whole", "whole_mut", "project", "as_view", "as_bytes"];
+
+/// #[derive(View)], on a Plain struct: a projection for each field, on View
+/// and ViewMut - `v.field()`, a View of the field, until field projections
+/// make it `v.field`. Not for fields named `_..`, padding and C's internals,
+/// or a trailing `[T; 0]`: a flexible array is View::as_bytes()'s. And
+/// __NAME_min!(FIELD), for a type whose values may end before FIELD: see
+/// min_arm().
+pub(crate) fn derive_view(input: TokenStream) -> Result<TokenStream, String> {
+    let def = parse_cstruct(&input.to_string())?;
+    if def.kind != CKind::Struct {
+        return Err(format!("{}: a View is of a struct", def.name));
+    }
+    let name = def.rust_ident();
+    let (mut get, mut get_mut) = (String::new(), String::new());
+    for f in &def.fields {
+        let field = f.rust_name();
+        let ty = f.ty.trim();
+        if field.starts_with('_') || matches!(field_type(ty)?, FieldType::Array { n, .. } if n == "0") {
+            continue;
+        }
+        if VIEW_METHODS.contains(&field.as_str()) {
+            return Err(format!("{name}.{field}: a View's own method is named {field} - \
+                                its projection would be hidden"));
+        }
+        let off = format!("::core::mem::offset_of!({name}, {field})");
+        get.push_str(&format!(
+            "pub fn {field}(&self) -> crate::util::projections::View<'a, {ty}> {{\n\
+                 self.project({off}, \"{field}\")\n\
+             }}\n"));
+        get_mut.push_str(&format!(
+            "pub fn {field}(&mut self) -> crate::util::projections::ViewMut<'_, {ty}> {{\n\
+                 self.project({off}, \"{field}\")\n\
+             }}\n"));
+    }
+    let arms: String = def.fields.iter().enumerate()
+        .map(|(i, f)| min_arm(name, &def.fields[..i], &f.rust_name()))
+        .collect();
+    Ok(tokens(&format!(
+        "#[allow(dead_code)]\n\
+         impl<'a> crate::util::projections::View<'a, {name}> {{\n{get}}}\n\
+         #[allow(dead_code)]\n\
+         impl<'a> crate::util::projections::ViewMut<'a, {name}> {{\n{get_mut}}}\n\
+         #[allow(unused_macros)]\n\
+         macro_rules! __{name}_min {{\n{arms}}}\n\
+         #[allow(unused_imports)]\n\
+         pub(crate) use __{name}_min;\n")))
+}
+
+/// __@name_min!'s arm for @field: @name up to it, its fields @before - the
+/// fields every valid value has, if one may end before @field - as
+/// @name_min, and @name Floored by it. For a key type, whose
+/// BCH_BKEY_TYPES() names @field: bkey_types! invokes it, through crate::c.
+///
+/// That's in another module, where @before's types as written may not be
+/// named, so it names them as every format file does: c and crate::types.
+fn min_arm(name: &str, before: &[CFieldDef], field: &str) -> String {
+    let min = format!("{name}_min");
+    let fields: String = before.iter()
+        .map(|f| format!("pub {}: {},\n", f.rust_name(), f.ty.trim()))
+        .collect();
+    let offsets: String = before.iter()
+        .map(|f| format!("assert!(::core::mem::offset_of!({min}, {0}) == \
+                          ::core::mem::offset_of!(crate::cstructs::c::{name}, {0}));\n", f.rust_name()))
+        .collect();
+    let tys: Vec<&str> = before.iter().map(|f| f.ty.trim()).collect();
+    let plain = plain(&min, &tys);
+    format!(
+        "({field}) => {{\n\
+             mod __{min} {{\n\
+                 #[allow(unused_imports)]\n\
+                 use crate::cstructs::c;\n\
+                 #[allow(unused_imports)]\n\
+                 use crate::types::*;\n\
+                 /// {name} up to {field}: the fields every valid one has.\n\
+                 #[repr(C)]\n\
+                 #[derive(Clone, Copy)]\n\
+                 #[allow(non_camel_case_types)]\n\
+                 pub struct {min} {{\n{fields}}}\n\
+                 {plain}\
+                 unsafe impl crate::util::projections::Floored for crate::cstructs::c::{name} {{\n\
+                     type Min = {min};\n\
+                 }}\n\
+                 const _: () = {{\n\
+                     {offsets}\
+                     assert!(::core::mem::size_of::<{min}>() == \
+                             ::core::mem::offset_of!(crate::cstructs::c::{name}, {field}));\n\
+                 }};\n\
+             }}\n\
+             pub use __{min}::{min};\n\
+         }};\n")
+}
+
+// ---- Families: a type's definitions, one per state (util/vstructs.rs) ----
+
+const VS: &str = "crate::util::vstructs";
+
+/// A field of C's struct as a state's definition has it, inline: pub only
+/// where C's is pub and holds no count - not the count, written private or
+/// pub(crate), nor an embedded header, Head<..>, whose own count it is, nor
+/// one of @private, which the family names: a counted type's count. Those
+/// read through the definition's Deref to its head, and can't be written: a
+/// count changes only through what holds the value.
+fn inline_field(f: &CFieldDef, private: &[&str]) -> String {
+    let vis = if f.vis == "pub" && !f.ty.contains("Head<") && !private.contains(&f.rust_name().as_str()) {
+        "pub "
+    } else {
+        ""
+    };
+    format!("    {vis}{}: {},\n", f.rust_name(), f.ty.trim())
+}
+
+/// @item's #[repr(..)]s, as written.
+fn repr_attrs(item: &TokenStream) -> String {
+    let tts: Vec<TokenTree> = item.clone().into_iter().collect();
+    tts.windows(2)
+        .filter_map(|w| match (&w[0], &w[1]) {
+            (TokenTree::Punct(p), TokenTree::Group(g))
+                if p.as_char() == '#' && g.delimiter() == Delimiter::Bracket
+                    && g.stream().to_string().trim_start().starts_with("repr") =>
+                Some(format!("#[{}]\n", g.stream())),
+            _ => None,
+        })
+        .collect()
+}
+
+/// What a state's definition is laid out as, for dst().
+#[derive(Clone, Copy)]
+struct Shape<'a> {
+    /// The item's #[repr]s, as written.
+    repr:    &'a str,
+    /// C's fields it has inline, at @head's offsets.
+    fields:  &'a [CFieldDef],
+    /// Those the family makes private: a counted type's count.
+    private: &'a [&'a str],
+    /// What precedes the tail: C's struct, or a grown type's floor.
+    head:    &'a str,
+    /// What it derefs to, #[repr(transparent)] over @head if not @head
+    /// itself: a #[whole] type's X<Whole>, where X's methods are.
+    deref:   &'a str,
+    /// After the fields: @tail, a slice of @elem.
+    tail:    &'a str,
+    elem:    &'a str,
+    /// C's struct: what as_ffi() points at.
+    ffi:     &'a str,
+    /// Where the tail starts, if not where the head ends: inside it, the
+    /// head being C's struct rounded up into the tail's first bytes - a key
+    /// value's (#[whole(tail = ..)]).
+    tail_at: Option<&'a str>,
+}
+
+/// A state's definition, @ty, laid out as @shape: a DST - its fields inline,
+/// those that hold a count private (inline_field()), then its tail.
+///
+/// Its fields are its head's, at the head's offsets - asserted - so it derefs
+/// to the head: reads, and the head's methods, written once there. No
+/// DerefMut: a &mut to the head would let a count - its own, or an embedded
+/// header's - be rewritten, or the whole head assigned or swapped, from
+/// outside what holds the value. Its own fields that hold one are private,
+/// and it's unsized, so it can't be assigned or swapped whole either.
+///
+/// It's Unsized: from_raw() at the length's worth of elements past the head;
+/// SelfSized, and its bytes, by its reference's length; and an arm's,
+/// ArmRef, cast() from the bytes its storage says are its. @doc is its own;
+/// @methods, more of them.
+fn dst(ty: &str, doc: &str, shape: &Shape<'_>, methods: &str) -> String {
+    let Shape { repr, fields, private, head, deref, tail, elem, ffi: _, tail_at } = *shape;
+    let tail_at = tail_at.map(str::to_string).unwrap_or_else(|| format!("::core::mem::size_of::<{head}>()"));
+    let plain_fields: String = fields.iter()
+        .map(|f| format!("{VS}::assert_plain::<{}>();\n", f.ty.trim()))
+        .collect();
+    let inline: String = fields.iter().map(|f| inline_field(f, private)).collect();
+    let offsets: String = fields.iter()
+        .map(|f| format!("assert!(::core::mem::offset_of!({ty}, {0}) == ::core::mem::offset_of!({head}, {0}),\n\
+                              \"{ty}.{0}: not at {head}'s offset\");\n", f.rust_name()))
+        .collect();
+    let tail_start = match fields.last() {
+        Some(l) => format!("::core::mem::offset_of!({ty}, {}) + ::core::mem::size_of::<{}>()",
+                           l.rust_name(), l.ty.trim()),
+        None => "0".to_string(),
+    };
+    format!(
+        "{doc}\
+         {repr}\
+         #[allow(non_camel_case_types)]\n\
+         pub struct {ty} {{\n\
+         {inline}\
+             pub {tail}: [{elem}],\n\
+         }}\n\
+         \n\
+         impl ::core::ops::Deref for {ty} {{\n\
+             type Target = {deref};\n\
+             #[inline]\n\
+             fn deref(&self) -> &{deref} {{\n\
+                 // SAFETY: its first size_of::<{head}>() bytes are {head}'s fields, at\n\
+                 // {head}'s offsets - asserted below, each Plain - and any of its\n\
+                 // tail they reach: it's no shorter than {head}, as Unsized says;\n\
+                 // {deref} is {head}, or #[repr(transparent)] over it\n\
+                 unsafe {{ &*(self as *const Self).cast::<{deref}>() }}\n\
+             }}\n\
+         }}\n\
+         \n\
+         // SAFETY: its head's fields, each Plain, then its tail at TAIL - as the\n\
+         // asserts below check - Plain; from_raw() makes the tail as long as\n\
+         // @bytes past TAIL\n\
+         unsafe impl {VS}::Unsized for {ty} {{\n\
+             type Head = {head};\n\
+             type Elem = {elem};\n\
+             const TAIL: usize = {tail_at};\n\
+             #[inline]\n\
+             fn from_raw(p: *const u8, bytes: usize) -> *const Self {{\n\
+                 let n = (bytes - Self::TAIL) / ::core::mem::size_of::<{elem}>();\n\
+                 ::core::ptr::slice_from_raw_parts(p.cast::<{elem}>(), n) as *const Self\n\
+             }}\n\
+             #[inline]\n\
+             fn from_raw_mut(p: *mut u8, bytes: usize) -> *mut Self {{\n\
+                 let n = (bytes - Self::TAIL) / ::core::mem::size_of::<{elem}>();\n\
+                 ::core::ptr::slice_from_raw_parts_mut(p.cast::<{elem}>(), n) as *mut Self\n\
+             }}\n\
+         }}\n\
+         \n\
+         const _: () = {{\n\
+             {VS}::assert_plain::<{elem}>();\n\
+             {plain_fields}\
+             {offsets}\
+             // its tail starts at TAIL - where its head ends, or inside it:\n\
+             // from_raw()'s length counts on it\n\
+             assert!(({tail_start}).next_multiple_of(::core::mem::align_of::<{elem}>())\n\
+                         == <{ty} as {VS}::Unsized>::TAIL,\n\
+                     \"{ty}: its tail starts where its fields end, at TAIL\");\n\
+             assert!(<{ty} as {VS}::Unsized>::TAIL <= ::core::mem::size_of::<{head}>());\n\
+         }};\n\
+         \n\
+         impl {VS}::SelfSized for {ty} {{\n\
+             #[inline]\n\
+             fn bytes(&self) -> usize {{\n\
+                 ::core::mem::size_of_val(self)\n\
+             }}\n\
+         }}\n\
+         \n\
+         // as a tagged union's arm, over the bytes its storage says are its\n\
+         impl {VS}::ArmRef for {ty} {{\n\
+             const MIN_LEN: usize = ::core::mem::size_of::<<Self as {VS}::Unsized>::Head>();\n\
+             \n\
+             fn arm_ref(b: &[u8]) -> Option<&Self> {{\n\
+                 {VS}::cast(b)\n\
+             }}\n\
+             \n\
+             fn arm_mut(b: &mut [u8]) -> Option<&mut Self> {{\n\
+                 {VS}::cast_mut(b)\n\
+             }}\n\
+             \n\
+             fn whole_len(len: usize) -> Option<usize> {{\n\
+                 {VS}::whole_len::<Self>(len)\n\
+             }}\n\
+         }}\n\
+         \n\
+         #[allow(dead_code)]\n\
+         impl {ty} {{\n\
+             /// Its bytes, every one.\n\
+             pub fn as_bytes(&self) -> &[u8] {{\n\
+                 {VS}::bytes_of(self)\n\
+             }}\n\
+             \n\
+             /// Its bytes, to edit: for its own walks - a count may be in them.\n\
+             pub(crate) fn as_bytes_mut(&mut self) -> &mut [u8] {{\n\
+                 {VS}::bytes_of_mut(self)\n\
+             }}\n\
+             \n\
+             {methods}\
+         }}\n\
+         \n")
+}
+
+/// @name's family, @name__family - its Unvalidated, Validated and Whole
+/// definitions. Every family has @name__unvalidated and @name__validated: a
+/// plain alias where a state shares another's definition, so a container's
+/// ArmOf impls can name each state's - concrete types, not projections.
+///
+/// And __@name__state_impls!{ items }: the items, impl'd on each of
+/// @with_fields, the definitions with C's fields inline - for c_bitmask!'s
+/// setters, which the Deref to C's struct can't reach: there's no DerefMut.
+fn family(name: &str, unvalidated: &str, validated: &str, whole: &str, with_fields: &[String])
+    -> String
+{
+    let aliases: String = [("unvalidated", unvalidated), ("validated", validated)].iter()
+        .filter(|(st, def)| *def != format!("{name}__{st}"))
+        .map(|(st, def)| format!("#[allow(non_camel_case_types)]\n\
+                                  pub type {name}__{st} = {def};\n"))
+        .collect();
+    let state_impls: String = with_fields.iter()
+        .map(|d| format!("impl {d} {{ $($items)* }}\n"))
+        .collect();
+    let state_impls = format!(
+        "#[doc(hidden)]\n\
+         #[allow(unused_macros)]\n\
+         macro_rules! __{name}__state_impls {{\n\
+             ($($items:tt)*) => {{\n{state_impls}}};\n\
+         }}\n");
+    format!(
+        "#[doc(hidden)]\n\
+         #[allow(non_camel_case_types)]\n\
+         pub struct {name}__family;\n\
+         \n\
+         impl {VS}::Family for {name}__family {{\n\
+             type Unvalidated = {unvalidated};\n\
+             type Validated = {validated};\n\
+             type Whole = {whole};\n\
+         }}\n\
+         \n\
+         {aliases}\
+         {state_impls}")
+}
+
+/// The methods of a state's definition, of a family whose count is its own -
+/// an unsized vstruct's, a counted type's: handed back to C, @ffi. What
+/// makes one is X<S>'s (generic_type()).
+fn state_methods(ffi: &str) -> String {
+    format!(
+        "/// For C: a pointer that reaches all of it.\n\
+         pub fn as_ffi(&self) -> *const {ffi} {{\n\
+             (self as *const Self).cast()\n\
+         }}\n\
+         \n\
+         /// For C, to edit: a pointer that reaches all of it.\n\
+         pub fn as_ffi_mut(&mut self) -> *mut {ffi} {{\n\
+             (self as *mut Self).cast()\n\
+         }}\n")
+}
+
+/// The family of a type whose count is its own - an unsized vstruct's, a
+/// #[counted] type's: both states laid out as @shape - Unvalidated, bytes
+/// from outside, its count checked against them; Validated, its count
+/// trusted as C trusts it - and Validated its Whole, the header never having
+/// grown.
+fn own_count_family(name: &str, shape: &Shape<'_>) -> String {
+    let state = |st: &str, what: &str| -> String {
+        let ty = format!("{name}__{}", st.to_lowercase());
+        dst(&ty,
+            &format!("/// {name}<{st}>: {what}. C's fields - those that hold a count\n\
+                      /// private - then its tail, as long as its count says. It derefs\n\
+                      /// to C's struct {name}, Head<{name}>, to read.\n"),
+            shape, &state_methods(shape.ffi))
+            + &format!(
+                "// a sized tagged union's arm: as many bytes as its count says\n\
+                 impl {VS}::ArmAt for {ty} {{\n\
+                     fn arm_at(b: &[u8]) -> Result<&Self, {VS}::VStructError> {{\n\
+                         {VS}::from_bytes::<Self>(b)\n\
+                     }}\n\
+                 }}\n")
+    };
+    let (unvalidated, validated) = (format!("{name}__unvalidated"), format!("{name}__validated"));
+    let unsized_states = [("Unvalidated", unvalidated.clone()), ("Validated", validated.clone()),
+                          ("Whole", validated.clone())];
+    format!(
+        "{}{}{}{}",
+        state("Unvalidated", "bytes from outside - off a device, from the kernel - its count \
+                              checked against them when it's made"),
+        state("Validated", "what C read and validated, its counts trusted as C trusts them"),
+        family(name, &unvalidated, &validated, &validated, &[unvalidated.clone(), validated.clone()]),
+        generic_type(name,
+               &Generic { default: "Validated", unsized_states: &unsized_states, arm_of: None,
+                          whole: None, ffi: Some(shape.ffi), typestate: false },
+               &format!("/// {name}, in state S - Validated unless named: a reference to one\n\
+                         /// reaches every byte of it and none past. C's struct {name} is\n\
+                         /// Head<{name}>.\n")))
+}
+
+/// #[unsized_vstruct]: the family of an unsized vstruct's definitions, one
+/// per state (util/vstructs.rs' Family), from C's struct as written.
+///
+/// C's definition is the item, renamed X__head, with #[c_name(X)]: C has it
+/// as struct X, Rust as Head<X> - X<S> is the family's type in state S,
+/// Validated unless named (generic_type()). Each state's definition,
+/// X__unvalidated and X__validated, is Rust's alone: a DST, the header and
+/// then its tail, as long as its count says - which derefs to the header,
+/// where its fields and methods are, written once. Its header never grew:
+/// Validated is whole.
+///
+/// The tail is the item's trailing flexible array, `NAME: [E; 0]` - the
+/// states' is `NAME: [E]` - or, where the header doesn't end in one, what
+/// the attribute says: `tail = [E]`, the states' `_tail`, the raw rest - a
+/// superblock field's, past its header; a btree node's, its bset's keys - or
+/// `tail = NAME: [E]`, an array the states call NAME.
+pub(crate) fn unsized_vstruct(attr: TokenStream, item: TokenStream) -> Result<TokenStream, String> {
+    let def = parse_cstruct(&item.to_string())?;
+    let name = def.rust_ident().to_string();
+    let last = def.fields.last().ok_or_else(|| format!("{name}: an unsized vstruct has fields"))?;
+    let args = parse_family_args(&attr.to_string(), &["tail"]).map_err(|e| format!("{name}: {e}"))?;
+    let (tail, elem) = match args.tail {
+        None => match field_type(&last.ty)? {
+            FieldType::Array { elem, n } if n == "0" => (last.rust_name(), elem),
+            _ => return Err(format!("{name}: its last field, {}, isn't a flexible array, [E; 0] - \
+                                     #[unsized_vstruct(tail = [E])] says what its tail holds",
+                                    last.name)),
+        },
+        Some((tail, elem)) => (tail.unwrap_or_else(|| "_tail".to_string()), elem),
+    };
+    let ffi = format!("{name}__head");
+    let last = last.rust_name();
+    // C's fields, inline in each state's definition - but its flexible array,
+    // where that's the tail
+    let fields = if tail == last { &def.fields[..def.fields.len() - 1] } else { &def.fields[..] };
+    let repr = repr_attrs(&item);
+    let shape = Shape { repr: &repr, fields, private: &[], head: &ffi, deref: &ffi, tail: &tail, elem: &elem,
+                        ffi: &ffi, tail_at: None };
+
+    let mut out = rename_struct(item, &def, &ffi)?;
+    out.extend(tokens(&format!(
+        "const _: () = {{\n\
+             // C's struct ends at its last field - its flexible array, or an\n\
+             // embedded vstruct's header, which ends where that one's tail starts\n\
+             assert!(::core::mem::offset_of!({ffi}, {last}) + crate::types::field_size(\n\
+                         |p: *const {ffi}| unsafe {{ ::core::ptr::addr_of!((*p).{last}) }}) as usize\n\
+                     == ::core::mem::size_of::<{ffi}>(),\n\
+                     \"{name}: its tail starts where its header ends\");\n\
+         }};\n\
+         \n\
+         {}",
+        own_count_family(&name, &shape))));
+    Ok(out)
+}
+
+/// #[counted], #[counted(PATH)], #[counted(PATH, tail = ..)]: the family of a
+/// type that's a header and an array it counts in elements - an ioctl's
+/// reply, a replicas usage record. Not a vstruct: no u64s, no entries to
+/// walk; its tail is just the array.
+///
+/// PATH is the count, as vstruct!'s is - a field, or a field of one it
+/// embeds (r.nr_devs) - and nr_entries if not named, the convention. Its
+/// first field holds the count, so that's private in each state's
+/// definition; C's struct keeps it as written, so a header can still be
+/// built standalone. The array is the item's trailing [E; 0], or what the
+/// attribute says - as #[unsized_vstruct]'s, `tail = [E]`, the states'
+/// `_tail`, or `tail = NAME: [E]`, a field of a field the states call NAME.
+///
+/// C's struct gets FlexArray from the count - its size, TAIL and the
+/// elements past it - and CountedHead, the way to its Unvalidated definition
+/// from what holds its bytes.
+pub(crate) fn counted(attr: TokenStream, item: TokenStream) -> Result<TokenStream, String> {
+    let def = parse_cstruct(&item.to_string())?;
+    let name = def.rust_ident().to_string();
+    let ffi = format!("{name}__head");
+
+    let args = parse_family_args(&attr.to_string(), &["count", "tail"]).map_err(|e| format!("{name}: {e}"))?;
+    let count = args.count.unwrap_or_else(|| "nr_entries".to_string());
+    let count_field = count.split('.').next().unwrap_or_default().to_string();
+    if !def.fields.iter().any(|f| f.rust_name() == count_field) {
+        return Err(format!("{name}: #[counted({count})], but {name} has no field {count_field} - \
+                            name its count, #[counted(FIELD)] or #[counted(FIELD.COUNT)]"));
+    }
+
+    // the array: a trailing [E; 0], or a field of a field - after C's struct,
+    // where dst() asserts its tail starts
+    let (tail, elem, fields, tail_at) = match args.tail {
+        Some((tail, elem)) => (tail.unwrap_or_else(|| "_tail".to_string()), elem, &def.fields[..],
+                               format!("::core::mem::size_of::<{ffi}>()")),
+        None => {
+            let last = def.fields.last().ok_or_else(|| format!("{name}: a counted type has fields"))?;
+            match field_type(&last.ty)? {
+                FieldType::Array { elem, n } if n == "0" =>
+                    (last.rust_name(), elem, &def.fields[..def.fields.len() - 1],
+                     format!("::core::mem::offset_of!({ffi}, {})", last.rust_name())),
+                _ => return Err(format!("{name}: its last field, {}, isn't a flexible array, [E; 0] - \
+                                         #[counted(.., tail = [E])] says where its array is",
+                                        last.name)),
+            }
+        }
+    };
+    let repr = repr_attrs(&item);
+    let private = [count_field.as_str()];
+    let shape = Shape { repr: &repr, fields, private: &private, head: &ffi, deref: &ffi, tail: &tail,
+                        elem: &elem, ffi: &ffi, tail_at: None };
+
+    let mut out = rename_struct(item, &def, &ffi)?;
+    out.extend(tokens(&format!(
+        "{}\
+         impl {VS}::CountedHead for {ffi} {{\n\
+             type Of<S: {VS}::State> = {name}<S>;\n\
+         }}\n\
+         \n\
+         // a reference as long as its count says is a whole number of its\n\
+         // alignment only if its elements are: else it claims bytes past it\n\
+         const _: () = assert!(::core::mem::size_of::<{elem}>() % ::core::mem::align_of::<{ffi}>() == 0,\n\
+             \"{name}: its elements aren't a whole number of its alignment\");\n\
+         \n\
+         {}",
+        flex_impl(&ffi, &tail_at, &elem, &count),
+        own_count_family(&name, &shape))));
+    Ok(out)
+}
+
+/// #[grown(from = FIELD)]: the family of a type that grew between format
+/// versions, from C's struct as written - FIELD the first field a valid
+/// value may lack, written by a version from before it.
+///
+/// X<S> is a generic struct over its definition in state S. X<Whole> - X -
+/// is the whole struct, every field a field: the item, renamed X__whole with
+/// #[c_name(X)], C's struct. X__floor is the fields before FIELD, every valid
+/// value's. X<Validated> - Unvalidated too, as the cast checks the floor - is
+/// a value in place, a DST: the floor's fields, then the bytes there are, at
+/// exactly the value's length; it derefs to the floor, to read. A field from
+/// FIELD on is a getter, zero past the end, and whole() is all of it, X, if
+/// it's all there.
+pub(crate) fn grown(attr: TokenStream, item: TokenStream) -> Result<TokenStream, String> {
+    let def = parse_cstruct(&item.to_string())?;
+    let name = def.name.clone();
+    let args = parse_family_args(&attr.to_string(), &["from", "bkey"]).map_err(|e| format!("{name}: {e}"))?;
+    let from = args.from.as_deref()
+        .ok_or_else(|| format!("{name}: #[grown(from = FIELD)], FIELD the first field an older \
+                                version's value may lack"))?;
+    let at = def.fields.iter().position(|f| f.rust_name() == from)
+        .ok_or_else(|| format!("{name}: #[grown(from = {from})], but {name} has no field {from}"))?;
+    if at == 0 {
+        return Err(format!("{name}: #[grown(from = {from})]: every valid value has at least one field"));
+    }
+    sized_family(&def, item, Some((from, at)), None, args.bkey)
+}
+
+/// #[whole]: the family of a type every valid value of which has all of it -
+/// C's validate rejects one shorter - though it may be longer, written by a
+/// version since: a superblock section or journal entry of fixed fields.
+///
+/// X<S> is a generic struct over its definition in state S. X<Whole> - X -
+/// is the struct: the item, renamed X__whole with #[c_name(X)], C's struct.
+/// X<Validated> and X<Unvalidated> are a value in place, a DST: X's fields,
+/// those that hold a count private, then the bytes past them there are, at
+/// exactly the value's length; it derefs to X, to read, and X's methods.
+///
+/// Or `#[whole(tail = NAME: [E])]`: C's struct ends in NAME: [E; 0] - and
+/// perhaps other zero-length arrays, C's other names for where it starts - a
+/// header and the array after it: a key value, its length the key's. The
+/// tail is NAME, from where C has it: inside C's struct, if align rounds the
+/// struct up into the array's first bytes - bch_inode's fields end at 14, its
+/// size is 16 - which the deref to C's struct reaches, a value being no
+/// shorter than that.
+///
+/// Or `tail = NAME: [u8]`, over any zero-length array: the bytes from where
+/// it starts, for a tail that's more than that array - bch_stripe's
+/// pointers, then checksums and sector counts its header sizes.
+pub(crate) fn whole(attr: TokenStream, item: TokenStream) -> Result<TokenStream, String> {
+    let def = parse_cstruct(&item.to_string())?;
+    let args = parse_family_args(&attr.to_string(), &["tail", "bkey"]).map_err(|e| format!("{}: {e}", def.name))?;
+    let tail = match args.tail {
+        None => None,
+        Some((None, _)) => return Err(format!("{}: #[whole(tail = NAME: [E])] - the tail is C's last \
+                                               field, NAME: [E; 0], named", def.name)),
+        Some((Some(tail), elem)) => {
+            let at = def.fields.iter().position(|f| f.rust_name() == tail)
+                .ok_or_else(|| format!("{}: #[whole(tail = {tail}: ..)], but it has no field {tail}", def.name))?;
+            // [E; 0] - or any zero-length array, for a tail of bytes
+            match field_type(&def.fields[at].ty)? {
+                FieldType::Array { elem: e, n }
+                    if n == "0" && (e.trim() == elem.trim() || elem.trim() == "u8") => {}
+                _ => return Err(format!("{}: #[whole(tail = {tail}: [{elem}])], but its field {tail} \
+                                         isn't [{elem}; 0]", def.name)),
+            }
+            // after it, only C's other names for where it starts
+            for f in &def.fields[at + 1..] {
+                if !matches!(field_type(&f.ty)?, FieldType::Array { n, .. } if n == "0") {
+                    return Err(format!("{}.{}: after the tail, {tail}, a field that isn't a \
+                                        zero-length array - C's other name for its start", def.name, f.name));
+                }
+            }
+            Some((tail, elem))
+        }
+    };
+    sized_family(&def, item, None, tail, args.bkey)
+}
+
+/// #[grown] and #[whole]: the family of sized C struct @def, written @item -
+/// @grew, the first field an older version's value may lack and its index,
+/// if it grew.
+///
+/// Both have a definition of all of it, every field inline: X__whole, if it
+/// grew - its Whole; else X__validated, its every state. Only that one is
+/// handed to C, as_ffi(): it's the one sure to hold all of C's struct.
+fn sized_family(def: &CStructDef, item: TokenStream, grew: Option<(&str, usize)>,
+                tail: Option<(String, String)>, bkey: bool)
+    -> Result<TokenStream, String>
+{
+    let name = def.rust_ident().to_string();
+    // A key's value: what a mutable copy of a key read as one is - and a
+    // grown type's struct, had by value
+    let bkey_impls = match (bkey, grew) {
+        (false, _) => String::new(),
+        (true, None) => format!(
+            "// SAFETY: every valid value has its head\n\
+             unsafe impl crate::btree::bkey::MutBkey for {name}<{VS}::Validated> {{\n\
+                 type Mut = Self;\n\
+                 const MIN_BYTES: usize = 0;\n\
+             }}\n\n"),
+        (true, Some(_)) => format!(
+            "// SAFETY: Plain, as #[grown] requires: no padding, any bytes a value\n\
+             unsafe impl crate::btree::bkey::BkeyWhole for {name} {{}}\n\
+             \n\
+             // SAFETY: every key is one of AllTypes'\n\
+             unsafe impl crate::btree::bkey::InFamily<crate::btree::bkey::AllTypes> for {name} {{}}\n\
+             \n\
+             // SAFETY: a BkeyWhole, its key whole\n\
+             unsafe impl crate::btree::bkey::MutBkey for {name}<{VS}::Validated> {{\n\
+                 type Mut = {name};\n\
+                 const MIN_BYTES: usize = ::core::mem::size_of::<crate::btree::bkey::BkeyI<{name}>>();\n\
+             }}\n\n"),
+    };
+    // The struct as written, renamed X__whole: X<Whole>'s representation,
+    // and C's struct X
+    let ffi = format!("{name}__whole");
+    // A value in place, as long as what holds it says: for a grown type the
+    // floor and the bytes there are, below; else all of its fields, then
+    // the bytes past them
+    let all = format!("{name}__validated");
+    // in place, the states but Whole: a DST
+    let states = [("Validated", all.clone()), ("Unvalidated", all.clone())];
+    let repr = repr_attrs(&item);
+    let derives = derive_names(&item);
+    // X is generated: a derive generic_type() doesn't forward would be
+    // X__whole's alone, out of X's reach. CStruct is C's record of the
+    // struct as written, which is X__whole's
+    if let Some(d) = derives.iter().find(|d| *d != "CStruct" && !WHOLE_DERIVES.contains(&d.as_str())) {
+        return Err(format!("{name}: #[derive({d})], but {name} - {name}<Whole> - is generated, and has \
+                            only the derives generic_type() forwards to it: {}", WHOLE_DERIVES.join(", ")));
+    }
+    // the tail, C's last field - or the bytes past C's fields
+    let (fields, tail_name, elem, tail_at) = match &tail {
+        Some((t, e)) => {
+            let at = def.fields.iter().position(|f| f.rust_name() == *t).unwrap_or(def.fields.len());
+            (&def.fields[..at], t.as_str(), e.as_str(), Some(format!("::core::mem::offset_of!({ffi}, {t})")))
+        }
+        None => (&def.fields[..], "_rest", "u8", None),
+    };
+    let Some((from, at)) = grew else {
+        // Every valid value has all of it: in place, all its fields and the
+        // bytes past them, in every state but Whole, the struct itself
+        let all_def = dst(&all,
+            &match &tail {
+                Some((t, _)) => format!("/// {name} in place: its fields - those that hold a count private -\n\
+                                         /// then {t}, from where C has it, as long as the value is. It\n\
+                                         /// derefs to the struct, to read.\n"),
+                None => format!("/// {name} in place: its fields - those that hold a count private - then\n\
+                                 /// the bytes past them there are, written by a version since, at\n\
+                                 /// exactly the value's length. It derefs to the struct, to read.\n"),
+            },
+            &Shape { repr: &repr, fields, private: &[], head: &ffi, deref: &name, tail: tail_name, elem,
+                     ffi: &ffi, tail_at: tail_at.as_deref() },
+            &format!("/// For C: a pointer to all of it.\n\
+                      pub fn as_ffi(&self) -> *const {ffi} {{\n\
+                          (self as *const Self).cast()\n\
+                      }}\n\
+                      \n\
+                      /// For C, to edit: a pointer to all of it.\n\
+                      pub fn as_ffi_mut(&mut self) -> *mut {ffi} {{\n\
+                          (self as *mut Self).cast()\n\
+                      }}\n"));
+        let mut out = rename_struct(item, &def, &ffi)?;
+        out.extend(tokens(&format!(
+            "{all_def}{}{}{}{bkey_impls}",
+            family(&name, &all, &all, &ffi, &[]),
+            whole_arm_ref(&ffi, derives.iter().any(|d| d == "Plain")),
+            generic_type(&name, &sized_generic(&all, &ffi, &derives, &states, false),
+                         &format!("/// {name}, in state S - Whole unless named: the struct, every field a field.\n\
+                                   /// Validated or Unvalidated, a value in place - all its fields, then\n\
+                                   /// the bytes past them a version since wrote, at the value's length.\n")))));
+        return Ok(out);
+    };
+    if !derives.iter().any(|d| d == "Plain") {
+        return Err(format!("{name}: #[grown] without Plain - the struct is a value in place, every \
+                            byte of it read, so it can't have padding"));
+    }
+    let (floor, later) = def.fields.split_at(at);
+
+    let fl = format!("{name}__floor");
+    let ty = format!("{name}__validated");
+
+    let floor_fields: String = floor.iter()
+        .map(|f| format!("    pub {}: {},\n", f.rust_name(), f.ty.trim()))
+        .collect();
+    let floor_tys: Vec<&str> = floor.iter().map(|f| f.ty.trim()).collect();
+    let floor_offsets: String = floor.iter()
+        .map(|f| format!("assert!(::core::mem::offset_of!({fl}, {0}) == ::core::mem::offset_of!({ffi}, {0}));\n",
+                         f.rust_name()))
+        .collect();
+
+    const METHODS: &[&str] = &["whole", "whole_mut", "as_bytes", "as_bytes_mut"];
+    let mut getters = String::new();
+    for f in later {
+        let field = f.rust_name();
+        if METHODS.contains(&field.as_str()) {
+            return Err(format!("{name}.{field}: {ty}'s own method is named {field} - its getter \
+                                would be hidden"));
+        }
+        let fty = f.ty.trim();
+        getters.push_str(&format!(
+            "/// {field}, or zero where the value ends before it: one written\n\
+             /// before {name} had it.\n\
+             pub fn {field}(&self) -> {fty} {{\n\
+                 {VS}::read_past::<{fty}>(&self._rest,\n\
+                     ::core::mem::offset_of!({ffi}, {field}) - ::core::mem::size_of::<{fl}>())\n\
+             }}\n\
+             \n"));
+    }
+
+    let methods = format!(
+        "/// All of it, if it's all there - every field a field.\n\
+         pub fn whole(&self) -> Option<&{name}> {{\n\
+             // SAFETY: {name} is #[repr(transparent)] over {ffi}\n\
+             {VS}::cast_plain::<{ffi}>(self.as_bytes())\n\
+                 .map(|w| unsafe {{ &*(w as *const {ffi} as *const {name}) }})\n\
+         }}\n\
+         \n\
+         /// whole(), to edit.\n\
+         pub fn whole_mut(&mut self) -> Option<&mut {name}> {{\n\
+             // SAFETY: as whole()'s\n\
+             {VS}::cast_plain_mut::<{ffi}>(self.as_bytes_mut())\n\
+                 .map(|w| unsafe {{ &mut *(w as *mut {ffi} as *mut {name}) }})\n\
+         }}\n\
+         \n\
+         {getters}");
+
+    let mut out = rename_struct(item, &def, &ffi)?;
+    out.extend(tokens(&format!(
+        "/// {name}'s floor: the fields every valid one has - all it had before\n\
+         /// it grew, from {from} on.\n\
+         #[repr(C)]\n\
+         #[derive(Clone, Copy)]\n\
+         #[allow(non_camel_case_types)]\n\
+         pub struct {fl} {{\n{floor_fields}}}\n\
+         {plain}\
+         const _: () = {{\n\
+             {floor_offsets}\
+             assert!(::core::mem::size_of::<{fl}>() == ::core::mem::offset_of!({ffi}, {from}),\n\
+                     \"{name}: its floor ends where {from} starts\");\n\
+         }};\n\
+         \n\
+         {dst}\
+         {family}\
+         {whole}\
+         {generic}\
+         {in_place}\
+         {bkey_impls}",
+        plain = plain(&fl, &floor_tys),
+        // all of it is a value in place, every field there: X's methods, on
+        // X<Validated>, are the struct's too
+        in_place = format!(
+            "impl ::core::ops::Deref for {ffi} {{\n\
+                 type Target = {name}<{VS}::Validated>;\n\
+                 #[inline]\n\
+                 fn deref(&self) -> &Self::Target {{\n\
+                     // SAFETY: all of its bytes - Plain, each a field's - which a value in\n\
+                     // place is as long as\n\
+                     unsafe {{ &*<Self::Target as {VS}::Unsized>::from_raw(\n\
+                         (self as *const Self).cast(), ::core::mem::size_of::<Self>()) }}\n\
+                 }}\n\
+             }}\n\
+             \n\
+             impl ::core::ops::DerefMut for {ffi} {{\n\
+                 #[inline]\n\
+                 fn deref_mut(&mut self) -> &mut Self::Target {{\n\
+                     // SAFETY: as deref()'s\n\
+                     unsafe {{ &mut *<Self::Target as {VS}::Unsized>::from_raw_mut(\n\
+                         (self as *mut Self).cast(), ::core::mem::size_of::<Self>()) }}\n\
+                 }}\n\
+             }}\n\
+             \n"),
+        dst = dst(&ty,
+                  &format!("/// A {name} as it was written, by any version since it had its floor:\n\
+                            /// the floor's fields, those that hold a count private, then the\n\
+                            /// bytes there are, at exactly the value's length. It derefs to the\n\
+                            /// floor, to read. A field it gained later is a getter, zero where\n\
+                            /// the value ends before it; whole() is all of it, if it's all there.\n"),
+                  &Shape { repr: "#[repr(C)]\n", fields: floor, private: &[], head: &fl, deref: &fl,
+                           tail: "_rest", elem: "u8", ffi: &ffi, tail_at: None },
+                  &methods),
+        // the cast checks the floor: an unvalidated one is as good
+        family = family(&name, &ty, &ty, &ffi, &[]),
+        whole = whole_arm_ref(&ffi, derives.iter().any(|d| d == "Plain")),
+        generic = generic_type(&name, &sized_generic(&ty, &ffi, &derives, &states, true),
+                               &format!("/// {name}, in state S - Whole unless named: the struct, every field a field.\n\
+                                         /// Validated or Unvalidated, a value in place, from any version since\n\
+                                         /// it had its floor: the floor's fields, then the bytes there are; a\n\
+                                         /// field it gained later is a getter, zero where the value ends.\n")))));
+    Ok(out)
+}
+
+/// A sized type's X<S>: Whole unless named, the struct @whole, with the value
+/// traits @derives names; in place, @inplace, an arm wherever that is - and
+/// if @typestate, Unvalidated a typestate over Validated.
+fn sized_generic<'a>(inplace: &'a str, whole: &'a str, derives: &'a [String],
+                     unsized_states: &'a [(&'a str, String)], typestate: bool) -> Generic<'a> {
+    Generic { default: "Whole", unsized_states, arm_of: Some(inplace), whole: Some((whole, derives)),
+              ffi: None, typestate }
+}
+
+/// The traits @item derives.
+fn derive_names(item: &TokenStream) -> Vec<String> {
+    let tts: Vec<TokenTree> = item.clone().into_iter().collect();
+    let mut out = Vec::new();
+    for w in tts.windows(2) {
+        let (TokenTree::Punct(p), TokenTree::Group(g)) = (&w[0], &w[1]) else { continue };
+        if p.as_char() != '#' || g.delimiter() != Delimiter::Bracket {
+            continue;
+        }
+        let inner: Vec<TokenTree> = g.stream().into_iter().collect();
+        if let [TokenTree::Ident(d), TokenTree::Group(args)] = inner.as_slice() {
+            if d.to_string() == "derive" {
+                out.extend(args.stream().into_iter().filter_map(|t| match t {
+                    TokenTree::Ident(i) => Some(i.to_string()),
+                    _ => None,
+                }));
+            }
+        }
+    }
+    out
+}
+
+/// @whole, a sized struct, from the bytes its storage says are its: all of
+/// it, aligned - a value longer than it, written by a version since, is
+/// still all of it. To edit, only if it's Plain (@plain): one with padding -
+/// a key value's header, rounded up into its tail - would write its padding
+/// over the tail.
+fn whole_arm_ref(whole: &str, plain: bool) -> String {
+    let (get, get_mut) = if plain {
+        (format!("{VS}::cast_plain(b)"), format!("{VS}::cast_plain_mut(b)"))
+    } else {
+        (format!("// SAFETY: that many bytes, aligned, and its fields - each Plain, as its\n\
+                  // value in place asserts - any bytes are; its padding is never read\n\
+                  (b.len() >= ::core::mem::size_of::<Self>() &&\n\
+                   b.as_ptr() as usize % ::core::mem::align_of::<Self>() == 0)\n\
+                      .then(|| unsafe {{ &*b.as_ptr().cast::<Self>() }})"),
+         "let _ = b;\nNone".to_string())
+    };
+    format!(
+        "impl {VS}::ArmRef for {whole} {{\n\
+             const MIN_LEN: usize = ::core::mem::size_of::<Self>();\n\
+             \n\
+             fn arm_ref(b: &[u8]) -> Option<&Self> {{\n\
+                 {get}\n\
+             }}\n\
+             \n\
+             fn arm_mut(b: &mut [u8]) -> Option<&mut Self> {{\n\
+                 {get_mut}\n\
+             }}\n\
+         }}\n\
+         \n")
+}
+
+/// The derives generic_type() gives X<Whole> as the struct has them.
+const WHOLE_DERIVES: &[&str] = &["Clone", "Copy", "Default", "Plain", "TypeInfo"];
+
+/// What a family's X<S> is made from: which states' definitions are DSTs,
+/// what it's an arm of, and what it's made by.
+struct Generic<'a> {
+    /// The state X alone names: Whole for a sized type, the struct;
+    /// Validated for an unsized one, whose Whole is its Validated.
+    default: &'a str,
+    /// The states whose definition is a DST, and each one's: these have
+    /// Unsized and SelfSized as it does.
+    unsized_states: &'a [(&'a str, String)],
+    /// Whose ArmOf it has: a sized type's value in place, in every state -
+    /// the struct, X<Whole>, is an arm wherever its value in place is - or,
+    /// None, its definition in each state's: an unsized type's, as a
+    /// container in that state has it.
+    arm_of: Option<&'a str>,
+    /// The sized struct, if Whole is one, and what it derives: X<Whole> has
+    /// the value traits among them that it has.
+    whole: Option<(&'a str, &'a [String])>,
+    /// C's struct, if X is made from C's pointer or from bytes - an unsized
+    /// type, whose count is its own: from_ffi() and from_bytes() on X<S>.
+    ffi: Option<&'a str>,
+    /// Whether Unvalidated is a typestate over Validated, X<Unvalidated>
+    /// dereffing to X<Validated> - where X's methods are - not to their
+    /// definition: a #[grown] type's, which is one for both, and whose length
+    /// validate checks before anything reads it.
+    typestate: bool,
+}
+
+/// @name<S>, documented @doc: a generic struct over its family's definition
+/// in state S, as @g says. #[repr(transparent)], so a reference to one is a
+/// reference to the other, and impls attach to @name<S> for the state
+/// they're for. What generic code goes by - ArmOf, ArmRef, Unsized - it has
+/// as its definition does.
+fn generic_type(name: &str, g: &Generic<'_>, doc: &str) -> String {
+    let fam = format!("{name}__family");
+    let default = g.default;
+    let mut out = format!(
+        "{doc}\
+         #[repr(transparent)]\n\
+         #[allow(non_camel_case_types)]\n\
+         pub struct {name}<S: {VS}::State = {VS}::{default}> {{\n\
+             _state:   ::core::marker::PhantomData<S>,\n\
+             /// Its definition in state S - for offset_of!(), repr.field.\n\
+             pub repr: <S as {VS}::State>::Of<{fam}>,\n\
+         }}\n\
+         \n\
+         impl<S: {VS}::State> {VS}::InState for {name}<S> {{\n\
+             type In<T: {VS}::State> = {name}<T>;\n\
+             type State = S;\n\
+         }}\n\
+         \n");
+
+    // To its definition in S - or, a typestate, to X<Validated>
+    let deref = |params: &str, ty: &str, target: &str, get: &str, get_mut: &str| format!(
+        "impl{params} ::core::ops::Deref for {ty} {{\n\
+             type Target = {target};\n\
+             #[inline]\n\
+             fn deref(&self) -> &Self::Target {{\n\
+                 {get}\n\
+             }}\n\
+         }}\n\
+         \n\
+         impl{params} ::core::ops::DerefMut for {ty} {{\n\
+             #[inline]\n\
+             fn deref_mut(&mut self) -> &mut Self::Target {{\n\
+                 {get_mut}\n\
+             }}\n\
+         }}\n\
+         \n");
+    if g.typestate {
+        for st in ["Whole", "Validated"] {
+            out.push_str(&deref("", &format!("{name}<{VS}::{st}>"),
+                                &format!("<{VS}::{st} as {VS}::State>::Of<{fam}>"),
+                                "&self.repr", "&mut self.repr"));
+        }
+        out.push_str(&deref("", &format!("{name}<{VS}::Unvalidated>"), &format!("{name}<{VS}::Validated>"),
+            "// SAFETY: #[repr(transparent)], both, over the one definition\n\
+             unsafe { &*(self as *const Self as *const Self::Target) }",
+            "// SAFETY: as deref()'s\n\
+             unsafe { &mut *(self as *mut Self as *mut Self::Target) }"));
+    } else {
+        out.push_str(&deref(&format!("<S: {VS}::State>"), &format!("{name}<S>"),
+                            &format!("<S as {VS}::State>::Of<{fam}>"), "&self.repr", "&mut self.repr"));
+    }
+
+    let arm_of_def = match g.arm_of {
+        Some(def) => def.to_string(),
+        None => format!("<S as {VS}::State>::Of<{fam}>"),
+    };
+    out.push_str(&format!(
+        "// An arm of what its definition is an arm of: the same tag\n\
+         impl<U: ?Sized, S: {VS}::State> crate::types::ArmOf<U> for {name}<S>\n\
+         where\n\
+             {arm_of_def}: crate::types::ArmOf<U>,\n\
+         {{\n\
+             type Tag = <{arm_of_def} as crate::types::ArmOf<U>>::Tag;\n\
+             const TAG: Self::Tag = <{arm_of_def} as crate::types::ArmOf<U>>::TAG;\n\
+         }}\n\
+         \n"));
+
+    // In every state, as its definition in that state is had: the pointer
+    // cast keeps the definition's metadata, its last field being it
+    out.push_str(&format!(
+        "impl<S: {VS}::State> {VS}::ArmRef for {name}<S> {{\n\
+             const MIN_LEN: usize = <<S as {VS}::State>::Of<{fam}> as {VS}::ArmRef>::MIN_LEN;\n\
+             \n\
+             fn arm_ref(b: &[u8]) -> Option<&Self> {{\n\
+                 // SAFETY: #[repr(transparent)] over its definition in S\n\
+                 <<S as {VS}::State>::Of<{fam}> as {VS}::ArmRef>::arm_ref(b)\n\
+                     .map(|d| unsafe {{ &*(d as *const <S as {VS}::State>::Of<{fam}> as *const Self) }})\n\
+             }}\n\
+             \n\
+             fn arm_mut(b: &mut [u8]) -> Option<&mut Self> {{\n\
+                 // SAFETY: as arm_ref()'s\n\
+                 <<S as {VS}::State>::Of<{fam}> as {VS}::ArmRef>::arm_mut(b)\n\
+                     .map(|d| unsafe {{ &mut *(d as *mut <S as {VS}::State>::Of<{fam}> as *mut Self) }})\n\
+             }}\n\
+             \n\
+             fn whole_len(len: usize) -> Option<usize> {{\n\
+                 <<S as {VS}::State>::Of<{fam}> as {VS}::ArmRef>::whole_len(len)\n\
+             }}\n\
+         }}\n\
+         \n\
+         impl<S: {VS}::State> {VS}::ArmAt for {name}<S>\n\
+         where\n\
+             <S as {VS}::State>::Of<{fam}>: {VS}::ArmAt,\n\
+         {{\n\
+             fn arm_at(b: &[u8]) -> Result<&Self, {VS}::VStructError> {{\n\
+                 // SAFETY: as arm_ref()'s\n\
+                 <<S as {VS}::State>::Of<{fam}> as {VS}::ArmAt>::arm_at(b)\n\
+                     .map(|d| unsafe {{ &*(d as *const <S as {VS}::State>::Of<{fam}> as *const Self) }})\n\
+             }}\n\
+         }}\n\
+         \n"));
+
+    for (st, def) in g.unsized_states {
+        out.push_str(&format!(
+            "// SAFETY: #[repr(transparent)] over {def}, whose Unsized it is\n\
+             unsafe impl {VS}::Unsized for {name}<{VS}::{st}> {{\n\
+                 type Head = <{def} as {VS}::Unsized>::Head;\n\
+                 type Elem = <{def} as {VS}::Unsized>::Elem;\n\
+                 const TAIL: usize = <{def} as {VS}::Unsized>::TAIL;\n\
+                 #[inline]\n\
+                 fn from_raw(p: *const u8, bytes: usize) -> *const Self {{\n\
+                     <{def} as {VS}::Unsized>::from_raw(p, bytes) as *const Self\n\
+                 }}\n\
+                 #[inline]\n\
+                 fn from_raw_mut(p: *mut u8, bytes: usize) -> *mut Self {{\n\
+                     <{def} as {VS}::Unsized>::from_raw_mut(p, bytes) as *mut Self\n\
+                 }}\n\
+             }}\n\
+             \n\
+             impl {VS}::SelfSized for {name}<{VS}::{st}> {{\n\
+                 #[inline]\n\
+                 fn bytes(&self) -> usize {{\n\
+                     ::core::mem::size_of_val(self)\n\
+                 }}\n\
+             }}\n\
+             \n"));
+
+        // made in the state the caller names: Whole, an unsized type's
+        // Validated, is never one made
+        if let Some(ffi) = g.ffi.filter(|_| *st != "Whole") {
+            let from_bytes = if *st == "Unvalidated" {
+                format!("/// The {name} at the start of @bytes - off a device, from the\n\
+                         /// kernel - as many as its count says: an error if they don't hold\n\
+                         /// its header, aligned, or that many.\n\
+                         pub fn from_bytes(bytes: &[u8]) -> Result<&Self, {VS}::VStructError> {{\n\
+                             {VS}::from_bytes::<Self>(bytes)\n\
+                         }}\n\
+                         \n\
+                         /// from_bytes(), mutably.\n\
+                         pub fn from_bytes_mut(bytes: &mut [u8]) -> Result<&mut Self, {VS}::VStructError> {{\n\
+                             {VS}::from_bytes_mut::<Self>(bytes)\n\
+                         }}\n\
+                         \n\
+                         /// It, Validated - the unsafe way up: both states are laid out\n\
+                         /// alike, so it's the same bytes, at the same length.\n\
+                         ///\n\
+                         /// # Safety\n\
+                         /// What Validated says of it is true: validate passed.\n\
+                         pub unsafe fn assume_validated(&self) -> &{name}<{VS}::Validated> {{\n\
+                             let p = <{name}<{VS}::Validated> as {VS}::Unsized>::from_raw(\n\
+                                 (self as *const Self).cast(), ::core::mem::size_of_val(self));\n\
+                             // SAFETY: its bytes, as long as they are; the caller's, that\n\
+                             // they're Validated\n\
+                             unsafe {{ &*p }}\n\
+                         }}\n\
+                         \n\
+                         /// assume_validated(), mutably.\n\
+                         ///\n\
+                         /// # Safety\n\
+                         /// As assume_validated()'s.\n\
+                         pub unsafe fn assume_validated_mut(&mut self) -> &mut {name}<{VS}::Validated> {{\n\
+                             let p = <{name}<{VS}::Validated> as {VS}::Unsized>::from_raw_mut(\n\
+                                 (self as *mut Self).cast(), ::core::mem::size_of_val(self));\n\
+                             // SAFETY: as assume_validated()'s\n\
+                             unsafe {{ &mut *p }}\n\
+                         }}\n")
+            } else if *st == "Validated" {
+                format!("/// It, Unvalidated - the safe way down: both states are laid out\n\
+                         /// alike, and an Unvalidated one trusts nothing - for what reads\n\
+                         /// one that may not be valid, a printer.\n\
+                         pub fn as_unvalidated(&self) -> &{name}<{VS}::Unvalidated> {{\n\
+                             let p = <{name}<{VS}::Unvalidated> as {VS}::Unsized>::from_raw(\n\
+                                 (self as *const Self).cast(), ::core::mem::size_of_val(self));\n\
+                             // SAFETY: its bytes, as long as they are\n\
+                             unsafe {{ &*p }}\n\
+                         }}\n")
+            } else {
+                String::new()
+            };
+            out.push_str(&format!(
+                "impl {name}<{VS}::{st}> {{\n\
+                     /// The {name} C's pointer @p is to, as long as its count says: not\n\
+                     /// widened from a reference to its header, which reaches only that.\n\
+                     /// In the state the caller names - {name}::<Validated>, for what C\n\
+                     /// read and validated - never one inferred.\n\
+                     ///\n\
+                     /// # Safety\n\
+                     /// @p points to a {name} whose count is right, and what its state\n\
+                     /// says of its entries' is true - for Validated, that C checked\n\
+                     /// them; and those bytes stay valid, and unwritten, for 'a.\n\
+                     pub unsafe fn from_ffi<'a>(p: *const {ffi}) -> &'a Self {{\n\
+                         // SAFETY: the caller's\n\
+                         unsafe {{ {VS}::from_ffi::<Self>(p) }}\n\
+                     }}\n\
+                     \n\
+                     /// from_ffi(), mutably.\n\
+                     ///\n\
+                     /// # Safety\n\
+                     /// As from_ffi()'s, and nothing else touches those bytes for 'a.\n\
+                     pub unsafe fn from_ffi_mut<'a>(p: *mut {ffi}) -> &'a mut Self {{\n\
+                         // SAFETY: the caller's\n\
+                         unsafe {{ {VS}::from_ffi_mut::<Self>(p) }}\n\
+                     }}\n\
+                     \n\
+                     {from_bytes}\
+                 }}\n\
+                 \n"));
+        }
+    }
+
+    let Some((whole, derives)) = g.whole else { return out };
+    let whole_ty = format!("{name}<{VS}::Whole>");
+
+    // Sized: in place, its first size_of bytes - for what holds a value it
+    // knows is whole, as a key in state Whole does, to make one from them
+    out.push_str(&format!(
+        "// SAFETY: a reference from it claims size_of::<Self>() of @bytes, the\n\
+         // first: the struct, every field Plain\n\
+         unsafe impl {VS}::Unsized for {whole_ty} {{\n\
+             type Head = {whole};\n\
+             type Elem = u8;\n\
+             const TAIL: usize = ::core::mem::size_of::<Self>();\n\
+             #[inline]\n\
+             fn from_raw(p: *const u8, _bytes: usize) -> *const Self {{\n\
+                 p.cast()\n\
+             }}\n\
+             #[inline]\n\
+             fn from_raw_mut(p: *mut u8, _bytes: usize) -> *mut Self {{\n\
+                 p.cast()\n\
+             }}\n\
+         }}\n\
+         \n"));
+    let has = |d: &str| derives.iter().any(|x| x == d);
+    if has("Clone") {
+        out.push_str(&format!(
+            "impl ::core::clone::Clone for {whole_ty} {{\n\
+                 fn clone(&self) -> Self {{\n\
+                     {name} {{ _state: ::core::marker::PhantomData, repr: self.repr.clone() }}\n\
+                 }}\n\
+             }}\n\n"));
+    }
+    if has("Copy") {
+        out.push_str(&format!("impl ::core::marker::Copy for {whole_ty} {{}}\n\n"));
+    }
+    if has("Default") {
+        out.push_str(&format!(
+            "impl ::core::default::Default for {whole_ty} {{\n\
+                 fn default() -> Self {{\n\
+                     {name} {{ _state: ::core::marker::PhantomData, repr: ::core::default::Default::default() }}\n\
+                 }}\n\
+             }}\n\n"));
+    }
+    if has("Plain") {
+        out.push_str(&format!(
+            "// SAFETY: #[repr(transparent)] over {whole}, which is Plain\n\
+             unsafe impl {VS}::Plain for {whole_ty} {{}}\n\n"));
+    }
+    if has("TypeInfo") {
+        out.push_str(&format!(
+            "impl crate::typeinfo::TypeInfo for {whole_ty} {{\n\
+                 const INFO: &'static crate::typeinfo::StructInfo =\n\
+                     <{whole} as crate::typeinfo::TypeInfo>::INFO;\n\
+             }}\n\n"));
+    }
+    out
+}
+
+/// @item, a struct, as @to - with #[c_name], C's name for it: its own, which
+/// it keeps, or added after its other attributes, so the derives among them
+/// see it.
+fn rename_struct(item: TokenStream, def: &CStructDef, to: &str) -> Result<TokenStream, String> {
+    let name = def.rust_ident();
+    let mut tts: Vec<TokenTree> = item.into_iter().collect();
+    let at = tts.windows(2)
+        .position(|w| matches!((&w[0], &w[1]), (TokenTree::Ident(s), TokenTree::Ident(n))
+                               if s.to_string() == "struct" && n.to_string() == name))
+        .ok_or_else(|| format!("{name}: a family is made from a struct"))?;
+    tts[at + 1] = TokenTree::Ident(Ident::new(to, tts[at + 1].span()));
+    let mut attrs_end = 0;
+    while matches!((tts.get(attrs_end), tts.get(attrs_end + 1)),
+                   (Some(TokenTree::Punct(p)), Some(TokenTree::Group(g)))
+                       if p.as_char() == '#' && g.delimiter() == Delimiter::Bracket) {
+        attrs_end += 2;
+    }
+    let mut out: TokenStream = tts[..attrs_end].iter().cloned().collect();
+    // C's name: the item's #[c_name], which it keeps, or its own
+    if def.rust_name.is_none() {
+        out.extend(tokens(&format!("#[c_name({})]", def.name)));
+    }
+    out.extend(tokens(&cfi_encoding(&def.name)));
+    out.extend(tts[attrs_end..].iter().cloned());
+    Ok(out)
+}
+
+/// A CStruct's FlexArray, from #[counted_by(FIELD)] on its trailing `[T; 0]`
+/// - empty if it has none.
+pub(crate) fn flex_array(def: &CStructDef) -> Result<String, String> {
+    let name = def.rust_ident();
+    let Some((i, f)) = def.fields.iter().enumerate().find(|(_, f)| f.counted_by.is_some()) else {
+        return Ok(String::new());
+    };
+    let count = f.counted_by.as_deref().unwrap_or_default();
+    let elem = match field_type(&f.ty)? {
+        FieldType::Array { elem, n } if n == "0" && i + 1 == def.fields.len() => elem,
+        _ => return Err(format!("{name}.{}: #[counted_by] is for the last field, a [T; 0]", f.name)),
+    };
+    if !def.fields.iter().any(|g| g.rust_name() == count) {
+        return Err(format!("{name}.{}: #[counted_by({count})]: {name} has no field {count}", f.name));
+    }
+    Ok(flex_impl(name, &format!("::core::mem::offset_of!({name}, {})", f.rust_name()), &elem, count))
+}
+
+/// FlexArray for @name: @elem from @tail_at, as many as @count says.
+fn flex_impl(name: &str, tail_at: &str, elem: &str, count: &str) -> String {
+    // the count by value: a reference to a packed struct's field may be
+    // unaligned
+    format!(
+        "impl {VS}::FlexArray for {name} {{\n\
+             type Elem = {elem};\n\
+             const TAIL: usize = {tail_at};\n\
+             #[inline]\n\
+             fn nr(&self) -> usize {{ {VS}::Count::count(&{{ self.{count} }}) }}\n\
+         }}\n\
+         \n")
+}
diff --git a/fs/bcachefs/cstruct-macros/src/xmacro_from_c.rs b/fs/bcachefs/cstruct-macros/src/xmacro_from_c.rs
new file mode 100644
index 0000000..46c1605
--- /dev/null
+++ b/fs/bcachefs/cstruct-macros/src/xmacro_from_c.rs
@@ -0,0 +1,246 @@
+// SPDX-License-Identifier: GPL-2.0
+//! c_xmacro_from_c!: an x-macro list C defines, for Rust - until its header
+//! is converted and the list is a c_xmacro!.
+//!
+//!   c_xmacro_from_c!(BCH_INODE_OPTS, "fs/inode_format.h");
+//!
+//! is the c_xmacro! of the header's #define BCH_INODE_OPTS() - c_xmacro! {
+//! BCH_INODE_OPTS(x) { (data_checksum, 8), ... } } - expanded the same way,
+//! only not recorded: C has the list already. Rust gets the same NAME!(cb),
+//! so nothing using the list changes when a c_xmacro! replaces it.
+//!
+//! The header is named relative to the crate, CARGO_MANIFEST_DIR: cargo sets
+//! it, and kbuild sets it for mod.o (fs/Makefile.rust). It's include_bytes!'d
+//! for rustc's dep-info, so a change to the list rebuilds what uses it.
+//!
+//! The #define is read as written, one call per entry:
+//!
+//!  - x(args) - or whatever the list's callback is called, one name for all
+//!    its entries: BLK_ERRS()'s is BLK_STS - is (args);
+//!  - OTHER() splices in another list from the same header. If OTHER's
+//!    callback isn't this list's, the header defines it in terms of this
+//!    one's, #define CB(params) x(template), and the splice is
+//!    OTHER(CB(params) => (template)).
+//!
+//! Anything else is an error, as is a list defined more than once: there's
+//! no preprocessor here to choose between definitions.
+
+use std::collections::HashMap;
+
+/// A function-like #define: its parameters, and its body as one line.
+struct Define {
+    params: Vec<String>,
+    body:   String,
+}
+
+/// c_xmacro_from_c!'s input, NAME, "header": c_xmacro!'s input for the
+/// list, and the header's path, to include_bytes!.
+pub(crate) fn read(input: proc_macro::TokenStream) -> Result<(String, String), String> {
+    use proc_macro::TokenTree;
+
+    let toks: Vec<TokenTree> = input.into_iter().collect();
+    let (name, header) = match toks.as_slice() {
+        [TokenTree::Ident(name), TokenTree::Punct(comma), TokenTree::Literal(header)]
+            if comma.as_char() == ',' => (name.to_string(), header.to_string()),
+        _ => return Err("expected NAME, \"header\"".into()),
+    };
+    let header = header.strip_prefix('"').and_then(|h| h.strip_suffix('"'))
+        .ok_or_else(|| format!("{name}: the header is a string, got {header}"))?;
+
+    let dir = std::env::var("CARGO_MANIFEST_DIR").map_err(|_| format!(
+        "{name}: CARGO_MANIFEST_DIR isn't set - cargo sets it, and kbuild has to, for mod.o"))?;
+    let path = format!("{dir}/{header}");
+    let text = std::fs::read_to_string(&path)
+        .map_err(|e| format!("{name}: reading {path}: {e}"))?;
+
+    let xmacro = translate(&defines(&text), &name).map_err(|e| format!("{e}, in {header}"))?;
+    Ok((xmacro, path))
+}
+
+/// The function-like #defines in @text, by name: each name's definitions,
+/// in order.
+fn defines(text: &str) -> HashMap<String, Vec<Define>> {
+    // As the preprocessor: lines spliced, then comments gone.
+    let text = strip_comments(&text.replace("\\\n", " "));
+    let ident = |c: char| c.is_ascii_alphanumeric() || c == '_';
+
+    let mut out: HashMap<String, Vec<Define>> = HashMap::new();
+    for line in text.lines() {
+        let Some(rest) = line.trim_start().strip_prefix('#') else { continue };
+        let Some(rest) = rest.trim_start().strip_prefix("define") else { continue };
+        if !rest.starts_with(char::is_whitespace) {
+            continue;
+        }
+        let rest = rest.trim_start();
+        let (name, rest) = rest.split_at(rest.find(|c| !ident(c)).unwrap_or(rest.len()));
+        // Function-like: its ( right after the name.
+        let Some(rest) = rest.strip_prefix('(') else { continue };
+        let Some(close) = rest.find(')') else { continue };
+
+        let params = rest[..close].split(',')
+            .map(|p| p.trim().to_string())
+            .filter(|p| !p.is_empty())
+            .collect();
+        out.entry(name.to_string()).or_default()
+            .push(Define { params, body: rest[close + 1..].trim().to_string() });
+    }
+    out
+}
+
+/// @text without its comments: a block comment is a space, as in C, and a
+/// line comment ends at its line. String and character literals are skipped.
+fn strip_comments(text: &str) -> String {
+    let mut out = String::with_capacity(text.len());
+    let mut chars = text.chars().peekable();
+    while let Some(c) = chars.next() {
+        match c {
+            '/' if chars.peek() == Some(&'*') => {
+                chars.next();
+                let mut prev = ' ';
+                for c in chars.by_ref() {
+                    if prev == '*' && c == '/' {
+                        break;
+                    }
+                    prev = c;
+                }
+                out.push(' ');
+            }
+            '/' if chars.peek() == Some(&'/') => {
+                for c in chars.by_ref() {
+                    if c == '\n' {
+                        out.push('\n');
+                        break;
+                    }
+                }
+            }
+            '"' | '\'' => {
+                out.push(c);
+                while let Some(d) = chars.next() {
+                    out.push(d);
+                    if d == '\\' {
+                        if let Some(e) = chars.next() {
+                            out.push(e);
+                        }
+                    } else if d == c {
+                        break;
+                    }
+                }
+            }
+            _ => out.push(c),
+        }
+    }
+    out
+}
+
+/// @body as the calls it is, NAME(args) each: their names and argument text.
+fn calls(body: &str) -> Result<Vec<(String, String)>, String> {
+    let ident = |c: char| c.is_ascii_alphanumeric() || c == '_';
+    let mut out = Vec::new();
+    let mut rest = body.trim_start();
+
+    while !rest.is_empty() {
+        let len = rest.find(|c| !ident(c)).unwrap_or(rest.len());
+        let (name, after) = rest.split_at(len);
+        let after = after.trim_start();
+        if name.is_empty() || !after.starts_with('(') {
+            let context: String = rest.chars().take(40).collect();
+            return Err(format!("expected NAME(args), at \"{context}\""));
+        }
+
+        // The matching ), past nested parentheses and literals:
+        let mut depth = 0;
+        let mut quote = None;
+        let mut escaped = false;
+        let mut end = None;
+        for (i, c) in after.char_indices() {
+            match quote {
+                Some(_) if escaped => escaped = false,
+                Some(_) if c == '\\' => escaped = true,
+                Some(q) if c == q => quote = None,
+                Some(_) => {}
+                None => match c {
+                    '"' | '\'' => quote = Some(c),
+                    '(' => depth += 1,
+                    ')' => {
+                        depth -= 1;
+                        if depth == 0 {
+                            end = Some(i);
+                            break;
+                        }
+                    }
+                    _ => {}
+                },
+            }
+        }
+        let end = end.ok_or_else(|| format!("{name}(: unterminated"))?;
+        out.push((name.to_string(), after[1..end].trim().to_string()));
+        rest = after[end + 1..].trim_start();
+    }
+    Ok(out)
+}
+
+/// @name's one definition in @defs.
+fn one<'a>(defs: &'a HashMap<String, Vec<Define>>, name: &str) -> Result<&'a Define, String> {
+    match defs.get(name).map(Vec::as_slice) {
+        Some([d]) => Ok(d),
+        None | Some([]) => Err(format!("no #define {name}()")),
+        Some(ds) => Err(format!("#define {name}() {} times - choosing one takes the preprocessor",
+                                ds.len())),
+    }
+}
+
+/// The callback list @name's entries call: x unless they say otherwise.
+fn callback(name: &str, calls: &[(String, String)]) -> Result<String, String> {
+    let mut cb: Option<&str> = None;
+    for (f, args) in calls {
+        if args.is_empty() {
+            continue;
+        }
+        match cb {
+            None => cb = Some(f),
+            Some(c) if c == f => {}
+            Some(c) => return Err(format!("{name}()'s entries call both {c}() and {f}()")),
+        }
+    }
+    Ok(cb.unwrap_or("x").to_string())
+}
+
+/// List @name, from @defs, as c_xmacro!'s input: NAME(cb) { entries }.
+fn translate(defs: &HashMap<String, Vec<Define>>, name: &str) -> Result<String, String> {
+    let d = one(defs, name)?;
+    if !d.params.is_empty() {
+        return Err(format!("#define {name}({}): a list takes no parameters", d.params.join(", ")));
+    }
+    let calls = calls(&d.body).map_err(|e| format!("{name}(): {e}"))?;
+    let cb = callback(name, &calls)?;
+
+    let mut entries = Vec::new();
+    for (f, args) in &calls {
+        if !args.is_empty() {
+            entries.push(format!("({args})"));
+            continue;
+        }
+
+        // A splice: OTHER(), its entries through a mapping macro if they
+        // call something else.
+        let sub = one(defs, f).map_err(|e| format!("{name}() splices {f}(): {e}"))?;
+        let sub_cb = callback(f, &calls_of(f, sub)?)?;
+        if sub_cb == cb {
+            entries.push(format!("{f}()"));
+            continue;
+        }
+        let map = one(defs, &sub_cb)
+            .map_err(|e| format!("{name}() splices {f}(), whose entries call {sub_cb}(): {e}"))?;
+        let template = match calls_of(&sub_cb, map)?.as_slice() {
+            [(x, template)] if *x == cb => template.replace("##", " ## "),
+            _ => return Err(format!("#define {sub_cb}({}) isn't one call of {cb}()",
+                                    map.params.join(", "))),
+        };
+        entries.push(format!("{f}({sub_cb}({}) => ({template}))", map.params.join(", ")));
+    }
+    Ok(format!("{name}({cb}) {{ {} }}", entries.join(", ")))
+}
+
+fn calls_of(name: &str, d: &Define) -> Result<Vec<(String, String)>, String> {
+    calls(&d.body).map_err(|e| format!("{name}(): {e}"))
+}
