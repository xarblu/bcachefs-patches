+    #[test]
+    fn ptr_swab_reads_the_other_endianness() {
+        use c::bch_csum_type as t;
+
+        let c32 = c::bch_extent_crc32::pack(&crc(t::BCH_CSUM_crc32c, 8, 0, 0)).unwrap();
+        let c64 = c::bch_extent_crc64::pack(&crc(t::BCH_CSUM_chacha20_poly1305_80, 8, 0, 3)).unwrap();
+        let c128 = c::bch_extent_crc128::pack(&crc(t::BCH_CSUM_chacha20_poly1305_128, 8, 0, 3)).unwrap();
+        let ptr = word(0, 0x123456789);
+
+        let native: std::vec::Vec<u64> = [words_of(&c32), vec![ptr], words_of(&c64), vec![ptr],
+                                          words_of(&c128), vec![ptr]].concat();
+
+        // As the other endianness writes it: each word's value the same, so its
+        // bytes reversed - but checksums are bytes: crc128's csum and crc64's
+        // csum_lo the same bytes, and the checksum bits in crc32's and crc64's
+        // first word byte-swapped values.
+        let mut b32 = c32;
+        b32.set_csum(c32.csum().swap_bytes());
+        let mut b64 = c64;
+        b64.set_csum_hi(c64.csum_hi().swap_bytes());
+        let c64w = words_of(&c64);
+        let c128w = words_of(&c128);
+        let mut other: std::vec::Vec<u64> = [
+            vec![words_of(&b32)[0].swap_bytes(), ptr.swap_bytes()],
+            vec![words_of(&b64)[0].swap_bytes(), c64w[1], ptr.swap_bytes()],
+            vec![c128w[0].swap_bytes(), c128w[1], c128w[2], ptr.swap_bytes()],
+        ].concat();
+
+        ops::entries_swab(sizes(&ours()), bytes(&mut other));
+        assert_eq!(other, native);
+    }
+
+    /// The nonces C's extent_nonce() gives on little-endian - worked by hand,
+    /// as data on disk was encrypted with them. A wrong one shows only as
+    /// encrypted extents whose checksums never verify.
+    #[test]
+    fn extent_nonce_as_c_makes_it() {
+        let version = c::bversion { lo: 0x1122_3344_5566_7788, hi: 0x9a };
+        let words = |n: c::nonce| n.d.map(|w| w.get());
+
+        // not compressed: no size or compression type; crc.nonce 3 is three
+        // 512 byte sectors, 24 ChaCha20 blocks
+        let mut crc = crc(c::bch_csum_type::BCH_CSUM_chacha20_poly1305_128, 128, 0, 3);
+        assert_eq!(words(extent_nonce(version, &crc)),
+                   [24, 0x5566_7788, 0x1122_3344, 0x1000_009a]);
+
+        // incompressible counts as not compressed
+        crc.compression_type = 5;
+        assert_eq!(words(extent_nonce(version, &crc)),
+                   [24, 0x5566_7788, 0x1122_3344, 0x1000_009a]);
+
+        // lz4 (3), 256 sectors uncompressed: the size at bit 22, the type at
+        // bit 24 of the last word, under the extent domain at 28
+        crc.compression_type = 3;
+        crc.uncompressed_size = 256;
+        assert_eq!(words(extent_nonce(version, &crc)),
+                   [(256 << 22) + 24, 0x5566_7788, 0x1122_3344, 0x1300_009a]);
+    }
+}
diff --git a/fs/bcachefs/data/ptrs_c_export.rs b/fs/bcachefs/data/ptrs_c_export.rs
new file mode 100644
index 0000000..32e4efe
--- /dev/null
+++ b/fs/bcachefs/data/ptrs_c_export.rs
@@ -0,0 +1,218 @@
+//! ptrs.rs's wrappers for C: each a C name over a Rust function, with C's
+//! types - the filesystem &Fs where C's pointer is const and &Opaque where it
+//! isn't, keys untyped, a key without pointers answered as an empty list of
+//! them.
+
+use super::*;
+use super::ops::{btree_ptr_validate, btree_ptr_v2_validate};
+use crate::btree::iter::{BtreeTrans, TransBkey};
+use crate::errcode::ret_to_c;
+use crate::init::error::BkeyValidate;
+use crate::util::ffi::Opaque;
+use crate::util::Printbuf;
+use core::ffi::{c_int, c_uint};
+use core::mem::MaybeUninit;
+use cstruct_macros::c_export;
+
+// ── bkey methods ─────────────────────────────────────────────────────────
+
+#[c_export]
+pub fn bch2_bkey_ptrs_validate(c: &Opaque<c::bch_fs>, k: BkeySC<'_>, from: &c::bkey_validate_context)
+    -> c_int
+{
+    ret_to_c(bkey_ptrs_validate(&BkeyValidate { fs: Fs::from_c(c), k, from }))
+}
+
+/// For C, which may or may not be in a read-side section: this takes its own.
+#[cold]
+#[c_export]
+pub fn bch2_extent_ptr_to_text(out: &mut Printbuf, c: Option<&Opaque<c::bch_fs>>, ptr: &c::bch_extent_ptr) {
+    extent_ptr_to_text(out, c.map(Fs::from_c), ptr, &read_lock());
+}
+
+#[cold]
+#[c_export]
+pub fn bch2_bkey_ptrs_to_text(out: &mut Printbuf, c: Option<&Opaque<c::bch_fs>>, k: BkeySC<'_>) {
+    bkey_ptrs_to_text(out, c.map(Fs::from_c), k);
+}
+
+#[c_export]
+pub fn bch2_btree_ptr_validate(c: &Opaque<c::bch_fs>, k: BkeySC<'_>, from: &c::bkey_validate_context)
+    -> c_int
+{
+    ret_to_c(btree_ptr_validate(&BkeyValidate { fs: Fs::from_c(c), k, from }))
+}
+
+#[cold]
+#[c_export]
+pub fn bch2_btree_ptr_to_text(out: &mut Printbuf, c: &Opaque<c::bch_fs>, k: BkeySC<'_>) {
+    bkey_ptrs_to_text(out, Some(Fs::from_c(c)), k);
+}
+
+#[c_export]
+pub fn bch2_btree_ptr_v2_validate(c: &Opaque<c::bch_fs>, k: BkeySC<'_>, from: &c::bkey_validate_context)
+    -> c_int
+{
+    ret_to_c(btree_ptr_v2_validate(&BkeyValidate { fs: Fs::from_c(c), k, from }))
+}
+
+#[cold]
+#[c_export]
+pub fn bch2_btree_ptr_v2_to_text(out: &mut Printbuf, c: &Opaque<c::bch_fs>, k: BkeySC<'_>) {
+    btree_ptr_v2_to_text(out, Fs::from_c(c), k);
+}
+
+#[c_export]
+pub fn bch2_btree_ptr_v2_compat(btree: c::btree_id, version: c_uint, big_endian: c_uint, write: c_int,
+                                k: BkeyS<'_>) {
+    btree_ptr_v2_compat(btree, c::bcachefs_metadata_version(version), big_endian != 0, write != 0, k);
+}
+
+/// bkey_ops' ->swab takes the filesystem const.
+#[c_export]
+pub fn bch2_ptr_swab(c: &Fs, k: BkeyS<'_>) {
+    ptr_swab(c, k);
+}
+
+// ── queries ──────────────────────────────────────────────────────────────
+
+#[c_export]
+pub fn bch2_bkey_has_device_c(c: &Fs, k: BkeySC<'_>, dev: c_uint) -> *const c::bch_extent_ptr {
+    k.arm::<Ptrs>()
+        .and_then(|k| k.has_device(c, dev).map(|p| p as *const _))
+        .unwrap_or(core::ptr::null())
+}
+
+#[c_export]
+pub fn bch2_bkey_devs_rw(c: &Opaque<c::bch_fs>, k: BkeySC<'_>) -> bool {
+    k.arm::<Ptrs>().is_none_or(|k| k.devs_rw(Fs::from_c(c)))
+}
+
+#[c_export]
+pub fn bch2_bkey_has_target(c: &Opaque<c::bch_fs>, k: BkeySC<'_>, target: c_uint) -> bool {
+    k.arm::<Ptrs>().is_some_and(|k| k.has_target(Fs::from_c(c), Target::decode(target)))
+}
+
+#[c_export]
+pub fn bch2_bkey_in_target(c: &Opaque<c::bch_fs>, k: BkeySC<'_>, target: c_uint) -> bool {
+    k.arm::<Ptrs>().is_none_or(|k| k.in_target(Fs::from_c(c), Target::decode(target)))
+}
+
+#[c_export]
+pub fn bch2_bkey_matches_ptr(c: &Opaque<c::bch_fs>, k: BkeySC<'_>, m: c::bch_extent_ptr, offset: u64) -> bool {
+    k.arm::<Ptrs>().is_some_and(|k| k.matches_ptr(Fs::from_c(c), &m, offset))
+}
+
+#[c_export]
+pub fn bch2_extents_match(c: &Fs, k1: BkeySC<'_>, k2: BkeySC<'_>) -> bool {
+    extents_match(c, k1, k2)
+}
+
+// ── reading ──────────────────────────────────────────────────────────────
+
+#[cold]
+#[c_export]
+pub fn bch2_io_failures_to_text(out: &mut Printbuf, c: &Opaque<c::bch_fs>, failed: &c::bch_io_failures) {
+    failed.to_text(out, Fs::from_c(c));
+}
+
+#[c_export]
+pub fn bch2_io_failures_all_dev_removed(failed: &c::bch_io_failures) -> bool {
+    failed.all_dev_removed()
+}
+
+/// Mutable, as C's: a caller may update the record.
+#[c_export]
+pub fn bch2_dev_io_failures(failed: &mut c::bch_io_failures, dev: c_uint) -> *mut c::bch_dev_io_failures {
+    let nr = usize::from(failed.nr);
+    failed.data[..nr].iter_mut().find(|f| u32::from(f.dev) == dev).map_or(core::ptr::null_mut(), |f| f)
+}
+
+#[c_export]
+pub fn bch2_dev_io_failures_mut(failed: &mut c::bch_io_failures, dev: c_uint) -> *mut c::bch_dev_io_failures {
+    failed.dev_mut(dev)
+}
+
+#[c_export]
+pub fn bch2_mark_io_failure(failed: &mut c::bch_io_failures, p: &c::extent_ptr_decoded, err: c_int) {
+    failed.mark(p, BchError::from_raw(-err));
+}
+
+/// 1 and @pick written, 0 for nothing to read, or an error. @failed may be
+/// NULL, and @pick is written, not read.
+#[c_export]
+pub fn bch2_bkey_pick_read_device(c: &Opaque<c::bch_fs>, k: BkeySC<'_>, failed: Option<&c::bch_io_failures>,
+                                  pick: &mut MaybeUninit<c::extent_ptr_decoded>, preferred_dev: c_uint,
+                                  flags: c_uint) -> c_int {
+    match k.pick_read_device(Fs::from_c(c), failed, preferred_dev, c::bch_read_flags::from_bits_retain(flags)) {
+        Ok(Some(p)) => {
+            pick.write(p);
+            1
+        }
+        Ok(None) => 0,
+        Err(e) => -e.raw(),
+    }
+}
+
+// ── editing ──────────────────────────────────────────────────────────────
+
+/// Where @p, a pointer C has into one of @k's entries, is: its EntryPos.
+/// Panics if it isn't in the value, or isn't u64 aligned there.
+fn entry_pos_of(k: BkeySC<'_>, p: *const u8) -> EntryPos {
+    let val = k.val_bytes();
+    let off = (p as usize).wrapping_sub(val.as_ptr() as usize);
+    assert!(off < val.len() && off % size_of::<u64>() == 0,
+            "an entry pointer {off} bytes into a value of {}", val.len());
+    EntryPos(off / size_of::<u64>())
+}
+
+fn ptrs(k: BkeyS<'_>) -> BkeyS<'_, Ptrs> {
+    k.arm::<Ptrs>().expect("dropping pointers of a key without them")
+}
+
+/// @ptr is one of @k's pointers: only its address is used.
+#[c_export]
+pub fn bch2_bkey_drop_ptr_noerror(c: &Fs, k: BkeyS<'_>, ptr: *mut c::bch_extent_ptr) {
+    let at = entry_pos_of(k.as_sc(), ptr.cast());
+    ptrs(k).drop_ptr_noerror(c, at);
+}
+
+/// @ptr is one of @k's pointers: only its address is used.
+#[c_export]
+pub fn bch2_bkey_drop_ptr(c: &Fs, k: BkeyS<'_>, ptr: *mut c::bch_extent_ptr) {
+    let at = entry_pos_of(k.as_sc(), ptr.cast());
+    ptrs(k).drop_ptr(c, at);
+}
+
+/// # Safety
+/// C has an attempt in progress on @trans.
+#[c_export]
+pub unsafe fn bch2_bkey_drop_stale_ptrs(trans: &BtreeTrans<'_>, iter: &BtreeIter<'_>, k: BkeySC<'_>) -> c_int {
+    // SAFETY: the caller's
+    let t = unsafe { trans.attempt_in_progress() };
+    ret_to_c(drop_stale_ptrs(&t, iter, k))
+}
+
+/// @k is in @trans's memory, @buf_u64s long: room for a flags entry, if it
+/// has none, that the caller allocates.
+///
+/// # Safety
+/// C has an attempt in progress on @trans, and @k is a key in its memory,
+/// @buf_u64s u64s of it its.
+#[c_export]
+pub unsafe fn bch2_bkey_extent_flags_set(trans: &BtreeTrans<'_>, k: *mut c::bkey_i, buf_u64s: c_uint,
+                                         flags: u64) -> c_int {
+    // SAFETY: the caller's
+    let t = unsafe { trans.attempt_in_progress() };
+    let fs = t.fs();
+
+    ret_to_c((|| -> Result<(), BchError> {
+        fs.request_incompat_feature(c::bcachefs_metadata_version::extent_flags)?;
+
+        // SAFETY: the caller's
+        let k = unsafe { TransBkey::from_raw_room(&t, k, buf_u64s) };
+        k.arm::<PtrsMut>().expect("extent flags on a key whose entries can't be edited")
+            .extent_flags_set(fs, flags).expect("room for an extent flags entry: its caller allocates it");
+        Ok(())
+    })())
+}
diff --git a/fs/bcachefs/data/ptrs_edit.rs b/fs/bcachefs/data/ptrs_edit.rs
new file mode 100644
index 0000000..8e2fab9
--- /dev/null
+++ b/fs/bcachefs/data/ptrs_edit.rs
@@ -0,0 +1,196 @@
+//! Editing a key's entries in place - a PtrsMut key's, whose entries run to
+//! its value's end: dropping an entry, or a pointer and what was only its, and
+//! inserting one into a TransBkey's room. By EntryPos, the walk's positions,
+//! each good until something before it moves.
+
+use super::*;
+use crate::btree::bkey::BKEY_U64S;
+use crate::btree::iter::{NoRoom, TransBkey};
+
+/// What a PtrsMut key does, in whichever form it's held: dropping only
+/// shrinks it, so any mutable key can; inserting grows it, so that's
+/// TransBkey's.
+pub trait BkeyVPtrsMut: BkeyVMut<V = PtrsMut> {
+    /// Where an entry inserted last goes: the value's end.
+    fn entries_end(&self) -> EntryPos {
+        EntryPos(self.k().val_bytes() / size_of::<u64>())
+    }
+
+    /// Drop the entry at @at, whatever it is, the entries after it moving
+    /// down: bch2_bkey_extent_entry_drop(). Panics if no entry starts at @at,
+    /// or the one that does is where the walk stopped.
+    fn drop_entry(&mut self, fs: &Fs, at: EntryPos) {
+        let len = match self.extent_entries_at(fs).find(|(p, _)| *p == at) {
+            None => panic!("no entry of the key at u64 {} to drop", at.0),
+            Some((_, e @ (ExtentEntry::Invalid { .. } | ExtentEntry::PastEnd { .. }))) =>
+                panic!("dropping the entry at u64 {}, of type {}, that the walk can't step past", at.0, e.ty()),
+            Some((_, e)) => e.bytes().len(),
+        };
+        let start = at.0 * size_of::<u64>();
+        self.val_bytes_mut().copy_within(start + len.., start);
+        self.as_s().k.u64s -= (len / size_of::<u64>()) as u8;
+    }
+
+    /// Drop the pointer at @at and what was only its: the stripe_ptr before
+    /// it, and the crc before it unless a pointer after it, before another
+    /// crc, still has it. bch2_bkey_drop_ptr_noerror(), of a key whose
+    /// pointers can be edited.
+    fn drop_ptr_entries(&mut self, fs: &Fs, at: EntryPos) {
+        assert_eq!(self.extent_entries_at(fs).find(|(p, _)| *p == at).map(|(_, e)| EntryKind::of(e)),
+                   Some(EntryKind::Ptr), "dropping the pointer at u64 {}, where there isn't one", at.0);
+
+        let drop_crc = self.extent_entries_at(fs)
+            .skip_while(|(p, _)| *p <= at)
+            .map(|(_, e)| EntryKind::of(e))
+            .find(|k| matches!(k, EntryKind::Crc | EntryKind::Ptr))
+            != Some(EntryKind::Ptr);
+
+        self.drop_entry(fs, at);
+
+        let mut cur = at;
+        while let Some((p, kind)) = entry_before(&*self, fs, cur) {
+            match kind {
+                EntryKind::Ptr => break,
+                EntryKind::Crc if drop_crc => self.drop_entry(fs, p),
+                EntryKind::Stripe => self.drop_entry(fs, p),
+                _ => {}
+            }
+            cur = p;
+        }
+    }
+
+    /// Drop the stripe_ptr of the first pointer to @dev - the last one
+    /// before it, as C's bch2_bkey_drop_ec() had it.
+    ///
+    /// XXX: C's - the stripe_ptr isn't forgotten at each pointer, so a
+    /// pointer to @dev without its own would drop an earlier pointer's; and
+    /// with none at all, C dereferences NULL, where this panics. Its callers
+    /// pass devices with a stripe; for ec's conversion.
+    fn drop_ec(&mut self, fs: &Fs, dev: u32) {
+        let mut ec = None;
+        let mut found = false;
+        for (p, e) in self.extent_entries_at(fs) {
+            match e {
+                ExtentEntry::stripe_ptr(_) => ec = Some(p),
+                ExtentEntry::ptr(ptr) if u32::from(ptr.dev()) == dev => {
+                    found = true;
+                    break;
+                }
+                _ => {}
+            }
+        }
+        if found {
+            let ec = ec.unwrap_or_else(|| panic!("dropping the stripe_ptr of the pointer to dev {dev}, with none"));
+            self.drop_entry(fs, ec);
+        }
+    }
+}
+
+impl<K: BkeyVMut<V = PtrsMut>> BkeyVPtrsMut for K {}
+
+/// What an entry is, for the editing that drops what belongs to a pointer.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum EntryKind {
+    Ptr,
+    Crc,
+    Stripe,
+    Other,
+}
+
+impl EntryKind {
+    fn of(e: ExtentEntry<'_>) -> Self {
+        match e {
+            ExtentEntry::ptr(_) => Self::Ptr,
+            ExtentEntry::crc32(_) | ExtentEntry::crc64(_) | ExtentEntry::crc128(_) => Self::Crc,
+            ExtentEntry::stripe_ptr(_) => Self::Stripe,
+            _ => Self::Other,
+        }
+    }
+}
+
+/// @k's last entry before @at, and what kind it is: extent_entry_prev().
+fn entry_before<K: BkeyV<V = PtrsMut>>(k: &K, fs: &Fs, at: EntryPos) -> Option<(EntryPos, EntryKind)> {
+    k.extent_entries_at(fs)
+        .take_while(|(p, _)| *p < at)
+        .last()
+        .map(|(p, e)| (p, EntryKind::of(e)))
+}
+
+impl TransBkey<'_, '_, PtrsMut> {
+    /// Insert @entry - an extent entry, as its u64s - at @at, the entries from
+    /// there moving up: __extent_entry_insert(); at entries_end(), appended.
+    /// NoRoom if the key's buffer can't hold it.
+    pub fn insert_entry(&mut self, at: EntryPos, entry: &[u64]) -> Result<(), NoRoom> {
+        let val_u64s = self.entries_end().0;
+        assert!(at.0 <= val_u64s, "inserting at u64 {} of a value of {val_u64s}", at.0);
+
+        self.set_val_u64s(val_u64s + entry.len())?;
+        let val = &mut self.as_mut_u64s()[BKEY_U64S..][..val_u64s + entry.len()];
+        val.copy_within(at.0..val_u64s, at.0 + entry.len());
+        val[at.0..][..entry.len()].copy_from_slice(entry);
+        Ok(())
+    }
+
+    /// Its extent flags made @flags: its flags entry's, which comes first, or
+    /// one inserted first - NoRoom if the buffer can't hold it. The caller
+    /// requests the extent_flags incompat feature. bch2_bkey_extent_flags_set().
+    pub fn extent_flags_set(&mut self, fs: &Fs, flags: u64) -> Result<(), NoRoom> {
+        // the field's 57 bits, as C's bitfield assignment truncates to
+        let flags = flags & ((1 << 57) - 1);
+
+        if let Some(ExtentEntryMut::flags(f)) = self.extent_entries_mut(fs).next() {
+            f.set_flags(flags);
+            return Ok(());
+        }
+
+        let start = EntryPos(PtrsMut::entry_range(self.as_sc()).start / size_of::<u64>());
+        self.insert_entry(start, &[c::bch_extent_flags::new().with_flags(flags).into_bits()])
+    }
+
+    /// @p inserted where its crc applies: its pointer, after its stripe_ptr if
+    /// it has one. With no crc, first, after the extent flags entry if there
+    /// is one; with a crc the key has an entry for, just after that entry;
+    /// else after a new one, at the end. Only the last is an append: the
+    /// others go ahead of pointers already there, renumbering them. NoRoom if
+    /// the buffer can't hold it, and the key's as it was.
+    pub fn insert_decoded_ptr(&mut self, fs: &Fs, p: &c::extent_ptr_decoded) -> Result<(), NoRoom> {
+        let mut entries = ArrayVec::<u64, 5>::new();
+
+        let at = if p.crc == crc_none(self.k()) {
+            let start = EntryPos(PtrsMut::entry_range(self.as_sc()).start / size_of::<u64>());
+            match self.extent_entries(fs).next() {
+                Some(e @ ExtentEntry::flags(_)) => EntryPos(start.0 + e.bytes().len() / size_of::<u64>()),
+                _ => start,
+            }
+        } else if let Some(at) = self.extent_entries_at(fs)
+            .find(|&(_, e)| crc_unpack(self.k(), e) == Some(p.crc))
+            .map(|(at, e)| EntryPos(at.0 + e.bytes().len() / size_of::<u64>()))
+        {
+            at
+        } else {
+            entries.extend(crc_entry(&p.crc));
+            self.entries_end()
+        };
+
+        if p.has_ec {
+            entries.push(p.ec.into_bits());
+        }
+        entries.push(p.ptr.into_bits().0);
+        self.insert_entry(at, &entries)
+    }
+}
+
+/// @crc as the smallest crc entry it packs into, in u64s.
+fn crc_entry(crc: &c::bch_extent_crc_unpacked) -> ArrayVec<u64, 3> {
+    let words = |b: &[u8]| b.chunks(8).map(|w| u64::from_ne_bytes(w.try_into().unwrap())).collect();
+
+    if let Some(e) = c::bch_extent_crc32::pack(crc) {
+        [e.into_bits().0].into_iter().collect()
+    } else if let Some(e) = c::bch_extent_crc64::pack(crc) {
+        words(plain_bytes(&e))
+    } else {
+        let e = c::bch_extent_crc128::pack(crc)
+            .unwrap_or_else(|| panic!("a crc no entry holds: csum type {}", crc.csum_type));
+        words(plain_bytes(&e))
+    }
+}
diff --git a/fs/bcachefs/data/ptrs_mask.rs b/fs/bcachefs/data/ptrs_mask.rs
new file mode 100644
index 0000000..49ed071
--- /dev/null
+++ b/fs/bcachefs/data/ptrs_mask.rs
@@ -0,0 +1,231 @@
+//! Pointer masks: sets of one key's pointers, a bit per pointer by its index
+//! among them - how the data update path names pointers (data_update_opts'
+//! ptrs_kill, ptrs_kill_ec, ptrs_io_error), and what reconcile's plan and the
+//! durability droppers pass around.
+//!
+//! A mask means nothing without its key, so a PtrMask<'id> carries the key's
+//! brand: brand() hands its closure the key as a Branded<'id, K>, 'id fresh
+//! and invariant, and masks are made only from it and used only with it.
+//! remap() takes one to another key, finding the same pointers there.
+//!
+//! An edit that keeps the numbering - a pointer's cached bit, a stripe_ptr, a
+//! cut, a crc - takes &mut Branded and keeps the brand. One that renumbers -
+//! dropping a pointer; set_cached(), which can drop cached pointers and the
+//! pointer itself; inserting one, which lands under its crc - consumes the
+//! Branded or isn't Branded's, so the brand's masks have no key left. A copy
+//! has its key's numbering: adopt() gives it the brand, checked. So every
+//! Branded of a brand has the brand's numbering, each its own key: none is a
+//! view of another's, which a renumbering through it would renumber under the
+//! other.
+//!
+//! Masks stay within their key's pointers - assume() clips - so C's ~m is
+//! except(m). At rest, in data_update_opts, a mask is raw bits relative to a
+//! key nobody edits: bits() erases one, and assume() brands bits with their
+//! key. Those two are where correctness is the caller's.
+
+use super::*;
+use crate::btree::bkey::BkeyFamily;
+use core::marker::PhantomData;
+use core::ops::{BitAnd, BitOr, BitOrAssign};
+
+const _: () = assert!(c::BCH_BKEY_PTRS_MAX <= u16::BITS);
+
+/// An invariant lifetime, standing for one key.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+struct Brand<'id>(PhantomData<fn(&'id ()) -> &'id ()>);
+
+/// A set of the pointers of the key branded 'id.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub struct PtrMask<'id> {
+    bits:  u16,
+    brand: Brand<'id>,
+}
+
+impl<'id> PtrMask<'id> {
+    fn of_bits(bits: u16) -> Self {
+        PtrMask { bits, brand: Brand(PhantomData) }
+    }
+
+    /// Its raw bits, for a mask at rest: relative to this key, which whoever
+    /// takes them back with assume() has to know.
+    pub fn bits(self) -> u16 {
+        self.bits
+    }
+
+    pub fn is_empty(self) -> bool {
+        self.bits == 0
+    }
+
+    pub fn contains(self, i: usize) -> bool {
+        i < 16 && self.bits & (1 << i) != 0
+    }
+
+    /// Its pointers' indices, each with its own one-pointer mask, lowest first.
+    pub fn iter(self) -> impl DoubleEndedIterator<Item = (usize, PtrMask<'id>)> {
+        (0..16).filter(move |&i| self.contains(i)).map(|i| (i, PtrMask::of_bits(1 << i)))
+    }
+}
+
+impl BitOr for PtrMask<'_> {
+    type Output = Self;
+    fn bitor(self, m: Self) -> Self { PtrMask::of_bits(self.bits | m.bits) }
+}
+
+impl BitAnd for PtrMask<'_> {
+    type Output = Self;
+    fn bitand(self, m: Self) -> Self { PtrMask::of_bits(self.bits & m.bits) }
+}
+
+impl BitOrAssign for PtrMask<'_> {
+    fn bitor_assign(&mut self, m: Self) { self.bits |= m.bits }
+}
+
+/// @k, branded 'id - for its closure only.
+pub struct Branded<'id, K> {
+    k:     K,
+    brand: Brand<'id>,
+}
+
+/// @f, with @k branded: its masks can only be used with it, and @f's result
+/// can't keep them.
+pub fn brand<K: BkeyV<V: PtrsBkey>, R>(k: K, f: impl for<'id> FnOnce(Branded<'id, K>) -> R) -> R {
+    f(Branded { k, brand: Brand(PhantomData) })
+}
+
+impl<'id, K: BkeyV<V: PtrsBkey>> Branded<'id, K> {
+    /// The key, to read: masks aren't made from it, so it carries no brand.
+    pub fn key(&self) -> BkeySC<'_, K::V> {
+        self.k.as_sc()
+    }
+
+    pub fn into_inner(self) -> K {
+        self.k
+    }
+
+    pub fn none(&self) -> PtrMask<'id> {
+        PtrMask::of_bits(0)
+    }
+
+    pub fn all(&self, fs: &Fs) -> PtrMask<'id> {
+        let n = self.k.ptrs(fs).count();
+        PtrMask::of_bits(if n >= 16 { u16::MAX } else { (1 << n) - 1 })
+    }
+
+    /// Its pointers @pred says, called on each in order, once.
+    pub fn where_(&self, fs: &Fs, mut pred: impl FnMut(&DecodedPtr<'_>) -> bool) -> PtrMask<'id> {
+        let bits = self.k.ptrs_decoded(fs).take(16).enumerate()
+            .filter(|(_, p)| pred(p))
+            .fold(0, |m, (i, _)| m | 1 << i);
+        PtrMask::of_bits(bits)
+    }
+
+    /// Its pointers not in @m.
+    pub fn except(&self, fs: &Fs, m: PtrMask<'id>) -> PtrMask<'id> {
+        PtrMask::of_bits(self.all(fs).bits & !m.bits)
+    }
+
+    /// @bits, taken against this key - the key at rest they're relative to -
+    /// clipped to its pointers: past the last, a bit names none.
+    pub fn assume(&self, fs: &Fs, bits: u32) -> PtrMask<'id> {
+        PtrMask::of_bits(self.all(fs).bits & bits as u16)
+    }
+
+    /// @m, of this key's pointers, as @new's: for each, the first of @new's
+    /// that ptrs_match() it - the same data, wherever each extent now starts
+    /// - and none if @new hasn't kept it.
+    pub fn remap<'n, N: BkeyV<V: PtrsBkey>>(&self, fs: &Fs, m: PtrMask<'id>, new: &Branded<'n, N>) -> PtrMask<'n> {
+        let (ok, nk) = (self.k.k(), new.k.k());
+        let bits = self.k.ptrs_decoded(fs).take(16).enumerate()
+            .filter(|(i, _)| m.contains(*i))
+            .filter_map(|(_, op)| new.k.ptrs_decoded(fs).take(16).position(|np| ptrs_match(ok, &op.p, nk, &np.p)))
+            .fold(0, |bits, j| bits | 1 << j);
+        PtrMask::of_bits(bits)
+    }
+
+    /// Its first pointer to @dev, if it has one there.
+    pub fn of_dev(&self, fs: &Fs, dev: u32) -> PtrMask<'id> {
+        let bits = self.k.ptrs(fs).take(16).position(|p| u32::from(p.dev()) == dev).map_or(0, |i| 1 << i);
+        PtrMask::of_bits(bits)
+    }
+
+    /// Its pointers on the devices of @other's pointers that @which takes:
+    /// of_dev() of each - which of this key's a write to them would conflict
+    /// with.
+    pub fn on_devs_of(&self, fs: &Fs, other: &impl BkeyVPtrs, mut which: impl FnMut(&c::bch_extent_ptr) -> bool)
+        -> PtrMask<'id>
+    {
+        other.ptrs(fs).filter(|p| which(p)).fold(self.none(), |m, p| m | self.of_dev(fs, p.dev().into()))
+    }
+
+    /// The pointers of @m.
+    pub fn ptrs_in<'a>(&'a self, fs: &'a Fs, m: PtrMask<'id>) -> impl Iterator<Item = &'a c::bch_extent_ptr> + 'a {
+        let bits = m.bits;
+        self.k.ptrs(fs).take(16).enumerate().filter(move |(i, _)| bits & (1 << i) != 0).map(|(_, p)| p)
+    }
+
+    /// @copy, a copy of this key, branded as it is: its pointers are the
+    /// same, so are their indices.
+    pub fn adopt<T: BkeyV<V: PtrsBkey>>(&self, fs: &Fs, copy: T) -> Branded<'id, T> {
+        assert!(self.k.ptrs(fs).map(|p| (p.dev(), p.offset(), p.generation()))
+                .eq(copy.ptrs(fs).map(|p| (p.dev(), p.offset(), p.generation()))),
+                "adopting a copy of {} with other pointers: {}", self.k.to_text(fs), copy.to_text(fs));
+        Branded { k: copy, brand: self.brand }
+    }
+}
+
+/// The edits that keep the numbering.
+impl<'id, K: BkeyVMut<V: PtrsBkey>> Branded<'id, K> {
+    /// Its pointers, to edit in place - not to drop.
+    pub fn ptrs_mut<'a>(&'a mut self, fs: &'a Fs) -> impl Iterator<Item = &'a mut c::bch_extent_ptr> + 'a {
+        self.k.ptrs_mut(fs)
+    }
+
+    /// Its entries, to drop a stripe_ptr from: a key with one has entries
+    /// that can be edited.
+    fn entries_mut(&mut self, fs: &Fs) -> BkeyS<'_, PtrsMut> {
+        assert!(PtrsMut::contains(self.k.k()), "dropping a stripe_ptr of a key whose entries can't be: {}",
+                self.k.to_text(fs));
+        self.k.as_s().arm::<PtrsMut>().unwrap()
+    }
+
+    pub fn drop_ec(&mut self, fs: &Fs, dev: u32) {
+        self.entries_mut(fs).drop_ec(fs, dev);
+    }
+
+    /// drop_ec() for each pointer of @m.
+    pub fn drop_ec_mask(&mut self, fs: &Fs, m: PtrMask<'id>) {
+        let devs: ArrayVec<u32, { c::BCH_BKEY_PTRS_MAX as usize }> =
+            self.ptrs_in(fs, m).map(|p| u32::from(p.dev())).collect();
+
+        for dev in devs {
+            self.drop_ec(fs, dev);
+        }
+    }
+}
+
+/// The edits that renumber: the key comes back unbranded.
+impl<'id, K: BkeyVMut<V: PtrsBkey>> Branded<'id, K> {
+    /// The pointers of @m dropped - the highest first, so the lower are where
+    /// they were.
+    pub fn drop_ptrs_mask(mut self, fs: &Fs, m: PtrMask<'id>) -> K {
+        for (i, _) in m.iter().rev() {
+            let at = self.k.ptrs_decoded(fs).nth(i).map(|p| p.pos)
+                .expect("a mask's pointer, within its key's");
+            self.k.drop_ptr_noerror(fs, at);
+        }
+        self.k
+    }
+
+    /// set_cached() each pointer of @m, the highest first. The mask is read as
+    /// devices before any is made cached - set_cached() can drop cached
+    /// pointers anywhere in the key, moving the ones after them.
+    pub fn set_ptrs_cached_mask(mut self, fs: &Fs, opts: &c::bch_inode_opts, m: PtrMask<'id>) -> K {
+        let devs: ArrayVec<u32, { c::BCH_BKEY_PTRS_MAX as usize }> =
+            self.ptrs_in(fs, m).map(|p| u32::from(p.dev())).collect();
+
+        for dev in devs.into_iter().rev() {
+            self.k.set_cached(fs, opts, dev);
+        }
+        self.k
+    }
+}
diff --git a/fs/bcachefs/data/ptrs_ops.rs b/fs/bcachefs/data/ptrs_ops.rs
new file mode 100644
index 0000000..cdff15e
--- /dev/null
+++ b/fs/bcachefs/data/ptrs_ops.rs
@@ -0,0 +1,402 @@
+//! The bkey methods of the key types with pointers, over ptrs.rs's walk:
+//! validate, to_text and swab - each reading entries validate may not have
+//! seen, or rejected - and btree_ptr(_v2)'s own on top of them.
+
+use super::*;
+use crate::{bkey_fsck_err, bkey_fsck_err_on};
+use crate::btree::bkey::{bkey_eq, bpos_ge, POS_MIN};
+use crate::data::durability::BkeyVDurability;
+use crate::data::reconcile::trigger::{extent_rebalance_v1_to_text, extent_reconcile_to_text,
+                                      extent_reconcile_validate};
+use crate::init::error::{id, BkeyValidate};
+use crate::util::rcu::ReadGuard;
+use crate::util::{Printbuf, ToText};
+
+// ── validate ─────────────────────────────────────────────────────────────
+
+/// A pointer, against the rest of the key and its device: extent_ptr_validate().
+/// One to a device that isn't there passes - check_fix_ptrs() repairs it.
+fn extent_ptr_validate(v: &BkeyValidate<'_, '_>, p: BkeySC<'_, Ptrs>, ptr: &c::bch_extent_ptr,
+                       size_ondisk: u32) -> Result<(), BchError> {
+    if u32::from(ptr.dev()) == c::BCH_SB_MEMBER_INVALID {
+        return Ok(());
+    }
+
+    for ptr2 in p.ptrs(v.fs) {
+        bkey_fsck_err_on!(v, !core::ptr::eq(ptr, ptr2) && ptr.dev() == ptr2.dev(),
+                          id::ptr_to_duplicate_device,
+                          "multiple pointers to same device ({})", ptr.dev())?;
+    }
+
+    let dev = {
+        let rcu = read_lock();
+        v.fs.dev_rcu(ptr.dev().into(), &rcu).map(|ca| {
+            let (bucket, bucket_offset) = ca.sector_to_bucket_and_offset(ptr.offset());
+            (bucket, bucket_offset, ca.mi.get().first_bucket, ca.mi.get().nbuckets, ca.mi.get().bucket_size)
+        })
+    };
+    let Some((bucket, bucket_offset, first_bucket, nbuckets, bucket_size)) = dev else {
+        return Ok(());
+    };
+
+    bkey_fsck_err_on!(v, bucket >= nbuckets, id::ptr_after_last_bucket,
+                      "pointer past last bucket ({} > {})", bucket, nbuckets)?;
+    bkey_fsck_err_on!(v, bucket < u64::from(first_bucket), id::ptr_before_first_bucket,
+                      "pointer before first bucket ({} < {})", bucket, first_bucket)?;
+    // u32, wrapping, as C's unsigned arithmetic
+    bkey_fsck_err_on!(v, bucket_offset.wrapping_add(size_ondisk) > u32::from(bucket_size),
+                      id::ptr_spans_multiple_buckets,
+                      "pointer spans multiple buckets ({} + {} > {})", bucket_offset, size_ondisk, bucket_size)
+}
+
+/// The entry types a btree node pointer may have.
+fn btree_ptr_entry_type_allowed(ty: u32) -> bool {
+    use c::bch_extent_entry_type as t;
+    [t::BCH_EXTENT_ENTRY_ptr, t::BCH_EXTENT_ENTRY_reconcile, t::BCH_EXTENT_ENTRY_reconcile_bp]
+        .iter().any(|a| a.0 == ty)
+}
+
+/// Each entry against the ones before it, then all of them together:
+/// bch2_bkey_ptrs_validate().
+pub fn bkey_ptrs_validate(v: &BkeyValidate<'_, '_>) -> Result<(), BchError> {
+    use c::bch_bkey_type as kt;
+
+    let (fs, k) = (v.fs, v.k);
+    let p = k.arm::<Ptrs>().expect("a key with pointers");
+    let is_btree_ptr = matches!(k.k.key_type(), kt::KEY_TYPE_btree_ptr | kt::KEY_TYPE_btree_ptr_v2);
+    let range = Ptrs::entry_range(p);
+    let entries_start = k.val_bytes().as_ptr() as usize + range.start;
+    let entries_u64s = range.len() / 8;
+
+    // btree_sectors(): a node's on-disk size, where a pointer has no crc
+    let mut size_ondisk = if is_btree_ptr { fs.opts().btree_node_size >> 9 } else { k.k.size };
+    let mut nonce = None;
+    let mut nr_ptrs = 0u32;
+    let (mut have_written, mut have_unwritten, mut have_ec, mut crc_since_last_ptr) =
+        (false, false, false, false);
+    let (mut have_non_inval_dev_ptrs, mut have_non_inval_dev_ptrs_dirty) = (false, false);
+
+    for (i, e) in p.extent_entries(fs).enumerate() {
+        let ty = e.ty();
+
+        bkey_fsck_err_on!(v, matches!(e, ExtentEntry::Invalid { .. }), id::extent_ptrs_invalid_entry,
+                          "invalid extent entry type (got {}, max {})", ty, fs.sb.extent_types_known.get())?;
+
+        if let ExtentEntry::PastEnd { bytes, .. } = e {
+            return Err(bkey_fsck_err!(v, id::extent_ptrs_entry_past_end,
+                "extent entry at u64 {} runs past the end of the value, {} u64s",
+                (bytes.as_ptr() as usize - entries_start) / 8, entries_u64s));
+        }
+
+        bkey_fsck_err_on!(v, is_btree_ptr && ty < c::BCH_EXTENT_ENTRY_MAX && !btree_ptr_entry_type_allowed(ty),
+                          id::btree_ptr_has_non_ptr, "has non allowed field")?;
+
+        match e {
+            ExtentEntry::ptr(ptr) => {
+                extent_ptr_validate(v, p, ptr, size_ondisk)?;
+
+                bkey_fsck_err_on!(v, ptr.cached() != 0 && have_ec, id::ptr_cached_and_erasure_coded,
+                                  "cached, erasure coded ptr")?;
+
+                let real_dev = u32::from(ptr.dev()) != c::BCH_SB_MEMBER_INVALID;
+                if real_dev {
+                    if ptr.unwritten() == 0 {
+                        have_written = true;
+                    } else {
+                        have_unwritten = true;
+                    }
+                }
+
+                if real_dev || have_ec {
+                    if ptr.cached() == 0 {
+                        have_non_inval_dev_ptrs_dirty = true;
+                    }
+                    have_non_inval_dev_ptrs = true;
+                }
+
+                have_ec = false;
+                crc_since_last_ptr = false;
+                nr_ptrs += 1;
+            }
+            ExtentEntry::crc32(_) | ExtentEntry::crc64(_) | ExtentEntry::crc128(_) => {
+                let crc = crc_unpack(k.k, e).expect("a crc");
+                let csum_type = c::bch_csum_type(crc.csum_type.into());
+
+                bkey_fsck_err_on!(v, !csum_type.valid(fs), id::ptr_crc_csum_type_unknown,
+                                  "invalid checksum type")?;
+                bkey_fsck_err_on!(v, u32::from(crc.compression_type) >=
+                                     c::bch_compression_type::BCH_COMPRESSION_TYPE_NR.0,
+                                  id::ptr_crc_compression_type_unknown, "invalid compression type")?;
+
+                bkey_fsck_err_on!(v, u32::from(crc.offset).wrapping_add(crc.live_size) > crc.uncompressed_size,
+                                  id::ptr_crc_uncompressed_size_too_small,
+                                  "checksum offset + key size > uncompressed size")?;
+                bkey_fsck_err_on!(v, crc_is_encoded(&crc) &&
+                                     crc.uncompressed_size > fs.opts().encoded_extent_max >> 9 &&
+                                     v.from.flags().intersects(c::bch_validate_flags::BCH_VALIDATE_write |
+                                                               c::bch_validate_flags::BCH_VALIDATE_commit),
+                                  id::ptr_crc_uncompressed_size_too_big, "too large encoded extent")?;
+                bkey_fsck_err_on!(v, !crc_is_compressed(&crc) && crc.compressed_size != crc.uncompressed_size,
+                                  id::ptr_crc_uncompressed_size_mismatch,
+                                  "not compressed but compressed != uncompressed size")?;
+
+                // an encrypted extent's crcs all point to one nonce, offset in
+                if csum_type.is_encryption() {
+                    let n = u32::from(crc.offset) + u32::from(crc.nonce);
+                    match nonce {
+                        None => nonce = Some(n),
+                        Some(first) if first != n =>
+                            return Err(bkey_fsck_err!(v, id::ptr_crc_nonce_mismatch, "incorrect nonce")),
+                        Some(_) => {}
+                    }
+                }
+
+                bkey_fsck_err_on!(v, crc_since_last_ptr, id::ptr_crc_redundant, "redundant crc entry")?;
+                crc_since_last_ptr = true;
+
+                size_ondisk = crc.compressed_size;
+            }
+            ExtentEntry::stripe_ptr(_) => {
+                bkey_fsck_err_on!(v, have_ec, id::ptr_stripe_redundant, "redundant stripe entry")?;
+                have_ec = true;
+            }
+            ExtentEntry::reconcile(r) => extent_reconcile_validate(v, r)?,
+            ExtentEntry::flags(_) =>
+                bkey_fsck_err_on!(v, i != 0, id::extent_flags_not_at_start,
+                                  "extent flags entry not at start")?,
+            _ => {}
+        }
+    }
+
+    bkey_fsck_err_on!(v, nr_ptrs == 0, id::extent_ptrs_no_ptrs, "no ptrs")?;
+    bkey_fsck_err_on!(v, nr_ptrs > c::BCH_BKEY_PTRS_MAX, id::extent_ptrs_too_many_ptrs,
+                      "too many ptrs: {} > {}", nr_ptrs, c::BCH_BKEY_PTRS_MAX)?;
+    bkey_fsck_err_on!(v, have_written && have_unwritten, id::extent_ptrs_written_and_unwritten,
+                      "extent with unwritten and written ptrs")?;
+    bkey_fsck_err_on!(v, k.k.key_type() != kt::KEY_TYPE_extent && have_unwritten,
+                      id::extent_ptrs_unwritten, "has unwritten ptrs")?;
+    bkey_fsck_err_on!(v, crc_since_last_ptr, id::extent_ptrs_redundant_crc, "redundant crc entry")?;
+    bkey_fsck_err_on!(v, have_ec, id::extent_ptrs_redundant_stripe, "redundant stripe entry")?;
+
+    // A dead btree node keeps its pointer - not KEY_TYPE_error - for
+    // bch_btree_ptr_v2's other fields
+    if !is_btree_ptr {
+        bkey_fsck_err_on!(v, !have_non_inval_dev_ptrs, id::extent_ptrs_all_invalid,
+                          "extent without valid pointers")?;
+        bkey_fsck_err_on!(v, v.from.from() == c::bkey_validate_from::BKEY_VALIDATE_commit &&
+                             !have_non_inval_dev_ptrs_dirty,
+                          id::extent_ptrs_all_invalid, "extent without valid dirty pointers")?;
+    }
+    Ok(())
+}
+
+// ── to_text ──────────────────────────────────────────────────────────────
+
+/// A pointer: its device, bucket and offset, if the device is there, and how
+/// stale it is once bucket gens are valid - on a new filesystem, or after
+/// alloc_read; before, the table is zeroes.
+pub(crate) fn extent_ptr_to_text(out: &mut Printbuf, fs: Option<&Fs>, ptr: &c::bch_extent_ptr,
+                                 rcu: &ReadGuard) {
+    match fs.and_then(|fs| Some((fs, fs.dev_rcu(ptr.dev().into(), rcu)?))) {
+        None => write!(out, "{}:{} gen {}", ptr.dev(), ptr.offset(), ptr.generation()),
+        Some((fs, ca)) => {
+            let (b, offset) = ca.sector_to_bucket_and_offset(ptr.offset());
+            write!(out, "{:>6} {}:{}:{} gen {}", ca.name().to_str().unwrap_or("(invalid name)"),
+                   ptr.dev(), b, offset, ptr.generation());
+            if ca.mi.get().durability != 1 {
+                write!(out, " d={}", ca.mi.get().durability);
+            }
+
+            let gens_valid = fs.flag(c::bch_fs_flags::BCH_FS_new_fs) ||
+                fs.recovery.runner.passes_complete.get() & (1 << c::bch_recovery_pass::BCH_RECOVERY_PASS_alloc_read as u32) != 0;
+            // dev_ptr_stale_rcu()'s -1 for a bucket the device doesn't have
+            let stale = if gens_valid { ca.ptr_stale(ptr, rcu).map_or(-1, i32::from) } else { 0 };
+            if stale != 0 {
+                write!(out, " stale={stale}");
+            }
+        }
+    }
+
+    if ptr.cached() != 0 {
+        write!(out, " cached");
+    }
+    if ptr.unwritten() != 0 {
+        write!(out, " unwritten");
+    }
+}
+
+/// A checksum's word as C prints it: its bytes as a u64 of this machine's.
+fn csum_word_raw(w: Le64) -> u64 {
+    u64::from_ne_bytes(w.get().to_le_bytes())
+}
+
+fn crc_unpacked_to_text(out: &mut Printbuf, crc: &c::bch_extent_crc_unpacked) {
+    write!(out, "c_size {} size {} offset {} nonce {} csum {} {:x}:{:x}  compress ",
+           crc.compressed_size, crc.uncompressed_size, crc.offset, crc.nonce,
+           c::bch_csum_type(crc.csum_type.into()),
+           csum_word_raw(crc.csum.hi), csum_word_raw(crc.csum.lo));
+    c::bch_compression_type(crc.compression_type.into()).to_text(out);
+}
+
+/// A key with pointers' entries, a line each: bch2_bkey_ptrs_to_text(). It
+/// prints keys validate rejected - that's what it's for - so an entry past
+/// the end of the value is reported, not read, and one of a type this code
+/// doesn't know ends it.
+pub fn bkey_ptrs_to_text(out: &mut Printbuf, fs: Option<&Fs>, k: BkeySC<'_>) {
+    let Some(fs) = fs else {
+        write!(out, "no filesystem object available");
+        return;
+    };
+    let p = k.arm::<Ptrs>().expect("a key with pointers");
+    let entries_start = k.val_bytes().as_ptr() as usize + Ptrs::entry_range(p).start;
+
+    let past_end = p.extent_entries(fs).find_map(|e| match e {
+        ExtentEntry::PastEnd { bytes, .. } => Some((bytes.as_ptr() as usize - entries_start) / 8),
+        _ => None,
+    });
+
+    if past_end.is_none() {
+        write!(out, "durability: {} ", k.durability_safe(fs).total);
+    }
+
+    let mut out = out.atomic();
+    let rcu = read_lock();
+
+    for e in p.extent_entries(fs) {
+        if let ExtentEntry::PastEnd { .. } = e {
+            break;
+        }
+
+        out.newline();
+        if let Some(name) = extent_entry_type_name(e.ty()) {
+            write!(out, "{name}: ");
+        }
+
+        match e {
+            ExtentEntry::ptr(ptr) => extent_ptr_to_text(&mut out, Some(fs), ptr, &rcu),
+            ExtentEntry::crc32(_) | ExtentEntry::crc64(_) | ExtentEntry::crc128(_) =>
+                crc_unpacked_to_text(&mut out, &crc_unpack(k.k, e).expect("a crc")),
+            ExtentEntry::stripe_ptr(ec) => write!(out, "idx {} block {}", ec.idx(), ec.block()),
+            ExtentEntry::rebalance_v1(r) => extent_rebalance_v1_to_text(&mut out, Some(fs), r),
+            ExtentEntry::reconcile(r) => extent_reconcile_to_text(&mut out, Some(fs), r),
+            ExtentEntry::flags(f) => crate::util::names::prt_set::<c::bch_extent_flags_e>(&mut out, f.flags()),
+            ExtentEntry::reconcile_bp(r) => write!(out, "idx {}", r.idx()),
+            ExtentEntry::Unknown { bytes, .. } | ExtentEntry::Invalid { bytes, .. } |
+            ExtentEntry::PastEnd { bytes, .. } => {
+                let w = bytes.get(..8).map_or(0, |w| u64::from_ne_bytes(w.try_into().unwrap()));
+                write!(out, "(unknown extent entry {w:016x})");
+                return;
+            }
+        }
+    }
+
+    if let Some(at) = past_end {
+        out.newline();
+        write!(out, "(extent entry at u64 {at} runs past the end of the value)");
+    }
+}
+
+// ── btree node pointers ──────────────────────────────────────────────────
+
+pub(super) fn btree_ptr_validate(v: &BkeyValidate<'_, '_>) -> Result<(), BchError> {
+    let val_u64s = v.k.val_bytes().len() / 8;
+
+    bkey_fsck_err_on!(v, val_u64s > c::BCH_REPLICAS_MAX as usize, id::btree_ptr_val_too_big,
+                      "value too big ({} > {})", val_u64s, c::BCH_REPLICAS_MAX)?;
+
+    bkey_ptrs_validate(v)
+}
+
+pub(super) fn btree_ptr_v2_validate(v: &BkeyValidate<'_, '_>) -> Result<(), BchError> {
+    let bp = v.k.arm::<c::BtreePtrV2>().expect("a btree_ptr_v2");
+    let val_u64s = v.k.val_bytes().len() / 8;
+
+    bkey_fsck_err_on!(v, val_u64s > c::BKEY_BTREE_PTR_VAL_U64s_MAX, id::btree_ptr_v2_val_too_big,
+                      "value too big ({} > {})", val_u64s, c::BKEY_BTREE_PTR_VAL_U64s_MAX)?;
+
+    bkey_fsck_err_on!(v, bpos_ge(bp.v().min_key, bp.k.p), id::btree_ptr_v2_min_key_bad,
+                      "min_key > key")?;
+
+    if v.from.flags().contains(c::bch_validate_flags::BCH_VALIDATE_write) &&
+       u32::from(v.fs.sb.version_min.get()) >= c::bcachefs_metadata_version::btree_ptr_sectors_written.0 {
+        bkey_fsck_err_on!(v, bp.v().sectors_written.get() == 0, id::btree_ptr_v2_written_0,
+                          "sectors_written == 0")?;
+    }
+
+    bkey_ptrs_validate(v)
+}
+
+/// A btree_ptr_v2: its node's seq, how much of it is written and its
+/// min_key, then its pointers.
+pub fn btree_ptr_v2_to_text(out: &mut Printbuf, fs: &Fs, k: BkeySC<'_>) {
+    let bp = k.arm::<c::BtreePtrV2>().expect("a btree_ptr_v2").v();
+
+    crate::prt!(out, "\nseq {:x} written {} min_key {}{} ",
+                bp.seq.get(), bp.sectors_written.get(),
+                if bp.btree_ptr_range_updated() { "R " } else { "" },
+                { bp.min_key });
+    bkey_ptrs_to_text(out, Some(fs), k);
+}
+
+/// The node's min_key, to or from how @version on a @big_endian machine wrote
+/// it: compat_bpos(), and the extents btree min_key shift - whose POS_MIN test
+/// is bkey_eq(), where compat_btree_node()'s is bpos_eq(). It runs before
+/// validate: a value too short for min_key is left to it, where C writes past.
+///
+/// XXX: as ptr_swab() - this should take an Unvalidated key.
+pub fn btree_ptr_v2_compat(btree: c::btree_id, version: c::bcachefs_metadata_version, big_endian: bool,
+                           write: bool, k: BkeyS<'_>) {
+    let Some(mut bp) = k.arm::<c::BtreePtrV2>() else { return };
+    let Some(v) = <c::BtreePtrV2 as ArmRef>::arm_mut(bp.val_bytes_mut()) else { return };
+
+    let mut min_key = v.min_key;
+    min_key.compat(btree, version, big_endian);
+
+    if version < c::bcachefs_metadata_version::inode_btree_change &&
+       btree.is_extents() &&
+       !bkey_eq(min_key, POS_MIN) {
+        min_key = if write { min_key.nosnap_predecessor() } else { min_key.nosnap_successor() };
+    }
+    v.min_key = min_key;
+}
+
+// ── byte swapping ────────────────────────────────────────────────────────
+
+/// The entries of a key written on a machine of the other endianness, made
+/// this one's - its own inverse: bch2_ptr_swab(), every BKEY_TYPE_ptrs
+/// type's ->swab. Every word swapped, then the checksums fixed up: a crc's
+/// checksum is bytes, not a word, and a crc32's and crc64's high part are
+/// fields of their first word.
+///
+/// This runs before validate. An entry past the end of the value - the walk's
+/// last - is left for validate to report.
+///
+/// XXX: this should take an Unvalidated key, once Rust has them.
+pub fn ptr_swab(fs: &Fs, k: BkeyS<'_>) {
+    let sizes = EntrySizes::of(fs);
+    let mut k = k.arm::<Ptrs>().expect("a key with pointers");
+    let range = Ptrs::entry_range(k.as_sc());
+
+    if let Some(b) = k.val_bytes_mut().get_mut(range) {
+        entries_swab(sizes, b);
+    }
+}
+
+pub(super) fn entries_swab(sizes: EntrySizes, b: &mut [u8]) {
+    b.chunks_exact_mut(8).for_each(<[u8]>::reverse);
+
+    for e in (EntriesMut { sizes, b }).map(|(ty, b, stop)| ExtentEntryMut::new(ty, b, stop)) {
+        match e {
+            ExtentEntryMut::crc32(e) => e.update_csum(|c| c.swap_bytes()),
+            ExtentEntryMut::crc64(e) => {
+                e.update_csum_hi(|c| c.swap_bytes());
+                e.csum_lo = { e.csum_lo }.swap_bytes();
+            }
+            ExtentEntryMut::crc128(e) => {
+                e.csum.hi = Le64::new(e.csum.hi.get().swap_bytes());
+                e.csum.lo = Le64::new(e.csum.lo.get().swap_bytes());
+            }
+            _ => {}
+        }
+    }
+}
diff --git a/fs/bcachefs/data/ptrs_read.rs b/fs/bcachefs/data/ptrs_read.rs
new file mode 100644
index 0000000..8710d17
--- /dev/null
+++ b/fs/bcachefs/data/ptrs_read.rs
@@ -0,0 +1,298 @@
+//! Reading a key's data: which of its pointers to read - pick_read_device() -
+//! and the record of what failed, a device at a time, that the read paths
+//! retry against: bch_io_failures, which the write paths keep too.
+//!
+//! A pick prefers what hasn't failed, then a checksummed copy, then - with
+//! BCH_READ_soft_require_read_device - the asked-for device, then, at
+//! random, the faster device: squared latencies, so the slower is still read
+//! now and then and its latency stays known. An erasure coded pointer whose
+//! device failed, or is offline, is read by reconstructing it from its
+//! stripe.
+
+use super::*;
+use crate::debug::params as debug_params;
+use crate::errcode::bch_errcode;
+use crate::util::Printbuf;
+use crate::util::kernel::READ;
+
+#[cfg(CONFIG_BCACHEFS_DEBUG)]
+crate::module_param! {
+    /// If >= 0, the device reads prefer after failures and checksums.
+    pub(crate) static force_read_device: i32 = -1;
+    perm = 0o644, desc = "";
+}
+
+// ── io failures ──────────────────────────────────────────────────────────
+
+impl c::bch_io_failures {
+    /// @dev's record, if it has one: bch2_dev_io_failures().
+    pub fn dev(&self, dev: u32) -> Option<&c::bch_dev_io_failures> {
+        self.data[..self.nr.into()].iter().find(|f| u32::from(f.dev) == dev)
+    }
+
+    /// @dev's record, a new one if it has none: bch2_dev_io_failures_mut().
+    /// Panics if there's no room for one - one per replica, and one more.
+    pub fn dev_mut(&mut self, dev: u32) -> &mut c::bch_dev_io_failures {
+        let nr = usize::from(self.nr);
+        if let Some(i) = self.data[..nr].iter().position(|f| u32::from(f.dev) == dev) {
+            return &mut self.data[i];
+        }
+
+        assert!(nr < self.data.len(), "io failures of {} devices, recording dev {dev}", nr + 1);
+        self.nr += 1;
+        self.data[nr] = c::bch_dev_io_failures { dev: dev as u8, ..Default::default() };
+        &mut self.data[nr]
+    }
+
+    /// Record @err, reading @p: a failed reconstruct, a checksum error - those
+    /// counted, retried until checksum_err_retry_nr - or an io error.
+    /// bch2_mark_io_failure().
+    pub fn mark(&mut self, p: &c::extent_ptr_decoded, err: BchError) {
+        assert!(err.raw() != 0, "marking an io failure that isn't one");
+        assert!(!err.matches(bch_errcode::BCH_ERR_transaction_restart),
+                "marking a transaction restart as an io failure");
+
+        let f = self.dev_mut(p.ptr.dev().into());
+        let code = -(err.raw() as i16);
+
+        if p.do_ec_reconstruct {
+            f.ec_errcode = code;
+        } else if err.raw() == bch_errcode::BCH_ERR_data_read_retry_csum_err.0 as i32 {
+            // its 7 bits, wrapping as C's bitfield does
+            f.bits.update_csum_nr(|n| n.wrapping_add(1) & 0x7f);
+        } else {
+            f.errcode = code;
+        }
+    }
+
+    /// Whether every failure is a device that's been removed - which said so
+    /// once, when it was: bch2_io_failures_all_dev_removed(). Only for an
+    /// operation that succeeded; a record with no error at all isn't one.
+    pub fn all_dev_removed(&self) -> bool {
+        self.data[..self.nr.into()].iter().all(|f| {
+            f.bits.csum_nr() == 0 && f.ec_errcode == 0 &&
+                BchError::from_raw(-i32::from(f.errcode)).matches(bch_errcode::BCH_ERR_BLK_STS_REMOVED)
+        })
+    }
+
+    /// A line per device - its name, and its errors - then the reconstruct's
+    /// message: bch2_io_failures_to_text().
+    pub fn to_text(&self, out: &mut Printbuf, fs: &Fs) {
+        {
+            let mut out = out.indent(2);
+
+            for f in &self.data[..self.nr.into()] {
+                out.make_room_gfp(1024, c::GFP_KERNEL);
+                {
+                    let mut out = out.atomic();
+                    let rcu = read_lock();
+                    match fs.dev_rcu(f.dev.into(), &rcu) {
+                        Some(ca) => write!(out, "{ca}"),
+                        None => write!(out, "(invalid device {})", f.dev),
+                    }
+                }
+
+                let err_str = |code: i16| BchError::from_raw(-i32::from(code)).msg();
+                if f.bits.csum_nr() == 0 && f.ec_errcode == 0 && f.errcode == 0 {
+                    write!(out, " no error - confused");
+                }
+                if f.bits.csum_nr() != 0 {
+                    write!(out, " checksum ({})", f.bits.csum_nr());
+                }
+                if f.errcode != 0 {
+                    write!(out, " io: {}", err_str(f.errcode));
+                }
+                if f.ec_errcode != 0 {
+                    write!(out, " ec reconstruct: {}", err_str(f.ec_errcode));
+                }
+                out.newline();
+            }
+        }
+
+        if self.ec_msg.pos != 0 {
+            write!(out, "ec reconstruct:\n");
+            let mut out = out.indent(2);
+            out.write_bytes(self.ec_msg_bytes());
+        }
+    }
+
+    fn ec_msg_bytes(&self) -> &[u8] {
+        // SAFETY: a printbuf's first pos bytes, its own
+        unsafe { core::slice::from_raw_parts(self.ec_msg.buf as *const u8, self.ec_msg.pos as usize) }
+    }
+}
+
+// ── picking a pointer ────────────────────────────────────────────────────
+
+/// What a read from @ca costs: its read latency, or the most for no device -
+/// dev_latency().
+fn dev_latency(ca: Option<&c::bch_dev>) -> u64 {
+    ca.map_or(i64::MAX as u64, |ca| ca.cur_latency(READ) as u64)
+}
+
+/// Whether @p1 is a better read than @p2, of latencies @l1 and @l2:
+/// ptr_better(). The last choice is random.
+fn ptr_better(fs: &Fs, p1: &c::extent_ptr_decoded, mut l1: u64, p2: &c::extent_ptr_decoded, mut l2: u64,
+              preferred_dev: u32, flags: c::bch_read_flags) -> bool {
+    if debug_params::force_reconstruct_read() {
+        return p1.do_ec_reconstruct > p2.do_ec_reconstruct;
+    }
+    if p1.do_ec_reconstruct || p2.do_ec_reconstruct {
+        return p1.do_ec_reconstruct < p2.do_ec_reconstruct;
+    }
+
+    if p1.crc_retry_nr != p2.crc_retry_nr {
+        return p1.crc_retry_nr < p2.crc_retry_nr;
+    }
+
+    #[cfg(CONFIG_BCACHEFS_DEBUG)]
+    {
+        let force = force_read_device.get();
+        if force >= 0 {
+            let (f1, f2) = (i32::from(p1.ptr.dev()) == force, i32::from(p2.ptr.dev()) == force);
+            if f1 != f2 {
+                return f1;
+            }
+        }
+    }
+
+    // prefer extents with checksums
+    let (c1, c2) = (p1.crc.csum_type != 0, p2.crc.csum_type != 0);
+    if c1 != c2 {
+        return c1;
+    }
+
+    if flags.contains(c::bch_read_flags::BCH_READ_soft_require_read_device) {
+        if u32::from(p1.ptr.dev()) == preferred_dev {
+            if fs.dev_rotational(p2.ptr.dev().into()) {
+                return true;
+            }
+            l1 /= 256;
+        }
+        if u32::from(p2.ptr.dev()) == preferred_dev {
+            if fs.dev_rotational(p1.ptr.dev().into()) {
+                return false;
+            }
+            l2 /= 256;
+        }
+    }
+
+    // at random, biased toward the faster device - C's: a sum of zero is 0
+    // SAFETY: plain
+    unsafe { c::bch2_get_random_u64_below(l1.wrapping_add(l2)) > l1 }
+}
+
+/// Which replica of a key to read, in whichever form it's held, of any type.
+pub trait BkeyVRead: BkeyV<V: BkeyVal<State = Validated>> {
+    /// Which of its pointers to read - preferring @preferred_dev, and with
+    /// BCH_READ_hard_require_read_device only it - against @failed, what
+    /// failed reading it so far: bch2_bkey_pick_read_device(). None if there's
+    /// nothing to read: it's unwritten, or has no pointers but cached ones, or
+    /// none. An error is why nothing could be picked.
+    fn pick_read_device(&self, fs: &Fs, failed: Option<&c::bch_io_failures>, preferred_dev: u32,
+                        flags: c::bch_read_flags) -> Result<Option<c::extent_ptr_decoded>, BchError> {
+        use c::bch_errcode as e;
+        let key = self.as_sc();
+
+        if key.k.key_type() == c::bch_bkey_type::KEY_TYPE_error {
+            return fs.throw(e::BCH_ERR_key_type_error);
+        }
+
+        let (mut have_csum_errors, mut have_io_errors, mut have_missing_devs) = (false, false, false);
+        let mut have_dirty_ptrs = false;
+        let mut pick: Option<(c::extent_ptr_decoded, u64)> = None;
+
+        if let Some(k) = key.arm::<Ptrs>() {
+            let mut rcu = read_lock();
+
+            for d in k.ptrs_decoded(fs) {
+                let mut p = d.p;
+                have_dirty_ptrs |= p.ptr.cached() == 0;
+
+                // an unwritten extent reads as a hole, of zeroes
+                if p.ptr.unwritten() != 0 {
+                    return Ok(None);
+                }
+
+                let dev = u32::from(p.ptr.dev());
+                if flags.contains(c::bch_read_flags::BCH_READ_hard_require_read_device) && dev != preferred_dev {
+                    continue;
+                }
+
+                // reported outside the read-side section; still not there
+                let missing = fs.dev_rcu(dev, &rcu).is_none() && dev != c::BCH_SB_MEMBER_INVALID;
+                if missing {
+                    drop(rcu);
+                    fs.dev_missing_bkey(key.untyped(), dev)?;
+                    rcu = read_lock();
+                }
+                let ca = if missing { None } else { fs.dev_rcu(dev, &rcu) };
+
+                if p.ptr.cached() != 0 && ca.is_none_or(|ca| ca.ptr_stale(&p.ptr, &rcu) != Some(0)) {
+                    continue;
+                }
+
+                if let Some(f) = failed.and_then(|f| f.dev(dev)) {
+                    let csum_nr = f.bits.csum_nr();
+                    p.crc_retry_nr = csum_nr;
+                    p.has_ec &= f.ec_errcode == 0;
+
+                    if ca.is_some() {
+                        have_io_errors |= f.errcode != 0 || f.ec_errcode != 0;
+                    }
+                    have_csum_errors |= csum_nr != 0;
+
+                    if p.has_ec && (f.errcode != 0 || csum_nr != 0) {
+                        p.do_ec_reconstruct = true;
+                    } else if f.errcode != 0 || csum_nr > fs.opts().checksum_err_retry_nr {
+                        continue;
+                    }
+                }
+
+                have_missing_devs |= ca.is_some_and(|ca| !ca.is_online());
+
+                if ca.is_none_or(|ca| !ca.is_online()) {
+                    if !p.has_ec {
+                        continue;
+                    }
+                    p.do_ec_reconstruct = true;
+                }
+
+                if debug_params::force_reconstruct_read() && p.has_ec {
+                    p.do_ec_reconstruct = true;
+                }
+
+                // squared, to favour the faster device more - but not so much
+                // the slower is never read, and its latency never updated
+                let l = dev_latency(ca);
+                let l = l.wrapping_mul(l);
+
+                if pick.as_ref().is_none_or(|(pp, pl)| ptr_better(fs, &p, l, pp, *pl, preferred_dev, flags)) {
+                    pick = Some((p, l));
+                }
+            }
+        }
+
+        if let Some((p, _)) = pick {
+            return Ok(Some(p));
+        }
+
+        use c::bch_bkey_type as t;
+        if !have_dirty_ptrs && !matches!(key.k.key_type(), t::KEY_TYPE_btree_ptr | t::KEY_TYPE_btree_ptr_v2) {
+            return Ok(None);
+        }
+        if have_missing_devs || !have_dirty_ptrs {
+            return fs.throw(e::BCH_ERR_no_device_to_read_from);
+        }
+        if have_csum_errors {
+            return fs.throw(e::BCH_ERR_data_read_csum_err);
+        }
+        if have_io_errors {
+            return fs.throw(e::BCH_ERR_data_read_io_err);
+        }
+        // pointers - validate makes sure of that - none to a device that's valid
+        fs.throw(e::BCH_ERR_no_devices_valid)
+    }
+}
+
+impl<K: BkeyV<V: BkeyVal<State = Validated>>> BkeyVRead for K {}
diff --git a/fs/bcachefs/data/read.c b/fs/bcachefs/data/read.c
new file mode 100644
index 0000000..b0bfd12
--- /dev/null
+++ b/fs/bcachefs/data/read.c
@@ -0,0 +1,1641 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright 2010, 2011 Kent Overstreet <kent.overstreet@gmail.com>
+ * Copyright 2012 Google, Inc.
+ */
+
+/* DOC(data-read-path)
+ *
+ * Reads are transparent and self-healing: if a checksum failure or IO error
+ * occurs on one replica, bcachefs automatically retries from another replica.
+ * The failed device's error counter is incremented and the bad copy is
+ * rewritten from the good one. If all replicas fail, the error is propagated
+ * to the application.
+ *
+ * With multiple devices, reads go to the lowest-latency replica. This is
+ * tracked per-device and adapts over time, so mixed SSD/HDD configurations
+ * automatically prefer the SSD for reads without explicit configuration.
+ *
+ * End-to-end flow: extent lookup, device selection, disk read, checksum
+ * verification, decryption, decompression. For compressed or checksummed
+ * extents the full extent must be read even for partial requests, because
+ * checksums and compression operate on the whole extent.
+ */
+
+#include "bcachefs.h"
+
+#include "alloc/background.h"
+#include "alloc/buckets.h"
+#include "alloc/disk_groups.h"
+#include "alloc/foreground.h"
+
+#include "btree/update.h"
+
+#include "data/checksum.h"
+#include "data/compress.h"
+#include "data/ec/io.h"
+#include "data/io_misc.h"
+#include "data/promote_gen.h"
+#include "data/read.h"
+#include "data/reconcile/trigger.h"
+#include "data/reflink.h"
+#include "data/update.h"
+#include "data/write.h"
+
+#include "debug/async_objs.h"
+
+#include "init/damage.h"
+#include "init/error.h"
+
+#include "sb/counters.h"
+
+#include "snapshots/subvolume.h"
+
+#include "util/clock.h"
+#include "util/enumerated_ref.h"
+
+#include <linux/moduleparam.h>
+#include <linux/random.h>
+#include <linux/sched/mm.h>
+#include <linux/version.h>
+
+static unsigned __maybe_unused bch2_read_corrupt_ratio;
+static int __maybe_unused bch2_read_corrupt_device;
+
+#ifdef CONFIG_BCACHEFS_DEBUG
+module_param_named(read_corrupt_ratio, bch2_read_corrupt_ratio, uint, 0644);
+MODULE_PARM_DESC(read_corrupt_ratio, "");
+
+module_param_named(read_corrupt_device, bch2_read_corrupt_device, int, 0644);
+MODULE_PARM_DESC(read_corrupt_device, "");
+#endif
+
+static bool bch2_poison_extents_on_checksum_error = true;
+module_param_named(poison_extents_on_checksum_error,
+		   bch2_poison_extents_on_checksum_error, bool, 0644);
+MODULE_PARM_DESC(poison_extents_on_checksum_error,
+		 "Extents with checksum errors are marked as poisoned - unsafe without read fua support");
+
+static void bch2_read_bio_to_text_atomic(struct printbuf *, struct bch_read_bio *);
+
+/* Read */
+
+static inline bool have_io_error(struct bch_io_failures *failed)
+{
+	return failed && failed->nr;
+}
+
+static inline struct data_update *rbio_data_update(struct bch_read_bio *rbio)
+{
+	EBUG_ON(rbio->split);
+
+	return rbio->data_update
+		? container_of(rbio, struct data_update, rbio)
+		: NULL;
+}
+
+void bch2_read_err_msg_trans(struct btree_trans *trans, struct printbuf *out,
+			     struct bch_read_bio *rbio, struct bpos read_pos)
+{
+	prt_str(out, "data read error at ");
+	bch2_inum_offset_err_msg_trans(trans, out, rbio->subvol, read_pos);
+
+	if (rbio->data_update)
+		prt_str(out, " (internal move) ");
+	prt_str(out, ": ");
+}
+
+enum rbio_context {
+	RBIO_CONTEXT_NULL,
+	RBIO_CONTEXT_HIGHPRI,
+	RBIO_CONTEXT_UNBOUND,
+};
+
+static inline struct bch_read_bio *
+bch2_rbio_parent(struct bch_read_bio *rbio)
+{
+	return rbio->split ? rbio->parent : rbio;
+}
+
+__always_inline
+static void bch2_rbio_punt(struct bch_read_bio *rbio, work_func_t fn,
+			   enum rbio_context context,
+			   struct workqueue_struct *wq)
+{
+	if (context <= rbio->context) {
+		fn(&rbio->work);
+	} else {
+		rbio->work.func		= fn;
+		rbio->context		= context;
+		queue_work(wq, &rbio->work);
+	}
+}
+
+static inline struct bch_read_bio *bch2_rbio_free(struct bch_read_bio *rbio)
+{
+	BUG_ON(rbio->bounce && !rbio->split);
+
+	if (rbio->ca)
+		enumerated_ref_put(&rbio->ca->io_ref[READ], BCH_DEV_READ_REF_io_read);
+
+	if (rbio->split) {
+		struct bch_read_bio *parent = rbio->parent;
+
+		if (unlikely(rbio->promote)) {
+			bch2_promote_read_done(rbio);
+		} else {
+			async_object_list_del(rbio->c, rbio, rbio->list_idx);
+
+			if (rbio->bounce)
+				bch2_bio_free_pages_pool(rbio->c, &rbio->bio);
+
+			bio_put(&rbio->bio);
+		}
+
+		rbio = parent;
+	}
+
+	return rbio;
+}
+
+/*
+ * Only called on a top level bch_read_bio to complete an entire read request,
+ * not a split:
+ */
+static void bch2_rbio_done(struct bch_read_bio *rbio)
+{
+	if (rbio->start_time)
+		bch2_time_stats_update(&rbio->c->times[BCH_TIME_data_read],
+				       rbio->start_time);
+#ifdef CONFIG_BCACHEFS_ASYNC_OBJECT_LISTS
+	if (rbio->list_idx)
+		async_object_list_del(rbio->c, rbio, rbio->list_idx);
+#endif
+	bio_endio(&rbio->bio);
+}
+
+static int get_rbio_extent(struct btree_trans *trans, struct bch_read_bio *rbio, struct bkey_buf *sk)
+{
+	CLASS(btree_iter, iter)(trans, rbio->data_btree, rbio->data_pos, 0);
+	struct bkey_s_c k;
+
+	try(lockrestart_do(trans, bkey_err(k = bch2_btree_iter_peek_slot(&iter))));
+
+	struct bch_fs *c = trans->c;
+	struct bkey_ptrs_c ptrs = bch2_bkey_ptrs_c(k);
+	bkey_for_each_ptr(ptrs, ptr)
+		if (bch2_extent_ptr_eq(*ptr, rbio->pick.ptr)) {
+			bch2_bkey_buf_reassemble(sk, k);
+			break;
+		}
+
+	return 0;
+}
+
+static noinline int maybe_poison_extent(struct btree_trans *trans, struct bch_read_bio *rbio,
+					enum btree_id btree, struct bkey_s_c read_k)
+{
+	if (!bch2_poison_extents_on_checksum_error)
+		return 0;
+
+	struct bch_fs *c = trans->c;
+
+	/* Can't commit during recovery — will be handled after going rw */
+	if (!test_bit(BCH_FS_rw, &c->flags))
+		return 0;
+	struct data_update *u = rbio_data_update(rbio);
+	if (u)
+		read_k = bkey_i_to_s_c(u->k.k);
+
+	u64 flags = bch2_bkey_extent_flags(read_k);
+	if (flags & BIT_ULL(BCH_EXTENT_FLAG_poisoned))
+		return 0;
+
+	CLASS(btree_iter, iter)(trans, btree, bkey_start_pos(read_k.k), BTREE_ITER_intent);
+	struct bkey_s_c k = bkey_try(bch2_btree_iter_peek_slot(&iter));
+
+	if (!bkey_and_val_eq(k, read_k))
+		return 0;
+
+	/* room for a flags entry, if it has none */
+	unsigned u64s = k.k->u64s + sizeof(struct bch_extent_flags) / sizeof(u64);
+	struct bkey_i *new = errptr_try(bch2_trans_kmalloc(trans, u64s * sizeof(u64)));
+
+	bkey_reassemble(new, k);
+	try(bch2_bkey_extent_flags_set(trans, new, u64s, flags|BIT_ULL(BCH_EXTENT_FLAG_poisoned)));
+	try(bch2_trans_update(trans, &iter, new, BTREE_UPDATE_internal_snapshot_node));
+
+	CLASS(disk_reservation, res)(c);
+	try(bch2_trans_commit(trans, &res.r, NULL, 0));
+
+	/*
+	 * Propagate key change back to data update path, in particular so it
+	 * knows the extent has been poisoned and it's safe to change the
+	 * checksum
+	 */
+	if (u)
+		bch2_bkey_buf_copy(&u->k, new);
+
+	event_inc_trace(c, data_read_fail_and_poison, buf, ({
+		bch2_bkey_val_to_text(&buf, c, k);
+		prt_newline(&buf);
+		bch2_read_bio_to_text_atomic(&buf, rbio);
+	}));
+	return 0;
+}
+
+static inline bool data_read_err_should_retry(int err)
+{
+	return  bch2_err_matches(err, BCH_ERR_transaction_restart) ||
+		bch2_err_matches(err, BCH_ERR_data_read_retry) ||
+		bch2_err_matches(err, BCH_ERR_blockdev_io_error);
+}
+
+static noinline int bch2_read_retry_nodecode(struct btree_trans *trans,
+					struct bch_read_bio *rbio,
+					struct bvec_iter bvec_iter,
+					struct bch_io_failures *failed,
+					enum bch_read_flags flags)
+{
+	struct data_update *u = container_of(rbio, struct data_update, rbio);
+	int ret = 0;
+
+	do {
+		bch2_trans_begin(trans);
+
+		CLASS(btree_iter, iter)(trans, u->btree_id, bkey_start_pos(&u->k.k->k), 0);
+		struct bkey_s_c k;
+
+		try(lockrestart_do(trans, bkey_err(k = bch2_btree_iter_peek_slot(&iter))));
+
+		if (!bkey_and_val_eq(k, bkey_i_to_s_c(u->k.k))) {
+			/* extent we wanted to read no longer exists: */
+			ret = bch_err_throw(trans->c, data_read_key_overwritten);
+			break;
+		}
+
+		ret = __bch2_read_extent(trans, rbio, bvec_iter,
+					 bkey_start_pos(&u->k.k->k),
+					 u->btree_id,
+					 bkey_i_to_s_c(u->k.k),
+					 0, failed, flags, -1);
+	} while (data_read_err_should_retry(ret));
+
+	if (ret)
+		rbio->ret = ret;
+
+	return ret;
+}
+
+static void propagate_io_error_to_data_update(struct bch_fs *c,
+					      struct bch_read_bio *rbio,
+					      struct extent_ptr_decoded *pick)
+{
+	struct data_update *u = rbio_data_update(bch2_rbio_parent(rbio));
+
+	if (u && !pick->do_ec_reconstruct) {
+		struct bkey_ptrs_c ptrs = bch2_bkey_ptrs_c(bkey_i_to_s_c(u->k.k));
+		unsigned ptr_bit = 1;
+		bkey_for_each_ptr(ptrs, ptr) {
+			if (pick->ptr.dev == ptr->dev)
+				u->opts.ptrs_io_error |= ptr_bit;
+			ptr_bit <<= 1;
+		}
+	}
+}
+
+static u32 bch2_io_failures_to_err_mask(struct bch_io_failures *failed)
+{
+	u32 errors = 0;
+	for (unsigned i = 0; i < failed->nr; i++) {
+		struct bch_dev_io_failures *f = &failed->data[i];
+
+		if (f->csum_nr)
+			errors |= BCH_READ_ERR_checksum;
+		if (f->ec_errcode)
+			errors |= BCH_READ_ERR_ec_reconstruct;
+		if (bch2_err_matches(f->errcode, BCH_ERR_decompress))
+			errors |= BCH_READ_ERR_decompression;
+		else if (f->errcode)
+			errors |= BCH_READ_ERR_io;
+	}
+	return errors;
+}
+
+static int rbio_mark_io_failure(struct bch_read_bio *rbio,
+				struct extent_ptr_decoded *pick,
+				struct bch_io_failures *failed,
+				int ret)
+{
+	if (bch2_err_matches(ret, BCH_ERR_data_read_retry_avoid) ||
+	    bch2_err_matches(ret, BCH_ERR_blockdev_io_error)) {
+		bch2_mark_io_failure(failed, pick, ret);
+		propagate_io_error_to_data_update(rbio->c, rbio, pick);
+
+	}
+
+	if (ret == -BCH_ERR_BLK_STS_INVAL) {
+		prt_printf(&failed->ec_msg, "Failing bio, after block layer completion:\n");
+		guard(printbuf_indent)(&failed->ec_msg);
+		bch2_bio_to_text(&failed->ec_msg, &rbio->bio);
+	}
+
+	return ret;
+}
+
+/*
+ * data_read_csum_err is the terminal error - thrown by
+ * bch2_bkey_pick_read_device() once every replica has been tried and the
+ * failures were checksum errors. It is a sibling of the data_read_retry_*
+ * codes, not a descendant, so it has to be matched on its own: a read that
+ * recovered reports the retry code and one that didn't reports this, and
+ * missing it labels every unrecoverable checksum error an IO error.
+ */
+static bool data_read_err_is_csum(int ret)
+{
+	return bch2_err_matches(ret, BCH_ERR_data_read_csum_err) ||
+	       bch2_err_matches(ret, BCH_ERR_data_read_retry_csum_err) ||
+	       bch2_err_matches(ret, BCH_ERR_data_read_retry_csum_err_maybe_userspace);
+}
+
+/*
+ * The sb error id naming a failed read, for damage records: a file whose
+ * extents won't decompress is a different repair problem from one with bad
+ * checksums, and which compression type failed is the first thing we'd ask.
+ * @ret must be a failure - a recovered read is a different event.
+ */
+enum bch_sb_error_id bch2_data_read_sb_err(int ret)
+{
+	return bch2_err_matches(ret, BCH_ERR_decompress)
+		? bch2_decompress_sb_err(ret)
+		: data_read_err_is_csum(ret)
+		? BCH_FSCK_ERR_data_read_csum_err
+		: BCH_FSCK_ERR_data_read_io_err;
+}
+
+static void bch2_rbio_retry(struct work_struct *work)
+{
+	struct bch_read_bio *rbio =
+		container_of(work, struct bch_read_bio, work);
+	struct bch_fs *c	= rbio->c;
+	struct bvec_iter iter	= rbio->bvec_iter;
+	enum bch_read_flags flags = rbio->flags;
+	subvol_inum inum = {
+		.subvol = rbio->subvol,
+		.inum	= rbio->read_pos.inode,
+	};
+	struct bpos read_pos = rbio->read_pos;
+	int orig_ret = rbio->ret;
+	CLASS(bch_io_failures, failed)();
+
+	flags &= ~BCH_READ_hard_require_read_device;
+
+	event_inc_trace(c, data_read_retry, buf,
+			bch2_read_bio_to_text_atomic(&buf, rbio));
+
+	{
+		CLASS(btree_trans, trans)(c);
+
+		struct bkey_buf sk __cleanup(bch2_bkey_buf_exit);
+		bch2_bkey_buf_init(&sk);
+		get_rbio_extent(trans, rbio, &sk);
+
+		if (!bkey_deleted(&sk.k->k))
+			rbio_mark_io_failure(rbio, &rbio->pick, &failed, rbio->ret);
+
+		if (!rbio->split) {
+			rbio->bio.bi_status	= 0;
+			rbio->ret		= 0;
+			/*
+			 * Not restored if we got here without going through
+			 * bch2_read_endio() (the EC reconstruct punt): the
+			 * retry's completion would run a second endio pass on
+			 * data it already decrypted.
+			 */
+			rbio->bio.bi_end_io	= rbio->end_io;
+		}
+
+		rbio = bch2_rbio_free(rbio);
+
+		flags |= BCH_READ_in_retry;
+		flags &= ~BCH_READ_may_promote;
+		flags &= ~BCH_READ_last_fragment;
+		flags |= BCH_READ_must_clone;
+
+		int ret = rbio->data_update
+			? bch2_read_retry_nodecode(trans, rbio, iter, &failed, flags)
+			: bch2_read(trans, rbio, iter, inum, &failed, &sk, flags);
+
+		if (ret)
+			rbio->ret = ret;
+
+		if (rbio->data_update &&
+		    (bch2_err_matches(ret, BCH_ERR_data_read_key_overwritten) ||
+		     bch2_err_matches(ret, BCH_ERR_data_read_ptr_stale_race)))
+			ret = 0;
+
+		if (failed.nr || failed.ec_msg.pos || ret) {
+			struct printbuf *out;
+			CLASS(bch_log_msg, msg)(c);
+
+			if (rbio->err_report) {
+				mutex_lock(&rbio->err_report->lock);
+				out = &rbio->err_report->msg;
+				rbio->err_report->errors |= bch2_io_failures_to_err_mask(&failed);
+			} else {
+				out = &msg.m;
+				msg.m.suppress = !ret
+					? bch2_ratelimit(c)
+					: bch2_ratelimit(c);
+			}
+
+			bch2_read_err_msg_trans(trans, out, rbio, read_pos);
+			prt_newline(out);
+
+			if (!bkey_deleted(&sk.k->k)) {
+				bch2_bkey_val_to_text(out, c, bkey_i_to_s_c(sk.k));
+				prt_newline(out);
+			}
+
+			bch2_io_failures_to_text(out, c, &failed);
+
+			if (!ret) {
+				prt_str(out, "successful retry");
+				if (rbio->self_healing)
+					prt_str(out, ", self healing");
+			} else
+				prt_printf(out, "error %s", bch2_err_str(ret));
+
+			if (rbio->err_report)
+				mutex_unlock(&rbio->err_report->lock);
+		}
+
+		/*
+		 * The persistent record: count what happened - recovered via
+		 * retry vs. hard failure, io error vs. checksum error - and
+		 * record damage against the file. Best effort: a bookkeeping
+		 * failure doesn't fail the read. Only user reads name an inum
+		 * (a data update read may be an indirect extent):
+		 */
+		if (failed.nr || ret) {
+			enum bch_sb_error_id e = !ret
+				? (data_read_err_is_csum(orig_ret)
+				   ? BCH_FSCK_ERR_data_read_csum_err_recovered
+				   : BCH_FSCK_ERR_data_read_io_err_recovered)
+				: (data_read_err_is_csum(ret)
+				   ? BCH_FSCK_ERR_data_read_csum_err
+				   : BCH_FSCK_ERR_data_read_io_err);
+
+			bch2_sb_error_count(c, e);
+
+			/*
+			 * Also count what the device said, per failure: the
+			 * outcome counters above say a read failed, these say
+			 * why - media errors, timeouts and rejected requests
+			 * are entirely different problems.
+			 *
+			 * Only for failures that came back from the block
+			 * layer: errcode also holds our own verdicts (device
+			 * offline, stale pointer, decompress error), and those
+			 * aren't block statuses to be counted as unknown ones.
+			 * Decompression failures are counted where they happen,
+			 * in bch2_bio_uncompress().
+			 */
+			darray_for_each(failed, f) {
+				if (bch2_err_matches(f->errcode, BCH_ERR_blockdev_io_error))
+					bch2_sb_error_count(c, bch2_blk_sts_sb_err(f->errcode));
+				if (bch2_err_matches(f->ec_errcode, BCH_ERR_blockdev_io_error))
+					bch2_sb_error_count(c, bch2_blk_sts_sb_err(f->ec_errcode));
+			}
+
+			/*
+			 * A read that recovered has nothing to name beyond the
+			 * outcome; one that failed names why it failed.
+			 */
+			enum bch_sb_error_id damage = ret
+				? bch2_data_read_sb_err(ret)
+				: e;
+
+			if (!rbio->data_update && inum.subvol && !bkey_deleted(&sk.k->k))
+				commit_do(trans, NULL, NULL, BCH_TRANS_COMMIT_no_enospc,
+					  bch2_damage_record(trans, read_pos, damage));
+		}
+
+		/* drop trans before calling rbio_done() */
+	}
+
+	bch2_rbio_done(rbio);
+}
+
+static int bch2_rbio_error(struct bch_read_bio *rbio, int ret)
+{
+	BUG_ON(ret >= 0);
+
+	rbio->ret = ret;
+	bch2_rbio_parent(rbio)->saw_error = true;
+
+	if (!(rbio->flags & BCH_READ_in_retry)) {
+		if (data_read_err_should_retry(ret)) {
+			bch2_rbio_punt(rbio, bch2_rbio_retry, RBIO_CONTEXT_UNBOUND, system_dfl_wq);
+		} else {
+			rbio = bch2_rbio_free(rbio);
+			rbio->ret = ret;
+			bch2_rbio_done(rbio);
+		}
+	} else {
+		rbio_mark_io_failure(rbio, &rbio->pick, rbio->failed, ret);
+	}
+	return ret;
+}
+
+static int __bch2_rbio_narrow_crcs(struct btree_trans *trans,
+				   struct bch_read_bio *rbio,
+				   struct bch_extent_crc_unpacked *new_crc)
+{
+	struct bch_fs *c = rbio->c;
+	u64 data_offset = rbio->data_pos.offset - rbio->pick.crc.offset;
+
+	CLASS(btree_iter, iter)(trans, rbio->data_btree, rbio->data_pos, BTREE_ITER_intent);
+	struct bkey_s_c k = bkey_try(bch2_btree_iter_peek_slot(&iter));
+
+	if (bversion_cmp(k.k->bversion, rbio->version) ||
+	    !bch2_bkey_matches_ptr(c, k, rbio->pick.ptr, data_offset))
+		return bch_err_throw(c, rbio_narrow_crcs_fail);
+
+	/* Extent was trimmed/merged? */
+	if (!bpos_eq(bkey_start_pos(k.k), rbio->data_pos) ||
+	    k.k->p.offset != rbio->data_pos.offset + rbio->pick.crc.live_size)
+		return bch_err_throw(c, rbio_narrow_crcs_fail);
+
+	/*
+	 * going to be temporarily appending another checksum entry:
+	 */
+	struct bkey_i *new =
+		errptr_try(bch2_trans_kmalloc(trans, bkey_bytes(k.k) + sizeof(struct bch_extent_crc128)));
+
+	bkey_reassemble(new, k);
+
+	if (!bch2_bkey_narrow_crc(c, new, rbio->pick.crc, *new_crc))
+		return bch_err_throw(c, rbio_narrow_crcs_fail);
+
+	return bch2_trans_update(trans, &iter, new, BTREE_UPDATE_internal_snapshot_node);
+}
+
+static noinline void bch2_rbio_narrow_crcs(struct bch_read_bio *rbio)
+{
+	struct bch_fs *c = rbio->c;
+
+	if (!rbio->pick.crc.csum_type ||
+	    crc_is_compressed(rbio->pick.crc))
+		return;
+
+	u64 data_offset = rbio->data_pos.offset - rbio->pick.crc.offset;
+
+	struct bch_extent_crc_unpacked new_crc;
+	if (bch2_rechecksum_bio(c, &rbio->bio, rbio->version,
+			rbio->pick.crc, NULL, &new_crc,
+			rbio->data_pos.offset - data_offset, rbio->pick.crc.live_size,
+			rbio->pick.crc.csum_type)) {
+		bch_err(c, "error verifying existing checksum while narrowing checksum (memory corruption?)");
+		return;
+	}
+
+	/* Can't commit during recovery */
+	if (!test_bit(BCH_FS_rw, &c->flags))
+		return;
+
+	CLASS(btree_trans, trans)(c);
+	CLASS(disk_reservation, res)(c);
+	int ret = commit_do(trans, &res.r, NULL, BCH_TRANS_COMMIT_no_enospc,
+			    __bch2_rbio_narrow_crcs(trans, rbio, &new_crc));
+	if (!ret)
+		event_inc_trace(c, data_read_narrow_crcs, buf,
+				bch2_read_bio_to_text_atomic(&buf, rbio));
+	else
+		event_inc_trace(c, data_read_narrow_crcs_fail, buf, ({
+			prt_printf(&buf, "%s\n", bch2_err_str(ret));
+			bch2_read_bio_to_text_atomic(&buf, rbio);
+		}));
+}
+
+static int bch2_rbio_decrypt(struct bch_fs *c, struct bch_read_bio *rbio,
+			     struct bch_extent_crc_unpacked crc, struct nonce nonce)
+{
+	return bch2_encrypt_bio(c, crc.csum_type, nonce, &rbio->bio)
+		? bch_err_throw(c, data_read_decrypt_err)
+		: 0;
+}
+
+/* Inner part that may run in process context */
+static int __bch2_read_endio_work(struct bch_read_bio *rbio)
+{
+	struct bch_fs *c	= rbio->c;
+	struct bch_dev *ca = rbio->ca;
+	struct bch_read_bio *parent	= bch2_rbio_parent(rbio);
+	struct bio *src			= &rbio->bio;
+	struct bio *dst			= &parent->bio;
+	struct bvec_iter dst_iter	= rbio->bvec_iter;
+	struct bch_extent_crc_unpacked crc = rbio->pick.crc;
+	struct nonce nonce = extent_nonce(rbio->version, crc);
+	struct bch_csum csum;
+	int ret;
+
+	guard(memalloc_flags)(PF_MEMALLOC_NOIO);
+
+	if (bch2_read_corrupt_device == rbio->pick.ptr.dev ||
+	    bch2_read_corrupt_device < 0)
+		bch2_maybe_corrupt_bio(src, bch2_read_corrupt_ratio);
+
+	csum = bch2_checksum_bio(c, crc.csum_type, nonce, src);
+	bool csum_good = !bch2_crc_cmp(csum, rbio->pick.crc.csum) || c->opts.no_data_io;
+
+	/*
+	 * Checksum error: if the bio wasn't bounced, we may have been
+	 * reading into buffers owned by userspace (that userspace can
+	 * scribble over) - retry the read, bouncing it this time:
+	 */
+	if (!csum_good && !rbio->bounce && (rbio->flags & BCH_READ_user_mapped)) {
+		rbio->flags |= BCH_READ_must_bounce;
+		return bch_err_throw(c, data_read_retry_csum_err_maybe_userspace);
+	}
+
+	bch2_account_io_completion(ca, BCH_MEMBER_ERROR_checksum, 0, csum_good);
+
+	/*
+	 * XXX
+	 * We need to rework the narrow_crcs path to deliver the read completion
+	 * first, and then punt to a different workqueue, otherwise we're
+	 * holding up reads while doing btree updates which is bad for memory
+	 * reclaim.
+	 */
+	if (unlikely(rbio->narrow_crcs) && csum_good)
+		bch2_rbio_narrow_crcs(rbio);
+
+	if (likely(!parent->data_update)) {
+		/* Adjust crc to point to subset of data we want: */
+		crc.offset     += rbio->offset_into_extent;
+		crc.live_size	= bvec_iter_sectors(rbio->bvec_iter);
+
+		if (crc_is_compressed(crc)) {
+			BUG_ON(!rbio->bounce);
+
+			try(bch2_rbio_decrypt(c, rbio, crc, nonce));
+
+			/*
+			 * On a checksum error we still try to decompress - a
+			 * bitflip often decompresses fine, and we return what
+			 * we have. But the checksum error is the one that
+			 * describes what happened, so don't report a
+			 * decompression failure over it: fall through to the
+			 * !csum_good check below.
+			 */
+			ret = bch2_bio_uncompress(c, src, dst, dst_iter, crc);
+			if (ret && !c->opts.no_data_io && csum_good)
+				return ret;
+		} else {
+			/* don't need to decrypt the entire bio: */
+			nonce = nonce_add(nonce, crc.offset << 9);
+			bio_advance(src, crc.offset << 9);
+
+			BUG_ON(src->bi_iter.bi_size < dst_iter.bi_size);
+			src->bi_iter.bi_size = dst_iter.bi_size;
+
+			try(bch2_rbio_decrypt(c, rbio, crc, nonce));
+
+			if (rbio->bounce) {
+				struct bvec_iter src_iter = src->bi_iter;
+
+				bch2_bio_copy_data_iter(dst, &dst_iter, src, &src_iter);
+			}
+		}
+	} else {
+		if (parent->data_update_verify_decompress &&
+		    crc_is_compressed(crc)) {
+			BUG_ON(!rbio->bounce);
+
+			try(bch2_rbio_decrypt(c, rbio, crc, nonce));
+
+			/*
+			 * dst_iter doesn't make sense here, it refers to the
+			 * size of the compressed extent on disk (what the data
+			 * update path generally wants), and here we're just
+			 * verifying thath the data decompresses and throwing
+			 * away the result:
+			 */
+			ret = bch2_bio_uncompress(c, src, dst, (struct bvec_iter) {}, crc);
+			if (ret && !c->opts.no_data_io && csum_good)
+				return ret;
+
+			/* We decrypted to decompress; re-encrypt: */
+			try(bch2_rbio_decrypt(c, rbio, crc, nonce));
+		}
+
+		if (rbio->split)
+			rbio->parent->pick = rbio->pick;
+
+		if (rbio->bounce) {
+			struct bvec_iter src_iter = src->bi_iter;
+
+			bch2_bio_copy_data_iter(dst, &dst_iter, src, &src_iter);
+		}
+	}
+
+	if (!csum_good)
+		return bch_err_throw(c, data_read_retry_csum_err);
+
+	if (rbio->promote) {
+		/*
+		 * Re encrypt data we decrypted, so it's consistent with
+		 * rbio->crc:
+		 */
+		try(bch2_rbio_decrypt(c, rbio, crc, nonce));
+	}
+
+	if (likely(!(rbio->flags & BCH_READ_in_retry))) {
+		rbio = bch2_rbio_free(rbio);
+		bch2_rbio_done(rbio);
+	}
+
+	return 0;
+}
+
+static void bch2_read_endio_work(struct work_struct *work)
+{
+	struct bch_read_bio *rbio =
+		container_of(work, struct bch_read_bio, work);
+	int ret = __bch2_read_endio_work(rbio);
+	if (ret)
+		bch2_rbio_error(rbio, ret);
+}
+
+noinline __cold
+static void data_read_reuse_race_trace(struct bch_read_bio *rbio)
+{
+	__event_trace(rbio->c, data_read_reuse_race, buf, ({
+		guard(printbuf_atomic)(&buf);
+		bch2_read_bio_to_text_atomic(&buf, rbio);
+	}));
+}
+
+static void bch2_read_endio(struct bio *bio)
+{
+	struct bch_read_bio *rbio =
+		container_of(bio, struct bch_read_bio, bio);
+	struct bch_fs *c	= rbio->c;
+	struct bch_dev *ca = rbio->ca;
+	struct workqueue_struct *wq = NULL;
+	enum rbio_context context = RBIO_CONTEXT_NULL;
+
+	bch2_account_io_completion(ca, BCH_MEMBER_ERROR_read,
+				   rbio->submit_time, !bio->bi_status);
+
+	if (!rbio->split)
+		rbio->bio.bi_end_io = rbio->end_io;
+
+	/* Reset iterator for checksumming and copying bounced data: */
+	if (rbio->bounce) {
+		rbio->bio.bi_iter.bi_size	= rbio->pick.crc.compressed_size << 9;
+		rbio->bio.bi_iter.bi_idx	= 0;
+#if !defined(__KERNEL__) || LINUX_VERSION_CODE < KERNEL_VERSION(7, 3, 0)
+		rbio->bio.bi_iter.bi_bvec_done	= 0;
+#else
+		rbio->bio.bi_iter.bi_offset	= 0;
+#endif
+	} else {
+		rbio->bio.bi_iter		= rbio->bvec_iter;
+	}
+
+	if (unlikely(bio->bi_status)) {
+		bch2_rbio_error(rbio, __bch2_err_throw(c, -blk_status_to_bch_err(bio->bi_status)));
+		return;
+	}
+
+	if (((rbio->flags & BCH_READ_retry_if_stale) && race_fault()) ||
+	    (ca && dev_ptr_stale(ca, &rbio->pick.ptr))) {
+		event_inc_trace_fn(c, data_read_reuse_race, data_read_reuse_race_trace(rbio));
+
+		if (rbio->flags & BCH_READ_retry_if_stale)
+			bch2_rbio_error(rbio, bch_err_throw(c, data_read_ptr_stale_retry));
+		else
+			bch2_rbio_error(rbio, bch_err_throw(c, data_read_ptr_stale_race));
+		return;
+	}
+
+	if (rbio->narrow_crcs ||
+	    rbio->promote ||
+	    crc_is_compressed(rbio->pick.crc) ||
+	    bch2_csum_type_is_encryption(rbio->pick.crc.csum_type))
+		context = RBIO_CONTEXT_UNBOUND,	wq = system_dfl_wq;
+	else if (rbio->pick.crc.csum_type)
+		context = RBIO_CONTEXT_HIGHPRI,	wq = system_highpri_wq;
+
+	bch2_rbio_punt(rbio, bch2_read_endio_work, context, wq);
+}
+
+static noinline void read_from_stale_dirty_pointer(struct btree_trans *trans,
+						   struct bch_dev *ca,
+						   struct bkey_s_c k,
+						   struct bch_extent_ptr ptr)
+{
+	struct bch_fs *c = trans->c;
+	CLASS(printbuf, buf)();
+	CLASS(btree_iter, iter)(trans, BTREE_ID_alloc,
+				PTR_BUCKET_POS(ca, &ptr),
+				BTREE_ITER_cached);
+
+	int gen = bucket_gen_get(ca, iter.pos.offset);
+	if (gen >= 0) {
+		prt_printf(&buf, "Attempting to read from stale dirty pointer:\n");
+		printbuf_indent_add(&buf, 2);
+
+		bch2_bkey_val_to_text(&buf, c, k);
+		prt_newline(&buf);
+
+		prt_printf(&buf, "memory gen: %u", gen);
+
+		int ret = lockrestart_do(trans, bkey_err(k = bch2_btree_iter_peek_slot(&iter)));
+		if (!ret) {
+			prt_newline(&buf);
+			bch2_bkey_val_to_text(&buf, c, k);
+		}
+	} else {
+		prt_printf(&buf, "Attempting to read from invalid bucket %llu:%llu:\n",
+			   iter.pos.inode, iter.pos.offset);
+		printbuf_indent_add(&buf, 2);
+
+		prt_printf(&buf, "first bucket %u nbuckets %llu\n",
+			   ca->mi.first_bucket, ca->mi.nbuckets);
+
+		bch2_bkey_val_to_text(&buf, c, k);
+		prt_newline(&buf);
+	}
+
+	bch2_fs_inconsistent(c, "%s", buf.buf);
+}
+
+static inline bool can_narrow_crc(struct bch_extent_crc_unpacked n)
+{
+	return n.csum_type &&
+		n.live_size < n.uncompressed_size &&
+		!crc_is_compressed(n);
+}
