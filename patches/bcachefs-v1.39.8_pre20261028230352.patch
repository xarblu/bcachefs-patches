+#[c_export]
+pub fn bch2_trans_mark_dev_sbs_flags(c: &Opaque<c::bch_fs>, flags: c::btree_iter_update_trigger_flags) -> c_int {
+    ret_to_c(Fs::from_c(c).trans_mark_dev_sbs(UpdateTriggerFlags::from_bits_retain(flags.bits())))
+}
