+					(_journal_seq), (_commit_flags)))
+
+#define for_each_btree_key_max_commit(_trans, _iter, _btree_id,	\
+				  _start, _end, _iter_flags, _k,	\
+				  _disk_res, _journal_seq, _commit_flags,\
+				  _do)					\
