+#[c_export]
+pub fn bch2_backpointer_swab(_c: Option<&Fs>, k: BkeyS<'_>) {
+    let mut bp = k.arm::<c::Backpointer>().expect("a backpointer");
+    let v = bp.v_mut();
+
+    v.flags = { v.flags }.swap_bytes();
+    v.bucket_len = { v.bucket_len }.swap_bytes();
+    let mut pos = v.pos;
+    pos.swab();
+    v.pos = pos;
+}
