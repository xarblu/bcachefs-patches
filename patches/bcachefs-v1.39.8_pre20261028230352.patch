+ */
+int bch2_btree_insert(struct bch_fs *c, enum btree_id id, struct bkey_i *k,
+		      struct disk_reservation *disk_res,
+		      enum bch_trans_commit_flags commit_flags,
+		      enum btree_iter_update_trigger_flags iter_flags)
+{
