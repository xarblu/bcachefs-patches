+//! Positions: bpos constructors, the sentinels, and stepping to the next or
+//! previous position.
+
+use crate::c;
+use crate::c::bpos as Bpos;
+
+pub const fn spos(inode: u64, offset: u64, snapshot: u32) -> Bpos {
+    Bpos {
+        inode,
+        offset,
+        snapshot,
+    }
+}
+
+pub const fn pos(inode: u64, offset: u64) -> Bpos {
+    spos(inode, offset, 0)
+}
+
+pub const POS_MIN: Bpos = spos(0, 0, 0);
+pub const POS_MAX: Bpos = spos(u64::MAX, u64::MAX, 0);
+pub const SPOS_MAX: Bpos = spos(u64::MAX, u64::MAX, u32::MAX);
+
+impl c::bpos {
+    /// The next position, snapshot field first. None after SPOS_MAX: panics.
+    pub fn successor(self) -> Self {
+        let (inode, offset, snapshot) = (self.inode, self.offset, self.snapshot);
+
+        if let Some(snapshot) = snapshot.checked_add(1) {
+            spos(inode, offset, snapshot)
+        } else if let Some(offset) = offset.checked_add(1) {
+            spos(inode, offset, 0)
+        } else {
+            spos(inode.checked_add(1).expect("no position after SPOS_MAX"), 0, 0)
+        }
+    }
+
+    /// The next position ignoring the snapshot field: past every snapshot
+    /// version of this one. Panics after POS_MAX.
+    pub fn nosnap_successor(self) -> Self {
+        let (inode, offset) = (self.inode, self.offset);
+
+        if let Some(offset) = offset.checked_add(1) {
+            spos(inode, offset, 0)
+        } else {
+            spos(inode.checked_add(1).expect("no position after POS_MAX"), 0, 0)
+        }
+    }
+
+    /// The previous position ignoring the snapshot field, at snapshot 0.
+    /// Panics before POS_MIN.
+    pub fn nosnap_predecessor(self) -> Self {
+        let (inode, offset) = (self.inode, self.offset);
+
+        if let Some(offset) = offset.checked_sub(1) {
+            spos(inode, offset, 0)
+        } else {
+            spos(inode.checked_sub(1).expect("no position before POS_MIN"), u64::MAX, 0)
+        }
+    }
+
+    /// The previous position, snapshot field first. None before POS_MIN:
+    /// panics.
+    pub fn predecessor(self) -> Self {
+        let (inode, offset, snapshot) = (self.inode, self.offset, self.snapshot);
+
+        if let Some(snapshot) = snapshot.checked_sub(1) {
+            spos(inode, offset, snapshot)
+        } else if let Some(offset) = offset.checked_sub(1) {
+            spos(inode, offset, u32::MAX)
+        } else {
+            spos(inode.checked_sub(1).expect("no position before POS_MIN"), u64::MAX, u32::MAX)
+        }
+    }
+}
diff --git a/fs/bcachefs/btree/bkey/cmp.rs b/fs/bcachefs/btree/bkey/cmp.rs
new file mode 100644
index 0000000..e33c4c5
--- /dev/null
+++ b/fs/bcachefs/btree/bkey/cmp.rs
@@ -0,0 +1,148 @@
+//! Comparing positions: Bpos's Ord, and C's bpos_*() - every field - and
+//! bkey_*() - inode and offset, the snapshot field ignored. Its Hash is of
+//! every field too, as its Eq.
+
+use crate::c::bpos as Bpos;
+use core::cmp::Ordering;
+use core::hash::{Hash, Hasher};
+
+impl Hash for Bpos {
+    fn hash<H: Hasher>(&self, h: &mut H) {
+        // packed: the fields by value
+        (self.inode, self.offset, self.snapshot).hash(h)
+    }
+}
+
+impl PartialEq for Bpos {
+    fn eq(&self, other: &Self) -> bool {
+        self.cmp(other) == Ordering::Equal
+    }
+}
+
+impl Eq for Bpos {}
+
+impl PartialOrd for Bpos {
+    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
+        Some(self.cmp(other))
+    }
+}
+
+impl Ord for Bpos {
+    fn cmp(&self, other: &Self) -> Ordering {
+        let l_inode = self.inode;
+        let r_inode = other.inode;
+        let l_offset = self.offset;
+        let r_offset = other.offset;
+        let l_snapshot = self.snapshot;
+        let r_snapshot = other.snapshot;
+
+        l_inode
+            .cmp(&r_inode)
+            .then(l_offset.cmp(&r_offset))
+            .then(l_snapshot.cmp(&r_snapshot))
+    }
+}
+
+#[inline(always)]
+pub fn bpos_lt(l: Bpos, r: Bpos) -> bool {
+    if l.inode != r.inode {
+        l.inode < r.inode
+    } else if l.offset != r.offset {
+        l.offset < r.offset
+    } else {
+        l.snapshot < r.snapshot
+    }
+}
+
+#[inline(always)]
+pub fn bpos_le(l: Bpos, r: Bpos) -> bool {
+    if l.inode != r.inode {
+        l.inode < r.inode
+    } else if l.offset != r.offset {
+        l.offset < r.offset
+    } else {
+        l.snapshot <= r.snapshot
+    }
+}
+
+#[inline(always)]
+pub fn bpos_gt(l: Bpos, r: Bpos) -> bool {
+    bpos_lt(r, l)
+}
+
+#[inline(always)]
+pub fn bpos_ge(l: Bpos, r: Bpos) -> bool {
+    bpos_le(r, l)
+}
+
+#[inline(always)]
+pub fn bpos_cmp(l: Bpos, r: Bpos) -> i32 {
+    if l.inode != r.inode {
+        if l.inode < r.inode { -1 } else { 1 }
+    } else if l.offset != r.offset {
+        if l.offset < r.offset { -1 } else { 1 }
+    } else if l.snapshot != r.snapshot {
+        if l.snapshot < r.snapshot { -1 } else { 1 }
+    } else {
+        0
+    }
+}
+
+#[inline]
+pub fn bpos_min(l: Bpos, r: Bpos) -> Bpos {
+    if bpos_lt(l, r) { l } else { r }
+}
+
+#[inline]
+pub fn bpos_max(l: Bpos, r: Bpos) -> Bpos {
+    if bpos_gt(l, r) { l } else { r }
+}
+
+#[inline(always)]
+pub fn bkey_eq(l: Bpos, r: Bpos) -> bool {
+    l.inode == r.inode && l.offset == r.offset
+}
+
+#[inline(always)]
+pub fn bkey_lt(l: Bpos, r: Bpos) -> bool {
+    if l.inode != r.inode {
+        l.inode < r.inode
+    } else {
+        l.offset < r.offset
+    }
+}
+
+#[inline(always)]
+pub fn bkey_le(l: Bpos, r: Bpos) -> bool {
+    if l.inode != r.inode {
+        l.inode < r.inode
+    } else {
+        l.offset <= r.offset
+    }
+}
+
+#[inline(always)]
+pub fn bkey_gt(l: Bpos, r: Bpos) -> bool {
+    bkey_lt(r, l)
+}
+
+#[inline(always)]
+pub fn bkey_ge(l: Bpos, r: Bpos) -> bool {
+    bkey_le(r, l)
+}
+
+#[inline]
+pub fn bkey_min(l: Bpos, r: Bpos) -> Bpos {
+    if bkey_lt(l, r) { l } else { r }
+}
+
+#[inline(always)]
+pub fn bkey_cmp(l: Bpos, r: Bpos) -> i32 {
+    if l.inode != r.inode {
+        if l.inode < r.inode { -1 } else { 1 }
+    } else if l.offset != r.offset {
+        if l.offset < r.offset { -1 } else { 1 }
+    } else {
+        0
+    }
+}
diff --git a/fs/bcachefs/btree/bkey/mod.rs b/fs/bcachefs/btree/bkey/mod.rs
new file mode 100644
index 0000000..2416ec8
--- /dev/null
+++ b/fs/bcachefs/btree/bkey/mod.rs
@@ -0,0 +1,160 @@
+//! Keys: their types, the forms they're held in, and narrowing between them.
+//! types.rs is the types and traits - key types and families, the forms
+//! they're held in, the macros generating them; bpos.rs, cmp.rs and text.rs
+//! are positions, comparisons, and to and from text; here is the header, the
+//! struct bkey every form has.
+//!
+//! **Value types and key types.** A key's type is its value's: c::Extent,
+//! c::Dirent, the c::bch_<name> structs of BCH_BKEY_TYPES(). A key type
+//! is a BkeyTag, the tag and minimum size, and a BkeyFamily, the set of just
+//! it, whose Validated is the value as a key read in place
+//! has it, as long as k.u64s says - and Unvalidated, the same from outside.
+//! Three kinds of value, each declared at its definition:
+//!  - plain (#[derive(SizedVal)]): every valid value is all of the struct -
+//!    in place it's the struct, BkeyWhole, had by value; Unvalidated,
+//!    UnvalidatedSized<the struct>;
+//!  - grown (#[grown(.., bkey)]): an older value is shorter - in place it's
+//!    the family's X<Validated>, the floor and the bytes there are; by value
+//!    it's the struct, zero padded;
+//!  - whole (#[whole(bkey)]): every valid value has the head, and maybe a tail -
+//!    in place it's X<Validated>, as long as its u64s.
+//! A key's state is its value's, and narrowing keeps it: an Unvalidated
+//! key's arms are Unvalidated.
+//! A key of any type's value is FamilyVal<AllTypes>, the family of every
+//! type, the default V. BkeyVal is what a value type is - what V can be:
+//! these, a family, a BkeyWhole's struct.
+//!
+//! **Key families.** BkeyFamily is a set of key types - what a key narrows
+//! to: one type (every BkeyTag), or a family, the union of several, made
+//! by bkey_family! from the BCH_BKEY_TYPES() rows a flag picks: Ptrs
+//! (BKEY_TYPE_ptrs, data/ptrs.rs), Extents (BKEY_TYPE_extent,
+//! data/extents.rs), Indirect (BKEY_TYPE_indirect, data/reflink.rs). A
+//! family's value is read through typed(), the enum of its types - Typed's
+//! arms but its own, PtrsTyped - and it can require more than the type: an
+//! Extents key's size is nonzero. contains() decides.
+//!
+//! **Forms.** A key is held as a BkeySC<V> - borrowed, to read, Copy; a
+//! BkeyS<V> - borrowed, to edit; a BkeyI<V> - header and value inline, by
+//! reference, a DST as long as its u64s say; or a TransBkey<V> - in
+//! transaction memory, to update (btree/iter.rs). Every form is a BkeyV -
+//! its header, as_sc(), and arm() - and the editable ones BkeyVMut, as_s().
+//! The same key in another form keeps V: From - BkeySC::from(&k),
+//! BkeyS::from(&mut k) - or, generic over the form, as_sc(), as_s(). A key
+//! converts to a family it's in by type, by From too, in its form or one it
+//! converts to, in its state or a weaker one - never a stronger: one into()
+//! does all three; untyped() erases keeping the form and state. as_ref() is
+//! the BkeyI a validated key is: an unvalidated one has none.
+//!
+//! Conversions go one way: BkeyI (and TransBkey) -> BkeyS -> BkeySC. A
+//! bkey_i's value is inline, after its header; a bkey_s's is split, a
+//! pointer of its own, which may be anywhere - an unpacked key's value is
+//! still in the btree node. So a BkeyS isn't a bkey_i: what needs one -
+//! C's bch2_btree_insert() - takes a BkeyI.
+//!
+//! **Narrowing.** arm::<K>() narrows any form to K, keeping the form: None
+//! if the key isn't one. It consumes the key, as a type change does; to
+//! narrow a borrow, as_s().arm(). typed() on an untyped key - or a family's
+//! - is the match on its type. Lookups narrow the same way:
+//! peek_slot_typed::<K>(). arm() checks the tag, and a family's
+//! constraints; a key's length is validate's, as in C.
+//!
+//! **Methods by value type.** A value type's trait says what its keys can
+//! do - PtrsBkey, where its extent entries are - and a form trait gives it
+//! to every form of key whose V has it: BkeyVPtrs (the entry walk),
+//! BkeyVExtents (cut, on a key armed to Extents). bkey::prelude has the
+//! form traits.
+//!
+//! **Copies.** MutBkey is what a mutable copy of a key read as V is: any
+//! key's, as it is; a plain type's, itself; a grown type's, its whole struct,
+//! grown (bkey_make_mut_noupdate()); a whole type's or a family's, itself,
+//! as long as it is. bkey_reassemble() and bkey_reassemble_room() copy a
+//! key keeping its V where the copy is still one (Mut = V). from_key() is
+//! an owned copy of a plain or grown key, its u64s clamped to what it holds.
+
+#![allow(non_camel_case_types)]
+
+mod bpos;
+mod cmp;
+#[cfg(test)]
+mod tests;
+mod text;
+mod types;
+
+pub use self::bpos::*;
+pub use self::cmp::*;
+pub use self::text::*;
+pub use self::types::*;
+
+use crate::c;
+
+pub const BKEY_U64S: usize = core::mem::size_of::<c::bkey>() / core::mem::size_of::<u64>();
+
+pub type bkey_type = c::bch_bkey_type;
+
+impl c::bkey {
+    /// Of type deleted, at POS_MIN, with no value: as bkey_init() sets.
+    pub fn new() -> Self {
+        Self {
+            u64s:        BKEY_U64S as u8,
+            format_bits: c::bkey_format_bits::new().with_format(c::KEY_FORMAT_CURRENT as u8),
+            ..Default::default()
+        }
+    }
+
+    /// The whole key's, value and all: bkey_bytes().
+    pub fn bytes(&self) -> usize {
+        self.u64s as usize * size_of::<u64>()
+    }
+
+    /// As its u64s say.
+    pub fn val_bytes(&self) -> usize {
+        (self.u64s as usize).saturating_sub(BKEY_U64S) * size_of::<u64>()
+    }
+
+    /// Whether it's @K's type: the tag. Not whether its value is long enough
+    /// - that's validate's, as in C.
+    pub fn is<K: BkeyTag + ?Sized>(&self) -> bool {
+        self.type_ as u32 == K::TYPE.0
+    }
+
+    pub fn set_val_bytes(&mut self, bytes: usize) {
+        let u64s = BKEY_U64S + bytes.div_ceil(size_of::<u64>());
+        self.u64s = u8::try_from(u64s)
+            .unwrap_or_else(|_| panic!("key of {u64s} u64s: a key is at most {} u64s", u8::MAX));
+    }
+
+    /// Make an extent @new_size long from where it starts: its end, its
+    /// position, moves.
+    pub fn resize(&mut self, new_size: u32) {
+        self.p.offset = self.p.offset - self.size as u64 + new_size as u64;
+        self.size = new_size;
+    }
+
+    pub fn key_type(&self) -> c::bch_bkey_type {
+        c::bch_bkey_type(self.type_ as u32)
+    }
+
+    pub fn start_pos(&self) -> c::bpos {
+        c::bpos { offset: self.start_offset(), ..self.p }
+    }
+
+    pub fn start_offset(&self) -> u64 {
+        self.p.offset.wrapping_sub(self.size as u64)
+    }
+
+    pub fn is_deleted(&self) -> bool {
+        self.key_type() == c::bch_bkey_type::KEY_TYPE_deleted
+    }
+
+    /// A tombstone in an extents btree.
+    pub fn is_extent_whiteout(&self) -> bool {
+        matches!(self.key_type(),
+                 c::bch_bkey_type::KEY_TYPE_deleted |
+                 c::bch_bkey_type::KEY_TYPE_whiteout |
+                 c::bch_bkey_type::KEY_TYPE_extent_whiteout)
+    }
+
+    pub fn is_btree_ptr(&self) -> bool {
+        <crate::data::ptrs::BtreePtrs as BkeyFamily>::contains(self)
+    }
+}
diff --git a/fs/bcachefs/btree/bkey/tests.rs b/fs/bcachefs/btree/bkey/tests.rs
new file mode 100644
index 0000000..1acde8b
--- /dev/null
+++ b/fs/bcachefs/btree/bkey/tests.rs
@@ -0,0 +1,110 @@
+use super::*;
+use crate::c;
+use crate::util::vstructs::ArmRef;
+use crate::types::Le32;
+
+/// A snapshot key from before depth, skip and btime - 24 bytes of its 64 -
+/// reads as a snapshot: the fields it has as they are, the rest zero, not
+/// what's in the buffer past it.
+#[test]
+fn bkey_short_value() {
+    assert_eq!(c::Snapshot::MIN_VAL_SIZE, 24);
+
+    let mut k = BkeyI::<c::Snapshot>::new();
+    k.v.subvol = Le32::new(5);
+    k.v.children = [Le32::new(3), Le32::new(4)];
+    k.v.depth = Le32::new(7);
+    k.k.set_val_bytes(24);
+
+    let s = BkeySC::from(k.as_ref()).arm::<c::Snapshot>().expect("a snapshot").v();
+    assert_eq!((s.subvol.get(), s.children[0].get(), s.children[1].get()), (5, 3, 4));
+    assert_eq!(s.depth().get(), 0);
+    assert!(s.whole().is_none());
+    assert!(BkeySC::from(k.as_ref()).arm::<c::Subvolume>().is_none());
+}
+
+/// A key by its type: a grown type's value its family's, an older value
+/// of it read as one - inline too: dispatch is by type, as C's.
+#[test]
+fn bkey_typed_short_values() {
+    let mut k = BkeyI::<c::Subvolume>::new();
+    k.v.snapshot = Le32::new(5);
+    k.k.set_val_bytes(16);
+    match BkeySC::from(k.as_ref()).typed() {
+        Typed::subvolume(s) =>
+            assert_eq!((s.v().snapshot.get(), s.v().fs_path_parent().get()), (5, 0)),
+        _ => panic!("a subvolume"),
+    }
+    match k.as_ref().typed() {
+        Typed::subvolume(s) =>
+            assert_eq!((s.v.snapshot.get(), s.v.fs_path_parent().get()), (5, 0)),
+        _ => panic!("a subvolume"),
+    }
+
+    let mut g = BkeyI::<c::InodeGeneration>::new();
+    g.v.bi_generation = Le32::new(3);
+    assert_eq!(BkeySC::from(g.as_ref()).arm::<c::InodeGeneration>().map(|g| g.v().bi_generation.get()),
+               Some(3));
+    assert!(matches!(g.as_ref().typed(), Typed::inode_generation(_)));
+}
+
+/// A snapshot can't be had over fewer bytes than every snapshot has -
+/// its floor, 24 - rather than reading past them; over 24, it can.
+#[test]
+fn bkey_unfloored() {
+    let b = [0u64; 3];
+    // SAFETY: b's bytes, aligned for any value
+    let b = unsafe { core::slice::from_raw_parts(b.as_ptr().cast::<u8>(), size_of_val(&b)) };
+    use crate::util::vstructs::Validated;
+    assert!(<c::Snapshot<Validated> as ArmRef>::arm_ref(&b[..16]).is_none());
+    assert!(<c::Snapshot<Validated> as ArmRef>::arm_ref(&b[..24]).is_some());
+}
+
+/// A subvolume key from before fs_path_parent - 16 bytes of its 48 - edited
+/// in place has only the fields it has: one it lacks has no setter, a
+/// write the key wouldn't carry. One grown whole does.
+#[test]
+fn bkey_edit_short_value() {
+    let mut k = BkeyI::<c::Subvolume>::new();
+    k.k.set_val_bytes(16);
+    let k = k.as_mut();
+
+    assert!(k.arm::<c::Snapshot>().is_none());
+
+    let s = BkeyS::from(&mut *k);
+    let Typed::subvolume(mut s) = s.typed() else { panic!("a subvolume") };
+    s.v_mut().snapshot = Le32::new(5);
+
+    let mut full = BkeyI::<c::Subvolume>::new();
+    full.v.fs_path_parent = Le32::new(9);
+    assert_eq!(full.v.fs_path_parent, 9);
+    let s = BkeySC::from(&*k).arm::<c::Subvolume>().expect("a subvolume").v();
+    assert_eq!((s.snapshot.get(), s.fs_path_parent().get()), (5, 0));
+}
+
+#[test]
+fn bpos_successor_predecessor_carry() {
+    let cases = [
+        (spos(1, 2, 3),               spos(1, 2, 4)),
+        (spos(1, 2, u32::MAX),        spos(1, 3, 0)),
+        (spos(1, u64::MAX, u32::MAX), spos(2, 0, 0)),
+        (POS_MIN,                     spos(0, 0, 1)),
+    ];
+
+    for (p, next) in cases {
+        assert_eq!(p.successor(), next, "successor of {p}");
+        assert_eq!(next.predecessor(), p, "predecessor of {next}");
+    }
+}
+
+#[test]
+#[should_panic(expected = "no position after SPOS_MAX")]
+fn bpos_successor_of_max() {
+    SPOS_MAX.successor();
+}
+
+#[test]
+#[should_panic(expected = "no position before POS_MIN")]
+fn bpos_predecessor_of_min() {
+    POS_MIN.predecessor();
+}
diff --git a/fs/bcachefs/btree/bkey/text.rs b/fs/bcachefs/btree/bkey/text.rs
new file mode 100644
index 0000000..966bbb6
--- /dev/null
+++ b/fs/bcachefs/btree/bkey/text.rs
@@ -0,0 +1,102 @@
+//! Keys and positions to and from text: Debug and FromStr for positions,
+//! ToText for a key's header, and BkeySCToText for a key with its value.
+
+use super::{AllTypes, BkeySC, BkeyVal, FamilyVal};
+use crate::c;
+use crate::c::bpos as Bpos;
+use crate::fs::Fs;
+use crate::util::{Printbuf, ToText};
+use core::fmt;
+#[cfg(feature = "std")]
+use core::str::FromStr;
+#[cfg(feature = "std")]
+use crate::errcode::{bch_errcode, BchError};
+#[cfg(feature = "std")]
+use super::{POS_MAX, POS_MIN, SPOS_MAX};
+
+/// As Display.
+impl fmt::Debug for Bpos {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        fmt::Display::fmt(self, f)
+    }
+}
+
+/// A bpos field that holds a u64 (inode, offset). "U64_MAX" and "U32_MAX" are
+/// accepted, as positions are printed.
+#[cfg(feature = "std")]
+fn parse_bpos_u64(s: &str) -> Result<u64, BchError> {
+    match s {
+        "U64_MAX" => Ok(u64::MAX),
+        "U32_MAX" => Ok(u32::MAX as u64),
+        _        => s.parse().map_err(|_| BchError::from(bch_errcode::BCH_ERR_EINVAL_parse_bpos)),
+    }
+}
+
+/// Same for the snapshot field (u32).
+#[cfg(feature = "std")]
+fn parse_bpos_u32(s: &str) -> Result<u32, BchError> {
+    match s {
+        "U32_MAX" => Ok(u32::MAX),
+        _        => s.parse().map_err(|_| BchError::from(bch_errcode::BCH_ERR_EINVAL_parse_bpos)),
+    }
+}
+
+#[cfg(feature = "std")]
+impl FromStr for c::bpos {
+    type Err = BchError;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        if s == "POS_MIN" {
+            return Ok(POS_MIN);
+        }
+
+        if s == "POS_MAX" {
+            return Ok(POS_MAX);
+        }
+
+        if s == "SPOS_MAX" {
+            return Ok(SPOS_MAX);
+        }
+
+        let err = || BchError::from(bch_errcode::BCH_ERR_EINVAL_parse_bpos);
+
+        let mut fields = s.split(':');
+        let ino_str = fields.next().ok_or_else(err)?;
+        let off_str = fields.next().ok_or_else(err)?;
+        let snp_str = fields.next();
+
+        let ino: u64 = parse_bpos_u64(ino_str)?;
+        let off: u64 = parse_bpos_u64(off_str)?;
+        let snp: u32 = snp_str
+            .map(parse_bpos_u32)
+            .transpose()?
+            .unwrap_or(0);
+
+        Ok(c::bpos {
+            inode:    ino,
+            offset:   off,
+            snapshot: snp,
+        })
+    }
+}
+
+pub struct BkeySCToText<'a, 'f, V: ?Sized + BkeyVal = FamilyVal<AllTypes>> {
+    pub(crate) k:  BkeySC<'a, V>,
+    pub(crate) fs: &'f Fs,
+}
+
+impl<V: ?Sized + BkeyVal> ToText for BkeySCToText<'_, '_, V> {
+    fn to_text(&self, out: &mut Printbuf) {
+        unsafe { c::bch2_bkey_val_to_text(out.as_raw(), self.fs.as_ptr(), self.k.into()) }
+    }
+}
+
+crate::display_via_to_text!(impl[V: ?Sized + BkeyVal] BkeySCToText<'_, '_, V>);
+
+/// Without its value.
+impl ToText for c::bkey {
+    fn to_text(&self, out: &mut Printbuf) {
+        unsafe { c::bch2_bkey_to_text(out.as_raw(), self) }
+    }
+}
+crate::display_via_to_text!(c::bkey);
diff --git a/fs/bcachefs/btree/bkey/types.rs b/fs/bcachefs/btree/bkey/types.rs
new file mode 100644
index 0000000..7c3481e
--- /dev/null
+++ b/fs/bcachefs/btree/bkey/types.rs
@@ -0,0 +1,898 @@
+//! Keys' types and traits - mod.rs has how they fit together; this is what
+//! each is.
+//!
+//! The forms: BkeySC/BkeyS, C's bkey_s_c/bkey_s - a header pointer and a thin
+//! value pointer, V phantom, v() making the reference - and BkeyI, header and
+//! value inline, a DST, a reference covering all of the key.
+//!
+//! Over the forms:
+//!  - BkeyV: a key in any form, TransBkey too - for code generic over how a
+//!    key is held: its header, as_sc(), arm(), typed();
+//!  - BkeyVMut: one that can be edited - as_s(), v_mut().
+//!
+//! Over value types, V:
+//!  - BkeyVal: what V can be - a key type's value, or a family's;
+//!  - BkeyFamily: a set of key types, what arm() narrows a key to - which keys
+//!    are in it, what one is read as in place, Validated and Unvalidated;
+//!  - KeyState: the state a key is in, its value's (BkeyVal::State) - which
+//!    narrowing keeps: Of<K> is K's value in it, Narrowed<K, V> a V's key's;
+//!  - Implies: what a state is too - itself, and the weaker ones: what a
+//!    conversion may make a key, never stronger;
+//!  - InFamily: a value type whose keys are a family's by type - what a key
+//!    converts to the family by, From;
+//!  - BkeyTag: a key type's tag and minimum value size - the row's data, all
+//!    bkey_val! writes for every type; a key type is a BkeyTag, and a
+//!    BkeyFamily of just itself;
+//!  - BkeyTyped: what typed() switches a key over, by V - every type, or a
+//!    family's;
+//!  - FamilyTypes: a key family's types, F in FamilyVal<F> - its value, any of
+//!    theirs, as long as the key is: Ptrs, Extents, Indirect;
+//!  - BkeyWhole: a key type whose value can be had by value - BkeyI::new(),
+//!    from_key();
+//!  - MutBkey: what a mutable copy of a key read as V is - bkey_make_mut();
+//!  - SizedVal: a sized key type's value, itself in place - what the generic
+//!    impls of the sized types' traits go by - or an unvalidated one's,
+//!    UnvalidatedSized. Unsized too, and its derive InState, so every key
+//!    type's BkeyFamily is the one impl.
+//!
+//! The macros generate the per-type impls from BCH_BKEY_TYPES(): bkey_val!
+//! per type, bkey_typed! the typed() enums, bkey_family! a family (Ptrs,
+//! Extents, Indirect), bkey_family_members! a family's InFamily markers, and
+//! bkey_family_conv! its From impls - one per form pair, generic over the
+//! key's type and state, so a single into() erases, narrows the family and
+//! weakens the state at once. What's per kind is at a value's definition:
+//! #[whole(bkey)], #[grown(.., bkey)], #[derive(SizedVal)].
+
+use crate::btree::iter::{BtreeIter, TransBkey};
+use crate::c;
+use crate::util::projections::Floored;
+use crate::util::vstructs::{ArmRef, InState, State, Unsized, Unvalidated, UnvalidatedSized, Validated, Whole};
+use core::marker::PhantomData;
+
+#[repr(C)]
+pub struct BkeySC<'a, V: ?Sized + BkeyVal = FamilyVal<AllTypes>> {
+    pub k:           &'a c::bkey,
+    pub(crate) v:    *const c::bch_val,
+    pub(crate) iter: PhantomData<&'a mut BtreeIter<'a>>,
+    pub(crate) val:  PhantomData<*const V>,
+}
+
+// Copy whatever V is: a derive would require V: Copy.
+impl<V: ?Sized + BkeyVal> Clone for BkeySC<'_, V> {
+    fn clone(&self) -> Self {
+        *self
+    }
+}
+impl<V: ?Sized + BkeyVal> Copy for BkeySC<'_, V> {}
+
+/// Not Copy: editing borrows it, so one can be walked twice - a read, then a
+/// rewrite - without aliasing.
+#[repr(C)]
+pub struct BkeyS<'a, V: ?Sized + BkeyVal = FamilyVal<AllTypes>> {
+    pub k:          &'a mut c::bkey,
+    pub(crate) v:   *mut c::bch_val,
+    pub(crate) val: PhantomData<*mut V>,
+}
+
+const _: () = {
+    use core::mem::{align_of, offset_of, size_of};
+    assert!(size_of::<BkeySC<'static>>() == size_of::<c::bkey_s_c>());
+    assert!(align_of::<BkeySC<'static>>() == align_of::<c::bkey_s_c>());
+    assert!(offset_of!(BkeySC<'static>, k) == offset_of!(c::bkey_s_c, k));
+    assert!(offset_of!(BkeySC<'static>, v) == offset_of!(c::bkey_s_c, v));
+};
+
+/// Not Clone or Copy: the value can run past V - copying a key is bkey_copy().
+///
+/// XXX: the header is writable under a key - BkeyI's and BkeyS's pub k,
+/// TransBkey::k_mut() - so safe code can set k.u64s past the value's bytes,
+/// which every form reads its length from, or retag a typed key. u64s and
+/// type_ should change only through what knows the room and the type.
+#[derive(Default)]
+#[repr(C)]
+pub struct BkeyI<V: ?Sized = FamilyVal<AllTypes>> {
+    pub k: c::bkey,
+    pub v: V,
+}
+
+impl<'a, V: ?Sized + BkeyVal> BkeySC<'a, V> {
+    pub fn val_bytes(&self) -> &'a [u8] {
+        // SAFETY: its value follows its header, as long as u64s says, for 'a
+        unsafe { core::slice::from_raw_parts(self.v.cast::<u8>(), self.k.val_bytes()) }
+    }
+
+    fn cast<W: ?Sized + BkeyVal>(self) -> BkeySC<'a, W> {
+        BkeySC { k: self.k, v: self.v, iter: PhantomData, val: PhantomData }
+    }
+
+    /// For C, which takes a typed key, bkey_s_c_<type>, without a lifetime.
+    ///
+    /// # Safety
+    /// It's handed to C within 'a, and not kept past it.
+    pub(crate) unsafe fn to_c(self) -> BkeySC<'static, V> {
+        BkeySC { k: unsafe { &*(self.k as *const c::bkey) }, v: self.v, iter: PhantomData, val: PhantomData }
+    }
+}
+
+impl<'a, V: ?Sized + BkeyVal + ArmRef> BkeySC<'a, V> {
+    /// A value shorter than validate passes is a bug.
+    pub fn v(&self) -> &'a V {
+        V::arm_ref(self.val_bytes())
+            .unwrap_or_else(|| panic!("{}: {} bytes, shorter than validate passes", self.k,
+                                      self.val_bytes().len()))
+    }
+}
+
+impl<'a> BkeySC<'a> {
+    /// A key C hands over.
+    ///
+    /// # Safety
+    /// @k's header and value are a key's, valid for 'a.
+    pub unsafe fn from_c(k: &'a c::bkey_s_c) -> Self {
+        BkeySC { k: unsafe { &*k.k }, v: k.v, iter: PhantomData, val: PhantomData }
+    }
+}
+
+impl<'a, V: ?Sized + BkeyVal> BkeyS<'a, V> {
+    pub(crate) fn as_raw(&mut self) -> c::bkey_s {
+        c::bkey_s { split: c::bkey_s_split { kv: c::bkey_s_kv { k: &mut *self.k, v: self.v } } }
+    }
+
+    pub fn into_val_bytes_mut(self) -> &'a mut [u8] {
+        // SAFETY: as val_bytes()'s, for 'a, whose borrow this consumes
+        unsafe { core::slice::from_raw_parts_mut(self.v.cast::<u8>(), self.k.val_bytes()) }
+    }
+
+    fn cast<W: ?Sized + BkeyVal>(self) -> BkeyS<'a, W> {
+        BkeyS { k: self.k, v: self.v, val: PhantomData }
+    }
+}
+
+impl<'a> BkeyS<'a> {
+    /// # Safety
+    /// @v is @k's value, as long as k.u64s says, nothing else touching it for
+    /// 'a.
+    pub unsafe fn from_parts(k: &'a mut c::bkey, v: *mut c::bch_val) -> Self {
+        BkeyS { k, v, val: PhantomData }
+    }
+}
+
+impl BkeyI {
+    /// # Safety
+    /// @p is a key, its u64s right and all of them there, and it may reach
+    /// them - not a pointer widened from a reference to the header.
+    pub unsafe fn from_raw(p: *const c::bkey_i) -> *const Self {
+        unsafe { cast_unsized(p) }
+    }
+
+    pub unsafe fn from_raw_mut(p: *mut c::bkey_i) -> *mut Self {
+        unsafe { cast_unsized_mut(p) }
+    }
+}
+
+/// A thin entry's key, in the state it is: its container's.
+impl<'a, S: KeyState> crate::util::vstructs::VstructRef<'a, c::bkey_i, S> {
+    pub fn key(&self) -> &'a BkeyI<FamilyVal<AllTypes, S>> {
+        // SAFETY: the walk checked its u64s against its bytes
+        unsafe { &*cast_unsized(self.as_bytes().as_ptr().cast()) }
+    }
+}
+
+impl<S: KeyState> crate::util::vstructs::VstructMut<'_, c::bkey_i, S> {
+    pub fn key_mut(&mut self) -> &mut BkeyI<FamilyVal<AllTypes, S>> {
+        // SAFETY: the walk checked its u64s against its bytes
+        unsafe { &mut *cast_unsized_mut(self.as_mut_ptr()) }
+    }
+}
+
+impl<V: ?Sized> BkeyI<V> {
+    pub fn as_ffi(&self) -> *const c::bkey_i {
+        (self as *const Self).cast()
+    }
+
+    pub fn as_ffi_mut(&mut self) -> *mut c::bkey_i {
+        (self as *mut Self).cast()
+    }
+
+    pub fn v(&self) -> &V {
+        &self.v
+    }
+
+    pub fn v_mut(&mut self) -> &mut V {
+        &mut self.v
+    }
+}
+
+impl<V: BkeyWhole> BkeyI<V> {
+    pub fn new() -> Self {
+        let mut k = c::bkey::new();
+        k.type_ = V::TYPE.0 as u8;
+        k.set_val_bytes(size_of::<V>());
+        BkeyI { k, v: V::default() }
+    }
+
+    /// u64s clamped to V, as __bch2_bkey_get_i_typed() does: a newer version's
+    /// fields are dropped - this one couldn't have kept them consistent with
+    /// its update. An older value's stay short, so to_text() doesn't print
+    /// fields it hasn't.
+    pub fn from_key(k: BkeySC<'_>) -> Option<Self> {
+        let v = V::val_copy_pad(k)?;
+        let mut hdr = *k.k;
+        hdr.set_val_bytes(hdr.val_bytes().min(size_of::<V>()));
+        Some(BkeyI { k: hdr, v })
+    }
+}
+
+impl<V: ?Sized + BkeyVal> From<BkeySC<'_, V>> for c::bkey_s_c {
+    fn from(k: BkeySC<'_, V>) -> Self {
+        c::bkey_s_c { k: k.k as *const c::bkey as *mut c::bkey, v: k.v.cast_mut() }
+    }
+}
+
+impl<'a, V: ?Sized + BkeyVal> From<&'a BkeyI<V>> for BkeySC<'a, V> {
+    fn from(k: &'a BkeyI<V>) -> Self {
+        BkeySC { k: &k.k, v: (&raw const k.v).cast(), iter: PhantomData, val: PhantomData }
+    }
+}
+
+impl<'a, V: ?Sized + BkeyVal> From<&'a BkeyS<'_, V>> for BkeySC<'a, V> {
+    fn from(k: &'a BkeyS<'_, V>) -> Self {
+        BkeySC { k: &*k.k, v: k.v.cast_const(), iter: PhantomData, val: PhantomData }
+    }
+}
+
+impl<'a, V: ?Sized + BkeyVal> From<&'a mut BkeyI<V>> for BkeyS<'a, V> {
+    fn from(k: &'a mut BkeyI<V>) -> Self {
+        BkeyS { k: &mut k.k, v: (&raw mut k.v).cast(), val: PhantomData }
+    }
+}
+
+/// The bkey_i it is, of any type - a validated key's, a key in a state that
+/// implies Validated: an unvalidated one converts by From, to one of its own.
+impl AsRef<BkeyI> for BkeyI {
+    fn as_ref(&self) -> &BkeyI {
+        self
+    }
+}
+
+impl AsMut<BkeyI> for BkeyI {
+    fn as_mut(&mut self) -> &mut BkeyI {
+        self
+    }
+}
+
+impl<V: ?Sized + InFamily<AllTypes> + BkeyVal<State: Implies<Validated>>> AsRef<BkeyI> for BkeyI<V> {
+    fn as_ref(&self) -> &BkeyI {
+        self.into()
+    }
+}
+
+impl<V: ?Sized + InFamily<AllTypes> + BkeyVal<State: Implies<Validated>>> AsMut<BkeyI> for BkeyI<V> {
+    fn as_mut(&mut self) -> &mut BkeyI {
+        self.into()
+    }
+}
+
+pub trait BkeyV: Sized {
+    type V: ?Sized + BkeyVal;
+
+    type As<W: ?Sized + BkeyVal + 'static>: BkeyV<V = W>;
+
+    fn as_sc(&self) -> BkeySC<'_, Self::V>;
+
+    fn k(&self) -> &c::bkey {
+        self.as_sc().k
+    }
+
+    fn v(&self) -> &Self::V
+        where Self::V: ArmRef
+    {
+        self.as_sc().v()
+    }
+
+    fn to_text<'f>(&self, fs: &'f crate::fs::Fs) -> super::BkeySCToText<'_, 'f, Self::V> {
+        super::BkeySCToText { k: self.as_sc(), fs }
+    }
+
+    fn typed(self) -> <Self::V as BkeyTyped>::Typed<Self>
+        where Self::V: BkeyTyped
+    {
+        <Self::V as BkeyTyped>::typed(self)
+    }
+
+    /// The same key, of any type, in the state it's in.
+    fn untyped(self) -> Self::As<Narrowed<FamilyVal<AllTypes>, Self::V>> {
+        // SAFETY: every key is of AllTypes
+        unsafe { self.arm_unchecked::<FamilyVal<AllTypes>>() }
+    }
+
+    fn arm<K: BkeyFamily + ?Sized>(self) -> Option<Self::As<Narrowed<K, Self::V>>> {
+        // SAFETY: a K, as K::contains() says; its length is validate's
+        K::contains(self.k()).then(|| unsafe { self.arm_unchecked::<K>() })
+    }
+
+    /// # Safety
+    /// The key is a @K, as K::contains() says, its length validate's.
+    unsafe fn arm_unchecked<K: BkeyFamily + ?Sized>(self) -> Self::As<Narrowed<K, Self::V>>;
+}
+
+pub trait BkeyVMut: BkeyV {
+    fn as_s(&mut self) -> BkeyS<'_, Self::V>;
+
+    fn val_bytes_mut(&mut self) -> &mut [u8] {
+        self.as_s().into_val_bytes_mut()
+    }
+
+    /// A field a grown type's older value lacks is a set() error.
+    fn v_mut(&mut self) -> &mut Self::V
+        where Self::V: ArmRef
+    {
+        let k = *self.k();
+        <Self::V as ArmRef>::arm_mut(self.val_bytes_mut())
+            .unwrap_or_else(|| panic!("{k}: {} bytes, shorter than validate passes", k.val_bytes()))
+    }
+}
+
+pub mod prelude {
+    pub use super::{BkeyV, BkeyVMut};
+    pub use crate::data::durability::BkeyVDurability;
+    pub use crate::data::extents::BkeyVExtents;
+    pub use crate::data::ptrs::BkeyVPtrs;
+}
+
+impl<'a, V: ?Sized + BkeyVal> BkeyV for BkeySC<'a, V> {
+    type V = V;
+    type As<W: ?Sized + BkeyVal + 'static> = BkeySC<'a, W>;
+
+    fn as_sc(&self) -> BkeySC<'_, V> {
+        // anew: a BkeySC is invariant in its lifetime
+        BkeySC { k: self.k, v: self.v, iter: PhantomData, val: PhantomData }
+    }
+
+    unsafe fn arm_unchecked<K: BkeyFamily + ?Sized>(self) -> BkeySC<'a, Narrowed<K, V>> {
+        self.cast()
+    }
+}
+
+impl<'a, V: ?Sized + BkeyVal> BkeyV for BkeyS<'a, V> {
+    type V = V;
+    type As<W: ?Sized + BkeyVal + 'static> = BkeyS<'a, W>;
+
+    fn as_sc(&self) -> BkeySC<'_, V> {
+        BkeySC::from(self)
+    }
+
+    unsafe fn arm_unchecked<K: BkeyFamily + ?Sized>(self) -> BkeyS<'a, Narrowed<K, V>> {
+        self.cast()
+    }
+}
+
+impl<V: ?Sized + BkeyVal> BkeyVMut for BkeyS<'_, V> {
+    fn as_s(&mut self) -> BkeyS<'_, V> {
+        BkeyS { k: &mut *self.k, v: self.v, val: PhantomData }
+    }
+}
+
+impl<'a, V: ?Sized + BkeyVal> BkeyV for &'a BkeyI<V> {
+    type V = V;
+    type As<W: ?Sized + BkeyVal + 'static> = &'a BkeyI<W>;
+
+    fn as_sc(&self) -> BkeySC<'_, V> {
+        BkeySC::from(&**self)
+    }
+
+    unsafe fn arm_unchecked<K: BkeyFamily + ?Sized>(self) -> &'a BkeyI<Narrowed<K, V>> {
+        &*cast_unsized(self.as_ffi())
+    }
+}
+
+impl<'a, V: ?Sized + BkeyVal> BkeyV for &'a mut BkeyI<V> {
+    type V = V;
+    type As<W: ?Sized + BkeyVal + 'static> = &'a mut BkeyI<W>;
+
+    fn as_sc(&self) -> BkeySC<'_, V> {
+        BkeySC::from(&**self)
+    }
+
+    unsafe fn arm_unchecked<K: BkeyFamily + ?Sized>(self) -> &'a mut BkeyI<Narrowed<K, V>> {
+        &mut *cast_unsized_mut(self.as_ffi_mut())
+    }
+}
+
+impl<V: ?Sized + BkeyVal> BkeyVMut for &mut BkeyI<V> {
+    fn as_s(&mut self) -> BkeyS<'_, V> {
+        BkeyS::from(&mut **self)
+    }
+}
+
+pub trait BkeyVal {
+    type State: KeyState;
+}
+
+impl<T: InState<State: KeyState> + ?Sized> BkeyVal for T {
+    type State = T::State;
+}
+
+/// A key's value in each state it can be in, as a key read in place has it,
+/// as long as k.u64s says: KeyState::Of picks one.
+pub trait BkeyFamily {
+    type Validated: ?Sized + Unsized + BkeyVal<State = Validated> + 'static;
+    type Unvalidated: ?Sized + Unsized + BkeyVal<State = Unvalidated> + 'static;
+
+    /// Its type, and anything else the set requires - an extent's size.
+    fn contains(k: &c::bkey) -> bool;
+}
+
+/// The state a key is in, as its value's is: what narrowing it keeps.
+pub trait KeyState: State {
+    /// @K's value in this state.
+    type Of<K: BkeyFamily + ?Sized>: ?Sized + Unsized + BkeyVal + 'static;
+}
+
+impl KeyState for Validated {
+    type Of<K: BkeyFamily + ?Sized> = K::Validated;
+}
+
+impl KeyState for Unvalidated {
+    type Of<K: BkeyFamily + ?Sized> = K::Unvalidated;
+}
+
+// XXX: a whole key narrows to its value in place - Validated - for now
+impl KeyState for Whole {
+    type Of<K: BkeyFamily + ?Sized> = K::Validated;
+}
+
+/// A key whose value is a @V narrowed to @K: K's value, in V's state.
+pub type Narrowed<K, V> = <<V as BkeyVal>::State as KeyState>::Of<K>;
+
+/// A key whose value is Self is one of family F's, by its type alone - what
+/// a key converts to a family's by, From: bkey_family_members!, and a family
+/// in a wider one.
+///
+/// # Safety
+/// Every key of Self's is a key of F's: F's contains() is true of it.
+pub unsafe trait InFamily<F> {}
+
+/// What a key in state Self is too: itself, and every weaker state - Whole
+/// a Validated key, and Validated an Unvalidated one. Never stronger:
+/// validating is the only way up.
+pub trait Implies<S: KeyState>: KeyState {}
+
+impl Implies<Whole> for Whole {}
+impl Implies<Validated> for Whole {}
+impl Implies<Unvalidated> for Whole {}
+impl Implies<Validated> for Validated {}
+impl Implies<Unvalidated> for Validated {}
+impl Implies<Unvalidated> for Unvalidated {}
+
+pub trait BkeyTag {
+    const TYPE: c::bch_bkey_type;
+
+    /// Up to BCH_BKEY_TYPES()' field: shorter than the struct is an older
+    /// version, shorter than this damage - bkey_val_size_too_small.
+    const MIN_VAL_SIZE: usize;
+}
+
+pub trait BkeyTyped: BkeyVal {
+    type Typed<K: BkeyV<V = Self>>;
+
+    fn typed<K: BkeyV<V = Self>>(k: K) -> Self::Typed<K>;
+}
+
+/// A plain type, or a grown type's struct - not a type with a tail.
+///
+/// # Safety
+/// Any bytes, all zeroes among them, are a valid Self in each of its fields -
+/// padding aside, which may hold anything: val_copy_pad() copies the key's
+/// bytes over a zeroed one.
+pub unsafe trait BkeyWhole: Sized + Default + BkeyTag + BkeyFamily<Validated: ArmRef>
+    + InFamily<AllTypes> + BkeyVal<State: Implies<Validated>>
+{
+    /// @k's value, if it's one, zero padded: it may predate fields Self has,
+    /// which a reference would read past its end for.
+    fn val_copy_pad(k: BkeySC<'_>) -> Option<Self> {
+        if !k.k.is::<Self>() {
+            return None;
+        }
+        let mut v = core::mem::MaybeUninit::<Self>::zeroed();
+        let n = k.k.val_bytes().min(size_of::<Self>());
+        // SAFETY: @n of a Self's bytes, into a zeroed one: BkeyWhole's
+        unsafe {
+            core::ptr::copy_nonoverlapping(k.v.cast::<u8>(), v.as_mut_ptr().cast::<u8>(), n);
+            Some(v.assume_init())
+        }
+    }
+}
+
+/// bkey_make_mut_noupdate() makes a TransBkey<Self::Mut>, grown to MIN_BYTES.
+///
+/// # Safety
+/// Mut is a BkeyWhole whose key is MIN_BYTES: TransBkey<Mut>'s value is over
+/// that many - or Self, MIN_BYTES 0, a value read as long as its key's u64s
+/// whose every valid value is one: a whole type's, a key family's.
+pub unsafe trait MutBkey: BkeyVal {
+    type Mut: ?Sized + BkeyVal;
+    const MIN_BYTES: usize;
+}
+
+// SAFETY: a BkeyWhole, its key whole
+unsafe impl<T: BkeyWhole + BkeyVal> MutBkey for T {
+    type Mut = Self;
+    const MIN_BYTES: usize = size_of::<BkeyI<Self>>();
+}
+
+/// A key value that's itself in place, all of it: #[derive(SizedVal)].
+///
+/// # Safety
+/// Any bytes are a valid Self.
+pub unsafe trait SizedVal: Sized + 'static {}
+
+// SAFETY: SizedVal's
+unsafe impl<T> BkeyWhole for T
+    where T: SizedVal + Default + BkeyTag + BkeyFamily<Validated: ArmRef> + InFamily<AllTypes>
+           + BkeyVal<State: Implies<Validated>>
+{}
+
+// A value is at the u64 after its key's header, so it's aligned.
+impl<T: SizedVal> ArmRef for T {
+    const MIN_LEN: usize = size_of::<Self>();
+
+    fn arm_ref(b: &[u8]) -> Option<&Self> {
+        (b.len() >= size_of::<Self>() && b.as_ptr() as usize % align_of::<Self>() == 0)
+            .then(|| unsafe { &*b.as_ptr().cast() })
+    }
+
+    fn arm_mut(b: &mut [u8]) -> Option<&mut Self> {
+        (b.len() >= size_of::<Self>() && b.as_ptr() as usize % align_of::<Self>() == 0)
+            .then(|| unsafe { &mut *b.as_mut_ptr().cast() })
+    }
+}
+
+unsafe impl<T: SizedVal> Floored for T {
+    type Min = Self;
+}
+
+// SAFETY: a reference from it claims size_of::<T>() of @bytes, the first -
+// which a valid value has, MIN_VAL_SIZE being all of it - not all of them
+unsafe impl<T: SizedVal> Unsized for T {
+    type Head = T;
+    type Elem = u8;
+    const TAIL: usize = size_of::<T>();
+
+    fn from_raw(p: *const u8, _bytes: usize) -> *const Self {
+        p.cast()
+    }
+
+    fn from_raw_mut(p: *mut u8, _bytes: usize) -> *mut Self {
+        p.cast()
+    }
+}
+
+// SAFETY: #[repr(transparent)] over T
+unsafe impl<T: SizedVal> SizedVal for UnvalidatedSized<T> {}
+
+impl<T: SizedVal> InState for UnvalidatedSized<T> {
+    type In<S: State> = S::OfSized<T>;
+    type State = Unvalidated;
+}
+
+impl<T: BkeyTag + InState> BkeyFamily for T
+    where T::In<Validated>: Unsized + BkeyVal<State = Validated> + 'static,
+          T::In<Unvalidated>: Unsized + BkeyVal<State = Unvalidated> + 'static,
+{
+    type Validated = T::In<Validated>;
+    type Unvalidated = T::In<Unvalidated>;
+
+    fn contains(k: &c::bkey) -> bool {
+        k.is::<T>()
+    }
+}
+
+/// The types of a key family, F in FamilyVal<F>: which keys are one.
+pub trait FamilyTypes: 'static {
+    fn contains(k: &c::bkey) -> bool;
+}
+
+/// A value of any of family F's types, as long as the key is, in state S -
+/// the state its key's value is in, which narrowing it keeps.
+#[repr(transparent)]
+pub struct FamilyVal<F, S: State = Validated>(PhantomData<(F, S)>, [u64]);
+
+/// Every key type, and those this code doesn't know: FamilyVal<AllTypes> is a
+/// key of any type's value.
+pub enum AllTypes {}
+
+impl FamilyTypes for AllTypes {
+    fn contains(_k: &c::bkey) -> bool {
+        true
+    }
+}
+
+// SAFETY: the value's u64s, all of them
+unsafe impl<F: 'static, S: State> Unsized for FamilyVal<F, S> {
+    type Head = ();
+    type Elem = u64;
+    const TAIL: usize = 0;
+
+    fn from_raw(p: *const u8, bytes: usize) -> *const Self {
+        core::ptr::slice_from_raw_parts(p.cast::<u64>(), bytes / size_of::<u64>()) as *const Self
+    }
+
+    fn from_raw_mut(p: *mut u8, bytes: usize) -> *mut Self {
+        core::ptr::slice_from_raw_parts_mut(p.cast::<u64>(), bytes / size_of::<u64>()) as *mut Self
+    }
+}
+
+impl<F: 'static, S: KeyState> BkeyVal for FamilyVal<F, S> {
+    type State = S;
+}
+
+// SAFETY: any key of the family, as long as it is
+unsafe impl<F: 'static, S: KeyState> MutBkey for FamilyVal<F, S> {
+    type Mut = Self;
+    const MIN_BYTES: usize = 0;
+}
+
+impl<F: FamilyTypes, S: KeyState> BkeyFamily for FamilyVal<F, S> {
+    type Validated = FamilyVal<F, Validated>;
+    type Unvalidated = FamilyVal<F, Unvalidated>;
+
+    fn contains(k: &c::bkey) -> bool {
+        F::contains(k)
+    }
+}
+
+/// # Safety
+/// @k is a key whose value is a @V, its length validate's.
+pub(crate) unsafe fn cast_unsized<V: Unsized + ?Sized>(k: *const c::bkey_i) -> *const BkeyI<V> {
+    unsafe {
+        let v = V::from_raw(k.cast::<u8>().add(size_of::<c::bkey>()), (*k).k.val_bytes());
+        v.byte_sub(size_of::<c::bkey>()) as *const BkeyI<V>
+    }
+}
+
+pub(crate) unsafe fn cast_unsized_mut<V: Unsized + ?Sized>(k: *mut c::bkey_i) -> *mut BkeyI<V> {
+    unsafe {
+        let v = V::from_raw_mut(k.cast::<u8>().add(size_of::<c::bkey>()), (*k).k.val_bytes());
+        v.byte_sub(size_of::<c::bkey>()) as *mut BkeyI<V>
+    }
+}
+
+/// `bkey_typed! { Enum for F [, unknown]; rows }`: typed() of a
+/// FamilyVal<F, S> key, in any state S, its arms in S. `unknown`, an arm for
+/// a type this code doesn't know - else there's none.
+macro_rules! bkey_typed {
+    ($(#[$meta:meta])* $enum:ident for $f:ty $(, $unknown:ident)?;
+     $(($name:ident, $nr:literal, $($rest:tt)*)),* $(,)?) => { crate::paste! {
+        $(#[$meta])*
+        #[allow(non_camel_case_types)]
+        pub enum $enum<K: crate::btree::bkey::BkeyV> {
+            $($name(K::As<crate::btree::bkey::Narrowed<crate::c::[<$name:camel>], K::V>>),)*
+            $(
+            $unknown(K),
+            )?
+        }
+
+        // Copy as a BkeySC is: a derive would require only K: Copy, not its arms
+        impl<'a, S: crate::btree::bkey::KeyState> Clone
+            for $enum<crate::btree::bkey::BkeySC<'a, crate::btree::bkey::FamilyVal<$f, S>>>
+        {
+            fn clone(&self) -> Self {
+                *self
+            }
+        }
+        impl<'a, S: crate::btree::bkey::KeyState> Copy
+            for $enum<crate::btree::bkey::BkeySC<'a, crate::btree::bkey::FamilyVal<$f, S>>> {}
+
+        impl<S: crate::btree::bkey::KeyState> crate::btree::bkey::BkeyTyped
+            for crate::btree::bkey::FamilyVal<$f, S>
+        {
+            type Typed<K: crate::btree::bkey::BkeyV<V = Self>> = $enum<K>;
+
+            fn typed<K: crate::btree::bkey::BkeyV<V = Self>>(k: K) -> $enum<K> {
+                match k.k().type_ as u32 {
+                    $($nr => $enum::$name(unsafe { k.arm_unchecked::<crate::c::[<$name:camel>]>() }),)*
+                    t => crate::btree::bkey::bkey_typed!(@other $enum, $f, k, t $(, $unknown)?),
+                }
+            }
+        }
+    } };
+    (@other $enum:ident, $f:ty, $k:ident, $t:ident, $unknown:ident) => {{ let _ = $t; $enum::$unknown($k) }};
+    (@other $enum:ident, $f:ty, $k:ident, $t:ident) => {
+        unreachable!(concat!("a ", stringify!($f), " key of type {}"), $t)
+    };
+}
+pub(crate) use bkey_typed;
+
+/// `bkey_family!(Ptrs)`: a key family, defined where it's used - the rows its
+/// BCH_BKEY_TYPES() flag picks, and what a key of it requires past its type.
+/// Each family is an arm here.
+macro_rules! bkey_family {
+    (Ptrs) => {
+        crate::c::BCH_BKEY_TYPES!(cstruct_macros::xmacro_select [BKEY_TYPE_ptrs =>
+            crate::btree::bkey::bkey_family { @def
+                /// Any of the key types with pointers, BKEY_TYPE_ptrs: a key armed
+                /// to it - BkeySC<'_, Ptrs>, BkeyS<'_, Ptrs>, &BkeyI<Ptrs> - has
+                /// its value read through typed().
+                Ptrs, |k| true;
+            }]);
+        crate::c::BCH_BKEY_TYPES!(cstruct_macros::xmacro_select [BKEY_TYPE_ptrs =>
+            crate::btree::bkey::bkey_family_members { crate::data::ptrs::PtrsTypes; }]);
+    };
+    (PtrsMut) => {
+        crate::c::BCH_BKEY_TYPES!(cstruct_macros::xmacro_select [BKEY_TYPE_ptrs_mut =>
+            crate::btree::bkey::bkey_family { @def
+                /// The key types with pointers that can be edited in place,
+                /// BKEY_TYPE_ptrs_mut: their extent entries run to the value's
+                /// end, so entries can be inserted and dropped - every Ptrs type
+                /// but a stripe.
+                PtrsMut, |k| true;
+            }]);
+        crate::c::BCH_BKEY_TYPES!(cstruct_macros::xmacro_select [BKEY_TYPE_ptrs_mut =>
+            crate::btree::bkey::bkey_family_members { crate::data::ptrs::PtrsMutTypes; }]);
+    };
+    (BtreePtrs) => {
+        crate::c::BCH_BKEY_TYPES!(cstruct_macros::xmacro_select [BKEY_TYPE_btree_ptr =>
+            crate::btree::bkey::bkey_family { @def
+                /// A btree node pointer, BKEY_TYPE_btree_ptr - a key above the
+                /// leaves, or a btree root's: a key armed to it is a
+                /// BkeySC<'_, BtreePtrs>, BkeyS<'_, BtreePtrs>, &BkeyI<BtreePtrs>.
+                BtreePtrs, |k| true;
+            }]);
+        crate::c::BCH_BKEY_TYPES!(cstruct_macros::xmacro_select [BKEY_TYPE_btree_ptr =>
+            crate::btree::bkey::bkey_family_members { crate::data::ptrs::BtreePtrsTypes; }]);
+    };
+    (Extents) => {
+        crate::c::BCH_BKEY_TYPES!(cstruct_macros::xmacro_select [BKEY_TYPE_extent =>
+            crate::btree::bkey::bkey_family { @def
+                /// Any key an extents btree may hold, its size nonzero - a range of
+                /// its btree, start_pos() to k.p: a key armed to it is a
+                /// BkeySC<'_, Extents>, BkeyS<'_, Extents>, &BkeyI<Extents>. A
+                /// key is one by its size as well as its type: a deletion slot
+                /// iteration makes is one or not by the iterator's mode.
+                Extents, |k| k.size != 0;
+            }]);
+    };
+    (Indirect) => {
+        crate::c::BCH_BKEY_TYPES!(cstruct_macros::xmacro_select [BKEY_TYPE_indirect =>
+            crate::btree::bkey::bkey_family { @def
+                /// An indirect extent, BKEY_TYPE_indirect - refcounted, in the
+                /// reflink btree, what a reflink_p points to: a key armed to it
+                /// is a BkeySC<'_, Indirect>, BkeyS<'_, Indirect>, &BkeyI<Indirect>.
+                Indirect, |k| true;
+            }]);
+        crate::c::BCH_BKEY_TYPES!(cstruct_macros::xmacro_select [BKEY_TYPE_indirect =>
+            crate::btree::bkey::bkey_family_members { crate::data::reflink::IndirectTypes; }]);
+    };
+
+    (@def $(#[$meta:meta])* $family:ident, |$k:ident| $contains:expr;
+     $(($name:ident, $nr:literal, $($rest:tt)*)),* $(,)?) => { crate::paste! {
+        $(#[$meta])*
+        pub type $family = crate::btree::bkey::FamilyVal<[<$family Types>]>;
+
+        pub enum [<$family Types>] {}
+
+        impl crate::btree::bkey::FamilyTypes for [<$family Types>] {
+            fn contains($k: &crate::c::bkey) -> bool {
+                matches!($k.type_ as u32, $($nr)|*) && $contains
+            }
+        }
+
+        crate::btree::bkey::bkey_typed! {
+            [<$family Typed>] for [<$family Types>];
+            $(($name, $nr, $($rest)*)),*
+        }
+
+        // SAFETY: every key is one of AllTypes'
+        unsafe impl<S: crate::btree::bkey::KeyState>
+            crate::btree::bkey::InFamily<crate::btree::bkey::AllTypes>
+            for crate::btree::bkey::FamilyVal<[<$family Types>], S> {}
+    } };
+}
+pub(crate) use bkey_family;
+
+/// `bkey_family_members!(F; rows)`: the rows' types' keys are F's, by type -
+/// InFamily, each of their values in place. Only for a family whose keys are
+/// one by type alone: not Extents.
+macro_rules! bkey_family_members {
+    ($f:ty; $(($name:ident, $nr:literal, $($rest:tt)*)),* $(,)?) => { crate::paste! { $(
+        // SAFETY: a key whose value is one is of the type, which @f has
+        unsafe impl crate::btree::bkey::InFamily<$f>
+            for <crate::c::[<$name:camel>] as crate::btree::bkey::BkeyFamily>::Validated {}
+        unsafe impl crate::btree::bkey::InFamily<$f>
+            for <crate::c::[<$name:camel>] as crate::btree::bkey::BkeyFamily>::Unvalidated {}
+    )* } };
+}
+pub(crate) use bkey_family_members;
+
+/// `bkey_family_conv!(F)`: a key of F's - InFamily - becomes FamilyVal<F, S>
+/// by From, in any state its own implies, in its form or any it converts to:
+/// one impl for each, the axes in its bounds, so one into() does all three.
+/// The forms don't convert back: BkeyI -> BkeyS -> BkeySC.
+macro_rules! bkey_family_conv {
+    ($f:ty) => {
+        bkey_family_conv!(@forms $f;
+            ['a]      [BkeySC<'a,]               => [BkeySC<'a,]:   |k| k.cast();
+            ['a]      [BkeyS<'a,]                => [BkeyS<'a,]:    |k| k.cast();
+            ['a]      [&'a BkeyI<]               => [&'a BkeyI<]:   |k| &*cast_unsized(k.as_ffi());
+            ['a]      [&'a mut BkeyI<]           => [&'a mut BkeyI<]:
+                |k| &mut *cast_unsized_mut(k.as_ffi_mut());
+            ['a, 't]  [TransBkey<'a, 't,]        => [TransBkey<'a, 't,]: |k| k.cast();
+            ['a]      [&'a BkeyI<]               => [BkeySC<'a,]:   |k| BkeySC::<V>::from(k).cast();
+            ['a, 'b]  [&'a BkeyS<'b,]            => [BkeySC<'a,]:   |k| BkeySC::<V>::from(k).cast();
+            ['a]      [&'a mut BkeyI<]           => [BkeyS<'a,]:    |k| BkeyS::<V>::from(k).cast();
+            ['a]      [&'a TransBkey<'_, '_,]    => [BkeySC<'a,]:   |k| BkeySC::<V>::from(k).cast();
+            ['a]      [&'a mut TransBkey<'_, '_,] => [BkeyS<'a,]:   |k| BkeyS::<V>::from(k).cast();
+            ['a]      [&'a TransBkey<'_, '_,]    => [&'a BkeyI<]:   |k| &*cast_unsized(k.as_ptr());
+            ['a]      [&'a mut TransBkey<'_, '_,] => [&'a mut BkeyI<]:
+                |k| &mut *cast_unsized_mut(k.as_ptr()););
+    };
+
+    // each form, up to its V: Form<.., V>
+    (@forms $f:ty; $([$($g:tt)*] [$($src:tt)*] => [$($dst:tt)*]: |$k:ident| $body:expr;)*) => {$(
+        impl<$($g)*, V, S> From<$($src)* V>> for $($dst)* FamilyVal<$f, S>>
+            where V: ?Sized + InFamily<$f> + BkeyVal<State: Implies<S>>, S: KeyState
+        {
+            #[allow(unused_unsafe)]
+            fn from($k: $($src)* V>) -> Self {
+                // SAFETY: a key of @f's, by InFamily, in a state its own implies
+                unsafe { $body }
+            }
+        }
+    )*};
+}
+
+/// A key type's impls from its BCH_BKEY_TYPES() row; what's per kind is at
+/// its value's definition - #[whole(bkey)], #[grown(.., bkey)],
+/// #[derive(SizedVal)].
+macro_rules! bkey_val {
+    // Its field column says gens, but every valid one is whole:
+    // bch2_bucket_gens_validate() takes no other length
+    (bucket_gens, $f:tt)          => { bkey_val!(@key bucket_gens, _); };
+
+    ($name:ident, $field:tt)      => { bkey_val!(@key $name, $field); };
+
+    // the shortest valid value: its value in place's head - a family's C
+    // struct or a grown type's floor, a sized type all of it
+    (@key $name:ident, $field:tt) => { crate::paste! {
+        impl BkeyTag for c::[<$name:camel>] {
+            const TYPE: c::bch_bkey_type = c::bch_bkey_type::[<KEY_TYPE_ $name>];
+            const MIN_VAL_SIZE: usize =
+                size_of::<<<Self as BkeyFamily>::Validated as Unsized>::Head>();
+        }
+
+        const _: () = assert!(<c::[<$name:camel>] as BkeyTag>::MIN_VAL_SIZE ==
+                              bkey_val!(@min_repr c::[<$name:camel>], $field),
+                              concat!("bch_", stringify!($name), ": its head isn't the \
+                                       minimum BCH_BKEY_TYPES() names"));
+    } };
+
+    // as C's bch2_bkey_min_val_sizes[]
+    (@min_repr $val:ty, _)            => { size_of::<$val>() };
+    (@min_repr $val:ty, $field:ident) => { core::mem::offset_of!($val, repr.$field) };
+}
+
+macro_rules! bkey_types {
+    ($(($name:ident, $nr:literal, $flags:expr, $field:tt $(, $($rest:tt)*)?)),* $(,)?) => {
+        $(
+        bkey_val!($name, $field);
+        )*
+
+        bkey_typed! {
+            Typed for AllTypes, unknown;
+            $(($name, $nr, $flags, $field $(, $($rest)*)?)),*
+        }
+
+        bkey_family_members! {
+            AllTypes;
+            $(($name, $nr, $flags, $field $(, $($rest)*)?)),*
+        }
+    };
+}
+
+c::BCH_BKEY_TYPES!(bkey_types);
+
+bkey_family_conv!(AllTypes);
+bkey_family_conv!(crate::data::ptrs::PtrsTypes);
+bkey_family_conv!(crate::data::ptrs::PtrsMutTypes);
+bkey_family_conv!(crate::data::reflink::IndirectTypes);
diff --git a/fs/bcachefs/btree/bkey_buf.h b/fs/bcachefs/btree/bkey_buf.h
new file mode 100644
index 0000000..8cde116
--- /dev/null
+++ b/fs/bcachefs/btree/bkey_buf.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_BKEY_BUF_H
+#define _BCACHEFS_BKEY_BUF_H
+
+#include <linux/mempool.h>
+
+#include "bcachefs.h"
+#include "btree/bkey.h"
+
+#include "btree/bkey_buf_gen.h"
+
+static inline int bch2_bkey_buf_realloc_noprof(struct bkey_buf *s, unsigned u64s)
+{
+	if (s->k == (void *) s->onstack &&
+	    u64s > ARRAY_SIZE(s->onstack)) {
+		s->k = kmalloc_noprof(2048, GFP_KERNEL|__GFP_NOFAIL);
+		memcpy(s->k, s->onstack, sizeof(s->onstack));
+	}
+
+	return 0; /* for alloc_hooks() macro */
+}
+#define bch2_bkey_buf_realloc(...)	alloc_hooks(bch2_bkey_buf_realloc_noprof(__VA_ARGS__))
+
+static inline int bch2_bkey_buf_reassemble_noprof(struct bkey_buf *s, struct bkey_s_c k)
+{
+	bch2_bkey_buf_realloc_noprof(s, k.k->u64s);
+	bkey_reassemble(s->k, k);
+	return 0;
+}
+#define bch2_bkey_buf_reassemble(...)	alloc_hooks(bch2_bkey_buf_reassemble_noprof(__VA_ARGS__))
+
+static inline int bch2_bkey_buf_copy_noprof(struct bkey_buf *s, struct bkey_i *src)
+{
+	bch2_bkey_buf_realloc_noprof(s, src->k.u64s);
+	bkey_copy(s->k, src);
+	return 0;
+}
+#define bch2_bkey_buf_copy(...)	alloc_hooks(bch2_bkey_buf_copy_noprof(__VA_ARGS__))
+
+static inline int bch2_bkey_buf_unpack_noprof(struct bkey_buf *s,
+					      struct btree *b,
+					      struct bkey_packed *src)
+{
+	bch2_bkey_buf_realloc_noprof(s, BKEY_U64s + bkeyp_val_u64s(&b->format, src));
+	bch2_bkey_unpack(b, s->k, src);
+	return 0;
+}
+#define bch2_bkey_buf_unpack(...)	alloc_hooks(bch2_bkey_buf_unpack_noprof(__VA_ARGS__))
+
+static inline void bch2_bkey_buf_init(struct bkey_buf *s)
+{
+	s->k = (void *) s->onstack;
+	bkey_init(&s->k->k);
+}
+
+static inline void bch2_bkey_buf_exit(struct bkey_buf *s)
+{
+	if (s->k != (void *) s->onstack)
+		kfree(s->k);
+	s->k = NULL;
+}
+
+#endif /* _BCACHEFS_BKEY_BUF_H */
diff --git a/fs/bcachefs/btree/bkey_buf.rs b/fs/bcachefs/btree/bkey_buf.rs
new file mode 100644
index 0000000..b50e931
--- /dev/null
+++ b/fs/bcachefs/btree/bkey_buf.rs
@@ -0,0 +1,187 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! An owned copy of a key, as C's struct bkey_buf: a small key is kept in the
+//! struct, a bigger one in a heap buffer with room for any key.
+//!
+//! The C version points bkey_buf.k at whichever buffer is in use - into
+//! itself, while the key is small - so it can't be moved. Here the buffer in
+//! use is decided on each access, and a BkeyBuf moves like any other value.
+//!
+//! As in C, copying a key in can't fail: the heap buffer is allocated
+//! __GFP_NOFAIL, through rust_kzalloc_nofail() - the kernel's Rust allocator
+//! API doesn't offer it. Zeroed, so the whole buffer is initialized memory.
+
+use crate::btree::bkey::{BkeyI, BkeySC, BKEY_U64S};
+use crate::c;
+use core::mem::size_of;
+use core::ptr::NonNull;
+use core::slice;
+
+const ONSTACK_U64S: usize = 12;
+
+/// A key's u64s, a u8, counts its header: room for 256 holds any key - as
+/// C's kmalloc(2048).
+const HEAP_U64S: usize = 256;
+
+pub struct BkeyBuf {
+    onstack: [u64; ONSTACK_U64S],
+    heap:    Option<NonNull<u64>>,
+}
+
+impl BkeyBuf {
+    /// Holding a deleted key, as bch2_bkey_buf_init() leaves it.
+    pub fn new() -> Self {
+        let mut b = BkeyBuf { onstack: [0; ONSTACK_U64S], heap: None };
+        b.as_mut().k = c::bkey::new();
+        b
+    }
+
+    fn buf(&self) -> &[u64] {
+        match self.heap {
+            Some(p) => unsafe { slice::from_raw_parts(p.as_ptr(), HEAP_U64S) },
+            None    => &self.onstack,
+        }
+    }
+
+    fn buf_mut(&mut self) -> &mut [u64] {
+        match self.heap {
+            Some(p) => unsafe { slice::from_raw_parts_mut(p.as_ptr(), HEAP_U64S) },
+            None    => &mut self.onstack,
+        }
+    }
+
+    /// Make room for a key of @u64s, as bch2_bkey_buf_realloc(): once on the
+    /// heap, a key stays there.
+    fn realloc(&mut self, u64s: usize) {
+        if self.heap.is_some() || u64s <= ONSTACK_U64S {
+            return;
+        }
+
+        let p = unsafe { c::rust_kzalloc_nofail(HEAP_U64S * size_of::<u64>()) } as *mut u64;
+        let p = NonNull::new(p).expect("__GFP_NOFAIL allocation returned NULL");
+
+        unsafe { core::ptr::copy_nonoverlapping(self.onstack.as_ptr(), p.as_ptr(), ONSTACK_U64S) };
+        self.heap = Some(p);
+    }
+
+    /// A copy of @k.
+    pub fn from_key(k: BkeySC<'_>) -> Self {
+        let mut b = Self::new();
+        b.reassemble(k);
+        b
+    }
+
+    /// Copy @k in, as bch2_bkey_buf_reassemble().
+    pub fn reassemble(&mut self, k: BkeySC<'_>) {
+        self.realloc(k.k.u64s as usize);
+        // SAFETY: realloc()'s room
+        unsafe { copy_key(self.buf_mut().as_mut_ptr(), k) }
+    }
+}
+
+/// Copies @k, header and value, to @dst.
+///
+/// # Safety
+/// @dst has room for @k's u64s.
+unsafe fn copy_key(dst: *mut u64, k: BkeySC<'_>) {
+    let u64s = k.k.u64s as usize;
+    // SAFETY: the caller's; a key's header and value are whole u64s
+    unsafe {
+        core::ptr::copy_nonoverlapping(core::ptr::from_ref(k.k).cast::<u64>(), dst, BKEY_U64S);
+        core::ptr::copy_nonoverlapping(k.v.cast::<u64>(), dst.add(BKEY_U64S),
+                                       u64s - BKEY_U64S);
+    }
+}
+
+impl<'a> From<&'a BkeyBuf> for BkeySC<'a> {
+    fn from(b: &'a BkeyBuf) -> Self {
+        BkeySC::from(b.as_ref())
+    }
+}
+
+/// The key, all of it, as long as its u64s say.
+impl AsRef<BkeyI> for BkeyBuf {
+    fn as_ref(&self) -> &BkeyI {
+        // SAFETY: a key at the start of the buffer, as reassemble() sizes it
+        unsafe { &*BkeyI::from_raw(self.buf().as_ptr().cast()) }
+    }
+}
+
+impl AsMut<BkeyI> for BkeyBuf {
+    fn as_mut(&mut self) -> &mut BkeyI {
+        // SAFETY: as as_ref()'s
+        unsafe { &mut *BkeyI::from_raw_mut(self.buf_mut().as_mut_ptr().cast()) }
+    }
+}
+
+/// C's bkey_buf: @k points into @onstack while the key is small, so once
+/// init()ed it can't move. Used for a data update's key, which C reads.
+impl c::bkey_buf {
+    pub fn key(&self) -> &BkeyI {
+        // SAFETY: as C keeps it, for as long as it's borrowed
+        unsafe { &*BkeyI::from_raw(self.k) }
+    }
+
+    fn onstack_ptr(&mut self) -> *mut c::bkey_i {
+        self.onstack.as_mut_ptr().cast()
+    }
+
+    /// # Safety
+    /// It isn't moved while it's in use: @k may point into it.
+    pub unsafe fn init(&mut self) {
+        self.k = self.onstack_ptr();
+        // SAFETY: @onstack, which has room for a header
+        unsafe { (*self.k).k = c::bkey::new() };
+    }
+
+    /// Copies @k in. A key too big for @onstack moves the buffer to the heap
+    /// (__GFP_NOFAIL), where it stays.
+    pub fn reassemble(&mut self, k: BkeySC<'_>) {
+        const { assert!(size_of::<[u64; ONSTACK_U64S]>() == size_of::<c::bkey_buf>() - size_of::<*mut c::bkey_i>()) };
+
+        if self.k == self.onstack_ptr() && k.k.u64s as usize > ONSTACK_U64S {
+            let p = unsafe { c::rust_kzalloc_nofail(HEAP_U64S * size_of::<u64>()) }.cast::<u64>();
+            assert!(!p.is_null(), "__GFP_NOFAIL allocation returned NULL");
+            // SAFETY: a fresh buffer, room for any key
+            unsafe { core::ptr::copy_nonoverlapping(self.onstack.as_ptr(), p, ONSTACK_U64S) };
+            self.k = p.cast();
+        }
+        // SAFETY: init()'s @k, which is @onstack with room for @k, or the
+        // heap buffer, with room for any key
+        unsafe { copy_key(self.k.cast(), k) }
+    }
+
+    pub fn exit(&mut self) {
+        if !self.k.is_null() && self.k != self.onstack_ptr() {
+            // SAFETY: reassemble()'s
+            unsafe { c::rust_kfree(self.k.cast()) };
+        }
+        self.k = core::ptr::null_mut();
+    }
+
+    /// exit(), for a key RCU readers may still be reading: the heap buffer is
+    /// freed a grace period later, and @k is left pointing at it - so this must
+    /// be the last thing done with the bkey_buf, and its memory freed no
+    /// sooner.
+    /// May sleep.
+    pub fn exit_rcu(&mut self) {
+        if !self.k.is_null() && self.k != self.onstack_ptr() {
+            // SAFETY: reassemble()'s, kmalloc()'d
+            unsafe { c::rust_kfree_rcu_mightsleep(self.k.cast()) };
+        }
+    }
+}
+
+impl Default for BkeyBuf {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl Drop for BkeyBuf {
+    fn drop(&mut self) {
+        if let Some(p) = self.heap {
+            unsafe { c::rust_kfree(p.as_ptr() as *const core::ffi::c_void) };
+        }
+    }
+}
