+// SPDX-License-Identifier: GPL-2.0
+
+//! A mount, as a file opened through it has it: write access to it. (Its
+//! idmap is idmap.rs's.)
+
+use crate::c;
+use crate::errcode::{ret_to_result_void, BchError};
+use crate::util::file::File;
+
+/// Write access to a file's mount for as long as this lives: the mount can't
+/// go read-only meanwhile.
+pub(crate) struct WriteAccess<'a>(&'a File);
+
+impl<'a> WriteAccess<'a> {
+    pub(crate) fn get(file: &'a File) -> Result<Self, BchError> {
+        ret_to_result_void(unsafe { c::mnt_want_write_file(file.as_ptr()) })?;
+        Ok(WriteAccess(file))
+    }
+}
+
+impl Drop for WriteAccess<'_> {
+    fn drop(&mut self) {
+        unsafe { c::mnt_drop_write_file(self.0.as_ptr()) }
+    }
+}
diff --git a/fs/bcachefs/vfs/namei.rs b/fs/bcachefs/vfs/namei.rs
new file mode 100644
index 0000000..5a03dad
--- /dev/null
+++ b/fs/bcachefs/vfs/namei.rs
@@ -0,0 +1,391 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! The namespace operations as the VFS makes them: each takes the update
+//! locks of the inodes it changes, runs its transaction - fs/namei.rs's - and
+//! brings the VFS inodes up to date with what it wrote - and gives the dentry
+//! a link or create made its inode. They're a directory's inode ops, DirOps's
+//! InodeOps (inode_ops.rs), and InodeInfo's where something else calls them.
+//! Making the new inode is still fs.c's __bch2_create(), with the inode
+//! cache.
+//!
+//! Lookup writes nothing, unless a dirent and its inode disagree, which it
+//! repairs. The inodes it returns come from the inode cache, which is still
+//! fs.c's.
+
+use core::ffi::{c_int, c_uint, CStr};
+
+use crate::btree::bkey::BkeyV;
+use crate::btree::iter::{commit_do, lockrestart_do, BtreeIter, BtreeIterFlags, CommitFlags, CommitOpts,
+                         TransAttempt};
+use crate::c;
+use crate::dirent::{self, Dirent};
+use crate::errcode::{bch_errcode, ret_to_c, ret_to_result_void, BchError};
+use crate::init::passes;
+use crate::inode;
+use crate::namei;
+use crate::quota;
+use crate::snapshots::subvolume;
+use crate::str_hash;
+use crate::util::kernel::{current_fsgid, current_fsuid};
+use crate::util::log::LogMsg;
+use crate::util::file::File;
+use crate::util::os_str::OsStr;
+use cstruct_macros::{c_export, c_extern, vtable};
+use kernel::sync::aref::ARef;
+
+use super::dentry::Dentry;
+use super::idmap::MntIdmap;
+use super::inode::{InodeInfo, InodeRef, ATTR_CTIME, ATTR_MTIME, ATTR_SIZE};
+use super::inode_ops::InodeOps;
+
+c_extern! {
+    // fs.c's, until the inode cache is Rust:
+    fn __bch2_create(idmap: *mut c::mnt_idmap, dir: *mut c::bch_inode_info, dentry: *mut c::dentry,
+                     mode: c::umode_t, rdev: c::dev_t, snapshot_src: c::subvol_inum,
+                     flags: c_uint) -> *mut c::bch_inode_info;
+}
+
+const DIR_ENTRIES_CHANGED: u32 = ATTR_MTIME | ATTR_CTIME | ATTR_SIZE;
+
+impl InodeInfo {
+    /// A new inode in this directory for @dentry, in the btree and the inode
+    /// cache - linked, unless @flags has BCH_CREATE_TMPFILE; a subvolume's
+    /// root, a snapshot of @snapshot_src's subvolume, with BCH_CREATE_SUBVOL
+    /// and BCH_CREATE_SNAPSHOT. The reference is ours, not yet the dentry's.
+    pub(crate) fn create(&self, idmap: MntIdmap<'_>, dentry: Dentry<'_>, mode: c::umode_t,
+                         rdev: c::dev_t, snapshot_src: c::subvol_inum, flags: u32)
+        -> Result<InodeRef, BchError>
+    {
+        unsafe {
+            InodeInfo::from_c(__bch2_create(idmap.as_ptr(), self.raw(), dentry.as_ptr(), mode, rdev,
+                                            snapshot_src, flags))
+        }
+    }
+
+    /// The inode @name in this directory names, through the inode cache - @hash
+    /// is this directory's. ENOENT if there's no such name, or it's a subvolume
+    /// this directory doesn't list.
+    pub fn lookup(&self, hash: &c::bch_hash_info, name: &OsStr) -> Result<InodeRef, BchError> {
+        let dir = self.inum();
+        let trans = crate::btree_trans!(self.fs());
+
+        lockrestart_do(&trans, |t| {
+            let mut iter = BtreeIter::uninit();
+            let k = dirent::lookup_key(t, &mut iter, dir, hash, name, BtreeIterFlags::empty())?;
+            let inum = dirent::lookup_target(t, dir, k)?;
+
+            if let Some(inode) = InodeInfo::cache_find(t, inum)? {
+                return Ok(inode);
+            }
+
+            // Peeked again for the iterator and the dirent together, as
+            // check_dirent_target() takes them
+            let (iter, k) = iter.peek_slot_with(t)?.expect("the dirent lookup_key() found");
+            let d = Dirent::new(k).expect("a dirent");
+
+            // check_dirent_target()'s repairs are committed before the insert,
+            // past which no restart can be taken
+            let mut subvol = c::Subvolume::default();
+            let ret = (|| {
+                subvol = subvolume::get(t, inum.subvol as u32, true)?;
+                let mut bi = inode::find_by_inum_snapshot(t, inum.inum, subvol.snapshot.get(),
+                                                          BtreeIterFlags::CACHED)?;
+                namei::check_dirent_target(t, iter, d, &mut bi, false)?;
+                t.commit(None, CommitFlags::NO_ENOSPC)?;
+                InodeInfo::cache_insert(t, inum, &mut bi, &mut subvol)
+            })();
+
+            match ret {
+                // The dirent stays: check_inodes may find an inode that points
+                // back to it
+                Err(e) if e.matches(c::ENOENT) => {
+                    dirent_to_missing_inode(t, d, dir, inum, subvol.snapshot.get(), &e)?;
+                    Err(e)
+                }
+                ret => ret,
+            }
+        })
+    }
+
+    /// Only this inode's update lock, as C took: the directory's VFS inode is
+    /// updated under its btree position's lock, which serializes that.
+    pub fn link(&self, dir: &InodeInfo, name: &OsStr) -> Result<(), BchError> {
+        let _lock = self.update_lock();
+        let trans = crate::btree_trans!(self.fs());
+        let [mut dir_u, mut inode_u] = [c::bch_inode_unpacked::default(); 2];
+
+        commit_do(&trans, None, CommitOpts::new(), |t| {
+            dir.fold_times_trans(t)?;
+            self.fold_times_trans(t)?;
+            namei::link_trans(t, dir.inum(), &mut dir_u, self.inum(), &mut inode_u, name)
+        })?;
+
+        dir.update_after_write(&trans, &dir_u, DIR_ENTRIES_CHANGED);
+        self.update_after_write(&trans, &inode_u, ATTR_CTIME);
+        Ok(())
+    }
+
+    /// @deleting_subvol: @dentry is a subvolume's root, the subvolume going.
+    pub fn unlink(&self, dentry: Dentry<'_>, deleting_subvol: bool) -> Result<(), BchError> {
+        let inode = dentry.inode();
+        {
+            let _locks = InodeInfo::update_lock_all([self, inode]);
+            let trans = crate::btree_trans!(self.fs());
+            let [mut dir_u, mut inode_u] = [c::bch_inode_unpacked::default(); 2];
+
+            commit_do(&trans, None, CommitFlags::NO_ENOSPC, |t| {
+                self.fold_times_trans(t)?;
+                inode.fold_times_trans(t)?;
+                namei::unlink_trans(t, self.inum(), &mut dir_u, inode.inum(), &mut inode_u,
+                                    dentry.name(), deleting_subvol)
+            })?;
+
+            self.update_after_write(&trans, &dir_u, DIR_ENTRIES_CHANGED);
+            inode.update_after_write(&trans, &inode_u, ATTR_CTIME);
+        }
+
+        /*
+         * d_invalidate() waits for other threads killing child dentries, and
+         * evicting a deleted child takes btree locks: called with none of ours
+         * held, as vfs_rmdir() does shrink_dcache_parent()
+         */
+        if self.vfs().flag(c::S_CASEFOLD) {
+            dentry.invalidate();
+        }
+        Ok(())
+    }
+}
+
+pub(crate) struct DirOps;
+
+#[vtable]
+impl InodeOps for DirOps {
+    /// Any error is a negative dentry, as C had it.
+    fn lookup(dir: &InodeInfo, dentry: Dentry<'_>, _flags: c_uint) -> *mut c::dentry {
+        let fs = dir.fs();
+
+        let Ok(hash) = crate::bch_err_fn!(fs, str_hash::hash_info_init(fs, &dir.inode())) else {
+            return dentry.splice_alias(None);
+        };
+        let inode = dir.lookup(&hash, dentry.name()).ok();
+
+        // No negative dentries in a casefolded directory: one for "blAH" would
+        // still say it isn't there once "BLAH" is created - until the VFS has a
+        // way to invalidate them
+        if inode.is_none() && dir.vfs().flag(c::S_CASEFOLD) {
+            return core::ptr::null_mut();
+        }
+        if let Some(inode) = &inode {
+            dentry.set_casefold_ops(inode.vfs());
+        }
+        dentry.splice_alias(inode)
+    }
+
+    fn create(idmap: MntIdmap<'_>, dir: &InodeInfo, dentry: Dentry<'_>, mode: c::umode_t,
+              #[cfg(not(linux_ge = "7.3"))] _excl: bool) -> Result<(), BchError>
+    {
+        Self::mknod(idmap, dir, dentry, mode | c::S_IFREG as c::umode_t, 0)
+    }
+
+    fn link(old: Dentry<'_>, dir: &InodeInfo, dentry: Dentry<'_>) -> Result<(), BchError> {
+        let inode = old.inode();
+        inode.vfs().assert_locked();
+
+        let fs = dir.fs();
+        subvolume::is_ro(fs, dir.inum().subvol as u32)?;
+        subvolume::is_ro(fs, inode.inum().subvol as u32)?;
+        inode.link(dir, dentry.name())?;
+        dentry.instantiate(ARef::from(inode));
+        Ok(())
+    }
+
+    fn unlink(dir: &InodeInfo, dentry: Dentry<'_>) -> Result<(), BchError> {
+        dir.unlink(dentry, false)
+    }
+
+    /// The inode made unlinked, its @target written and flushed, then linked
+    /// - never a symlink with no target.
+    fn symlink(idmap: MntIdmap<'_>, dir: &InodeInfo, dentry: Dentry<'_>, target: &CStr)
+        -> Result<(), BchError>
+    {
+        let inode = dir.create(idmap, dentry, (c::S_IFLNK | c::S_IRWXUGO) as c::umode_t, 0,
+                               Default::default(), c::BCH_CREATE_TMPFILE)?;
+        let len = target.to_bytes_with_nul().len() as c_int;
+        ret_to_result_void(unsafe { c::page_symlink(inode.vfs().as_ptr(), target.as_ptr().cast(), len) })?;
+        inode.vfs().write_and_wait()?;
+        inode.link(dir, dentry.name())?;
+        dentry.instantiate(inode);
+        Ok(())
+    }
+
+    fn mkdir(idmap: MntIdmap<'_>, dir: &InodeInfo, dentry: Dentry<'_>, mode: c::umode_t)
+        -> Result<(), BchError>
+    {
+        Self::mknod(idmap, dir, dentry, mode | c::S_IFDIR as c::umode_t, 0)
+    }
+
+    fn rmdir(dir: &InodeInfo, dentry: Dentry<'_>) -> Result<(), BchError> {
+        dir.unlink(dentry, false)
+    }
+
+    fn mknod(idmap: MntIdmap<'_>, dir: &InodeInfo, dentry: Dentry<'_>, mode: c::umode_t,
+             rdev: c::dev_t) -> Result<(), BchError>
+    {
+        let inode = dir.create(idmap, dentry, mode, rdev, Default::default(), 0)?;
+        dentry.set_casefold_ops(inode.vfs());
+        dentry.instantiate(inode);
+        Ok(())
+    }
+
+    fn rename(_idmap: MntIdmap<'_>, src_dir: &InodeInfo, src_dentry: Dentry<'_>,
+              dst_dir: &InodeInfo, dst_dentry: Dentry<'_>, flags: c_uint) -> Result<(), BchError>
+    {
+        use c::bch_rename_mode::*;
+
+        let fs = src_dir.fs();
+        let src_inode = src_dentry.inode();
+        let dst_inode = dst_dentry.inode_opt();
+        let mode = if flags & c::RENAME_EXCHANGE != 0 {
+            BCH_RENAME_EXCHANGE
+        } else if dst_inode.is_some() {
+            BCH_RENAME_OVERWRITE
+        } else {
+            BCH_RENAME
+        };
+
+        if flags & !(c::RENAME_NOREPLACE | c::RENAME_EXCHANGE | c::RENAME_WHITEOUT) != 0 {
+            return fs.throw(bch_errcode::BCH_ERR_EINVAL_rename_bad_flags);
+        }
+
+        if mode == BCH_RENAME_OVERWRITE {
+            src_inode.vfs().write_and_wait()?;
+        }
+
+        // Without a dst_inode, src_inode in its place: locked once all the same
+        let locks = InodeInfo::update_lock_all([src_dir, dst_dir, src_inode,
+                                                dst_inode.unwrap_or(src_inode)]);
+        let ret = (|| {
+            let trans = crate::btree_trans!(fs);
+
+            lockrestart_do(&trans, |t| {
+                subvolume::is_ro_trans(t, src_dir.inum().subvol as u32)?;
+                subvolume::is_ro_trans(t, dst_dir.inum().subvol as u32)?;
+                Ok(())
+            })?;
+
+            // An inode moved into a directory whose project it inherits is
+            // charged to that project from here: put back below to the project
+            // the inode was written with, whatever happens
+            locks.get(src_inode).inherit_project(dst_dir)?;
+            if mode == BCH_RENAME_EXCHANGE {
+                let dst_inode = dst_inode.expect("an exchange with nothing to exchange");
+                locks.get(dst_inode).inherit_project(src_dir)?;
+            }
+
+            let [mut src_dir_u, mut dst_dir_u, mut src_inode_u, mut dst_inode_u] =
+                [c::bch_inode_unpacked::default(); 4];
+            // Outside the attempts: the propagates they start are finished after
+            // the commit
+            let mut src_opt_change = c::inode_opt_change::new();
+            let mut dst_opt_change = c::inode_opt_change::new();
+
+            lockrestart_do(&trans, |t| {
+                for inode in [src_dir, dst_dir, src_inode].into_iter().chain(dst_inode) {
+                    inode.fold_times_trans(t)?;
+                }
+                namei::rename_trans(t, src_dir.inum(), &mut src_dir_u, dst_dir.inum(), &mut dst_dir_u,
+                                    &mut src_inode_u, &mut dst_inode_u,
+                                    src_dentry.name(), dst_dentry.name(), mode,
+                                    &mut src_opt_change, &mut dst_opt_change)?;
+
+                if flags & c::RENAME_WHITEOUT != 0 {
+                    // In the transaction's memory, as C had it: off the stack
+                    let w = t.alloc_zeroed::<c::bch_inode_unpacked>()?;
+                    inode::init_early(fs, w);
+
+                    let mut new_subvol = c::Subvolume::default();
+                    let uid = src_dir.vfs().uid_of(current_fsuid());
+                    let gid = src_dir.vfs().gid_of(current_fsgid());
+                    namei::create_trans(t, src_dir.inum(), &mut src_dir_u, w, &mut new_subvol,
+                                        Some(src_dentry.name()), uid, gid,
+                                        (c::S_IFCHR | c::WHITEOUT_MODE) as c::umode_t, 0,
+                                        None, None, c::subvol_inum::default(), 0)?;
+                    if !src_dir.flag(c::bch_inode_info_flags::EI_INODE_SNAPSHOT) {
+                        quota::acct(fs, quota::qid(w), c::quota_counters::Q_INO.0 as usize, 1,
+                                    c::quota_acct_mode::KEY_TYPE_QUOTA_PREALLOC)?;
+                    }
+                }
+
+                t.commit(None, CommitOpts::new())
+            })?;
+
+            assert_eq!(src_inode.inum().inum, src_inode_u.bi_inum, "renamed the wrong inode");
+            if let Some(dst_inode) = dst_inode {
+                assert_eq!(dst_inode.inum().inum, dst_inode_u.bi_inum, "renamed over the wrong inode");
+            }
+
+            src_dir.update_after_write(&trans, &src_dir_u, DIR_ENTRIES_CHANGED);
+            if !core::ptr::eq(src_dir, dst_dir) {
+                dst_dir.update_after_write(&trans, &dst_dir_u, DIR_ENTRIES_CHANGED);
+            }
+            src_inode.update_after_write(&trans, &src_inode_u, ATTR_CTIME);
+            if let Some(dst_inode) = dst_inode {
+                dst_inode.update_after_write(&trans, &dst_inode_u, ATTR_CTIME);
+            }
+
+            src_opt_change.finish(&trans)?;
+            dst_opt_change.finish(&trans)
+        })();
+
+        // Whether it happened or not, the project quota is the inode's, as
+        // written:
+        let prj = 1 << c::quota_types::QTYP_PRJ.0;
+        for inode in [Some(src_inode), dst_inode].into_iter().flatten() {
+            let _ = locks.get(inode).quota_transfer(quota::qid(&inode.inode()), prj,
+                                                    c::quota_acct_mode::KEY_TYPE_QUOTA_NOCHECK);
+        }
+        ret
+    }
+
+    fn tmpfile(idmap: MntIdmap<'_>, dir: &InodeInfo, file: &File, mode: c::umode_t)
+        -> Result<(), BchError>
+    {
+        // SAFETY: the file being opened's, referenced by it
+        let dentry = unsafe { Dentry::borrow_raw(file.dentry()) };
+        let inode = dir.create(idmap, dentry, mode, 0, Default::default(), c::BCH_CREATE_TMPFILE)?;
+        unsafe { c::d_mark_tmpfile(file.as_ptr(), inode.vfs().as_ptr()) };
+        dentry.instantiate(inode);
+        ret_to_result_void(unsafe { c::finish_open_simple(file.as_ptr(), 0) })
+    }
+}
+
+/// Dirent @d, in @dir, points at @inum, which isn't there: @err, looking for
+/// it in @snapshot. Not a reason to take the filesystem read-only - logged, and
+/// check_dirents scheduled.
+fn dirent_to_missing_inode(t: &TransAttempt<'_, '_>, d: Dirent<'_>, dir: c::subvol_inum,
+                           inum: c::subvol_inum, snapshot: u32, err: &BchError)
+    -> Result<(), BchError>
+{
+    let fs = t.fs();
+    let mut msg = LogMsg::new(fs);
+
+    write!(msg, "dirent to missing inode: ({err})\n{}\n in: ", d.k().to_text(fs));
+    namei::inum_to_path(t, dir, &mut msg)?;
+    write!(msg, "\ndir subvol {} inum subvol {} snapshot {snapshot}\n", dir.subvol, inum.subvol);
+
+    // Scheduling the pass takes sb_lock, and may write the superblock
+    t.unlock();
+    passes::run_explicit(fs, &mut msg, c::bch_recovery_pass::BCH_RECOVERY_PASS_check_dirents,
+                         c::bch_run_recovery_pass_flags::empty())
+}
+
+/// For C's unlink and rmdir, and subvolume deletion, until they're Rust.
+///
+/// # Safety
+/// @vdir is one of our directories and @dentry one of our dentries in it,
+/// both referenced, and @vdir locked, for the call.
+#[c_export]
+pub unsafe fn __bch2_unlink(vdir: *mut c::inode, dentry: *mut c::dentry, deleting_subvol: bool) -> c_int {
+    let dir = unsafe { InodeInfo::from_inode(vdir) };
+    ret_to_c(dir.unlink(unsafe { Dentry::borrow_raw(dentry) }, deleting_subvol))
+}
diff --git a/fs/bcachefs/vfs/ops.rs b/fs/bcachefs/vfs/ops.rs
new file mode 100644
index 0000000..16c53b4
--- /dev/null
+++ b/fs/bcachefs/vfs/ops.rs
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! The VFS's side of vfs_ops! (util/ops.rs): what its ops are passed and
+//! return, as FromRaw and IntoRaw impls, and SelfOf's &self - what the
+//! superblock's s_fs_info points to, found from whatever the op is passed.
+
+use core::ffi::{c_int, CStr};
+use core::mem::ManuallyDrop;
+use core::ptr::NonNull;
+
+use crate::acl::{AclType, PosixAcl};
+use crate::c;
+use crate::errcode::BchError;
+use crate::util::ffi::c_char;
+use crate::util::ops::{from_raw, into_raw, SelfOf};
+use crate::util::seq_file::SeqFile;
+
+use super::dentry::Dentry;
+use super::export::NameBuf;
+use super::idmap::MntIdmap;
+use super::inode::InodeInfo;
+use super::path::Path;
+use super::super_block::SuperBlock;
+
+// s_fs_info is set at mount, before the superblock has an inode, to the T
+// that implements its traits: SelfOf's contract
+
+impl<T: 'static> SelfOf<T> for *mut c::super_block {
+    type Out = T;
+    unsafe fn self_of<'a>(&self) -> &'a T { unsafe { &*(**self).s_fs_info.cast::<T>() } }
+}
+
+impl<T: 'static> SelfOf<T> for *mut c::inode {
+    type Out = T;
+    unsafe fn self_of<'a>(&self) -> &'a T { unsafe { SelfOf::<T>::self_of(&(**self).i_sb) } }
+}
+
+impl<T: 'static> SelfOf<T> for *mut c::dentry {
+    type Out = T;
+    unsafe fn self_of<'a>(&self) -> &'a T { unsafe { SelfOf::<T>::self_of(&(**self).d_sb) } }
+}
+
+// ── Arguments ────────────────────────────────────────────────────────────
+
+from_raw! {
+    &'a SuperBlock        = *mut c::super_block => |r| SuperBlock::from_raw(r);
+    &'a InodeInfo         = *mut c::inode       => |r| InodeInfo::from_inode(r);
+    /// A parent, which may not be given.
+    Option<&'a InodeInfo> = *mut c::inode       => |r| (!r.is_null()).then(|| InodeInfo::from_inode(r));
+    /// One the VFS is done with, to free: not borrowed, nor its superblock.
+    NonNull<InodeInfo>    = *mut c::inode       => |r| NonNull::new(r).expect("an inode").cast();
+    Dentry<'a>            = *mut c::dentry      => |r| Dentry::borrow_raw(r);
+    /// get_link's, None in an RCU walk.
+    Option<Dentry<'a>>    = *mut c::dentry      => |r| (!r.is_null()).then(|| Dentry::borrow_raw(r));
+    &'a Path              = *const c::path      => |r| &*r.cast();
+    MntIdmap<'a>          = *mut c::mnt_idmap   => |r| MntIdmap::borrow_raw(r);
+    /// One this thread is writing.
+    &'a SeqFile           = *mut c::seq_file    => |r| SeqFile::from_raw(r);
+    &'a CStr              = *const c_char       => |r| CStr::from_ptr(r.cast());
+    AclType               = c_int               => |r| AclType::from_vfs(r);
+    /// The VFS's reference, None for no ACL.
+    Option<ManuallyDrop<PosixAcl>> = *mut c::posix_acl => |r| PosixAcl::borrow_raw(r);
+    &'a mut c::kstat      = *mut c::kstat       => |r| &mut *r;
+    &'a mut c::iattr      = *mut c::iattr       => |r| &mut *r;
+    &'a mut c::file_kattr = *mut c::file_kattr  => |r| &mut *r;
+    &'a mut c::delayed_call = *mut c::delayed_call => |r| &mut *r;
+    &'a mut c::fiemap_extent_info = *mut c::fiemap_extent_info => |r| &mut *r;
+    /// The kernel crate's is fs.h's declaration, opaque; codegen's the same.
+    &'a mut c::kstatfs    = *mut kernel::bindings::kstatfs => |r| &mut *r.cast();
+    /// get_name's, NAME_MAX + 1 bytes.
+    &'a mut NameBuf       = *mut c_char         => |r| &mut *r.cast();
+}
+
+#[cfg(linux_ge = "6.17")]
+from_raw! {
+    /// mmap_prepare's.
+    &'a mut c::vm_area_desc = *mut c::vm_area_desc => |r| &mut *r;
+}
+
+#[cfg(not(linux_ge = "6.17"))]
+from_raw! {
+    /// mmap's.
+    &'a mut c::vm_area_struct = *mut c::vm_area_struct => |r| &mut *r;
+}
+
+// ── Returns ──────────────────────────────────────────────────────────────
+
+/// @e, classed, as an ERR_PTR().
+pub(crate) fn err_class_ptr<T>(e: BchError) -> *mut T {
+    e.class() as isize as *mut T
+}
+
+into_raw! {
+    /// mkdir's: NULL for the dentry it was given, instantiated.
+    Result<(), BchError>    => *mut c::dentry: |r| r.map_or_else(err_class_ptr, |()| core::ptr::null_mut());
+    Result<usize, BchError> => isize: |r| r.map_or_else(|e| e.class() as isize, |n| n as isize);
+    /// NULL for no ACL; the ACL's reference ours to give.
+    Result<Option<PosixAcl>, BchError> => *mut c::posix_acl:
+        |r| r.map_or_else(err_class_ptr, |acl| acl.map_or(core::ptr::null_mut(), PosixAcl::into_raw));
+    /// alloc_inode's: NULL if there isn't one.
+    Result<NonNull<c::inode>, BchError> => *mut c::inode: |r| r.map_or(core::ptr::null_mut(), NonNull::as_ptr);
+}
diff --git a/fs/bcachefs/vfs/pagecache.c b/fs/bcachefs/vfs/pagecache.c
new file mode 100644
index 0000000..9f761d3
--- /dev/null
+++ b/fs/bcachefs/vfs/pagecache.c
@@ -0,0 +1,1035 @@
+// SPDX-License-Identifier: GPL-2.0
+#ifndef NO_BCACHEFS_FS
+
+#include "bcachefs.h"
+
+#include "btree/iter.h"
+
+#include "data/extents.h"
+
+#include "snapshots/snapshot.h"
+#include "snapshots/subvolume.h"
+
+#include "vfs/io.h"
+#include "vfs/pagecache.h"
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7,1,0)
+#include <linux/folio_batch.h>
+#else
+#include <linux/pagevec.h>
+#endif
+#include <linux/writeback.h>
+
+int bch2_filemap_get_contig_folios_d(struct address_space *mapping,
+				     loff_t start, u64 end,
+				     fgf_t fgp_flags, gfp_t gfp,
+				     folios *fs)
+{
+	struct folio *f;
+	u64 pos = start;
+	int ret = 0;
+
+	while (pos < end) {
+		if ((u64) pos >= (u64) start + (1ULL << 20))
+			fgp_flags &= ~FGP_CREAT;
+
+		ret = darray_make_room_gfp(fs, 1, gfp & GFP_KERNEL);
+		if (ret)
+			break;
+
+		f = __filemap_get_folio(mapping, pos >> PAGE_SHIFT, fgp_flags, gfp);
+		if (IS_ERR(f))
+			break;
+
+		BUG_ON(fs->nr && folio_pos(f) != pos);
+
+		pos = folio_end_pos(f);
+		darray_push(fs, f);
+	}
+
+	if (!fs->nr && !ret && (fgp_flags & FGP_CREAT))
+		ret = -ENOMEM;
+
+	return fs->nr ? 0 : ret;
+}
+
+/* pagecache_block must be held */
+int bch2_write_invalidate_inode_pages_range(struct address_space *mapping,
+					    loff_t start, loff_t end)
+{
+	int ret;
+
+	/*
+	 * XXX: the way this is currently implemented, we can spin if a process
+	 * is continually redirtying a specific page
+	 */
+	do {
+		if (!mapping->nrpages)
+			return 0;
+
+		ret = filemap_write_and_wait_range(mapping, start, end);
+		if (ret)
+			break;
+
+		if (!mapping->nrpages)
+			return 0;
+
+		ret = invalidate_inode_pages2_range(mapping,
+				start >> PAGE_SHIFT,
+				end >> PAGE_SHIFT);
+	} while (ret == -EBUSY);
+
+	return ret;
+}
+
+#if 0
+/* Useful for debug tracing: */
+static const char * const bch2_folio_sector_states[] = {
+#define x(n)	#n,
+	BCH_FOLIO_SECTOR_STATE()
+#undef x
+	NULL
+};
+#endif
+
+static inline enum bch_folio_sector_state
+folio_sector_dirty(enum bch_folio_sector_state state)
+{
+	switch (state) {
+	case SECTOR_unallocated:
+		return SECTOR_dirty;
+	case SECTOR_reserved:
+		return SECTOR_dirty_reserved;
+	default:
+		return state;
+	}
+}
+
+static inline enum bch_folio_sector_state
+folio_sector_undirty(enum bch_folio_sector_state state)
+{
+	switch (state) {
+	case SECTOR_dirty:
+		return SECTOR_unallocated;
+	case SECTOR_dirty_reserved:
+		return SECTOR_reserved;
+	default:
+		return state;
+	}
+}
+
+static inline enum bch_folio_sector_state
+folio_sector_reserve(enum bch_folio_sector_state state)
+{
+	switch (state) {
+	case SECTOR_unallocated:
+		return SECTOR_reserved;
+	case SECTOR_dirty:
+		return SECTOR_dirty_reserved;
+	default:
+		return state;
+	}
+}
+
+/* for newly allocated folios: */
+struct bch_folio *__bch2_folio_create(struct folio *folio, gfp_t gfp)
+{
+	struct bch_folio *s = kzalloc(sizeof(*s) +
+				      sizeof(struct bch_folio_sector) *
+				      folio_sectors(folio), gfp);
+	if (!s)
+		return NULL;
+
+	spin_lock_init(&s->lock);
+	folio_attach_private(folio, s);
+	return s;
+}
+
+struct bch_folio *bch2_folio_create(struct folio *folio, gfp_t gfp)
+{
+	EBUG_ON(!folio_test_locked(folio));
+
+	return bch2_folio(folio) ?: __bch2_folio_create(folio, gfp);
+}
+
+static unsigned bkey_to_sector_state(const struct bch_fs *c, struct bkey_s_c k)
+{
+	if (bkey_extent_is_reservation(c, k))
+		return SECTOR_reserved;
+	if (bkey_extent_is_allocation(k.k))
+		return SECTOR_allocated;
+	return SECTOR_unallocated;
+}
+
+static void __bch2_folio_set(struct folio *folio,
+			     unsigned pg_offset, unsigned pg_len,
+			     unsigned nr_ptrs, unsigned state)
+{
+	struct bch_folio *s = bch2_folio(folio);
+	unsigned i, sectors = folio_sectors(folio);
+
+	BUG_ON(pg_offset >= sectors);
+	BUG_ON(pg_offset + pg_len > sectors);
+
+	guard(spinlock)(&s->lock);
+
+	for (i = pg_offset; i < pg_offset + pg_len; i++) {
+		s->s[i].nr_replicas	= nr_ptrs;
+		bch2_folio_sector_set(folio, s, i, state);
+	}
+
+	if (i == sectors)
+		s->state_uptodate = true;
+}
+
+/*
+ * Initialize bch_folio state (allocated/unallocated, nr_replicas) from the
+ * extents btree:
+ */
+int bch2_folio_set(struct bch_fs *c,
+		   struct bch_inode_info *inode,
+		   struct folio **fs, unsigned nr_folios)
+{
+	u64 offset = folio_sector(fs[0]);
+	bool need_set = false;
+
+	for (unsigned folio_idx = 0; folio_idx < nr_folios; folio_idx++) {
+		struct folio *f = fs[folio_idx];
+		struct bch_folio *s = bch2_folio_create(f, GFP_KERNEL);
+		if (!s)
+			return -ENOMEM;
+
+		if (!s->state_uptodate &&
+		    folio_pos(f)	>= inode->ei_reserved_start &&
+		    folio_end_pos(f)	<= inode->ei_reserved_end) {
+			guard(spinlock)(&inode->ei_reserved_lock);
+
+			if (folio_pos(f)	>= inode->ei_reserved_start &&
+			    folio_end_pos(f)	<= inode->ei_reserved_end) {
+				__bch2_folio_set(f, 0, folio_sectors(f),
+						 inode->ei_reserved_replicas,
+						 inode->ei_reserved_state);
+				inode->ei_reserved_start = folio_end_pos(f);
+			}
+		}
+
+		need_set |= !s->state_uptodate;
+	}
+
+	if (!need_set)
+		return 0;
+
+	unsigned folio_idx = 0;
+	unsigned nr_after = 0;
+	u64 res_start	= folio_end_pos(fs[nr_folios - 1]);
+	u64 res_end	= 0;
+	u8 res_replicas	= 0;
+	u8 res_state	= 0;
+
+	int ret = bch2_trans_run(c,
+		for_each_btree_key_in_subvolume_max(trans, iter, BTREE_ID_extents,
+				   POS(inode_inum(inode).inum, offset),
+				   POS(inode_inum(inode).inum, U64_MAX),
+				   inode_inum(inode).subvol, BTREE_ITER_slots|BTREE_ITER_trim, k, ({
+			unsigned nr_ptrs = bch2_bkey_durability_safe(c, k).nr_overwritable;
+			unsigned state = bkey_to_sector_state(c, k);
+
+			while (folio_idx < nr_folios) {
+				struct folio *folio = fs[folio_idx];
+				u64 folio_start	= folio_sector(folio);
+				u64 folio_end	= folio_end_sector(folio);
+				unsigned folio_offset = max(bkey_start_offset(k.k), folio_start) -
+					folio_start;
+				unsigned folio_len = min(k.k->p.offset, folio_end) -
+					folio_offset - folio_start;
+
+				BUG_ON(k.k->p.offset < folio_start);
+				BUG_ON(bkey_start_offset(k.k) > folio_end);
+
+				if (!bch2_folio(folio)->state_uptodate)
+					__bch2_folio_set(folio, folio_offset, folio_len, nr_ptrs, state);
+
+				if (k.k->p.offset < folio_end)
+					break;
+				folio_idx++;
+			}
+
+			if (folio_idx == nr_folios) {
+				if (!nr_after) {
+					res_replicas	= nr_ptrs;
+					res_state	= state;
+				} else if (res_replicas	!= nr_ptrs ||
+					   res_state	!= state ||
+					   nr_after > 16) {
+					break;
+				}
+
+				res_end = k.k->p.offset << 9;
+				nr_after++;
+			}
+			0;
+		})));
+
+	/* Build up in locals, publish once: see ei_reserved_start */
+	if (!ret && nr_after) {
+		guard(spinlock)(&inode->ei_reserved_lock);
+		inode->ei_reserved_start	= res_start;
+		inode->ei_reserved_end		= res_end;
+		inode->ei_reserved_replicas	= res_replicas;
+		inode->ei_reserved_state	= res_state;
+	}
+
+	return ret;
+}
+
+void bch2_bio_page_state_set(const struct bch_fs *c, struct bio *bio, struct bkey_s_c k)
+{
+	struct bvec_iter iter;
+	struct folio_vec fv;
+	unsigned nr_ptrs = k.k->type == KEY_TYPE_reflink_v
+		? 0 : bch2_bkey_durability_safe(c, k).nr_overwritable;
+	unsigned state = bkey_to_sector_state(c, k);
+
+	bio_for_each_folio(fv, bio, iter)
+		__bch2_folio_set(fv.fv_folio,
+				 fv.fv_offset >> 9,
+				 fv.fv_len >> 9,
+				 nr_ptrs, state);
+}
+
+void bch2_mark_pagecache_unallocated(struct bch_inode_info *inode,
+				     u64 start, u64 end)
+{
+	pgoff_t index = start >> PAGE_SECTORS_SHIFT;
+	pgoff_t end_index = (end - 1) >> PAGE_SECTORS_SHIFT;
+	struct folio_batch fbatch;
+	unsigned i, j;
+
+	if (end <= start)
+		return;
+
+	folio_batch_init(&fbatch);
+
+	while (filemap_get_folios(inode->v.i_mapping,
+				  &index, end_index, &fbatch)) {
+		for (i = 0; i < folio_batch_count(&fbatch); i++) {
+			struct folio *folio = fbatch.folios[i];
+			u64 folio_start = folio_sector(folio);
+			u64 folio_end = folio_end_sector(folio);
+			unsigned folio_offset = max(start, folio_start) - folio_start;
+			unsigned folio_len = min(end, folio_end) - folio_offset - folio_start;
+			struct bch_folio *s;
+
+			BUG_ON(end <= folio_start);
+
+			folio_lock(folio);
+			s = bch2_folio(folio);
+
+			if (s) {
+				guard(spinlock)(&s->lock);
+				for (j = folio_offset; j < folio_offset + folio_len; j++)
+					s->s[j].nr_replicas = 0;
+			}
+
+			folio_unlock(folio);
+		}
+		folio_batch_release(&fbatch);
+		cond_resched();
+	}
+}
+
+int bch2_mark_pagecache_reserved(struct bch_inode_info *inode,
+				 u64 *start, u64 end,
+				 bool nonblocking)
+{
+	struct bch_fs *c = inode->v.i_sb->s_fs_info;
+	pgoff_t index = *start >> PAGE_SECTORS_SHIFT;
+	pgoff_t end_index = (end - 1) >> PAGE_SECTORS_SHIFT;
+	struct folio_batch fbatch;
+	s64 i_sectors_delta = 0;
+	int ret = 0;
+
+	if (end <= *start)
+		return 0;
+
+	folio_batch_init(&fbatch);
+
+	while (filemap_get_folios(inode->v.i_mapping,
+				  &index, end_index, &fbatch)) {
+		for (unsigned i = 0; i < folio_batch_count(&fbatch); i++) {
+			struct folio *folio = fbatch.folios[i];
+
+			if (!nonblocking)
+				folio_lock(folio);
+			else if (!folio_trylock(folio)) {
+				folio_batch_release(&fbatch);
+				ret = -EAGAIN;
+				break;
+			}
+
+			u64 folio_start = folio_sector(folio);
+			u64 folio_end = folio_end_sector(folio);
+
+			BUG_ON(end <= folio_start);
+
+			struct bch_folio *s = bch2_folio(folio);
+			if (s) {
+				unsigned folio_offset = max(*start, folio_start) - folio_start;
+				unsigned folio_len = min(end, folio_end) - folio_offset - folio_start;
+
+				guard(spinlock)(&s->lock);
+				for (unsigned j = folio_offset; j < folio_offset + folio_len; j++) {
+					i_sectors_delta -= s->s[j].state == SECTOR_dirty;
+					bch2_folio_sector_set(folio, s, j,
+						folio_sector_reserve(s->s[j].state));
+				}
+			}
+
+			*start = min(end, folio_end);
+			folio_unlock(folio);
+		}
+		folio_batch_release(&fbatch);
+		cond_resched();
+	}
+
+	bch2_i_sectors_acct(c, inode, NULL, i_sectors_delta);
+	return ret;
+}
+
+static inline unsigned replicas_to_reserve(struct bch_folio_sector *s,
+					   unsigned nr_replicas)
+{
+	return max(0, (int) nr_replicas -
+		   s->nr_replicas -
+		   s->replicas_reserved);
+}
+
+/*
+ * Raise the count the folio's reservation is held at, carrying what it holds
+ * across. The inode's count can change under dirty folios, so whatever charges
+ * next has to land in the slot the rest is already in. Caller holds s->lock.
+ */
+static void folio_reservation_set_nr_replicas(struct bch_fs *c, struct folio *folio,
+					      struct bch_folio *s, unsigned nr_replicas)
+{
+	if (nr_replicas <= s->replicas_reserved_at)
+		return;
+
+	struct disk_reservation res = { .c = c, .nr_replicas = s->replicas_reserved_at };
+
+	for (unsigned i = 0; i < folio_sectors(folio); i++)
+		res.sectors += s->s[i].replicas_reserved;
+
+	bch2_disk_reservation_set_nr_replicas(c, &res, nr_replicas);
+	s->replicas_reserved_at = nr_replicas;
+}
+
+static bool folio_sectors_short(struct bch_folio *s, unsigned first,
+				unsigned last, unsigned nr_replicas)
+{
+	for (unsigned i = first; i < last; i++)
+		if (replicas_to_reserve(&s->s[i], nr_replicas))
+			return true;
+	return false;
+}
+
+/*
+ * Every sector at the inode's count, not just the copies each lacks: writeback
+ * rewrites every copy, and a reservation's count is the placement question it
+ * asks. What sectors already hold is over-reserved, and goes back when
+ * @disk_res is put.
+ *
+ * Without @check_enospc this can't fail: it's the backstop for overwrite credit
+ * lost since the folio was dirtied (snapshots, reflink, EC, compression). But
+ * if a foreground reservation already fell back, that was a decision - retry
+ * the normal way, which falls back too, and only insist if that fails.
+ */
+int bch2_get_folio_disk_reservation(struct bch_fs *c,
+				struct bch_inode_info *inode,
+				struct folio *folio, bool check_enospc)
+{
+	struct bch_folio *s = bch2_folio(folio);
+	unsigned nr_replicas = inode_nr_replicas(c, inode);
+	unsigned sectors = folio_sectors(folio);
+
+	BUG_ON(!s);
+	EBUG_ON(!s->state_uptodate);
+
+	if (!folio_sectors_short(s, 0, sectors, nr_replicas))
+		return 0;
+
+	int flags = !check_enospc ? BCH_DISK_RESERVATION_NOFAIL : 0;
+
+	CLASS(disk_reservation, disk_res)(c);
+	int ret = bch2_disk_reservation_add(c, &disk_res.r, sectors, nr_replicas,
+					    READ_ONCE(s->reserved_degraded) ? 0 : flags);
+	if (ret && (flags & BCH_DISK_RESERVATION_NOFAIL))
+		ret = bch2_disk_reservation_add(c, &disk_res.r, sectors, nr_replicas, flags);
+	if (ret)
+		return ret;
+
+	/* what we can place, before it's raised to the folio's slot below: */
+	unsigned granted = disk_res.r.nr_replicas;
+
+	/*
+	 * Only what each sector lacks: reserved copies stay until the sector
+	 * is written, so topping up clean sectors would pile them up.
+	 */
+	scoped_guard(spinlock, &s->lock) {
+		folio_reservation_set_nr_replicas(c, folio, s, granted);
+		bch2_disk_reservation_set_nr_replicas(c, &disk_res.r, s->replicas_reserved_at);
+
+		for (unsigned i = 0; i < sectors; i++) {
+			unsigned r = replicas_to_reserve(&s->s[i], granted);
+
+			s->s[i].replicas_reserved += r;
+			disk_res.r.sectors -= r;
+		}
+	}
+
+	return 0;
+}
+
+void bch2_folio_reservation_put(struct bch_fs *c,
+			struct bch_inode_info *inode,
+			struct bch2_folio_reservation *res)
+{
+	bch2_disk_reservation_put(c, &res->disk);
+	bch2_quota_reservation_put(c, inode, &res->quota);
+}
+
+/* A reservation lives in one slot: raise whichever is lower first */
+static void folio_res_merge(struct bch_fs *c, struct disk_reservation *res,
+			    struct disk_reservation *add)
+{
+	bch2_disk_reservation_set_nr_replicas(c, add, res->nr_replicas);
+	bch2_disk_reservation_set_nr_replicas(c, res, add->nr_replicas);
+	res->sectors += add->sectors;
+	add->sectors = 0;
+}
+
+/*
+ * If the reservation fell back, @res drops to the count we got: the folio is
+ * charged at @res's count, and the rest of this write shouldn't ask again.
+ */
+static ssize_t __bch2_folio_reservation_get(struct bch_fs *c,
+			struct bch_inode_info *inode,
+			struct folio *folio,
+			struct bch2_folio_reservation *res,
+			size_t offset, size_t len,
+			bool partial)
+{
+	struct bch_folio *s = bch2_folio(folio);
+	unsigned first	= round_down(offset, block_bytes(c)) >> 9;
+	unsigned last	= round_up(offset + len, block_bytes(c)) >> 9;
+	unsigned quota_sectors = 0;
+	size_t reserved = len;
+
+	BUG_ON(!s);
+	BUG_ON(!s->state_uptodate);
+
+	CLASS(disk_reservation, disk_res)(c);
+
+	if (folio_sectors_short(s, first, last, res->disk.nr_replicas)) {
+		try(bch2_disk_reservation_add(c, &disk_res.r, last - first,
+					      res->disk.nr_replicas,
+					      partial ? BCH_DISK_RESERVATION_PARTIAL : 0));
+
+		unsigned got = div_u64(disk_res.r.sectors, disk_res.r.nr_replicas);
+		if (unlikely(got < last - first)) {
+			/*
+			 * Make sure to get a reservation that's aligned to the
+			 * filesystem blocksize:
+			 */
+			unsigned reserved_offset = round_down((first + got) << 9, block_bytes(c));
+			reserved = clamp(reserved_offset, offset, offset + len) - offset;
+
+			if (!reserved)
+				return bch_err_throw(c, ENOSPC_disk_reservation);
+
+			last = round_up(offset + reserved, block_bytes(c)) >> 9;
+		}
+
+		if (unlikely(disk_res.r.nr_replicas < res->disk.nr_replicas)) {
+			disk_res_move_slot(c, &res->disk, disk_res.r.nr_replicas);
+			res->degraded = true;
+		}
+	}
+
+	for (unsigned i = first; i < last; i++)
+		quota_sectors += s->s[i].state == SECTOR_unallocated;
+
+	if (quota_sectors)
+		try(bch2_quota_reservation_add(c, inode, &res->quota, quota_sectors, true));
+
+	folio_res_merge(c, &res->disk, &disk_res.r);
+	return partial ? reserved : 0;
+}
+
+static int bch2_folio_reservation_get_nofail(struct bch_fs *c,
+			struct bch_inode_info *inode,
+			struct folio *folio,
+			struct bch2_folio_reservation *res,
+			size_t offset, size_t len)
+{
+	struct bch_folio *s = bch2_folio(folio);
+	unsigned first	= round_down(offset, block_bytes(c)) >> 9;
+	unsigned last	= round_up(offset + len, block_bytes(c)) >> 9;
+	unsigned quota_sectors = 0;
+	int ret;
+
+	BUG_ON(!s);
+	BUG_ON(!s->state_uptodate);
+
+	for (unsigned i = first; i < last; i++)
+		quota_sectors += s->s[i].state == SECTOR_unallocated;
+
+	CLASS(disk_reservation, disk_res)(c);
+
+	if (folio_sectors_short(s, first, last, res->disk.nr_replicas))
+		try(bch2_disk_reservation_add(c, &disk_res.r, last - first,
+					      res->disk.nr_replicas,
+					      BCH_DISK_RESERVATION_NOFAIL));
+
+	if (quota_sectors) {
+		/* FIXME: we'll need to make sure this won't fail with -ENOMEM */
+		ret = bch2_quota_reservation_add(c, inode, &res->quota, quota_sectors, false);
+		if (unlikely(ret))
+			return ret;
+	}
+
+	folio_res_merge(c, &res->disk, &disk_res.r);
+	return 0;
+}
+
+int bch2_folio_reservation_get(struct bch_fs *c,
+			struct bch_inode_info *inode,
+			struct folio *folio,
+			struct bch2_folio_reservation *res,
+			size_t offset, size_t len)
+{
+	return (int)__bch2_folio_reservation_get(c, inode, folio, res, offset, len, false);
+}
+
+ssize_t bch2_folio_reservation_get_partial(struct bch_fs *c,
+			struct bch_inode_info *inode,
+			struct folio *folio,
+			struct bch2_folio_reservation *res,
+			size_t offset, size_t len)
+{
+	return __bch2_folio_reservation_get(c, inode, folio, res, offset, len, true);
+}
+
+void bch2_set_folio_undirty(struct bch_fs *c,
+			    struct bch_inode_info *inode,
+			    struct folio *folio,
+			    size_t offset, size_t len)
+{
+	struct bch_folio *s = bch2_folio(folio);
+	if (!s)
+		return;
+
+	CLASS(disk_reservation, disk_res)(c);
+	int dirty_sectors = 0;
+
+	scoped_guard(spinlock, &s->lock) {
+		/* release at the count the folio's sectors were charged at */
+		disk_res.r.nr_replicas = s->replicas_reserved_at;
+
+		for (unsigned i = round_up(offset, block_bytes(c)) >> 9;
+		     i < round_down(offset + len, block_bytes(c)) >> 9;
+		     i++) {
+			disk_res.r.sectors += s->s[i].replicas_reserved;
+			s->s[i].replicas_reserved = 0;
+
+			dirty_sectors -= s->s[i].state == SECTOR_dirty;
+			bch2_folio_sector_set(folio, s, i, folio_sector_undirty(s->s[i].state));
+		}
+	}
+
+	bch2_i_sectors_acct(c, inode, NULL, dirty_sectors);
+}
+
+bool bch2_set_folio_dirty(struct bch_fs *c,
+			  struct bch_inode_info *inode,
+			  struct folio *folio,
+			  struct bch2_folio_reservation *res,
+			  size_t offset, size_t len)
+{
+	struct bch_folio *s = bch2_folio(folio);
+	unsigned i, dirty_sectors = 0;
+
+	/*
+	 * We'll get called by the mm code when propagating the dirty bit from
+	 * the PTE to the folio, and address_space_operations.dirty_folio
+	 * doesn't know the difference between a page and a folio.
+	 *
+	 * Potentially a nasty performance bug, we'll be dirtying more than
+	 * we're supposed to.
+	 *
+	 * We may also legitimately be dirtying folios above i_size: truncate_setsize()
+	 * drops i_size before truncate_pagecache() runs, and folios pinned by
+	 * gup (e.g. DIO read destinations into an mmap'd region of this file)
+	 * stay attached to the address_space until the pin drops. The VFS
+	 * truncate path documents this in truncate_cleanup_folio() and handles
+	 * it via folio_cancel_dirty() ordering; __bch2_writepage cleans up the
+	 * sectors_dirty bits we set here.
+	 */
+
+	BUG_ON(!s);
+	BUG_ON(!s->state_uptodate);
+	EBUG_ON(round_up(offset + len, block_bytes(c)) >> 9 > UINT_MAX);
+
+	unsigned nr_replicas = res->disk.nr_replicas;
+
+	scoped_guard(spinlock, &s->lock) {
+		/* both have to name the same slot: raise whichever is lower */
+		folio_reservation_set_nr_replicas(c, folio, s, nr_replicas);
+		bch2_disk_reservation_set_nr_replicas(c, &res->disk,
+						      s->replicas_reserved_at);
+
+		if (res->degraded)
+			s->reserved_degraded = true;
+
+		for (i = round_down(offset, block_bytes(c)) >> 9;
+		     i < round_up(offset + len, block_bytes(c)) >> 9;
+		     i++) {
+			unsigned replicas = replicas_to_reserve(&s->s[i], nr_replicas);
+
+			/*
+			 * This can happen if we race with the error path in
+			 * bch2_writepage_io_done():
+			 */
+			replicas = min_t(unsigned, replicas, res->disk.sectors);
+
+			s->s[i].replicas_reserved += replicas;
+			res->disk.sectors -= replicas;
+
+			dirty_sectors += s->s[i].state == SECTOR_unallocated;
+
+			bch2_folio_sector_set(folio, s, i, folio_sector_dirty(s->s[i].state));
+		}
+	}
+
+	bch2_i_sectors_acct(c, inode, &res->quota, dirty_sectors);
+
+	if (!folio_test_dirty(folio))
+		return filemap_dirty_folio(inode->v.i_mapping, folio);
+	return false;
+}
+
+bool bch2_vfs_dirty_folio(struct address_space *mapping, struct folio *folio)
+{
+	struct bch_inode_info *inode = to_bch_ei(mapping->host);
+	struct bch_fs *c = inode->v.i_sb->s_fs_info;
+	struct bch2_folio_reservation res;
+
+	/*
+	 * Folios above i_size are expected here rather than a curiosity:
+	 * truncate_setsize() drops i_size before truncate_pagecache() runs, so
+	 * there's a window where the mapping still holds folios past the new
+	 * end, and a folio pinned by gup stays attached to the address_space
+	 * until the pin drops. bch2_set_folio_dirty() has the longer version.
+	 *
+	 * A folio entirely past i_size has nothing to reserve or account for, so
+	 * drop it; one straddling i_size is clamped by the min() below and only
+	 * the part still within the file gets dirtied.
+	 */
+	u64 file_size = i_size_read(&inode->v);
+	if (folio_pos(folio) >= file_size)
+		return false;
+
+	size_t dirty_bytes =
+		round_up(min(folio_end_pos(folio), file_size) - folio_pos(folio),
+			 block_bytes(c));
+
+	bch2_folio_reservation_init(c, inode, &res);
+	BUG_ON(bch2_folio_reservation_get_nofail(c, inode, folio, &res, 0, dirty_bytes));
+	bool ret = bch2_set_folio_dirty(c, inode, folio, &res, 0, dirty_bytes);
+	bch2_folio_reservation_put(c, inode, &res);
+	return ret;
+}
+
+vm_fault_t bch2_page_fault(struct vm_fault *vmf)
+{
+	struct file *file = vmf->vma->vm_file;
+	struct address_space *mapping = file->f_mapping;
+	struct bch_inode_info *inode = file_bch_inode(file);
+	struct bch_fs *c = inode->v.i_sb->s_fs_info;
+	struct address_space *fdm = faults_disabled_mapping(c);
+	vm_fault_t ret;
+
+	if (fdm == mapping)
+		return VM_FAULT_SIGBUS;
+
+	/* Lock ordering: */
+	if (fdm > mapping) {
+		struct bch_inode_info *fdm_host = to_bch_ei(fdm->host);
+
+		if (bch2_pagecache_add_tryget(inode))
+			goto got_lock;
+
+		bch2_pagecache_block_put(fdm_host);
+
+		bch2_pagecache_add_get(inode);
+		bch2_pagecache_add_put(inode);
+
+		bch2_pagecache_block_get(fdm_host);
+
+		/* Signal that lock has been dropped: */
+		set_fdm_dropped_locks(c);
+		return VM_FAULT_SIGBUS;
+	}
+
+	bch2_pagecache_add_get(inode);
+got_lock:
+	ret = filemap_fault(vmf);
+	bch2_pagecache_add_put(inode);
+
+	return ret;
+}
+
+vm_fault_t bch2_page_mkwrite(struct vm_fault *vmf)
+{
+	struct folio *folio = page_folio(vmf->page);
+	struct file *file = vmf->vma->vm_file;
+	struct bch_inode_info *inode = file_bch_inode(file);
+	struct address_space *mapping = file->f_mapping;
+	struct bch_fs *c = inode->v.i_sb->s_fs_info;
+	struct bch2_folio_reservation res;
+	vm_fault_t ret;
+
+	loff_t file_offset = round_down(vmf->pgoff << PAGE_SHIFT, block_bytes(c));
+	size_t offset = file_offset - folio_pos(folio);
+	unsigned len = max(PAGE_SIZE, block_bytes(c));
+
+	BUG_ON(offset + len > folio_size(folio));
+
+	bch2_folio_reservation_init(c, inode, &res);
+
+	percpu_down_read(&c->snapshots.create_lock);
+	sb_start_pagefault(inode->v.i_sb);
+	file_update_time(file);
+
+	/*
+	 * Not strictly necessary, but helps avoid dio writes livelocking in
+	 * bch2_write_invalidate_inode_pages_range() - can drop this if/when we get
+	 * a bch2_write_invalidate_inode_pages_range() that works without dropping
+	 * page lock before invalidating page
+	 */
+	guard(bch2_pagecache_add)(inode);
+
+	folio_lock(folio);
+	u64 isize = i_size_read(&inode->v);
+
+	if (folio->mapping != mapping || file_offset >= isize) {
+		folio_unlock(folio);
+		ret = VM_FAULT_NOPAGE;
+		goto out;
+	}
+
+	len = min_t(unsigned, len, isize - file_offset);
+
+	if (bch2_folio_set(c, inode, &folio, 1) ?:
+	    bch2_folio_reservation_get(c, inode, folio, &res, offset, len)) {
+		folio_unlock(folio);
+		ret = VM_FAULT_SIGBUS;
+		goto out;
+	}
+
+	inode->ei_last_dirtied = (unsigned long) current;
+
+	bch2_set_folio_dirty(c, inode, folio, &res, offset, len);
+	bch2_folio_reservation_put(c, inode, &res);
+
+	folio_wait_stable(folio);
+
+	bch2_dirty_inode(c, inode);
+
+	ret = VM_FAULT_LOCKED;
+out:
+	sb_end_pagefault(inode->v.i_sb);
+	percpu_up_read(&c->snapshots.create_lock);
+
+	return ret;
+}
+
+static void bch2_clear_folio_bits(struct folio *folio)
+{
+	struct bch_inode_info *inode = to_bch_ei(folio->mapping->host);
+	struct bch_fs *c = inode->v.i_sb->s_fs_info;
+
+	bch2_set_folio_undirty(c, inode, folio, 0, folio_size(folio));
+
+	bch2_folio_release(folio);
+}
+
+void bch2_invalidate_folio(struct folio *folio, size_t offset, size_t length)
+{
+	if (offset || length < folio_size(folio))
+		return;
+
+	bch2_clear_folio_bits(folio);
+}
+
+bool bch2_release_folio(struct folio *folio, gfp_t gfp_mask)
+{
+	if (folio_test_dirty(folio) || folio_test_writeback(folio))
+		return false;
+
+	bch2_clear_folio_bits(folio);
+	return true;
+}
+
+/* fseek: */
+
+static int folio_data_offset(struct folio *folio, loff_t pos,
+			     unsigned min_replicas)
+{
+	struct bch_folio *s = bch2_folio(folio);
+	unsigned i, sectors = folio_sectors(folio);
+
+	if (s)
+		for (i = folio_pos_to_s(folio, pos); i < sectors; i++)
+			if (s->s[i].state >= SECTOR_dirty &&
+			    s->s[i].nr_replicas + s->s[i].replicas_reserved >= min_replicas)
+				return i << SECTOR_SHIFT;
+
+	return -1;
+}
+
+loff_t bch2_seek_pagecache_data(struct inode *vinode,
+				loff_t start_offset,
+				loff_t end_offset,
+				unsigned min_replicas,
+				bool nonblock)
+{
+	struct folio_batch fbatch;
+	pgoff_t start_index	= start_offset >> PAGE_SHIFT;
+	pgoff_t end_index	= end_offset >> PAGE_SHIFT;
+	pgoff_t index		= start_index;
+	unsigned i;
+	loff_t ret;
+	int offset;
+
+	folio_batch_init(&fbatch);
+
+	while (filemap_get_folios(vinode->i_mapping,
+				  &index, end_index, &fbatch)) {
+		for (i = 0; i < folio_batch_count(&fbatch); i++) {
+			struct folio *folio = fbatch.folios[i];
+
+			if (!nonblock) {
+				folio_lock(folio);
+			} else if (!folio_trylock(folio)) {
+				folio_batch_release(&fbatch);
+				return -EAGAIN;
+			}
+
+			offset = folio_data_offset(folio,
+					max(folio_pos(folio), start_offset),
+					min_replicas);
+			if (offset >= 0) {
+				ret = clamp(folio_pos(folio) + offset,
+					    start_offset, end_offset);
+				folio_unlock(folio);
+				folio_batch_release(&fbatch);
+				return ret;
+			}
+			folio_unlock(folio);
+		}
+		folio_batch_release(&fbatch);
+		cond_resched();
+	}
+
+	return end_offset;
+}
+
+/*
+ * Search for a hole in a folio.
+ *
+ * The filemap layer returns -ENOENT if no folio exists, so reuse the same error
+ * code to indicate a pagecache hole exists at the returned offset. Otherwise
+ * return 0 if the folio is filled with data, or an error code. This function
+ * can return -EAGAIN if nonblock is specified.
+ */
+static int folio_hole_offset(struct address_space *mapping, loff_t *offset,
+			      unsigned min_replicas, bool nonblock)
+{
+	struct folio *folio;
+	struct bch_folio *s;
+	unsigned i, sectors;
+	int ret = -ENOENT;
+
+	folio = __filemap_get_folio(mapping, *offset >> PAGE_SHIFT,
+				    FGP_LOCK|(nonblock ? FGP_NOWAIT : 0), 0);
+	if (IS_ERR(folio))
+		return PTR_ERR(folio);
+
+	s = bch2_folio(folio);
+	if (!s)
+		goto unlock;
+
+	sectors = folio_sectors(folio);
+	for (i = folio_pos_to_s(folio, *offset); i < sectors; i++)
+		if (s->s[i].state < SECTOR_dirty ||
+		    s->s[i].nr_replicas + s->s[i].replicas_reserved < min_replicas) {
+			*offset = max(*offset,
+				      folio_pos(folio) + (i << SECTOR_SHIFT));
+			goto unlock;
+		}
+
+	*offset = folio_end_pos(folio);
+	ret = 0;
+unlock:
+	folio_unlock(folio);
+	folio_put(folio);
+	return ret;
+}
+
+loff_t bch2_seek_pagecache_hole(struct inode *vinode,
+				loff_t start_offset,
+				loff_t end_offset,
+				unsigned min_replicas,
+				bool nonblock)
+{
+	struct address_space *mapping = vinode->i_mapping;
+	loff_t offset = start_offset;
+	loff_t ret = 0;
+
+	while (!ret && offset < end_offset)
+		ret = folio_hole_offset(mapping, &offset, min_replicas, nonblock);
+
+	if (ret && ret != -ENOENT)
+		return ret;
+	return min(offset, end_offset);
+}
+
+int bch2_clamp_data_hole(struct inode *inode,
+			 u64 *hole_start,
+			 u64 *hole_end,
+			 unsigned min_replicas,
+			 bool nonblock)
+{
+	loff_t ret;
+
+	ret = bch2_seek_pagecache_hole(inode,
+		*hole_start << 9, *hole_end << 9, min_replicas, nonblock) >> 9;
+	if (ret < 0)
+		return ret;
+
+	*hole_start = ret;
+
+	if (*hole_start == *hole_end)
+		return 0;
+
+	ret = bch2_seek_pagecache_data(inode,
+		*hole_start << 9, *hole_end << 9, min_replicas, nonblock) >> 9;
+	if (ret < 0)
+		return ret;
+
+	*hole_end = ret;
+	return 0;
+}
+
+#endif /* NO_BCACHEFS_FS */
diff --git a/fs/bcachefs/vfs/pagecache.h b/fs/bcachefs/vfs/pagecache.h
new file mode 100644
index 0000000..aace0a1
--- /dev/null
+++ b/fs/bcachefs/vfs/pagecache.h
@@ -0,0 +1,151 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_FS_IO_PAGECACHE_H
+#define _BCACHEFS_FS_IO_PAGECACHE_H
+
+#include "vfs/io.h"
+
+#include <linux/pagemap.h>
+
+#include "vfs/pagecache_gen.h"
+
+int bch2_filemap_get_contig_folios_d(struct address_space *, loff_t,
+				     u64, fgf_t, gfp_t, folios *);
+int bch2_write_invalidate_inode_pages_range(struct address_space *, loff_t, loff_t);
+
+/*
+ * Use u64 for the end pos and sector helpers because if the folio covers the
+ * max supported range of the mapping, the start offset of the next folio
+ * overflows loff_t. This breaks much of the range based processing in the
+ * buffered write path.
+ */
+static inline u64 folio_end_pos(struct folio *folio)
+{
+	return folio_pos(folio) + folio_size(folio);
+}
+
+static inline size_t folio_sectors(struct folio *folio)
+{
+	return PAGE_SECTORS << folio_order(folio);
+}
+
+static inline loff_t folio_sector(struct folio *folio)
+{
+	return folio_pos(folio) >> 9;
+}
+
+static inline u64 folio_end_sector(struct folio *folio)
+{
+	return folio_end_pos(folio) >> 9;
+}
+
+/*
+ * Worst-case bytes for a per-folio bch_folio_sector snapshot: a folio can be up
+ * to MAX_PAGECACHE_ORDER pages, each contributing PAGE_SECTORS sector entries.
+ * Used to size the writepage_buf_pool reserve.
+ */
+#define BCH_WRITEPAGE_BUF_BYTES						\
+	((PAGE_SECTORS << MAX_PAGECACHE_ORDER) *			\
+	 sizeof(struct bch_folio_sector))
+
+/* Helper for when we need to add debug instrumentation: */
+static inline void bch2_folio_sector_set(struct folio *folio,
+			     struct bch_folio *s,
+			     unsigned i, unsigned n)
+{
+	s->s[i].state = n;
+}
+
+/* file offset (to folio offset) to bch_folio_sector index */
+static inline int folio_pos_to_s(struct folio *folio, loff_t pos)
+{
+	u64 f_offset = pos - folio_pos(folio);
+
+	BUG_ON(pos < folio_pos(folio) || pos >= folio_end_pos(folio));
+	return f_offset >> SECTOR_SHIFT;
+}
+
+/* for newly allocated folios: */
+static inline void __bch2_folio_release(struct folio *folio)
+{
+	kfree(folio_detach_private(folio));
+}
+
+static inline void bch2_folio_release(struct folio *folio)
+{
+	EBUG_ON(!folio_test_locked(folio));
+	__bch2_folio_release(folio);
+}
+
+static inline struct bch_folio *bch2_folio(struct folio *folio)
+{
+	return folio_get_private(folio);
+}
+
+struct bch_folio *__bch2_folio_create(struct folio *, gfp_t);
+struct bch_folio *bch2_folio_create(struct folio *, gfp_t);
+
+static inline unsigned inode_nr_replicas(struct bch_fs *c, struct bch_inode_info *inode)
+{
+	/* XXX: this should not be open coded */
+	return inode->ei_inode.bi_data_replicas
+		? inode->ei_inode.bi_data_replicas - 1
+		: c->opts.data_replicas;
+}
+
+static inline void bch2_folio_reservation_init(struct bch_fs *c,
+			struct bch_inode_info *inode,
+			struct bch2_folio_reservation *res)
+{
+	memset(res, 0, sizeof(*res));
+
+	res->disk.c = c;
+	res->disk.nr_replicas = inode_nr_replicas(c, inode);
+}
+
+int bch2_folio_set(struct bch_fs *, struct bch_inode_info *,
+		   struct folio **, unsigned);
+void bch2_bio_page_state_set(const struct bch_fs *, struct bio *, struct bkey_s_c);
+
+void bch2_mark_pagecache_unallocated(struct bch_inode_info *, u64, u64);
+int bch2_mark_pagecache_reserved(struct bch_inode_info *, u64 *, u64, bool);
+
+int bch2_get_folio_disk_reservation(struct bch_fs *,
+				struct bch_inode_info *,
+				struct folio *, bool);
+
+void bch2_folio_reservation_put(struct bch_fs *,
+			struct bch_inode_info *,
+			struct bch2_folio_reservation *);
+int bch2_folio_reservation_get(struct bch_fs *,
+			struct bch_inode_info *,
+			struct folio *,
+			struct bch2_folio_reservation *,
+			size_t, size_t);
+ssize_t bch2_folio_reservation_get_partial(struct bch_fs *,
+			struct bch_inode_info *,
+			struct folio *,
+			struct bch2_folio_reservation *,
+			size_t, size_t);
+
+void bch2_set_folio_undirty(struct bch_fs *c,
+			    struct bch_inode_info *inode,
+			    struct folio *folio,
+			    size_t offset, size_t len);
+bool bch2_set_folio_dirty(struct bch_fs *,
+			  struct bch_inode_info *,
+			  struct folio *,
+			  struct bch2_folio_reservation *,
+			  size_t, size_t);
+
+bool bch2_vfs_dirty_folio(struct address_space *mapping, struct folio *folio);
+
+vm_fault_t bch2_page_fault(struct vm_fault *);
+vm_fault_t bch2_page_mkwrite(struct vm_fault *);
+void bch2_invalidate_folio(struct folio *, size_t, size_t);
+bool bch2_release_folio(struct folio *, gfp_t);
+
+loff_t bch2_seek_pagecache_data(struct inode *, loff_t, loff_t, unsigned, bool);
+loff_t bch2_seek_pagecache_hole(struct inode *, loff_t, loff_t, unsigned, bool);
+int bch2_clamp_data_hole(struct inode *, u64 *, u64 *, unsigned, bool);
+
+#endif /* _BCACHEFS_FS_IO_PAGECACHE_H */
diff --git a/fs/bcachefs/vfs/pagecache_types.rs b/fs/bcachefs/vfs/pagecache_types.rs
new file mode 100644
index 0000000..4742591
--- /dev/null
+++ b/fs/bcachefs/vfs/pagecache_types.rs
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+// The VFS's: kernel only, as C's #ifndef NO_BCACHEFS_FS
+#![cfg(not(NO_BCACHEFS_FS))]
+
+use crate::cstructs::c;
+use crate::types::{DArray, c_default};
+use cstruct_macros::{bitfield, c_enum, c_typedef, c_xmacro, CStruct, TypeInfo};
+use nestify::nest;
+use core::sync::atomic::AtomicI32;
+
+c_typedef! {
+    #[c("DARRAY(struct folio *) folios")]
+    pub type folios = DArray<*mut c::folio>;
+}
+
+c_xmacro! {
+    BCH_FOLIO_SECTOR_STATE(x) {
+        (unallocated),
+        (reserved),
+        (dirty),
+        (dirty_reserved),
+        (allocated),
+    }
+}
+
+c_enum! {
+    #[closed]
+    pub enum bch_folio_sector_state: u32 {
+        BCH_FOLIO_SECTOR_STATE(n) => SECTOR_ ## n,
+    }
+}
+
+nest! {
+    #[repr(C)]
+    #[derive(Clone, Copy, Default, CStruct, TypeInfo)]
+    pub struct bch_folio_sector {
+        #[c_bitfield]
+        #>[bitfield(u8)]
+        pub bits: pub struct bch_folio_sector_bits {
+            /* Uncompressed, fully allocated replicas (or on disk reservation): */
+            nr_replicas:       u4,
+            /* Owns PAGE_SECTORS * replicas_reserved sized in memory reservation: */
+            replicas_reserved: u4,
+        },
+        pub state: u8,
+    }
+}
+
+#[repr(C)]
+#[derive(CStruct, TypeInfo)]
+pub struct bch_folio {
+    pub lock: c::spinlock_t,
+    pub write_count: AtomicI32,
+    /* is s[] up to date with the btree? says nothing about the data */
+    pub state_uptodate: bool,
+    /* the count s[].replicas_reserved is charged at, and released at */
+    pub replicas_reserved_at: u8,
+    /*
+     * A foreground reservation fell back: writeback shouldn't insist on the
+     * inode's count - see bch2_get_folio_disk_reservation().
+     */
+    pub reserved_degraded: bool,
+    /*
+     * The data: sectors [0, partially_uptodate) are read but the folio
+     * isn't uptodate. One offset suffices because reads start at the front
+     * of the folio; 0 means nothing partial, so only
+     * readpage_bio_drop_unissued() maintains this.
+     */
+    pub partially_uptodate: u16,
+    pub s: [c::bch_folio_sector; 0],
+}
+c_default!(bch_folio);
+
+#[repr(C)]
+#[derive(CStruct)]
+pub struct bch2_folio_reservation {
+    pub disk: c::disk_reservation,
+    pub quota: c::quota_res,
+    /* @disk fell back to fewer replicas than the inode asks for */
+    pub degraded: bool,
+}
diff --git a/fs/bcachefs/vfs/path.rs b/fs/bcachefs/vfs/path.rs
new file mode 100644
index 0000000..d70cb57
--- /dev/null
+++ b/fs/bcachefs/vfs/path.rs
@@ -0,0 +1,205 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Paths: Path, one the VFS passes an op; and from userspace, resolved and
+//! held until they drop: UserPath, a path looked up; and Creating and
+//! Removing, a path's last component to create or remove, with its parent
+//! locked and its mount's write access held.
+//!
+//! The VFS's helpers for the last two changed twice. Before 6.18 they're
+//! user_path_create() and done_path_create(), and the removal lookup,
+//! user_path_locked_at(), takes the parent's lock without the write access -
+//! which nests outside it - so that's dropped, the access taken, the lock
+//! retaken, and the victim revalidated: still hashed, still the parent's.
+//! 7.2 dropped the removal lookup by dirfd and user pointer: it's
+//! user_path_at(), then start_removing_dentry() to lock the parent and
+//! revalidate the victim under the lock.
+
+use core::ffi::{c_int, c_uint};
+use core::mem::MaybeUninit;
+use core::ptr::NonNull;
+
+use crate::c;
+use crate::errcode::{errptr_to_result, ret_to_result_void, BchError};
+use crate::fs::Fs;
+use crate::util::ffi::c_char;
+
+use super::dentry::Dentry;
+
+fn user_ptr(addr: u64) -> *const c_char {
+    addr as usize as *const c_char
+}
+
+/// Whether @dentry is on @fs.
+fn on(dentry: *mut c::dentry, fs: &Fs) -> bool {
+    // SAFETY: a dentry the VFS gave us, referenced
+    unsafe { (*(*dentry).d_sb).s_fs_info.cast() == fs.as_ptr() }
+}
+
+/// A path the VFS passes an op - getattr's - ours, held for the call.
+#[repr(transparent)]
+pub struct Path(c::path);
+
+impl Path {
+    pub fn dentry(&self) -> Dentry<'_> {
+        // SAFETY: held, its inode ours, as the FromRaw row has it
+        unsafe { Dentry::borrow_raw(self.0.dentry) }
+    }
+}
+
+/// A path looked up, from directory fd @dirfd: path_put() when it drops.
+pub struct UserPath(c::path);
+
+impl UserPath {
+    pub fn at(dirfd: c_int, name: u64, flags: c_uint) -> Result<Self, BchError> {
+        let mut p = MaybeUninit::uninit();
+        ret_to_result_void(unsafe { c::user_path_at(dirfd, user_ptr(name), flags, p.as_mut_ptr()) })?;
+        // SAFETY: user_path_at() filled it in
+        Ok(UserPath(unsafe { p.assume_init() }))
+    }
+
+    pub fn dentry(&self) -> *mut c::dentry {
+        self.0.dentry
+    }
+
+    pub fn on(&self, fs: &Fs) -> bool {
+        on(self.0.dentry, fs)
+    }
+}
+
+impl Drop for UserPath {
+    fn drop(&mut self) {
+        unsafe { c::path_put(&self.0) }
+    }
+}
+
+/// A last component to create - @dentry, negative unless it exists - in
+/// @path, the parent, locked, its mount writable.
+pub struct Creating {
+    pub path:   c::path,
+    pub dentry: *mut c::dentry,
+}
+
+impl Creating {
+    pub fn start(dirfd: c_int, name: u64) -> Result<Self, BchError> {
+        let mut path = MaybeUninit::uninit();
+        // SAFETY: the VFS's, filling in @path if it succeeds
+        let dentry = unsafe {
+            #[cfg(linux_ge = "6.18")]
+            let d = c::start_creating_user_path(dirfd, user_ptr(name), path.as_mut_ptr(), 0);
+            #[cfg(not(linux_ge = "6.18"))]
+            let d = c::user_path_create(dirfd, user_ptr(name), path.as_mut_ptr(), 0);
+            d
+        };
+        let dentry = errptr_to_result(NonNull::new(dentry).expect("a dentry, or an error"))?.as_ptr();
+        Ok(Creating { path: unsafe { path.assume_init() }, dentry })
+    }
+
+    pub fn on(&self, fs: &Fs) -> bool {
+        on(self.dentry, fs)
+    }
+}
+
+impl Drop for Creating {
+    fn drop(&mut self) {
+        #[cfg(linux_ge = "6.18")]
+        unsafe { c::end_creating_path(&self.path, self.dentry) }
+        #[cfg(not(linux_ge = "6.18"))]
+        unsafe { c::done_path_create(&mut self.path, self.dentry) }
+    }
+}
+
+/// A last component to remove, @victim, in @path, the parent, locked, its
+/// mount writable.
+pub struct Removing {
+    pub path:   c::path,
+    pub victim: *mut c::dentry,
+}
+
+impl Removing {
+    pub fn start(dirfd: c_int, name: u64) -> Result<Self, BchError> {
+        let mut path = MaybeUninit::<c::path>::uninit();
+        let victim = unsafe { start_removing(dirfd, user_ptr(name), path.as_mut_ptr()) };
+        let victim = errptr_to_result(NonNull::new(victim).expect("a dentry, or an error"))?.as_ptr();
+        Ok(Removing { path: unsafe { path.assume_init() }, victim })
+    }
+
+    pub fn on(&self, fs: &Fs) -> bool {
+        on(self.victim, fs)
+    }
+}
+
+impl Drop for Removing {
+    fn drop(&mut self) {
+        #[cfg(linux_ge = "6.18")]
+        unsafe { c::end_removing_path(&self.path, self.victim) }
+        #[cfg(not(linux_ge = "6.18"))]
+        unsafe { c::done_path_create(&mut self.path, self.victim) }
+    }
+}
+
+/// # Safety
+/// @name a user pointer, @path for the parent: filled in, held, if it succeeds.
+#[cfg(all(linux_ge = "6.18", not(linux_ge = "7.2")))]
+unsafe fn start_removing(dirfd: c_int, name: *const c_char, path: *mut c::path) -> *mut c::dentry {
+    unsafe { c::start_removing_user_path_at(dirfd, name, path) }
+}
+
+#[cfg(linux_ge = "7.2")]
+unsafe fn start_removing(dirfd: c_int, name: *const c_char, path: *mut c::path) -> *mut c::dentry {
+    unsafe {
+        let mut victim = MaybeUninit::<c::path>::uninit();
+        let ret = c::user_path_at(dirfd, name, 0, victim.as_mut_ptr());
+        if ret != 0 {
+            return crate::errcode::err_ptr(BchError::from_raw(-ret));
+        }
+        let victim = victim.assume_init();
+
+        let ret = c::mnt_want_write(victim.mnt);
+        if ret != 0 {
+            c::path_put(&victim);
+            return crate::errcode::err_ptr(BchError::from_raw(-ret));
+        }
+
+        let parent = c::dget_parent(victim.dentry);
+        let child = c::start_removing_dentry(parent, victim.dentry);
+        if errptr_to_result(NonNull::new(child).expect("a dentry, or an error")).is_err() {
+            c::dput(parent);
+            c::mnt_drop_write(victim.mnt);
+            c::path_put(&victim);
+            return child;
+        }
+        // The parent's path, with the victim's mount reference: child is a
+        // reference of its own
+        *path = c::path { mnt: victim.mnt, dentry: parent };
+        c::dput(victim.dentry);
+        child
+    }
+}
+
+#[cfg(not(linux_ge = "6.18"))]
+unsafe fn start_removing(dirfd: c_int, name: *const c_char, path: *mut c::path) -> *mut c::dentry {
+    unsafe {
+        let victim = c::user_path_locked_at(dirfd, name, path);
+        if errptr_to_result(NonNull::new(victim).expect("a dentry, or an error")).is_err() {
+            return victim;
+        }
+        let dir = (*(*path).dentry).d_inode;
+
+        c::inode_unlock(dir);
+        let mut ret = c::mnt_want_write((*path).mnt);
+        c::inode_lock(dir);
+
+        // A NULL pprev: unhashed, d_unhashed()
+        if ret == 0 && ((*victim).d_hash.pprev.is_null() || (*victim).d_parent != (*path).dentry) {
+            c::mnt_drop_write((*path).mnt);
+            ret = -(c::ENOENT as c_int);
+        }
+        if ret != 0 {
+            c::inode_unlock(dir);
+            c::dput(victim);
+            c::path_put(path);
+            return crate::errcode::err_ptr(BchError::from_raw(-ret));
+        }
+        victim
+    }
+}
diff --git a/fs/bcachefs/vfs/status_fd.rs b/fs/bcachefs/vfs/status_fd.rs
new file mode 100644
index 0000000..dd2029d
--- /dev/null
+++ b/fs/bcachefs/vfs/status_fd.rs
@@ -0,0 +1,179 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! The status fd: mount.bcachefs's channel to the filesystem coming up, which
+//! it asks for with the "status_fd" fsconfig parameter. The filesystem's
+//! questions and hard errors come out of it, its answers go in, and its
+//! ioctl answers what the filesystem would - recovery's progress, notably,
+//! for a caller drawing it.
+//!
+//! A stdio file with no thread: the mounting task does the work, printing
+//! as it goes. The channel outlives the fs_context - userspace still holds
+//! the fd - so the mount holds a ref on the file for as long as anything may
+//! print there, and the file frees the channel when both are gone.
+
+use crate::c;
+use crate::fs::Fs;
+use crate::init::chardev::{fs_ioctl, ioctl_ret};
+use crate::locking::Lock;
+use crate::new_lock;
+use crate::util::ffi::Opaque;
+use crate::util::ioctl::Ioctl;
+use crate::util::thread_with_file::{Stdio, StdioFile, ThreadWithFile};
+use core::ffi::c_void;
+use core::mem::size_of;
+use core::ptr::NonNull;
+use cstruct_macros::c_export;
+use kernel::ffi::{c_int, c_long, c_uint, c_ulong};
+use kernel::uaccess::UserPtr;
+use pin_init::{pin_data, pin_init};
+
+#[pin_data]
+struct StatusFd {
+    /// The filesystem coming up on this channel. The mounting thread sets it
+    /// around bch2_fs_start() and clears it after, because that is the only
+    /// window where we know it's alive - the fd outlives the mount either way.
+    ///
+    /// A mutex, not a spinlock, because the ioctl hands the filesystem to
+    /// bch2_fs_ioctl(), which sleeps: the lock has to be held across that
+    /// call, or the mounting thread could return from bch2_fs_start() and
+    /// tear it down underneath it. The only waiter is that thread, once, at
+    /// the end of the mount.
+    #[pin]
+    fs: Lock<c::mutex, Option<NonNull<Fs>>>,
+}
+
+// SAFETY: the filesystem's every thread's, and only touched under @fs's lock
+unsafe impl Send for StatusFd {}
+unsafe impl Sync for StatusFd {}
+
+impl StdioFile for StatusFd {
+    fn ioctl(&self, cmd: c_uint, arg: c_ulong) -> c_long {
+        let mut status = c::bch_ioctl_recovery_status::default();
+        {
+            let fs = self.fs.lock();
+            let Some(fs) = *fs else {
+                return -(c::ENODEV as c_long);
+            };
+            // SAFETY: set only while it's alive, and we hold the lock
+            let fs = unsafe { fs.as_ref() };
+
+            // Everything else this filesystem answers, it answers here: the
+            // chardev's ioctl exists to turn a minor back into a bch_fs, and
+            // we already have one. This is the only handle on a filesystem
+            // that hasn't finished mounting, so it's the only way to ask it
+            // anything - bcachefs<N>-ctl exists by now, but nothing knows the
+            // minor.
+            //
+            // Safe to pass everything through: the dispatch answers the
+            // read-only queries and then refuses anything else until
+            // BCH_FS_started, which isn't set until recovery is done.
+            if cmd != <c::BCH_IOCTL_RECOVERY_STATUS as Ioctl>::OPCODE {
+                return ioctl_ret(fs_ioctl(fs, cmd, UserPtr::from_addr(arg as usize)));
+            }
+
+            // Whoever's asking is drawing it: keep it off the console.
+            // SAFETY: a flag C reads as READ_ONCE()
+            unsafe { core::ptr::write_volatile(&raw mut (*fs.as_ptr()).stdio_progress_reader, true) };
+
+            let r = &fs.recovery;
+            {
+                let _runner = r.runner.lock();
+                status.passes_scheduled_ephemeral.v[0] = r.runner.scheduled_passes_ephemeral.get();
+                status.passes_complete.v[0]            = r.runner.passes_complete.get();
+                status.passes_remaining.v[0]           = r.runner.current_passes.get();
+                status.pass                            = r.runner.current_pass.get() as u32;
+            }
+
+            status.passes_scheduled_sb.v[0] = fs.sb.recovery_passes_required.get();
+            let (units, seen, total) = r.progress.status();
+            (status.units, status.seen, status.total) = (units.0, seen, total);
+        }
+
+        // SAFETY: copy_to_user() checks the caller's buffer is theirs
+        if unsafe {
+            c::copy_to_user(arg as *mut c_void, (&raw const status).cast(),
+                            size_of::<c::bch_ioctl_recovery_status>() as _)
+        } != 0 {
+            -(c::EFAULT as c_long)
+        } else {
+            0
+        }
+    }
+}
+
+/// # Safety
+/// @file is bch2_status_fd_open()'s, its ref still held.
+unsafe fn status_of<'a>(file: *mut c::file) -> &'a Stdio<StatusFd> {
+    unsafe { ThreadWithFile::<Stdio<StatusFd>>::from_file(file) }
+}
+
+/// A new status channel: its fd, for userspace, and in @filep a ref on its
+/// file, for the mount - put by bch2_status_fd_put().
+#[c_export]
+pub unsafe fn bch2_status_fd_open(filep: *mut *mut c::file) -> c_int {
+    let status = ThreadWithFile::new_stdio(pin_init!(StatusFd {
+        fs <- new_lock!(None),
+    }? crate::errcode::BchError));
+
+    match status.and_then(|s| s.get_fd()) {
+        Ok((fd, file)) => {
+            unsafe { *filep = file.as_ptr() };
+            fd
+        }
+        Err(e) => -e.raw(),
+    }
+}
+
+/// @c starts up with the channel: what it prints for the user, and its
+/// questions, go to it, and its ioctl answers for @c.
+///
+/// # Safety
+/// @file is bch2_status_fd_open()'s, its ref held; @c is alive until
+/// bch2_status_fd_detach().
+#[c_export]
+pub unsafe fn bch2_status_fd_attach(file: *mut c::file, c: &Opaque<c::bch_fs>) {
+    let status = unsafe { status_of(file) };
+    let fs = Fs::from_c(c);
+
+    // SAFETY: as C's: set while the mount's in recovery, which is the
+    // mounting thread
+    unsafe {
+        (*fs.as_ptr()).stdio = status.redirect.as_c();
+        (*fs.as_ptr()).stdio_user_only = true;
+    }
+    *status.data.fs.lock() = Some(NonNull::from(fs));
+}
+
+/// Recovery's over, however it went: @c's no longer the channel's.
+///
+/// # Safety
+/// As bch2_status_fd_attach().
+#[c_export]
+pub unsafe fn bch2_status_fd_detach(file: *mut c::file, c: &Opaque<c::bch_fs>) {
+    let status = unsafe { status_of(file) };
+    let fs = Fs::from_c(c);
+
+    // Clearing the channel's filesystem first is what makes the reader flag
+    // safe to clear after it: the ioctl only sets it having seen a
+    // filesystem under this lock, so no further ioctl can set it.
+    *status.data.fs.lock() = None;
+
+    unsafe {
+        (*fs.as_ptr()).stdio = core::ptr::null_mut();
+        (*fs.as_ptr()).stdio_user_only = false;
+        core::ptr::write_volatile(&raw mut (*fs.as_ptr()).stdio_progress_reader, false);
+    }
+}
+
+/// The mount is over however it went: close the channel, so a reader gets
+/// EOF rather than waiting for a filesystem that isn't coming, and put the
+/// mount's ref on the file - userspace holds the other, and the channel's
+/// freed when both are gone.
+///
+/// # Safety
+/// @file is bch2_status_fd_open()'s, its ref held, and put here.
+#[c_export]
+pub unsafe fn bch2_status_fd_put(file: *mut c::file) {
+    unsafe { status_of(file) }.redirect.set_done();
+    unsafe { c::fput(file) };
+}
diff --git a/fs/bcachefs/vfs/super_block.rs b/fs/bcachefs/vfs/super_block.rs
new file mode 100644
index 0000000..a433a9c
--- /dev/null
+++ b/fs/bcachefs/vfs/super_block.rs
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! The VFS's struct super_block, for Rust: the filesystem's, once it's
+//! mounted - Fs::vfs_super(), or an inode's, VfsInode::sb(). A SuperBlock is
+//! always one of ours: its s_fs_info is its Fs, set before it has an inode
+//! and live until the last is evicted.
+//!
+//! Its operations are a trait, SuperOps, declared by vfs_ops! (ops.rs): Self
+//! is what s_fs_info points to - Fs - and each op gets it as &self, but
+//! free_inode(), which can run after the filesystem's freed.
+//!
+//! bch2_super_ops is ours, the table mount sets s_op to. evict_inode() and
+//! free_inode() are still fs.c's, with the inode cache.
+
+use core::ffi::{c_int, CStr};
+use core::ptr::NonNull;
+
+use crate::accounting;
+use crate::alloc::capacity::avail_factor;
+use crate::c;
+use crate::errcode::{ret_to_result_void, BchError};
+use crate::fs::Fs;
+use crate::inode_opts;
+use crate::locking::Lock;
+use crate::prt;
+use crate::sb::counters::events;
+use crate::util::ffi::Opaque;
+use crate::util::kernel::ktime_get_ns;
+use crate::util::{Nsecs, Printbuf};
+use crate::util::rcu::read_lock;
+use crate::util::seq_file::SeqFile;
+use cstruct_macros::{c_export, c_extern, vtable};
+
+use super::dentry::Dentry;
+use super::inode::{InodeInfo, ATTR_ATIME, ATTR_CTIME, ATTR_MTIME};
+
+c_extern! {
+    // fs.c's, with the inode cache:
+    fn bch2_evict_inode(vinode: *mut c::inode);
+    fn bch2_free_inode(vinode: *mut c::inode);
+}
+
+#[repr(transparent)]
+pub struct SuperBlock(Opaque<c::super_block>);
+
+impl Fs {
+    /// The VFS superblock it's mounted as: None while it isn't.
+    pub fn vfs_super(&self) -> Option<&SuperBlock> {
+        // SAFETY: set at mount, live until unmount clears it
+        unsafe { self.vfs_sb.cast::<SuperBlock>().as_ref() }
+    }
+}
+
+impl SuperBlock {
+    /// # Safety
+    /// @sb is one of ours, live for 'a.
+    pub(crate) unsafe fn from_raw<'a>(sb: *mut c::super_block) -> &'a SuperBlock {
+        unsafe { &*sb.cast::<SuperBlock>() }
+    }
+
+    fn as_ptr(&self) -> *mut c::super_block {
+        self.0.as_ptr()
+    }
+
+    pub fn fs(&self) -> &Fs {
+        unsafe { Fs::borrow_raw((*self.as_ptr()).s_fs_info.cast()) }
+    }
+
+    pub fn dev(&self) -> c::dev_t {
+        unsafe { (*self.as_ptr()).s_dev }
+    }
+}
+
+// ── The operations ───────────────────────────────────────────────────────
+
+crate::vfs_ops! {
+    pub(crate) trait SuperOps for c::super_operations, SuperVTable<T: SuperOps> = T;
+
+    fn alloc_inode(&self = sb, sb: &SuperBlock) -> Result<NonNull<c::inode>, BchError>;
+    /// The inode's memory, the VFS done with it - an RCU callback after
+    /// eviction, which can run after the filesystem's freed: no &self.
+    fn free_inode(inode: NonNull<InodeInfo>);
+    /// Not always referenced - iput_final() writes one back with i_count 0
+    /// - but I_SYNC or I_WILL_FREE keeps it from eviction meanwhile.
+    fn write_inode(&self = inode, inode: &InodeInfo, wbc: *mut c::writeback_control)
+        -> Result<(), BchError>;
+    /// I_FREEING: ours to evict, the superblock still up.
+    fn evict_inode(&self = inode, inode: &InodeInfo);
+    fn sync_fs(&self = sb, sb: &SuperBlock, wait: c_int) -> Result<(), BchError>;
+    fn statfs(&self = dentry, dentry: Dentry<'_>, buf: &mut c::kstatfs) -> Result<(), BchError>;
+    fn show_devname(&self = root, m: &SeqFile, root: Dentry<'_>) -> Result<(), BchError>;
+    fn show_options(&self = root, m: &SeqFile, root: Dentry<'_>) -> Result<(), BchError>;
+    /// The VFS's last op on the superblock.
+    fn put_super(&self = sb, sb: &SuperBlock);
+    fn freeze_fs(&self = sb, sb: &SuperBlock) -> Result<(), BchError>;
+    fn unfreeze_fs(&self = sb, sb: &SuperBlock) -> Result<(), BchError>;
+}
+
+// ── bcachefs's ───────────────────────────────────────────────────────────
+
+#[vtable]
+impl SuperOps for Fs {
+    /// Never the VFS's to call: our inodes are made by bch2_new_inode().
+    fn alloc_inode(&self, _sb: &SuperBlock) -> Result<NonNull<c::inode>, BchError> {
+        unreachable!("bcachefs inodes are allocated by bch2_new_inode()")
+    }
+
+    fn free_inode(inode: NonNull<InodeInfo>) {
+        unsafe { bch2_free_inode(inode.as_ptr().cast()) }
+    }
+
+    fn write_inode(&self, inode: &InodeInfo, _wbc: *mut c::writeback_control) -> Result<(), BchError> {
+        inode.update_lock().write_inode(ATTR_ATIME | ATTR_MTIME | ATTR_CTIME, |_, _| Ok(()))
+    }
+
+    fn evict_inode(&self, inode: &InodeInfo) {
+        unsafe { bch2_evict_inode(inode.vfs().as_ptr()) }
+    }
+
+    fn sync_fs(&self, _sb: &SuperBlock, wait: c_int) -> Result<(), BchError> {
+        let start = ktime_get_ns();
+        let disabled = self.opts().journal_flush_disabled != 0;
+
+        let ret = if disabled {
+            Ok(())
+        } else if wait == 0 {
+            unsafe { c::bch2_journal_flush_async(&raw mut (*self.as_ptr()).journal, core::ptr::null_mut()) };
+            Ok(())
+        } else {
+            self.journal_flush()
+        };
+
+        self.event_inc_trace(events::sync_fs, |out| {
+            prt!(out, "journal_flush_disabled: {}\n", disabled as u32);
+            prt!(out, "blocking: {}\n", wait);
+            prt!(out, "duration: {}\n", Nsecs(ktime_get_ns() - start));
+        });
+        ret
+    }
+
+    fn statfs(&self, dentry: Dentry<'_>, buf: &mut c::kstatfs) -> Result<(), BchError> {
+        let inode = dentry.inode();
+        let usage = self.usage_read_short();
+        let block_bytes = self.block_bytes();
+        let shift = block_bytes.ilog2() - 9;
+
+        // Inodes as 256 bytes each - 144 to 160 is typical, since bi_dir and
+        // bi_dir_offset, which shouldn't have been varints
+        let avail_inodes = (usage.capacity - usage.used) << 1;
+
+        // A reservation at the inode's replica count, from placeable space -
+        // whole free buckets - which applications size fallocate() from; and
+        // never more than capacity less used
+        let opts = inode_opts::get_inode(self, &inode.inode());
+        let nr_replicas = (opts.data_replicas as usize).clamp(1, c::BCH_REPLICAS_MAX as usize);
+        let placeable = self.sectors_placeable().eventual[nr_replicas - 1];
+        let avail = avail_factor(usage.free).min(placeable) / nr_replicas as u64;
+
+        buf.f_type    = c::BCACHEFS_STATFS_MAGIC as _;
+        buf.f_bsize   = block_bytes as _;
+        buf.f_blocks  = usage.capacity >> shift;
+        buf.f_bfree   = usage.free >> shift;
+        buf.f_bavail  = avail >> shift;
+        buf.f_files   = accounting::nr_inodes(self) + avail_inodes;
+        buf.f_ffree   = avail_inodes;
+        let mut uuid = self.sb.user_uuid.each_ref().map(|b| b.get());
+        buf.f_fsid    = unsafe { c::uuid_to_fsid(uuid.as_mut_ptr()) };
+        buf.f_namelen = c::BCH_NAME_MAX as _;
+        Ok(())
+    }
+
+    fn show_devname(&self, m: &SeqFile, _root: Dentry<'_>) -> Result<(), BchError> {
+        let rcu = read_lock();
+        for (i, ca) in self.online_devs_rcu(&rcu).enumerate() {
+            if i > 0 {
+                m.write(b":");
+            }
+            // SAFETY: an online device's, set while it's open
+            m.write(unsafe { CStr::from_ptr(ca.disk_sb.sb_name.cast()) }.to_bytes());
+        }
+        Ok(())
+    }
+
+    fn show_options(&self, m: &SeqFile, _root: Dentry<'_>) -> Result<(), BchError> {
+        let mut out = Printbuf::new();
+        // No superblock: with the filesystem, every option's to_text reads it
+        crate::opts::opts_to_text(&mut out, self.opts(), Some(self), None, Some(&self.mount_opts),
+                                  c::opt_flags::OPT_MOUNT.bits(), c::opt_flags::OPT_HIDDEN.bits(),
+                                  c::OPT_SHOW_MOUNT_STYLE);
+        if out.allocation_failure() {
+            return Err(BchError::from(c::ENOMEM));
+        }
+        m.write(b",");
+        m.write(out.as_bytes());
+        Ok(())
+    }
+
+    fn put_super(&self, _sb: &SuperBlock) {
+        unsafe { c::bch2_fs_stop(self.as_ptr()) };
+    }
+
+    fn freeze_fs(&self, _sb: &SuperBlock) -> Result<(), BchError> {
+        let _state = Lock::from_c(&self.state_lock).write();
+        self.read_only();
+        Ok(())
+    }
+
+    fn unfreeze_fs(&self, _sb: &SuperBlock) -> Result<(), BchError> {
+        if self.flag(c::bch_fs_flags::BCH_FS_emergency_ro) {
+            return Ok(());
+        }
+        let _state = Lock::from_c(&self.state_lock).write();
+        ret_to_result_void(unsafe { c::bch2_fs_read_write(self.as_ptr()) })
+    }
+}
+
+#[c_export]
+pub static bch2_super_ops: c::super_operations = SuperVTable::<Fs>::OPS;
diff --git a/fs/bcachefs/vfs/types.rs b/fs/bcachefs/vfs/types.rs
new file mode 100644
index 0000000..a72bdbf
--- /dev/null
+++ b/fs/bcachefs/vfs/types.rs
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::types::c_default;
+use cstruct_macros::{CStruct, TypeInfo};
+
+/*
+ * An inode number that something in memory is holding: membership in
+ * @inodes_by_inum_table below.
+ *
+ * bch2_inode_or_descendents_is_open() consults that table and nothing else, so
+ * that fsck won't delete an unlinked inode out from under a live reference.
+ * Membership - not the existence of a bch_inode_info - is therefore what
+ * matters, and this is a standalone type so an entry can be held without one:
+ * an unlinked on-disk inode becomes visible to a scanning fsck pass at
+ * bch2_trans_commit(), which for O_TMPFILE is before __bch2_create() has a VFS
+ * inode to hash.
+ *
+ * @inum is kept whole rather than split into its fields because
+ * @inodes_table keys on the entire subvol_inum.
+ */
+#[repr(C)]
+#[derive(Clone, Copy, CStruct, TypeInfo)]
+pub struct bch_inum_hash_entry {
+    pub hash: c::rhlist_head,
+    pub inum: c::subvol_inum,
+}
+c_default!(bch_inum_hash_entry);
+
+#[repr(C)]
+#[derive(Clone, Copy, CStruct, TypeInfo)]
+pub struct bch_fs_vfs {
+    pub inodes: c::fast_list,
+    pub inodes_table: c::rhashtable,
+    /*
+     * Keyed on the inode number alone, not (subvol, inum): a query asks
+     * whether any snapshot version of an inode number is held, so every
+     * version has to land in one bucket. Hence an rhltable - the key is
+     * deliberately non-unique.
+     */
+    pub inodes_by_inum_table: c::rhltable,
+
+    pub writepage_bioset: c::bio_set,
+    pub dio_write_bioset: c::bio_set,
+    pub dio_read_bioset: c::bio_set,
+    pub nocow_flush_bioset: c::bio_set,
+    pub writepage_buf_pool: c::mempool_t,
+    pub writeback_wq: *mut c::workqueue_struct,
+}
+c_default!(bch_fs_vfs);
diff --git a/fs/bcachefs/vfs/vfs_inode.rs b/fs/bcachefs/vfs/vfs_inode.rs
new file mode 100644
index 0000000..a7db998
--- /dev/null
+++ b/fs/bcachefs/vfs/vfs_inode.rs
@@ -0,0 +1,177 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! The kernel's struct inode, for Rust: VfsInode, InodeInfo's @v. All Rust
+//! reads and writes of the VFS inode are here.
+//!
+//! The VFS, update_after_write() and i_sectors_acct write its fields while
+//! others read them, with no lock in common. Those read or written here
+//! directly - mode, flags, generation, blocks, and reads of the ids and the
+//! link count - are read and written whole, as READ_ONCE() and WRITE_ONCE(),
+//! where C uses them plainly; the rest - the times, the size, writes of the
+//! ids and link count - go through the kernel's helpers.
+//!
+//! Its reference count, i_count, is AlwaysRefCounted's - ihold(), iput() - so
+//! an InodeRef, ARef<InodeInfo>, holds one.
+
+use crate::c;
+use crate::util::ffi::Opaque;
+#[cfg(kernel)]
+use {
+    core::ffi::c_int,
+    core::ptr::{read_volatile, write_volatile, NonNull},
+    crate::acl::{AclType, PosixAcl},
+    crate::errcode::{ret_to_result_void as ret_to_result, BchError},
+    kernel::sync::aref::AlwaysRefCounted,
+    super::super_block::SuperBlock,
+    crate::locking::Lock,
+};
+
+/// A struct inode of ours - one InodeInfo's - referenced while this is
+/// borrowed. Both builds lay it out; only the kernel's has a VFS.
+#[repr(transparent)]
+pub struct VfsInode(Opaque<c::inode>);
+
+/// VfsInode's accessors that are a read or write and nothing else, as a
+/// table: name() -> T, or name(T) to set, and how - a field read or written
+/// whole, READ_ONCE() or WRITE_ONCE(), or the kernel helper that does it.
+#[cfg(kernel)]
+macro_rules! accessors {
+    () => {};
+    ($(#[$m:meta])* $name:ident() -> $t:ty = READ_ONCE($($f:ident).+); $($rest:tt)*) => {
+        $(#[$m])* pub fn $name(&self) -> $t {
+            unsafe { read_volatile(&raw const (*self.as_ptr()).$($f).+) }
+        }
+        accessors!($($rest)*);
+    };
+    ($(#[$m:meta])* $name:ident($t:ty) = WRITE_ONCE($($f:ident).+); $($rest:tt)*) => {
+        $(#[$m])* pub fn $name(&self, v: $t) {
+            unsafe { write_volatile(&raw mut (*self.as_ptr()).$($f).+, v) }
+        }
+        accessors!($($rest)*);
+    };
+    ($(#[$m:meta])* $name:ident() -> $t:ty = $helper:ident; $($rest:tt)*) => {
+        $(#[$m])* pub fn $name(&self) -> $t {
+            unsafe { c::$helper(self.as_ptr()) }
+        }
+        accessors!($($rest)*);
+    };
+    ($(#[$m:meta])* $name:ident($t:ty) = $helper:ident; $($rest:tt)*) => {
+        $(#[$m])* pub fn $name(&self, v: $t) {
+            unsafe { c::$helper(self.as_ptr(), v) };
+        }
+        accessors!($($rest)*);
+    };
+}
+
+#[cfg(kernel)]
+impl VfsInode {
+    pub fn as_ptr(&self) -> *mut c::inode {
+        self.0.as_ptr()
+    }
+
+    pub fn sb(&self) -> &SuperBlock {
+        // SAFETY: set at allocation, to our superblock, which outlives it
+        unsafe { &*(*self.as_ptr()).i_sb.cast::<SuperBlock>() }
+    }
+
+    accessors! {
+        /// The user namespace its ids are stored in.
+        user_ns() -> *mut c::user_namespace = i_user_ns;
+        kuid() -> c::kuid_t                 = READ_ONCE(i_uid);
+        kgid() -> c::kgid_t                 = READ_ONCE(i_gid);
+        set_uid(u32)                        = i_uid_write;
+        set_gid(u32)                        = i_gid_write;
+        mode() -> c::umode_t                = READ_ONCE(i_mode);
+        set_mode(c::umode_t)                = WRITE_ONCE(i_mode);
+        generation() -> u32                 = READ_ONCE(i_generation);
+        /// Changed under ei_quota_lock: hold it for a stable value.
+        blocks() -> u64                     = READ_ONCE(i_blocks);
+        nlink() -> u32                      = READ_ONCE(__bindgen_anon_1.i_nlink);
+        set_nlink(u32)                      = set_nlink;
+        size() -> i64                       = i_size_read;
+        set_size(i64)                       = i_size_write;
+        /// Now, at the granularity its times are kept at.
+        current_time() -> c::timespec64     = current_time;
+        atime() -> c::timespec64            = inode_get_atime;
+        mtime() -> c::timespec64            = inode_get_mtime;
+        ctime() -> c::timespec64            = inode_get_ctime;
+        set_atime(c::timespec64)            = inode_set_atime_to_ts;
+        set_mtime(c::timespec64)            = inode_set_mtime_to_ts;
+        set_ctime(c::timespec64)            = inode_set_ctime_to_ts;
+    }
+
+    // ── Ownership ────────────────────────────────────────────────────────
+
+    /// @kuid as the inode stores it, a number in its user namespace.
+    pub fn uid_of(&self, kuid: c::kuid_t) -> u32 {
+        unsafe { c::from_kuid(self.user_ns(), kuid) }
+    }
+
+    pub fn gid_of(&self, kgid: c::kgid_t) -> u32 {
+        unsafe { c::from_kgid(self.user_ns(), kgid) }
+    }
+
+    // ── Mode and flags ───────────────────────────────────────────────────
+
+    pub fn is_dir(&self) -> bool {
+        self.mode() as u32 & c::S_IFMT == c::S_IFDIR
+    }
+
+    pub fn is_reg(&self) -> bool {
+        self.mode() as u32 & c::S_IFMT == c::S_IFREG
+    }
+
+    /// Set when it's made, and never changed.
+    pub fn rdev(&self) -> c::dev_t {
+        unsafe { (*self.as_ptr()).i_rdev }
+    }
+
+    pub fn flag(&self, flag: u32) -> bool {
+        let flags = unsafe { read_volatile(&raw const (*self.as_ptr()).i_flags) };
+        flags & flag != 0
+    }
+
+    /// A read-modify-write, not atomic, as C's |= and &= aren't: the VFS's
+    /// own i_flags writes can race it, as they race C's.
+    pub fn set_flag(&self, flag: u32, on: bool) {
+        let p = unsafe { &raw mut (*self.as_ptr()).i_flags };
+        unsafe {
+            let flags = read_volatile(p);
+            write_volatile(p, if on { flags | flag } else { flags & !flag });
+        }
+    }
+
+    /// i_rwsem held for write: inode_lock(), as the VFS takes it for a
+    /// namespace operation or setattr.
+    pub fn assert_locked(&self) {
+        // SAFETY: c::rw_semaphore is the kernel's, i_rwsem one
+        let l = unsafe { &*(&raw const (*self.as_ptr()).i_rwsem).cast::<c::rw_semaphore>() };
+        Lock::from_c(l).assert_held();
+    }
+
+    // ── ACLs ─────────────────────────────────────────────────────────────
+
+    /// None caches that there's none. The cache takes a reference of its own.
+    pub fn set_cached_acl(&self, ty: AclType, acl: Option<&PosixAcl>) {
+        let acl = acl.map_or(core::ptr::null_mut(), PosixAcl::as_raw);
+        unsafe { c::set_cached_acl(self.as_ptr(), ty as c_int, acl) }
+    }
+
+    // ── The page cache ───────────────────────────────────────────────────
+
+    pub fn write_and_wait(&self) -> Result<(), BchError> {
+        ret_to_result(unsafe { c::rust_filemap_write_and_wait_range((*self.as_ptr()).i_mapping, 0, i64::MAX) })
+    }
+}
+
+// SAFETY: a borrowed VfsInode is referenced, as ihold() requires
+#[cfg(kernel)]
+unsafe impl AlwaysRefCounted for VfsInode {
+    fn inc_ref(&self) {
+        unsafe { c::ihold(self.as_ptr()) }
+    }
+
+    unsafe fn dec_ref(obj: NonNull<Self>) {
+        unsafe { c::iput(obj.as_ptr().cast()) }
+    }
+}
-- 
