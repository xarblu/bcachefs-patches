+impl<T: FnOnce()> WorkItem for ClosureWork<T> {
+    type Pointer = Pin<KBox<Self>>;
+
+    fn run(mut this: Pin<KBox<Self>>) {
+        if let Some(func) = this.as_mut().project().func.take() {
+            (func)()
+        }
+    }
