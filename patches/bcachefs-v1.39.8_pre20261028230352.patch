+
+    /// bit_mod(), at @iter's position: bch2_btree_bit_mod_iter().
+    pub fn bit_mod_iter(&self, iter: &BtreeIter<'a>, set: bool) -> Result<(), BchError> {
+        let ret = unsafe { c::bch2_btree_bit_mod_iter(self.raw(), iter.raw(), set) };
+        self.result(ret)
