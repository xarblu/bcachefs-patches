index 0000000..fbc82c9
--- /dev/null
+++ b/fs/bcachefs/fs/check.rs
@@ -0,0 +1,1051 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Helpers shared by the fsck passes.
+
+use crate::btree::bkey::{pos, spos, BkeyI, BkeySC};
+use crate::btree::bkey::prelude::*;
+use crate::btree::iter::{
+    BtreeIter, BtreeIterFlags, CommitFlags, TransAttempt, UpdateTriggerFlags,
+};
+use crate::c;
+use crate::errcode::{bch_errcode, BchError};
+use crate::fs::Fs;
+use crate::init::error::id;
+use crate::inode;
+use crate::dirent::{Dirent, DirentTarget};
+use crate::errcode::Found;
+use crate::snapshots::{snapshot, subvolume};
+use crate::alloc::capacity::DiskReservation;
+use crate::util::alloc::{flags::GFP_KERNEL, kvvec_insert, KVVec};
+use crate::util::Printbuf;
+use crate::{bch_err, bch_err_msg, bch_info, fsck_err_on, inode_fsck_err, prt};
+use core::ops::ControlFlow;
+
+/// The snapshots of the keys seen so far at one position, while walking a
+/// btree in key order with all snapshots: a key in an ancestor is hidden from
+/// a descendant that overwrote it. C only passes it through, from check_key()
+/// back to __bch2_str_hash_check_key().
+pub struct SnapshotsSeen {
+    pos: c::bpos,
+    /// Ascending, as seen in key order, plus any a repair added in order.
+    ids: KVVec<u32>,
+}
+
+impl SnapshotsSeen {
+    pub fn new() -> Self {
+        SnapshotsSeen { pos: Default::default(), ids: KVVec::new() }
+    }
+
+    /// Record a key at @pos; a new inode:offset starts the list over.
+    pub fn update(&mut self, pos: c::bpos) -> Result<(), BchError> {
+        if self.pos.inode != pos.inode || self.pos.offset != pos.offset {
+            self.ids.clear();
+        }
+        self.pos = pos;
+
+        if !self.has_id(pos.snapshot) {
+            self.ids.push(pos.snapshot, GFP_KERNEL)?;
+        }
+        Ok(())
+    }
+
+    /// Whether a key in @ancestor is visible in its descendant @id: not
+    /// overwritten by a key this list has seen.
+    pub fn key_visible(&self, t: &TransAttempt<'_, '_>, id: u32, ancestor: u32) -> bool {
+        debug_assert!(id <= ancestor);
+
+        if id == ancestor {
+            return true;
+        }
+        if !snapshot::is_ancestor(t, id, ancestor) {
+            return false;
+        }
+
+        // Overwritten by a key seen in a snapshot between the two?
+        !self.ids.iter().any(|&i| i != ancestor && snapshot::is_ancestor(t, id, i))
+    }
+
+    /// Whether a key in @src points at something visible as a key in @dst, in
+    /// some snapshot. The @src keys must be walked in key order, recorded here.
+    pub fn ref_visible(&self, t: &TransAttempt<'_, '_>, src: u32, dst: u32) -> bool {
+        if dst <= src {
+            self.key_visible(t, dst, src)
+        } else {
+            snapshot::is_ancestor(t, src, dst)
+        }
+    }
+
+    /// The snapshots that have overwritten the key at @pos in @btree, as if a walk
+    /// had seen them: for a key checked out of walk order.
+    pub fn overwrites(t: &TransAttempt<'_, '_>, btree: c::btree_id, pos: c::bpos)
+        -> Result<Self, BchError>
+    {
+        Ok(SnapshotsSeen { pos, ids: snapshot::overwrites(t, btree, pos)? })
+    }
+
+    /// Whether a key in snapshot @id has been seen at this position.
+    pub fn has_id(&self, id: u32) -> bool {
+        self.ids.contains(&id)
+    }
+
+    /// A copy, to keep the list as it was at this key while the walk goes on.
+    pub fn try_clone(&self) -> Result<Self, BchError> {
+        let mut ids = KVVec::with_capacity(self.ids.len(), GFP_KERNEL)?;
+        for &i in self.ids.iter() {
+            ids.push(i, GFP_KERNEL)?;
+        }
+        Ok(SnapshotsSeen { pos: self.pos, ids })
+    }
+
+    /// For a key a repair created at this position: kept sorted.
+    pub fn add_inorder(&mut self, id: u32) -> Result<(), BchError> {
+        match self.ids.iter().position(|&i| i >= id) {
+            Some(idx) if self.ids[idx] == id => {}
+            Some(idx) => kvvec_insert(&mut self.ids, idx, id)?,
+            None => self.ids.push(id, GFP_KERNEL)?,
+        }
+        Ok(())
+    }
+}
+
+/// Whether a key in @src and one in @dst are both visible in some snapshot:
+/// one an ancestor of the other, not overwritten in between.
+pub fn ref_visible2(
+    t:        &TransAttempt<'_, '_>,
+    src:      u32,
+    src_seen: &SnapshotsSeen,
+    dst:      u32,
+    dst_seen: &SnapshotsSeen,
+) -> bool {
+    if dst > src {
+        dst_seen.key_visible(t, src, dst)
+    } else {
+        src_seen.key_visible(t, dst, src)
+    }
+}
+
+/// Every version of the inode the walked keys belong to, for passes walking a
+/// btree keyed by inode number (xattrs, dirents, extents) with all snapshots.
+/// Cached between keys of one inode, refetched on the next inode or after a
+/// commit; sorted by snapshot ID, each with the pass's counts (i_sectors,
+/// subdirectories).
+pub struct InodeWalker {
+    first_this_inode: bool,
+    have_inodes:      bool,
+    recalculate_sums: bool,
+    last_pos:         c::bpos,
+    /// The versions are valid while the transaction's commit_count is this.
+    commit_count:     u32,
+    inodes:           KVVec<WalkerEntry>,
+    /// From get_visible(): snapshots where a whiteout hides older versions.
+    deletes:          KVVec<u32>,
+    /// A repair changed an inode's type: see take_changed_inode_type().
+    changed_inode_type: bool,
+}
+
+/// One version of the walked inode - or a whiteout, where the inode was
+/// deleted in that snapshot - and what the pass has counted against it.
+#[derive(Clone, Copy)]
+pub struct WalkerEntry {
+    pub inode:    c::bch_inode_unpacked,
+    pub whiteout: bool,
+    pub count:    u64,
+}
+
+impl WalkerEntry {
+    fn new(fs: &Fs, k: BkeySC<'_>) -> Self {
+        let whiteout = !inode::bkey_is_inode(k.k);
+        let inode = if whiteout {
+            c::bch_inode_unpacked {
+                bi_inum:     k.k.p.offset,
+                bi_snapshot: k.k.p.snapshot,
+                ..Default::default()
+            }
+        } else {
+            inode::unpack(fs, k)
+        };
+        WalkerEntry { inode, whiteout, count: 0 }
+    }
+}
+
+/// The live inode version a key belongs to, from InodeWalker::walk().
+pub struct Walked<'w> {
+    pub inode:            &'w mut c::bch_inode_unpacked,
+    /// The first key walked in this inode: per-inode state such as the
+    /// bch_hash_info is set up here. Reading it clears it.
+    pub first_this_inode: bool,
+}
+
+impl InodeWalker {
+    pub fn new() -> Self {
+        InodeWalker {
+            first_this_inode: false,
+            have_inodes:      false,
+            recalculate_sums: false,
+            last_pos:         Default::default(),
+            commit_count:     0,
+            inodes:           KVVec::new(),
+            deletes:          KVVec::new(),
+            changed_inode_type: false,
+        }
+    }
+
+    /// The live version @k belongs to: None if @k is a tombstone, or its inode is
+    /// missing or a whiteout. A missing inode, or one of the wrong type, is
+    /// reported and repaired, which may commit and return a restart; on an error
+    /// the cache is invalidated, so the retry reads the btree.
+    pub fn walk<'w, 't>(
+        &'w mut self,
+        t:    &TransAttempt<'_, 't>,
+        iter: &BtreeIter<'t>,
+        k:    BkeySC<'_>,
+    ) -> Result<Option<Walked<'w>>, BchError> {
+        let i = match self.walk_and_check(t, iter, k) {
+            Ok(i) => i,
+            Err(e) => {
+                // Keep last_pos on this inode: a retry that saw a new inode
+                // would have the caller check this one's sums half counted
+                self.last_pos = k.k.p;
+                self.invalidate();
+                return Err(e);
+            }
+        };
+
+        let Some(i) = i.filter(|&i| !self.inodes[i].whiteout) else { return Ok(None) };
+
+        let first_this_inode = core::mem::take(&mut self.first_this_inode);
+        Ok(Some(Walked { inode: &mut self.inodes[i].inode, first_this_inode }))
+    }
+
+    /// The index of the version @k resolves to, if any.
+    fn walk_and_check<'t>(
+        &mut self,
+        t:    &TransAttempt<'_, 't>,
+        iter: &BtreeIter<'t>,
+        k:    BkeySC<'_>,
+    ) -> Result<Option<usize>, BchError> {
+        if self.last_pos.inode != k.k.p.inode {
+            self.get_inodes_all_snapshots(t, k.k.p.inode)?;
+        } else if self.commit_count != t.commit_count() {
+            // A commit may have changed cached inodes: refetch, and since we're partway
+            // through this inode's keys, recount rather than complain
+            self.get_inodes_all_snapshots(t, k.k.p.inode)?;
+            self.recalculate_sums = true;
+        }
+
+        self.last_pos = k.k.p;
+
+        let i = self.lookup_inode_for_snapshot(t, k)?;
+        self.check_key_has_inode(t, iter, i, k)?;
+        Ok(i)
+    }
+
+    /// Load every version of inode @inum, whiteouts included, in snapshot ID
+    /// order.
+    fn get_inodes_all_snapshots(&mut self, t: &TransAttempt<'_, '_>, inum: u64)
+        -> Result<(), BchError>
+    {
+        let fs = t.fs();
+
+        // No inodes for last_pos now: clear it, or a restart here would confuse
+        // check_i_sectors and check_subdir_count
+        self.have_inodes = false;
+        self.recalculate_sums = false;
+        self.inodes.clear();
+
+        let inodes = &mut self.inodes;
+        let mut iter = BtreeIter::new(t, c::btree_id::inodes, pos(0, inum),
+                                      BtreeIterFlags::ALL_SNAPSHOTS);
+        iter.for_each_max_norestart(t, spos(0, inum, u32::MAX), |_, k| {
+            inodes.push(WalkerEntry::new(fs, k), GFP_KERNEL)?;
+            Ok(())
+        })?;
+
+        self.first_this_inode = true;
+        self.have_inodes = true;
+        self.commit_count = t.commit_count();
+        Ok(())
+    }
+
+    /// The version @k belongs to: the nearest, in its snapshot or an ancestor. It
+    /// should be @k's own, a key's inode being updated with it; if it's an
+    /// ancestor's, the inode (or whiteout) is copied into @k's snapshot,
+    /// committed, and a restart returned.
+    fn lookup_inode_for_snapshot(&mut self, t: &TransAttempt<'_, '_>, k: BkeySC<'_>)
+        -> Result<Option<usize>, BchError>
+    {
+        let fs = t.fs();
+        let snapshot = k.k.p.snapshot;
+        let k_snapshot = fs.snapshots.redundant_interior(snapshot).unwrap_or(snapshot);
+
+        let Some(i) = self.inodes.iter()
+            .position(|i| snapshot::is_ancestor(t, k_snapshot, i.inode.bi_snapshot)) else {
+            return Ok(None);
+        };
+
+        let e = self.inodes[i];
+        let inode_snapshot = fs.snapshots.redundant_interior(e.inode.bi_snapshot)
+            .unwrap_or(e.inode.bi_snapshot);
+
+        if !fsck_err_on!(t, k_snapshot != inode_snapshot, id::snapshot_key_missing_inode_snapshot,
+                         "have key for inode {}:{snapshot} but have inode in ancestor snapshot {}\n\
+                          unexpected because we should always update the inode when we update a key in that inode\n\
+                          {}",
+                         { self.last_pos.inode }, e.inode.bi_snapshot, k.to_text(fs))? {
+            return Ok(Some(i));
+        }
+
+        if !e.whiteout {
+            let mut new = e.inode;
+            new.bi_snapshot = snapshot;
+            inode::fsck_write(t, &mut new)?;
+        } else {
+            let whiteout = t.bkey_alloc_init::<c::Whiteout>(0,
+                                             spos(0, e.inode.bi_inum, snapshot))?;
+            t.insert_with(c::btree_id::inodes, whiteout, BtreeIterFlags::CACHED,
+                          UpdateTriggerFlags::INTERNAL_SNAPSHOT_NODE)?;
+        }
+        t.commit(None, CommitFlags::empty())?;
+
+        // walk() invalidates on the restart: the retry refetches the versions,
+        // the one just written included
+        Err(t.restart(bch_errcode::BCH_ERR_transaction_restart_nested))
+    }
+
+    /// @k, in @iter's btree, has to belong to an inode of the matching type:
+    /// version @i, the one it resolved to. A missing inode is recreated, or
+    /// copied down from a good version in an ancestor snapshot, or - if it
+    /// looks deleted - @k is; one of the wrong type gets the type its keys
+    /// say it has.
+    fn check_key_has_inode<'t>(
+        &mut self,
+        t:    &TransAttempt<'_, 't>,
+        iter: &BtreeIter<'t>,
+        i:    Option<usize>,
+        k:    BkeySC<'_>,
+    ) -> Result<(), BchError> {
+        let fs = t.fs();
+        let btree = iter.btree();
+
+        // whiteouts and hash whiteouts are tombstones - they need no inode:
+        if k.k.is_extent_whiteout() || k.k.key_type() == c::bch_bkey_type::KEY_TYPE_hash_whiteout {
+            return Ok(());
+        }
+
+        let inodes = self.inodes();
+        // The version @k resolved to, unless that's a whiteout:
+        let live = i.filter(|&i| !inodes[i].whiteout);
+
+        if live.is_some_and(|l| btree_matches_i_mode(btree, inodes[l].inode.bi_mode)) {
+            return Ok(());
+        }
+
+        let mut buf = Printbuf::new();
+        match live {
+            Some(l) => write!(buf, "key for wrong inode mode {:o}", inodes[l].inode.bi_mode),
+            None    => write!(buf, "key in missing inode"),
+        }
+
+        let good_ancestor = inodes.iter().position(|i2| {
+            !i2.whiteout &&
+            snapshot::is_ancestor(t, k.k.p.snapshot, i2.inode.bi_snapshot) &&
+            btree_matches_i_mode(btree, i2.inode.bi_mode)
+        });
+        if let Some(g) = good_ancestor {
+            prt!(&mut buf, ", but found good inode in older snapshot{}\n", inodes[g].inode);
+        }
+
+        write!(buf, "\nfound keys:\n");
+
+        let inode_pos = spos(k.k.p.inode, 0, k.k.p.snapshot);
+        let nr_keys = count_inode_keys(t, inode_pos, btree, Some(&mut buf))?;
+        if nr_keys == 0 {
+            bch_err!(fs, "check_key_has_inode: error finding live keys in inode");
+            return Err(fs.err(bch_errcode::BCH_ERR_shutdown_with_errors_unfixed));
+        }
+
+        if nr_keys >= COUNT_INODE_KEYS_MAX {
+            writeln!(buf, "found {nr_keys}+ keys for this inode");
+        } else {
+            writeln!(buf, "found {nr_keys} keys for this inode");
+        }
+
+        let lost_data = fs.btree_lost_data(c::btree_id::inodes);
+        if lost_data {
+            writeln!(buf, "data was lost in inodes btree");
+        }
+
+        // Which repair: each edits a version in place
+        let fix = match live {
+            None => {
+                let inode_looks_deleted = good_ancestor.is_some() && nr_keys < 3 && !lost_data;
+                if inode_looks_deleted {
+                    writeln!(buf, "inode was deleted, will delete key");
+                }
+
+                if !inode_fsck_err!(t, k.k.p, id::key_in_missing_inode, "{buf}")? {
+                    return Ok(());
+                }
+
+                if inode_looks_deleted {
+                    return delete_stray_key(t, iter);
+                }
+
+                let Some(g) = good_ancestor else {
+                    reconstruct_inode(t, btree, k.k.p.snapshot, k.k.p.inode, None)?;
+                    t.commit(None, CommitFlags::NO_ENOSPC)?;
+                    return Err(t.restart(bch_errcode::BCH_ERR_transaction_restart_commit));
+                };
+
+                // A good ancestor is visible from @k, so the walk resolved @k
+                // to a version - a whiteout, there being no live one.
+                // XXX: which stays marked a whiteout - see check_extents
+                let i = i.expect("a good ancestor is visible, so @k resolved to a version");
+                let inodes = self.inodes_mut();
+                let snapshot = inodes[i].inode.bi_snapshot;
+                inodes[i].inode = inodes[g].inode;
+                inodes[i].inode.bi_snapshot = snapshot;
+                i
+            }
+            Some(l) => {
+                // Which is wrong, the inode's type or @k? If the inode has
+                // keys of its own type - in the btree its mode owns, if any -
+                // its type is right and @k is a stray. If it has none, its
+                // keys say what it is:
+                let mode = self.inodes()[l].inode.bi_mode;
+                let own_btree = [c::btree_id::extents, c::btree_id::dirents]
+                    .into_iter()
+                    .find(|&b| btree_matches_i_mode(b, mode));
+                let has_own_keys = match own_btree {
+                    Some(b) => count_inode_keys(t, inode_pos, b, None)? != 0,
+                    None    => false,
+                };
+
+                if has_own_keys {
+                    writeln!(buf, "inode has keys of its own type: deleting this one");
+                } else {
+                    writeln!(buf, "inode has no keys of its own type: changing its type to match");
+                }
+
+                if !inode_fsck_err!(t, k.k.p, id::key_in_wrong_inode_type, "{buf}")? {
+                    return Ok(());
+                }
+
+                if has_own_keys {
+                    return delete_stray_key(t, iter);
+                }
+
+                // A file's i_size has to cover its data, or the extents are
+                // past the end and go next: as a directory, it had none
+                let (ty, size) = if btree == c::btree_id::dirents {
+                    (c::S_IFDIR, 0)
+                } else {
+                    (c::S_IFREG, extents_end(t, k.k.p.inode, k.k.p.snapshot)?)
+                };
+
+                let inode = &mut self.inodes_mut()[l].inode;
+                inode.bi_mode = (inode.bi_mode & !(c::S_IFMT as c::umode_t)) | ty as c::umode_t;
+                inode.bi_size = inode.bi_size.max(size);
+                self.changed_inode_type = true;
+                l
+            }
+        };
+
+        // fsck_write(), not the self-committing write: inside the caller's commit
+        // loop that eats restarts, and leaks the advanced restart_count to the caller
+        inode::fsck_write(t, &mut self.inodes_mut()[fix].inode)?;
+        t.commit_lazy(None, CommitFlags::NO_ENOSPC)
+    }
+
+    /// Refetch on the next walk and recount the per-inode sums: the inodes
+    /// changed without a commit, or the walk is retrying. Spelled as a commit: the
+    /// walker refetches when commit_count isn't the one it recorded.
+    pub fn invalidate(&mut self) {
+        self.commit_count = self.commit_count.wrapping_sub(1);
+    }
+
+    /// The versions visible to a key in @snapshot: its own or its ancestors', not
+    /// overwritten by a version in a descendant @s has seen.
+    pub fn visible_mut<'a>(
+        &'a mut self,
+        t:        &'a TransAttempt<'_, '_>,
+        s:        &'a SnapshotsSeen,
+        snapshot: u32,
+    ) -> impl Iterator<Item = &'a mut WalkerEntry> {
+        self.inodes.iter_mut()
+            .take_while(move |i| i.inode.bi_snapshot <= snapshot)
+            .filter(move |i| s.key_visible(t, i.inode.bi_snapshot, snapshot))
+    }
+
+    /// Load the versions of inode @inum that a reference from @s's position
+    /// names - a dirent's target, not a walk: those visible from @s's snapshot,
+    /// newest first, and in deletes() the snapshots where a whiteout hides older
+    /// versions.
+    pub fn get_visible(
+        &mut self,
+        t:     &TransAttempt<'_, '_>,
+        s:     &SnapshotsSeen,
+        inum:  u64,
+    ) -> Result<(), BchError> {
+        let fs = t.fs();
+        let snapshot = s.pos.snapshot;
+
+        self.inodes.clear();
+        self.deletes.clear();
+
+        let (inodes, deletes) = (&mut self.inodes, &mut self.deletes);
+        let mut iter = BtreeIter::new(t, c::btree_id::inodes, spos(0, inum, snapshot),
+                                      BtreeIterFlags::ALL_SNAPSHOTS);
+        iter.for_each_reverse_norestart(t, pos(0, inum), |_, k| {
+            let id = k.k.p.snapshot;
+
+            if !s.ref_visible(t, snapshot, id) ||
+               deletes.iter().any(|&d| snapshot::is_ancestor(t, id, d)) {
+                return Ok(());
+            }
+
+            if inode::bkey_is_inode(k.k) {
+                inodes.push(WalkerEntry::new(fs, k), GFP_KERNEL)?;
+            } else {
+                deletes.push(id, GFP_KERNEL)?;
+            }
+            Ok(())
+        })?;
+
+        // We scan @snapshot and its descendants. With no version at @snapshot, it
+        // sees its nearest ancestor's - only that one, the rest shadowed by it.
+        // Normally there is one, since what makes a dirent writes its inode there;
+        // this is for what repair or corruption left. First, as the oldest, and
+        // shared with the ancestor's other descendants: writers use own_version().
+        if !self.inodes.iter().any(|i| i.inode.bi_snapshot == snapshot) &&
+           !self.deletes.contains(&snapshot) {
+            if let Some(u) = inode::find_by_inum_snapshot(t, inum, snapshot,
+                                                          BtreeIterFlags::empty()).found()? {
+                if u.bi_snapshot != snapshot {
+                    let e = WalkerEntry { inode: u, whiteout: false, count: 0 };
+                    kvvec_insert(&mut self.inodes, 0, e)?;
+                }
+            }
+        }
+        Ok(())
+    }
+
+    pub fn inodes(&self) -> &[WalkerEntry] {
+        &self.inodes
+    }
+
+    pub fn inodes_mut(&mut self) -> &mut [WalkerEntry] {
+        &mut self.inodes
+    }
+
+    /// From get_visible(): snapshots where the inode was deleted.
+    pub fn deletes(&self) -> &[u32] {
+        &self.deletes
+    }
+
+    /// The inode whose versions walk() has loaded, if any.
+    pub fn cur_inum(&self) -> Option<u64> {
+        self.have_inodes.then_some(self.last_pos.inode)
+    }
+
+    /// The versions were refetched partway through the inode, so its per-pass
+    /// counts are partial: recount them rather than reporting a mismatch.
+    pub fn recalculate_sums(&self) -> bool {
+        self.recalculate_sums
+    }
+
+    /// A repair changed what this inode's keys add up to: recount at the end
+    /// of the inode instead of reporting the mismatch.
+    pub fn set_recalculate_sums(&mut self) {
+        self.recalculate_sums = true;
+    }
+
+    /// Whether a repair has changed an inode's type since the last call. The
+    /// dirent pointing at it may already have been checked - its d_type, and
+    /// its directory's subdirectory count - under the old one.
+    pub fn take_changed_inode_type(&mut self) -> bool {
+        core::mem::take(&mut self.changed_inode_type)
+    }
+}
+
+impl Default for InodeWalker {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+/// Delete @iter's stray key, commit, and restart: the per-key checks carry on
+/// with the key they were handed, and a deleted dirent would be rehashed back
+/// in. With an empty disk reservation: an extents update needs one, and a
+/// deletion charges nothing.
+fn delete_stray_key<'t>(t: &TransAttempt<'_, 't>, iter: &BtreeIter<'t>) -> Result<(), BchError> {
+    let res = DiskReservation::new(t.fs());
+    t.delete_at(iter, UpdateTriggerFlags::INTERNAL_SNAPSHOT_NODE)?;
+    t.commit(Some(&res), CommitFlags::NO_ENOSPC)?;
+    Err(t.restart(bch_errcode::BCH_ERR_transaction_restart_commit))
+}
+
+/// Where @inum's last extent, as @snapshot sees it, ends, in bytes: the
+/// i_size its data needs.
+fn extents_end(t: &TransAttempt<'_, '_>, inum: u64, snapshot: u32) -> Result<u64, BchError> {
+    let mut iter = BtreeIter::new(t, c::btree_id::extents,
+                                  spos(inum, u64::MAX, snapshot), BtreeIterFlags::empty());
+    Ok(iter.peek_prev_min(t, pos(inum, 0))?.map_or(0, |k| k.k.p.offset << 9))
+}
+
+/// The inode mode for dirent type @d_type, if it's a file type.
+fn d_type_mode(d_type: u8) -> Option<u32> {
+    let d_type = d_type as u32;
+    [c::DT_REG, c::DT_DIR, c::DT_LNK, c::DT_CHR, c::DT_BLK, c::DT_FIFO, c::DT_SOCK]
+        .contains(&d_type)
+        .then_some(d_type << 12)
+}
+
+/// Recreate missing inode @inum:@snapshot from the keys found in @btree -
+/// a directory for dirents, a file sized to its extents - for the caller to
+/// commit. Xattrs don't say what the inode was: @d_type, from a dirent that
+/// names it, does if there is one; a regular file if not.
+pub fn reconstruct_inode(
+    t:        &TransAttempt<'_, '_>,
+    btree:    c::btree_id,
+    snapshot: u32,
+    inum:     u64,
+    d_type:   Option<u8>,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    let (mode, size) = match btree {
+        // may race with repair deleting the extents that triggered us
+        c::btree_id::extents => (c::S_IFREG, extents_end(t, inum, snapshot)?),
+        c::btree_id::dirents => (c::S_IFDIR, 0),
+        c::btree_id::xattrs  => (d_type.and_then(d_type_mode).unwrap_or(c::S_IFREG), 0),
+        _ => unreachable!("reconstruct_inode() for btree {}", { btree.0 }),
+    };
+
+    let mut new = inode::init(fs, 0, 0, (mode | 0o600) as c::umode_t, 0, None);
+    new.bi_size     = size;
+    new.bi_inum     = inum;
+    new.bi_snapshot = snapshot;
+
+    // Recover the hash info from any surviving version: every version shares
+    // bi_hash_seed and the str_hash type (repair_inode_hash_info() enforces it),
+    // so a descendant will do. Node loss can take one snapshot's inode and leave
+    // another's; a random seed would put every existing dirent at the wrong
+    // offset, and the directory quietly becomes untraversable.
+    let hash_src = match inode::find_oldest_snapshot(t, inum, snapshot) {
+        Err(e) if e.matches(c::ENOENT) => inode::find_any_snapshot(t, inum),
+        r => r,
+    }.found()?;
+    if let Some(src) = hash_src {
+        new.bi_hash_seed = src.bi_hash_seed;
+        new.set_inode_str_hash(src.inode_str_hash());
+    }
+
+    inode::fsck_write(t, &mut new)
+}
+
+/// The root inode for recreating subvolume @subvol at @snapshot: @inum if the
+/// caller knows it, else found. fsck_repair_unimplemented if it can't be,
+/// decided before anything is queued, so a caller can fall back to reporting.
+/// @snapshot must be a leaf: the subvolume key sets its subvol backref, which
+/// bch2_snapshot_validate() rejects on a node with children.
+pub fn reconstruct_subvol_root(
+    t:        &TransAttempt<'_, '_>,
+    snapshot: u32,
+    subvol:   u32,
+    inum:     Option<u64>,
+) -> Result<u64, BchError> {
+    let fs = t.fs();
+
+    if !fs.snapshots.is_leaf(snapshot)? {
+        bch_err!(fs, "need to reconstruct subvol {subvol}, but snapshot {snapshot} is an interior node");
+        return Err(fs.err(bch_errcode::BCH_ERR_fsck_repair_unimplemented));
+    }
+
+    if let Some(inum) = inum {
+        return Ok(inum);
+    }
+
+    // Find the root, don't mint one: when the subvolume key is what went missing,
+    // the inode with bi_subvol == @subvol is still there, and a second root would
+    // orphan the real contents. Nor can it wait for a later pass: a subvolume key
+    // with inode == 0 is rejected (subvol_inode_bad).
+    let mut iter = BtreeIter::new(t, c::btree_id::inodes, pos(0, 0),
+                                  BtreeIterFlags::PREFETCH | BtreeIterFlags::ALL_SNAPSHOTS);
+    let root = iter.for_each_norestart(t, |_, k| Ok(
+        match inode::bkey_is_inode(k.k).then(|| inode::unpack(fs, k)) {
+            Some(u) if u.bi_subvol == subvol => ControlFlow::Break(Some(u.bi_inum)),
+            _ => ControlFlow::Continue(()),
+        }))?;
+
+    root.ok_or_else(|| {
+        bch_err!(fs, "no root inode found for subvol {subvol}, can't reconstruct");
+        fs.err(bch_errcode::BCH_ERR_fsck_repair_unimplemented)
+    })
+}
+
+/// Recreate missing subvolume key @subvol, at leaf @snapshot with root inode
+/// @root - from reconstruct_subvol_root() - and point the snapshot, and its
+/// tree if it has no master subvolume, back at it.
+pub fn reconstruct_subvol(
+    t:        &TransAttempt<'_, '_>,
+    snapshot: u32,
+    subvol:   u32,
+    root:     u64,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    bch_info!(fs, "reconstructing subvol {subvol} with root inode {root}");
+
+    let mut k = t.bkey_alloc_typed::<c::Subvolume>()?;
+    k.k_mut().p = pos(0, subvol as u64);
+    let v = k.v_mut();
+    v.snapshot = snapshot.into();
+    v.inode    = root.into();
+    v.set_state(c::bch_subvolume_state::SUBVOLUME_STATE_live);
+    t.insert(c::btree_id::subvolumes, k, UpdateTriggerFlags::empty())?;
+
+    let mut s = bch_err_msg!(fs,
+        t.bkey_get_mut::<c::Snapshot>(c::btree_id::snapshots, pos(0, snapshot as u64),
+                                       BtreeIterFlags::empty(), UpdateTriggerFlags::empty()),
+        "getting snapshot {snapshot}")?;
+    let s = s.v_mut();
+    let tree = s.tree();
+    s.subvol = subvol.into();
+    s.set_state(c::bch_snapshot_state::SNAPSHOT_STATE_live);
+
+    let mut st = bch_err_msg!(fs,
+        t.bkey_get_mut::<c::SnapshotTree>(c::btree_id::snapshot_trees, pos(0, tree as u64),
+                                           BtreeIterFlags::empty(), UpdateTriggerFlags::empty()),
+        "getting snapshot tree {tree}")?;
+    let st = st.v_mut();
+    if st.master_subvol == 0 {
+        st.master_subvol = subvol.into();
+    }
+
+    Ok(())
+}
+
+/// Whether an inode of mode @mode can own keys in @btree.
+fn btree_matches_i_mode(btree: c::btree_id, mode: c::umode_t) -> bool {
+    let fmt = mode as u32 & c::S_IFMT;
+    match btree {
+        c::btree_id::extents => fmt == c::S_IFREG || fmt == c::S_IFLNK,
+        c::btree_id::dirents => fmt == c::S_IFDIR,
+        c::btree_id::xattrs  => true,
+        _ => unreachable!("check_key_has_inode() on btree {}", { btree.0 }),
+    }
+}
+
+/// Where count_inode_keys() stops counting.
+const COUNT_INODE_KEYS_MAX: u32 = 100;
+
+/// How many keys inode @inode_pos has in @btree, as its version in
+/// @inode_pos's snapshot sees them - up to COUNT_INODE_KEYS_MAX - printing
+/// the first ten to @out.
+fn count_inode_keys(
+    t:         &TransAttempt<'_, '_>,
+    inode_pos: c::bpos,
+    btree:     c::btree_id,
+    mut out:   Option<&mut Printbuf>,
+) -> Result<u32, BchError> {
+    let fs = t.fs();
+    let mut nr_keys = 0;
+    let mut iter = BtreeIter::new(t, btree, inode_pos, BtreeIterFlags::TRIM);
+
+    iter.for_each_max_norestart(t, pos(inode_pos.inode, u64::MAX), |_, k| {
+        // Error keys count: they're placeholders for unreadable data,
+        // evidence the inode had contents. Hash whiteouts are just
+        // tombstones:
+        if k.k.key_type() == c::bch_bkey_type::KEY_TYPE_hash_whiteout {
+            return Ok(ControlFlow::Continue(()));
+        }
+
+        nr_keys += 1;
+        if let Some(out) = out.as_deref_mut().filter(|_| nr_keys <= 10) {
+            prt!(out, "{}\n", k.to_text(fs));
+        }
+
+        Ok(if nr_keys >= COUNT_INODE_KEYS_MAX { ControlFlow::Break(()) } else { ControlFlow::Continue(()) })
+    })?;
+
+    Ok(nr_keys)
+}
+
+/// A repair to @inode made for a key at @snapshot: if @inode is a version in
+/// a strict ancestor - one get_visible() resolved @snapshot to - it's shared
+/// with the ancestor's other descendants, and the repair goes in @snapshot
+/// instead, as a version of its own. Written in place, it would change what
+/// every other view of the ancestor sees.
+pub fn own_version(t: &TransAttempt<'_, '_>, inode: &mut c::bch_inode_unpacked, snapshot: u32) {
+    if inode.bi_snapshot != snapshot && snapshot::is_ancestor(t, snapshot, inode.bi_snapshot) {
+        inode.bi_snapshot = snapshot;
+    }
+}
+
+/// @new, a key a hash table repair just wrote, may be a dirent at a new
+/// position: point what it names back at it - a subvolume's root inode, or
+/// the versions of an inode visible from it, by @s.
+pub fn fsck_update_backpointers(
+    t:   &TransAttempt<'_, '_>,
+    s:   &mut SnapshotsSeen,
+    new: &BkeyI,
+) -> Result<(), BchError> {
+    let Some(d) = Dirent::new(BkeySC::from(new)) else { return Ok(()) };
+    let (dir, offset) = (new.k.p.inode, new.k.p.offset);
+    let points_here = |i: &c::bch_inode_unpacked| i.bi_dir == dir && i.bi_dir_offset == offset;
+
+    match d.target() {
+        // A subvolume dirent's backpointer lives on the child subvolume's root
+        // inode, same as a regular inode - see bch2_inode_get_dirent(). A
+        // dangling subvol dirent (subvol or root inode gone) is
+        // check_subvols/check_dirents' problem, not ours.
+        DirentTarget::Subvol { child, .. } => {
+            let Some(subvol) = subvolume::get(t, child, false).found()? else { return Ok(()) };
+            let Some(mut root) = inode::find_by_inum_snapshot(t, subvol.inode.get(),
+                                                              subvol.snapshot.get(),
+                                                              BtreeIterFlags::empty()).found()? else {
+                return Ok(());
+            };
+            if points_here(&root) {
+                return Ok(());
+            }
+
+            root.bi_dir        = dir;
+            root.bi_dir_offset = offset;
+            inode::fsck_write(t, &mut root)
+        }
+        DirentTarget::Inode(inum) => {
+            let mut target = InodeWalker::new();
+            target.get_visible(t, s, inum)?;
+
+            // A backpointer is the (bi_dir, bi_dir_offset) pair: compare and set both, or
+            // a matching offset in the wrong directory skips a broken one. Skip before
+            // writing: fsck_write() allocates trans mem per call, once per visible
+            // version, so a correct backpointer must cost nothing - and a re-run over
+            // partly repaired state then shrinks instead of repeating.
+            for i in target.inodes_mut().iter_mut().filter(|i| !points_here(&i.inode)) {
+                own_version(t, &mut i.inode, new.k.p.snapshot);
+                i.inode.bi_dir        = dir;
+                i.inode.bi_dir_offset = offset;
+                inode::fsck_write(t, &mut i.inode)?;
+            }
+            Ok(())
+        }
+    }
+}
+
+impl Default for SnapshotsSeen {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl Fs {
+    /// fsck(8)'s exit status for what the filesystem's errors came to - 1
+    /// fixed, 4 left, 8 a fatal error, ORed - each said in @out.
+    pub fn fsck_errcode(&self, out: &mut Printbuf) -> core::ffi::c_int {
+        use c::bch_fs_flags::*;
+
+        let mut ret = 0;
+        for (flag, bit, what) in [
+            (BCH_FS_errors_fixed, 1, "errors fixed"),
+            (BCH_FS_error,        4, "still has errors"),
+            (BCH_FS_emergency_ro, 8, "fatal error (went emergency read-only)"),
+        ] {
+            if self.flag(flag) {
+                out.write_bytes(self.name().to_bytes());
+                prt!(out, ": {what}\n");
+                ret |= bit;
+            }
+        }
+        ret
+    }
+}
+
+/// BCH_IOCTL_FSCK_OFFLINE and BCH_IOCTL_FSCK_ONLINE: fsck in the kernel, for
+/// the bcachefs fsck command. Each runs in a kthread behind a stdio file, its
+/// output read from the fd and its questions answered by writing to it; what
+/// it returns - an fsck(8) exit status, or an error - is what closing the fd
+/// returns.
+#[cfg(kernel)]
+pub mod ioctl {
+    use super::*;
+    use crate::errcode::errptr_to_result;
+    use crate::fs::{OpenFs, RoRef};
+    use crate::init::passes::{bch2_recovery_passes, passes_match, run_passes};
+    use crate::opts::parse_mount_opts_cstr;
+    use crate::util::ffi::c_char;
+    use crate::util::kernel::{capable, Capability};
+    use crate::util::thread_with_file::{StdioRedirect, ThreadWithFile};
+    use crate::util::ioctl::{UserStr, UserVstruct};
+    use core::ptr::NonNull;
+    use kernel::ffi::c_int;
+
+    /// The options at user address @addr, or none if it's 0.
+    fn user_opts(addr: u64) -> Result<c::bch_opts, BchError> {
+        match addr {
+            0 => Ok(c::bch_opts::default()),
+            _ => parse_mount_opts_cstr(None, UserStr::read(addr, 1 << 16)?.as_cstr(), false),
+        }
+    }
+
+    pub fn fsck_offline(user: UserVstruct<c::bch_ioctl_fsck_offline>) -> Result<c_int, BchError> {
+        let arg = user.head()?;
+
+        if arg.flags != 0 {
+            return Err(bch_errcode::BCH_ERR_EINVAL_fsck_offline_bad_flags.into());
+        }
+
+        if !capable(Capability::SysAdmin) {
+            return Err(c::EPERM.into());
+        }
+
+        let mut opts = user_opts(arg.opts)?;
+
+        let user_devs = user.tail(&arg);
+        let mut devs = KVVec::with_capacity(user_devs.len(), GFP_KERNEL)?;
+        let mut dev_ptrs = KVVec::with_capacity(user_devs.len(), GFP_KERNEL)?;
+        for i in 0..user_devs.len() {
+            devs.push(UserStr::read(user_devs.get(i)?, c::PATH_MAX as usize)?, GFP_KERNEL)?;
+        }
+        for d in devs.iter() {
+            dev_ptrs.push(d.as_cstr().as_ptr().cast::<c_char>(), GFP_KERNEL)?;
+        }
+
+        let thr = ThreadWithFile::new_stdio(Ok(()))?;
+
+        opts.set_stdio(thr.stdio().as_c() as u64);
+        opts.set_read_only(true);
+        opts.set_ratelimit_errors(false);
+        // We need request_key() to be called before we punt to kthread:
+        opts.set_nostart(true);
+
+        // C only reads the list, and read_super() keeps a copy of each path
+        let mut dev_list = c::darray_const_str {
+            nr: dev_ptrs.len(), size: dev_ptrs.len(), data: dev_ptrs.as_mut_ptr(), preallocated: [],
+        };
+        let fs = unsafe { c::bch2_fs_open(&mut dev_list, &mut opts, core::ptr::null()) };
+        let fs = errptr_to_result(NonNull::new(fs).expect("a filesystem, or an error"))
+            .map(|fs| unsafe { OpenFs::from_raw(fs.cast()) });
+
+        if let Ok(fs) = &fs {
+            if fs.opts.errors() == c::bch_error_actions::BCH_ON_ERROR_panic {
+                unsafe { (*fs.as_ptr()).opts.set_errors(c::bch_error_actions::BCH_ON_ERROR_ro) };
+            }
+        }
+
+        thr.run_stdio(move |(), stdio| fsck_offline_thread(fs, stdio))
+            .inspect_err(|e| kernel::pr_err!("ret {}\n", e.msg()))
+    }
+
+    fn fsck_offline_thread(fs: Result<OpenFs, BchError>, stdio: &StdioRedirect) -> c_int {
+        let fs = match fs {
+            Ok(fs) => fs,
+            Err(e) => return -e.raw(),
+        };
+
+        unsafe { (*fs.as_ptr()).recovery_task = c::get_current() };
+
+        let mut buf = Printbuf::new();
+        let ret = match crate::errcode::ret_to_result_void(unsafe { c::bch2_fs_start(fs.as_ptr()) }) {
+            Err(e) => {
+                prt!(&mut buf, "{}: error starting filesystem: {}\n",
+                     fs.name().to_str().unwrap_or("?"), e.msg());
+                // What we return is an fsck(8) exit status, not an errcode -
+                // see Fs::fsck_errcode(). A filesystem we couldn't start
+                // is an operational error, same as the online path reports
+                // for recovery passes that fail outright.
+                8
+            }
+            Ok(()) => fs.fsck_errcode(&mut buf),
+        };
+        if ret != 0 {
+            let _ = stdio.write(false, buf.as_bytes());
+        }
+
+        fs.exit();
+        ret
+    }
+
+    pub fn fsck_online(fs: &Fs, arg: c::bch_ioctl_fsck_online) -> Result<c_int, BchError> {
+        if arg.flags != 0 {
+            return fs.throw(bch_errcode::BCH_ERR_EINVAL_fsck_online_bad_flags);
+        }
+
+        if !capable(Capability::SysAdmin) {
+            return fs.throw(bch_errcode::BCH_ERR_EPERM_non_admin);
+        }
+
+        let opts = user_opts(arg.opts)?;
+
+        let fs_ref = RoRef::tryget(fs).ok_or(BchError::from(c::EROFS))?;
+
+        let thr = ThreadWithFile::new_stdio(Ok(()))?;
+        crate::bch_err_fn!(fs, thr.run_stdio(move |(), stdio| fsck_online_thread(fs_ref, opts, stdio)))
+    }
+
+    fn fsck_online_thread(fs: RoRef, opts: c::bch_opts, stdio: &StdioRedirect) -> c_int {
+        let mut buf = Printbuf::new();
+
+        let online = passes_match(c::PASS_ONLINE);
+        let mut passes = passes_match(c::PASS_FSCK) & online;
+
+        if opts.defined(c::bch_opt_id::Opt_recovery_passes) {
+            passes = opts.recovery_passes;
+
+            if passes & online != passes {
+                prt!(&mut buf, "Cannot run passes ");
+                // SAFETY: NULL terminated
+                unsafe { buf.prt_bitflags(bch2_recovery_passes.as_ptr().cast(), passes & !online) };
+                prt!(&mut buf, " online\n");
+                let _ = stdio.write(false, buf.as_bytes());
+                return -fs.err(bch_errcode::BCH_ERR_EINVAL_fsck_online_bad_passes).raw();
+            }
+        }
+
+        let mut ret = Err(BchError::from(c::EAGAIN));
+        if let Some(_run) = fs.recovery.run_lock.try_lock() {
+            let c = fs.as_ptr();
+            // SAFETY: as C's, under run_lock: online fsck's, while it runs
+            unsafe {
+                (*c).stdio_filter = c::get_current();
+                (*c).stdio = stdio.as_c();
+            }
+
+            // XXX: can we figure out a way to do this without mucking with c->opts?
+            let old_fix_errors = fs.opts.fix_errors;
+            unsafe {
+                (*c).opts.fix_errors = if opts.defined(c::bch_opt_id::Opt_fix_errors) {
+                    opts.fix_errors
+                } else {
+                    c::fsck_err_opts::FSCK_FIX_ask as u8
+                };
+                (*c).opts.fsck = 1;
+            }
+            fs.set_flag(c::bch_fs_flags::BCH_FS_in_fsck);
+
+            ret = run_passes(&fs, passes, true)
+                .map(|()| fs.fsck_errcode(&mut buf));
+
+            fs.clear_flag(c::bch_fs_flags::BCH_FS_in_fsck);
+
+            unsafe {
+                (*c).stdio = core::ptr::null_mut();
+                (*c).stdio_filter = core::ptr::null_mut();
+                (*c).opts.fix_errors = old_fix_errors;
+            }
+        }
+
+        let ret = ret.unwrap_or_else(|e| {
+            prt!(&mut buf, "{}: error running recovery passes: {}\n",
+                 fs.name().to_str().unwrap_or("?"), e.msg());
+            8
+        });
+
+        if !buf.as_bytes().is_empty() {
+            let _ = stdio.write(false, buf.as_bytes());
+        }
+        ret
+    }
+}
diff --git a/fs/bcachefs/fs/check_dir_structure.rs b/fs/bcachefs/fs/check_dir_structure.rs
new file mode 100644
index 0000000..a3a6827
--- /dev/null
+++ b/fs/bcachefs/fs/check_dir_structure.rs
@@ -0,0 +1,367 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! check_subvolume_structure and check_directory_structure: earlier passes
+//! fixed every other connectivity problem, so what's left is part of the tree
+//! looping back on itself, or a subvolume whose path up doesn't reach the
+//! root. The repair for both cuts the loop - removes the dirent naming it - and
+//! reattaches in lost+found.
+//!
+//! Subvolumes walk their fs_path_parent chain to the root subvolume
+//! (subvol_loop, subvol_unreachable); directories walk their backpointers to a
+//! subvolume root (dir_loop).
+//!
+//! bi_depth makes the directory walk cheap: if every directory is deeper than
+//! its parent, every chain decreases to a root, so each directory only checks
+//! its own edge. One whose parent isn't shallower walks to the root, and the
+//! path is renumbered after. Sound, because a loop has an edge that doesn't
+//! decrease, and the walk from its child goes around and sees the repeat.
+//!
+//! Renumbering commits per inode in nested transactions - a path needn't fit
+//! in one - which silently drops anything the outer attempt queued: nothing
+//! may be queued on a path that renumbers. Today the walk only reads, and
+//! repairs return before it.
+
+use crate::btree::bkey::prelude::*;
+use crate::btree::bkey::{pos, spos, BkeySC, POS_MIN, SPOS_MAX};
+use crate::btree::bkey_buf::BkeyBuf;
+use crate::btree::iter::{
+    BtreeIter, BtreeIterFlags, CommitFlags, TransAttempt,
+};
+use crate::c;
+use crate::errcode::{bch_errcode, BchError, Found};
+use crate::fs::Fs;
+use crate::init::error::id;
+use crate::init::progress::Progress;
+use crate::snapshots::subvolume;
+use crate::dirent::{self, Dirent};
+use crate::{inode, lostfound, namei};
+use crate::util::alloc::{flags::GFP_KERNEL, KVVec};
+use crate::util::Printbuf;
+use crate::util::log::LogMsg;
+use crate::{bch_err_fn, bch_err_msg, bch_warn, c_function_name, inode_fsck_err, prt};
+
+/// @k: a dirent, from a dirent lookup.
+fn dirent_points_to_inode(
+    fs:    &Fs,
+    k:     BkeySC<'_>,
+    inode: &mut c::bch_inode_unpacked,
+) -> Result<(), BchError> {
+    let d = Dirent::new(k).expect("dirent lookups only return dirents");
+
+    if namei::dirent_points_to_inode(d, inode) {
+        return Ok(());
+    }
+
+    bch_warn!(fs, "{}", namei::dirent_inode_mismatch(fs, k, inode));
+    fs.throw(bch_errcode::BCH_ERR_ENOENT_dirent_doesnt_match_inode)
+}
+
+fn remove_backpointer(
+    t:     &TransAttempt<'_, '_>,
+    inode: &mut c::bch_inode_unpacked,
+) -> Result<(), BchError> {
+    if !inode.has_backpointer() {
+        return Ok(());
+    }
+
+    let mut snapshot = inode.bi_snapshot;
+    let mut iter = BtreeIter::uninit();
+
+    // For a subvolume root, a missing parent subvolume reads as ENOENT here, like
+    // a missing dirent - what reattach_subvol() is for. Nothing to remove is
+    // success: the caller reattaches next.
+    let Some(k) = namei::inode_get_dirent(t, &mut iter, inode, &mut snapshot).found()? else {
+        return Ok(());
+    };
+
+    dirent_points_to_inode(t.fs(), k, inode)?;
+    dirent::fsck_remove(t, k.k.p)
+}
+
+/// @root: the subvolume and its root inode.
+fn reattach_subvol(t: &TransAttempt<'_, '_>, root: c::subvol_inum) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    let mut inode = inode::find_by_inum_trans(t, root, c_function_name!())?;
+
+    let ret = remove_backpointer(t, &mut inode);
+    if !matches!(&ret, Err(e) if e.matches(c::ENOENT)) {
+        bch_err_msg!(fs, ret, "removing dirent")?;
+    }
+    ret?;
+
+    bch_err_msg!(fs, lostfound::reattach_inode(t, &mut inode),
+                 "reattaching inode {}", inode.bi_inum)
+}
+
+fn check_subvol_path(t: &TransAttempt<'_, '_>, k: BkeySC<'_>) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    let Some(start_sv) = subvolume::val(k) else {
+        return Ok(());
+    };
+
+    // Unlinking zeroes fs_path_parent: a subvolume on its way to deletion has
+    // no path by design, and isn't ours to reattach.
+    if start_sv.state_decoded() != Some(c::bch_subvolume_state::SUBVOLUME_STATE_live) {
+        return Ok(());
+    }
+
+    let mut subvol_path: KVVec<u32> = KVVec::new();
+    let mut parent_iter = BtreeIter::new(t, c::btree_id::subvolumes, POS_MIN,
+                                         BtreeIterFlags::empty());
+
+    let start = c::subvol_inum {
+        subvol: k.k.p.offset,
+        inum:   start_sv.inode.get(),
+    };
+
+    // A copy: from the second step on the key is parent_iter's, whose unpacked
+    // header looking up the parent overwrites
+    let mut cur = BkeyBuf::from_key(k);
+
+    loop {
+        let s = BkeySC::from(&cur);
+        let sv = subvolume::val(s).expect("cur only ever holds subvolume keys");
+
+        if s.k.p.offset == c::BCACHEFS_ROOT_SUBVOL as u64 {
+            return Ok(());
+        }
+
+        subvol_path.push(s.k.p.offset as u32, GFP_KERNEL)?;
+
+        let root = c::subvol_inum { subvol: s.k.p.offset, inum: sv.inode.get() };
+
+        inode::find_by_inum_trans(t, root, c_function_name!())?;
+
+        let parent = sv.fs_path_parent.get();
+        let inode_pos = spos(0, sv.inode.get(), sv.snapshot.get());
+
+        if subvol_path.contains(&parent) {
+            let mut buf = Printbuf::new();
+            write!(buf, "subvolume loop: ");
+            namei::inum_to_path(t, start, &mut buf)?;
+
+            if inode_fsck_err!(t, inode_pos, id::subvol_loop, "{}", buf)? {
+                return reattach_subvol(t, root);
+            }
+            return Ok(());
+        }
+
+        parent_iter.set_pos(pos(0, parent as u64));
+        match parent_iter.peek_slot(t)? {
+            Some(pk) if pk.arm::<c::Subvolume>().is_some() => {
+                cur.reassemble(pk);
+            }
+            _ => {
+                if inode_fsck_err!(t, inode_pos, id::subvol_unreachable,
+                                   "unreachable subvolume {}", s.to_text(fs))? {
+                    return reattach_subvol(t, root);
+                }
+                return Ok(());
+            }
+        }
+    }
+}
+
+fn check_subvolume_structure(fs: &Fs) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+    let progress = Progress::recovery(fs, c"bch2_check_subvolume_structure",
+                                      &[c::btree_id::subvolumes], &[]);
+
+    let mut iter = BtreeIter::new(&trans, c::btree_id::subvolumes, POS_MIN,
+                                  BtreeIterFlags::PREFETCH);
+
+    iter.for_each_commit(&trans, None, CommitFlags::NO_ENOSPC,
+        |t, iter, k| {
+            progress.update(t, iter)?;
+            check_subvol_path(t, k)
+        })
+}
+
+fn bi_depth_renumber_one(
+    t:         &TransAttempt<'_, '_>,
+    inum:      u64,
+    snapshot:  u32,
+    new_depth: u32,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+    let mut iter = BtreeIter::new(t, c::btree_id::inodes, spos(0, inum, snapshot),
+                                  BtreeIterFlags::empty());
+
+    let Some(k) = iter.peek_slot(t)?.filter(|k| inode::bkey_is_inode(k.k)) else {
+        return Err(bch_errcode::BCH_ERR_ENOENT_inode.into());
+    };
+
+    let mut inode = inode::unpack(fs, k);
+
+    if inode.bi_depth != new_depth {
+        inode.bi_depth = new_depth;
+        inode::fsck_write(t, &mut inode)?;
+        t.commit(None, CommitFlags::empty())?;
+    }
+
+    Ok(())
+}
+
+fn bi_depth_renumber(
+    t:                &TransAttempt<'_, '_>,
+    path:             &[u64],
+    snapshot:         u32,
+    mut new_bi_depth: u32,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    // A nested attempt that restarted returns transaction_restart_nested, so the
+    // outer one retries too
+    for &inum in path.iter().rev() {
+        bch_err_fn!(fs, t.nested(|t| bi_depth_renumber_one(t, inum, snapshot, new_bi_depth)))?;
+        new_bi_depth += 1;
+    }
+
+    Ok(())
+}
+
+fn check_path_loop(t: &TransAttempt<'_, '_>, inode_k: BkeySC<'_>) -> Result<(), BchError> {
+    let fs = t.fs();
+    let mut path: KVVec<u64> = KVVec::new();
+    let mut snapshot = inode_k.k.p.snapshot;
+    let mut redo_bi_depth = false;
+    let mut min_bi_depth = u32::MAX;
+
+    let start = inode_k.k.p;
+
+    let mut inode = inode::unpack(fs, inode_k);
+
+    // At a redundant interior node delete_dead_snapshots will collapse, walk in
+    // the live descendant's view: an interrupted collapse moved the dirents and
+    // parents down there, and a half-moved dirent would read as unreachable.
+    // No-op on a healthy fs.
+    if let Some(terminal) = fs.snapshots.redundant_interior(snapshot) {
+        snapshot = terminal;
+    }
+
+    // Not all_snapshots: the parent we want is the one visible in @snapshot,
+    // and a filtered iterator looks in the snapshot it was initialized with -
+    // set_pos() keeps it.
+    let mut inode_iter = BtreeIter::new(t, c::btree_id::inodes, spos(0, 0, snapshot),
+                                        BtreeIterFlags::empty());
+
+    // After check_dirents, a missing dirent or backpointer is
+    // check_unreachable_inodes'
+    while inode.bi_subvol == 0 && inode.has_backpointer() {
+        let mut dirent_iter = BtreeIter::new(t, c::btree_id::dirents,
+                                             spos(inode.bi_dir, inode.bi_dir_offset, snapshot),
+                                             BtreeIterFlags::empty());
+
+        if let Err(e) = dirent_iter.peek_slot_typed::<c::Dirent>(t) {
+            if !e.matches(c::ENOENT) {
+                return Err(e);
+            }
+
+            // The dirent is gone, and the name with it, but bi_dir says which directory:
+            // print its path. A restart propagates to the commit loop, unprinted.
+            let mut msg = LogMsg::new(fs);
+            write!(msg, "unreachable inode, naming dirent missing; was in directory ");
+            if let Err(e) = namei::inum_snapshot_to_path(t, inode.bi_dir, snapshot, &mut msg) {
+                msg.set_suppressed(true);
+                return Err(e);
+            }
+            msg.newline();
+            prt!(msg, "{}", inode);
+            return Err(e);
+        }
+
+        path.push(inode.bi_inum, GFP_KERNEL)?;
+
+        inode_iter.set_pos(spos(0, inode.bi_dir, snapshot));
+        // Should have been caught in dirents pass
+        let parent_inode = bch_err_msg!(fs, match inode_iter.peek_slot(t) {
+            Ok(Some(k)) if inode::bkey_is_inode(k.k) => Ok(inode::unpack(fs, k)),
+            ret => Err(ret.err()
+                .unwrap_or(bch_errcode::BCH_ERR_ENOENT_inode.into())),
+        }, "error looking up parent directory")?;
+
+        min_bi_depth = parent_inode.bi_depth;
+
+        // Depths decrease towards the root, so a shallower parent means the
+        // rest of the path has been checked - unless this walk has already
+        // crossed a depth that's wrong. Around a loop the depths can't all
+        // decrease, so trusting them past a wrong one always stops the walk
+        // before it comes back around.
+        if !redo_bi_depth &&
+            parent_inode.bi_depth < inode.bi_depth &&
+            min_bi_depth < u16::MAX as u32
+        {
+            break;
+        }
+
+        inode = parent_inode;
+        redo_bi_depth = true;
+
+        if path.contains(&inode.bi_inum) {
+            let mut buf = Printbuf::new();
+            write!(buf, "directory structure loop in snapshot {}: ", snapshot);
+
+            namei::inum_snapshot_to_path(t, start.offset, start.snapshot, &mut buf)?;
+
+            if fs.opts().verbose() {
+                buf.newline();
+                for i in path.iter() {
+                    write!(buf, "{} ", i);
+                }
+            }
+
+            if inode_fsck_err!(t, spos(0, inode.bi_inum, inode.bi_snapshot), id::dir_loop,
+                               "{}", buf)? {
+                bch_err_msg!(fs, remove_backpointer(t, &mut inode), "removing dirent")?;
+
+                // Done with this path: it was a loop, there are no depths
+                // along it to renumber - and on error or restart, nothing more
+                // may run in this transaction.
+                return bch_err_msg!(fs, lostfound::reattach_inode(t, &mut inode),
+                                    "reattaching inode {}", inode.bi_inum);
+            }
+
+            break;
+        }
+    }
+
+    if inode.bi_subvol != 0 {
+        min_bi_depth = 0;
+    }
+
+    if redo_bi_depth {
+        return bi_depth_renumber(t, &path, snapshot, min_bi_depth);
+    }
+
+    Ok(())
+}
+
+/// Check for directory loops.
+fn check_directory_structure(fs: &Fs) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+    let mut iter = BtreeIter::new(&trans, c::btree_id::inodes, SPOS_MAX,
+        BtreeIterFlags::INTENT | BtreeIterFlags::PREFETCH | BtreeIterFlags::ALL_SNAPSHOTS);
+
+    iter.for_each_reverse_commit(&trans, POS_MIN, None,
+        CommitFlags::NO_ENOSPC,
+        |t, _, k| {
+            if inode::mode(k) & c::S_IFMT != c::S_IFDIR {
+                return Ok(());
+            }
+
+            // check_inodes has already stripped BCH_INODE_unlinked from every
+            // directory but the root of an unlinked subvolume, and a subvolume
+            // root ends every walk - so skipping these can't hide a directory
+            // loop:
+            if inode::flags(k) & c::bch_inode_flags::BCH_INODE_unlinked.bits() != 0 {
+                return Ok(());
+            }
+
+            check_path_loop(t, k)
+        })
+}
+
+crate::recovery_pass!(bch2_check_subvolume_structure => check_subvolume_structure);
+crate::recovery_pass!(bch2_check_directory_structure => check_directory_structure);
diff --git a/fs/bcachefs/fs/check_dirents.rs b/fs/bcachefs/fs/check_dirents.rs
new file mode 100644
index 0000000..1c63bd8
--- /dev/null
+++ b/fs/bcachefs/fs/check_dirents.rs
@@ -0,0 +1,568 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! check_dirents: every dirent belongs to a live directory in its snapshot,
+//! sits where its hash says, and points at something that agrees with it - an
+//! inode whose backpointer and type match, or for DT_SUBVOL a subvolume whose
+//! root and fs_path_parent match. Each directory's subdirectories are counted
+//! and checked against i_nlink as the walk leaves it.
+//!
+//! @dir walks the directories in key order; @target is loaded per dirent with
+//! the versions of its inode visible from it.
+//!
+//! The target must exist in an ancestor of the dirent's snapshot, so every
+//! subvolume that sees the dirent sees the inode. One only in descendants gets
+//! the dirent moved down to them - ahead of the walk, so the pass runs twice,
+//! and a second pass that still finds work is an error. A target deleted in a
+//! descendant, a whiteout there, gets the dirent whited out there too.
+//!
+//! Subdirectory counts are per dir walker entry, incremented as each DT_DIR
+//! dirent commits; if the walker refetches partway through a directory, they're
+//! recounted from the btree (recalculate_sums).
+
+use crate::btree::bkey::prelude::*;
+use crate::btree::bkey::{pos, spos, BkeySC, POS_MIN};
+use crate::btree::iter::{
+    is_restart, lockrestart_do, BtreeIter, BtreeIterFlags, CommitFlags, TransAttempt,
+    UpdateTriggerFlags,
+};
+use crate::c;
+use crate::check::{self, InodeWalker, SnapshotsSeen};
+use crate::dirent::{self, Dirent, DirentTarget, Dirents};
+use crate::errcode::{bch_errcode, BchError, Found};
+use crate::fs::Fs;
+use crate::init::error::id;
+use crate::init::progress::Progress;
+use crate::snapshots::{snapshot, subvolume};
+use crate::util::Printbuf;
+use crate::{bch_err, bch_err_fn, bch_err_ratelimited, bch_info, fsck_err, fsck_err_on, inode_fsck_err};
+use crate::{inode, namei, str_hash};
+use core::ops::ControlFlow;
+
+struct CheckDirents {
+    s:                SnapshotsSeen,
+    dir:              InodeWalker,
+    target:           InodeWalker,
+    hash_info:        c::bch_hash_info,
+    need_second_pass: bool,
+}
+
+// ---------------------------------------------------------------------------
+// Subdirectory counts
+
+/// The subdirectories of @inum as @snapshot sees them. In the caller's attempt,
+/// a restart returned, not retried: a walk of its own would begin, retrying the
+/// key even when the repair is declined (see check_dir_nlink()).
+fn count_subdirs(t: &TransAttempt<'_, '_>, inum: u64, snapshot: u32) -> Result<u64, BchError> {
+    let mut subdirs = 0;
+    let mut iter = BtreeIter::new(t, c::btree_id::dirents, spos(inum, 0, snapshot),
+                                  BtreeIterFlags::empty());
+
+    iter.for_each_max_norestart(t, pos(inum, u64::MAX), |_, k| {
+        if Dirent::new(k).is_some_and(|d| d.d_type() as u32 == c::DT_DIR) {
+            subdirs += 1;
+        }
+        Ok(())
+    })?;
+
+    Ok(subdirs)
+}
+
+/// Check one version of directory @inum, @i, against the subdirectories
+/// counted for it - recounting from the btree if the count disagrees, or
+/// is known to be partial (@recalculate_sums) - and repair i_nlink.
+fn check_dir_nlink(
+    t:                &TransAttempt<'_, '_>,
+    inum:             u64,
+    recalculate_sums: bool,
+    i:                &mut check::WalkerEntry,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    if i.inode.bi_nlink as u64 == i.count {
+        return Ok(());
+    }
+
+    let snapshot = i.inode.bi_snapshot;
+    let count = count_subdirs(t, inum, snapshot)?;
+
+    if !recalculate_sums && i.count != count {
+        bch_err_ratelimited!(fs, "fsck counted subdirectories wrong for inum {inum}:{snapshot}: got {} should be {count}",
+                             i.count);
+    }
+    i.count = count;
+
+    if i.inode.bi_nlink as u64 == i.count {
+        return Ok(());
+    }
+
+    let mut path = Printbuf::new();
+    // For the message only. In the caller's attempt: beginning one retries the
+    // key, and a declined repair would find the same count and begin another,
+    // forever.
+    if let Err(e) = namei::inum_snapshot_to_path(t, inum, snapshot, &mut path) {
+        if is_restart(&e) {
+            return Err(e);
+        }
+    }
+
+    if fsck_err!(t, id::inode_dir_wrong_nlink,
+                 "directory with wrong i_nlink: got {}, should be {}\n{path}\n{}",
+                 i.inode.bi_nlink, i.count, i.inode)? {
+        // The walker learns the fix only with the write: a restart before
+        // it, from the close's commit, leaves it to be found again
+        return Err(t.close(CommitFlags::NO_ENOSPC, |trans| {
+            i.inode.bi_nlink = i.count as u32;
+            inode::fsck_write_inode(trans, &mut i.inode)
+        }));
+    }
+
+    Ok(())
+}
+
+/// Check i_nlink of each version of the directory @w has walked against its
+/// subdirectory count. A repair commits for itself, closing the attempt -
+/// see check_subdir_dirents_count().
+fn check_subdir_count_notnested(t: &TransAttempt<'_, '_>, w: &mut InodeWalker)
+    -> Result<(), BchError>
+{
+    let Some(inum) = w.cur_inum() else { return Ok(()) };
+    let recalculate_sums = w.recalculate_sums();
+
+    bch_err_fn!(t.fs(), w.inodes_mut().iter_mut()
+        .try_for_each(|i| check_dir_nlink(t, inum, recalculate_sums, i)))
+}
+
+/// check_subdir_count_notnested() from inside the commit loop. A repair
+/// closes the attempt - committing what it queued, the fsck_err log entry
+/// with it - to commit for itself, and the key is retried: the rerun finds
+/// the versions already fixed, and goes on to the rest.
+fn check_subdir_dirents_count(t: &TransAttempt<'_, '_>, w: &mut InodeWalker) -> Result<(), BchError> {
+    check_subdir_count_notnested(t, w)
+}
+
+// ---------------------------------------------------------------------------
+// DT_SUBVOL dirents
+
+/// A subvolume whose snapshot is @snapshot or a descendant of it.
+fn find_snapshot_subvol(t: &TransAttempt<'_, '_>, snapshot: u32) -> Result<Option<u32>, BchError> {
+    let mut iter = BtreeIter::new(t, c::btree_id::subvolumes, POS_MIN, BtreeIterFlags::empty());
+
+    iter.for_each_norestart(t, |_, k| Ok(
+        match k.arm::<c::Subvolume>().map(|k| k.v()) {
+            Some(s) if snapshot::is_ancestor(t, s.snapshot.get(), snapshot) =>
+                ControlFlow::Break(Some(k.k.p.offset as u32)),
+            _ => ControlFlow::Continue(()),
+        }))
+}
+
+/// The subvolume @k, a DT_SUBVOL dirent, lives in: it must exist and see the
+/// dirent's snapshot. Returns the subvolume, after any repair.
+fn check_dirent_parent_subvol<'t>(
+    t:      &TransAttempt<'_, 't>,
+    iter:   &BtreeIter<'t>,
+    k:      BkeySC<'_, c::Dirent>,
+    parent: u32,
+) -> Result<u32, BchError> {
+    let fs = t.fs();
+    let d_snapshot = k.k.p.snapshot;
+
+    let parent_snapshot = subvolume::get_snapshot_nowarn(t, parent).found()?;
+
+    // The root subvolume always exists (check_root() recreates it): rewiring
+    // around its absence would reparent the root's subvolume dirents onto
+    // arbitrary subvolumes.
+    if parent_snapshot.is_none() && parent == c::BCACHEFS_ROOT_SUBVOL {
+        return Ok(parent);
+    }
+
+    if parent_snapshot.is_some_and(|s| snapshot::is_ancestor(t, s, d_snapshot)) {
+        return Ok(parent);
+    }
+
+    let new_parent = find_snapshot_subvol(t, d_snapshot)?;
+
+    if new_parent.is_none() && fs.btree_lost_data(c::btree_id::subvolumes) {
+        // No subvolume sees the dirent's snapshot - but we lost subvolumes,
+        // so reconstruct the one it names:
+        let root = check::reconstruct_subvol_root(t, d_snapshot, parent, None)?;
+        check::reconstruct_subvol(t, d_snapshot, parent, root)?;
+        return Ok(parent);
+    }
+
+    // The parent exists but doesn't see the dirent, and another subvolume
+    // does: that's the one to move it to. Otherwise it's missing, as far as
+    // the dirent is concerned:
+    let repair = match (parent_snapshot, new_parent) {
+        (Some(parent_snapshot), Some(_)) =>
+            fsck_err!(t, id::dirent_not_visible_in_parent_subvol,
+                      "dirent not visible in parent_subvol (not an ancestor of subvol snap {parent_snapshot})\n{}",
+                      k.to_text(fs))?,
+        _ =>
+            fsck_err!(t, id::dirent_to_missing_parent_subvol,
+                      "dirent parent_subvol points to missing subvolume\n{}", k.to_text(fs))?,
+    };
+    if !repair {
+        return Ok(parent);
+    }
+
+    let Some(new_parent) = new_parent else {
+        bch_err!(fs, "could not find a subvol for snapshot {d_snapshot}");
+        return Err(fs.err(bch_errcode::BCH_ERR_fsck_repair_unimplemented));
+    };
+
+    // The dirent is rewritten at its own position, which may be an interior
+    // snapshot node - dirents in old snapshots need this repair too:
+    let mut n = t.bkey_reassemble(k)?;
+    n.v_mut().set_parent_subvol(new_parent);
+    t.update(iter, &n, UpdateTriggerFlags::INTERNAL_SNAPSHOT_NODE)?;
+
+    // The fs_path_parent check next repairs the subvolume to agree with the dirent:
+    // the one just written, or each fsck after moves one to match the other's
+    // stale value.
+    Ok(new_parent)
+}
+
+fn check_dirent_to_subvol<'t>(
+    t:      &TransAttempt<'_, 't>,
+    iter:   &BtreeIter<'t>,
+    d:      Dirent<'_>,
+    child:  u32,
+    parent: u32,
+) -> Result<(), BchError> {
+    let k = d.k();
+    let parent = check_dirent_parent_subvol(t, iter, k, parent)?;
+    let fs = t.fs();
+
+    let mut subvol_iter = BtreeIter::new(t, c::btree_id::subvolumes, pos(0, child as u64),
+                                         BtreeIterFlags::empty());
+    let s = subvol_iter.peek_slot_typed::<c::Subvolume>(t).found()?;
+
+    // A deleted subvolume is a tombstone awaiting the sweep: missing, as get()
+    // would say - this is a raw read, for the key. Else the dirent outlives it,
+    // and fsck stops converging once the sweep removes it.
+    let s = s.filter(|s| {
+        s.v().state_decoded() != Some(c::bch_subvolume_state::SUBVOLUME_STATE_deleted)
+    });
+
+    let Some(s) = s else {
+        if inode_fsck_err!(t, k.k.p, id::dirent_to_missing_subvol,
+                           "dirent points to missing subvolume\n{}", k.to_text(fs))? {
+            dirent::fsck_remove(t, k.k.p)?;
+        }
+        return Ok(());
+    };
+
+    let v = s.v();
+    let fs_path_parent  = v.fs_path_parent().get();
+    let target_inum     = v.inode.get();
+    let target_snapshot = v.snapshot.get();
+
+    if fs_path_parent != parent {
+        let mut path = Printbuf::new();
+        namei::inum_to_path(t, c::subvol_inum { subvol: child as u64, inum: target_inum }, &mut path)?;
+
+        if fsck_err!(t, id::subvol_fs_path_parent_wrong,
+                     "subvol with wrong fs_path_parent, should be {parent}\n{path}\n{}",
+                     s.to_text(fs))? {
+            // grown to a whole subvolume: one from before fs_path_parent is
+            // shorter than the field
+            let mut n = t.bkey_make_mut_noupdate(s)?;
+            n.v_mut().fs_path_parent = parent.into();
+            t.update(&subvol_iter, &n, UpdateTriggerFlags::empty())?;
+        }
+    }
+
+    let Some(mut subvol_root) = inode::find_by_inum_snapshot(t, target_inum, target_snapshot,
+                                                             BtreeIterFlags::empty()).found()? else {
+        bch_err!(fs, "subvol {child} points to missing inode root {target_inum}");
+        return Err(fs.err(bch_errcode::BCH_ERR_fsck_repair_unimplemented));
+    };
+
+    if fsck_err_on!(t, parent != subvol_root.bi_parent_subvol, id::inode_bi_parent_wrong,
+                    "subvol root {target_inum} has wrong bi_parent_subvol: got {}, should be {parent}",
+                    subvol_root.bi_parent_subvol)? {
+        subvol_root.bi_parent_subvol = parent;
+        subvol_root.bi_snapshot      = target_snapshot;
+        inode::fsck_write(t, &mut subvol_root)?;
+    }
+
+    namei::check_dirent_target(t, iter, d, &mut subvol_root, true)
+}
+
+// ---------------------------------------------------------------------------
+// Dirents to inodes
+
+/// The target is missing but @inum has keys in @snapshot: offer to recreate it,
+/// as what its keys say it was - or for xattrs, which don't say, as @d_type.
+/// Xattrs count, or a file of only xattrs would lose its name. Whether the
+/// repair was declined: the dirent is then left alone.
+fn maybe_reconstruct_inum(
+    t:        &TransAttempt<'_, '_>,
+    inum:     u64,
+    snapshot: u32,
+    d_type:   u8,
+) -> Result<bool, BchError> {
+    for (btree, type_) in [(c::btree_id::extents, "reg"),
+                           (c::btree_id::dirents, "dir"),
+                           (c::btree_id::xattrs,  "with xattrs")] {
+        let has_contents = {
+            let mut iter = BtreeIter::new(t, btree, spos(inum, 0, snapshot), BtreeIterFlags::TRIM);
+            iter.peek_max(t, pos(inum, u64::MAX))?.is_some()
+        };
+        if !has_contents {
+            continue;
+        }
+
+        if !inode_fsck_err!(t, spos(0, inum, snapshot), id::missing_inode_with_contents,
+                            "inode {inum}:{snapshot} type {type_} missing, but contents found: reconstruct?")? {
+            return Ok(true);
+        }
+
+        check::reconstruct_inode(t, btree, snapshot, inum, Some(d_type))?;
+        t.commit(None, CommitFlags::NO_ENOSPC)?;
+        return Err(t.restart(bch_errcode::BCH_ERR_transaction_restart_commit));
+    }
+
+    Ok(false)
+}
+
+/// The dirent's target exists only in snapshots descending from the dirent's:
+/// subvolumes in a sibling branch see the dirent and not the inode. Deleting
+/// the dirent would orphan the inodes, so copy it down to each snapshot the
+/// inode exists in, and delete the original.
+fn move_dirent_to_inode_snapshots(
+    t:  &TransAttempt<'_, '_>,
+    k:  BkeySC<'_>,
+    st: &CheckDirents,
+) -> Result<(), BchError> {
+    for i in st.target.inodes() {
+        t.commit_lazy_if_full(CommitFlags::NO_ENOSPC)?;
+
+        let snapshot = i.inode.bi_snapshot;
+
+        // The state firing this is unchanged by the copies: skip those already
+        // committed, or a re-drive after a partial commit makes no progress
+        let copied = {
+            let mut probe = BtreeIter::new(t, c::btree_id::dirents,
+                                           spos(k.k.p.inode, k.k.p.offset, snapshot),
+                                           BtreeIterFlags::empty());
+            let old = probe.peek_slot(t)?.expect("a slot always has a key");
+            old.k.p.snapshot == snapshot &&
+                old.k.key_type() == k.k.key_type() &&
+                old.val_bytes() == k.val_bytes()
+        };
+        if copied {
+            continue;
+        }
+
+        let mut n = t.bkey_make_mut_noupdate(k)?;
+        n.k_mut().p.snapshot = snapshot;
+        t.insert(c::btree_id::dirents, n, UpdateTriggerFlags::INTERNAL_SNAPSHOT_NODE)?;
+    }
+
+    // Delete with the hash info we already have - dirent::fsck_remove()
+    // rederives it from the first inode version it finds:
+    let mut del_iter = BtreeIter::new(t, c::btree_id::dirents, k.k.p, BtreeIterFlags::INTENT);
+    t.iter_traverse(&mut del_iter)?;
+    str_hash::delete_at::<Dirents>(t, &st.hash_info, &mut del_iter,
+                                   UpdateTriggerFlags::INTERNAL_SNAPSHOT_NODE)
+}
+
+/// Returns whether the rest of the key is to be skipped.
+fn check_dirent_to_inode<'t>(
+    t:    &TransAttempt<'_, 't>,
+    iter: &BtreeIter<'t>,
+    k:    BkeySC<'_>,
+    inum: u64,
+    st:   &mut CheckDirents,
+) -> Result<bool, BchError> {
+    let fs = t.fs();
+    let d_snapshot = k.k.p.snapshot;
+
+    st.target.get_visible(t, &st.s, inum)?;
+
+    if st.target.inodes().is_empty() {
+        let d_type = Dirent::new(k).expect("a dirent").d_type();
+        if maybe_reconstruct_inum(t, inum, d_snapshot, d_type)? {
+            return Ok(true);
+        }
+    }
+
+    // The inode must exist in an ancestor of the dirent's snapshot, for every
+    // subvolume that sees the dirent to see it: one only in descendants is
+    // invisible from a sibling branch. Versions come newest snapshot first, from
+    // the dirent's down, so an ancestor's is first.
+    if let Some(first) = st.target.inodes().first() {
+        if !snapshot::is_ancestor(t, d_snapshot, first.inode.bi_snapshot) &&
+           inode_fsck_err!(t, k.k.p, id::dirent_to_inode_in_descendant_snapshot,
+                           "dirent with inode(s) only in descendant snapshots:\n{}", k.to_text(fs))? {
+            move_dirent_to_inode_snapshots(t, k, st)?;
+            // The copies are ahead of the walk: a second pass checks them,
+            // and counts them in their directories.
+            st.need_second_pass = true;
+            return Ok(true);
+        }
+    }
+
+    if st.target.inodes().is_empty() &&
+       inode_fsck_err!(t, k.k.p, id::dirent_to_missing_inode,
+                       "dirent points to missing inode:\n{}", k.to_text(fs))? {
+        dirent::fsck_remove(t, k.k.p)?;
+    }
+
+    for i in st.target.inodes_mut() {
+        // One repair per snapshot version of the target inode, bounded only
+        // by snapshot count. The re-drive converges: get_visible() rereads
+        // the versions, and committed repairs no longer fire.
+        t.commit_lazy_if_full(CommitFlags::NO_ENOSPC)?;
+        check::own_version(t, &mut i.inode, d_snapshot);
+        namei::check_dirent_target(t, iter, Dirent::new(k).expect("a dirent"), &mut i.inode, true)?;
+    }
+
+    for &snapshot in st.target.deletes() {
+        if st.s.has_id(snapshot) {
+            continue;
+        }
+
+        t.commit_lazy_if_full(CommitFlags::NO_ENOSPC)?;
+
+        let mut delete_iter = BtreeIter::new(t, c::btree_id::dirents,
+                                             spos(k.k.p.inode, k.k.p.offset, snapshot),
+                                             BtreeIterFlags::INTENT);
+
+        // Still visible here? A re-drive after a partial commit must skip the
+        // whiteouts already committed to make progress, and a dirent no longer
+        // visible mustn't be reported again.
+        let visible = delete_iter.peek_slot(t)?.expect("a slot always has a key");
+        if visible.k.key_type() != c::bch_bkey_type::KEY_TYPE_dirent {
+            continue;
+        }
+        let visible_pos = visible.k.p;
+
+        if inode_fsck_err!(t, visible_pos, id::dirent_to_overwritten_inode,
+                           "dirent points to inode overwritten in snapshot {snapshot}:\n{}",
+                           k.to_text(fs))? {
+            str_hash::delete_at::<Dirents>(t, &st.hash_info, &mut delete_iter,
+                                           UpdateTriggerFlags::INTERNAL_SNAPSHOT_NODE)?;
+        }
+    }
+
+    Ok(false)
+}
+
+// ---------------------------------------------------------------------------
+
+fn check_dirent<'t>(
+    t:    &TransAttempt<'_, 't>,
+    iter: &BtreeIter<'t>,
+    k:    BkeySC<'_>,
+    st:   &mut CheckDirents,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+
+    if snapshot::check_key_has_snapshot(t, iter, k)? {
+        return Ok(());
+    }
+
+    st.s.update(k.k.p)?;
+
+    if k.k.key_type() == c::bch_bkey_type::KEY_TYPE_whiteout {
+        return Ok(());
+    }
+
+    // The walk has left the last directory: its subdirectory counts are done.
+    if st.dir.cur_inum().is_some_and(|inum| inum != k.k.p.inode) {
+        check_subdir_dirents_count(t, &mut st.dir)?;
+    }
+
+    let Some(w) = st.dir.walk(t, iter, k)? else { return Ok(()) };
+    if w.first_this_inode {
+        st.hash_info = str_hash::hash_info_init(fs, w.inode)?;
+    }
+    st.hash_info.cf_encoding = inode::cf_encoding(fs, w.inode);
+
+    match str_hash::check_key::<Dirents>(t, Some(&mut st.s), &mut st.hash_info,
+                                         k, &mut st.need_second_pass) {
+        Ok(()) => {}
+        // A casefold mismatch repair deletes the dirent and recreates it
+        // where it hashes to: nothing more to check here.
+        Err(e) if e.matches(bch_errcode::BCH_ERR_str_hash_key_repaired) => return Ok(()),
+        Err(e) => {
+            // A hash info repair leaves the walker's inodes - and hash_info,
+            // initialized from them - stale:
+            st.dir.invalidate();
+            return Err(e);
+        }
+    }
+
+    let Some(d) = Dirent::new(k) else { return Ok(()) };
+    let d_snapshot = k.k.p.snapshot;
+    // Key values aren't valid after a commit without revalidating:
+    let have_dir = d.d_type() as u32 == c::DT_DIR;
+
+    match d.target() {
+        DirentTarget::Subvol { child, parent } => check_dirent_to_subvol(t, iter, d, child, parent)?,
+        DirentTarget::Inode(inum) => {
+            if check_dirent_to_inode(t, iter, k, inum, st)? {
+                return Ok(());
+            }
+        }
+    }
+
+    t.commit(None, CommitFlags::NO_ENOSPC)?;
+
+    if have_dir {
+        for i in st.dir.visible_mut(t, &st.s, d_snapshot) {
+            i.count += 1;
+        }
+    }
+
+    Ok(())
+}
+
+fn check_dirents(fs: &Fs) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+    let mut st = CheckDirents {
+        s:                SnapshotsSeen::new(),
+        dir:              InodeWalker::new(),
+        target:           InodeWalker::new(),
+        hash_info:        Default::default(),
+        need_second_pass: false,
+    };
+    let mut did_second_pass = false;
+
+    loop {
+        let progress = Progress::recovery(fs, c"bch2_check_dirents", &[c::btree_id::dirents], &[]);
+        let mut iter = BtreeIter::new(&trans, c::btree_id::dirents,
+                                      pos(c::BCACHEFS_ROOT_INO as u64, 0),
+                                      BtreeIterFlags::PREFETCH | BtreeIterFlags::ALL_SNAPSHOTS);
+
+        iter.for_each_commit(&trans, None, CommitFlags::NO_ENOSPC, |t, iter, k| {
+            progress.update(t, iter)?;
+            check_dirent(t, iter, k, &mut st)
+        })?;
+
+        // The last directory's subdirectory counts, as in the loop, with the
+        // restart it may end in retried here.
+        lockrestart_do(&trans, |t| check_subdir_dirents_count(t, &mut st.dir))?;
+
+        // A directory that's become a file, or the reverse, may have been
+        // counted in its parent before the walk got to it:
+        st.need_second_pass |= st.dir.take_changed_inode_type();
+
+        if !st.need_second_pass {
+            return Ok(());
+        }
+
+        if did_second_pass {
+            bch_err!(fs, "dirents not repairing");
+            return Err(c::EINVAL.into());
+        }
+
+        bch_info!(fs, "check_dirents requires second pass");
+        did_second_pass = true;
+        st.need_second_pass = false;
+    }
+}
+
+crate::recovery_pass!(bch2_check_dirents => check_dirents);
