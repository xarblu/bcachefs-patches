diff --git a/fs/bcachefs/data/ec/create_types.rs b/fs/bcachefs/data/ec/create_types.rs
new file mode 100644
index 0000000..3a37e4d
--- /dev/null
+++ b/fs/bcachefs/data/ec/create_types.rs
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::data::ec::stripe_new::StripeNewBox;
+use crate::locking::Lock;
+use crate::types::{bits_to_longs, c_opaque};
+use crate::util::bitmap::BitArray;
+use core::ffi::{c_uint, c_ulong};
+use cstruct_macros::{c_enum, c_xmacro, CStruct};
+use pin_init::pin_data;
+
+/// A disk label's striping of new stripes' buckets across its devices - in
+/// bch_fs_ec.dev_stripe_states, by label, made on first use: shared by the
+/// label's stripe heads, and repairs. Freed only with the filesystem.
+#[pin_data]
+#[repr(C)]
+#[derive(CStruct)]
+pub struct ec_dev_stripe_state {
+    #[c_lock("struct mutex lock")]
+    #[pin]
+    pub lock: Lock<c::mutex, DevStripes>,
+
+    pub disk_label: c_uint,
+}
+
+/// What an ec_dev_stripe_state's lock protects: how the buckets of new
+/// stripes' data blocks, and of their parity, have been spread across the
+/// devices, for the allocator to go on spreading them.
+#[repr(C)]
+#[derive(Clone, Copy, Default, CStruct)]
+pub struct DevStripes {
+    pub block_stripe: c::dev_stripe_state,
+    pub parity_stripe: c::dev_stripe_state,
+}
+
+c_xmacro! {
+    /*
+     * open:	the sector allocator can still hand blocks out of this stripe;
+     *		it's the stripe head's h->s.
+     * filling:	every block has been handed to a writer, but the writers haven't
+     *		finished - buckets are still checked out, and the stripe can
+     *		only be completed by the writers that already hold them.
+     * in_flight:	every bucket has come back, the data is all in, and its task
+     *		is creating it. This is the only state guaranteed to make
+     *		progress on its own.
+     *
+     * The filling/in_flight split is what makes it possible to wait on stripe
+     * buffer memory safely: a stripe that is filling may never complete (its
+     * writers can go away), so blocking on one can deadlock, while an in_flight
+     * stripe always drains.
+     */
+    EC_STRIPE_NEW_STATES(x) {
+        (open),
+        (filling),
+        (in_flight),
+    }
+}
+
+c_enum! {
+    #[closed]
+    pub enum ec_stripe_new_state: u32 {
+        EC_STRIPE_NEW_STATES(n) => EC_STRIPE_NEW_ ## n,
+        EC_STRIPE_NEW_STATE_NR,
+    }
+}
+
+/// A set of a stripe's blocks, by index.
+pub type StripeBlockMask = BitArray<{ bits_to_longs(c::BCH_BKEY_PTRS_MAX as usize) }>;
+
+// data/ec/stripe_new.rs's StripeNew, to C: what ob->ec points to
+c_opaque!(ec_stripe_new);
+
+/// The sector allocator's source of erasure coded buckets, one per disk label,
+/// algorithm, redundancy and watermark - its key, fixed when it's made - and
+/// the stripe it's filling, @s. In bch_fs_ec.stripe_heads, made on first use,
+/// freed with the filesystem.
+#[pin_data]
+#[repr(C)]
+#[derive(CStruct)]
+pub struct ec_stripe_head {
+    #[c_lock("struct mutex lock")]
+    #[pin]
+    pub lock: Lock<c::mutex, HeadState>,
+
+    pub disk_label: c_uint,
+    pub algo: c_uint,
+    pub redundancy: c_uint,
+    pub watermark: c::bch_watermark,
+}
+
+/// The devices a stripe head makes stripes on - its disk label's, as
+/// disk_label_ec_devs() has them - and what follows from them, all as of one
+/// count of the allocator's RW device changes: set together, by
+/// stripe_head_devs_update(), whenever that's moved on.
+#[repr(C)]
+#[derive(Default, CStruct)]
+pub struct HeadDevs {
+    /// The allocator's rw_devs_change_count they're as of
+    pub change_count: c_ulong,
+    pub mask:         c::bch_devs_mask,
+    pub nr_active:    c_uint,
+    pub blocksize:    c_uint,
+    /// Too few for the head's redundancy: it makes no stripes
+    pub insufficient: bool,
+}
+
+/// What a stripe head's lock protects: the devices it makes stripes on, and
+/// the stripe being filled - the head's, till it hands it on.
+#[repr(C)]
+#[derive(Default, CStruct)]
+pub struct HeadState {
+    pub devs: HeadDevs,
+
+    pub nr_created: u64,
+
+    #[c("struct ec_stripe_new *s")]
+    pub s: Option<StripeNewBox>,
+}
diff --git a/fs/bcachefs/data/ec/delete.rs b/fs/bcachefs/data/ec/delete.rs
new file mode 100644
index 0000000..1aef1f7
--- /dev/null
+++ b/fs/bcachefs/data/ec/delete.rs
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Deleting stripes gone empty: the stripe trigger queues the work, and
+//! the worker walks the stripe lru's empty end.
+
+use crate::alloc::lru::{LruId, LruPos};
+use crate::btree::bkey::{pos, BkeyV};
+use crate::btree::iter::{BtreeIter, BtreeIterFlags, CommitFlags, TransAttempt, UpdateTriggerFlags};
+use crate::c;
+use crate::data::ec::stripe::STRIPE_LRU_POS_EMPTY;
+use crate::errcode::BchError;
+use crate::fs::Fs;
+use crate::sb::counters::events;
+use crate::util::ffi::Opaque;
+use crate::util::place::Placed;
+use crate::{btree_trans, fs_inconsistent, prt};
+use cstruct_macros::c_export;
+
+// ── Stripe deletion ──────────────────────────────────────────────────────
+//
+// A stripe is deleted once it's empty, and not while it's open - held by a
+// stripe being created, or by repair. The stripe trigger deletes one that
+// empties while it isn't; the holders delete theirs as they let go; and the
+// worker deletes whatever empty stripes the stripe lru still has.
+
+/// Delete stripe @idx if it's empty: ec_stripe_delete(). @is_open: the
+/// caller holds it open, so it must exist.
+pub(crate) fn stripe_delete(t: &TransAttempt<'_, '_>, idx: u64, is_open: bool) -> Result<(), BchError> {
+    let fs = t.fs();
+    let mut iter = BtreeIter::new(t, c::btree_id::stripes, pos(0, idx), BtreeIterFlags::INTENT);
+    let k = iter.peek_slot(t)?.expect("a slot");
+
+    // checked with the stripe intent locked: an existing stripe is opened
+    // only under that lock - bch2_stripe_tryget_existing() - so a
+    // create can't open it, and load the key we're deleting, before we commit
+    if !is_open && fs.stripe_is_open(idx) {
+        return Ok(());
+    }
+
+    // the worker races with the write buffer: its lru entry can outlive the
+    // stripe. An open stripe must exist, but needn't be empty.
+    let Some(s) = k.arm::<c::Stripe>() else {
+        if is_open {
+            fs_inconsistent!(fs, "error deleting stripe: open stripe {idx} missing\n{}", k.to_text(fs));
+        }
+        return Ok(());
+    };
+
+    if s.v().lru_pos() != STRIPE_LRU_POS_EMPTY {
+        return Ok(());
+    }
+
+    fs.event_inc_trace(events::stripe_delete, |out| prt!(out, "{}", k.to_text(fs)));
+    t.delete_at(&iter, UpdateTriggerFlags::empty())
+}
+
+/// Deletes empty stripes that aren't open. They sit at lru time
+/// STRIPE_LRU_POS_EMPTY, ahead of every reusable one: it walks just those.
+///
+/// XXX: can we kill this and delete stripes from the trigger?
+pub(crate) fn delete_empty_stripes(ec: &c::bch_fs_ec) {
+    let fs = ec.container();
+    let trans = btree_trans!(fs);
+    let at = |offset| LruPos::new(LruId::Stripes.id(), STRIPE_LRU_POS_EMPTY, offset).to_bpos();
+
+    // as C's: errors - going read-only - end the walk, and are dropped
+    let _ = trans.write_buffer_tryflush().and_then(|_| {
+        BtreeIter::new(&trans, c::btree_id::lru, at(0), BtreeIterFlags::empty())
+            .for_each_max_commit(&trans, at(u64::MAX), BtreeIterFlags::empty(), None,
+                                 CommitFlags::NO_ENOSPC, |t, _, k| stripe_delete(t, k.k.p.offset, false))
+    });
+}
+
+impl Fs {
+    /// Kick the worker that deletes empty stripes, unless the filesystem's
+    /// going read-only: bch2_do_stripe_deletes().
+    pub fn do_stripe_deletes(&self) {
+        self.ec.stripe_delete_work.queue(self.write_ref_wq());
+    }
+}
+
+#[c_export]
+pub fn bch2_do_stripe_deletes(c: &Opaque<c::bch_fs>) {
+    Fs::from_c(c).do_stripe_deletes()
+}
