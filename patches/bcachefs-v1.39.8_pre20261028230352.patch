diff --git a/fs/bcachefs/vfs/dentry.rs b/fs/bcachefs/vfs/dentry.rs
new file mode 100644
index 0000000..09e1015
--- /dev/null
+++ b/fs/bcachefs/vfs/dentry.rs
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! The VFS's dentry, for Rust's VFS entry points. A Dentry is one borrowed
+//! for a VFS call, which holds a reference on it for as long as it runs:
+//! that's 'a.
+//!
+//! d_parent changes under rename, and the old parent can go once it has; it's
+//! read under d_lock, which rename takes to change it.
+//!
+//! A directory's dentry has the kernel's casefolding d_hash and d_compare as
+//! its ops from when its inode is attached - d_alloc() runs before that, so
+//! it can't choose them - but they're used only while DCACHE_OP_HASH and
+//! DCACHE_OP_COMPARE are set, while the directory is casefolded: the RCU
+//! lookup checks the parent's flag, so other directories keep the inline
+//! compare. A change of casefolding changes only the flags - never the ops,
+//! so a lockless reader never sees a flag without its op. The flags change
+//! under d_lock, as a single write: d_wait_lookup() sets
+//! DCACHE_LOOKUP_WAITERS under it, which an unlocked read-modify-write could
+//! erase.
+
+use core::ffi::CStr;
+use core::marker::PhantomData;
+use core::ptr::NonNull;
+
+use crate::c;
+use crate::errcode::{errptr_to_result, BchError};
+use crate::inode_opts::InodeOpt;
+use crate::locking::Lock;
+use crate::util::os_str::{qstr_name, OsStr};
+use cstruct_macros::c_export;
+
+use kernel::sync::aref::ARef;
+
+use super::inode::{InodeInfo, InodeRef};
+use super::vfs_inode::VfsInode;
+
+#[cfg(CONFIG_UNICODE)]
+// SAFETY, of the CStatic: immutable, its only parts that aren't Sync pointers
+static CASEFOLD_OPS: crate::types::CStatic<c::dentry_operations> = unsafe {
+    crate::types::CStatic::new(c::dentry_operations {
+        d_hash:    Some(c::generic_ci_d_hash),
+        d_compare: Some(c::generic_ci_d_compare),
+        // SAFETY: zero is NULL, an op not implemented
+        ..core::mem::zeroed()
+    })
+};
+
+#[derive(Clone, Copy)]
+pub struct Dentry<'a> {
+    raw:  *mut c::dentry,
+    _ref: PhantomData<&'a c::dentry>,
+}
+
+impl<'a> Dentry<'a> {
+    /// # Safety
+    /// @raw is a dentry the VFS holds a reference on, for 'a - its inode, if
+    /// it has one, one of ours.
+    pub unsafe fn borrow_raw(raw: *mut c::dentry) -> Self {
+        Dentry { raw, _ref: PhantomData }
+    }
+
+    pub fn as_ptr(&self) -> *mut c::dentry {
+        self.raw
+    }
+
+    /// Stable while its directory is locked, as the namespace operations
+    /// hold it.
+    pub fn name(&self) -> &'a OsStr {
+        unsafe {
+            // 6.18 made d_name a const union member, __d_name its writable alias
+            #[cfg(linux_ge = "6.18")]
+            let name = &(*self.raw).__bindgen_anon_1.d_name;
+            #[cfg(not(linux_ge = "6.18"))]
+            let name = &(*self.raw).d_name;
+            qstr_name(name)
+        }
+    }
+
+    /// Drop it, and what's cached under it.
+    pub fn invalidate(&self) {
+        unsafe { c::d_invalidate(self.raw) }
+    }
+
+    /// A positive dentry's inode.
+    pub fn inode(&self) -> &'a InodeInfo {
+        self.inode_opt().expect("the inode of a negative dentry")
+    }
+
+    pub fn inode_opt(&self) -> Option<&'a InodeInfo> {
+        // SAFETY: ours, as borrow_raw() was promised. A referenced positive
+        // dentry stays positive - d_delete() only unhashes one with other
+        // references - and a negative one stays negative while the call holds
+        // its directory locked, as a namespace operation does
+        let inode = unsafe { (*self.raw).d_inode };
+        (!inode.is_null()).then(|| unsafe { InodeInfo::from_inode(inode) })
+    }
+
+    /// Inode option @opt of the parent directory - None at the root, which
+    /// has none: what clearing it on this inode inherits.
+    pub fn parent_inode_opt(&self, opt: InodeOpt) -> Option<u64> {
+        let _d_lock = self.d_lock().lock();
+
+        // A root is its own parent:
+        let parent = unsafe { (*self.raw).d_parent };
+        if parent == self.raw {
+            return None;
+        }
+        // SAFETY: held by this dentry while d_lock is; a directory of ours
+        let dir = unsafe { InodeInfo::from_inode((*parent).d_inode) };
+        Some(opt.get(&dir.inode()))
+    }
+
+    fn d_lock(&self) -> &Lock<c::spinlock_t> {
+        // SAFETY: referenced, so live; d_lock is a #define, d_lockref.lock, and
+        // c::spinlock_t the kernel's spinlock_t in an Opaque
+        Lock::from_c(unsafe {
+            &*(&raw const (*self.raw).d_lockref.__bindgen_anon_1.__bindgen_anon_1.lock).cast::<c::spinlock_t>()
+        })
+    }
+
+    /// DCACHE_OP_HASH and DCACHE_OP_COMPARE, set while @inode is casefolded.
+    /// d_lock held.
+    #[cfg(CONFIG_UNICODE)]
+    fn set_casefold_flags(&self, inode: &VfsInode) {
+        let op = c::DCACHE_OP_HASH | c::DCACHE_OP_COMPARE;
+        // SAFETY: referenced; d_flags is written under d_lock, which is held,
+        // and read without it - READ_ONCE(), WRITE_ONCE()
+        unsafe {
+            let p = &raw mut (*self.raw).d_flags;
+            let flags = core::ptr::read_volatile(p);
+            core::ptr::write_volatile(p, if inode.flag(c::S_CASEFOLD) { flags | op } else { flags & !op });
+        }
+    }
+
+    /// Casefolding was turned on or off on this directory: drop its cached
+    /// children, whose names were folded the old way, and use its ops or
+    /// not.
+    pub fn casefold_changed(&self) {
+        #[cfg(CONFIG_UNICODE)]
+        if let Some(dir) = self.inode_opt().filter(|i| i.vfs().is_dir()) {
+            unsafe { c::shrink_dcache_parent(self.raw) };
+            let _d_lock = self.d_lock().lock();
+            self.set_casefold_flags(dir.vfs());
+        }
+    }
+
+    /// For a directory @inode, before it's this dentry's: the dentry ops that
+    /// fold names, which it uses while @inode is casefolded.
+    pub fn set_casefold_ops(&self, inode: &VfsInode) {
+        #[cfg(CONFIG_UNICODE)]
+        if inode.is_dir() {
+            let _d_lock = self.d_lock().lock();
+            // SAFETY: referenced; d_op is set under d_lock, before the flags
+            // that have it used
+            unsafe { (*self.raw).d_op = &*CASEFOLD_OPS };
+            self.set_casefold_flags(inode);
+        }
+        #[cfg(not(CONFIG_UNICODE))]
+        let _ = inode;
+    }
+
+    /// Give it @inode - None for a negative dentry - or give @inode's alias
+    /// instead, for ->lookup to return: d_splice_alias(), which takes the
+    /// reference, whatever it returns.
+    pub fn splice_alias(self, inode: Option<InodeRef>) -> *mut c::dentry {
+        let inode = inode.map_or(core::ptr::null_mut(), |i| ARef::into_raw(i).as_ptr().cast());
+        unsafe { c::d_splice_alias(inode, self.raw) }
+    }
+
+    /// Make this negative dentry @inode's: d_instantiate(), which takes the
+    /// reference.
+    pub fn instantiate(&self, inode: InodeRef) {
+        unsafe { c::d_instantiate(self.raw, ARef::into_raw(inode).as_ptr().cast()) }
+    }
+
+    /// A dentry for @inode, connected or not, as exportfs wants one - its
+    /// casefold ops set, for a directory: d_obtain_alias(), which takes the
+    /// reference. An error, classed, as an ERR_PTR.
+    pub fn obtain_alias(inode: Result<InodeRef, BchError>) -> *mut c::dentry {
+        let inode = match inode {
+            Ok(inode) => inode,
+            Err(e)    => return e.class() as isize as *mut c::dentry,
+        };
+        let vinode = inode.vfs().as_ptr();
+        let dentry = unsafe { c::d_obtain_alias(ARef::into_raw(inode).as_ptr().cast()) };
+        if errptr_to_result(NonNull::new(dentry).expect("a dentry, or an error")).is_ok() {
+            // SAFETY: the dentry's, which holds the inode's reference
+            unsafe { Dentry::borrow_raw(dentry).set_casefold_ops(&*vinode.cast::<VfsInode>()) };
+        }
+        dentry
+    }
+
+    /// The prefix xattrs of @ty list under, here - None for a type that
+    /// isn't listed, or that the caller may not see.
+    pub fn xattr_list_prefix(&self, ty: c::bch_xattr_type) -> Option<&'static CStr> {
+        crate::xattr::list_prefix(ty, self.raw)
+    }
+}
+
+/// For C's mount, until it's Rust: the root's.
+///
+/// # Safety
+/// @dentry and @vinode are ours, referenced, for the call.
+#[c_export]
+pub unsafe fn bch2_dentry_set_casefold_ops(dentry: *mut c::dentry, vinode: *mut c::inode) {
+    unsafe { Dentry::borrow_raw(dentry).set_casefold_ops(InodeInfo::from_inode(vinode).vfs()) }
+}
diff --git a/fs/bcachefs/vfs/dir.rs b/fs/bcachefs/vfs/dir.rs
new file mode 100644
index 0000000..c707857
--- /dev/null
+++ b/fs/bcachefs/vfs/dir.rs
@@ -0,0 +1,229 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A directory as an open file: readdir, and the position it's up to.
+//!
+//! A readdir position, ctx->pos, is a dirent's offset in the dirents btree -
+//! its name's hash, 64 bits - with 0 and 1 for "." and "..". The 32-bit
+//! getdents ABIs round-trip d_off through a signed long and d_ino through an
+//! unsigned long, so a 32-bit reader gets cookies: the position shifted down
+//! by the hash's spare bits - none for a 31-bit hash, one for crc32c, 32 for
+//! the 64-bit ones - and kept in [READDIR_32_FIRST, READDIR_32_EOF), and the
+//! inode number truncated, 0 made 1. READDIR_32_EOF is no position's: a
+//! readdir sets it only when it runs out of dirents, so a stateless reader -
+//! NFS - stops, rather than rescanning the last cookie's granule forever.
+//!
+//! A cookie is lossy, so the open directory - Dir, the file's private data -
+//! keeps the last one it handed out and the exact position after it, its
+//! Cookie, and a readdir that resumes at that cookie resumes there. A seek
+//! forgets it.
+//!
+//! The Cookie is changed only by readdir and llseek, which the VFS serializes
+//! on one open file: under f_pos_lock where the file is shared - fdget_pos()
+//! always takes it for a file with iterate_shared - and by its one user where
+//! it isn't, as nfsd's and overlayfs's own files are. So it's LockedBy that,
+//! not a lock of its own, and there's no lock to assert.
+//!
+//! The 32-bit readdir puts its own dir_context, Readdir32's, in front of the
+//! VFS's: the actor, emit32(), translates each entry and hands it on.
+//!
+//! Dir's FileOps are the directory file_operations, bch2_dir_file_ops;
+//! fsync is still C's.
+
+use core::ffi::{c_int, c_uint};
+use core::pin::Pin;
+use kernel::ffi::{c_long, c_ulong};
+
+use crate::c;
+use crate::dirent::{self, DirContext};
+use crate::errcode::{ret_to_result_void, BchError};
+use crate::locking::LockedBy;
+use crate::str_hash;
+use crate::util::alloc::{flags, KBox};
+use crate::util::ffi::{c_char, Opaque};
+use crate::util::file::{File, FileOps, FileVTable, UserBuf};
+use cstruct_macros::{c_export, vtable};
+
+use super::file::bch2_fsync;
+use super::inode::InodeInfo;
+use super::ioctl::fs_file_ioctl;
+
+const READDIR_32_FIRST: i64 = 2;
+const READDIR_32_EOF: i64 = i32::MAX as i64;
+
+#[derive(Default)]
+struct Cookie {
+    valid:    bool,
+    cookie:   i64,
+    next_pos: u64,
+}
+
+/// Whether @file's reader takes 32-bit cookies: as the file was opened, or
+/// as the syscall is.
+fn dirents_32bit(file: &File) -> bool {
+    let mode = file.mode();
+    mode & c::FMODE_32BITHASH != 0 ||
+        (mode & c::FMODE_64BITHASH == 0 &&
+         (cfg!(target_pointer_width = "32") || unsafe { c::in_compat_syscall() }))
+}
+
+fn cookie_shift(hash: &c::bch_hash_info) -> u32 {
+    if hash.is_31bit {
+        0
+    } else if hash.type_ as u32 == c::bch_str_hash_type::BCH_STR_HASH_crc32c.0 {
+        1
+    } else {
+        32
+    }
+}
+
+fn pos_to_32(shift: u32, pos: u64) -> i64 {
+    if pos < READDIR_32_FIRST as u64 || shift == 0 {
+        return (pos as i64).min(READDIR_32_EOF - 1);
+    }
+    ((pos >> shift) as i64).clamp(READDIR_32_FIRST, READDIR_32_EOF - 1)
+}
+
+fn pos_from_32(shift: u32, pos: i64) -> u64 {
+    if pos < READDIR_32_FIRST || shift == 0 {
+        pos as u64
+    } else if pos == READDIR_32_FIRST {
+        READDIR_32_FIRST as u64
+    } else if pos >= READDIR_32_EOF {
+        u64::MAX
+    } else {
+        (pos as u64) << shift
+    }
+}
+
+/// @ctx first: emit32() is given it, and takes it to the whole.
+#[repr(C)]
+struct Readdir32<'a> {
+    ctx:   c::dir_context,
+    dst:   *mut c::dir_context,
+    cookie: &'a mut Cookie,
+    shift: u32,
+    /// An entry was refused: the readdir stopped at a full buffer, not the end.
+    full:  bool,
+}
+
+unsafe extern "C" fn emit32(ctx: *mut c::dir_context, name: *const c_char, namelen: c_int,
+                            offset: c::loff_t, ino: u64, d_type: c_uint) -> bool {
+    // SAFETY: a Readdir32's ctx, given as the whole Readdir32's pointer
+    let r = unsafe { &mut *ctx.cast::<Readdir32<'_>>() };
+    let cookie = pos_to_32(r.shift, offset as u64);
+    let ino = (ino as u32).max(1);
+
+    // SAFETY: the VFS's dir_context, and its actor
+    let emitted = unsafe {
+        let actor = (*r.dst).actor.expect("a dir_context's actor");
+        actor(r.dst, name, namelen, cookie, ino as u64, d_type)
+    };
+    if emitted {
+        *r.cookie = Cookie { valid: true, cookie, next_pos: offset as u64 + 1 };
+    } else {
+        r.full = true;
+    }
+    emitted
+}
+
+pub(crate) struct Dir(LockedBy<Cookie>);
+
+impl Dir {
+    /// # Safety
+    /// In readdir or llseek, which the VFS serializes on one open file.
+    unsafe fn cookie(&self) -> &mut Cookie {
+        unsafe { self.0.protected_mut() }
+    }
+}
+
+#[vtable]
+impl FileOps for Dir {
+    // #[vtable] sees compat_ioctl() whether or not it's built
+    const HAS_COMPAT_IOCTL: bool = cfg!(CONFIG_COMPAT);
+
+    fn open(_inode: &Opaque<c::inode>, _file: &File) -> Result<Pin<KBox<Self>>, BchError> {
+        Ok(KBox::pin(Dir(LockedBy::new(Cookie::default(), ())), flags::GFP_KERNEL)?)
+    }
+
+    /// generic_read_dir()'s: read(2) of a directory is EISDIR.
+    fn read(&self, _file: &File, _buf: &mut UserBuf) -> Result<(), BchError> {
+        Err(BchError::from(c::EISDIR))
+    }
+
+    /// A 32-bit reader's positions are cookies, up to READDIR_32_EOF.
+    fn llseek(&self, file: &File, offset: i64, whence: c_int) -> c::loff_t {
+        let max = if dirents_32bit(file) { READDIR_32_EOF } else { i64::MAX };
+
+        // SAFETY: llseek
+        unsafe { self.cookie() }.valid = false;
+        unsafe { c::generic_file_llseek_size(file.as_ptr(), offset, whence, max, max) }
+    }
+
+    fn iterate_shared(&self, file: &File, ctx: *mut c::dir_context) -> Result<(), BchError> {
+        // SAFETY: an open file's inode
+        let inode = unsafe { InodeInfo::from_inode((*file.as_ptr()).f_inode) };
+        let fs = inode.fs();
+        let hash = &mut str_hash::hash_info_init(fs, &inode.inode())?;
+
+        let ret = if !dirents_32bit(file) {
+            // SAFETY: the VFS's, for the call
+            match unsafe { c::dir_emit_dots(file.as_ptr(), ctx) } {
+                true  => dirent::readdir(fs, inode.inum(), hash, unsafe { DirContext::from_raw(ctx) }),
+                false => Ok(()),
+            }
+        } else {
+            // SAFETY: readdir; and the VFS's ctx
+            let (cookie, pos) = unsafe { (self.cookie(), (*ctx).pos) };
+            let shift = cookie_shift(hash);
+            let start = if cookie.valid && cookie.cookie == pos {
+                cookie.next_pos
+            } else {
+                pos_from_32(shift, pos)
+            };
+
+            let mut r = Readdir32 {
+                ctx:    c::dir_context { actor: Some(emit32), pos: start as c::loff_t, ..Default::default() },
+                dst:    ctx,
+                cookie,
+                shift,
+                full:   false,
+            };
+            // Its actor reaches the rest of it: the whole Readdir32's pointer
+            let r32 = (&raw mut r).cast::<c::dir_context>();
+
+            let ret = match unsafe { c::dir_emit_dots(file.as_ptr(), r32) } {
+                true  => dirent::readdir(fs, inode.inum(), hash, unsafe { DirContext::from_raw(r32) }),
+                false => Ok(()),
+            };
+
+            // Out of dirents, or stopped at a full buffer - the dots' too: only
+            // the actor knows
+            let eof = ret.is_ok() && !r.full;
+            // SAFETY: the VFS's
+            unsafe { (*ctx).pos = if eof { READDIR_32_EOF } else { pos_to_32(shift, r.ctx.pos as u64) } };
+            ret
+        };
+        crate::bch_err_fn!(fs, ret)
+    }
+
+    fn fsync(&self, file: &File, start: i64, end: i64, datasync: c_int) -> Result<(), BchError> {
+        ret_to_result_void(unsafe { bch2_fsync(file.as_ptr(), start, end, datasync) })
+    }
+
+    fn unlocked_ioctl(&self, file: &File, cmd: c_uint, arg: c_ulong) -> c_long {
+        fs_file_ioctl(file, cmd, arg)
+    }
+
+    #[cfg(CONFIG_COMPAT)]
+    fn compat_ioctl(&self, file: &File, cmd: c_uint, arg: c_ulong) -> c_long {
+        super::ioctl::fs_file_compat_ioctl(file, cmd, arg)
+    }
+}
+
+#[c_export]
+pub static bch2_dir_file_ops: c::file_operations = {
+    let mut ops = FileVTable::<Dir>::OPS;
+    // As a regular file's (file.rs): no module reference by each open
+    ops.owner = core::ptr::null_mut();
+    ops
+};
diff --git a/fs/bcachefs/vfs/direct.c b/fs/bcachefs/vfs/direct.c
new file mode 100644
index 0000000..562c0f5
--- /dev/null
+++ b/fs/bcachefs/vfs/direct.c
@@ -0,0 +1,634 @@
+// SPDX-License-Identifier: GPL-2.0
+#ifndef NO_BCACHEFS_FS
+
+#include "bcachefs.h"
+
+#include "alloc/foreground.h"
+
+#include "data/read.h"
+#include "data/write.h"
+
+#include "vfs/fs.h"
+#include "vfs/io.h"
+#include "vfs/direct.h"
+#include "vfs/pagecache.h"
+
+#include "vendor/bio_iov_iter.h"
+
+#include "util/enumerated_ref.h"
+
+#include <linux/kthread.h>
+#include <linux/pagemap.h>
+#include <linux/prefetch.h>
+#include <linux/task_io_accounting_ops.h>
+
+/* O_DIRECT reads */
+
+static void bio_check_or_release(struct bio *bio, bool check_dirty)
+{
+	if (check_dirty) {
+		bch2_bio_check_pages_dirty(bio);
+	} else {
+		bio_release_pages(bio, false);
+		bio_put(bio);
+	}
+}
+
+static CLOSURE_CALLBACK(bch2_dio_read_complete)
+{
+	closure_type(dio, struct dio_read, cl);
+
+	dio->req->ki_complete(dio->req, dio->ret);
+	bio_check_or_release(&dio->rbio.bio, dio->should_dirty);
+}
+
+static void bch2_direct_IO_read_endio(struct bio *bio)
+{
+	struct bch_read_bio *rbio = to_rbio(bio);
+	struct dio_read *dio = bio->bi_private;
+
+	/*
+	 * no_poison_check asks for what is physically there. The read still
+	 * failed, and said so - err_report carries which errors - but the bytes
+	 * it got are in the caller's buffer, and replacing the count with the
+	 * error is what throws them away.
+	 */
+	if (rbio->ret && !(dio->flags & BCH_READ_no_poison_check))
+		dio->ret = bch2_err_class(rbio->ret);
+
+	closure_put(&dio->cl);
+}
+
+static void bch2_direct_IO_read_split_endio(struct bio *bio)
+{
+	struct dio_read *dio = bio->bi_private;
+	bool should_dirty = dio->should_dirty;
+
+	bch2_direct_IO_read_endio(bio);
+	bio_check_or_release(bio, should_dirty);
+}
+
+static int __bch2_direct_IO_read(struct kiocb *req, struct iov_iter *iter,
+				enum bch_read_flags flags,
+				struct bch_read_err_report *err_report)
+{
+	struct file *file = req->ki_filp;
+	struct bch_inode_info *inode = file_bch_inode(file);
+	struct bch_fs *c = inode->v.i_sb->s_fs_info;
+	struct dio_read *dio;
+	struct bio *bio;
+	loff_t offset = req->ki_pos;
+	bool sync = is_sync_kiocb(req);
+	bool split = false;
+	size_t shorten;
+	ssize_t ret;
+
+	struct bch_inode_opts opts;
+	bch2_inode_opts_get_inode(c, &inode->ei_inode, &opts);
+
+	/* bios must be 512 byte aligned: */
+	if ((offset|iter->count) & (SECTOR_SIZE - 1))
+		return bch_err_throw(c, EINVAL_unaligned_io);
+
+	ret = min_t(loff_t, iter->count,
+		    max_t(loff_t, 0, i_size_read(&inode->v) - offset));
+
+	if (!ret)
+		return ret;
+
+	shorten = iov_iter_count(iter) - round_up(ret, block_bytes(c));
+	if (shorten >= iter->count)
+		shorten = 0;
+	iter->count -= shorten;
+
+	bio = bio_alloc_bioset(NULL,
+			       bio_iov_vecs_to_alloc(iter, BIO_MAX_VECS),
+			       REQ_OP_READ,
+			       GFP_KERNEL,
+			       &c->vfs.dio_read_bioset);
+
+	dio = container_of(bio, struct dio_read, rbio.bio);
+	closure_init(&dio->cl, NULL);
+
+	/*
+	 * this is a _really_ horrible hack just to avoid an atomic sub at the
+	 * end:
+	 */
+	if (!sync) {
+		set_closure_fn(&dio->cl, bch2_dio_read_complete, NULL);
+		atomic_set(&dio->cl.remaining,
+			   CLOSURE_REMAINING_INITIALIZER -
+			   CLOSURE_RUNNING +
+			   CLOSURE_DESTRUCTOR);
+	} else {
+		atomic_set(&dio->cl.remaining,
+			   CLOSURE_REMAINING_INITIALIZER + 1);
+	}
+
+	dio->req	= req;
+	dio->ret	= ret;
+	dio->flags	= flags;
+	/*
+	 * This is one of the sketchier things I've encountered: we have to skip
+	 * the dirtying of requests that are internal from the kernel (i.e. from
+	 * loopback), because we'll deadlock on page_lock.
+	 */
+	dio->should_dirty = user_backed_iter(iter);
+
+	goto start;
+	while (iter->count) {
+		split = true;
+
+		bio = bio_alloc_bioset(NULL,
+				       bio_iov_vecs_to_alloc(iter, BIO_MAX_VECS),
+				       REQ_OP_READ,
+				       GFP_KERNEL,
+				       &c->bio_read);
+start:
+		struct bch_read_bio *rbio =
+			rbio_init(bio,
+				  c,
+				  opts,
+				  split
+				  ? bch2_direct_IO_read_split_endio
+				  : bch2_direct_IO_read_endio);
+
+		BUG_ON(rbio->_state);
+		rbio->err_report		= err_report;
+		rbio->subvol			= inode_inum(inode).subvol;
+		rbio->bio.bi_opf		= REQ_OP_READ|REQ_SYNC;
+		rbio->bio.bi_iter.bi_sector	= offset >> 9;
+		rbio->bio.bi_private		= dio;
+
+		ret = bch2_bio_iov_iter_get_pages(&rbio->bio, iter, 0);
+		if (ret < 0) {
+			/* XXX: fault inject this path */
+			rbio->ret = ret;
+			bio_endio(&rbio->bio);
+			break;
+		}
+
+		offset += rbio->bio.bi_iter.bi_size;
+
+		if (dio->should_dirty)
+			bch2_bio_set_pages_dirty(&rbio->bio);
+
+		if (iter->count)
+			closure_get(&dio->cl);
+
+		CLASS(btree_trans, trans)(c);
+		bch2_read(trans, rbio, rbio->bio.bi_iter, inode_inum(inode),
+			  NULL, NULL,
+			  BCH_READ_retry_if_stale|
+			  BCH_READ_may_promote|
+			  BCH_READ_user_mapped|
+			  flags);
+	}
+
+	iter->count += shorten;
+
+	if (sync) {
+		closure_sync(&dio->cl);
+		closure_debug_destroy(&dio->cl);
+		ret = dio->ret;
+		bio_check_or_release(&dio->rbio.bio, dio->should_dirty);
+		return ret;
+	} else {
+		return -EIOCBQUEUED;
+	}
+}
+
+int bch2_direct_IO_read(struct kiocb *req, struct iov_iter *iter,
+			enum bch_read_flags flags,
+			struct bch_read_err_report *err_report)
+{
+	struct file *file = req->ki_filp;
+	struct address_space *mapping = file->f_mapping;
+
+	if (unlikely(mapping->nrpages)) {
+		ssize_t ret = filemap_write_and_wait_range(mapping,
+					req->ki_pos,
+					req->ki_pos + iov_iter_count(iter) - 1);
+		if (ret < 0)
+			return ret;
+	}
+
+	file_accessed(file);
+
+	struct blk_plug plug;
+	blk_start_plug(&plug);
+	ssize_t ret = __bch2_direct_IO_read(req, iter, flags, err_report);
+	blk_finish_plug(&plug);
+
+	if (ret >= 0)
+		req->ki_pos += ret;
+	return ret;
+}
+
+ssize_t bch2_read_iter(struct kiocb *iocb, struct iov_iter *iter)
+{
+	struct file *file = iocb->ki_filp;
+	ssize_t ret = 0;
+
+	if (!iov_iter_count(iter))
+		return 0; /* skip atime */
+
+	if (iocb->ki_flags & IOCB_DIRECT) {
+		ret = bch2_direct_IO_read(iocb, iter, 0, NULL);
+	} else {
+		guard(bch2_pagecache_add)(file_bch_inode(file));
+		ret = filemap_read(iocb, iter, ret);
+	}
+
+	return bch2_err_class(ret);
+}
+
+/* O_DIRECT writes */
+
+static bool bch2_check_range_allocated(struct bch_fs *c, subvol_inum inum,
+				       u64 offset, u64 size,
+				       unsigned nr_replicas, bool compressed)
+{
+	CLASS(btree_trans, trans)(c);
+	struct bkey_s_c k;
+	u64 end = offset + size;
+	u32 snapshot;
+	int err;
+retry:
+	bch2_trans_begin(trans);
+
+	err = bch2_subvolume_get_snapshot(trans, inum.subvol, &snapshot);
+	if (err)
+		goto err;
+
+	for_each_btree_key_max_norestart(trans, iter, BTREE_ID_extents,
+			   SPOS(inum.inum, offset, snapshot), POS(inum.inum, end),
+			   BTREE_ITER_slots|BTREE_ITER_trim, k, err) {
+		offset = iter.pos.offset;
+
+		if (k.k->p.snapshot != snapshot ||
+		    nr_replicas > bch2_bkey_durability_safe(c, k).total ||
+		    (!compressed && bch2_bkey_durability_safe(c, k).sectors_compressed))
+			return false;
+	}
+err:
+	if (bch2_err_matches(err, BCH_ERR_transaction_restart))
+		goto retry;
+
+	return !err;
+}
+
+static noinline bool bch2_dio_write_check_allocated(struct dio_write *dio)
+{
+	struct bch_fs *c = dio->op.c;
+	struct bch_inode_info *inode = dio->inode;
+	struct bio *bio = &dio->op.wbio.bio;
+
+	return bch2_check_range_allocated(c, inode_inum(inode),
+				dio->op.pos.offset, bio_sectors(bio),
+				dio->op.opts.data_replicas,
+				dio->op.opts.compression != 0);
+}
+
+static void bch2_dio_write_loop_async(struct bch_write_op *);
+static __always_inline long bch2_dio_write_done(struct dio_write *dio);
+
+/*
+ * We're going to return -EIOCBQUEUED, but we haven't finished consuming the
+ * iov_iter yet, so we need to stash a copy of the iovec: it might be on the
+ * caller's stack, we're not guaranteed that it will live for the duration of
+ * the IO:
+ */
+static noinline int bch2_dio_write_copy_iov(struct dio_write *dio)
+{
+	struct iovec *iov = dio->inline_vecs;
+
+	/*
+	 * iov_iter has a single embedded iovec - nothing to do:
+	 */
+	if (iter_is_ubuf(&dio->iter))
+		return 0;
+
+	/*
+	 * We don't currently handle non-iovec iov_iters here - return an error,
+	 * and we'll fall back to doing the IO synchronously:
+	 */
+	if (!iter_is_iovec(&dio->iter))
+		return -1;
+
+	if (dio->iter.nr_segs > ARRAY_SIZE(dio->inline_vecs)) {
+		dio->iov = iov = kmalloc_array(dio->iter.nr_segs, sizeof(*iov),
+				    GFP_KERNEL);
+		if (unlikely(!iov))
+			return -ENOMEM;
+	}
+
+	memcpy(iov, dio->iter.__iov, dio->iter.nr_segs * sizeof(*iov));
+	dio->iter.__iov = iov;
+	return 0;
+}
+
+static __always_inline long bch2_dio_write_done(struct dio_write *dio)
+{
+	struct bch_fs *c = dio->op.c;
+	struct kiocb *req = dio->req;
+	struct bch_inode_info *inode = dio->inode;
+	bool sync = dio->sync;
+
+	bch2_pagecache_block_put(inode);
+
+	kfree(dio->iov);
+
+	long ret = dio->op.error ?: ((long) dio->written << 9);
+	bio_put(&dio->op.wbio.bio);
+
+	enumerated_ref_put(&c->writes, BCH_WRITE_REF_dio_write);
+
+	/* inode->i_dio_count is our ref on inode and thus bch_fs */
+	inode_dio_end(&inode->v);
+
+	if (ret < 0)
+		ret = bch2_err_class(ret);
+
+	if (!sync) {
+		req->ki_complete(req, ret);
+		ret = -EIOCBQUEUED;
+	}
+	return ret;
+}
+
+static __always_inline void bch2_dio_write_end(struct dio_write *dio)
+{
+	struct bch_fs *c = dio->op.c;
+	struct kiocb *req = dio->req;
+	struct bch_inode_info *inode = dio->inode;
+	struct bio *bio = &dio->op.wbio.bio;
+
+	req->ki_pos	+= (u64) dio->op.written << 9;
+	dio->written	+= dio->op.written;
+
+	if (dio->extending) {
+		guard(spinlock)(&inode->v.i_lock);
+		if (req->ki_pos > inode->v.i_size)
+			i_size_write(&inode->v, req->ki_pos);
+	}
+
+	if (dio->op.i_sectors_delta || dio->quota_res.sectors) {
+		guard(mutex)(&inode->ei_quota_lock);
+		__bch2_i_sectors_acct(c, inode, &dio->quota_res, dio->op.i_sectors_delta);
+		__bch2_quota_reservation_put(c, inode, &dio->quota_res);
+	}
+
+	bio_release_pages(bio, false);
+
+	if (unlikely(dio->op.error))
+		set_bit(EI_INODE_ERROR, &inode->ei_flags);
+}
+
+static void bch2_dio_write_sync_done(struct bch_write_op *op)
+{
+	struct dio_write *dio = container_of(op, struct dio_write, op);
+
+	dio->sync_done = true;
+}
+
+static __always_inline long bch2_dio_write_loop(struct dio_write *dio)
+{
+	struct bch_fs *c = dio->op.c;
+	struct kiocb *req = dio->req;
+	struct address_space *mapping = dio->mapping;
+	struct bch_inode_info *inode = dio->inode;
+	struct bch_inode_opts opts;
+	struct bio *bio = &dio->op.wbio.bio;
+	unsigned unaligned, iter_count;
+	bool sync = dio->sync, dropped_locks;
+	long ret;
+
+	bch2_inode_opts_get_inode(c, &inode->ei_inode, &opts);
+
+	while (1) {
+		iter_count = dio->iter.count;
+
+		EBUG_ON(faults_disabled_mapping(c));
+		fdm_set(&c->fdm_table, mapping);
+
+		ret = bch2_bio_iov_iter_get_pages(bio, &dio->iter, 0);
+
+		dropped_locks = bch2_fdm_dropped_locks(c);
+
+		fdm_clear(&c->fdm_table);
+
+		/*
+		 * If the fault handler returned an error but also signalled
+		 * that it dropped & retook ei_pagecache_lock, we just need to
+		 * re-shoot down the page cache and retry:
+		 */
+		if (dropped_locks && ret)
+			ret = 0;
+
+		if (unlikely(ret < 0))
+			goto err;
+
+		if (unlikely(dropped_locks)) {
+			ret = bch2_write_invalidate_inode_pages_range(mapping,
+					req->ki_pos,
+					req->ki_pos + iter_count - 1);
+			if (unlikely(ret))
+				goto err;
+
+			if (!bio->bi_iter.bi_size)
+				continue;
+		}
+
+		unaligned = bio->bi_iter.bi_size & (block_bytes(c) - 1);
+		bio->bi_iter.bi_size -= unaligned;
+		iov_iter_revert(&dio->iter, unaligned);
+
+		if (!bio->bi_iter.bi_size) {
+			/*
+			 * bio_iov_iter_get_pages was only able to get <
+			 * blocksize worth of pages:
+			 */
+			ret = -EFAULT;
+			goto err;
+		}
+
+		bch2_write_op_init(&dio->op, c, opts);
+		dio->op.end_io		= sync
+			? bch2_dio_write_sync_done
+			: bch2_dio_write_loop_async;
+		dio->op.target		= dio->op.opts.foreground_target;
+		dio->op.write_point	= writepoint_hashed((unsigned long) current);
+		dio->op.nr_replicas	= dio->op.opts.data_replicas;
+		dio->op.subvol		= inode_inum(inode).subvol;
+		dio->op.pos		= POS(inode_inum(inode).inum, (u64) req->ki_pos >> 9);
+		dio->op.devs_need_flush	= &inode->ei_devs_need_flush;
+
+		if (sync)
+			dio->op.flags |= BCH_WRITE_sync;
+		if (dio->flush)
+			dio->op.flags |= BCH_WRITE_flush;
+		dio->op.flags |= BCH_WRITE_check_enospc;
+
+		ret = bch2_quota_reservation_add(c, inode, &dio->quota_res,
+						 bio_sectors(bio), true);
+		if (unlikely(ret))
+			goto err;
+
+		ret = bch2_disk_reservation_add(c, &dio->op.res, bio_sectors(bio),
+						dio->op.opts.data_replicas, 0);
+		if (likely(!ret))
+			dio->op.nr_replicas = dio->op.res.nr_replicas;
+		else if (!bch2_dio_write_check_allocated(dio))
+			goto err;
+
+		task_io_account_write(bio->bi_iter.bi_size);
+
+		if (unlikely(dio->iter.count) &&
+		    !dio->sync &&
+		    !dio->loop &&
+		    bch2_dio_write_copy_iov(dio))
+			dio->sync = sync = true;
+
+		dio->loop = true;
+		closure_call(&dio->op.cl, bch2_write, NULL, NULL);
+
+		if (!sync)
+			return -EIOCBQUEUED;
+
+		BUG_ON(!dio->sync_done);
+		dio->sync_done = false;
+
+		bch2_dio_write_end(dio);
+
+		if (likely(!dio->iter.count) || dio->op.error)
+			break;
+
+		bio_reset(bio, NULL, REQ_OP_WRITE | REQ_SYNC | REQ_IDLE);
+	}
+out:
+	return bch2_dio_write_done(dio);
+err:
+	dio->op.error = ret;
+
+	bio_release_pages(bio, false);
+
+	bch2_quota_reservation_put(c, inode, &dio->quota_res);
+	goto out;
+}
+
+static noinline __cold void bch2_dio_write_continue(struct dio_write *dio)
+{
+	struct mm_struct *mm = dio->mm;
+
+	bio_reset(&dio->op.wbio.bio, NULL, REQ_OP_WRITE);
+
+	if (mm)
+		kthread_use_mm(mm);
+	bch2_dio_write_loop(dio);
+	if (mm)
+		kthread_unuse_mm(mm);
+}
+
+static void bch2_dio_write_loop_async(struct bch_write_op *op)
+{
+	struct dio_write *dio = container_of(op, struct dio_write, op);
+
+	bch2_dio_write_end(dio);
+
+	if (likely(!dio->iter.count) || dio->op.error)
+		bch2_dio_write_done(dio);
+	else
+		bch2_dio_write_continue(dio);
+}
+
+ssize_t bch2_direct_write(struct kiocb *req, struct iov_iter *iter)
+{
+	struct file *file = req->ki_filp;
+	struct address_space *mapping = file->f_mapping;
+	struct bch_inode_info *inode = file_bch_inode(file);
+	struct bch_fs *c = inode->v.i_sb->s_fs_info;
+	struct dio_write *dio;
+	struct bio *bio;
+	bool locked = true, extending;
+	ssize_t ret;
+
+	prefetch(&c->opts);
+	prefetch((void *) &c->opts + 64);
+	prefetch(&inode->ei_inode);
+	prefetch((void *) &inode->ei_inode + 64);
+
+	if (!enumerated_ref_tryget(&c->writes, BCH_WRITE_REF_dio_write))
+		return -EROFS;
+
+	inode_lock(&inode->v);
+
+	ret = generic_write_checks(req, iter);
+	if (unlikely(ret <= 0))
+		goto err_put_write_ref;
+
+	ret = file_remove_privs(file);
+	if (unlikely(ret))
+		goto err_put_write_ref;
+
+	ret = file_update_time(file);
+	if (unlikely(ret))
+		goto err_put_write_ref;
+
+	if (unlikely((req->ki_pos|iter->count) & (block_bytes(c) - 1))) {
+		ret = bch_err_throw(c, EINVAL_unaligned_io);
+		goto err_put_write_ref;
+	}
+
+	inode_dio_begin(&inode->v);
+	bch2_pagecache_block_get(inode);
+
+	extending = req->ki_pos + iter->count > inode->v.i_size;
+	if (!extending) {
+		inode_unlock(&inode->v);
+		locked = false;
+	}
+
+	bio = bio_alloc_bioset(NULL,
+			       bio_iov_vecs_to_alloc(iter, BIO_MAX_VECS),
+			       REQ_OP_WRITE | REQ_SYNC | REQ_IDLE,
+			       GFP_KERNEL,
+			       &c->vfs.dio_write_bioset);
+	dio = container_of(bio, struct dio_write, op.wbio.bio);
+	dio->req		= req;
+	dio->mapping		= mapping;
+	dio->inode		= inode;
+	dio->mm			= current->mm;
+	dio->iov		= NULL;
+	dio->loop		= false;
+	dio->extending		= extending;
+	dio->sync		= is_sync_kiocb(req) || extending;
+	dio->flush		= iocb_is_dsync(req) && !c->opts.journal_flush_disabled;
+	dio->quota_res.sectors	= 0;
+	dio->written		= 0;
+	dio->iter		= *iter;
+	dio->op.c		= c;
+
+	if (unlikely(mapping->nrpages)) {
+		ret = bch2_write_invalidate_inode_pages_range(mapping,
+						req->ki_pos,
+						req->ki_pos + iter->count - 1);
+		if (unlikely(ret))
+			goto err_put_bio;
+	}
+
+	ret = bch2_dio_write_loop(dio);
+out:
+	if (locked)
+		inode_unlock(&inode->v);
+	return ret;
+err_put_bio:
+	bch2_pagecache_block_put(inode);
+	bio_put(bio);
+	inode_dio_end(&inode->v);
+err_put_write_ref:
+	enumerated_ref_put(&c->writes, BCH_WRITE_REF_dio_write);
+	goto out;
+}
+
+#endif /* NO_BCACHEFS_FS */
