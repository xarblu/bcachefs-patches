+    fn label(s: &str) -> [u8; c::BCH_SB_LABEL_SIZE as usize] {
+        let mut l = [0; c::BCH_SB_LABEL_SIZE as usize];
+        l[..s.len()].copy_from_slice(s.as_bytes());
+        l
+    }
