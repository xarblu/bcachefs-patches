diff --git a/fs/bcachefs/Cargo.toml b/fs/bcachefs/Cargo.toml
new file mode 100644
index 0000000..70bb0a3
--- /dev/null
+++ b/fs/bcachefs/Cargo.toml
@@ -0,0 +1,48 @@
+[package]
+name = "bcachefs-kernel"
+version = "0.1.0"
+authors = [ "Kent Overstreet <kent.overstreet@linux.dev>" ]
+edition = "2021"
+rust-version = "1.85.0"
+
+[lib]
+crate-type = ["lib"]
+path = "mod.rs"
+
+[features]
+# `std` pulls in the userspace-only helpers (path/OsStr conversions). On by
+# default for the tools build; the in-kernel build uses --no-default-features
+# to get a no_std crate.
+default = ["std"]
+# `zeroize` is a userspace crate; the in-kernel build (no_std, no crates.io)
+# wipes key material with a hand-rolled volatile memset instead (see mod.rs).
+std = ["dep:zeroize"]
+
+[dependencies]
+bcachefs-shim = { path = "../bcachefs-shim" }
+# The kernel build has pin_init as a crate too - --extern pin_init, the
+# kernel's or the vendored stack's: #[pin_data] and pin_init!() expand to
+# ::pin_init paths.
+pin-init = { path = "../bcachefs-shim/pin-init" }
+bcachefs-cstruct-macros = { path = "cstruct-macros" }
+bitfield-struct = { path = "vendor/bitfield-struct" }
+nestify = { path = "vendor/nestify" }
+bitfield = { path = "vendor/bitfield" }
+bitflags = { path = "vendor/bitflags" }
+num-traits = { path = "vendor/num-traits", default-features = false }
+arrayvec = { path = "vendor/arrayvec", default-features = false }
+paste    = { path = "vendor/paste" }
+# Userspace only: std's legacy-mangled names, in backtraces. v0 names are
+# util/demangle.rs's, and in the kernel every Rust name is v0
+rustc-demangle = "0.1.27"
+uuid     = "1.2.2"
+# The target's ioctl number layout (util/ioctl.rs) and errnos (errcode.rs):
+# bindgen output of each architecture's own headers. Userspace only - the
+# kernel build has no crates.io.
+linux-raw-sys = { version = "0.12", default-features = false, features = ["errno", "general", "no_std"] }
+# Endian-typed integers for the on-disk format: byteorder::{little,big}_endian.
+zerocopy = "0.8"
+# Aligned boxes, for IO buffers: util/alloc.rs's ABox. Userspace only - the
+# kernel build has its own, the same API over kvmalloc.
+aligned-vec = "0.6"
+zeroize  = { version = "1", optional = true, features = ["std", "zeroize_derive"] }
diff --git a/fs/bcachefs/Kconfig b/fs/bcachefs/Kconfig
new file mode 100644
index 0000000..deee79f
--- /dev/null
+++ b/fs/bcachefs/Kconfig
@@ -0,0 +1,96 @@
+
+config BCACHEFS_FS
+	tristate "bcachefs filesystem support (EXPERIMENTAL)"
+	depends on BLOCK
+	select EXPORTFS
+	select CRC32
+	select CRC64
+	select FS_POSIX_ACL
+	select LZ4_COMPRESS
+	select LZ4_DECOMPRESS
+	select LZ4HC_COMPRESS
+	select ZLIB_DEFLATE
+	select ZLIB_INFLATE
+	select ZSTD_COMPRESS
+	select ZSTD_DECOMPRESS
+	select CRYPTO_LIB_SHA256
+	select CRYPTO_LIB_CHACHA
+	select CRYPTO_LIB_POLY1305
+	select KEYS
+	select RAID6_PQ
+	select XOR_BLOCKS
+	select XXHASH
+	select SYMBOLIC_ERRNAME
+	help
+	The bcachefs filesystem - a modern, copy on write filesystem, with
+	support for multiple devices, compression, checksumming, etc.
+
+config BCACHEFS_QUOTA
+	bool "bcachefs quota support"
+	depends on BCACHEFS_FS
+	default y if QUOTA
+	select QUOTACTL
+
+config BCACHEFS_DEBUG
+	bool "bcachefs debugging"
+	depends on BCACHEFS_FS
+	help
+	Enables many extra debugging checks and assertions.
+
+	The resulting code will be significantly slower than normal; you
+	probably shouldn't select this option unless you're a developer.
+
+config BCACHEFS_INJECT_TRANSACTION_RESTARTS
+	bool "Randomly inject transaction restarts"
+	depends on BCACHEFS_DEBUG
+	help
+	Randomly inject transaction restarts in a few core paths - may have a
+	significant performance penalty
+
+config BCACHEFS_TESTS
+	bool "bcachefs unit and performance tests"
+	depends on BCACHEFS_FS
+	help
+	Include some unit and performance tests for the core btree code
+
+config BCACHEFS_LOCK_TIME_STATS
+       bool "bcachefs lock time statistics"
+       depends on BCACHEFS_FS
+       help
+       Expose statistics for how long we held a lock in debugfs
+
+config BCACHEFS_NO_LATENCY_ACCT
+	bool "disable latency accounting and time stats"
+	depends on BCACHEFS_FS
+	help
+	This disables device latency tracking and time stats, only for performance testing
+
+config BCACHEFS_SIX_OPTIMISTIC_SPIN
+	bool "Optimistic spinning for six locks"
+	depends on BCACHEFS_FS
+	depends on SMP
+	default y
+	help
+	Instead of immediately sleeping when attempting to take a six lock that
+	is held by another thread, spin for a short while, as long as the
+	thread owning the lock is running.
+
+config BCACHEFS_PATH_TRACEPOINTS
+	bool "Extra btree_path tracepoints"
+	depends on BCACHEFS_FS && TRACING
+	help
+	Enable extra tracepoints for debugging btree_path operations; we don't
+	normally want these enabled because they happen at very high rates.
+
+config BCACHEFS_TRANS_KMALLOC_TRACE
+	bool "Trace bch2_trans_kmalloc() calls"
+	depends on BCACHEFS_FS
+
+config MEAN_AND_VARIANCE_UNIT_TEST
+	tristate "mean_and_variance unit tests" if !KUNIT_ALL_TESTS
+	depends on KUNIT
+	depends on BCACHEFS_FS
+	default KUNIT_ALL_TESTS
+	help
+	  This option enables the kunit tests for mean_and_variance module.
+	  If unsure, say N.
diff --git a/fs/bcachefs/Makefile b/fs/bcachefs/Makefile
new file mode 100644
index 0000000..09d745f
--- /dev/null
+++ b/fs/bcachefs/Makefile
@@ -0,0 +1,155 @@
+# bcachefs's kbuild Makefile. Built in-tree (scripts/install-to-kernel.sh),
+# configured by the kernel's .config like any filesystem; or as an external
+# module by DKMS (dkms/Makefile sets BCACHEFS_DKMS), where no .config has our
+# options and we set them here.
+
+ifdef BCACHEFS_DKMS
+CONFIG_BCACHEFS_FS := m
+
+# If the build farm has a signed bcachefs.ko for this kernel and version,
+# fetch-module.sh puts it where kbuild would put ours, and we build nothing.
+# (It logs to stderr: stdout is our "hit" or nothing.) Not on clean, which
+# reads this file too.
+ifneq ($(.DEFAULT_GOAL),__clean)
+bcachefs-version := $(shell sed -n 's/.*bcachefs_version "\(.*\)".*/\1/p' $(src)/version.h 2>/dev/null)
+ifneq ($(bcachefs-version),)
+ifeq ($(shell $(CONFIG_SHELL) $(src)/scripts/fetch-module.sh '$(KERNELRELEASE)' '$(bcachefs-version)' '$(obj)/bcachefs.ko' && echo hit),hit)
+CONFIG_BCACHEFS_FS :=
+bcachefs-prebuilt := y
+endif
+else
+$(warning bcachefs: no version in $(src)/version.h - not looking for a prebuilt module (version.h is staged by bcachefs-tools 'make install_dkms'; a hand-copied kernel fs/bcachefs/ tree lacks it))
+endif
+endif
+
+# Our options: from the environment (ktest, build.vars), and quota as Kconfig
+# defaults it, with CONFIG_QUOTA.
+bcachefs-config-cppflags := \
+	$(foreach o,DEBUG INJECT_TRANSACTION_RESTARTS TESTS,$(if $(BCACHEFS_$(o)),-DCONFIG_BCACHEFS_$(o)=1)) \
+	$(if $(CONFIG_QUOTA),-DCONFIG_BCACHEFS_QUOTA=1) \
+	$(if $(CONFIG_DEBUG_FS),-DCONFIG_BCACHEFS_ASYNC_OBJECT_LISTS=1)
+endif
+
+# bindgen and rustc get these too (Makefile.rust): some change struct layouts
+# (CONFIG_BCACHEFS_DEBUG adds btree_iter.ip_allocated), and C and Rust
+# disagreeing on one is silent memory corruption.
+subdir-ccflags-y += $(bcachefs-config-cppflags)
+
+# Our includes are relative to fs/ ("alloc/background.h"), and the
+# generated header below is in $(obj); kbuild only adds these itself when
+# building out of the source tree.
+subdir-ccflags-y += -I$(src) -I$(obj)
+
+# BCACHEFS_WERROR=1: our warnings fatal, without CONFIG_WERROR for the whole
+# kernel. Per-file -Wno-* waivers still apply.
+ifeq ($(BCACHEFS_WERROR),1)
+subdir-ccflags-y += -Werror
+endif
+
+# Not fatal even with CONFIG_WERROR (Proxmox: CONFIG_FRAME_WARN=1024): the
+# functions that trip it run in kthreads and workqueues, on a full stack. The
+# trailing '=' is required: GCC 15 rejects -Wno-error=frame-larger-than.
+subdir-ccflags-y += -Wno-error=frame-larger-than=
+# "note: xyz changed in GCC X.X"
+subdir-ccflags-y += $(call cc-disable-warning, psabi)
+
+# fs/dirent.c's copy of struct getdents_callback64, checked against the
+# kernel's (pahole on vmlinux) in external builds; without the check, the
+# filldir fastpath is compiled out. In-tree, fs/readdir.c is the same tree.
+$(obj)/fs/dirent.o: $(obj)/bch2_getdents_layout.h
+$(obj)/bch2_getdents_layout.h: FORCE
+	$(Q)$(CONFIG_SHELL) $(src)/scripts/getdents-layout.sh \
+		"$(if $(KBUILD_EXTMOD),$(objtree)/vmlinux,)" $@
+clean-files += bch2_getdents_layout.h
+
+obj-$(CONFIG_BCACHEFS_FS)	+= bcachefs.o
+
+bcachefs-y		:=			\
+	alloc/accounting.o			\
+	alloc/foreground.o			\
+	btree/bkey.o				\
+	btree/bkey_methods.o			\
+	btree/bset.o				\
+	btree/cache.o				\
+	btree/check.o				\
+	btree/commit.o				\
+	btree/init.o				\
+	btree/interior.o			\
+	btree/iter.o				\
+	btree/journal_overlay.o			\
+	btree/key_cache.o			\
+	btree/locking.o				\
+	btree/node_scan.o			\
+	btree/read.o				\
+	btree/sort.o				\
+	btree/update.o				\
+	btree/write.o				\
+	btree/write_buffer.o			\
+	data/ec/trigger.o			\
+	data/extents.o				\
+	data/extent_update.o			\
+	data/io_misc.o				\
+	data/move.o				\
+	data/read.o				\
+	data/reconcile/trigger.o		\
+	data/write.o				\
+	debug/debug.o				\
+	debug/trace.o				\
+	errcode.o				\
+	fs/dirent.o				\
+	init/dev.o				\
+	init/error.o				\
+	init/fs.o				\
+	init/recovery.o				\
+	journal/init.o				\
+	journal/journal.o			\
+	journal/read.o				\
+	journal/reclaim.o			\
+	journal/validate.o			\
+	journal/write.o				\
+	locking/locking.o			\
+	sb/members.o				\
+	util/clock.o				\
+	util/darray.o				\
+	util/enumerated_ref.o			\
+	util/eytzinger.o			\
+	util/fast_list.o			\
+	util/mean_and_variance.o		\
+	util/printbuf.o				\
+	util/rcu.o				\
+	util/rcu_pending.o			\
+	util/six.o				\
+	util/time_stats.o			\
+	util/two_state_shared_lock.o		\
+	util/util.o				\
+	util/varint.o				\
+	vendor/bio_iov_iter.o			\
+	vendor/closure.o			\
+	vendor/min_heap.o			\
+	vfs/fs.o				\
+	vfs/io.o				\
+	vfs/buffered.o				\
+	vfs/direct.o				\
+	vfs/pagecache.o
+
+ifdef CONFIG_DEBUG_FS
+	bcachefs-y += debug/async_objs.o
+endif
+
+ifdef BCACHEFS_DKMS
+ifneq ($(wildcard $(src)/module-version.c),)
+	bcachefs-y += module-version.o
+else
+# A hand-copied tree (field report, 2026-07-23): say so, rather than fail
+# with "no rule to make target".
+$(warning bcachefs: $(src)/module-version.c missing - module will carry no MODULE_VERSION)
+endif
+else
+	obj-$(CONFIG_MEAN_AND_VARIANCE_UNIT_TEST)   += util/mean_and_variance_test.o
+endif
+
+# A prebuilt module builds nothing, so none of Rust's requirements apply - its
+# checks fail the build on a kernel that can't build our Rust (#1133).
+ifndef bcachefs-prebuilt
+include $(src)/Makefile.rust
+endif
diff --git a/fs/bcachefs/Makefile.rust b/fs/bcachefs/Makefile.rust
new file mode 100644
index 0000000..7d1984b
--- /dev/null
+++ b/fs/bcachefs/Makefile.rust
@@ -0,0 +1,454 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# bcachefs's Rust, for the kernel build; included from fs/Makefile. mod.o is
+# a member object of bcachefs.ko. It include!s the bindings to the kernel APIs
+# kernel::bindings doesn't cover (rust/bindings.rs), with C wrappers for those
+# that are static inlines (rust/extern.c): codegen.rs, the kernel's counterpart
+# of bcachefs-shim, built and run as a host tool.
+#
+# It builds against the kernel's own Rust, or failing that our vendored copy
+# (Makefile.rust.vendor); failing both, say why. BCACHEFS_RUST_VENDOR=1 forces
+# the vendored one, for testing.
+
+# Can we build against the kernel's Rust, or our own? "y", or why not.
+bch-rust-available = $(shell RUSTC='$(RUSTC)' HOSTRUSTC='$(HOSTRUSTC)'	\
+	BINDGEN='$(BINDGEN)' CC='$(CC)' KERNEL_SRC='$(srctree)'		\
+	KERNEL_OBJ='$(objtree)' CONFIG_RUSTC_VERSION='$(CONFIG_RUSTC_VERSION)' \
+	RUST_LIB_SRC='$(RUST_LIB_SRC)'						\
+	RUSTC_MIN=1.85.0 $(CONFIG_SHELL) $(src)/scripts/rust-available.sh $(1))
+
+# Why the kernel's Rust can't be used, or empty.
+ifndef CONFIG_RUST
+bcachefs-kernel-rust-why := kernel $(KERNELVERSION) was built without CONFIG_RUST
+else ifeq ($(BCACHEFS_RUST_VENDOR),1)
+bcachefs-kernel-rust-why := vendored Rust forced with BCACHEFS_RUST_VENDOR=1
+else ifdef BCACHEFS_DKMS
+bcachefs-kernel-rust-why := $(filter-out y,$(call bch-rust-available,kernel))
+# --target: on x86 a generated scripts/target.json, which headers may lack.
+bcachefs-kernel-rust-target := $(patsubst --target=%,%,$(filter --target=%.json,$(KBUILD_RUSTFLAGS)))
+ifeq ($(bcachefs-kernel-rust-why),)
+bcachefs-kernel-rust-why := $(if $(filter-out $(wildcard $(bcachefs-kernel-rust-target)),$(bcachefs-kernel-rust-target)),missing $(bcachefs-kernel-rust-target))
+endif
+else
+# In-tree, the kernel's Rust matches by construction; we still need bindgen.
+bcachefs-kernel-rust-why := $(if $(shell command -v $(BINDGEN) 2>/dev/null),,bindgen ($(BINDGEN)) not found)
+endif
+
+# The on-disk format's endian integers are zerocopy's, which the kernel's Rust
+# has only had since 7.2:
+ifeq ($(bcachefs-kernel-rust-why),)
+bcachefs-kernel-rust-why := $(if $(wildcard $(objtree)/rust/libzerocopy.rmeta),,kernel $(KERNELVERSION)'s Rust has no zerocopy)
+endif
+
+# Paranoid FineIBT (x86; cfi=auto on IBT hardware without FRED) rewrites each
+# kCFI indirect call site as 20 bytes, taking the thunk call to be 6, as
+# -mindirect-branch-cs-prefix makes C's. The kernel passes rustc no equivalent
+# (as of 7.3), so Rust's are 5 and the byte after each is clobbered at boot,
+# vmlinux's own core::fmt included. The vendored stack is built with
+# -Zindirect-branch-cs-prefix, and doesn't call into the kernel's Rust.
+ifeq ($(bcachefs-kernel-rust-why),)
+ifdef CONFIG_FINEIBT
+bcachefs-kernel-rust-why := $(if $(filter -Zindirect-branch-cs-prefix,$(KBUILD_RUSTFLAGS)),,kernel $(KERNELVERSION)'s Rust is built without -Zindirect-branch-cs-prefix and breaks under paranoid FineIBT)
+endif
+endif
+
+ifneq ($(bcachefs-kernel-rust-why),)
+bcachefs-vendor-rust-probe := $(call bch-rust-available,vendored)
+ifeq ($(bcachefs-vendor-rust-probe),y)
+bcachefs-vendor-rust := y
+else ifneq ($(.DEFAULT_GOAL),__clean)
+# (Not on clean: kbuild reads this then without the kernel config.) Both
+# reasons: "no CONFIG_RUST" alone sends people asking their distro for it,
+# when installing rust-src may be all that's needed.
+$(error bcachefs requires Rust. Can't use the kernel's Rust: $(bcachefs-kernel-rust-why). Can't build bcachefs' own copy either: $(bcachefs-vendor-rust-probe))
+endif
+endif
+
+# Where the leaf crates find core: the kernel's, or the vendored stack's - never
+# both, or rustc may pick a stale one (E0464).
+bch-rust-L := -L$(objtree)/rust
+
+# bindgen has to see the headers as the C build does, or struct layouts diverge
+# silently (NO_BCACHEFS_FS gates bch_fs.vfs; -fplan9-extensions changes struct
+# filename): so the kernel's full C flags, less the ones libclang can't parse.
+# That list is rust/Makefile's bindgen_skip_c_flags, which isn't reachable
+# out-of-tree - keep it in sync.
+#
+# Also dropped: $(CC_FLAGS_LTO), whose -fvisibility=hidden makes bindgen skip
+# every extern; -funsigned-char, so char binds as c_char, as in userspace. -w:
+# CONFIG_WERROR, and clang's noise on kernel headers. No NOSTDINC_FLAGS: libclang
+# brings its own freestanding headers. -D__BINDGEN__ as the kernel's bindgen
+# sets it; -DRUST_BINDGEN swaps DECLARE_FLEX_ARRAY for a layout-identical s[0].
+bcachefs-codegen-skip-cflags := \
+	-mno-fp-ret-in-387 -mpreferred-stack-boundary=% \
+	-mskip-rax-setup -mgeneral-regs-only -msign-return-address=% \
+	-mindirect-branch=thunk-extern -mindirect-branch-register \
+	-mfunction-return=thunk-extern -mrecord-mcount -mabi=lp64 \
+	-mindirect-branch-cs-prefix -mstack-protector-guard% -mtraceback=no \
+	-mno-pointers-to-nested-functions -mno-string \
+	-mno-strict-align -mstrict-align -mdirect-extern-access \
+	-mexplicit-relocs -mno-check-zero-division \
+	-fconserve-stack -falign-jumps=% -falign-loops=% \
+	-femit-struct-debug-baseonly -fno-ipa-cp-clone -fno-ipa-sra \
+	-fno-partial-inlining -fplugin-arg-arm_ssp_per_task_plugin-% \
+	-fno-reorder-blocks -fno-allow-store-data-races -fasan-shadow-offset=% \
+	-fzero-call-used-regs=% -fno-stack-clash-protection \
+	-fno-inline-functions-called-once -fsanitize=bounds-strict \
+	-fstrict-flex-arrays=% -fmin-function-alignment=% \
+	-fzero-init-padding-bits=% -mno-fdpic \
+	-fdiagnostics-show-context -fdiagnostics-show-context=% \
+	--param=% --param asan-% -fno-isolate-erroneous-paths-dereference \
+	$(CC_FLAGS_LTO)
+
+# For cross builds, compute a target to pass to bindgen. We cannot use kernel's
+# per-arch BINDGEN_TARGET table as it isn't reachable from here (or from an
+# out-of-tree build). Instead of duplicating it, under LLVM=1, --target is
+# already in $(KBUILD_CPPFLAGS) and thus there's nothing to add.
+# For GCC, query the target from the cross compiler. The GCC target triple is
+# sometimes different from LLVM, but it is good enough for bindgen/libclang
+# for all supported arches. Only when cross compiling: a native build's target
+# is the host's, which bindgen defaults to, and a distro GCC's own triple
+# (x86_64-redhat-linux, x86_64-pc-linux-gnu, ...) is one more thing that could
+# go wrong in the build every DKMS install does.
+bcachefs-codegen-target := $(if $(CONFIG_CC_IS_CLANG),,$(if $(CROSS_COMPILE),--target=$(shell $(CC) -dumpmachine)))
+
+bcachefs-codegen-cflags := \
+	$(LINUXINCLUDE) $(KBUILD_CPPFLAGS) \
+	$(filter-out -funsigned-char $(bcachefs-codegen-skip-cflags),$(KBUILD_CFLAGS)) \
+	$(bcachefs-config-cppflags) \
+	-I$(src) -I$(obj)/rust -include $(srctree)/include/linux/compiler_types.h \
+	-w -D__BINDGEN__ -DRUST_BINDGEN $(bcachefs-codegen-target)
+
+# Types from outside fs/ are blocklisted, and come from kernel::bindings (as
+# userspace gets them from bcachefs-shim).
+bcachefs-codegen-blocklist := \
+	$(srctree)/include:$(objtree)/include:$(srctree)/arch/$(SRCARCH)/include:$(objtree)/arch/$(SRCARCH)/include
+
+# The codegen tool: plain host rustc, linked with $(HOSTCC) as kbuild's host
+# Rust is. codegen_main.rs include!s codegen.rs.
+quiet_cmd_bch_codegen_host = HOSTRUSTC $@
+      cmd_bch_codegen_host = $(HOSTRUSTC) --edition 2021 -O \
+	-Clinker-flavor=gcc -Clinker=$(HOSTCC) $< -o $@
+
+$(obj)/codegen: $(src)/codegen_main.rs $(src)/codegen.rs FORCE
+	$(call if_changed,bch_codegen_host)
+
+# The clang flags go after --, as separate words, exactly as the C compile gets
+# them: quoting them as one argument breaks flags with embedded quotes (arm64's
+# -DARM64_ASM_ARCH='"armv8.5-a"').
+#
+# We do not pass codegen tool's own --target, since non-empty clang driver args
+# always override it.
+quiet_cmd_bch_codegen = CODEGEN $(obj)/rust
+      cmd_bch_codegen = $(obj)/codegen --out $(obj)/rust \
+	--blocklist '$(bcachefs-codegen-blocklist)' \
+	-- $(bcachefs-codegen-cflags)
+
+# The headers under fs/ it binds are prerequisites: if_changed ignores FORCE,
+# so an edit to one wouldn't otherwise regenerate the bindings. (Kernel-header
+# edits ride in via a cflags or tool change, or a full rebuild.)
+$(obj)/rust/bindings.rs: $(obj)/codegen $(src)/vendor/closure.h $(src)/codegen.h FORCE
+	$(call if_changed,bch_codegen)
+
+# extern.c, from the same run: bindgen's wrappers have no prototypes, and its
+# warnings shouldn't fail CONFIG_WERROR builds - it's generated code (#819).
+$(obj)/rust/extern.c: $(obj)/rust/bindings.rs ;
+CFLAGS_rust/extern.o += -Wno-missing-prototypes -Wno-missing-declarations \
+			-Wno-error
+
+# A section per function - and per datum - in every Rust object, for rust.o's
+# section GC (below): kbuild builds modules' Rust without.
+bch-rust-gc-flags := -Zfunction-sections=y
+
+# mod.rs tests cfg(kernel), to take the kernel-compat types from the kernel
+# crate (userspace has bcachefs-shim), and __KERNEL__, as C does.
+RUSTFLAGS_mod.o += --cfg kernel --cfg __KERNEL__ $(bch-rust-gc-flags)
+
+# mod.rs's cfi_encoding, which kbuild's -Zallow-features doesn't list - and
+# it's after RUSTFLAGS_mod.o, the last one being what rustc takes. So another,
+# its list and ours, after it: rust_common_cmd is expanded when mod.o's recipe
+# runs, by then with kbuild's list. (The vendored path allows any feature.)
+$(obj)/mod.o: private rust_common_cmd += -Zallow-features=$(rust_allowed_features),cfi_encoding
+
+# And our CONFIG defines, which the kernel's rustc_cfg doesn't have, not being
+# in its .config: -DCONFIG_FOO=1 is --cfg CONFIG_FOO. The Rust tests them as
+# the C does, and a define one side sees and the other doesn't is code that
+# exists on one side only.
+RUSTFLAGS_mod.o += $(foreach f,$(bcachefs-config-cppflags),--cfg $(firstword $(subst =, ,$(patsubst -D%,%,$(f)))))
+
+# The kernel version checks, cfg(linux_ge = "7.3"): see the script.
+bch-linux-version-cfgs := $(shell $(CONFIG_SHELL) $(src)/scripts/linux-version-cfgs.sh '$(KERNELVERSION)' $(src))
+ifneq ($(.SHELLSTATUS),0)
+$(error linux-version-cfgs.sh failed, for kernel $(KERNELVERSION))
+endif
+RUSTFLAGS_mod.o += $(bch-linux-version-cfgs)
+
+# In kernel 7.3+, pin-init unified PinInit to use __init instead of __pinned_init
+# in-kernel.
+ifneq ($(bcachefs-vendor-rust),y)
+bch-pin-init-v2 := $(shell [ -f $(objtree)/rust/libpin_init.rmeta ] && \
+	! grep -qa "__pinned_init" $(objtree)/rust/libpin_init.rmeta 2>/dev/null && echo y)
+ifeq ($(bch-pin-init-v2),y)
+RUSTFLAGS_mod.o += --cfg bch_pin_init_v2
+endif
+endif
+
+# ---- crates kbuild doesn't build for us -------------------------------------
+# These, and Makefile.rust.vendor's. The crate name comes from the target -
+# foo.o, libfoo.so, libfoo.rmeta; per target, rs-flags (externs, cfgs) and
+# rs-edition (default 2021).
+#
+# The cfgs describing the kernel config and its rustc; Makefile.rust.vendor
+# points this at a copy describing ours.
+bch-rustc-cfg = $(objtree)/include/generated/rustc_cfg
+bch-crate = $(patsubst lib%,%,$(basename $(notdir $@)))
+bch-edition = --edition=$(or $(rs-edition),2021)
+
+# Kernel-side rlibs, linked into bcachefs.ko, with kbuild's per-object flags
+# (KASAN, KCOV, RUSTFLAGS_foo.o) as the kernel builds its own crates.
+quiet_cmd_bch_rlib = RUSTC L  $@
+      cmd_bch_rlib = $(rs-env) $(RUSTC) $(filter-out --edition=%,$(_rust_flags)) \
+	$(bch-rust-gc-flags) @$(bch-rustc-cfg) $(bch-edition) $(rs-flags) -Zunstable-options \
+	--sysroot=/dev/null $(bch-rust-L) --crate-type rlib --crate-name $(bch-crate) \
+	--emit=dep-info=$(depfile) --emit=metadata=$(dir $@)lib$(bch-crate).rmeta \
+	--emit=obj=$@ $<$(rs-post)
+
+# Proc-macros, for the host.
+quiet_cmd_bch_procmacro = RUSTC P  $@
+      cmd_bch_procmacro = $(RUSTC) $(filter-out --edition=%,$(rust_common_flags)) \
+	@$(bch-rustc-cfg) $(bch-edition) $(rs-flags) \
+	-Clinker-flavor=gcc -Clinker=$(HOSTCC) \
+	-Clink-args='$(call escsq,$(KBUILD_PROCMACROLDFLAGS))' \
+	--extern proc_macro --crate-type proc-macro --crate-name $(bch-crate) \
+	--emit=dep-info=$(depfile) --emit=link=$@ $<
+
+# Our rustc's version, as CONFIG_RUSTC_VERSION has it: 1.85.0 is 108500.
+bch-rustc-version := $(shell $(RUSTC) --version 2>/dev/null | \
+	awk '{ split($$2, v, "."); print v[1] * 100000 + v[2] * 100 + v[3] }')
+bch-rustc-min = $(shell [ "$(bch-rustc-version)" -ge $(1) ] 2>/dev/null && echo y)
+
+# proc-macro2, quote, syn: host rlibs, for the proc-macros - bitfield-struct's
+# here, the vendored stack's in Makefile.rust.vendor - with either Rust: the
+# kernel doesn't ship its own built for the host. From the vendored stack's
+# sources.
+bch-host := $(obj)/rust-host
+bch-host-src := $(src)/vendor/kernel-rust
+
+quiet_cmd_bch_host = RUSTC H  $@
+      cmd_bch_host = $(RUSTC) $(filter-out --edition=%,$(rust_common_flags)) \
+	$(bch-edition) $(rs-flags) --cap-lints=allow -L$(bch-host) \
+	--crate-type rlib --crate-name $(bch-crate) --emit=dep-info=$(depfile) \
+	--emit=metadata=$@ --emit=link=$(bch-host)/lib$(bch-crate).rlib $<
+
+$(bch-host)/libproc_macro2.rmeta: private rs-flags := --cfg 'feature="proc-macro"' \
+	--cfg wrap_proc_macro \
+	$(if $(call bch-rustc-min,108800),--cfg proc_macro_span_file --cfg proc_macro_span_location)
+$(bch-host)/libproc_macro2.rmeta: $(bch-host-src)/proc-macro2/lib.rs FORCE
+	$(call if_changed_dep,bch_host)
+
+$(bch-host)/libquote.rmeta: private rs-edition := 2018
+$(bch-host)/libquote.rmeta: private rs-flags := --cfg 'feature="proc-macro"' \
+	--extern proc_macro2=$(bch-host)/libproc_macro2.rlib
+$(bch-host)/libquote.rmeta: $(bch-host-src)/quote/lib.rs $(bch-host)/libproc_macro2.rmeta FORCE
+	$(call if_changed_dep,bch_host)
+
+$(bch-host)/libsyn.rmeta: private rs-flags := $(foreach f,clone-impls derive extra-traits \
+	full parsing printing proc-macro visit visit-mut,--cfg 'feature="$(f)"') \
+	--extern proc_macro2=$(bch-host)/libproc_macro2.rlib --extern quote=$(bch-host)/libquote.rlib
+$(bch-host)/libsyn.rmeta: $(bch-host-src)/syn/lib.rs $(bch-host)/libquote.rmeta FORCE
+	$(call if_changed_dep,bch_host)
+
+# The proc-macros on them:
+bch-pmac := --cap-lints=allow -L$(bch-host) --extern proc_macro2=$(bch-host)/libproc_macro2.rlib \
+	--extern quote=$(bch-host)/libquote.rlib --extern syn=$(bch-host)/libsyn.rlib
+bch-pmac-deps := $(bch-host)/libsyn.rmeta FORCE
+
+# Vendored crates get --cap-lints=allow: the kernel's lints are about how our
+# own code is written, not whether someone else's is correct (as cargo does for
+# dependencies) - and a rustc bump would otherwise break the build (#830).
+# cstruct-macros is ours, and gets the lints.
+$(obj)/libpaste.so $(obj)/arrayvec.o $(obj)/bitfield.o $(obj)/bitflags.o $(obj)/num_traits.o \
+	$(obj)/uuid.o: private rs-flags := --cap-lints=allow
+$(obj)/libbitfield_struct.so $(obj)/libnestify.so: private rs-flags := $(bch-pmac)
+
+$(obj)/libpaste.so: $(src)/vendor/paste/src/lib.rs FORCE
+	$(call if_changed_dep,bch_procmacro)
+# cstruct-macros include!s its parser from types/cstruct.rs: the dep-info
+# tracks it.
+$(obj)/libcstruct_macros.so: $(src)/cstruct-macros/src/lib.rs FORCE
+	$(call if_changed_dep,bch_procmacro)
+$(obj)/libbitfield_struct.so: $(src)/vendor/bitfield-struct/src/lib.rs $(bch-pmac-deps)
+	$(call if_changed_dep,bch_procmacro)
+# nestify: tagged_union! hands it the arm types defined in its block.
+# fs/vendor/nestify is a commit of our fork, exactly: scripts/vendor.sh.
+$(obj)/libnestify.so: $(src)/vendor/nestify/src/lib.rs $(bch-pmac-deps)
+	$(call if_changed_dep,bch_procmacro)
+
+$(obj)/arrayvec.o: private rs-edition := 2018
+$(obj)/arrayvec.o: $(src)/vendor/arrayvec/src/lib.rs FORCE
+	$(call if_changed_dep,bch_rlib)
+$(obj)/bitfield.o: $(src)/vendor/bitfield/src/lib.rs FORCE
+	$(call if_changed_dep,bch_rlib)
+$(obj)/bitflags.o: $(src)/vendor/bitflags/src/lib.rs FORCE
+	$(call if_changed_dep,bch_rlib)
+# num-traits' build.rs only probes for f64::total_cmp() (rustc 1.62): ours
+# has it. no_fp_fmt_parse is the kernel's core's: no float parsing.
+$(obj)/num_traits.o: private rs-flags += --cfg has_total_cmp --cfg no_fp_fmt_parse
+$(obj)/num_traits.o: $(src)/vendor/num-traits/src/lib.rs FORCE
+	$(call if_changed_dep,bch_rlib)
+$(obj)/uuid.o: $(src)/vendor/uuid/src/lib.rs FORCE
+	$(call if_changed_dep,bch_rlib)
+
+# Rust's library source - rust-src, which either path needs: RUST_LIB_SRC if
+# given, else rustc's - as the kernel's rust/Makefile, since some packagings
+# (nixpkgs) keep it outside the sysroot and pass it this way.
+RUST_LIB_SRC ?= $(shell $(RUSTC) --print sysroot)/lib/rustlib/src/rust/library
+
+# The integer intrinsics rustc calls that the kernel has none of: u128
+# division, __udivti3 and the rest - see vendor/bch_builtins. An ordinary
+# crate, not the #![compiler_builtins] one core binds to - the kernel's, or the
+# vendored copy, whose stubs panic - with only those global.
+$(obj)/bch_builtins.o: private rs-flags := --cap-lints=allow -Zallow-features=core_intrinsics
+$(obj)/bch_builtins.o: private rs-post = ; $(OBJCOPY) -w --keep-global-symbol='__*[sdt]i[234]' $@
+$(obj)/bch_builtins.o: $(src)/vendor/bch_builtins/lib.rs FORCE
+	$(call if_changed_dep,bch_rlib)
+
+# Asm from the kernel's own headers, as kbuild makes the kernel crate's
+# (generated_arch_*_asm.rs): the C preprocessor over a .rs.S with the C
+# build's flags, what precedes "// Cut here." the C and the rest Rust. Ours are
+# util/'s *_asm.rs.S; Makefile.rust.vendor's, the vendored kernel crate's.
+quiet_cmd_bch_rscpp = RSCPP   $@
+      cmd_bch_rscpp = $(CPP) $(c_flags) -xc -C -P $< | sed '1,/^\/\/ Cut here.$$/d' >$@
+
+bch-arch-asm-rs := $(addprefix rust/,percpu_asm.rs jump_label_asm.rs)
+
+$(addprefix $(obj)/,$(bch-arch-asm-rs)): $(obj)/rust/%.rs: $(src)/util/%.rs.S FORCE
+	$(Q)mkdir -p $(@D)
+	$(call if_changed_dep,bch_rscpp)
+
+targets += $(bch-arch-asm-rs)
+
+# mod.o gets them as externs, and the codegen output via OUT_DIR, as in
+# userspace - and the crate's directory as cargo gives it, CARGO_MANIFEST_DIR,
+# which c_xmacro_from_c! reads C's headers relative to.
+bch-externs := paste:libpaste.so \
+	cstruct_macros:libcstruct_macros.so bitfield_struct:libbitfield_struct.so \
+	nestify:libnestify.so \
+	arrayvec:libarrayvec.rmeta bitfield:libbitfield.rmeta bitflags:libbitflags.rmeta \
+	num_traits:libnum_traits.rmeta uuid:libuuid.rmeta
+RUSTFLAGS_mod.o += $(foreach e,$(bch-externs),--extern $(subst :,=$(obj)/,$(e)))
+$(obj)/mod.o: export OUT_DIR := $(abspath $(obj)/rust)
+$(obj)/mod.o: export CARGO_MANIFEST_DIR := $(abspath $(src))
+$(obj)/mod.o: $(obj)/rust/bindings.rs $(addprefix $(obj)/,$(bch-arch-asm-rs)) $(obj)/libpaste.so \
+	$(obj)/libcstruct_macros.so $(obj)/libbitfield_struct.so $(obj)/libnestify.so \
+	$(obj)/arrayvec.o $(obj)/bitfield.o $(obj)/bitflags.o $(obj)/num_traits.o $(obj)/uuid.o
+
+# mod.o carries the records of the types defined in Rust that C shares
+# (types/lib.rs), in .discard.bch_cstruct: the headers are generated from them,
+# and linking the module discards them.
+RUSTFLAGS_mod.o += --cfg bch_cstruct_records
+
+targets += codegen rust/bindings.rs libpaste.so \
+	libcstruct_macros.so libbitfield_struct.so libnestify.so \
+	$(addprefix rust-host/,libproc_macro2.rmeta libquote.rmeta libsyn.rmeta)
+
+# The Rust objects, linked into the module as one: rust.o, below.
+bch-rust-gc-in := mod.o arrayvec.o bitfield.o bitflags.o num_traits.o uuid.o bch_builtins.o
+bcachefs-y += rust.o rust/extern.o
+
+# And what those rules write besides their targets: the rest of the codegen's
+# output, the rlibs' metadata, and the vendored stack's directory - here, as
+# clean doesn't always read Makefile.rust.vendor.
+clean-files += rust rust-host vrust lib*.rmeta
+
+# Makefile.rust.vendor builds mod.o against the vendored stack; otherwise kbuild
+# builds it.
+ifeq ($(bcachefs-vendor-rust),y)
+include $(src)/Makefile.rust.vendor
+endif
+
+# Line tables, not the kernel's full (or reduced) debuginfo: our crate is one
+# codegen unit, so what rustc holds for it grows with the crate - enough to be
+# OOM-killed in a 4G test VM - and full debuginfo adds ~15% to that, for
+# nothing BTF uses: pahole skips Rust units. Line tables keep addresses
+# decodable to file:line. After Makefile.rust.vendor, which may have turned
+# debuginfo off for BTF: this reads KBUILD_RUSTFLAGS now (rustflags-y is
+# simply expanded), and mustn't turn it back on.
+rustflags-remove-y += -Cdebuginfo=1 -Cdebuginfo=2
+rustflags-y += $(if $(filter -Cdebuginfo=1 -Cdebuginfo=2,$(KBUILD_RUSTFLAGS)),-Cdebuginfo=line-tables-only)
+
+# ---- rust.o: the Rust, less what nothing reaches ----------------------------
+# kbuild links a module without section GC, and rustc compiles everything a
+# crate's dependents could call - core's and the vendored crates' included:
+# unless it's collected here, it's all in the module, with what it references
+# (a crate's float impls, say: soft-float intrinsics the kernel doesn't have).
+# scripts/rust-gc-link.sh has the roots and what's kept.
+#
+# Its inputs aren't bcachefs.o's members to kbuild, only rust.o is: they're
+# made members - of the module, or built in, as bcachefs.o is - as
+# Makefile.build does a composite's, so their flags (MODULE, KASAN, KCOV, ...)
+# are a member's. objtool runs on rust.o, as on any member - or on bcachefs.o,
+# when kbuild delays it - not on its inputs: their ORC, return-site and mcount
+# tables would make every function reachable.
+#
+# rust.o is linked, a file symbol from each input: objtool refuses that
+# without --link (since 6.15). kbuild passes it only when it delays objtool to
+# bcachefs.o - IBT, LTO_CLANG, KLP_BUILD - when objtool doesn't run on rust.o
+# at all; without those, rust.o's run needs its own.
+bch-rust-gc-objs := $(addprefix $(obj)/,$(bch-rust-gc-in))
+ifeq ($(CONFIG_BCACHEFS_FS),m)
+$(bch-rust-gc-objs): private part-of-module := y
+else
+$(bch-rust-gc-objs): private part-of-builtin := y
+endif
+OBJECT_FILES_NON_STANDARD_mod.o := y
+$(obj)/rust.o: private objtool-args += --link
+
+quiet_cmd_bch_rust_gc = LD $(quiet_modtag)  $@
+      cmd_bch_rust_gc = LD='$(LD) $(ld_flags)' NM='$(NM)' OBJCOPY='$(OBJCOPY)' \
+	READELF='$(READELF)' $(CONFIG_SHELL) $(src)/scripts/rust-gc-link.sh \
+	$@ $(obj)/rust $(bch-rust-gc-objs) $(cmd_objtool)
+
+define rule_bch_rust_gc
+	$(call cmd_and_savecmd,bch_rust_gc)
+	$(call cmd,gen_objtooldep)
+endef
+
+$(obj)/rust.o: $(bch-rust-gc-objs) $(src)/scripts/rust-gc-link.sh FORCE
+	$(call if_changed_rule,bch_rust_gc)
+
+targets += $(bch-rust-gc-in)
+
+# ---- the C of the types defined in Rust ------------------------------------
+# foo/types_gen.h for foo/types.rs (types/lib.rs), written from mod.o's
+# records by rust_types_gen, a host program. In $(obj)/rust, never $(src):
+# userspace generates its own. Every C object waits for them; mod.o and the
+# bindings it's built from can't - they come first.
+#
+# Each record is a section of its own, all of the same name: ld -r makes them
+# one, which objcopy extracts. A record's source path is relative to where
+# rustc ran - or, since 7.0's --remap-path-prefix=$(srcroot)/=, to srcroot:
+# not where this runs in an in-tree O= build, so rust_types_gen is given it.
+$(obj)/rust_types_gen: $(src)/types/main.rs $(src)/types/cstruct.rs FORCE
+	$(call if_changed,bch_codegen_host)
+
+quiet_cmd_bch_cstruct_gen = GEN     $(obj)/rust/*_gen.h
+      cmd_bch_cstruct_gen = $(LD) -r -o $(obj)/rust/cstruct.o $< && \
+	$(OBJCOPY) -O binary -j .discard.bch_cstruct $(obj)/rust/cstruct.o $(obj)/rust/cstruct.bin && \
+	$(obj)/rust_types_gen $(obj)/rust/cstruct.bin $(src) $(obj)/rust $(srcroot) && \
+	touch $@
+
+$(obj)/rust/cstruct.stamp: $(obj)/mod.o $(obj)/rust_types_gen FORCE
+	$(call if_changed,bch_cstruct_gen)
+
+targets += rust_types_gen rust/cstruct.stamp
+
+# After the vendored stack's include: its objects are in bcachefs-y by now.
+subdir-ccflags-y += -I$(obj)/rust
+$(addprefix $(obj)/,$(filter-out rust.o vrust/%,$(bcachefs-y))): | $(obj)/rust/cstruct.stamp
+
+# The headers come from the stamp's recipe: without saying so, make reads their
+# times before it runs, and an object whose header just changed isn't rebuilt.
+# rust_types_gen rewrites only the headers that changed.
+$(obj)/rust/%_gen.h: $(obj)/rust/cstruct.stamp
+	@:
diff --git a/fs/bcachefs/Makefile.rust.vendor b/fs/bcachefs/Makefile.rust.vendor
new file mode 100644
index 0000000..4a3b4d0
--- /dev/null
+++ b/fs/bcachefs/Makefile.rust.vendor
@@ -0,0 +1,263 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# The vendored Rust stack: a patched copy of the kernel's rust/ (7.1), in
+# fs/vendor/kernel-rust, built into $(obj)/vrust and bundled into bcachefs.ko,
+# for when the kernel's own Rust can't be used (fs/Makefile.rust decides).
+# Its Rust symbols stay module-local; only the kernel's C ABI crosses the .ko
+# boundary. The kernel tree is only read.
+
+VRD	:= $(obj)/vrust
+VRD_ABS	:= $(abspath $(VRD))
+VENDOR	:= $(src)/vendor/kernel-rust
+
+# ---- adapting the kernel's build to our rustc ------------------------------
+# The kernel's KBUILD_RUSTFLAGS (set even with CONFIG_RUST=n), rustc_cfg and
+# target.json were made for the rustc it was configured with - not ours, or we
+# wouldn't be here. Redo for $(RUSTC) what the kernel decided by its version.
+# KBUILD_RUSTFLAGS is rewritten in place: every rule expands it lazily.
+
+bch-rust-L := -L$(VRD)
+
+# target.json, where the kernel's flags use one (x86; the other architectures
+# use rustc's builtin targets, and the generator refuses them): a Rust-off
+# kernel has none, and a Rust kernel's is for its rustc (the format changes
+# between versions). Ours, from the kernel's generator told our version, made
+# at parse time so every rule sees it - and removed if that fails, not left
+# empty by the redirect. The generator is vendored too: distros' kernel headers
+# don't all ship it (Debian's don't, #1133).
+ifneq ($(filter --target=$(objtree)/scripts/target.json,$(KBUILD_RUSTFLAGS)),)
+bch-target-json := $(VRD_ABS)/target.json
+bch-target-gen := $(VENDOR)/scripts/generate_rust_target.rs
+$(shell	mkdir -p '$(VRD_ABS)' &&						\
+	{ [ '$(VRD_ABS)/generate_rust_target' -nt '$(bch-target-gen)' ] || \
+	  $(HOSTRUSTC) --edition=2021 -Copt-level=0			\
+	    '$(bch-target-gen)' -o '$(VRD_ABS)/generate_rust_target'; } && \
+	{ grep -v '^CONFIG_RUSTC_VERSION=' '$(objtree)/include/config/auto.conf'; \
+	  echo CONFIG_RUSTC_VERSION=$(bch-rustc-version); } |	\
+	'$(VRD_ABS)/generate_rust_target' > '$(bch-target-json).tmp' &&	\
+	{ cmp -s '$(bch-target-json).tmp' '$(bch-target-json)' && rm -f '$(bch-target-json).tmp' || \
+	  mv '$(bch-target-json).tmp' '$(bch-target-json)'; } ||		\
+	rm -f '$(bch-target-json)' '$(bch-target-json).tmp')
+ifneq ($(wildcard $(bch-target-json)),)
+KBUILD_RUSTFLAGS := $(patsubst --target=$(objtree)/scripts/target.json,--target=$(bch-target-json),$(KBUILD_RUSTFLAGS))
+else ifneq ($(.DEFAULT_GOAL),__clean)
+$(error bcachefs: failed to generate $(bch-target-json) with $(bch-target-gen))
+endif
+endif
+
+# rustc_cfg: the kernel's, with its CONFIG_RUSTC_HAS_* replaced by ours, at
+# init/Kconfig's thresholds - and CONFIG_RUST, which a CONFIG_RUST=n kernel's
+# lacks and kernel/lib.rs refuses to build without: this describes our Rust,
+# and that's always on. Its own mkdir: target.json's above is x86 only.
+bch-vr-rustc-has := SPAN_FILE:108800 UNNECESSARY_TRANSMUTES:108800 FILE_WITH_NUL:108900 \
+	FILE_AS_C_STR:109100 SUSPICIOUS_RUNTIME_SYMBOL_DEFINITIONS:109800
+bch-rustc-cfg := $(VRD_ABS)/rustc_cfg
+$(shell mkdir -p '$(VRD_ABS)' && \
+	{ grep -v -e '^--cfg=CONFIG_RUSTC_' -e '^--cfg=CONFIG_RUST$$' \
+		'$(objtree)/include/generated/rustc_cfg'; \
+	echo --cfg=CONFIG_RUST; \
+	$(foreach h,$(bch-vr-rustc-has),$(if $(call bch-rustc-min,$(lastword $(subst :, ,$(h)))),\
+		echo --cfg=CONFIG_RUSTC_HAS_$(firstword $(subst :, ,$(h)));)) } > '$(bch-rustc-cfg)')
+
+# -Zno-jump-tables became -Cjump-tables=n in 1.93: pass whichever we take.
+ifneq ($(filter -Cjump-tables=n -Zno-jump-tables,$(KBUILD_RUSTFLAGS)),)
+KBUILD_RUSTFLAGS := $(filter-out -Cjump-tables=n -Zno-jump-tables,$(KBUILD_RUSTFLAGS)) \
+	$(shell $(RUSTC) -Cjump-tables=n --print=sysroot >/dev/null 2>&1 && \
+		echo -Cjump-tables=n || echo -Zno-jump-tables)
+endif
+
+# The cs prefix on retpoline thunk calls, as C has it: paranoid FineIBT's
+# rewrite needs it (fs/Makefile.rust). rustc has it from 1.91;
+# rust-available.sh requires that of a CONFIG_FINEIBT kernel.
+KBUILD_RUSTFLAGS := $(filter-out -Zindirect-branch-cs-prefix,$(KBUILD_RUSTFLAGS)) \
+	$(if $(filter -mindirect-branch-cs-prefix,$(KBUILD_CFLAGS)),$(if $(call bch-rustc-min,109100),-Zindirect-branch-cs-prefix))
+
+# rustc < 1.98 doesn't record frame pointers or unwind tables in the LLVM
+# module flags (rust-lang/rust#156980, #156973); the kernel adds them by hand
+# when it asks for either (top Makefile, arch/arm64), if its rustc needs it.
+bch-vr-fp-flag := -Zllvm_module_flag=frame-pointer:u32:2:max
+bch-vr-uwt-flag := -Zllvm_module_flag=uwtable:u32:2:max
+KBUILD_RUSTFLAGS := $(filter-out $(bch-vr-fp-flag) $(bch-vr-uwt-flag),$(KBUILD_RUSTFLAGS)) \
+	$(if $(call bch-rustc-min,109800),,\
+		$(if $(filter -Cforce-frame-pointers=y,$(KBUILD_RUSTFLAGS)),$(bch-vr-fp-flag)) \
+		$(if $(filter arm64,$(SRCARCH)),$(if $(filter -Cforce-unwind-tables=y,$(KBUILD_RUSTFLAGS)),$(bch-vr-uwt-flag))))
+
+# A kernel only has Rust with module BTF if pahole can skip Rust units and
+# there's no LTO (init/Kconfig); outside that our DWARF breaks the module's BTF
+# (#1086), so build without debuginfo.
+ifdef CONFIG_DEBUG_INFO_BTF_MODULES
+ifneq ($(CONFIG_PAHOLE_HAS_LANG_EXCLUDE):$(CONFIG_LTO),y:)
+KBUILD_RUSTFLAGS := $(filter-out $(DEBUG_RUSTFLAGS),$(KBUILD_RUSTFLAGS)) -Cdebuginfo=0
+endif
+endif
+
+# KASAN only where the kernel allows it with Rust (init/Kconfig: RUST depends
+# on !KASAN || CC_IS_CLANG, and SW_TAGS on rustc 1.96): rustc's
+# instrumentation doesn't match gcc's.
+ifneq ($(CONFIG_CC_IS_CLANG),y)
+RUSTFLAGS_KASAN :=
+else ifdef CONFIG_KASAN_SW_TAGS
+RUSTFLAGS_KASAN := $(if $(call bch-rustc-min,109600),$(RUSTFLAGS_KASAN))
+endif
+
+# AutoFDO's debuginfo flag, spelled for our rustc (renamed in 1.98).
+ifdef CONFIG_AUTOFDO_CLANG
+RUSTFLAGS_AUTOFDO_CLANG := $(filter-out -Zdebuginfo-for-profiling -Zdebug-info-for-profiling,$(RUSTFLAGS_AUTOFDO_CLANG)) \
+	$(if $(call bch-rustc-min,109800),-Zdebuginfo-for-profiling,-Zdebug-info-for-profiling)
+endif
+
+# ---- the vendored crates ---------------------------------------------------
+# Built by Makefile.rust's rules; all vendored, so all lint-capped. The
+# kernel's own rules for them are in vendor/kernel-rust/Makefile.
+
+# bindgen, as the kernel's rule does it: the carried bindgen_parameters, and
+# the kernel's C flags less the ones libclang can't parse.
+# $(bcachefs-codegen-target) is defined in fs/bcachefs/Makefile.rust
+# (our parent file), same as for our codegen.
+# -I rust/bindings: the helper headers' relative includes ("../../drivers/base/base.h")
+# resolve from there.
+bch-vr-bindgen-cflags := $(LINUXINCLUDE) -I$(srctree)/rust/bindings $(KBUILD_CPPFLAGS) \
+	$(filter-out $(bcachefs-codegen-skip-cflags),$(KBUILD_CFLAGS)) \
+	-fno-builtin -D__BINDGEN__ -DMODULE -DKBUILD_MODNAME='"bcachefs"' -w \
+	$(bcachefs-codegen-target)
+quiet_cmd_bch_vr_bindgen = BINDGEN $@
+      cmd_bch_vr_bindgen = $(BINDGEN) $< $(rs-bindgen-flags) --rust-target 1.85 \
+	--use-core --with-derive-default --ctypes-prefix ffi --no-layout-tests \
+	--no-debug '.*' --enable-function-attribute-detection -o $@ \
+	-- $(bch-vr-bindgen-cflags) $(rs-bindgen-cflags) $(rs-post)
+
+# The proc-macros, on Makefile.rust's host crates:
+$(VRD)/libmacros.so $(VRD)/libzerocopy_derive.so: private rs-flags := $(bch-pmac)
+$(VRD)/libpin_init_internal.so: private rs-flags := $(bch-pmac) --cfg kernel --cfg USE_RUSTC_FEATURES
+
+$(VRD)/libmacros.so: $(VENDOR)/macros/lib.rs $(bch-pmac-deps)
+	$(call if_changed_dep,bch_procmacro)
+$(VRD)/libzerocopy_derive.so: $(VENDOR)/zerocopy-derive/lib.rs $(bch-pmac-deps)
+	$(call if_changed_dep,bch_procmacro)
+$(VRD)/libpin_init_internal.so: $(VENDOR)/pin-init/internal/src/lib.rs $(bch-pmac-deps)
+	$(call if_changed_dep,bch_procmacro)
+
+# core, our rustc's own, at its own edition; the soft-float and u128
+# intrinsics routed to __rust*, which compiler_builtins stubs.
+vr-redirect-intrinsics := __addsf3 __eqsf2 __extendsfdf2 __gesf2 __lesf2 __ltsf2 \
+	__mulsf3 __nesf2 __truncdfsf2 __unordsf2 __adddf3 __eqdf2 __ledf2 __ltdf2 \
+	__muldf3 __unorddf2 __muloti4 __multi3 __udivmodti4 __udivti3 __umodti3
+$(VRD)/core.o: private rs-edition := $(shell sed -n 's/^edition *= *"\(.*\)"/\1/p' $(RUST_LIB_SRC)/core/Cargo.toml)
+$(VRD)/core.o: private rs-flags := --cap-lints=allow --cfg no_fp_fmt_parse
+$(VRD)/core.o: private rs-post = ; $(OBJCOPY) $(foreach s,$(vr-redirect-intrinsics),--redefine-sym $(s)=__rust$(s)) $@
+$(VRD)/core.o: $(RUST_LIB_SRC)/core/src/lib.rs FORCE
+	$(call if_changed_dep,bch_rlib)
+KCOV_INSTRUMENT_vrust/core.o := n
+
+vr-core := --cap-lints=allow --extern core=$(VRD)/libcore.rmeta
+$(VRD)/compiler_builtins.o: private rs-flags := $(vr-core)
+$(VRD)/compiler_builtins.o: private rs-post = ; $(OBJCOPY) -w -W '__*' $@
+$(VRD)/compiler_builtins.o: $(VENDOR)/compiler_builtins.rs $(VRD)/core.o FORCE
+	$(call if_changed_dep,bch_rlib)
+
+# Everything else is built on those two - our leaf crates too:
+vr-base := $(vr-core) --extern compiler_builtins=$(VRD)/libcompiler_builtins.rmeta
+vr-base-deps := $(VRD)/compiler_builtins.o FORCE
+$(obj)/arrayvec.o $(obj)/bitfield.o $(obj)/bitflags.o $(obj)/num_traits.o $(obj)/uuid.o \
+	$(obj)/bch_builtins.o: $(VRD)/compiler_builtins.o
+
+$(VRD)/ffi.o $(VRD)/build_error.o: private rs-flags := $(vr-base)
+$(VRD)/ffi.o: $(VENDOR)/ffi.rs $(vr-base-deps)
+	$(call if_changed_dep,bch_rlib)
+$(VRD)/build_error.o: $(VENDOR)/build_error.rs $(vr-base-deps)
+	$(call if_changed_dep,bch_rlib)
+
+$(VRD)/zerocopy.o: private rs-env := CARGO_PKG_VERSION=0.8.50
+$(VRD)/zerocopy.o: private rs-flags := $(vr-base) --extern zerocopy_derive=$(VRD)/libzerocopy_derive.so
+$(VRD)/zerocopy.o: $(VENDOR)/zerocopy/src/lib.rs $(VRD)/libzerocopy_derive.so $(vr-base-deps)
+	$(call if_changed_dep,bch_rlib)
+
+$(VRD)/pin_init.o: private rs-flags := $(vr-base) --cfg kernel --cfg USE_RUSTC_FEATURES \
+	--extern pin_init_internal=$(VRD)/libpin_init_internal.so --extern macros=$(VRD)/libmacros.so
+$(VRD)/pin_init.o: $(VENDOR)/pin-init/src/lib.rs $(VRD)/libpin_init_internal.so \
+	$(VRD)/libmacros.so $(vr-base-deps)
+	$(call if_changed_dep,bch_rlib)
+
+# bindings and uapi: bindgen on the kernel headers. The crates, and kernel's
+# generated arch asm below, are found under $OBJTREE/rust - so OBJTREE is ours.
+vr-bindgen-params := $(shell grep -Ev '^\#|^$$' $(VENDOR)/bindgen_parameters)
+$(VRD)/rust/bindings/bindings_generated.rs $(VRD)/rust/uapi/uapi_generated.rs: \
+	private rs-bindgen-flags := $(vr-bindgen-params)
+$(VRD)/rust/bindings/bindings_generated.rs: private rs-post = ; \
+	sed -Ei 's/pub const RUST_CONST_HELPER_([a-zA-Z0-9_]*)/pub const \1/g' $@
+$(VRD)/rust/bindings/bindings_helpers_generated.rs: private rs-bindgen-flags := \
+	--blocklist-type '.*' --allowlist-var '' --allowlist-function 'rust_helper_.*'
+$(VRD)/rust/bindings/bindings_helpers_generated.rs: private rs-bindgen-cflags := \
+	-I$(VRD)/rust/bindings -Wno-missing-prototypes -Wno-missing-declarations
+$(VRD)/rust/bindings/bindings_helpers_generated.rs: private rs-post = ; \
+	sed -Ei 's/pub fn rust_helper_([a-zA-Z0-9_]*)/#[link_name="rust_helper_\1"]\n    pub fn \1/g' $@
+
+$(VRD)/rust/bindings/bindings_generated.rs: $(VENDOR)/bindings/bindings_helper.h $(VENDOR)/bindgen_parameters FORCE
+	$(Q)mkdir -p $(@D)
+	$(call if_changed,bch_vr_bindgen)
+$(VRD)/rust/bindings/bindings_helpers_generated.rs: $(VENDOR)/helpers/helpers.c FORCE
+	$(Q)mkdir -p $(@D)
+	$(call if_changed,bch_vr_bindgen)
+$(VRD)/rust/uapi/uapi_generated.rs: $(VENDOR)/uapi/uapi_helper.h $(VENDOR)/bindgen_parameters FORCE
+	$(Q)mkdir -p $(@D)
+	$(call if_changed,bch_vr_bindgen)
+
+vr-kernel-deps := $(vr-base) --extern ffi=$(VRD)/libffi.rmeta --extern pin_init=$(VRD)/libpin_init.rmeta
+$(VRD)/bindings.o $(VRD)/uapi.o $(VRD)/kernel.o: private rs-env := OBJTREE=$(VRD_ABS)
+$(VRD)/bindings.o $(VRD)/uapi.o: private rs-flags := $(vr-kernel-deps)
+$(VRD)/bindings.o: $(VENDOR)/bindings/lib.rs $(VRD)/ffi.o $(VRD)/pin_init.o \
+	$(VRD)/rust/bindings/bindings_generated.rs $(VRD)/rust/bindings/bindings_helpers_generated.rs FORCE
+	$(call if_changed_dep,bch_rlib)
+$(VRD)/uapi.o: $(VENDOR)/uapi/lib.rs $(VRD)/ffi.o $(VRD)/pin_init.o \
+	$(VRD)/rust/uapi/uapi_generated.rs FORCE
+	$(call if_changed_dep,bch_rlib)
+
+# The kernel crate, and the arch asm it includes, preprocessed from .rs.S
+# (Makefile.rust's bch_rscpp):
+vr-arch-gen-rs := $(foreach f,static_branch warn reachable,$(VRD)/rust/kernel/generated_arch_$(f)_asm.rs)
+$(vr-arch-gen-rs): $(VRD)/rust/kernel/%.rs: $(VENDOR)/kernel/%.rs.S FORCE
+	$(Q)mkdir -p $(@D)
+	$(call if_changed,bch_rscpp)
+
+$(VRD)/kernel.o: private rs-flags := $(vr-kernel-deps) \
+	--extern build_error=$(VRD)/libbuild_error.rmeta --extern macros=$(VRD)/libmacros.so \
+	--extern bindings=$(VRD)/libbindings.rmeta --extern uapi=$(VRD)/libuapi.rmeta \
+	--extern zerocopy=$(VRD)/libzerocopy.rmeta --extern zerocopy_derive=$(VRD)/libzerocopy_derive.so
+$(VRD)/kernel.o: $(VENDOR)/kernel/lib.rs $(VRD)/build_error.o $(VRD)/bindings.o \
+	$(VRD)/uapi.o $(VRD)/zerocopy.o $(vr-arch-gen-rs) FORCE
+	$(call if_changed_dep,bch_rlib)
+
+# The rust_helper_* C the kernel crate calls; helpers.c #includes helpers/*.c.
+quiet_cmd_bch_vr_helpers = CC [M]  $@
+      cmd_bch_vr_helpers = $(CC) $(c_flags) -I$(VENDOR)/include -c -o $@ $<
+$(VRD)/helpers.o: $(VENDOR)/helpers/helpers.c $(wildcard $(VENDOR)/helpers/*.c) FORCE
+	$(Q)mkdir -p $(@D)
+	$(call if_changed_dep,bch_vr_helpers)
+
+# ---- mod.o: bcachefs's Rust, against the vendored crates --------------------
+# What kbuild's Rust rule does on the kernel's-Rust path - its per-object flags
+# included - but with our externs and cfgs. It supplies no_std and OBJTREE as
+# that rule does; mod.rs mustn't (a no_std attribute there is a duplicate on
+# the kbuild path: unused_attributes, fatal under CONFIG_WERROR).
+quiet_cmd_bch_vr_mod = RUSTC M  $@
+      cmd_bch_vr_mod = OUT_DIR=$(abspath $(obj)/rust) OBJTREE=$(VRD_ABS) \
+	$(RUSTC) $(filter-out --edition=%,$(_rust_flags)) $(bch-rust-gc-flags) @$(bch-rustc-cfg) \
+	--edition=2021 -Awarnings -Zunstable-options --sysroot=/dev/null \
+	-L$(VRD) -Zcrate-attr=no_std -Zcrate-attr='feature($(rust_allowed_features))' \
+	--crate-type rlib --crate-name bcachefs_mod \
+	--extern core=$(VRD)/libcore.rmeta --extern kernel=$(VRD)/libkernel.rmeta \
+	--extern pin_init=$(VRD)/libpin_init.rmeta --extern bindings=$(VRD)/libbindings.rmeta \
+	--extern zerocopy=$(VRD)/libzerocopy.rmeta \
+	--emit=obj=$@ $<
+$(obj)/mod.o: $(src)/mod.rs $(obj)/rust/bindings.rs $(VRD)/kernel.o $(VRD)/zerocopy.o FORCE
+	$(call if_changed,bch_vr_mod)
+
+# The Rust goes into rust.o (Makefile.rust), its C helpers into the module.
+bch-vr-objs := $(addprefix vrust/,core.o compiler_builtins.o ffi.o build_error.o \
+	zerocopy.o pin_init.o bindings.o uapi.o kernel.o)
+bch-rust-gc-in += $(bch-vr-objs)
+bcachefs-y += vrust/helpers.o
+targets += $(bch-vr-objs) vrust/helpers.o $(addprefix vrust/,libmacros.so libpin_init_internal.so \
+	libzerocopy_derive.so) \
+	$(patsubst $(obj)/%,%,$(vr-arch-gen-rs) $(addprefix $(VRD)/rust/,\
+	bindings/bindings_generated.rs bindings/bindings_helpers_generated.rs uapi/uapi_generated.rs))
diff --git a/fs/bcachefs/alloc/accounting.c b/fs/bcachefs/alloc/accounting.c
new file mode 100644
index 0000000..df18904
--- /dev/null
+++ b/fs/bcachefs/alloc/accounting.c
@@ -0,0 +1,1509 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include "bcachefs.h"
+#include "bcachefs_ioctl.h"
+
+#include "alloc/accounting.h"
+#include "alloc/buckets.h"
+#include "alloc/replicas.h"
+
+#include "btree/cache.h"
+#include "btree/journal_overlay.h"
+#include "btree/update.h"
+#include "btree/write_buffer.h"
+
+#include "data/compress.h"
+
+#include "init/error.h"
+#include "init/fs.h"
+#include "init/passes.h"
+
+/*
+ * Notes on disk accounting:
+ *
+ * We have two parallel sets of counters to be concerned with, and both must be
+ * kept in sync.
+ *
+ *  - Persistent/on disk accounting, stored in the accounting btree and updated
+ *    via btree write buffer updates that treat new accounting keys as deltas to
+ *    apply to existing values. But reading from a write buffer btree is
+ *    expensive, so we also have
+ *
+ *  - In memory accounting, where accounting is stored as an array of percpu
+ *    counters, indexed by an eytzinger array of disk acounting keys/bpos (which
+ *    are the same thing, excepting byte swabbing on big endian).
+ *
+ *    Cheap to read, but non persistent.
+ *
+ * Disk accounting updates are generated by transactional triggers; these run as
+ * keys enter and leave the btree, and can compare old and new versions of keys;
+ * the output of these triggers are deltas to the various counters.
+ *
+ * Disk accounting updates are done as btree write buffer updates, where the
+ * counters in the disk accounting key are deltas that will be applied to the
+ * counter in the btree when the key is flushed by the write buffer (or journal
+ * replay).
+ *
+ * To do a disk accounting update:
+ * - initialize a disk_accounting_pos, to specify which counter is being update
+ * - initialize counter deltas, as an array of 1-3 s64s
+ * - call bch2_disk_accounting_mod()
+ *
+ * This queues up the accounting update to be done at transaction commit time.
+ * Underneath, it's a normal btree write buffer update.
+ *
+ * The transaction commit path is responsible for propagating updates to the in
+ * memory counters, with bch2_accounting_mem_mod().
+ *
+ * The commit path also assigns every disk accounting update a unique version
+ * number, based on the journal sequence number and offset within that journal
+ * buffer; this is used by journal replay to determine which updates have been
+ * done.
+ *
+ * The transaction commit path also ensures that replicas entry accounting
+ * updates are properly marked in the superblock (so that we know whether we can
+ * mount without data being unavailable); it will update the superblock if
+ * bch2_accounting_mem_mod() tells it to.
+ */
+
+static const char * const disk_accounting_type_strs[] = {
+#define x(t, n, ...) [n] = #t,
+	BCH_DISK_ACCOUNTING_TYPES()
+#undef x
+	NULL
+};
+
+static const unsigned bch2_accounting_type_nr_counters[] = {
+#define x(f, id, nr)	[BCH_DISK_ACCOUNTING_##f]	= nr,
+	BCH_DISK_ACCOUNTING_TYPES()
+#undef x
+};
+
+static inline void __accounting_key_init(struct bkey_i *k, struct bpos pos,
+					 s64 *d, unsigned nr)
+{
+	struct bkey_i_accounting *acc = bkey_accounting_init(k);
+
+	acc->k.p = pos;
+	set_bkey_val_u64s(&acc->k, sizeof(struct bch_accounting) / sizeof(u64) + nr);
+
+	memcpy_u64s_small(acc->v.d, d, nr);
+}
+
+static inline void accounting_key_init(struct bkey_i *k, struct disk_accounting_pos *pos,
+				       s64 *d, unsigned nr)
+{
+	return __accounting_key_init(k, disk_accounting_pos_to_bpos(pos), d, nr);
+}
+
+static int bch2_accounting_update_sb_one(struct bch_fs *, struct bpos);
+
+int bch2_accounting_mem_add(struct btree_trans *trans, struct bkey_s_c_accounting a,
+			    enum bch_accounting_mode mode, bool write_locked)
+{
+	return bch2_accounting_mem_add_inlined(trans, a, mode, write_locked);
+}
+
+int bch2_disk_accounting_mod_normal(struct btree_trans *trans,
+			     struct disk_accounting_pos *k,
+			     s64 *d, unsigned nr)
+{
+	BUG_ON(nr > BCH_ACCOUNTING_MAX_COUNTERS);
+
+	BUG_ON(k->type >= BCH_DISK_ACCOUNTING_TYPE_NR);
+	EBUG_ON(nr != bch2_accounting_type_nr_counters[k->type]);
+
+	/* Normalize: */
+	switch (k->type) {
+	case BCH_DISK_ACCOUNTING_replicas:
+		bubble_sort(k->replicas.devs, k->replicas.nr_devs, u8_cmp);
+		break;
+	}
+
+	struct bpos pos = disk_accounting_pos_to_bpos(k);
+	struct bkey_i_accounting *a;
+
+	for (a = btree_trans_subbuf_base(trans, &trans->accounting);
+	     a != btree_trans_subbuf_top(trans, &trans->accounting);
+	     a = (void *) bkey_next(&a->k_i))
+		if (bpos_eq(a->k.p, pos) &&
+		    bch2_accounting_counters(&a->k) == nr) {
+			acc_u64s(a->v.d, d, nr);
+
+			if (bch2_accounting_key_is_zero(accounting_i_to_s_c(a))) {
+				unsigned offset = (u64 *) a -
+					(u64 *) btree_trans_subbuf_base(trans, &trans->accounting);
+
+				trans->accounting.u64s -= a->k.u64s;
+				memmove_u64s_down(a,
+						  bkey_next(&a->k_i),
+						  trans->accounting.u64s - offset);
+			}
+			return 0;
+		}
+
+	unsigned u64s = sizeof(*a) / sizeof(u64) + nr;
+	a = errptr_try(bch2_trans_subbuf_alloc(trans, &trans->accounting, u64s));
+
+	__accounting_key_init(&a->k_i, pos, d, nr);
+	return 0;
+}
+
+int bch2_disk_accounting_mod_gc(struct btree_trans *trans,
+			     struct disk_accounting_pos *k,
+			     s64 *d, unsigned nr)
+{
+	BUG_ON(nr > BCH_ACCOUNTING_MAX_COUNTERS);
+
+	BUG_ON(k->type >= BCH_DISK_ACCOUNTING_TYPE_NR);
+	EBUG_ON(nr != bch2_accounting_type_nr_counters[k->type]);
+
+	/* Normalize: */
+	switch (k->type) {
+	case BCH_DISK_ACCOUNTING_replicas:
+		bubble_sort(k->replicas.devs, k->replicas.nr_devs, u8_cmp);
+		break;
+	}
+
+	struct { __BKEY_PADDED(k, BCH_ACCOUNTING_MAX_COUNTERS); } k_i;
+
+	__accounting_key_init(&k_i.k, disk_accounting_pos_to_bpos(k), d, nr);
+
+	int ret = 0;
+
+	while (true) {
+		scoped_guard(percpu_read_noio, &trans->c->capacity.mark_lock)
+			ret = bch2_accounting_mem_add_inlined(trans,
+						bkey_i_to_s_c_accounting(&k_i.k),
+						BCH_ACCOUNTING_gc,
+						false);
+		if (likely(ret != -BCH_ERR_btree_insert_need_mark_replicas))
+			break;
+
+		ret = drop_locks_do(trans, bch2_accounting_update_sb_one(trans->c, k_i.k.k.p));
+		if (ret)
+			break;
+	}
+
+	return ret;
+}
+
+int bch2_mod_dev_cached_sectors(struct btree_trans *trans,
+				unsigned dev, s64 sectors,
+				bool gc)
+{
+	struct disk_accounting_pos acc;
+	memset(&acc, 0, sizeof(acc));
+	acc.type = BCH_DISK_ACCOUNTING_replicas;
+	bch2_replicas_entry_cached(&acc.replicas, dev);
+
+	return bch2_disk_accounting_mod(trans, &acc, &sectors, 1, gc);
+}
+
+static inline bool is_zero(char *start, char *end)
+{
+	BUG_ON(start > end);
+
+	for (; start < end; start++)
+		if (*start)
+			return false;
+	return true;
+}
+
+#define field_end(p, member)	(((void *) (&p.member)) + sizeof(p.member))
+
+/* @acc's replicas entry has more devs than the key has room for: */
+static inline bool accounting_replicas_past_end(struct disk_accounting_pos *acc)
+{
+	return (void *) &acc->replicas + replicas_entry_bytes(&acc->replicas) >
+		(void *) (acc + 1);
+}
+
+int bch2_accounting_validate(struct bch_fs *c, struct bkey_s_c k,
+			     const struct bkey_validate_context *from)
+{
+	struct disk_accounting_pos acc_k;
+	bpos_to_disk_accounting_pos(&acc_k, k.k->p);
+	void *end = &acc_k + 1;
+	int ret = 0;
+
+	if (acc_k.type >= BCH_DISK_ACCOUNTING_TYPE_NR)
+		return 0;
+
+	bkey_fsck_err_on((from->flags & BCH_VALIDATE_commit) &&
+			 bversion_zero(k.k->bversion),
+			 c, accounting_key_version_0,
+			 "accounting key with version=0");
+
+	switch (acc_k.type) {
+	case BCH_DISK_ACCOUNTING_nr_inodes:
+		end = field_end(acc_k, nr_inodes);
+		break;
+	case BCH_DISK_ACCOUNTING_persistent_reserved:
+		end = field_end(acc_k, persistent_reserved);
+		break;
+	case BCH_DISK_ACCOUNTING_replicas:
+		bkey_fsck_err_on(accounting_replicas_past_end(&acc_k),
+				 c, accounting_key_replicas_past_end,
+				 "accounting key replicas entry with %u devs, room for %zu",
+				 acc_k.replicas.nr_devs,
+				 (size_t) ((void *) (&acc_k + 1) - (void *) acc_k.replicas.devs));
+
+		bkey_fsck_err_on(!acc_k.replicas.nr_devs,
+				 c, accounting_key_replicas_nr_devs_0,
+				 "accounting key replicas entry with nr_devs=0");
+
+		bkey_fsck_err_on(acc_k.replicas.nr_required > acc_k.replicas.nr_devs ||
+				 (acc_k.replicas.nr_required > 1 &&
+				  acc_k.replicas.nr_required == acc_k.replicas.nr_devs),
+				 c, accounting_key_replicas_nr_required_bad,
+				 "accounting key replicas entry with bad nr_required");
+
+		for (unsigned i = 0; i + 1 < acc_k.replicas.nr_devs; i++)
+			bkey_fsck_err_on(acc_k.replicas.devs[i] != BCH_SB_MEMBER_INVALID &&
+					 acc_k.replicas.devs[i] >= acc_k.replicas.devs[i + 1],
+					 c, accounting_key_replicas_devs_unsorted,
+					 "accounting key replicas entry with unsorted devs");
+
+		end = (void *) &acc_k.replicas + replicas_entry_bytes(&acc_k.replicas);
+		break;
+	case BCH_DISK_ACCOUNTING_dev_data_type:
+		end = field_end(acc_k, dev_data_type);
+		break;
+	case BCH_DISK_ACCOUNTING_compression:
+		end = field_end(acc_k, compression);
+		break;
+	case BCH_DISK_ACCOUNTING_snapshot:
+		end = field_end(acc_k, snapshot);
+		break;
+	case BCH_DISK_ACCOUNTING_btree:
+		end = field_end(acc_k, btree);
+		break;
+	case BCH_DISK_ACCOUNTING_rebalance_work:
+		end = field_end(acc_k, rebalance_work);
+		break;
+	case BCH_DISK_ACCOUNTING_reconcile_work:
+		end = field_end(acc_k, reconcile_work);
+		break;
+	case BCH_DISK_ACCOUNTING_stripe_frag:
+		end = field_end(acc_k, stripe_frag);
+		break;
+	case BCH_DISK_ACCOUNTING_dev_stripe_frag:
+		end = field_end(acc_k, dev_stripe_frag);
+		break;
+	}
+
+	bkey_fsck_err_on(!is_zero(end, (void *) (&acc_k + 1)),
+			 c, accounting_key_junk_at_end,
+			 "junk at end of accounting key");
+
+	const unsigned nr_counters = bch2_accounting_counters(k.k);
+
+	bkey_fsck_err_on(!nr_counters || nr_counters > BCH_ACCOUNTING_MAX_COUNTERS,
+			 c, accounting_key_nr_counters_wrong,
+			 "accounting key with %u counters, should be %u",
+			 nr_counters, bch2_accounting_type_nr_counters[acc_k.type]);
+fsck_err:
+	return ret;
+}
+
+__cold void bch2_accounting_key_to_text(struct printbuf *out,
+				 struct bch_fs *c,
+				 struct disk_accounting_pos *k)
+{
+	if (k->type >= BCH_DISK_ACCOUNTING_TYPE_NR) {
+		prt_printf(out, "unknown type %u", k->type);
+		return;
+	}
+
+	prt_str(out, disk_accounting_type_strs[k->type]);
+	prt_str(out, " ");
+
+	switch (k->type) {
+	case BCH_DISK_ACCOUNTING_nr_inodes:
+		break;
+	case BCH_DISK_ACCOUNTING_persistent_reserved:
+		prt_printf(out, "replicas=%u", k->persistent_reserved.nr_replicas);
+		break;
+	case BCH_DISK_ACCOUNTING_replicas:
+		if (accounting_replicas_past_end(k))
+			prt_printf(out, "(replicas entry with %u devs runs past the end of the key)",
+				   k->replicas.nr_devs);
+		else
+			bch2_replicas_entry_to_text(out, &k->replicas);
+		break;
+	case BCH_DISK_ACCOUNTING_dev_data_type:
+		prt_printf(out, "dev=%u data_type=", k->dev_data_type.dev);
+		bch2_prt_data_type(out, k->dev_data_type.data_type);
+		break;
+	case BCH_DISK_ACCOUNTING_compression:
+		bch2_prt_compression_type(out, k->compression.type);
+		break;
+	case BCH_DISK_ACCOUNTING_snapshot:
+		prt_printf(out, "id=%u btree=", k->snapshot.id);
+		bch2_btree_id_to_text(out, k->snapshot.btree);
+		break;
+	case BCH_DISK_ACCOUNTING_btree:
+		prt_str(out, "btree=");
+		bch2_btree_id_to_text(out, k->btree.id);
+		break;
+	case BCH_DISK_ACCOUNTING_reconcile_work:
+		bch2_prt_reconcile_accounting_type(out, k->reconcile_work.type);
+		break;
+	case BCH_DISK_ACCOUNTING_stripe_frag:
+		prt_printf(out, "nr_empty=%u", k->stripe_frag.nr_empty);
+		break;
+	case BCH_DISK_ACCOUNTING_dev_stripe_frag:
+		prt_printf(out, "dev=%u", k->dev_stripe_frag.dev);
+		break;
+	case BCH_DISK_ACCOUNTING_dev_leaving: {
+		guard(rcu)();
+		guard(printbuf_atomic)(out);
+		struct bch_dev *ca = c ? bch2_dev_rcu_noerror(c, k->dev_leaving.dev) : NULL;
+		if (ca)
+			prt_printf(out, "%s ", ca->name);
+		else
+			prt_printf(out, "%u ", k->dev_leaving.dev);
+		break;
+	}
+	}
+}
+
+__cold void bch2_accounting_to_text(struct printbuf *out, struct bch_fs *c, struct bkey_s_c k)
+{
+	struct bkey_s_c_accounting acc = bkey_s_c_to_accounting(k);
+	struct disk_accounting_pos acc_k;
+	bpos_to_disk_accounting_pos(&acc_k, k.k->p);
+
+	bch2_accounting_key_to_text(out, c, &acc_k);
+
+	for (unsigned i = 0; i < bch2_accounting_counters(k.k); i++)
+		prt_printf(out, " %lli", acc.v->d[i]);
+}
+
+void bch2_accounting_swab(const struct bch_fs *c, struct bkey_s k)
+{
+	for (u64 *p = (u64 *) k.v;
+	     p < (u64 *) bkey_val_end(k);
+	     p++)
+		*p = swab64(*p);
+}
+
+static inline void __accounting_to_replicas(struct bch_replicas_entry_v1 *r,
+					    struct disk_accounting_pos *acc)
+{
+	unsafe_memcpy(r, &acc->replicas,
+		      replicas_entry_bytes(&acc->replicas),
+		      "variable length struct");
+}
+
+static inline bool accounting_to_replicas(struct bch_replicas_entry_v1 *r, struct bpos p)
+{
+	struct disk_accounting_pos acc_k;
+	bpos_to_disk_accounting_pos(&acc_k, p);
+
+	switch (acc_k.type) {
+	case BCH_DISK_ACCOUNTING_replicas:
+		__accounting_to_replicas(r, &acc_k);
+		return true;
+	default:
+		return false;
+	}
+}
+
+static int bch2_accounting_update_sb_one(struct bch_fs *c, struct bpos p)
+{
+	union bch_replicas_padded r;
+	return accounting_to_replicas(&r.e, p)
+		? bch2_mark_replicas(c, &r.e)
+		: 0;
+}
+
+/*
+ * Ensure accounting keys being updated are present in the superblock, when
+ * applicable (i.e. replicas updates)
+ */
+int bch2_accounting_update_sb(struct btree_trans *trans)
+{
+	for (struct bkey_i *i = btree_trans_subbuf_base(trans, &trans->accounting);
+	     i != btree_trans_subbuf_top(trans, &trans->accounting);
+	     i = bkey_next(i))
+		try(bch2_accounting_update_sb_one(trans->c, i->k.p));
+
+	return 0;
+}
+
+static int __bch2_accounting_mem_insert(struct bch_fs *c, struct bkey_s_c_accounting a)
+{
+	struct bch_accounting_mem *acc = &c->accounting;
+
+	/* raced with another insert, already present: */
+	if (eytzinger0_find(acc->k.data, acc->k.nr, sizeof(acc->k.data[0]),
+			    accounting_pos_cmp, &a.k->p) < acc->k.nr)
+		return 0;
+
+	struct disk_accounting_pos acc_k;
+	bpos_to_disk_accounting_pos(&acc_k, a.k->p);
+
+	struct accounting_mem_entry n = {
+		.pos		= a.k->p,
+		.bversion	= a.k->bversion,
+		.nr_counters	= bch2_accounting_type_nr_counters[acc_k.type],
+		.v[0]		= __alloc_percpu_gfp(n.nr_counters * sizeof(u64),
+						     sizeof(u64), GFP_KERNEL),
+	};
+
+	if (!n.v[0])
+		goto err;
+
+	if (acc->gc_running) {
+		n.v[1] = __alloc_percpu_gfp(n.nr_counters * sizeof(u64),
+					    sizeof(u64), GFP_KERNEL);
+		if (!n.v[1])
+			goto err;
+	}
+
+	if (darray_push(&acc->k, n))
+		goto err;
+
+	eytzinger0_sort(acc->k.data, acc->k.nr, sizeof(acc->k.data[0]),
+			accounting_pos_cmp, NULL);
+
+	event_trace(c, accounting_mem_insert, buf, ({
+		prt_printf(&buf, "entries %zu added ", c->accounting.k.nr);
+		bch2_accounting_to_text(&buf, c, a.s_c);
+	}));
+
+	return 0;
+err:
+	free_percpu(n.v[1]);
+	free_percpu(n.v[0]);
+	return bch_err_throw(c, ENOMEM_disk_accounting);
+}
+
+int bch2_accounting_mem_insert(struct bch_fs *c, struct bkey_s_c_accounting a,
+			       enum bch_accounting_mode mode)
+{
+	/*
+	 * Raw of the inner rwsem: our caller holds mark_lock read via
+	 * percpu_read_noio, so PF_MEMALLOC_NOIO stays set across this temporary
+	 * upgrade to write - the raw up/down only move the lock, not the
+	 * memalloc scope.
+	 *
+	 * The replicas entry is checked for under the write lock, not before:
+	 * between up_read and down_write replicas gc can drop it, as nothing in
+	 * memory references it until this insert.
+	 */
+	percpu_up_read(&c->capacity.mark_lock.lock);
+	int ret;
+	scoped_guard(percpu_write_noio, &c->capacity.mark_lock)
+		ret = bch2_accounting_mem_insert_locked(c, a, mode);
+	percpu_down_read(&c->capacity.mark_lock.lock);
+	return ret;
+}
+
+int bch2_accounting_mem_insert_locked(struct bch_fs *c, struct bkey_s_c_accounting a,
+			       enum bch_accounting_mode mode)
+{
+	union bch_replicas_padded r;
+
+	if (mode != BCH_ACCOUNTING_read &&
+	    accounting_to_replicas(&r.e, a.k->p) &&
+	    !bch2_replicas_marked(c, &r.e))
+		return bch_err_throw(c, btree_insert_need_mark_replicas);
+
+	return __bch2_accounting_mem_insert(c, a);
+}
+
+static bool accounting_mem_entry_is_zero(struct accounting_mem_entry *e)
+{
+	for (unsigned i = 0; i < e->nr_counters; i++)
+		if (percpu_u64_get(e->v[0] + i) ||
+		    (e->v[1] &&
+		     percpu_u64_get(e->v[1] + i)))
+			return false;
+	return true;
+}
+
+void __bch2_accounting_maybe_kill(struct bch_fs *c, struct bpos pos)
+{
+	struct disk_accounting_pos acc_k;
+	bpos_to_disk_accounting_pos(&acc_k, pos);
+
+	if (acc_k.type != BCH_DISK_ACCOUNTING_replicas)
+		return;
+
+	if (acc_k.replicas.data_type > BCH_DATA_btree &&
+	    !bch2_request_incompat_feature(c, bcachefs_metadata_version_no_sb_user_data_replicas))
+		return;
+
+	guard(mutex_noio)(&c->sb_lock);
+	scoped_guard(percpu_write_noio, &c->capacity.mark_lock) {
+
+		struct bch_accounting_mem *acc = &c->accounting;
+
+		unsigned idx = eytzinger0_find(acc->k.data, acc->k.nr, sizeof(acc->k.data[0]),
+					       accounting_pos_cmp, &pos);
+		if (idx >= acc->k.nr)
+			return;
+
+		struct accounting_mem_entry *e = acc->k.data + idx;
+		if (!accounting_mem_entry_is_zero(e))
+			return;
+
+		free_percpu(e->v[0]);
+		free_percpu(e->v[1]);
+
+		swap(*e, darray_last(acc->k));
+		--acc->k.nr;
+		eytzinger0_sort(acc->k.data, acc->k.nr, sizeof(acc->k.data[0]),
+				accounting_pos_cmp, NULL);
+
+		bch2_replicas_entry_kill(c, &acc_k.replicas);
+	}
+
+	bch2_write_super(c);
+}
+
+void bch2_accounting_mem_gc(struct bch_fs *c)
+{
+	struct bch_accounting_mem *acc = &c->accounting;
+
+	guard(percpu_write_noio)(&c->capacity.mark_lock);
+	struct accounting_mem_entry *dst = acc->k.data;
+
+	darray_for_each(acc->k, src) {
+		if (accounting_mem_entry_is_zero(src)) {
+			free_percpu(src->v[0]);
+			free_percpu(src->v[1]);
+		} else {
+			*dst++ = *src;
+		}
+	}
+
+	acc->k.nr = dst - acc->k.data;
+	eytzinger0_sort(acc->k.data, acc->k.nr, sizeof(acc->k.data[0]),
+			accounting_pos_cmp, NULL);
+}
+
+/*
+ * Read out accounting keys for replicas entries, as an array of
+ * bch_replicas_usage entries.
+ *
+ * Note: this may be deprecated/removed at smoe point in the future and replaced
+ * with something more general, it exists to support the ioctl used by the
+ * 'bcachefs fs usage' command.
+ */
+int bch2_fs_replicas_usage_read(struct bch_fs *c, darray_char *usage)
+{
+	struct bch_accounting_mem *acc = &c->accounting;
+
+	guard(percpu_read_noio)(&c->capacity.mark_lock);
+	darray_for_each(acc->k, i) {
+		union {
+			u8 bytes[struct_size_t(struct bch_replicas_usage, r.devs,
+					       BCH_BKEY_PTRS_MAX)];
+			struct bch_replicas_usage r;
+		} u;
+		u.r.r.nr_devs = BCH_BKEY_PTRS_MAX;
+
+		if (!accounting_to_replicas(&u.r.r, i->pos))
+			continue;
+
+		u64 sectors;
+		bch2_accounting_mem_read_counters(acc, i - acc->k.data, &sectors, 1, false);
+		u.r.sectors = sectors;
+
+		try(darray_make_room(usage, replicas_usage_bytes(&u.r)));
+
+		memcpy(&darray_top(*usage), &u.r, replicas_usage_bytes(&u.r));
+		usage->nr += replicas_usage_bytes(&u.r);
+	}
+
+	return 0;
+}
+
+int bch2_fs_accounting_read(struct bch_fs *c, darray_char *out_buf, unsigned accounting_types_mask)
+{
+
+	struct bch_accounting_mem *acc = &c->accounting;
+
+	darray_init(out_buf);
+
+	guard(percpu_read_noio)(&c->capacity.mark_lock);
+	darray_for_each(acc->k, i) {
+		struct disk_accounting_pos a_p;
+		bpos_to_disk_accounting_pos(&a_p, i->pos);
+
+		if (!(accounting_types_mask & BIT(a_p.type)))
+			continue;
+
+		try(darray_make_room(out_buf, sizeof(struct bkey_i_accounting) +
+				     sizeof(u64) * i->nr_counters));
+
+		struct bkey_i_accounting *a_out =
+			bkey_accounting_init((void *) &darray_top(*out_buf));
+		set_bkey_val_u64s(&a_out->k, i->nr_counters);
+		a_out->k.p = i->pos;
+		bch2_accounting_mem_read_counters(acc, i - acc->k.data,
+						  a_out->v.d, i->nr_counters, false);
+
+		if (!bch2_accounting_key_is_zero(accounting_i_to_s_c(a_out)))
+			out_buf->nr += bkey_bytes(&a_out->k);
+	}
+
+	return 0;
+}
+
+int bch2_fs_accounting_read_key(struct btree_trans *trans,
+				struct disk_accounting_pos *acc_k, u64 *v, unsigned nr)
+{
+	memset(v, 0, sizeof(*v) * nr);
+
+	struct bpos p = disk_accounting_pos_to_bpos(acc_k);
+
+	if (bch2_accounting_is_mem(acc_k)) {
+		bch2_accounting_mem_read(trans->c, p, v, nr);
+		return 0;
+	}
+
+	CLASS(btree_iter, iter)(trans, BTREE_ID_accounting, p, 0);
+	struct bkey_s_c k = bkey_try(bch2_btree_iter_peek_slot(&iter));
+
+	if (k.k->type == KEY_TYPE_accounting) {
+		struct bkey_s_c_accounting a = bkey_s_c_to_accounting(k);
+
+		for (unsigned i = 0; i < min(nr, bch2_accounting_counters(a.k)); i++)
+			v[i] = a.v->d[i];
+	}
+
+	return 0;
+}
+
+static void bch2_accounting_free_counters(struct bch_accounting_mem *acc, bool gc)
+{
+	darray_for_each(acc->k, e) {
+		free_percpu(e->v[gc]);
+		e->v[gc] = NULL;
+	}
+}
+
+int bch2_gc_accounting_start(struct bch_fs *c)
+{
+	struct bch_accounting_mem *acc = &c->accounting;
+	int ret = 0;
+
+	guard(percpu_write_noio)(&c->capacity.mark_lock);
+
+	darray_for_each(acc->k, e) {
+		e->v[1] = __alloc_percpu_gfp(e->nr_counters * sizeof(u64),
+					     sizeof(u64), GFP_KERNEL);
+		if (!e->v[1]) {
+			bch2_accounting_free_counters(acc, true);
+			ret = bch_err_throw(c, ENOMEM_disk_accounting);
+			break;
+		}
+	}
+
+	acc->gc_running = !ret;
+	return ret;
+}
+
+int bch2_gc_accounting_done(struct bch_fs *c)
+{
+	struct bch_accounting_mem *acc = &c->accounting;
+	CLASS(btree_trans, trans)(c);
+	CLASS(printbuf, buf)();
+	struct bpos pos = POS_MIN;
+	int ret = 0;
+
+	guard(percpu_write_noio)(&c->capacity.mark_lock);
+
+	while (1) {
+		unsigned idx = eytzinger0_find_ge(acc->k.data, acc->k.nr, sizeof(acc->k.data[0]),
+						  accounting_pos_cmp, &pos);
+
+		if (idx >= acc->k.nr)
+			break;
+
+		struct accounting_mem_entry *e = acc->k.data + idx;
+		pos = bpos_successor(e->pos);
+
+		struct disk_accounting_pos acc_k;
+		bpos_to_disk_accounting_pos(&acc_k, e->pos);
+
+		if (acc_k.type >= BCH_DISK_ACCOUNTING_TYPE_NR)
+			continue;
+
+		u64 src_v[BCH_ACCOUNTING_MAX_COUNTERS];
+		u64 dst_v[BCH_ACCOUNTING_MAX_COUNTERS];
+
+		unsigned nr = e->nr_counters;
+		bch2_accounting_mem_read_counters(acc, idx, dst_v, nr, false);
+		bch2_accounting_mem_read_counters(acc, idx, src_v, nr, true);
+
+		if (memcmp(dst_v, src_v, nr * sizeof(u64))) {
+			printbuf_reset(&buf);
+			prt_str(&buf, "accounting mismatch for ");
+			bch2_accounting_key_to_text(&buf, c, &acc_k);
+
+			prt_str(&buf, ":\n      got");
+			for (unsigned j = 0; j < nr; j++)
+				prt_printf(&buf, " %llu", dst_v[j]);
+
+			prt_str(&buf,  "\nshould be");
+			for (unsigned j = 0; j < nr; j++)
+				prt_printf(&buf, " %llu", src_v[j]);
+
+			for (unsigned j = 0; j < nr; j++)
+				src_v[j] -= dst_v[j];
+
+			bch2_trans_unlock_long(trans);
+
+			if (fsck_err(c, accounting_mismatch, "%s", buf.buf)) {
+				/*
+				 * Raw drop/retake of just the lock to run
+				 * commit_do: the guard(percpu_write_noio) at the
+				 * top of the function keeps PF_MEMALLOC_NOIO set
+				 * the whole time, even though the trans was
+				 * unlocked above.
+				 */
+				percpu_up_write(&c->capacity.mark_lock.lock);
+				ret = commit_do(trans, NULL, NULL,
+						BCH_TRANS_COMMIT_skip_accounting_apply,
+						bch2_disk_accounting_mod(trans, &acc_k, src_v, nr, false));
+				percpu_down_write(&c->capacity.mark_lock.lock);
+				if (ret)
+					goto err;
+
+				if (!test_bit(BCH_FS_may_go_rw, &c->flags)) {
+					memset(&trans->fs_usage_delta, 0, sizeof(trans->fs_usage_delta));
+					struct { __BKEY_PADDED(k, BCH_ACCOUNTING_MAX_COUNTERS); } k_i;
+
+					accounting_key_init(&k_i.k, &acc_k, src_v, nr);
+					bch2_accounting_mem_add(trans,
+								bkey_i_to_s_c_accounting(&k_i.k),
+								BCH_ACCOUNTING_normal, true);
+
+					guard(preempt)();
+					struct bch_fs_usage_base *dst = &this_cpu_ptr(c->capacity.pcpu)->usage;
+					struct bch_fs_usage_base *src = &trans->fs_usage_delta;
+					acc_u64s((u64 *) dst, (u64 *) src, sizeof(*src) / sizeof(u64));
+				}
+			}
+		}
+	}
+err:
+fsck_err:
+	bch_err_fn(c, ret);
+	return ret;
+}
+
+static int accounting_read_key(struct btree_trans *trans, struct bkey_s_c k)
+{
+	struct bch_fs *c = trans->c;
+
+	if (k.k->type != KEY_TYPE_accounting)
+		return 0;
+
+	struct disk_accounting_pos acc_k;
+	bpos_to_disk_accounting_pos(&acc_k, k.k->p);
+
+	if (acc_k.type == BCH_DISK_ACCOUNTING_replicas &&
+	    !bch2_accounting_key_is_zero(bkey_s_c_to_accounting(k))) {
+		unsigned flags = 0;
+		switch (c->opts.degraded) {
+		case BCH_DEGRADED_very:
+			flags |= BCH_FORCE_IF_DEGRADED|BCH_FORCE_IF_LOST;
+			break;
+		case BCH_DEGRADED_yes:
+			flags |= BCH_FORCE_IF_DEGRADED;
+			break;
+		}
+
+		CLASS(printbuf, buf)();
+		if (!bch2_can_read_replicas_with_devs(c, &c->devs_online, &acc_k.replicas, flags, &buf)) {
+			bch2_missing_devs_to_text(&buf, c);
+			bch2_print_str_loglevel(c, LOGLEVEL_err, buf.buf);
+			return bch_err_throw(c, insufficient_devices_to_start);
+		}
+	}
+
+	if (!bch2_accounting_is_mem(&acc_k))
+		return 0;
+
+	struct bch_accounting_mem *acc = &c->accounting;
+	struct bkey_s_c_accounting a = bkey_s_c_to_accounting(k);
+	unsigned nr = bch2_accounting_counters(k.k);
+
+	/* Caller holds percpu_write on mark_lock */
+
+	/*
+	 * Accumulate into last entry if same bpos - this happens when both
+	 * btree and journal keys exist for the same accounting entry
+	 * (journal key = delta on top of btree base value).
+	 *
+	 * The btree/journal walk in bch2_accounting_read() processes keys
+	 * in bpos order, so duplicates are always adjacent.
+	 */
+	if (acc->k.nr && bpos_eq(darray_last(acc->k).pos, a.k->p)) {
+		struct accounting_mem_entry *e = &darray_last(acc->k);
+		nr = min_t(unsigned, nr, e->nr_counters);
+		for (unsigned i = 0; i < nr; i++)
+			percpu_u64_set(e->v[0] + i,
+				       percpu_u64_get(e->v[0] + i) + a.v->d[i]);
+		return 0;
+	}
+
+	struct accounting_mem_entry n = {
+		.pos		= a.k->p,
+		.bversion	= a.k->bversion,
+		.nr_counters	= bch2_accounting_type_nr_counters[acc_k.type],
+	};
+
+	n.v[0] = __alloc_percpu_gfp(n.nr_counters * sizeof(u64),
+				     sizeof(u64), GFP_KERNEL);
+	if (!n.v[0])
+		return bch_err_throw(c, ENOMEM_disk_accounting);
+
+	if (darray_push(&acc->k, n)) {
+		free_percpu(n.v[0]);
+		return bch_err_throw(c, ENOMEM_disk_accounting);
+	}
+
+	struct accounting_mem_entry *e = &darray_last(acc->k);
+	nr = min_t(unsigned, nr, e->nr_counters);
+	for (unsigned i = 0; i < nr; i++)
+		percpu_u64_set(e->v[0] + i, a.v->d[i]);
+
+	return 0;
+}
+
+static int disk_accounting_invalid_dev(struct btree_trans *trans,
+				       struct disk_accounting_pos *acc,
+				       u64 *v, unsigned nr,
+				       unsigned dev)
+{
+	CLASS(printbuf, buf)();
+	bch2_accounting_key_to_text(&buf, trans->c, acc);
+
+	if (ret_fsck_err(trans, accounting_to_invalid_device,
+		     "accounting entry points to invalid device %u\n%s",
+		     dev, buf.buf)) {
+		bch2_u64s_neg(v, nr);
+
+		return  bch2_disk_accounting_mod(trans, acc, v, nr, false) ?:
+			bch2_trans_commit(trans, NULL, NULL, BCH_TRANS_COMMIT_no_enospc) ?:
+			-BCH_ERR_remove_disk_accounting_entry;
+	} else {
+		return bch_err_throw(trans->c, remove_disk_accounting_entry);
+	}
+}
+
+static int bch2_disk_accounting_validate_late(struct btree_trans *trans,
+					      struct disk_accounting_pos *acc,
+					      u64 *v, unsigned nr)
+{
+	struct bch_fs *c = trans->c;
+	CLASS(printbuf, buf)();
+	int ret = 0;
+
+	switch (acc->type) {
+	case BCH_DISK_ACCOUNTING_replicas: {
+		union bch_replicas_padded r;
+		__accounting_to_replicas(&r.e, acc);
+
+		for (unsigned i = 0; i < r.e.nr_devs; i++)
+			if (r.e.devs[i] != BCH_SB_MEMBER_INVALID &&
+			    !bch2_dev_exists(c, r.e.devs[i]))
+				return disk_accounting_invalid_dev(trans, acc, v, nr, r.e.devs[i]);
+
+		/*
+		 * All replicas entry checks except for invalid device are done
+		 * in bch2_accounting_validate
+		 */
+		BUG_ON(bch2_replicas_entry_validate(&r.e, c, &buf));
+
+		if (fsck_err_on(!bch2_replicas_marked(c, &r.e),
+				trans, accounting_replicas_not_marked,
+				"accounting not marked in superblock replicas\n%s",
+				(printbuf_reset(&buf),
+				 bch2_accounting_key_to_text(&buf, c, acc),
+				 buf.buf))) {
+			try(bch2_mark_replicas(c, &r.e));
+			/*
+			 * bch2_mark_replicas() updates the superblock, not the
+			 * transaction, so commit here to flush the fsck_err log
+			 * entry - the caller loops back into a lockrestart_do
+			 * whose trans_begin would otherwise discard it.
+			 */
+			try(bch2_trans_commit(trans, NULL, NULL, BCH_TRANS_COMMIT_no_enospc));
+		}
+		break;
+	}
+
+	case BCH_DISK_ACCOUNTING_dev_data_type:
+		if (!bch2_dev_exists(c, acc->dev_data_type.dev))
+			return disk_accounting_invalid_dev(trans, acc, v, nr,
+							   acc->dev_data_type.dev);
+		break;
+	}
+
+fsck_err:
+	return ret;
+}
+
+static struct journal_key *accumulate_newer_accounting_keys(struct btree_trans *trans, struct journal_key *i)
+{
+	struct bch_fs *c = trans->c;
+	struct journal_keys *keys = &c->journal_keys;
+	struct bkey_i *k = journal_key_k(c, i);
+	int ret = 0;
+
+	darray_for_each_from(*keys, j, i + 1) {
+		if (journal_key_cmp(c, i, j))
+			return j;
+
+		struct bkey_i *n = journal_key_k(c, j);
+		if (n->k.type == KEY_TYPE_accounting) {
+			if (bversion_cmp(k->k.bversion, n->k.bversion) >= 0) {
+				CLASS(printbuf, buf)();
+				prt_printf(&buf, "accounting keys with out of order versions:");
+
+				prt_newline(&buf);
+				prt_printf(&buf, "%u.%u ", i->journal_seq_offset, i->journal_offset);
+				bch2_bkey_val_to_text(&buf, c, bkey_i_to_s_c(k));
+				prt_newline(&buf);
+				prt_printf(&buf, "%u.%u ", j->journal_seq_offset, j->journal_offset);
+				bch2_bkey_val_to_text(&buf, c, bkey_i_to_s_c(n));
+				fsck_err(trans, accounting_key_version_out_of_order, "%s", buf.buf);
+			}
+
+			bch2_accounting_accumulate(bkey_i_to_accounting(k),
+						   bkey_i_to_s_c_accounting(n));
+			j->overwritten = true;
+		}
+	}
+
+	return &darray_top(*keys);
+fsck_err:
+	return ERR_PTR(ret);
+}
+
+static struct journal_key *accumulate_and_read_journal_accounting(struct btree_trans *trans, struct journal_key *i)
+{
+	struct journal_key *next = accumulate_newer_accounting_keys(trans, i);
+
+	int ret = PTR_ERR_OR_ZERO(next) ?:
+		accounting_read_key(trans, bkey_i_to_s_c(journal_key_k(trans->c, i)));
+	return ret ? ERR_PTR(ret) : next;
+}
+
+static void accounting_key_check_sanity(struct printbuf *out, struct bch_fs *c,
+					struct disk_accounting_pos *k,
+					u64 *v, unsigned nr_counters)
+{
+	/* Ratelimit... */
+	if (out->pos > 2048)
+		return;
+
+	/*
+	 * Check for underflow, schedule check_allocations necessary:
+	 *
+	 * XXX - see if we can factor this out to run on a bkey
+	 * so we can check everything lazily, right now we don't
+	 * check the non in-mem counters at all
+	 */
+
+	for (unsigned i = 0; i < nr_counters; i++)
+		if ((s64) v[i] < 0) {
+			prt_printf(out, "Accounting underflow for\n");
+			bch2_accounting_key_to_text(out, c, k);
+
+			for (unsigned i = 0; i < nr_counters; i++)
+				prt_printf(out, " %lli", v[i]);
+			prt_newline(out);
+			out->suppress = false;
+		}
+}
+
+static int accounting_read_mem_fixups(struct btree_trans *trans)
+{
+	struct bch_fs *c = trans->c;
+	struct bch_accounting_mem *acc = &c->accounting;
+
+	/*
+	 * Filter zeroed/invalid entries with an in-place forward pass.
+	 *
+	 * We previously did this reverse-iterating + darray_remove_item per
+	 * dropped entry, which is O(N*R) memmove (each remove shifts the tail
+	 * back). On large arrays the replicas table grows combinatorially with
+	 * device count, and many entries come back zero on read, so the cost
+	 * was dominating mount time on big multi-device filesystems.
+	 *
+	 * Caller (bch2_accounting_read) has already sorted acc->k; forward
+	 * filter preserves that order.
+	 */
+	struct accounting_mem_entry *src = acc->k.data;
+	struct accounting_mem_entry *dst = acc->k.data;
+	struct accounting_mem_entry *end = acc->k.data + acc->k.nr;
+	int ret = 0;
+
+	while (src < end) {
+		struct disk_accounting_pos acc_k;
+		bpos_to_disk_accounting_pos(&acc_k, src->pos);
+
+		u64 v[BCH_ACCOUNTING_MAX_COUNTERS];
+		memset(v, 0, sizeof(v));
+
+		for (unsigned j = 0; j < src->nr_counters; j++)
+			v[j] = percpu_u64_get(src->v[0] + j);
+
+		/*
+		 * If the entry counters are zeroed, it should be treated as
+		 * nonexistent - it might point to an invalid device.
+		 *
+		 * Drop it, so that if it's re-added it gets re-marked in the
+		 * superblock:
+		 */
+		ret = bch2_is_zero(v, sizeof(v[0]) * src->nr_counters)
+			? -BCH_ERR_remove_disk_accounting_entry
+			: lockrestart_do(trans,
+				bch2_disk_accounting_validate_late(trans, &acc_k, v, src->nr_counters));
+
+		if (ret == -BCH_ERR_remove_disk_accounting_entry) {
+			free_percpu(src->v[0]);
+			free_percpu(src->v[1]);
+			src++;
+			ret = 0;
+			continue;
+		}
+
+		if (dst != src)
+			*dst = *src;
+		dst++;
+		src++;
+
+		if (ret)
+			break;
+	}
+
+	/*
+	 * On error: shift unprocessed tail down so the array stays a
+	 * contiguous run of valid entries. Avoids leaking percpu storage on
+	 * any retry path that reads acc->k.nr.
+	 */
+	while (src < end) {
+		if (dst != src)
+			*dst = *src;
+		dst++;
+		src++;
+	}
+
+	acc->k.nr = dst - acc->k.data;
+
+	if (ret)
+		return ret;
+
+	eytzinger0_sort(acc->k.data, acc->k.nr, sizeof(acc->k.data[0]),
+			accounting_pos_cmp, NULL);
+
+	CLASS(bch_log_msg, underflow_err)(c);
+	underflow_err.m.suppress = true;
+
+	for (unsigned i = 0; i < acc->k.nr; i++) {
+		struct disk_accounting_pos k;
+		bpos_to_disk_accounting_pos(&k, acc->k.data[i].pos);
+
+		u64 v[BCH_ACCOUNTING_MAX_COUNTERS];
+		bch2_accounting_mem_read_counters(acc, i, v, ARRAY_SIZE(v), false);
+
+		accounting_key_check_sanity(&underflow_err.m, c, &k, v, acc->k.data[i].nr_counters);
+
+		guard(preempt)();
+		struct bch_fs_usage_base *usage = &this_cpu_ptr(c->capacity.pcpu)->usage;
+
+		switch (k.type) {
+		case BCH_DISK_ACCOUNTING_persistent_reserved:
+			usage->reserved += v[0] * k.persistent_reserved.nr_replicas;
+			break;
+		case BCH_DISK_ACCOUNTING_replicas:
+			fs_usage_data_type_to_base(usage, k.replicas.data_type, v[0]);
+			break;
+		case BCH_DISK_ACCOUNTING_dev_data_type: {
+			guard(rcu)();
+			struct bch_dev *ca = bch2_dev_rcu_noerror(c, k.dev_data_type.dev);
+			if (ca) {
+				struct bch_dev_usage_type __percpu *d = &ca->usage->d[k.dev_data_type.data_type];
+				percpu_u64_set(&d->buckets,	v[0]);
+				percpu_u64_set(&d->sectors,	v[1]);
+				percpu_u64_set(&d->fragmented,	v[2]);
+
+				if (k.dev_data_type.data_type == BCH_DATA_sb ||
+				    k.dev_data_type.data_type == BCH_DATA_journal)
+					usage->hidden += v[0] * ca->mi.bucket_size;
+			}
+			break;
+		}
+		}
+	}
+
+	if (!underflow_err.m.suppress) {
+		bch2_count_fsck_err(c, accounting_key_underflow, &underflow_err.m);
+		try(bch2_run_explicit_recovery_pass(c, &underflow_err.m,
+						    BCH_RECOVERY_PASS_check_allocations, 0));
+	}
+
+	return 0;
+}
+
+/*
+ * At startup time, initialize the in memory accounting from the btree (and
+ * journal)
+ */
+int bch2_accounting_read(struct bch_fs *c)
+{
+	struct bch_accounting_mem *acc = &c->accounting;
+	CLASS(btree_trans, trans)(c);
+	CLASS(printbuf, buf)();
+
+	/*
+	 * We might run more than once if we rewind to start topology repair or
+	 * btree node scan - and those might cause us to get different results,
+	 * so we can't just skip if we've already run.
+	 *
+	 * Free and re-initialize accounting - entries are appended unsorted
+	 * during the read and sorted once at the end, so we need a clean slate.
+	 */
+	bch2_accounting_free_counters(acc, false);
+	acc->k.nr = 0;
+	for_each_member_device(c, ca)
+		percpu_memset(ca->usage, 0, sizeof(*ca->usage));
+	percpu_memset(&c->capacity.pcpu->usage, 0, sizeof(struct bch_fs_usage_base));
+
+	struct journal_keys *keys = &c->journal_keys;
+	struct journal_key *jk = keys->data;
+
+	move_gap(keys, keys->nr);
+
+	/* Find the range of accounting keys from the journal: */
+
+	while (jk < &darray_top(*keys) &&
+	       __journal_key_cmp(c, BTREE_ID_accounting, 0, POS_MIN, jk) > 0)
+		jk++;
+
+	struct journal_key *end = jk;
+	while (end < &darray_top(*keys) &&
+	       __journal_key_cmp(c, BTREE_ID_accounting, 0, SPOS_MAX, end) > 0)
+		end++;
+
+	/*
+	 * Iterate over btree and journal accounting simultaneously:
+	 *
+	 * We want to drop unneeded unneeded accounting deltas early - deltas
+	 * that are older than the btree accounting key version, and once we've
+	 * dropped old accounting deltas we can accumulate and compact deltas
+	 * for the same key:
+	 */
+
+	CLASS(btree_iter, iter)(trans, BTREE_ID_accounting, POS_MIN,
+				BTREE_ITER_prefetch|BTREE_ITER_all_snapshots);
+	iter.flags &= ~BTREE_ITER_with_journal;
+	try(for_each_btree_key_continue(trans, iter,
+				BTREE_ITER_prefetch|BTREE_ITER_all_snapshots, k, ({
+		if (k.k->type != KEY_TYPE_accounting)
+			continue;
+
+		while (jk < end &&
+		       __journal_key_cmp(c, BTREE_ID_accounting, 0, k.k->p, jk) > 0)
+			jk = accumulate_and_read_journal_accounting(trans, jk);
+
+		while (jk < end &&
+		       __journal_key_cmp(c, BTREE_ID_accounting, 0, k.k->p, jk) == 0 &&
+		       bversion_cmp(journal_key_k(c, jk)->k.bversion, k.k->bversion) <= 0) {
+			jk->overwritten = true;
+			jk++;
+		}
+
+		if (jk < end &&
+		    __journal_key_cmp(c, BTREE_ID_accounting, 0, k.k->p, jk) == 0)
+			jk = accumulate_and_read_journal_accounting(trans, jk);
+
+		struct disk_accounting_pos acc_k;
+		bpos_to_disk_accounting_pos(&acc_k, k.k->p);
+
+		if (acc_k.type >= BCH_DISK_ACCOUNTING_TYPE_NR)
+			break;
+
+		if (!bch2_accounting_is_mem(&acc_k)) {
+			struct disk_accounting_pos next_acc;
+			memset(&next_acc, 0, sizeof(next_acc));
+			next_acc.type = acc_k.type + 1;
+			struct bpos next = disk_accounting_pos_to_bpos(&next_acc);
+			if (jk < end)
+				next = bpos_min(next, journal_key_k(c, jk)->k.p);
+
+			/*
+			 * for_each_btree_key() will still advance iterator - in
+			 * Rust, LoopFlow::ContinueFrom(next), which resumes at next:
+			 */
+			bch2_btree_iter_set_pos(&iter, bpos_predecessor(next));
+			continue;
+		}
+
+		accounting_read_key(trans, k);
+	})));
+
+	while (jk < end)
+		jk = accumulate_and_read_journal_accounting(trans, jk);
+
+	bch2_trans_unlock(trans);
+
+	struct journal_key *dst = keys->data;
+	darray_for_each(*keys, i)
+		if (!i->overwritten)
+			*dst++ = *i;
+	keys->gap = keys->nr = dst - keys->data;
+
+	/*
+	 * Entries were inserted unsorted during the btree/journal walk above.
+	 * Sort now, before fixups which may need eytzinger lookups.
+	 */
+	eytzinger0_sort(acc->k.data, acc->k.nr, sizeof(acc->k.data[0]),
+			accounting_pos_cmp, NULL);
+
+	/* Assert no duplicates - the btree/journal walk must produce unique keys */
+	struct bpos prev;
+	bool have_prev = false;
+	eytzinger0_for_each(i, acc->k.nr) {
+		BUG_ON(have_prev && bpos_cmp(prev, acc->k.data[i].pos) >= 0);
+		prev = acc->k.data[i].pos;
+		have_prev = true;
+	}
+
+	/*
+	 * accounting_read_mem_fixups() does transaction commits to
+	 * fix invalid accounting entries, so we can't hold mark_lock
+	 * across it - the commit path takes mark_lock itself.
+	 */
+	return accounting_read_mem_fixups(trans);
+}
+
+int bch2_dev_usage_remove(struct bch_fs *c, struct bch_dev *ca)
+{
+	CLASS(btree_trans, trans)(c);
+
+	struct disk_accounting_pos start;
+	disk_accounting_key_init(start, dev_data_type, .dev = ca->dev_idx);
+
+	struct disk_accounting_pos end;
+	disk_accounting_key_init(end, dev_data_type, .dev = ca->dev_idx, .data_type = U8_MAX);
+
+	return bch2_btree_write_buffer_flush_sync(trans) ?:
+		commit_do(trans, NULL, NULL, 0, ({
+			struct bkey_s_c k;
+			int ret = 0;
+
+			for_each_btree_key_max_norestart(trans, iter, BTREE_ID_accounting,
+							 disk_accounting_pos_to_bpos(&start),
+							 disk_accounting_pos_to_bpos(&end),
+							 BTREE_ITER_all_snapshots, k, ret) {
+				if (k.k->type != KEY_TYPE_accounting)
+					continue;
+
+				struct disk_accounting_pos acc;
+				bpos_to_disk_accounting_pos(&acc, k.k->p);
+
+				const unsigned nr = bch2_accounting_counters(k.k);
+				u64 v[BCH_ACCOUNTING_MAX_COUNTERS];
+				memcpy_u64s_small(v, bkey_s_c_to_accounting(k).v->d, nr);
+
+				bch2_u64s_neg(v, nr);
+
+				ret = bch2_disk_accounting_mod(trans, &acc, v, nr, false);
+				if (ret)
+					break;
+			}
+
+			ret;
+	})) ?: bch2_btree_write_buffer_flush_sync(trans);
+}
+
+int bch2_dev_usage_init(struct bch_dev *ca, bool gc)
+{
+	struct bch_fs *c = ca->fs;
+	CLASS(btree_trans, trans)(c);
+	int ret = lockrestart_do(trans, ({
+		/*
+		 * Set, not add: subtract whatever's currently accounted so the
+		 * free count lands at exactly nbuckets. This makes
+		 * dev_usage_init idempotent, so it's safe to re-run when a
+		 * half-finished device add is resumed during recovery.
+		 *
+		 * gc accounting is rebuilt from a cleared state, and read_key2
+		 * only sees the non-gc counters, so the gc path keeps the plain
+		 * delta-add (cur stays zero).
+		 */
+		u64 v[3] = { ca->mi.nbuckets - ca->mi.first_bucket, 0, 0 };
+		u64 cur[3] = {};
+
+		(gc
+		 ? 0
+		 : bch2_fs_accounting_read_key2(trans, cur, dev_data_type,
+						.dev = ca->dev_idx,
+						.data_type = BCH_DATA_free)) ?:
+		({
+			for (unsigned i = 0; i < 3; i++)
+				v[i] -= cur[i];
+
+			bch2_disk_accounting_mod2(trans, gc, v, dev_data_type,
+						  .dev = ca->dev_idx,
+						  .data_type = BCH_DATA_free);
+		}) ?:
+		(!gc ? bch2_trans_commit(trans, NULL, NULL, 0) : 0);
+	}));
+	bch_err_fn(c, ret);
+	return ret;
+}
+
+void bch2_verify_accounting_clean(struct bch_fs *c)
+{
+	bool mismatch = false;
+	struct bch_fs_usage_base base = {}, base_inmem = {};
+
+	CLASS(btree_trans, trans)(c);
+	for_each_btree_key(trans, iter,
+			   BTREE_ID_accounting, POS_MIN,
+			   BTREE_ITER_all_snapshots, k, ({
+		u64 v[BCH_ACCOUNTING_MAX_COUNTERS];
+		struct bkey_s_c_accounting a = bkey_s_c_to_accounting(k);
+		unsigned nr = bch2_accounting_counters(k.k);
+
+		struct disk_accounting_pos acc_k;
+		bpos_to_disk_accounting_pos(&acc_k, k.k->p);
+
+		if (acc_k.type >= BCH_DISK_ACCOUNTING_TYPE_NR)
+			break;
+
+		if (!bch2_accounting_is_mem(&acc_k)) {
+			struct disk_accounting_pos next;
+			memset(&next, 0, sizeof(next));
+			next.type = acc_k.type + 1;
+			/*
+			 * for_each_btree_key() will still advance iterator - in
+			 * Rust, LoopFlow::ContinueFrom(next), which resumes at next:
+			 */
+			bch2_btree_iter_set_pos(&iter, bpos_predecessor(disk_accounting_pos_to_bpos(&next)));
+			continue;
+		}
+
+		bch2_accounting_mem_read(c, k.k->p, v, nr);
+
+		if (memcmp(a.v->d, v, nr * sizeof(u64))) {
+			CLASS(printbuf, buf)();
+
+			bch2_bkey_val_to_text(&buf, c, k);
+			prt_str(&buf, " !=");
+			for (unsigned j = 0; j < nr; j++)
+				prt_printf(&buf, " %llu", v[j]);
+
+			pr_err("%s", buf.buf);
+			mismatch = true;
+		}
+
+		switch (acc_k.type) {
+		case BCH_DISK_ACCOUNTING_persistent_reserved:
+			base.reserved += acc_k.persistent_reserved.nr_replicas * a.v->d[0];
+			break;
+		case BCH_DISK_ACCOUNTING_replicas:
+			fs_usage_data_type_to_base(&base, acc_k.replicas.data_type, a.v->d[0]);
+			break;
+		case BCH_DISK_ACCOUNTING_dev_data_type: {
+			{
+				guard(rcu)(); /* scoped guard is a loop, and doesn't play nicely with continue */
+				const enum bch_data_type data_type = acc_k.dev_data_type.data_type;
+				struct bch_dev *ca = bch2_dev_rcu_noerror(c, acc_k.dev_data_type.dev);
+				if (!ca)
+					continue;
+
+				v[0] = percpu_u64_get(&ca->usage->d[data_type].buckets);
+				v[1] = percpu_u64_get(&ca->usage->d[data_type].sectors);
+				v[2] = percpu_u64_get(&ca->usage->d[data_type].fragmented);
+
+				if (data_type == BCH_DATA_sb || data_type == BCH_DATA_journal)
+					base.hidden += a.v->d[0] * ca->mi.bucket_size;
+			}
+
+			if (memcmp(a.v->d, v, 3 * sizeof(u64))) {
+				CLASS(printbuf, buf)();
+
+				bch2_bkey_val_to_text(&buf, c, k);
+				prt_str(&buf, " in mem");
+				for (unsigned j = 0; j < nr; j++)
+					prt_printf(&buf, " %llu", v[j]);
+
+				pr_err("dev accounting mismatch: %s", buf.buf);
+				mismatch = true;
+			}
+		}
+		}
+
+		0;
+	}));
+
+	acc_u64s_percpu(&base_inmem.hidden, &c->capacity.pcpu->usage.hidden,
+			sizeof(base_inmem) / sizeof(u64));
+
+#define check(x)										\
+	if (base.x != base_inmem.x) {								\
+		pr_err("fs_usage_base.%s mismatch: %llu != %llu", #x, base.x, base_inmem.x);	\
+		mismatch = true;								\
+	}
+
+	check(hidden);
+	check(btree);
+	check(data);
+	check(cached);
+	check(reserved);
+
+	WARN_ON(mismatch);
+}
+
+void bch2_accounting_gc_free(struct bch_fs *c)
+{
+	lockdep_assert_held(&c->capacity.mark_lock.lock);
+
+	struct bch_accounting_mem *acc = &c->accounting;
+
+	bch2_accounting_free_counters(acc, true);
+	acc->gc_running = false;
+}
+
+void bch2_fs_accounting_exit(struct bch_fs *c)
+{
+	struct bch_accounting_mem *acc = &c->accounting;
+
+	bch2_accounting_free_counters(acc, false);
+	darray_exit(&acc->k);
+}
+
+/* For Rust: a static inline, under mark_lock - a percpu rwsem */
+void rust_bch2_accounting_mem_read(struct bch_fs *c, struct bpos p, u64 *v, unsigned nr)
+{
+	bch2_accounting_mem_read(c, p, v, nr);
+}
+
+/* For Rust's replicas gc: whether @r has accounting - under mark_lock */
+bool bch2_accounting_mem_has_replicas(struct bch_fs *c, const struct bch_replicas_entry_v1 *r)
+{
+	percpu_rwsem_assert_held(&c->capacity.mark_lock.lock);
+
+	struct disk_accounting_pos k = { .type = BCH_DISK_ACCOUNTING_replicas };
+	unsafe_memcpy(&k.replicas, r, replicas_entry_bytes(r),
+		      "embedded variable length struct");
+
+	struct bpos p = disk_accounting_pos_to_bpos(&k);
+	struct bch_accounting_mem *acc = &c->accounting;
+	return eytzinger0_find(acc->k.data, acc->k.nr, sizeof(acc->k.data[0]),
+			       accounting_pos_cmp, &p) < acc->k.nr;
+}
diff --git a/fs/bcachefs/alloc/accounting.h b/fs/bcachefs/alloc/accounting.h
new file mode 100644
index 0000000..c08657d
--- /dev/null
+++ b/fs/bcachefs/alloc/accounting.h
@@ -0,0 +1,346 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_DISK_ACCOUNTING_H
+#define _BCACHEFS_DISK_ACCOUNTING_H
+
+#include "btree/update.h"
+#include "sb/members.h"
+#include "util/eytzinger.h"
+
+#include "alloc/accounting_defs_gen.h"
+
+static inline void bch2_u64s_neg(u64 *v, unsigned nr)
+{
+	for (unsigned i = 0; i < nr; i++)
+		v[i] = -v[i];
+}
+
+static inline unsigned bch2_accounting_counters(const struct bkey *k)
+{
+	return bkey_val_u64s(k) - offsetof(struct bch_accounting, d) / sizeof(u64);
+}
+
+static inline void bch2_accounting_neg(struct bkey_s_accounting a)
+{
+	bch2_u64s_neg(a.v->d, bch2_accounting_counters(a.k));
+}
+
+static inline bool bch2_accounting_key_is_zero(struct bkey_s_c_accounting a)
+{
+	for (unsigned i = 0;  i < bch2_accounting_counters(a.k); i++)
+		if (a.v->d[i])
+			return false;
+	return true;
+}
+
+static inline void bch2_accounting_accumulate(struct bkey_i_accounting *dst,
+					      struct bkey_s_c_accounting src)
+{
+	for (unsigned i = 0;
+	     i < min(bch2_accounting_counters(&dst->k),
+		     bch2_accounting_counters(src.k));
+	     i++)
+		dst->v.d[i] += src.v->d[i];
+
+	if (bversion_cmp(dst->k.bversion, src.k->bversion) < 0)
+		dst->k.bversion = src.k->bversion;
+}
+
+void __bch2_accounting_maybe_kill(struct bch_fs *, struct bpos pos);
+
+static inline void bch2_accounting_accumulate_maybe_kill(struct bch_fs *c,
+							 struct bkey_i_accounting *dst,
+							 struct bkey_s_c_accounting src)
+{
+	bch2_accounting_accumulate(dst, src);
+
+	if (bch2_accounting_key_is_zero(accounting_i_to_s_c(dst)))
+		__bch2_accounting_maybe_kill(c, dst->k.p);
+}
+
+static inline void fs_usage_data_type_to_base(struct bch_fs_usage_base *fs_usage,
+					      enum bch_data_type data_type,
+					      s64 sectors)
+{
+	switch (data_type) {
+	case BCH_DATA_btree:
+		fs_usage->btree		+= sectors;
+		break;
+	case BCH_DATA_user:
+	case BCH_DATA_parity:
+		fs_usage->data		+= sectors;
+		break;
+	case BCH_DATA_cached:
+		fs_usage->cached	+= sectors;
+		break;
+	default:
+		break;
+	}
+}
+
+static inline void bpos_to_disk_accounting_pos(struct disk_accounting_pos *acc, struct bpos p)
+{
+	BUILD_BUG_ON(sizeof(*acc) != sizeof(p));
+
+#if __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+	acc->_pad = p;
+#else
+	memcpy_swab(acc, &p, sizeof(p));
+#endif
+}
+
+static inline struct bpos disk_accounting_pos_to_bpos(struct disk_accounting_pos *acc)
+{
+	struct bpos p;
+#if __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+	p = acc->_pad;
+#else
+	memcpy_swab(&p, acc, sizeof(p));
+#endif
+	return p;
+}
+
+static inline int bch2_disk_accounting_mod(struct btree_trans *trans,
+			     struct disk_accounting_pos *k,
+			     s64 *d, unsigned nr, bool gc)
+{
+	return likely(!gc)
+		? bch2_disk_accounting_mod_normal(trans, k, d, nr)
+		: bch2_disk_accounting_mod_gc(trans, k, d, nr);
+}
+
+#define disk_accounting_key_init(_k, _type, ...)			\
+do {									\
+	memset(&(_k), 0, sizeof(_k));					\
+	(_k).type	= BCH_DISK_ACCOUNTING_##_type;			\
+	(_k)._type	= (bch_acct_##_type) { __VA_ARGS__ };		\
+} while (0)
+
+#define bch2_disk_accounting_mod2(_trans, _gc, _v, ...)			\
+({									\
+	struct disk_accounting_pos pos;					\
+	disk_accounting_key_init(pos, __VA_ARGS__);			\
+	bch2_disk_accounting_mod(trans, &pos, _v, ARRAY_SIZE(_v), _gc);	\
+})
+
+int bch2_mod_dev_cached_sectors(struct btree_trans *, unsigned, s64, bool);
+
+int bch2_accounting_validate(struct bch_fs *, struct bkey_s_c,
+			     const struct bkey_validate_context *);
+void bch2_accounting_key_to_text(struct printbuf *, struct bch_fs *, struct disk_accounting_pos *);
+void bch2_accounting_to_text(struct printbuf *, struct bch_fs *, struct bkey_s_c);
+void bch2_accounting_swab(const struct bch_fs *, struct bkey_s);
+
+#define bch2_bkey_ops_accounting ((struct bkey_ops) {	\
+	.key_validate	= bch2_accounting_validate,	\
+	.val_to_text	= bch2_accounting_to_text,	\
+	.swab		= bch2_accounting_swab,		\
+})
+
+int bch2_accounting_update_sb(struct btree_trans *);
+
+static inline int accounting_pos_cmp(const void *_l, const void *_r)
+{
+	const struct bpos *l = _l, *r = _r;
+
+	return bpos_cmp(*l, *r);
+}
+
+int bch2_accounting_mem_insert(struct bch_fs *, struct bkey_s_c_accounting, enum bch_accounting_mode);
+int bch2_accounting_mem_insert_locked(struct bch_fs *, struct bkey_s_c_accounting, enum bch_accounting_mode);
+void bch2_accounting_mem_gc(struct bch_fs *);
+
+static inline bool bch2_accounting_is_mem(struct disk_accounting_pos *acc)
+{
+	return acc->type < BCH_DISK_ACCOUNTING_TYPE_NR &&
+		acc->type != BCH_DISK_ACCOUNTING_inum;
+}
+
+static inline bool bch2_bkey_is_accounting_mem(struct bkey *k)
+{
+	if (k->type != KEY_TYPE_accounting)
+		return false;
+
+	struct disk_accounting_pos acc_k;
+	bpos_to_disk_accounting_pos(&acc_k, k->p);
+	return bch2_accounting_is_mem(&acc_k);
+}
+
+/*
+ * Update in memory counters so they match the btree update we're doing; called
+ * from transaction commit path
+ */
+static __always_inline
+int bch2_accounting_mem_add_inlined(struct btree_trans *trans,
+				   struct bkey_s_c_accounting a,
+				   enum bch_accounting_mode mode,
+				   bool write_locked)
+{
+	struct bch_fs *c = trans->c;
+	struct bch_accounting_mem *acc = &c->accounting;
+	struct disk_accounting_pos acc_k;
+	bpos_to_disk_accounting_pos(&acc_k, a.k->p);
+	bool gc = mode == BCH_ACCOUNTING_gc;
+
+	if (gc && !acc->gc_running)
+		return 0;
+
+	if (!bch2_accounting_is_mem(&acc_k))
+		return 0;
+
+	if (mode == BCH_ACCOUNTING_normal) {
+		switch (acc_k.type) {
+		case BCH_DISK_ACCOUNTING_persistent_reserved:
+			trans->fs_usage_delta.reserved += acc_k.persistent_reserved.nr_replicas * a.v->d[0];
+			break;
+		case BCH_DISK_ACCOUNTING_replicas:
+			fs_usage_data_type_to_base(&trans->fs_usage_delta, acc_k.replicas.data_type, a.v->d[0]);
+			break;
+		case BCH_DISK_ACCOUNTING_dev_data_type: {
+			guard(rcu)();
+			const enum bch_data_type data_type = acc_k.dev_data_type.data_type;
+			struct bch_dev *ca = bch2_dev_rcu_noerror(c, acc_k.dev_data_type.dev);
+			if (ca) {
+				this_cpu_add(ca->usage->d[data_type].buckets, a.v->d[0]);
+				this_cpu_add(ca->usage->d[data_type].sectors, a.v->d[1]);
+				this_cpu_add(ca->usage->d[data_type].fragmented, a.v->d[2]);
+
+				if (data_type == BCH_DATA_sb || data_type == BCH_DATA_journal)
+					trans->fs_usage_delta.hidden += a.v->d[0] * ca->mi.bucket_size;
+			}
+			break;
+		}
+		}
+	}
+
+	unsigned idx;
+
+	while ((idx = eytzinger0_find(acc->k.data, acc->k.nr, sizeof(acc->k.data[0]),
+				      accounting_pos_cmp, &a.k->p)) >= acc->k.nr) {
+		if (unlikely(write_locked))
+			try(bch2_accounting_mem_insert_locked(c, a, mode));
+		else
+			try(bch2_accounting_mem_insert(c, a, mode));
+	}
+
+	struct accounting_mem_entry *e = &acc->k.data[idx];
+
+	const unsigned nr = min_t(unsigned, bch2_accounting_counters(a.k), e->nr_counters);
+
+	for (unsigned i = 0; i < nr; i++)
+		this_cpu_add(e->v[gc][i], a.v->d[i]);
+	return 0;
+}
+
+int bch2_accounting_mem_add(struct btree_trans *, struct bkey_s_c_accounting,
+			    enum bch_accounting_mode, bool);
+
+static inline void bch2_accounting_mem_read_counters(struct bch_accounting_mem *acc,
+						     unsigned idx, u64 *v, unsigned nr, bool gc)
+{
+	memset(v, 0, sizeof(*v) * nr);
+
+	if (unlikely(idx >= acc->k.nr))
+		return;
+
+	struct accounting_mem_entry *e = &acc->k.data[idx];
+
+	nr = min_t(unsigned, nr, e->nr_counters);
+
+	for (unsigned i = 0; i < nr; i++)
+		v[i] = percpu_u64_get(e->v[gc] + i);
+}
+
+static inline void bch2_accounting_mem_read_locked(struct bch_fs *c, struct bpos p,
+						   u64 *v, unsigned nr)
+{
+	percpu_rwsem_assert_held(&c->capacity.mark_lock.lock);
+
+	/*
+	 * Types not in the mem table read back as zeros - not an error, a
+	 * silently wrong answer: bch2_snapshot_node_check_no_data()'s empty
+	 * check read zeros from the day it was added, licensing no_keys
+	 * transitions that stranded live keys. Non-mem types must be read
+	 * from the accounting btree.
+	 */
+	EBUG_ON(({
+		struct disk_accounting_pos acc_k;
+		bpos_to_disk_accounting_pos(&acc_k, p);
+		!bch2_accounting_is_mem(&acc_k);
+	}));
+
+	struct bch_accounting_mem *acc = &c->accounting;
+	unsigned idx = eytzinger0_find(acc->k.data, acc->k.nr, sizeof(acc->k.data[0]),
+				       accounting_pos_cmp, &p);
+
+	bch2_accounting_mem_read_counters(acc, idx, v, nr, false);
+}
+
+static inline void bch2_accounting_mem_read(struct bch_fs *c, struct bpos p,
+					    u64 *v, unsigned nr)
+{
+	guard(percpu_read_noio)(&c->capacity.mark_lock);
+	bch2_accounting_mem_read_locked(c, p, v, nr);
+}
+
+static inline struct bversion journal_pos_to_bversion(struct journal_res *res, unsigned offset)
+{
+	EBUG_ON(!res->ref);
+
+	return (struct bversion) {
+		.hi = res->seq >> 32,
+		.lo = (res->seq << 32) | (res->offset + offset),
+	};
+}
+
+static inline int bch2_accounting_trans_commit_hook(struct btree_trans *trans,
+						    struct bkey_i_accounting *a,
+						    unsigned commit_flags)
+{
+	u64 *base = (u64 *) btree_trans_subbuf_base(trans, &trans->accounting);
+	a->k.bversion = journal_pos_to_bversion(&trans->journal_res, (u64 *) a - base);
+
+	EBUG_ON(bversion_zero(a->k.bversion));
+
+	return likely(!(commit_flags & BCH_TRANS_COMMIT_skip_accounting_apply))
+		? bch2_accounting_mem_add_inlined(trans, accounting_i_to_s_c(a), BCH_ACCOUNTING_normal, false)
+		: 0;
+}
+
+static inline void bch2_accounting_trans_commit_revert(struct btree_trans *trans,
+						       struct bkey_i_accounting *a_i,
+						       unsigned commit_flags)
+{
+	if (likely(!(commit_flags & BCH_TRANS_COMMIT_skip_accounting_apply))) {
+		struct bkey_s_accounting a = accounting_i_to_s(a_i);
+
+		bch2_accounting_neg(a);
+		bch2_accounting_mem_add(trans, a.c, BCH_ACCOUNTING_normal, false);
+		bch2_accounting_neg(a);
+	}
+}
+
+int bch2_fs_replicas_usage_read(struct bch_fs *, darray_char *);
+int bch2_fs_accounting_read(struct bch_fs *, darray_char *, unsigned);
+int bch2_fs_accounting_read_key(struct btree_trans *, struct disk_accounting_pos *, u64 *, unsigned);
+
+#define bch2_fs_accounting_read_key2(_trans, _v, ...)			\
+({									\
+	struct disk_accounting_pos pos;					\
+	disk_accounting_key_init(pos, __VA_ARGS__);			\
+	bch2_fs_accounting_read_key(trans, &pos, _v, ARRAY_SIZE(_v));	\
+})
+
+int bch2_gc_accounting_start(struct bch_fs *);
+int bch2_gc_accounting_done(struct bch_fs *);
+
+int bch2_accounting_read(struct bch_fs *);
+
+int bch2_dev_usage_remove(struct bch_fs *, struct bch_dev *);
+int bch2_dev_usage_init(struct bch_dev *, bool);
+
+void bch2_verify_accounting_clean(struct bch_fs *c);
+
+void bch2_accounting_gc_free(struct bch_fs *);
+void bch2_fs_accounting_exit(struct bch_fs *);
+
+#endif /* _BCACHEFS_DISK_ACCOUNTING_H */
diff --git a/fs/bcachefs/alloc/accounting.rs b/fs/bcachefs/alloc/accounting.rs
new file mode 100644
index 0000000..dc04966
--- /dev/null
+++ b/fs/bcachefs/alloc/accounting.rs
@@ -0,0 +1,211 @@
+use crate::btree::iter::TransAttempt;
+use crate::c;
+use crate::errcode::{ret_to_result_void as ret_to_result, BchError};
+use crate::fs::Fs;
+use crate::util::eytzinger::Eytzinger0;
+use crate::util::percpu::PerCpuRef;
+use crate::util::vstructs::Unvalidated;
+
+pub use c::bch_data_type;
+pub use c::bch_compression_type;
+pub use c::bch_reconcile_accounting_type;
+#[allow(non_camel_case_types)]
+pub type data_type = c::bch_data_type;
+#[allow(non_camel_case_types)]
+pub type compression_type = c::bch_compression_type;
+#[allow(non_camel_case_types)]
+pub type disk_accounting_type = c::disk_accounting_type;
+#[allow(non_camel_case_types)]
+pub type reconcile_accounting_type = c::bch_reconcile_accounting_type;
+
+pub fn data_type_from_u8(v: u8) -> bch_data_type {
+    bch_data_type(v as u32)
+}
+
+pub fn compression_type_from_u8(v: u8) -> bch_compression_type {
+    bch_compression_type(v as u32)
+}
+
+pub fn reconcile_type_from_u8(v: u8) -> bch_reconcile_accounting_type {
+    bch_reconcile_accounting_type(v as u32)
+}
+
+/// Size of a bpos in bytes — maximum size of any accounting key payload.
+const BPOS_SIZE: usize = core::mem::size_of::<c::bpos>();
+
+/// The disk_accounting_pos an accounting key at @p holds, as bytes: the
+/// position as one big-endian number - inode, offset, snapshot - so the first
+/// byte, the inode's top one, is the accounting type. As
+/// bpos_to_disk_accounting_pos(): memcpy_swab() on little endian, a copy on
+/// big - the same bytes, as a bpos's fields are in the opposite order there.
+fn bpos_to_acc_bytes(p: c::bpos) -> [u8; BPOS_SIZE] {
+    let mut b = [0u8; BPOS_SIZE];
+    b[0..8].copy_from_slice(&p.inode.to_be_bytes());
+    b[8..16].copy_from_slice(&p.offset.to_be_bytes());
+    b[16..20].copy_from_slice(&p.snapshot.to_be_bytes());
+    b
+}
+
+/// The bpos of the accounting key holding disk_accounting_pos bytes @b:
+/// bpos_to_acc_bytes()'s inverse.
+fn acc_bytes_to_bpos(b: &[u8; BPOS_SIZE]) -> c::bpos {
+    c::bpos {
+        inode:    u64::from_be_bytes(b[0..8].try_into().unwrap()),
+        offset:   u64::from_be_bytes(b[8..16].try_into().unwrap()),
+        snapshot: u32::from_be_bytes(b[16..20].try_into().unwrap()),
+    }
+}
+
+/// An accounting key's position is a disk_accounting_pos - see
+/// accounting_format.rs: get() for the arm it holds, from_arm() to make one.
+impl c::disk_accounting_pos<Unvalidated> {
+    /// The disk_accounting_pos an accounting key at @p holds - one validate
+    /// may not have passed: bpos_to_disk_accounting_pos().
+    pub fn from_bpos(p: c::bpos) -> Self {
+        Self::from_bytes(&bpos_to_acc_bytes(p))
+    }
+}
+
+impl<S> c::disk_accounting_pos<S> {
+    /// The position of the accounting key holding it:
+    /// disk_accounting_pos_to_bpos().
+    pub fn to_bpos(&self) -> c::bpos {
+        acc_bytes_to_bpos(self.as_bytes())
+    }
+}
+
+pub fn mem_read(fs: &Fs, pos: &c::disk_accounting_pos, counters: &mut [u64]) {
+    unsafe {
+        c::rust_bch2_accounting_mem_read(
+            fs.as_ptr(),
+            pos.to_bpos(),
+            counters.as_mut_ptr(),
+            counters.len() as u32,
+        );
+    }
+}
+
+/// mem_read(), mark_lock held - read or write - by the caller:
+/// bch2_accounting_mem_read_locked(). Taking it again, for read, could
+/// deadlock against a writer waiting on it. Zeroes for what isn't in the
+/// table, and past the counters an entry has.
+pub fn mem_read_locked(fs: &Fs, pos: &c::disk_accounting_pos, counters: &mut [u64]) {
+    fs.mark_lock_assert_held();
+    counters.fill(0);
+
+    let p = pos.to_bpos();
+    let acc = &fs.accounting.k;
+    if acc.nr == 0 {
+        return;
+    }
+    // SAFETY: as C's: the table changes under mark_lock for write - but for
+    // recovery's accounting_read(), which C relies on no reader racing
+    let entries = unsafe { core::slice::from_raw_parts(acc.data, acc.nr) };
+    let Some(idx) = Eytzinger0::find_by(entries, |e| e.pos.cmp(&p)) else { return };
+    let e = &entries[idx];
+
+    for (i, v) in counters.iter_mut().take(e.nr_counters as usize).enumerate() {
+        // SAFETY: the entry's counters, nr_counters u64s, percpu
+        *v = unsafe { PerCpuRef::from_raw(e.v[0].wrapping_add(i)) }.sum();
+    }
+}
+
+/// Snapshot @id's counters - keys, key bytes, sectors - in each snapshotted
+/// btree. In memory, so current without a write buffer flush.
+pub fn snapshot_btrees(fs: &Fs, id: u32) -> impl Iterator<Item = [u64; 3]> + '_ {
+    crate::BTREE_IDS_KNOWN.iter()
+        .filter(|&&btree| crate::BTREE_HAS_SNAPSHOTS_MASK & (1 << btree.0) != 0)
+        .map(move |&btree| {
+            let mut v = [0; 3];
+            mem_read(fs, &c::disk_accounting_pos::from_arm(c::bch_acct_snapshot { id, btree: btree.0 }), &mut v);
+            v
+        })
+}
+
+/// Add @d to accounting key @pos's counters, in @trans - the gc copy's, with
+/// @gc: as bch2_disk_accounting_mod(). For triggers.
+pub fn add(t: &TransAttempt<'_, '_>, pos: &c::disk_accounting_pos, d: &[i64], gc: bool)
+    -> Result<(), BchError>
+{
+    // bch2_disk_accounting_mod(); C's signatures aren't const: a copy of
+    // @pos, and @d only read.
+    let mut acc = *pos;
+    let d_ptr = d.as_ptr() as *mut i64;
+    ret_to_result(unsafe {
+        if gc {
+            c::bch2_disk_accounting_mod_gc(t.raw(), &raw mut acc, d_ptr, d.len() as u32)
+        } else {
+            c::bch2_disk_accounting_mod_normal(t.raw(), &raw mut acc, d_ptr, d.len() as u32)
+        }
+    })
+}
+
+/// Add @sectors to device @dev's cached sectors, in @trans - the gc copy's,
+/// with @gc: bch2_mod_dev_cached_sectors().
+pub fn mod_dev_cached_sectors(t: &TransAttempt<'_, '_>, dev: u32, sectors: i64, gc: bool)
+    -> Result<(), BchError>
+{
+    ret_to_result(unsafe { c::bch2_mod_dev_cached_sectors(t.raw(), dev, sectors, gc) })
+}
+
+pub fn nr_inodes(fs: &Fs) -> u64 {
+    let mut nr_inodes = 0;
+    mem_read(
+        fs,
+        &c::disk_accounting_pos::from_arm(c::bch_acct_nr_inodes {}),
+        core::slice::from_mut(&mut nr_inodes),
+    );
+    nr_inodes
+}
+
+/// A single accounting entry, from the query_accounting ioctl - from the
+/// kernel, so its position is Unvalidated. Tools-only — holds its counters
+/// in a heap Vec.
+#[cfg(feature = "std")]
+pub struct AccountingEntry {
+    pub pos: c::disk_accounting_pos<Unvalidated>,
+    pub counters: Vec<u64>,
+}
+
+#[cfg(feature = "std")]
+impl AccountingEntry {
+    pub fn counter(&self, i: usize) -> u64 {
+        self.counters.get(i).copied().unwrap_or(0)
+    }
+}
+
+/// Free/empty data types — not counted as "used" space.
+pub fn data_type_is_empty(t: bch_data_type) -> bool {
+    t == data_type::free
+        || t == data_type::need_gc_gens
+        || t == data_type::need_discard
+}
+
+/// Internal/hidden data types — not user-visible (superblock, journal).
+pub fn data_type_is_hidden(t: bch_data_type) -> bool {
+    t == data_type::sb || t == data_type::journal
+}
+
+/// What a bucket holding @t is: cached and stripe data are in user buckets.
+pub fn bucket_data_type(t: bch_data_type) -> bch_data_type {
+    if t == data_type::cached || t == data_type::stripe { data_type::user } else { t }
+}
+
+/// Whether a bucket of type @bucket can't hold a pointer of type @ptr.
+pub fn bucket_data_type_mismatch(bucket: bch_data_type, ptr: bch_data_type) -> bool {
+    !data_type_is_empty(bucket) &&
+        bucket != data_type::multiple &&
+        bucket_data_type(bucket) != bucket_data_type(ptr)
+}
+
+/// Whether copygc moves data of type @t.
+pub fn data_type_movable(t: bch_data_type) -> bool {
+    c::DATA_TYPES_MOVABLE & (1 << t.0) != 0
+}
+
+impl Fs {
+    /// Device @ca's usage accounting, deleted: as it's removed.
+    pub fn dev_usage_remove(&self, ca: &c::bch_dev) -> Result<(), BchError> {
+        ret_to_result(unsafe { c::bch2_dev_usage_remove(self.as_ptr(), core::ptr::from_ref(ca).cast_mut()) })
+    }
+}
