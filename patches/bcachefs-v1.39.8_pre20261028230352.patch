+        assert_eq!(split(b"ssd."),     [&b"ssd"[..]]);
+        assert_eq!(split(b"a..b"),     [&b"a"[..], b"", b"b"]);
+        assert_eq!(split(b".a"),       [&b""[..], b"a"]);
