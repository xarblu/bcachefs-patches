+    fb.set_signed_eight_bits(-1);
+    assert_eq!(0xFF, fb.0);
+    assert_eq!(-1, fb.signed_two_bits());
+    assert_eq!(-1, fb.signed_eight_bits());
+    assert_eq!(127, fb.signed_eight_bits_unaligned());
