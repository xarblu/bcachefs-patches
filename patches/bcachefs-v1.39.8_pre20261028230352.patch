+    ///
+    /// ```
+    /// use num_traits::real::Real;
+    /// use std::f64;
+    ///
+    /// let x: f64 = Real::min_positive_value();
+    ///
+    /// assert_eq!(x, f64::MIN_POSITIVE);
+    /// ```
+    fn min_positive_value() -> Self;
+
+    /// Returns epsilon, a small positive value.
+    ///
+    /// ```
+    /// use num_traits::real::Real;
+    /// use std::f64;
+    ///
+    /// let x: f64 = Real::epsilon();
+    ///
+    /// assert_eq!(x, f64::EPSILON);
