+/// @v, a value per replica count from 1.
+fn per_replicas_to_text(out: &mut Printbuf, name: &str, v: impl IntoIterator<Item = u64>) {
+    write!(out, "{name}\n");
+    for (i, v) in v.into_iter().enumerate() {
+        write!(out, "  {}x\t{v}\n", i + 1);
+    }
+}
+
+impl Fs {
+    /// The open buckets allocated, by data type, and whether anything's
+    /// waiting for one.
+    #[cold]
+    pub fn fs_open_buckets_to_text(&self, out: &mut Printbuf) {
+        if out.nr_tabstops() == 0 {
+            out.tabstop_push(24);
+        }
+
+        let a = &self.allocator;
+        let mut nr = [0u32; c::BCH_DATA_NR as usize];
+        for ob in a.open_buckets.iter().filter(|ob| ob.pin.load(Relaxed) != 0) {
+            if let Some(n) = nr.get_mut(usize::from(ob.data_type.get())) {
+                *n += 1;
+            }
+        }
+
+        write!(out, "open buckets allocated\t{}\n",
+               c::OPEN_BUCKETS_COUNT - u32::from(a.freelist_lock.open_buckets_nr_free.get()));
+        write!(out, "open buckets total\t{}\n", c::OPEN_BUCKETS_COUNT);
+        for (i, n) in nr.into_iter().enumerate().filter(|&(_, n)| n != 0) {
+            write!(out, "open_buckets {}:\t{n}\n", data_type_str(c::bch_data_type(i as u32)));
+        }
+        write!(out, "open_buckets_wait\t{}\n", waiting_to_text(&a.open_buckets_wait));
+    }
+
+    /// Capacity, usage and reservations, and the free space by the replica
+    /// count it's placeable at.
+    #[cold]
+    pub fn alloc_debug_to_text(&self, out: &mut Printbuf) {
+        if out.nr_tabstops() == 0 {
+            out.tabstop_push(24);
+        }
+
+        let b = percpu_field!(self.capacity.pcpu.get(), counters).sum_nonnegative();
+        write!(out, "capacity\t{}\n",   self.capacity.capacity.get());
+        write!(out, "used\t{}\n",       self.usage_read_short().used);
+        write!(out, "reserved\t{}\n",   self.capacity.reserved.get());
+        write!(out, "hidden\t{}\n",     b.usage.hidden);
+        write!(out, "btree\t{}\n",      b.usage.btree);
+        write!(out, "data\t{}\n",       b.usage.data);
+        write!(out, "cached\t{}\n",     b.usage.cached);
+        write!(out, "reserved\t{}\n",   b.usage.reserved);
+        // Per replica count: an ENOSPC at 3x with raw space free needs this
+        per_replicas_to_text(out, "online_reserved", b.online_reserved);
+
+        // Computed, not read back: "cached" below is only what the
+        // reservation fast path has left, and reads zero until a slot has run
+        // dry once.
+        let p = self.sectors_placeable();
+        per_replicas_to_text(out, "sectors_available placeable", p.eventual);
+        per_replicas_to_text(out, "sectors_available now", p.now);
+        // the exclusive partition underneath, which sums to the free space
+        per_replicas_to_text(out, "sectors_available slots",
+            p.eventual.iter().zip(p.eventual[1..].iter().chain([&0])).map(|(n, above)| n.wrapping_sub(*above)));
+        // what the pools hold, which lags until a recalc
+        per_replicas_to_text(out, "sectors_available cached",
+            self.capacity.sectors_available.iter().map(|s| s.load(Relaxed)));
+
+        writeln!(out);
+        write!(out, "freelist_wait\t{}\n", waiting_to_text(&self.allocator.freelist_wait));
+        write!(out, "btree reserve cache\t{}\n", self.btree.reserve_cache.lock.lock().nr);
+        writeln!(out);
+    }
+}
+
+impl c::bch_dev {
+    /// Its usage, its reserve at each watermark, and its open buckets and
+    /// buckets to invalidate.
+    #[cold]
+    pub fn alloc_debug_to_text(&self, out: &mut Printbuf) {
+        self.usage_to_text(out, &self.usage_full_read_fast());
+        writeln!(out);
+
+        write!(out, "reserves:\n");
+        for w in (0..c::bch_watermark::BCH_WATERMARK_NR as u32).map(c::bch_watermark::from_bits) {
+            write!(out, "{w}\t{}\r\n", self.buckets_reserved(w));
+        }
+        writeln!(out);
+
+        out.tabstops(&[12, 16]);
+        write!(out, "open buckets\t{}\r\n", self.nr_open_buckets.get() as i32);
+        write!(out, "buckets to invalidate\t{}\r\n", self.should_invalidate_buckets(&self.usage_read_fast()));
+    }
+}
+
+impl Fs {
+    /// The open buckets - on @ca, or all of them.
+    pub fn open_buckets_to_text(&self, out: &mut Printbuf, ca: Option<&c::bch_dev>) {
+        let mut out = out.atomic();
+        for ob in &self.allocator.open_buckets {
+            let l = ob.lock.lock();
+            if let Some(ob) = ob.open_ref(&l).filter(|ob| ca.is_none_or(|ca| ob.id().dev() == ca.dev_idx)) {
+                ob.to_text(&mut out);
+            }
+        }
+    }
+
+    pub fn open_buckets_partial_to_text(&self, out: &mut Printbuf) {
+        let mut out = out.atomic();
+        let g = self.allocator.freelist_lock.lock();
+        self.allocator.partial(&g).for_each(|ob| ob.to_text(&mut out));
+    }
+}
+
+impl ToText for OpenBucketRef {
+    fn to_text(&self, out: &mut Printbuf) {
+        let bucket_size = u32::from(self.ca().mi.get().bucket_size);
+        write!(out, "{} ref {} ", self.idx().get(), self.pin.load(Relaxed));
+        c::bch_data_type(self.data_type.get().into()).to_text(out);
+        let id = self.id();
+        write!(out, " {}:{} gen {} allocated {}/{}", id.dev(), id.bucket(), id.generation(),
+               bucket_size.wrapping_sub(self.sectors_free.get()), bucket_size);
+        if let Some(s) = self.stripe() {
+            write!(out, " ec idx {}", s.idx.load(Relaxed));
+        }
+        if self.flag(c::open_bucket::ON_PARTIAL_LIST) {
+            write!(out, " partial");
+        }
+        writeln!(out);
+    }
+}
+
+// ── For C ────────────────────────────────────────────────────────────────
+
+/// What's built once the allocator is in place, before anything allocates:
+/// the open buckets' freelist - every one but slot 0, the sentinel, never
+/// handed out - and the write points' hash.
+#[c_export]
+pub fn bch2_fs_allocator_foreground_init(c: &Opaque<c::bch_fs>) {
+    let fs = Fs::from_c(c);
+    let a = &fs.allocator;
+    {
+        let mut g = a.freelist_lock.lock();
+        let (free, nr) = g.parts();
+        for ob in &a.open_buckets[1..] {
+            ob.freelist.set(free.open_buckets_freelist);
+            free.open_buckets_freelist = Some(ob.idx());
+            *nr.open_buckets_nr_free.place() += 1;
+        }
+    }
+    fs.write_points_init();
+}
+
+#[c_export]
+pub fn bch2_alloc_wake_all(c: &Opaque<c::bch_fs>) {
+    Fs::from_c(c).alloc_wake_all()
+}
+
+/// bch2_open_bucket_put()'s, for the last pin.
+///
+/// # Safety
+/// @ob's last pin was put by the caller.
+#[c_export]
+pub unsafe fn __bch2_open_bucket_put(c: &Opaque<c::bch_fs>, ob: &c::open_bucket) {
+    // SAFETY: open until it's closed, which this does
+    Fs::from_c(c).open_bucket_close(unsafe { OpenBucketRef::from_c(ob) })
+}
+
+/// The stripes the buckets of @obs on @dev are blocks of, cancelled with
+/// @err: the writes to @dev failed.
+#[c_export]
+pub fn bch2_open_bucket_write_error(c: &Opaque<c::bch_fs>, obs: &c::open_buckets, dev: c_uint, err: c_int) {
+    let Err(err) = ret_to_result_void(err) else { panic!("a write error without an error") };
+    obs.iter(Fs::from_c(c)).filter(|ob| u32::from(ob.id().dev()) == dev).filter_map(|ob| ob.stripe()).for_each(|s| s.err.set(err));
+}
+
+/// # Safety
+/// @ob is open, and held open for the call.
+#[c_export]
+pub unsafe fn bch2_open_bucket_to_text(out: &mut Printbuf, _c: &Opaque<c::bch_fs>, ob: &c::open_bucket) {
+    // SAFETY: the caller's
+    unsafe { OpenBucketRef::from_c(ob) }.to_text(out)
+}
+
+/// bch2_wait_on_allocator()'s, with @cl on a waitlist.
+#[c_export]
+pub fn __bch2_wait_on_allocator(trans: &BtreeTrans<'_>, req: &mut c::alloc_request, err: c_int,
+                                cl: &Opaque<c::closure>) {
+    let Err(err) = ret_to_result_void(err) else { panic!("waiting on the allocator without an error") };
+    trans.sleep_on_allocator(req, err, cl)
+}
+
+/// For C: a request, in @trans's memory - an ERR_PTR() if there's none -
+/// put by alloc_request_put().
+///
+/// # Safety
+/// @trans is in an attempt.
+#[c_export]
+#[allow(clippy::too_many_arguments)]
+pub unsafe fn alloc_request_get(trans: &BtreeTrans<'_>, target: c_uint, erasure_code: c_uint,
+                                devs_have: *mut c::bch_devs_list, nr_replicas: c_uint, ec_replicas: c_uint,
+                                watermark: c::bch_watermark, flags: c::bch_write_flags,
+                                cl: *mut c::closure) -> *mut c::alloc_request {
+    // SAFETY: the caller's
+    let t = unsafe { trans.attempt_in_progress() };
+    let req = c::alloc_request::new(t.fs(), target, erasure_code != 0, devs_have, nr_replicas, ec_replicas,
+                                    watermark, flags, cl);
+    t.alloc_init(req).map_or_else(err_ptr, core::ptr::from_mut)
+}
+
+#[c_export]
+pub fn alloc_request_put(req: &mut c::alloc_request) {
+    req.trace_reset()
+}
+
+/// @dev's @bucket's slot in the open buckets' hash.
+#[c_export]
+pub fn bch2_open_bucket_hash(dev: c_uint, bucket: u64) -> c_uint {
+    hash_64(Fold::of(&(dev, bucket)), c::OPEN_BUCKETS_COUNT.ilog2()) as c_uint
+}
diff --git a/fs/bcachefs/alloc/foreground_types.rs b/fs/bcachefs/alloc/foreground_types.rs
new file mode 100644
index 0000000..7f8b644
--- /dev/null
+++ b/fs/bcachefs/alloc/foreground_types.rs
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::types::{c_default, rust_only};
+use crate::util::inline_vec::InlineVec;
+use core::ffi::c_uint;
+use cstruct_macros::{bitfield, c_enum, CStruct};
+use nestify::nest;
+
+#[repr(C)]
+#[derive(Clone, Copy, CStruct)]
+pub struct dev_alloc_list {
+    pub nr: c_uint,
+    pub data: [u8; c::BCH_SB_MEMBERS_MAX as usize],
+}
+c_default!(dev_alloc_list);
+
+nest! {
+    #[repr(C)]
+    #[derive(Clone, Copy, Default, CStruct)]
+    #[c_typedef]
+    pub struct alloc_trace_entry {
+        pub dev: u8,
+        #[c_bitfield]
+        #>[bitfield(u8)]
+        pub bits: pub struct alloc_trace_entry_bits {
+            new_stripe_alloc:          bool,
+            will_retry_all_devices:    bool,
+            will_retry_target_devices: bool,
+            will_retry_set_devices:    bool,
+            copygc_can_make_progress:  bool,
+            have_cl:                   bool,
+            __pad:                     u2,
+        },
+        pub err: i16,
+        pub wake_counter_snapshot: u32,
+        pub free_buckets: u64,
+    }
+}
+
+/// alloc_request's trace: room for 16 attempts in the request itself, as
+/// C's DARRAY_PREALLOCATED(, 16) had.
+pub(crate) type AllocTrace = rust_only!(InlineVec<c::alloc_trace_entry, 16>);
+
+/*
+ * alloc_request.btree_bitmap: whether the bucket must be in a region the
+ * device's btree bitmap marks (YES), must not be (NO), or may be either (ANY)
+ */
+c_enum! {
+    #[closed]
+    pub enum alloc_btree_bitmap: u32 {
+        BTREE_BITMAP_NO,
+        BTREE_BITMAP_YES,
+        BTREE_BITMAP_ANY,
+    }
+}
+
+nest! {
+    #[derive(CStruct)]*
+    #[repr(C)]*
+    pub struct alloc_request {
+        pub cl: *mut c::closure,
+        pub wake_all_counter_snapshot: u32,
+        pub nr_replicas: u8,
+        pub ec_replicas: u8,
+        pub ec_max_data_blocks: u8, /* 0 = no cap */
+        pub target: c_uint,
+        #[c_bitfield]
+        #>[bitfield(u8)]
+        #>[derive(CStruct)]-
+        #>[repr(C)]-
+        pub bits: pub struct alloc_request_bits {
+            ec:                        bool,
+            new_stripe_alloc:          bool,
+            will_retry_all_devices:    bool,
+            will_retry_target_devices: bool,
+            will_retry_set_devices:    bool,
+            copygc_can_make_progress:  bool,
+            trace_alloc_failed:        bool,
+            /* failure domains are a hard requirement, not a preference (erasure coding): */
+            failure_domains_required:  bool,
+        },
+        pub watermark: c::bch_watermark,
+        pub flags: c::bch_write_flags,
+        pub data_type: c::bch_data_type,
+        pub devs_have: *mut c::bch_devs_list,
+        pub wp: *mut c::write_point,
+
+        /* These fields are used primarily by open_bucket_add_buckets */
+        pub ptrs: c::open_buckets,
+        pub nr_effective: c_uint, /* sum of @ptrs durability */
+        pub devs_may_alloc: c::bch_devs_mask,
+
+        /*
+         * Devices already holding a replica of what we're allocating for -
+         * devs_have plus buckets allocated so far - for spreading replicas
+         * across failure domains, see bch2_dev_domain_key():
+         */
+        pub devs_chosen: c::bch_devs_mask,
+
+        /* devices this allocation should use first, see dev_alloc_required() */
+        pub devs_required: *const c::bch_devs_mask,
+
+        /* bch2_bucket_alloc_set_trans(): */
+        pub devs_sorted: c::dev_alloc_list,
+        pub domain_keys: [u64; c::BCH_SB_MEMBERS_MAX as usize],
+        pub usage: c::bch_dev_usage,
+
+        /* bch2_bucket_alloc_trans(): */
+        pub ca: *mut c::bch_dev,
+
+        /*
+         * Allocate the free bucket nearest this device position (a 32.32
+         * fixed point fraction of the device, see dev_frac_to_offset()),
+         * instead of allocating from the device cursor; 0 = no target.
+         *
+         * A fraction rather than a sector offset so it means the same thing
+         * on devices of different sizes: erasure coding uses it to allocate
+         * a stripe's blocks at equivalent positions on each device, and the
+         * device is chosen after the target is set:
+         */
+        pub target_frac: u64,
+
+        pub btree_bitmap: c::alloc_btree_bitmap,
+
+        #[c_inline]
+        #>[derive(Clone, Copy, Default)]
+        pub counters: pub struct alloc_request_counters {
+            pub buckets_seen: u64,
+            pub skipped_open: u64,
+            pub skipped_need_journal_commit: u64,
+            pub need_journal_commit: u64,
+            pub skipped_nocow: u64,
+            pub skipped_nouse: u64,
+            pub skipped_mi_btree_bitmap: u64,
+        },
+
+        pub scratch_ptrs: c::open_buckets,
+
+        /* Allocation attempt trace — dumped on allocator stuck */
+        pub(crate) trace: AllocTrace,
+    }
+}
+
diff --git a/fs/bcachefs/alloc/format.rs b/fs/bcachefs/alloc/format.rs
new file mode 100644
index 0000000..74daf45
--- /dev/null
+++ b/fs/bcachefs/alloc/format.rs
@@ -0,0 +1,175 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::types::{c_default, Le32, Le64};
+use core::ffi::c_ulong;
+use cstruct_macros::{c_bitmask, c_const, c_enum, c_xmacro, grown, whole, CStruct, Plain, TypeInfo, View, SizedVal};
+
+#[whole(tail = data: [u8], bkey)]
+#[repr(C, align(8))]
+#[derive(Clone, Copy, Default, CStruct, TypeInfo)]
+#[c_packed]
+#[c_name(bch_alloc)]
+pub struct Alloc {
+    pub v: c::bch_val,
+    pub fields: u8,
+    pub generation: u8,
+    pub data: [u8; 0],
+}
+
+c_xmacro! {
+    BCH_ALLOC_FIELDS_V1(x) {
+        (read_time, 16),
+        (write_time, 16),
+        (data_type, 8),
+        (dirty_sectors, 16),
+        (cached_sectors, 16),
+        (oldest_gen, 8),
+        (stripe, 32),
+        (stripe_redundancy, 8),
+    }
+}
+
+c_enum! {
+    #[closed]
+    pub enum _: u32 {
+        BCH_ALLOC_FIELDS_V1(name, ..) => BCH_ALLOC_FIELD_V1_ ## name,
+    }
+}
+
+#[whole(tail = data: [u8], bkey)]
+#[repr(C, align(8))]
+#[derive(Clone, Copy, Default, CStruct, TypeInfo)]
+#[c_packed]
+#[c_name(bch_alloc_v2)]
+pub struct AllocV2 {
+    pub v: c::bch_val,
+    pub nr_fields: u8,
+    pub generation: u8,
+    pub oldest_gen: u8,
+    pub data_type: u8,
+    pub data: [u8; 0],
+}
+
+c_xmacro! {
+    BCH_ALLOC_FIELDS_V2(x) {
+        (read_time, 64),
+        (write_time, 64),
+        (dirty_sectors, 32),
+        (cached_sectors, 32),
+        (stripe, 32),
+        (stripe_redundancy, 8),
+    }
+}
+
+#[whole(tail = data: [u8], bkey)]
+#[repr(C, align(8))]
+#[derive(Clone, Copy, Default, CStruct, Plain, TypeInfo)]
+#[c_packed]
+#[c_name(bch_alloc_v3)]
+pub struct AllocV3 {
+    pub v: c::bch_val,
+    pub journal_seq: Le64,
+    pub flags: Le32,
+    pub nr_fields: u8,
+    pub generation: u8,
+    pub oldest_gen: u8,
+    pub data_type: u8,
+    pub data: [u8; 0],
+}
+
+c_bitmask! {
+    LE32_BITMASK(struct AllocV3, flags), strip BCH_ALLOC_V3_ {
+        BCH_ALLOC_V3_NEED_DISCARD(0, 1),
+        BCH_ALLOC_V3_NEED_INC_GEN(1, 2),
+    }
+}
+
+/*
+ * Per-bucket allocation state, stored in the alloc btree (cached).
+ *
+ * data_type is the bucket's state. For non-empty buckets, alloc_data_type()
+ * derives it from sector counts and stripe_refcount. The empty-state
+ * transitions are decided explicitly:
+ *   stripe_refcount > 0	→ BCH_DATA_stripe/parity
+ *   dirty_sectors > 0		→ data type from bucket contents
+ *   cached_sectors > 0		→ BCH_DATA_cached
+ *   nonempty → empty		→ BCH_DATA_need_discard (set in bch2_trigger_alloc)
+ *   need_discard → empty	→ BCH_DATA_free (set in bch2_discard_one_bucket)
+ *   gc_gen >= MAX, free	→ BCH_DATA_need_gc_gens (in alloc_data_type)
+ *
+ * NEED_DISCARD flag is no longer read by alloc_data_type(); it's still
+ * written for forward/back compatibility with kernels that do read it.
+ *
+ * journal_seq_nonempty/journal_seq_empty track bucket state transitions for
+ * the noflush optimization and discard path:
+ *   journal_seq_nonempty: set on empty→nonempty transition
+ *   journal_seq_empty:    set on nonempty→empty transition;
+ *     bucket can't be reused until this seq is flushed to disk.
+ *     0 means no journal delay needed (noflush/fast discard path).
+ */
+#[grown(from = journal_seq_empty, bkey)]
+#[repr(C, align(8))]
+#[derive(Clone, Copy, Default, CStruct, Plain, TypeInfo)]
+#[c_packed]
+#[c_name(bch_alloc_v4)]
+pub struct AllocV4 {
+    pub v: c::bch_val,
+    pub journal_seq_nonempty: u64,
+    pub flags: u32,
+    pub generation: u8,
+    pub oldest_gen: u8,
+    pub data_type: u8,
+    pub stripe_redundancy_obsolete: u8,
+    pub dirty_sectors: u32,
+    pub cached_sectors: u32,
+    pub io_time: [u64; 2],
+    pub stripe_refcount: u32,
+    pub nr_external_backpointers: u32,
+    /* end of fields in original version of alloc_v4 */
+    pub journal_seq_empty: u64,
+    pub stripe_sectors: u32,
+    pub pad: u32,
+}
+
+c_const! {
+    #[c_int]
+    pub const BCH_ALLOC_V4_U64s_V0: u32 = 6;
+    pub const BCH_ALLOC_V4_U64s: usize = size_of::<c::AllocV4>() / size_of::<u64>();
+}
+
+c_bitmask! {
+    BITMASK(struct AllocV4, flags), strip BCH_ALLOC_V4_ {
+        BCH_ALLOC_V4_NEED_DISCARD(0, 1),
+        BCH_ALLOC_V4_NEED_INC_GEN(1, 2),
+        BCH_ALLOC_V4_BACKPOINTERS_START(2, 8),
+        BCH_ALLOC_V4_NR_BACKPOINTERS(8, 14),
+    }
+}
+
+c_const! {
+    #[c_int]
+    pub const KEY_TYPE_BUCKET_GENS_BITS: u32 = 8;
+    pub const KEY_TYPE_BUCKET_GENS_NR: u32 = 1 << c::KEY_TYPE_BUCKET_GENS_BITS;
+    pub const KEY_TYPE_BUCKET_GENS_MASK: u32 = c::KEY_TYPE_BUCKET_GENS_NR - 1;
+}
+
+#[repr(C, align(8))]
+#[derive(Clone, Copy, CStruct, Plain, TypeInfo, View, SizedVal)]
+#[c_packed]
+#[c_name(bch_bucket_gens)]
+pub struct BucketGens {
+    pub v: c::bch_val,
+    pub gens: [u8; c::KEY_TYPE_BUCKET_GENS_NR as usize],
+}
+c_default!(BucketGens);
+
+c_const! {
+    pub const DATA_TYPES_MOVABLE: c_ulong =
+        (1 << c::BCH_DATA_btree as u32) |
+        (1 << c::BCH_DATA_user as u32) |
+        (1 << c::BCH_DATA_stripe as u32) |
+        (1 << c::BCH_DATA_multiple as u32);
+}
diff --git a/fs/bcachefs/alloc/format_inline.h b/fs/bcachefs/alloc/format_inline.h
new file mode 100644
index 0000000..ad19953
--- /dev/null
+++ b/fs/bcachefs/alloc/format_inline.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_ALLOC_FORMAT_INLINE_H
+#define _BCACHEFS_ALLOC_FORMAT_INLINE_H
+
+/* Included after alloc/format_gen.h. */
+
+/* Data type computation */
+
+/*
+ * Normalize data_type to the type of data stored in the bucket: cached and
+ * stripe data are both user data from the bucket's perspective.
+ */
+static inline enum bch_data_type bucket_data_type(enum bch_data_type data_type)
+{
+	switch (data_type) {
+	case BCH_DATA_cached:
+	case BCH_DATA_stripe:
+		return BCH_DATA_user;
+	default:
+		return data_type;
+	}
+}
+
+static inline bool bucket_data_type_mismatch(enum bch_data_type bucket,
+					     enum bch_data_type ptr)
+{
+	return !data_type_is_empty(bucket) &&
+		bucket != BCH_DATA_multiple &&
+		bucket_data_type(bucket) != bucket_data_type(ptr);
+}
+
+#endif /* _BCACHEFS_ALLOC_FORMAT_INLINE_H */
diff --git a/fs/bcachefs/alloc/lru.h b/fs/bcachefs/alloc/lru.h
new file mode 100644
index 0000000..a8ad024
--- /dev/null
+++ b/fs/bcachefs/alloc/lru.h
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_LRU_H
+#define _BCACHEFS_LRU_H
+
+/* The lru btree is lru.rs's; these inlines are its position encoding, for C */
+#include "alloc/lru_gen.h"
+
+static inline u64 lru_pos_id(struct bpos pos)
+{
+	return pos.inode >> LRU_TIME_BITS;
+}
+
+static inline u64 lru_pos_time(struct bpos pos)
+{
+	return pos.inode & ~(~0ULL << LRU_TIME_BITS);
+}
+
+static inline struct bpos lru_pos(u16 lru_id, u64 dev_bucket, u64 time)
+{
+	struct bpos pos = POS(((u64) lru_id << LRU_TIME_BITS)|time, dev_bucket);
+
+	EBUG_ON(time > LRU_TIME_MAX);
+	EBUG_ON(lru_pos_id(pos) != lru_id);
+	EBUG_ON(lru_pos_time(pos) != time);
+	EBUG_ON(pos.offset != dev_bucket);
+
+	return pos;
+}
+
+static inline struct bpos lru_start(u16 lru_id)
+{
+	return lru_pos(lru_id, 0, 0);
+}
+
+static inline struct bpos lru_end(u16 lru_id)
+{
+	return lru_pos(lru_id, U64_MAX, LRU_TIME_MAX);
+}
+
+static inline u16 bucket_fragmentation_lru(unsigned dev)
+{
+	return BCH_LRU_BUCKET_FRAGMENTATION_START + dev;
+}
+
+#define bch2_bkey_ops_lru ((struct bkey_ops) {	\
+	.key_validate	= bch2_lru_validate,	\
+	.val_to_text	= bch2_lru_to_text,	\
+})
+
+static inline int bch2_lru_change(struct btree_trans *trans,
+		      u16 lru_id, u64 dev_bucket,
+		      u64 old_time, u64 new_time)
+{
+	return old_time != new_time
+		? __bch2_lru_change(trans, lru_id, dev_bucket, old_time, new_time)
+		: 0;
+}
+
+#endif /* _BCACHEFS_LRU_H */
diff --git a/fs/bcachefs/alloc/lru.rs b/fs/bcachefs/alloc/lru.rs
new file mode 100644
index 0000000..ea3123c
--- /dev/null
+++ b/fs/bcachefs/alloc/lru.rs
@@ -0,0 +1,427 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! The lru btree: per-device read and fragmentation lrus, and the stripe lru.
+//!
+//! An entry is a set bit at an LruPos: which lru, a time, and the entry's
+//! target - a bucket (bucket_to_u64()) for the read and fragmentation lrus, a
+//! stripe index for the stripe lru. It's encoded into a bpos as inode = id <<
+//! LRU_TIME_BITS | time, offset = target, so the bpos order is (id, time,
+//! target): an lru is one contiguous range, oldest first. LruPos is that
+//! position, its own type rather than a bpos, converted only at the btree.
+//!
+//! What an id means - LruId - is a function of the id: ranges of it are the
+//! per-device lrus, the device a part of the id. The raw id is what's stored
+//! and ordered by, never the decoded LruId.
+//!
+//! lru.h's inlines are the same encoding, for C's callers.
+
+use crate::alloc::background::alloc_to_v4;
+use crate::alloc::buckets::u64_to_bucket;
+use crate::btree::bkey::prelude::*;
+use crate::btree::bkey::{pos, spos, BkeySC, POS_MIN, SPOS_MAX};
+use crate::btree::cache::BtreeCachePins;
+use crate::btree::iter::{lockrestart_do, BtreeIter, BtreeIterFlags, BtreeTrans, CommitFlags,
+                         TransAttempt, UpdateTriggerFlags};
+use crate::btree::write_buffer::{WbFlush, WbMaybeFlush};
+use crate::c;
+use crate::errcode::{ret_to_c, BchError};
+use crate::fs::Fs;
+use crate::init::error::{id, BkeyValidate};
+use crate::init::progress::Progress;
+use crate::util::ffi::Opaque;
+use crate::util::rcu::read_lock;
+use crate::util::Printbuf;
+use crate::{bkey_fsck_err_on, fsck_err};
+use core::ffi::c_int;
+use core::ops::RangeInclusive;
+use cstruct_macros::c_export;
+
+/// What an lru id says: which lru, and for a per-device one, the device.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LruId {
+    Read { dev: u32 },
+    Fragmentation { dev: u32 },
+    /// Before per_dev_fragmentation_lru: one lru for every device's buckets
+    FragmentationOld,
+    Stripes,
+    /// None of ours: check_lrus() deletes its entries
+    Unknown(u16),
+}
+
+impl From<u16> for LruId {
+    fn from(id: u16) -> Self {
+        let id32 = u32::from(id);
+
+        if id32 < c::BCH_LRU_READ_MAX {
+            Self::Read { dev: id32 }
+        } else if (c::BCH_LRU_BUCKET_FRAGMENTATION_START..c::BCH_LRU_BUCKET_FRAGMENTATION_END).contains(&id32) {
+            Self::Fragmentation { dev: id32 - c::BCH_LRU_BUCKET_FRAGMENTATION_START }
+        } else if id32 == c::BCH_LRU_BUCKET_FRAGMENTATION_OLD {
+            Self::FragmentationOld
+        } else if id32 == c::BCH_LRU_STRIPE_FRAGMENTATION {
+            Self::Stripes
+        } else {
+            Self::Unknown(id)
+        }
+    }
+}
+
+impl LruId {
+    /// The inverse of From<u16>: a device past its lru's id range is a bug.
+    pub fn id(self) -> u16 {
+        let id = match self {
+            Self::Read { dev }          => dev,
+            Self::Fragmentation { dev } => c::BCH_LRU_BUCKET_FRAGMENTATION_START + dev,
+            Self::FragmentationOld      => c::BCH_LRU_BUCKET_FRAGMENTATION_OLD,
+            Self::Stripes               => c::BCH_LRU_STRIPE_FRAGMENTATION,
+            Self::Unknown(id)           => u32::from(id),
+        } as u16;
+
+        debug_assert_eq!(Self::from(id), self);
+        id
+    }
+
+    /// Its type, an unknown id's being read, as lru_type() has it: its
+    /// entries' targets are read as buckets.
+    pub fn lru_type(self) -> c::bch_lru_type {
+        use c::bch_lru_type as T;
+
+        match self {
+            Self::Read { .. } | Self::Unknown(_)           => T::BCH_LRU_read,
+            Self::Fragmentation { .. } | Self::FragmentationOld => T::BCH_LRU_fragmentation,
+            Self::Stripes                                  => T::BCH_LRU_stripes,
+        }
+    }
+}
+
+/// A position in the lru btree. Ordered as the bpos it's encoded in -
+/// (id, time, target) - so an lru is one contiguous range, oldest first.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub struct LruPos {
+    pub id:     u16,
+    /// LRU_TIME_BITS wide
+    pub time:   u64,
+    pub target: u64,
+}
+
+impl LruPos {
+    pub fn new(id: u16, time: u64, target: u64) -> Self {
+        debug_assert!(time <= c::LRU_TIME_MAX);
+        Self { id, time, target }
+    }
+
+    /// Any position in the lru btree decodes: an id is all of inode's top
+    /// bits.
+    pub fn from_bpos(p: c::bpos) -> Self {
+        Self {
+            id:     (p.inode >> c::LRU_TIME_BITS) as u16,
+            time:   p.inode & c::LRU_TIME_MAX,
+            target: p.offset,
+        }
+    }
+
+    pub fn to_bpos(self) -> c::bpos {
+        pos(u64::from(self.id) << c::LRU_TIME_BITS | self.time, self.target)
+    }
+
+    /// Every position of lru @id: lru_start()..=lru_end().
+    pub fn range(id: LruId) -> RangeInclusive<Self> {
+        Self::new(id.id(), 0, 0)..=Self::new(id.id(), c::LRU_TIME_MAX, u64::MAX)
+    }
+
+    pub fn lru_id(self) -> LruId {
+        LruId::from(self.id)
+    }
+
+    /// The key the entry is for: lru_pos_to_bp().
+    pub fn backing(self) -> c::bbpos {
+        match self.lru_id().lru_type() {
+            c::bch_lru_type::BCH_LRU_stripes => c::bbpos {
+                btree: c::btree_id::stripes,
+                pos:   pos(0, self.target),
+            },
+            _ => c::bbpos {
+                btree: c::btree_id::alloc,
+                pos:   u64_to_bucket(self.target),
+            },
+        }
+    }
+}
+
+/// The bch_lru_type names, by type: bch2_lru_types[].
+macro_rules! lru_type_strs {
+    ($(($n:ident)),* $(,)?) => { [$(stringify!($n)),*] };
+}
+const LRU_TYPE_STRS: [&str; 3] = c::BCH_LRU_TYPES!(lru_type_strs);
+
+fn lru_type_str(t: c::bch_lru_type) -> &'static str {
+    LRU_TYPE_STRS.get(t.0 as usize).copied().unwrap_or("(unknown)")
+}
+
+// ── The key type ─────────────────────────────────────────────────────────
+//
+// An lru entry is a KEY_TYPE_set; KEY_TYPE_lru, with an idx, is obsolete.
+
+fn lru_validate(v: &BkeyValidate<'_, '_>) -> Result<(), BchError> {
+    bkey_fsck_err_on!(v, LruPos::from_bpos(v.k.k.p).time == 0, id::lru_entry_at_time_0,
+                      "lru entry at time=0")
+}
+
+#[c_export]
+pub fn bch2_lru_validate(c: &Opaque<c::bch_fs>, k: BkeySC<'_>, from: &c::bkey_validate_context) -> c_int {
+    ret_to_c(lru_validate(&BkeyValidate { fs: Fs::from_c(c), k, from }))
+}
+
+#[cold]
+#[c_export]
+pub fn bch2_lru_to_text(out: &mut Printbuf, _c: &Opaque<c::bch_fs>, k: BkeySC<'_>) {
+    write!(out, "idx {}", k.arm::<c::Lru>().expect("an lru key").v().idx.get());
+}
+
+// ── Setting entries ──────────────────────────────────────────────────────
+
+/// Set or clear @pos's bit - there's none at time 0: nothing to do.
+pub(crate) fn lru_mod(t: &TransAttempt<'_, '_>, pos: LruPos, set: bool) -> Result<(), BchError> {
+    if pos.time == 0 {
+        return Ok(());
+    }
+    t.bit_mod_buffered(c::btree_id::lru, pos.to_bpos(), set)
+}
+
+/// Move @target's entry in lru @id from @old_time to @new_time:
+/// bch2_lru_change().
+pub fn lru_change(t: &TransAttempt<'_, '_>, id: LruId, target: u64, old_time: u64, new_time: u64)
+    -> Result<(), BchError>
+{
+    if old_time == new_time {
+        return Ok(());
+    }
+    let pos = |time| LruPos::new(id.id(), time, target);
+    lru_mod(t, pos(old_time), false)?;
+    lru_mod(t, pos(new_time), true)
+}
+
+/// bch2_lru_change()'s slow path, with old_time != new_time.
+///
+/// # Safety
+/// @trans is in an attempt.
+#[c_export]
+pub unsafe extern "C" fn __bch2_lru_change<'t>(trans: &'t BtreeTrans<'t>, lru_id: u16,
+                                               dev_bucket: u64, old_time: u64, new_time: u64) -> c_int {
+    let t = unsafe { trans.attempt_in_progress() };
+    ret_to_c(lru_change(&t, LruId::from(lru_id), dev_bucket, old_time, new_time))
+}
+
+// ── Removing a device ────────────────────────────────────────────────────
+
+/// Every entry of device @dev's buckets, wherever they are - the old
+/// fs-wide fragmentation lru's are mixed in with every device's.
+fn dev_remove_lrus_scan(fs: &Fs, dev: u32) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+    let mut iter = BtreeIter::new(&trans, c::btree_id::lru, POS_MIN, BtreeIterFlags::PREFETCH);
+
+    iter.for_each_commit(&trans, None, CommitFlags::empty(), |t, iter, k| {
+        let bp = LruPos::from_bpos(k.k.p).backing();
+        if bp.btree == c::btree_id::alloc && bp.pos.inode == u64::from(dev) {
+            t.delete_at(iter, UpdateTriggerFlags::empty())?;
+        }
+        Ok(())
+    })
+}
+
+/// Lru @id's entries, all of it.
+fn dev_remove_lru_range(fs: &Fs, id: LruId) -> Result<(), BchError> {
+    let range = LruPos::range(id);
+    // In a transaction of its own, not the trans's delete_range(), whose
+    // transaction_restart_nested this has no attempt to begin again for. The
+    // end is inclusive: lru_end(), not the next lru's start.
+    fs.btree_delete_range(c::btree_id::lru, range.start().to_bpos(), range.end().to_bpos(),
+                          BtreeIterFlags::empty(), UpdateTriggerFlags::empty())
+}
+
+/// The entries of device @ca's buckets, as it's removed: its own lrus, if it
+/// has them - a device past the per-device lrus' ids has its entries found
+/// by scanning - and before per_dev_fragmentation_lru, the fs-wide
+/// fragmentation lru's, found by scanning.
+pub(crate) fn dev_remove_lrus(fs: &Fs, ca: &c::bch_dev) -> Result<(), BchError> {
+    crate::btree_trans!(fs).write_buffer_flush_sync()?;
+
+    let dev = u32::from(ca.dev_idx);
+    if dev < c::BCH_LRU_READ_MAX {
+        dev_remove_lru_range(fs, LruId::Read { dev })?;
+        dev_remove_lru_range(fs, LruId::Fragmentation { dev })?;
+    } else {
+        dev_remove_lrus_scan(fs, dev)?;
+    }
+
+    if !per_dev_fragmentation_lru(fs) {
+        dev_remove_lrus_scan(fs, dev)?;
+    }
+    Ok(())
+}
+
+/// Whether the upgrade to the per-device fragmentation lrus is done: before
+/// it, entries can be in the old fs-wide one.
+pub(crate) fn per_dev_fragmentation_lru(fs: &Fs) -> bool {
+    fs.version_upgrade_complete().0 >=
+        c::bcachefs_metadata_version::bcachefs_metadata_version_per_dev_fragmentation_lru.0
+}
+
+// ── fsck ─────────────────────────────────────────────────────────────────
+
+/// That the entry at @pos, which @referring_k - an alloc or stripe key - says
+/// it has, is there: set it if not, as fsck says. The write buffer is flushed
+/// first, in case it's there, once per referring key - @last_flushed's.
+pub(crate) fn lru_check_set(
+    t:                &TransAttempt<'_, '_>,
+    pos:              LruPos,
+    referring_k:      BkeySC<'_>,
+    mut last_flushed: WbFlush<'_>,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+    let mut iter = BtreeIter::new(t, c::btree_id::lru, pos.to_bpos(), BtreeIterFlags::empty());
+    let lru_k = iter.peek_slot(t)?.expect("a slot always has a key");
+
+    if lru_k.k.type_ != c::bch_bkey_type::KEY_TYPE_set.0 as u8 {
+        last_flushed.maybe_flush(t, referring_k)?;
+
+        if fsck_err!(t, id::alloc_key_to_missing_lru_entry, "missing {} lru entry at pos {}\n{}",
+                     lru_type_str(pos.lru_id().lru_type()), iter.pos(), referring_k.to_text(fs))? {
+            lru_mod(t, pos, true)?;
+        }
+    }
+    Ok(())
+}
+
+/// The time @k says its entry in an lru of type @ty is at - 0, none:
+/// bkey_lru_type_idx().
+fn expected_time(fs: &Fs, ty: c::bch_lru_type, k: BkeySC<'_>) -> u64 {
+    use c::bch_lru_type as T;
+
+    match ty {
+        T::BCH_LRU_read => alloc_to_v4(k).lru_idx_read(),
+        T::BCH_LRU_fragmentation => {
+            let a = alloc_to_v4(k);
+            let rcu = read_lock();
+            fs.dev_rcu(k.k.p.inode as u32, &rcu).map_or(0, |ca| a.lru_idx_fragmentation(ca))
+        }
+        T::BCH_LRU_stripes => k.arm::<c::Stripe>().map_or(0, |s| s.v().lru_pos()),
+        t => unreachable!("lru type {}", t.0),
+    }
+}
+
+/// That the entry at @lru_k is in the lru its target's key says, at the time
+/// it says - deleting it if not, as fsck says.
+fn check_lru_key(
+    t:            &TransAttempt<'_, '_>,
+    lru_iter:     &BtreeIter<'_>,
+    lru_k:        BkeySC<'_>,
+    last_flushed: &mut WbMaybeFlush,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+    let pos = LruPos::from_bpos(lru_k.k.p);
+    let lru = pos.lru_id();
+
+    // per_dev_fragmentation_lru upgrade: the old fs-wide fragmentation lru is
+    // deleted, its entries not checked - check_alloc_to_lru_refs recreates
+    // them in the per-device lrus, from the alloc btree
+    if lru == LruId::FragmentationOld && !per_dev_fragmentation_lru(fs) {
+        return t.bit_mod_buffered(c::btree_id::lru, lru_iter.pos(), false);
+    }
+
+    let bp = pos.backing();
+    let mut iter = BtreeIter::new(t, bp.btree, bp.pos, BtreeIterFlags::empty());
+    let k = iter.peek_slot(t)?.expect("a slot always has a key");
+
+    let ty = lru.lru_type();
+    let time = expected_time(fs, ty, k);
+
+    // The read and bucket fragmentation lrus are per-device: the lru its
+    // bucket's device says, by the raw id - a corrupt target's device needn't
+    // be one an lru id can name. That's also what deletes stragglers in the old
+    // fs-wide fragmentation lru after the upgrade.
+    let bucket_dev = u64_to_bucket(pos.target).inode as u16;
+    let want_id = match ty {
+        c::bch_lru_type::BCH_LRU_read          => bucket_dev,
+        c::bch_lru_type::BCH_LRU_fragmentation => (c::BCH_LRU_BUCKET_FRAGMENTATION_START as u16)
+                                                    .wrapping_add(bucket_dev),
+        _                                      => pos.id,
+    };
+
+    if pos.id != want_id || pos.time != time {
+        last_flushed.maybe_flush(t, lru_k)?;
+
+        if fsck_err!(t, id::lru_entry_bad,
+                     "incorrect lru entry: lru {}, expected id {} time {}\n{}\nfor {}",
+                     lru_type_str(ty), want_id, time, lru_k.to_text(fs), k.to_text(fs))? {
+            return t.bit_mod_buffered(c::btree_id::lru, lru_iter.pos(), false);
+        }
+    }
+    Ok(())
+}
+
+/// Pin lru @lru's backing keys in the btree node cache: a per-device lru's
+/// are its device's slice of the alloc btree, the stripe lru's the stripes
+/// btree. The others' entries - the old fs-wide fragmentation lru, ids nothing
+/// uses - are scattered or bogus, stragglers to be deleted: no pin.
+fn pin_backing(trans: &BtreeTrans<'_>, pins: &BtreeCachePins<'_>, lru: LruId) -> Result<(), BchError> {
+    let (btree, start, end) = match lru {
+        LruId::Read { dev } | LruId::Fragmentation { dev } =>
+            (c::btree_id::alloc, pos(dev.into(), 0), spos(dev.into(), u64::MAX, u32::MAX)),
+        LruId::Stripes =>
+            (c::btree_id::stripes, POS_MIN, SPOS_MAX),
+        LruId::FragmentationOld | LruId::Unknown(_) => {
+            pins.unpin();
+            return Ok(());
+        }
+    };
+    let mask = 1 << btree.0;
+    let end = c::bbpos { btree, pos: end };
+    let pinned_end = pins.pin(trans, mask, mask, c::bbpos { btree, pos: start }..=end)?;
+
+    if pinned_end != end {
+        let fs = trans.fs();
+        crate::bch_warn_ratelimited!(fs,
+            "memory budget ({}% of ram) exhausted pinning btree {btree} at {}, requested range end {}; \
+             continuing, lookups past this point will be uncached",
+            fs.opts.fsck_memory_usage_percent, pinned_end.pos, end.pos);
+    }
+    Ok(())
+}
+
+/// Every lru entry, an lru at a time, its backing keys pinned in the btree
+/// node cache: the lookups are random-order, so on a cold cache that turns a
+/// read per key into cache hits.
+fn check_lrus(fs: &Fs) -> Result<(), BchError> {
+    let trans = &crate::btree_trans!(fs);
+    let pins = fs.btree_cache_pins();
+    let mut last_flushed = WbMaybeFlush::new()?;
+    let progress = Progress::recovery(fs, c"bch2_check_lrus", &[c::btree_id::lru], &[]);
+    let mut next = POS_MIN;
+
+    loop {
+        // The next lru with entries
+        let Some(id) = lockrestart_do(trans, |t| {
+            let mut iter = BtreeIter::new(t, c::btree_id::lru, next, BtreeIterFlags::empty());
+            Ok(iter.peek(t)?.map(|k| LruPos::from_bpos(k.k.p).id))
+        })? else { return Ok(()) };
+
+        let lru = LruId::from(id);
+        pin_backing(trans, &pins, lru)?;
+
+        let range = LruPos::range(lru);
+        let mut iter = BtreeIter::new(trans, c::btree_id::lru, range.start().to_bpos(),
+                                      BtreeIterFlags::PREFETCH);
+        iter.for_each_max_commit(trans, range.end().to_bpos(), BtreeIterFlags::PREFETCH, None,
+                                 CommitFlags::NO_ENOSPC, |t, iter, k| {
+            progress.update(t, iter)?;
+            last_flushed.inc();
+            check_lru_key(t, iter, k, &mut last_flushed)
+        })?;
+
+        let Some(id) = id.checked_add(1) else { return Ok(()) };
+        next = LruPos::new(id, 0, 0).to_bpos();
+    }
+}
+
+crate::recovery_pass!(bch2_check_lrus => check_lrus);
