diff --git a/fs/bcachefs/data/reconcile/check.rs b/fs/bcachefs/data/reconcile/check.rs
new file mode 100644
index 0000000..a251e41
--- /dev/null
+++ b/fs/bcachefs/data/reconcile/check.rs
@@ -0,0 +1,550 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Reconcile's check pass, check_reconcile_work - check.c's:
+//!
+//! - the work btrees against what the data btrees' keys say they need: the
+//!   data btree and the three work btrees walked side by side, in the work
+//!   btrees' positions - data_to_rb_work_pos() - with the keys' reconcile
+//!   options brought up to date on the way
+//! - the reconcile phys bits, a backpointer's cache of its extent's work,
+//!   against the extent - from the extent's side there - and the phys btrees
+//!   against the backpointers' bits, walked side by side the same way
+//! - btree node pointers' reconcile backpointers, both ways
+//! - stripes' can_widen against the pool they'd widen into
+//!
+//! A walk side by side is peek_parallel()'s: an iterator that's ahead has no
+//! key at the walk's position, where C overwrote its iter->k with a deleted
+//! one.
+
+use crate::alloc::backpointers::{backpointer_get_key, backpointers_match, bp_reconcile_phys, extent_ptr_to_bp};
+use crate::alloc::capacity::DiskReservation;
+use crate::alloc::check_backpointers::check_bp_exists;
+use crate::btree::bkey::{bpos_ge, pos, BkeyI, BkeySC, BkeyV, BkeyVMut, POS_MIN};
+use crate::btree::iter::{commit_do, lockrestart_do, peek_parallel, BtreeIter, BtreeIterFlags, BtreeLevels,
+                         BtreeTrans, CommitFlags, TransAttempt, TransBkey, UpdateTriggerFlags};
+use crate::btree::write_buffer::WbMaybeFlush;
+use crate::c;
+use crate::data::ec::stripe::WidenCache;
+use crate::data::ptrs::{BkeyVPtrs, BtreePtrs, Ptrs, PtrsMut};
+use crate::data::reconcile::needs_reconcile::update_reconcile_opts;
+use crate::data::reconcile::trigger::{add_reconcile_bp, data_to_rb_work_pos, rb_bp, rb_work_to_data_pos,
+                                      BkeyVReconcile};
+use crate::errcode::{ret_to_c, BchError};
+use crate::fs::Fs;
+use crate::init::error::id;
+use crate::inode_opts::{get_io_opts, PerSnapshotIoOpts};
+use crate::util::ffi::Opaque;
+use crate::util::log::{LogLevel, LogMsg};
+use crate::util::printbuf::Msg;
+use crate::util::vstructs::plain_bytes;
+use crate::util::Printbuf;
+use crate::{fsck_err, fsck_err_on, prt, SPOS_MAX};
+use core::ffi::c_int;
+use core::mem::size_of;
+use cstruct_macros::c_export;
+
+const NO_ENOSPC: CommitFlags = CommitFlags::NO_ENOSPC;
+
+/// The work btree a walk position's bit is in, and its key there if it has one.
+type WorkKey<'k, 't> = (&'k BtreeIter<'t>, Option<BkeySC<'k>>);
+
+/// Which of @keys' btrees have a key at the walk's position, a bit per btree.
+fn btrees_set(keys: &[WorkKey<'_, '_>]) -> u64 {
+    keys.iter().filter(|(_, k)| k.is_some()).fold(0, |m, (iter, _)| m | 1 << iter.btree().0)
+}
+
+/// What btree @want and set mask @set say, for a mismatch's message.
+fn btrees_to_text(out: &mut Printbuf, want: Option<c::btree_id>, set: u64) {
+    match want {
+        Some(b) => write!(out, "{b}"),
+        None    => write!(out, "(none)"),
+    }
+    write!(out, "\nbut set in: ");
+    crate::util::names::prt_set::<c::btree_id>(out, set);
+}
+
+/// The bit at @pos in work btree @iter's made whether it's @want's:
+/// fix_reconcile_work_btree().
+fn fix_work_btree(t: &TransAttempt<'_, '_>, want: Option<c::btree_id>, pos: c::bpos,
+                  (iter, k): WorkKey<'_, '_>) -> Result<(), BchError> {
+    let should = Some(iter.btree()) == want;
+    let have = k.is_some_and(|k| k.k.key_type() == c::bch_bkey_type::KEY_TYPE_set);
+
+    if should != have {
+        t.bit_mod_buffered(iter.btree(), pos, should)?;
+    }
+    Ok(())
+}
+
+/// A backpointer's reconcile phys bits mirror its extent's work, when the
+/// pointer's on a rotational device - see extent_ptr_to_bp() - set when the
+/// backpointer is made, so they go stale if the device's rotational flag
+/// changes while the work's pending. @bp's made @want, its phys btree entries
+/// moved with them: backpointer_set_reconcile_phys().
+fn backpointer_set_reconcile_phys(t: &TransAttempt<'_, '_>, bp: BkeySC<'_, c::Backpointer>,
+                                  want: c::reconcile_work_id) -> Result<(), BchError> {
+    let have = bp.v().reconcile_work_phys();
+
+    let mut n = t.bkey_make_mut_noupdate(bp)?;
+    n.v_mut().set_reconcile_work_phys(want);
+
+    if let Some(btree) = have.phys_btree() {
+        t.bit_mod_buffered(btree, bp.k.p, false)?;
+    }
+    if let Some(btree) = want.phys_btree() {
+        t.bit_mod_buffered(btree, bp.k.p, true)?;
+    }
+    t.update_buffered(c::btree_id::backpointers, &n)
+}
+
+/// @bp's reconcile phys bits, not @want - for @extent, if it's found -
+/// reported, and fixed: whether they were. reconcile_phys_wrong().
+fn reconcile_phys_wrong(t: &TransAttempt<'_, '_>, bp: BkeySC<'_, c::Backpointer>, want: c::reconcile_work_id,
+                        extent: Option<BkeySC<'_>>) -> Result<bool, BchError> {
+    let fs = t.fs();
+    let for_extent = Msg(|out: &mut Printbuf| if let Some(e) = extent {
+        prt!(out, "\nfor {}", e.to_text(fs));
+    });
+
+    if fsck_err!(t, id::backpointer_reconcile_phys_wrong, "backpointer reconcile phys should be {}, is {}\n{}{}",
+                 want, bp.v().reconcile_work_phys(), bp.untyped().to_text(fs), for_extent)? {
+        backpointer_set_reconcile_phys(t, bp, want)?;
+        return Ok(true);
+    }
+    Ok(false)
+}
+
+/// The "should be set, isn't" direction: only an extent knows its work, and
+/// only extents with work past pending have phys bits to check - so this
+/// costs a backpointer lookup per pointer, but only on those:
+/// check_extent_reconcile_phys().
+fn check_extent_reconcile_phys(t: &TransAttempt<'_, '_>, btree: c::btree_id, k: BkeySC<'_>,
+                               last_flushed: &mut WbMaybeFlush) -> Result<(), BchError> {
+    let fs = t.fs();
+    let Some(kp) = k.arm::<Ptrs>() else { return Ok(()) };
+
+    for d in kp.ptrs_decoded(fs) {
+        if u32::from(d.p.ptr.dev()) == c::BCH_SB_MEMBER_INVALID {
+            continue;
+        }
+
+        let mut want = extent_ptr_to_bp(fs, btree, 0, k, &d);
+
+        let mut bp_iter = BtreeIter::new(t, want.v.bp_btree(), want.k.p, BtreeIterFlags::empty());
+        let bp_k = bp_iter.peek_slot(t)?.expect("a slot");
+
+        // Someone else's, or stale: repaired as check_extents_to_backpointers
+        // would - that only looks where a bucket's sector counts don't add
+        // up, and a stale backpointer's can. Missing too: replacing a stale
+        // one deletes it, committing, and a restart loses the insert.
+        let Some(bp) = bp_k.arm::<c::Backpointer>().filter(|bp| backpointers_match(bp.v(), &want.v)) else {
+            check_bp_exists(t, kp, &mut want, last_flushed.borrow())?;
+            continue;
+        };
+
+        let want_w = want.v.reconcile_work_phys();
+        if bp.v().reconcile_work_phys() == want_w {
+            continue;
+        }
+
+        last_flushed.maybe_flush(t, k)?;
+        reconcile_phys_wrong(t, bp, want_w, Some(k))?;
+    }
+    Ok(())
+}
+
+/// One step of the walk of data btree @data_iter's against the work btrees
+/// @rb - work, hipri, pending - from @cur_pos, a work btree position, left
+/// where the step was: check_reconcile_work_one().
+fn check_reconcile_work_one<'t>(t: &TransAttempt<'_, 't>, data_iter: &mut BtreeIter<'t>, rb: &mut [BtreeIter<'t>; 3],
+                            s: &mut PerSnapshotIoOpts, last_flushed: &mut WbMaybeFlush, cur_pos: &mut c::bpos)
+    -> Result<(), BchError>
+{
+    let fs = t.fs();
+    let btree = data_iter.btree();
+    let data_pos = rb_work_to_data_pos(*cur_pos).pos;
+
+    data_iter.set_pos(data_pos);
+    for iter in rb.iter_mut() {
+        iter.set_pos(*cur_pos);
+    }
+
+    let [rb_w, rb_h, rb_p] = rb;
+    if rb_w.peek(t)?.is_some_and(|k| k.k.key_type() == c::bch_bkey_type::KEY_TYPE_cookie) {
+        t.delete_at(rb_w, UpdateTriggerFlags::empty())?;
+        t.commit_lazy(None, NO_ENOSPC)?;
+    }
+
+    // what the data btree has at the walk's position, if it's ahead: for the
+    // write buffer flush to remember as flushed for
+    let mut deleted = BkeyI::<c::Deleted>::new();
+    deleted.k.p = data_pos;
+
+    let (pos, [(data_iter, data_k), work @ ..]) = peek_parallel(t, [data_iter, rb_w, rb_h, rb_p], |i, iter| {
+        if i == 0 { data_to_rb_work_pos(btree, iter.pos()) } else { iter.pos() }
+    })?;
+
+    *cur_pos = pos;
+    if bpos_ge(pos, data_to_rb_work_pos(btree, SPOS_MAX)) {
+        return Ok(());
+    }
+
+    let work_id = data_k.map_or(c::reconcile_work_id::RECONCILE_WORK_none, |k| k.reconcile_work_id(fs));
+    let want = work_id.btree();
+    let set = btrees_set(&work);
+
+    if set != want.map_or(0, |b| 1 << b.0) {
+        let shown = match data_k { Some(k) => k, None => BkeySC::<c::Deleted>::from(&deleted).untyped() };
+        last_flushed.maybe_flush(t, shown)?;
+
+        if fsck_err!(t, id::reconcile_work_incorrectly_set, "extent should be set in {}\n{}: {}",
+                     Msg(|out: &mut Printbuf| btrees_to_text(out, want, set)), btree, shown.to_text(fs))? {
+            for k in work {
+                fix_work_btree(t, want, pos, k)?;
+            }
+        }
+    }
+
+    let Some(data_k) = data_k else { return Ok(()) };
+
+    if work_id.phys() != c::reconcile_work_id::RECONCILE_WORK_none {
+        check_extent_reconcile_phys(t, btree, data_k, last_flushed)?;
+    }
+
+    let opts = get_io_opts(t, Some(&mut **s), data_k)?;
+    update_reconcile_opts(t, Some(&mut **s), &opts, data_iter, 0, data_k,
+                          c::set_needs_reconcile_ctx::SET_NEEDS_RECONCILE_other)
+}
+
+/// Data btree @btree against the work btrees: check_reconcile_work_data_btree().
+fn check_reconcile_work_data_btree<'t>(trans: &'t BtreeTrans<'t>, btree: c::btree_id, rb: &mut [BtreeIter<'t>; 3],
+                                   s: &mut PerSnapshotIoOpts, last_flushed: &mut WbMaybeFlush)
+    -> Result<(), BchError>
+{
+    let fs = trans.fs();
+    let res = DiskReservation::new(fs);
+    let mut data_iter = BtreeIter::new(trans, btree, POS_MIN, BtreeIterFlags::PREFETCH | BtreeIterFlags::ALL_SNAPSHOTS);
+    let mut cur_pos = data_to_rb_work_pos(btree, POS_MIN);
+    let end = data_to_rb_work_pos(btree, SPOS_MAX);
+    let snapshots = crate::BTREE_HAS_SNAPSHOTS_MASK & 1 << btree.0 != 0;
+
+    loop {
+        res.put();
+
+        commit_do(trans, Some(&res), NO_ENOSPC, |t| {
+            fs.recovery.progress.update(t, &data_iter)?;
+            check_reconcile_work_one(t, &mut data_iter, rb, s, last_flushed, &mut cur_pos)
+        })?;
+        if bpos_ge(cur_pos, end) {
+            return Ok(());
+        }
+
+        cur_pos = if snapshots { cur_pos.successor() } else { cur_pos.nosnap_successor() };
+        last_flushed.inc();
+    }
+}
+
+/// The data btrees - stripes, reflink, extents, the work btrees' order -
+/// against the work btrees: check_reconcile_work_data_btrees().
+fn check_reconcile_work_data_btrees(trans: &BtreeTrans<'_>) -> Result<(), BchError> {
+    let fs = trans.fs();
+    let rb_iter = |btree| BtreeIter::new(trans, btree, POS_MIN, BtreeIterFlags::PREFETCH | BtreeIterFlags::ALL_SNAPSHOTS);
+    let mut rb = [rb_iter(c::btree_id::reconcile_work),
+                  rb_iter(c::btree_id::reconcile_hipri),
+                  rb_iter(c::btree_id::reconcile_pending)];
+
+    let mut s = PerSnapshotIoOpts::new(fs);
+    let mut last_flushed = WbMaybeFlush::new()?;
+
+    fs.recovery.progress.init(fs, c"check_reconcile_work_data_btrees",
+                              &[c::btree_id::extents, c::btree_id::reflink], &[]);
+
+    for btree in [c::btree_id::stripes, c::btree_id::reflink, c::btree_id::extents] {
+        check_reconcile_work_data_btree(trans, btree, &mut rb, &mut s, &mut last_flushed)?;
+    }
+    Ok(())
+}
+
+/// One step of the walk of the backpointers against the phys btrees @phys -
+/// work, hipri - from @cur_pos, left where the step was:
+/// check_reconcile_work_phys_one().
+fn check_reconcile_work_phys_one<'t>(t: &TransAttempt<'_, 't>, bp_iter: &mut BtreeIter<'t>,
+                                 phys: &mut [BtreeIter<'t>; 2], last_flushed: &mut WbMaybeFlush,
+                                 cur_pos: &mut c::bpos) -> Result<(), BchError>
+{
+    let fs = t.fs();
+
+    bp_iter.set_pos(*cur_pos);
+    for iter in phys.iter_mut() {
+        iter.set_pos(*cur_pos);
+    }
+
+    let [r_w, r_h] = phys;
+    let (pos, [(_, bp_k), work @ ..]) = peek_parallel(t, [bp_iter, r_w, r_h], |_, iter| iter.pos())?;
+    *cur_pos = pos;
+    // what the backpointers have at the walk's position, if ahead
+    let mut deleted = BkeyI::<c::Deleted>::new();
+    deleted.k.p = pos;
+
+    let mut bp = bp_k.and_then(|k| k.arm::<c::Backpointer>());
+    let mut w = bp.map_or(c::reconcile_work_id::RECONCILE_WORK_none, |bp| bp.v().reconcile_work_phys());
+
+    // The "set, shouldn't be" direction: what the bits should be is what the
+    // backpointer's extent says, computed as extent_ptr_to_bp() does - so
+    // this and the data btrees' direction can't disagree. Only backpointers
+    // with bits set pay for the lookup.
+    if let Some(bp_v) = bp.filter(|_| w != c::reconcile_work_id::RECONCILE_WORK_none) {
+        let mut iter = BtreeIter::uninit();
+        match backpointer_get_key(t, bp_v, &mut iter, BtreeIterFlags::empty(), last_flushed.borrow())? {
+            None => {
+                // No extent: backpointer_get_key() reported the backpointer
+                // and may have deleted it, committing - don't touch it again.
+                // Its phys btree entry goes below.
+                bp = None;
+                w = c::reconcile_work_id::RECONCILE_WORK_none;
+            }
+            Some((_, k)) => {
+                let want = bp_reconcile_phys(fs, bp_v.v().level.into(), bp_v.k.p.inode as u32, k);
+                if want != w {
+                    last_flushed.maybe_flush(t, bp_v.untyped())?;
+                    // the repair moved its phys btree entry too
+                    if reconcile_phys_wrong(t, bp_v, want, Some(k))? {
+                        return Ok(());
+                    }
+                }
+            }
+        }
+    }
+
+    let want = w.phys_btree();
+    let set = btrees_set(&work);
+
+    if set != want.map_or(0, |b| 1 << b.0) {
+        let shown = match bp { Some(bp) => bp.untyped(), None => BkeySC::<c::Deleted>::from(&deleted).untyped() };
+        last_flushed.maybe_flush(t, shown)?;
+
+        if fsck_err!(t, id::reconcile_work_phys_incorrectly_set, "backpointer should be set in {}\n{}",
+                     Msg(|out: &mut Printbuf| btrees_to_text(out, want, set)), shown.to_text(fs))? {
+            for k in work {
+                fix_work_btree(t, want, pos, k)?;
+            }
+        }
+    }
+    Ok(())
+}
+
+/// The backpointers against the phys btrees: check_reconcile_work_phys().
+fn check_reconcile_work_phys(trans: &BtreeTrans<'_>) -> Result<(), BchError> {
+    let fs = trans.fs();
+    fs.recovery.progress.init(fs, c"check_reconcile_work_phys", &[c::btree_id::backpointers], &[]);
+
+    let mut cur_pos = POS_MIN;
+    let mut bp_iter = BtreeIter::new(trans, c::btree_id::backpointers, POS_MIN, BtreeIterFlags::PREFETCH);
+    let mut phys = [BtreeIter::new(trans, c::btree_id::reconcile_work_phys, POS_MIN, BtreeIterFlags::PREFETCH),
+                    BtreeIter::new(trans, c::btree_id::reconcile_hipri_phys, POS_MIN, BtreeIterFlags::PREFETCH)];
+    let mut last_flushed = WbMaybeFlush::new()?;
+
+    loop {
+        commit_do(trans, None, NO_ENOSPC, |t| {
+            fs.recovery.progress.update(t, &bp_iter)?;
+            check_reconcile_work_phys_one(t, &mut bp_iter, &mut phys, &mut last_flushed, &mut cur_pos)
+        })?;
+        if cur_pos == crate::POS_MAX {
+            return Ok(());
+        }
+
+        cur_pos = cur_pos.nosnap_successor();
+        last_flushed.inc();
+    }
+}
+
+/// btree node pointer @k, at @level in @iter's btree: its reconcile options
+/// brought up to date, and its reconcile backpointer there and its, or made:
+/// check_reconcile_work_btree_key().
+fn check_reconcile_work_btree_key(t: &TransAttempt<'_, '_>, iter: &BtreeIter<'_>, level: u32,
+                                  k: BkeySC<'_, BtreePtrs>) -> Result<(), BchError>
+{
+    let fs = t.fs();
+    let btree = iter.btree();
+    let room = c::BKEY_BTREE_PTR_U64s_MAX as usize * size_of::<u64>();
+
+    let opts = get_io_opts(t, None, k.into())?;
+    update_reconcile_opts(t, None, &opts, iter, level, k.into(),
+                          c::set_needs_reconcile_ctx::SET_NEEDS_RECONCILE_other)?;
+
+    let bp_pos = k.reconcile_bp_pos(fs);
+    // @k, with its reconcile_bp entry made @idx, as the pointer to its node
+    let set_bp = |idx: u64| -> Result<(), BchError> {
+        let mut n: TransBkey<'_, '_, PtrsMut> = t.bkey_reassemble_room(k, room)?.into();
+        n.set_reconcile_bp(fs, idx).expect("room for a reconcile_bp entry: BKEY_BTREE_PTR_U64s_MAX");
+        t.btree_node_update_key_at_pos(btree, level, n)
+    };
+
+    if fsck_err_on!(t, bp_pos.inode != 0 && bp_pos.offset == 0, id::btree_ptr_with_no_reconcile_bp,
+                    "btree ptr with no reconcile \n{}", k.to_text(fs))? {
+        let bp = add_reconcile_bp(t, btree, level, k.into(), bp_pos.inode)?;
+        return set_bp(bp.offset);
+    }
+
+    if fsck_err_on!(t, bp_pos.inode == 0 && bp_pos.offset != 0, id::btree_ptr_with_bad_reconcile_bp,
+                    "btree ptr with bad reconcile \n{}", k.to_text(fs))? {
+        return set_bp(0);
+    }
+
+    if bp_pos == POS_MIN {
+        return Ok(());
+    }
+
+    let want = rb_bp(btree, level, k.into());
+    let mut rb_iter = BtreeIter::new(t, c::btree_id::reconcile_scan, bp_pos, BtreeIterFlags::INTENT);
+    let bp_k = rb_iter.peek_slot(t)?.expect("a slot");
+    let is_bp = bp_k.k.key_type() == c::bch_bkey_type::KEY_TYPE_backpointer;
+
+    if bp_k.arm::<c::Backpointer>().is_some_and(|bp| plain_bytes(bp.v()) == plain_bytes(&want)) {
+        return Ok(());
+    }
+
+    fsck_err!(t, id::btree_ptr_to_bad_reconcile_bp, "btree ptr points to bad/missing reconcile bp\n{}\n{}",
+              k.to_text(fs), bp_k.to_text(fs))?;
+
+    let alloc_bp = |iter: &BtreeIter<'_>| -> Result<(), BchError> {
+        let mut bp = t.bkey_alloc_typed::<c::Backpointer>()?;
+        bp.k_mut().p = iter.pos();
+        *bp.v_mut() = want;
+        t.update(iter, &bp, UpdateTriggerFlags::empty())
+    };
+
+    if !is_bp {
+        return alloc_bp(&rb_iter);
+    }
+
+    // someone else's: ours, in a slot of our work id's
+    let mut slot = BtreeIter::uninit();
+    t.bkey_get_empty_slot(&mut slot, c::btree_id::reconcile_scan, pos(bp_pos.inode, 1), pos(bp_pos.inode, u64::MAX))?;
+    alloc_bp(&slot)?;
+    set_bp(slot.pos().offset)
+}
+
+/// Every btree node pointer, by level - the root's key, then each level's
+/// keys - against its reconcile backpointer: check_reconcile_work_btrees().
+fn check_reconcile_work_btrees(trans: &BtreeTrans<'_>) -> Result<(), BchError> {
+    let fs = trans.fs();
+    let res = DiskReservation::new(fs);
+    fs.recovery.progress.init_mask(fs, c"check_reconcile_work_btrees", 0, !0);
+
+    for btree in 0..fs.btree_id_nr_alive() {
+        if fs.btree_id_root(btree).is_none() {
+            continue;
+        }
+        BtreeLevels { btree: c::btree_id(btree), levels: 1..c::BTREE_MAX_DEPTH, start: POS_MIN, end: SPOS_MAX }
+            .for_each_btree_ptr_commit(trans, Some(&res), NO_ENOSPC, |t, iter, level, k| {
+                res.put();
+                fs.recovery.progress.update(t, iter)?;
+                check_reconcile_work_btree_key(t, iter, level, k)
+            })?;
+    }
+    Ok(())
+}
+
+/// Each btree node backpointer in reconcile_scan - by work id, hipri to
+/// pending - against the node pointer it's to: check_reconcile_btree_bps(),
+/// through reconcile_bp_get_key(), C's still, which reports and deletes one
+/// whose pointer isn't there or isn't its.
+fn check_reconcile_btree_bps(trans: &BtreeTrans<'_>) -> Result<(), BchError> {
+    use c::reconcile_work_id as w;
+    let fs = trans.fs();
+    fs.recovery.progress.init(fs, c"check_reconcile_btree_bps", &[c::btree_id::reconcile_scan], &[]);
+
+    let mut iter = BtreeIter::new(trans, c::btree_id::reconcile_scan, pos(w::RECONCILE_WORK_hipri.0.into(), 0),
+                                  BtreeIterFlags::PREFETCH);
+    iter.for_each_max(trans, pos(w::RECONCILE_WORK_pending.0.into(), u64::MAX), |t, iter, k| {
+        fs.recovery.progress.update(t, iter)?;
+
+        let Some(bp) = k.arm::<c::Backpointer>() else { return Ok(()) };
+        let mut node_iter = BtreeIter::uninit();
+        // SAFETY: @bp, for the call; the key returned isn't kept
+        let ret = unsafe { c::reconcile_bp_get_key(t.raw(), node_iter.raw_mut(), bp.to_c()) };
+        unsafe { crate::btree::iter::bkey_s_c_to_result(ret) }.map(|_| ())
+    })
+}
+
+/// Stripe @k's can_widen against how many data blocks its disk label's RW
+/// members would let it have now - unless a stripes scan, pending, is to
+/// refresh it: check_stripe_can_widen_one(). The reconcile_scan_stripes pass
+/// refreshes it when devices' RW state changes, and get_old_stripe() demotes
+/// it lazily on reuse; this surfaces one stuck out of sync.
+fn check_stripe_can_widen_one(t: &TransAttempt<'_, '_>, iter: &BtreeIter<'_>, k: BkeySC<'_>,
+                              cache: &mut WidenCache, scan_pending: bool) -> Result<(), BchError> {
+    let fs = t.fs();
+    let Some(s) = k.arm::<c::Stripe>() else { return Ok(()) };
+    let v = s.v();
+
+    let correct = cache.can_widen(fs, v)?;
+
+    if v.can_widen() == correct || scan_pending {
+        return Ok(());
+    }
+
+    if fsck_err!(t, id::stripe_can_widen_wrong, "stripe can_widen={}, should be {}\n{}",
+                 v.can_widen(), correct, k.to_text(fs))? {
+        let mut u = t.bkey_make_mut(iter, s, UpdateTriggerFlags::empty())?;
+        u.v_mut().bits.set_can_widen(correct);
+    }
+    Ok(())
+}
+
+/// Stripes' can_widen: check_stripe_can_widen().
+fn check_stripe_can_widen(trans: &BtreeTrans<'_>) -> Result<(), BchError> {
+    let fs = trans.fs();
+    fs.recovery.progress.init(fs, c"check_stripe_can_widen", &[c::btree_id::stripes], &[]);
+
+    let mut cache = WidenCache::new();
+    let scan_pending = lockrestart_do(trans, |t| {
+        t.scan_requested(c::reconcile_scan::from_arm(c::reconcile_scan_stripes {}))
+    })?;
+
+    let mut iter = BtreeIter::new(trans, c::btree_id::stripes, POS_MIN, BtreeIterFlags::PREFETCH);
+    iter.for_each_commit(trans, None, NO_ENOSPC, |t, iter, k| {
+        fs.recovery.progress.update(t, iter)?;
+        check_stripe_can_widen_one(t, iter, k, &mut cache, scan_pending)
+    })
+}
+
+/// The check_reconcile_work recovery pass: bch2_check_reconcile_work().
+fn check_reconcile_work(fs: &Fs) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+    check_reconcile_work_data_btrees(&trans)?;
+    check_reconcile_work_phys(&trans)?;
+    check_reconcile_work_btrees(&trans)?;
+    check_reconcile_btree_bps(&trans)?;
+    check_stripe_can_widen(&trans)
+}
+
+#[c_export]
+pub fn bch2_check_reconcile_work(c: &Opaque<c::bch_fs>) -> c_int {
+    ret_to_c(check_reconcile_work(Fs::from_c(c)))
+}
+
+/// Flipping device @ca's rotational flag leaves the reconcile phys bits of
+/// backpointers made under the old setting stale, and deletes after it miss
+/// their phys btree entries - expected, not damage: check_reconcile_work is
+/// scheduled to repair them, quietly.
+pub fn rotational_changed(fs: &Fs, ca: &c::bch_dev) {
+    let mut msg = LogMsg::with_level(fs, LogLevel::INFO);
+    write!(msg, "{}: rotational changed, repairing backpointer reconcile phys bits\n",
+           ca);
+
+    // Silence first, in its own write: an online pass starts as soon as it's
+    // scheduled, and has to see the silenced errors
+    {
+        let mut w = fs.sb_write();
+        w.set_err_silent(id::backpointer_reconcile_phys_wrong);
+        w.set_err_silent(id::reconcile_work_phys_incorrectly_set);
+    }
+
+    if let Err(e) = crate::init::passes::run_explicit(fs, &mut msg, c::bch_recovery_pass::BCH_RECOVERY_PASS_check_reconcile_work,
+                                                      c::bch_run_recovery_pass_flags::from_bits_retain(0)) {
+        write!(msg, "error scheduling check_reconcile_work: {e}\n");
+        msg.set_level(LogLevel::ERR);
+    }
+}
diff --git a/fs/bcachefs/data/reconcile/format.rs b/fs/bcachefs/data/reconcile/format.rs
new file mode 100644
index 0000000..8bdc9d8
--- /dev/null
+++ b/fs/bcachefs/data/reconcile/format.rs
@@ -0,0 +1,217 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use cstruct_macros::{bitfield, c_const, c_enum, c_xmacro, CStruct};
+
+/*
+ * rebalance on disk data structures:
+ *
+ * extents will contain a bch_extent_reconcile if they have background
+ * processing pending; additionally, indirect extents will always have a
+ * bch_extent_reconcile if they had any io path options set on the inode, since
+ * we don't (yet) have backpointers that would let us look up the "owning" inode
+ * of an indirect extent to recover the io path options.
+ *
+ * We also have 4 btrees for keeping track of pending rebalance work:
+ *
+ * BTREE_ID_reconcile_scan:
+ *   Inum 0:
+ *     Holds "scan cookies", which are created on option change to indicate that
+ *     new options need to be propagated to each extent; this happens before the
+ *     actual data processing.
+ *
+ *     A scan cookie may be for the entire filesystem, a specific device, or a
+ *     specific inode.
+ *
+ *   Inum 1:
+ *     Btree nodes that need background processing cannot be tracked by the
+ *     other rebalance btrees; instead they have backpointers
+ *     (KEY_TYPE_backpointer) created here.
+ *
+ *     This has the added benefit that btree nodes will be processed before
+ *     regular data, which is beneficial if e.g. we're recovering from data
+ *     being degraded.
+ *
+ *  BTREE_ID_reconcile_work:
+ *    The main "pending rebalance work" btree: it's a simple bitset btree where
+ *    a set bit indicates that an an extent in BTREE_ID_extents or
+ *    BTREE_ID_reflink needs to be processed.
+ *
+ *  BTREE_ID_reconcile_hipri:
+ *    If bch_extent_reconcile.hipri is set, the extent will be tracked here
+ *    instead of BTREE_ID_reconcile_work and processed ahead of extents in
+ *    BTREE_ID_reconcile_work; this is so that we can evacuate failed devices
+ *    before other work.
+ *
+ *  BTREE_ID_reconcile_pending:
+ *    If we'd like to move an extent to a specific target, but can't because the
+ *    target is full, we set bch_extent_reconcile.pending and switch to tracking
+ *    it here; pending rebalance work is re-attempted on device resize, add, or
+ *    label change.
+ */
+
+#[bitfield(u64)]
+#[derive(CStruct)]
+pub struct bch_extent_rebalance_v1 {
+    #[bits(default = 1 << c::bch_extent_entry_type::BCH_EXTENT_ENTRY_rebalance_v1.0)]
+    pub(self) type_:                   u6,
+    unused:                            u3,
+
+    promote_target_from_inode:         u1,
+    erasure_code_from_inode:           u1,
+    data_checksum_from_inode:          u1,
+    background_compression_from_inode: u1,
+    data_replicas_from_inode:          u1,
+    background_target_from_inode:      u1,
+
+    promote_target:                    u16,
+    erasure_code:                      u1,
+    data_checksum:                     u4,
+    data_replicas:                     u4,
+    background_compression:            u8, /* enum bch_compression_opt */
+    background_target:                 u16,
+}
+
+#[bitfield(u64)]
+#[derive(CStruct)]
+pub struct bch_extent_reconcile {
+    #[bits(default = 1 << c::bch_extent_entry_type::BCH_EXTENT_ENTRY_reconcile.0)]
+    pub(self) type_:                   u8,
+    unused:                            u2,
+    ptrs_moving:                       u5,
+    hipri:                             u1,
+    pending:                           u1,
+    need_rb:                           u5,
+
+    data_replicas_from_inode:          u1,
+    data_checksum_from_inode:          u1,
+    erasure_code_from_inode:           u1,
+    background_compression_from_inode: u1,
+    background_target_from_inode:      u1,
+    promote_target_from_inode:         u1,
+
+    data_replicas:                     u3,
+    data_checksum:                     u4,
+    erasure_code:                      u1,
+    background_compression:            u8, /* enum bch_compression_opt */
+    background_target:                 u10,
+    promote_target:                    u10,
+}
+
+#[bitfield(u64)]
+#[derive(CStruct)]
+pub struct bch_extent_reconcile_bp {
+    #[bits(default = 1 << c::bch_extent_entry_type::BCH_EXTENT_ENTRY_reconcile_bp.0)]
+    pub(self) type_: u9,
+    idx:   u55,
+}
+
+c_xmacro! {
+    /* subset of BCH_INODE_OPTS */
+    BCH_RECONCILE_OPTS(x) {
+        (data_replicas),
+        (data_checksum),
+        (erasure_code),
+        (background_compression),
+        (background_target),
+        (promote_target),
+    }
+}
+
+c_enum! {
+    #[open]
+    pub enum bch_reconcile_opts: u32 {
+        BCH_RECONCILE_OPTS(n) => BCH_RECONCILE_ ## n,
+    }
+}
+
+impl bch_extent_reconcile {
+    /// An entry with @opts' reconcile options, and whether the inode set
+    /// each: io_opts_to_reconcile_opts(). Truncated to the entry's fields,
+    /// as C's bitfield assignments truncate.
+    pub fn from_io_opts(opts: &c::bch_inode_opts) -> Self {
+        let mut r = Self::new();
+        macro_rules! opts {
+            ($(($name:tt)),* $(,)?) => { crate::paste! { $(
+                let mask = (1u64 << Self::[<$name:upper _BITS>]) - 1;
+                r.[<set_ $name>]((u64::from(opts.$name) & mask) as _);
+                r.[<set_ $name _from_inode>](opts.[<$name _from_inode>]().into());
+            )* } };
+        }
+        c::BCH_RECONCILE_OPTS!(opts);
+        r
+    }
+
+    /// Each of @opts' reconcile options too big for its field - what
+    /// from_io_opts() truncates - as (name, value).
+    pub fn too_big(opts: &c::bch_inode_opts) -> impl Iterator<Item = (&'static str, u64)> {
+        macro_rules! opts {
+            ($(($name:tt)),* $(,)?) => { crate::paste! { [$(
+                (stringify!($name), u64::from(opts.$name), Self::[<$name:upper _BITS>]),
+            )*] } };
+        }
+        c::BCH_RECONCILE_OPTS!(opts).into_iter()
+            .filter(|&(_, v, bits)| v >> bits != 0)
+            .map(|(name, v, _)| (name, v))
+    }
+
+    /// Pointer @i - by index among the key's pointers - marked moving; past
+    /// ptrs_moving's bits it isn't tracked, as C's |= of the bit truncates.
+    pub fn set_ptr_moving(&mut self, i: usize) {
+        if i < Self::PTRS_MOVING_BITS {
+            self.update_ptrs_moving(|m| m | 1 << i);
+        }
+    }
+}
+
+c_xmacro! {
+    BCH_RECONCILE_ACCOUNTING(x) {
+        (replicas, 0),
+        (checksum, 1),
+        (erasure_code, 2),
+        (compression, 3),
+        (target, 4),
+        (high_priority, 5),
+        (pending, 6),
+        (stripes, 7),
+    }
+}
+
+c_enum! {
+    #[open]
+    pub enum bch_reconcile_accounting_type: u32 {
+        BCH_RECONCILE_ACCOUNTING(t, n) => BCH_RECONCILE_ACCOUNTING_ ## t = n,
+        BCH_RECONCILE_ACCOUNTING_NR,
+    }
+}
+
+c_xmacro! {
+    RECONCILE_WORK_IDS(x) {
+        (none),
+        (hipri),
+        (normal),
+        (pending),
+    }
+}
+
+c_enum! {
+    #[open]
+    pub enum reconcile_work_id: u32 {
+        RECONCILE_WORK_IDS(t) => RECONCILE_WORK_ ## t,
+    }
+}
+
+c_const! {
+    #[c_int]
+    pub const RECONCILE_SCAN_COOKIE_device: u32 = 32;
+    #[c_int]
+    pub const RECONCILE_SCAN_COOKIE_stripes: u32 = 3;
+    #[c_int]
+    pub const RECONCILE_SCAN_COOKIE_pending: u32 = 2;
+    #[c_int]
+    pub const RECONCILE_SCAN_COOKIE_metadata: u32 = 1;
+    #[c_int]
+    pub const RECONCILE_SCAN_COOKIE_fs: u32 = 0;
+}
diff --git a/fs/bcachefs/data/reconcile/needs_reconcile.rs b/fs/bcachefs/data/reconcile/needs_reconcile.rs
new file mode 100644
index 0000000..09ccb94
--- /dev/null
+++ b/fs/bcachefs/data/reconcile/needs_reconcile.rs
@@ -0,0 +1,464 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! What a key's reconcile state should be, and setting it - trigger.c's
+//! needs_reconcile family: the reconcile entry its pointers' work and the io
+//! options call for, padding pointers for replicas it's short, a stripe's
+//! needs_reconcile bit; and whether new work is allowed, or an fsck error.
+
+use crate::fsck_err;
+use crate::alloc::disk_groups::Target;
+use crate::btree::bkey::{BkeyS, BkeySC, BkeyV, BkeyVMut, BkeyVal};
+use crate::btree::bkey_methods::TriggerOp;
+use crate::btree::iter::{BtreeIter, BtreeIterFlags, BtreeTrans, TransAttempt, TransBkey, UpdateTriggerFlags};
+use crate::c;
+use crate::data::durability::BkeyVDurability;
+use crate::data::ptrs::{BkeyVPtrs, BkeyVPtrsMut, ExtentEntry, ExtentEntryMut, Ptrs, PtrsMut};
+use crate::data::reconcile::trigger::{extent_reconcile_to_text, BkeyVReconcile};
+use crate::errcode::{ret_to_c, BchError};
+use crate::init::error::id;
+use crate::inode_opts::get_io_opts;
+use crate::util::printbuf::Msg;
+use crate::util::rcu::read_lock;
+use crate::util::vstructs::Validated;
+use crate::util::Printbuf;
+use core::ffi::{c_int, c_uint};
+use core::mem::size_of;
+use cstruct_macros::c_export;
+
+/// Option @o's need_rb bit.
+pub(crate) fn rb_bit(o: c::bch_reconcile_opts) -> u8 {
+    1 << o.0
+}
+
+/// Whether a key should carry @r: while it has work - and a reflink_v while
+/// it has any option its inode set, as it has no inode to take them from
+/// after. bkey_should_have_rb_opts().
+fn should_have_rb_opts(k: &c::bkey, r: &c::bch_extent_reconcile) -> bool {
+    if k.key_type() == c::bch_bkey_type::KEY_TYPE_reflink_v {
+        macro_rules! any_from_inode {
+            ($(($name:tt)),* $(,)?) => { crate::paste! { false $(|| r.[<$name _from_inode>]() != 0)* } };
+        }
+        if c::BCH_RECONCILE_OPTS!(any_from_inode) {
+            return true;
+        }
+    }
+    r.need_rb() != 0
+}
+
+/// What a key's reconcile state should be: needs_reconcile()'s.
+struct NeedsReconcile {
+    r:            c::bch_extent_reconcile,
+    /// Padding pointers to BCH_SB_MEMBER_INVALID to drop, or - negative - to
+    /// add, standing in for replicas the key is short.
+    invalid_devs: i32,
+}
+
+/// What @k's reconcile entry should be for options @opts - the work its
+/// pointers need, and which are moving - and the padding pointers it should
+/// gain or lose; None if it has them already: bch2_bkey_needs_reconcile().
+/// A stripe goes by its needs_reconcile bit: data_replicas work, or none.
+fn needs_reconcile(t: &TransAttempt<'_, '_>, k: BkeySC<'_, Ptrs>, opts: &c::bch_inode_opts)
+    -> Result<Option<NeedsReconcile>, BchError>
+{
+    use c::bch_reconcile_opts as o;
+    let fs = t.fs();
+    let btree = k.k.is_btree_ptr();
+
+    if btree && fs.request_incompat_feature(c::bcachefs_metadata_version::reconcile).is_err() {
+        return Ok(None);
+    }
+
+    let mut r = c::bch_extent_reconcile::from_io_opts(opts);
+    let need = |r: &mut c::bch_extent_reconcile, opt| r.update_need_rb(|n| n | rb_bit(opt));
+
+    let poisoned = k.extent_flags(fs) & 1 << c::bch_extent_flags_e::BCH_EXTENT_FLAG_poisoned.0 != 0;
+    let compression_type = c::bch_compression_opt::to_type(r.background_compression(), fs);
+    let csum_type = if opts.nocow == 0 { fs.data_checksum_type_rb(&r) } else { c::bch_csum_type::BCH_CSUM_none };
+    let stripe = k.k.key_type() == c::bch_bkey_type::KEY_TYPE_stripe;
+
+    let (mut incompressible, mut unwritten, mut ec) = (false, false, false);
+    let (mut invalid, mut ec_redundancy) = (0u32, 0u32);
+    {
+        let rcu = read_lock();
+        for (i, d) in k.ptrs_decoded(fs).enumerate() {
+            let p = &d.p;
+            let dev = u32::from(p.ptr.dev());
+
+            incompressible |= p.crc.compression_type == c::bch_compression_type::BCH_COMPRESSION_TYPE_incompressible.0 as u8;
+            unwritten      |= p.ptr.unwritten() != 0;
+
+            // A stripe block counts for nothing on a device of durability 0 -
+            // missing, evacuating, or set to 0: bch2_stripe_block_dev_bad().
+            // An extent's pointer there is legitimate - a cache device - but a
+            // stripe block there leaves every extent in the stripe short.
+            let evacuating = if stripe {
+                fs.dev_durability(dev, &rcu) == 0
+            } else {
+                fs.dev_bad_or_evacuating(dev, &rcu) && !p.has_ec
+            };
+
+            if !poisoned && !btree && p.ptr.cached() == 0 {
+                if p.crc.csum_type != csum_type.0 as u8 {
+                    need(&mut r, o::BCH_RECONCILE_data_checksum);
+                }
+                if p.crc.compression_type != compression_type.0 as u8 {
+                    need(&mut r, o::BCH_RECONCILE_background_compression);
+                }
+            }
+
+            if !poisoned && !evacuating && p.ptr.cached() == 0 &&
+                r.background_target() != 0 &&
+                !fs.dev_in_target(dev, Target::decode(r.background_target().into()), &rcu) {
+                need(&mut r, o::BCH_RECONCILE_background_target);
+                if dev != c::BCH_SB_MEMBER_INVALID {
+                    r.set_ptr_moving(i);
+                }
+            }
+
+            if evacuating {
+                need(&mut r, o::BCH_RECONCILE_data_replicas);
+                r.set_hipri(1);
+                if dev != c::BCH_SB_MEMBER_INVALID {
+                    r.set_ptr_moving(i);
+                }
+            }
+
+            if p.has_ec && r.erasure_code() != 0 {
+                ec_redundancy = ec_redundancy.max(p.ec.redundancy().into());
+            }
+            ec |= p.has_ec;
+            invalid += u32::from(dev == c::BCH_SB_MEMBER_INVALID);
+        }
+    }
+
+    if let Some(s) = k.arm::<c::Stripe>() {
+        // both ways: a device that stops evacuating leaves the bit set on
+        // stripes that no longer need anything (#929)
+        let needs = r.need_rb() & rb_bit(o::BCH_RECONCILE_data_replicas) != 0;
+        return Ok(if needs != (s.v().needs_reconcile() != 0) {
+            Some(NeedsReconcile { r, invalid_devs: 0 })
+        } else {
+            None
+        });
+    }
+
+    if unwritten || incompressible {
+        r.update_need_rb(|n| n & !rb_bit(o::BCH_RECONCILE_background_compression));
+    }
+    if unwritten {
+        r.update_need_rb(|n| n & !rb_bit(o::BCH_RECONCILE_data_checksum));
+    }
+
+    // whole-key durability: a device shared between the extent's stripes
+    // counted once, which a per-pointer sum can't see
+    let dur = k.durability(t)?;
+    let (durability, acct, min) = (u32::from(dur.total), u32::from(dur.acct), u32::from(dur.min_durability));
+    let replicas = u32::from(r.data_replicas());
+
+    if durability.max(ec_redundancy + 1) < replicas {
+        need(&mut r, o::BCH_RECONCILE_data_replicas);
+        r.set_hipri(1);
+    }
+    if durability >= replicas + min {
+        need(&mut r, o::BCH_RECONCILE_data_replicas);
+    }
+    if !unwritten && (r.erasure_code() != 0) != ec {
+        need(&mut r, o::BCH_RECONCILE_erasure_code);
+    }
+
+    // The EC contribution floored at what the stripe can repair: a removed
+    // stripe device reads as durability_desired 0, dropping acct below
+    // ec_redundancy + 1, but stripe repair restores the block - so no padding
+    // for durability the stripe gets back on its own.
+    let mut invalid_devs = (acct.max(ec_redundancy + 1) as i32 + invalid as i32 - replicas as i32)
+        .min(invalid as i32);
+
+    // more than one pointer to BCH_SB_MEMBER_INVALID is an incompat feature
+    if invalid_devs < 0 && fs.request_incompat_feature(c::bcachefs_metadata_version::reconcile).is_err() {
+        invalid_devs = 0;
+    }
+
+    let old = k.reconcile_opts(fs);
+    if let Some(old) = old.filter(|old| old.need_rb() & !r.need_rb() == 0) {
+        r.set_pending(old.pending());
+        if r.hipri() != 0 && old.hipri() == 0 {
+            r.set_pending(0);
+        }
+    }
+
+    let should_have = should_have_rb_opts(k.k, &r);
+    let changed = invalid_devs != 0 || match old {
+        Some(old) => !should_have || old.into_bits() != r.into_bits(),
+        None      => should_have,
+    };
+
+    Ok((changed && fs.request_incompat_feature(c::bcachefs_metadata_version::sb_field_extent_type_u64s).is_ok())
+        .then_some(NeedsReconcile { r, invalid_devs }))
+}
+
+/// Whether @scan is requested - remembered in @cache once it is: a set
+/// cookie stays set while a walk runs, an unset one can be set any time.
+/// check_reconcile_scan_cookie().
+fn scan_cookie_set(t: &TransAttempt<'_, '_>, scan: c::reconcile_scan, cache: Option<&mut bool>)
+    -> Result<bool, BchError>
+{
+    if cache.as_deref() == Some(&true) {
+        return Ok(true);
+    }
+    let set = t.scan_requested(scan)?;
+    if let Some(cache) = cache {
+        *cache = set;
+    }
+    Ok(set)
+}
+
+/// Whether a scan cookie is set for a device @k points to - @cache, the ones
+/// found set, checked first: check_dev_reconcile_scan_cookie().
+fn dev_scan_cookie_set(t: &TransAttempt<'_, '_>, k: &impl BkeyVPtrs, cache: Option<&mut c::bch_devs_mask>)
+    -> Result<bool, BchError>
+{
+    let fs = t.fs();
+    let devs = || k.ptrs(fs).map(|p| u32::from(p.dev())).filter(|&dev| dev != c::BCH_SB_MEMBER_INVALID);
+
+    if cache.as_deref().is_some_and(|m| devs().any(|dev| m.d.test(dev as usize))) {
+        return Ok(true);
+    }
+    for dev in devs() {
+        if scan_cookie_set(t, c::reconcile_scan::from_arm::<c::reconcile_scan_device>(dev), None)? {
+            if let Some(m) = cache {
+                m.d.set(dev as usize);
+            }
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
+
+/// Whether new work @new_need_rb - pointers that don't match the options -
+/// is allowed: propagating new options, always; a foreground write, except
+/// what it can't match yet (background compression and target, erasure
+/// coding before a stripe exists, replicas lost to a device going away), or
+/// if options changed since it took them; anything with a scan pending, as
+/// that propagates options. Otherwise it's an fsck error: new_needs_rb_allowed().
+///
+/// Checking for scan cookies is cached in @s - only their being set, so a
+/// cookie set meanwhile isn't missed.
+#[allow(clippy::too_many_arguments)]
+fn new_needs_rb_allowed(t: &TransAttempt<'_, '_>, s: Option<&mut c::per_snapshot_io_opts>, k: &impl BkeyVPtrs,
+                        ctx: c::set_needs_reconcile_ctx, opt_change_cookie: u32,
+                        old: Option<&c::bch_extent_reconcile>, new: &c::bch_extent_reconcile,
+                        mut new_need_rb: u8) -> Result<(), BchError> {
+    use c::bch_reconcile_opts as o;
+    use c::set_needs_reconcile_ctx as x;
+    let fs = t.fs();
+
+    if ctx == x::SET_NEEDS_RECONCILE_opt_change || ctx == x::SET_NEEDS_RECONCILE_opt_change_indirect {
+        return Ok(());
+    }
+
+    // foreground writes aren't erasure coded at first, and we may crash
+    // before a stripe is made
+    if new_need_rb & rb_bit(o::BCH_RECONCILE_erasure_code) != 0 &&
+        !k.extent_entries(fs).any(|e| matches!(e, ExtentEntry::stripe_ptr(_))) {
+        new_need_rb &= !rb_bit(o::BCH_RECONCILE_erasure_code);
+    }
+
+    if ctx == x::SET_NEEDS_RECONCILE_foreground {
+        // XXX: a foreground write can end up degraded when a device is
+        // yanked - retries in the write path would fix that, carefully
+        new_need_rb &= !(rb_bit(o::BCH_RECONCILE_background_compression) |
+                         rb_bit(o::BCH_RECONCILE_background_target) |
+                         rb_bit(o::BCH_RECONCILE_data_replicas));
+        // the caller took @opt_change_cookie with its options: if they've
+        // changed since, the write may rightly not match - and a scan for
+        // the new ones is triggered on its own
+        if new_need_rb == 0 || opt_change_cookie != fs.opt_change_cookie.get() {
+            return Ok(());
+        }
+    }
+
+    let (fs_cookie, inum_cookie, dev_cookie) = match s {
+        Some(s) => (Some(&mut s.fs_scan_cookie), Some(&mut s.inum_scan_cookie), Some(&mut s.dev_cookie)),
+        None    => (None, None, None),
+    };
+
+    // btree node pointers follow the metadata options, so theirs is the
+    // metadata cookie
+    if scan_cookie_set(t, c::reconcile_scan::fs(), fs_cookie)? ||
+        if k.k().is_btree_ptr() {
+            scan_cookie_set(t, c::reconcile_scan::from_arm(c::reconcile_scan_metadata {}), None)?
+        } else {
+            scan_cookie_set(t, c::reconcile_scan::from_arm::<c::reconcile_scan_inum>(k.k().p.inode), inum_cookie)?
+        } {
+        return Ok(());
+    }
+
+    if new_need_rb == rb_bit(o::BCH_RECONCILE_data_replicas) && dev_scan_cookie_set(t, k, dev_cookie)? {
+        return Ok(());
+    }
+
+    let old = old.copied().unwrap_or(c::bch_extent_reconcile::from_bits(0));
+    let diff = Msg(|out: &mut Printbuf| {
+        macro_rules! diff {
+            ($(($name:tt)),* $(,)?) => { crate::paste! { $(
+                if new_need_rb & rb_bit(o::[<BCH_RECONCILE_ $name>]) != 0 {
+                    write!(out, "\n{} {} != {}", stringify!($name), old.$name(), new.$name());
+                }
+            )* } };
+        }
+        c::BCH_RECONCILE_OPTS!(diff);
+    });
+    fsck_err!(t, id::extent_io_opts_not_set, "extent with incorrect/missing reconcile opts:\n{}\nnew reconcile : {}{}",
+              k.as_sc().untyped().to_text(fs), Msg(|out: &mut Printbuf| extent_reconcile_to_text(out, Some(fs), new)), diff)?;
+    Ok(())
+}
+
+/// Of a key of any type, typed or not.
+impl<V: ?Sized + BkeyVal<State = Validated>> TransBkey<'_, '_, V> {
+    /// Its reconcile state brought in line with options @opts: a stripe's
+    /// needs_reconcile bit; a data key's reconcile entry set, or dropped if
+    /// it needs none, and its padding pointers to BCH_SB_MEMBER_INVALID added
+    /// or dropped. New work must be allowed - new_needs_rb_allowed().
+    /// bch2_bkey_set_needs_reconcile(); its room is what it's grown into.
+    pub fn set_needs_reconcile(&mut self, t: &TransAttempt<'_, '_>, s: Option<&mut c::per_snapshot_io_opts>,
+                               opts: &c::bch_inode_opts, ctx: c::set_needs_reconcile_ctx,
+                               opt_change_cookie: u32) -> Result<(), BchError> {
+        let fs = t.fs();
+
+        let Some(kp) = self.as_sc().arm::<Ptrs>() else { return Ok(()) };
+        let Some(NeedsReconcile { r: new, mut invalid_devs }) = needs_reconcile(t, kp, opts)? else {
+            return Ok(());
+        };
+
+        let Some(mut k) = self.reborrow().arm::<PtrsMut>() else {
+            let stripe = self.reborrow().arm::<c::Stripe>().expect("with pointers, and not PtrsMut: a stripe");
+            return set_needs_reconcile_stripe(t, s, stripe,
+                new.need_rb() & rb_bit(c::bch_reconcile_opts::BCH_RECONCILE_data_replicas) != 0);
+        };
+        let old = k.reconcile_opts(fs).copied();
+        let new_need_rb = new.need_rb() & !old.map_or(0, |old| old.need_rb());
+
+        if new_need_rb != 0 {
+            new_needs_rb_allowed(t, s, &k, ctx, opt_change_cookie, old.as_ref(), &new, new_need_rb)?;
+        }
+
+        let should_have = should_have_rb_opts(k.k(), &new);
+        let r = k.extent_entries_mut_at(fs).find_map(|(at, e)| match e {
+            ExtentEntryMut::reconcile(r) => Some((at, r)),
+            _ => None,
+        });
+        match r {
+            Some((_, r)) if should_have => *r = new,
+            Some((at, _)) => k.drop_entry(fs, at),
+            None if should_have => {
+                let end = k.entries_end();
+                k.insert_entry(end, &[new.into_bits()]).expect("room for a reconcile entry: its caller's");
+            }
+            None => {}
+        }
+
+        if invalid_devs > 0 {
+            k.drop_ptrs_noerror(fs, |p| {
+                let drop = p.p.ptr.dev() as u32 == c::BCH_SB_MEMBER_INVALID && !p.p.has_ec && invalid_devs > 0;
+                invalid_devs -= i32::from(drop);
+                drop
+            });
+        } else if invalid_devs < 0 {
+            let n = invalid_devs.unsigned_abs();
+            let sectors: u64 = if k.k().is_btree_ptr() { fs.btree_sectors().into() } else { k.k().size.into() };
+            t.extra_disk_res_add(u64::from(n) * sectors, n);
+
+            for _ in 0..n {
+                let end = k.entries_end();
+                let ptr = c::bch_extent_ptr::new().with_dev(c::BCH_SB_MEMBER_INVALID as u8);
+                k.insert_entry(end, &[ptr.into_bits().0]).expect("room for padding pointers: its caller's");
+            }
+        }
+        Ok(())
+    }
+}
+
+/// A stripe's needs_reconcile bit made @needs - set where the stripe's
+/// devices have no scan pending to explain it, an fsck error:
+/// set_needs_reconcile_stripe().
+fn set_needs_reconcile_stripe(t: &TransAttempt<'_, '_>, s: Option<&mut c::per_snapshot_io_opts>,
+                              mut k: TransBkey<'_, '_, c::Stripe<Validated>>, needs: bool) -> Result<(), BchError> {
+    if needs && k.v().needs_reconcile() == 0 && !dev_scan_cookie_set(t, &k, s.map(|s| &mut s.dev_cookie))? {
+        fsck_err!(t, id::stripe_needs_reconcile_not_set, "stripe with needs_reconcile incorrectly unset\n{}",
+                  k.to_text(t.fs()))?;
+    }
+    k.v_mut().bits.set_needs_reconcile(needs.into());
+    Ok(())
+}
+
+/// What set_needs_reconcile() can grow a key by: a reconcile entry, and a
+/// padding pointer for each replica.
+const SET_NEEDS_RECONCILE_ROOM: u32 = 1 + c::BCH_REPLICAS_MAX;
+
+/// The extent trigger's: the reconcile entry filled in on the key going in,
+/// so callers needn't - its room made here, as callers like extent split
+/// fragments don't reserve it - @op's @new repointed, if the key was grown.
+/// Its io options are looked up each time:
+/// bch2_extent_trigger_set_needs_reconcile().
+pub(crate) fn extent_trigger_set_needs_reconcile(t: &TransAttempt<'_, '_>, op: &mut TriggerOp<'_>) -> Result<(), BchError> {
+    let opts = get_io_opts(t, None, BkeySC::from(&op.new).untyped())?;
+    let needed = u32::from(op.new.k.u64s) + SET_NEEDS_RECONCILE_ROOM;
+    op.new_with_room(t, needed)?
+        .set_needs_reconcile(t, None, &opts, c::set_needs_reconcile_ctx::SET_NEEDS_RECONCILE_other, 0)
+}
+
+/// @k, at @iter, with its reconcile state brought in line with @opts, as an
+/// update - or for a btree node pointer, @level the level it's at, the
+/// pointer to the node below, updated in place: committed, and the
+/// transaction restarted. Nothing if it's right already:
+/// bch2_update_reconcile_opts().
+pub fn update_reconcile_opts(t: &TransAttempt<'_, '_>, s: Option<&mut c::per_snapshot_io_opts>,
+                             opts: &c::bch_inode_opts, iter: &BtreeIter<'_>, level: u32, k: BkeySC<'_>,
+                             ctx: c::set_needs_reconcile_ctx) -> Result<(), BchError> {
+    let flags = iter.iter_flags();
+    assert!(!flags.contains(BtreeIterFlags::IS_EXTENTS), "update_reconcile_opts() on an extents iterator");
+    assert!(!flags.contains(BtreeIterFlags::FILTER_SNAPSHOTS),
+            "update_reconcile_opts() on a snapshot filtering iterator");
+
+    let Some(kp) = k.arm::<Ptrs>() else { return Ok(()) };
+    if needs_reconcile(t, kp, opts)?.is_none() {
+        return Ok(());
+    }
+
+    if level == 0 {
+        let room = u32::from(k.k.u64s) + SET_NEEDS_RECONCILE_ROOM;
+        let mut n = t.bkey_reassemble_room(k, room as usize * size_of::<u64>())?;
+        n.set_needs_reconcile(t, s, opts, ctx, 0)?;
+        return t.update(iter, &n, UpdateTriggerFlags::INTERNAL_SNAPSHOT_NODE);
+    }
+
+    t.btree_node_edit_key(iter.btree(), level, iter.pos(), |n| n.set_needs_reconcile(t, s, opts, ctx, 0))?;
+    Err(t.restart(c::bch_errcode::BCH_ERR_transaction_restart_commit))
+}
+
+// ── C's ──────────────────────────────────────────────────────────────────
+
+/// # Safety
+/// C has an attempt in progress on @trans, and @k is a key it can edit while
+/// that runs, @buf_u64s u64s of it its.
+#[c_export]
+pub unsafe fn bch2_bkey_set_needs_reconcile(trans: &BtreeTrans<'_>, s: Option<&mut c::per_snapshot_io_opts>,
+                                            opts: &c::bch_inode_opts, k: BkeyS<'_>, buf_u64s: c_uint,
+                                            ctx: c::set_needs_reconcile_ctx, opt_change_cookie: u32) -> c_int {
+    // SAFETY: the caller's
+    let t = unsafe { trans.attempt_in_progress() };
+    // SAFETY: the caller's - a struct bkey heads its struct bkey_i
+    let mut k = unsafe { TransBkey::from_raw_room(&t, core::ptr::from_mut(k.k).cast(), buf_u64s) };
+    ret_to_c(k.set_needs_reconcile(&t, s, opts, ctx, opt_change_cookie))
+}
+
+/// # Safety
+/// C has an attempt in progress on @trans, @iter one of its iterators.
+#[c_export]
+pub unsafe fn bch2_update_reconcile_opts(trans: &BtreeTrans<'_>, s: Option<&mut c::per_snapshot_io_opts>,
+                                         opts: &c::bch_inode_opts, iter: &mut BtreeIter<'_>, level: c_uint,
+                                         k: BkeySC<'_>, ctx: c::set_needs_reconcile_ctx) -> c_int {
+    // SAFETY: the caller's
+    let t = unsafe { trans.attempt_in_progress() };
+    ret_to_c(update_reconcile_opts(&t, s, opts, iter, level, k, ctx))
+}
