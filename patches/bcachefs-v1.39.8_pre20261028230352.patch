+
+c_enum! {
+    #[open]
+    pub enum bch_sb_error_id: u32 {
+        BCH_SB_ERRS(t, n, ..) => BCH_FSCK_ERR_ ## t = n,
+    }
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, CStruct, Plain, TypeInfo)]
+#[c_typedef(bch_sb_field_error_entry)]
+pub struct bch_sb_field_error_entry {
+    pub v: Le64,
+    pub last_error_time: Le64,
+}
+
+#[unsized_vstruct]
+#[repr(C)]
+#[derive(Clone, Copy, Default, CStruct, Plain, TypeInfo)]
+pub struct bch_sb_field_errors {
+    pub field: Head<c::bch_sb_field>,
+    pub entries: [c::bch_sb_field_error_entry; 0],
+}
+vstruct!(unsized bch_sb_field_errors, field.u64s, start = 0);
+
+c_bitmask! {
+    LE64_BITMASK(struct bch_sb_field_error_entry, v) {
+        BCH_SB_ERROR_ENTRY_ID(0, 16),
+        BCH_SB_ERROR_ENTRY_NR(16, 64),
+    }
+}
+
+/*
+ * v2 entries add the time of first occurrence: id (16 bits), a
+ * saturating occurrence count (32), and two 40-bit second-resolution
+ * timestamps - good until the year ~36,800 - packed exactly into 128
+ * bits. No 64-bit boundary partition fits {16, 32, 40, 40}, so
+ * last_error_time spans the two words: in Rust the entry is one
+ * little-endian u128, where the fields are contiguous; C has the two
+ * words and hand-rolled accessors, whose setters saturate, since a
+ * wrapped count or timestamp would be worse than a pinned one.
+ *
+ * v[0]: id 0..16, nr 16..48, last_error_time 48..64 (low 16 bits)
+ * v[1]: last_error_time 0..24 (high 24 bits), first_error_time 24..64
+ */
+/* align(8): C's v is __le64 v[2]; its bitfield's le::U128 is aligned to 1 */
+nest! {
+    #[repr(C, align(8))]
+    #[derive(Clone, Copy, Default, CStruct, Plain, TypeInfo)]
+    #[c_typedef(bch_sb_field_error_entry_v2)]
+    pub struct bch_sb_field_error_entry_v2 {
+        #[c("__le64 v[2]")]
+        #>[bitfield(u128, repr = le::U128, from = le::U128::new, into = le::U128::get)]
+        pub v: pub struct bch_sb_field_error_entry_v2_bits {
+            id:               u16,
+            nr:               u32,
+            last_error_time:  u40,
+            first_error_time: u40,
+        },
+    }
+}
+
+#[unsized_vstruct]
+#[repr(C)]
+#[derive(Clone, Copy, Default, CStruct, Plain, TypeInfo)]
+pub struct bch_sb_field_errors_v2 {
+    pub field: Head<c::bch_sb_field>,
+    pub entries: [c::bch_sb_field_error_entry_v2; 0],
+}
+vstruct!(unsized bch_sb_field_errors_v2, field.u64s, start = 0);
+
+c_const! {
+    pub const BCH_SB_ERROR_ENTRY_V2_NR_MAX: u64 = (1 << 32) - 1;
+    pub const BCH_SB_ERROR_ENTRY_V2_TIME_MAX: u64 = (1 << 40) - 1;
+}
diff --git a/fs/bcachefs/sb/errors_format_inline.h b/fs/bcachefs/sb/errors_format_inline.h
new file mode 100644
index 0000000..563b1d2
--- /dev/null
+++ b/fs/bcachefs/sb/errors_format_inline.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_SB_ERRORS_FORMAT_INLINE_H
+#define _BCACHEFS_SB_ERRORS_FORMAT_INLINE_H
+
+/* Included after sb/errors_format_gen.h. */
+
+static inline __u64 BCH_SB_ERROR_ENTRY_V2_ID(const struct bch_sb_field_error_entry_v2 *e)
+{
+	return __le64_to_cpu(e->v[0]) & 0xffff;
+}
+
+static inline void SET_BCH_SB_ERROR_ENTRY_V2_ID(struct bch_sb_field_error_entry_v2 *e, __u64 id)
+{
+	e->v[0] = __cpu_to_le64((__le64_to_cpu(e->v[0]) & ~0xffffULL) |
+				(id & 0xffff));
+}
+
+static inline __u64 BCH_SB_ERROR_ENTRY_V2_NR(const struct bch_sb_field_error_entry_v2 *e)
+{
+	return (__le64_to_cpu(e->v[0]) >> 16) & 0xffffffffULL;
+}
+
+static inline void SET_BCH_SB_ERROR_ENTRY_V2_NR(struct bch_sb_field_error_entry_v2 *e, __u64 nr)
+{
+	if (nr > BCH_SB_ERROR_ENTRY_V2_NR_MAX)
+		nr = BCH_SB_ERROR_ENTRY_V2_NR_MAX;
+	e->v[0] = __cpu_to_le64((__le64_to_cpu(e->v[0]) & ~(0xffffffffULL << 16)) |
+				(nr << 16));
+}
+
+static inline __u64 BCH_SB_ERROR_ENTRY_V2_LAST(const struct bch_sb_field_error_entry_v2 *e)
+{
+	return (__le64_to_cpu(e->v[0]) >> 48) |
+	       ((__le64_to_cpu(e->v[1]) & 0xffffffULL) << 16);
+}
+
+static inline void SET_BCH_SB_ERROR_ENTRY_V2_LAST(struct bch_sb_field_error_entry_v2 *e, __u64 t)
+{
+	if (t > BCH_SB_ERROR_ENTRY_V2_TIME_MAX)
+		t = BCH_SB_ERROR_ENTRY_V2_TIME_MAX;
+	e->v[0] = __cpu_to_le64((__le64_to_cpu(e->v[0]) & ~(0xffffULL << 48)) |
+				((t & 0xffff) << 48));
+	e->v[1] = __cpu_to_le64((__le64_to_cpu(e->v[1]) & ~0xffffffULL) |
+				(t >> 16));
+}
+
+static inline __u64 BCH_SB_ERROR_ENTRY_V2_FIRST(const struct bch_sb_field_error_entry_v2 *e)
+{
+	return __le64_to_cpu(e->v[1]) >> 24;
+}
+
+static inline void SET_BCH_SB_ERROR_ENTRY_V2_FIRST(struct bch_sb_field_error_entry_v2 *e, __u64 t)
+{
+	if (t > BCH_SB_ERROR_ENTRY_V2_TIME_MAX)
+		t = BCH_SB_ERROR_ENTRY_V2_TIME_MAX;
+	e->v[1] = __cpu_to_le64((__le64_to_cpu(e->v[1]) & 0xffffffULL) |
+				(t << 24));
+}
+
+#endif /* _BCACHEFS_SB_ERRORS_FORMAT_INLINE_H */
diff --git a/fs/bcachefs/sb/errors_types.rs b/fs/bcachefs/sb/errors_types.rs
new file mode 100644
index 0000000..277567f
--- /dev/null
+++ b/fs/bcachefs/sb/errors_types.rs
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::types::DArray;
+use cstruct_macros::{CStruct, bitfield, c_typedef, c_xmacro, TypeInfo};
+use nestify::nest;
+
+nest! {
+    #[repr(C)]
+    #[derive(Clone, Copy, Default, CStruct, TypeInfo)]
+    pub struct bch_sb_error_entry_cpu {
+        #[c_bitfield]
+        #>[bitfield(u64)]
+        pub bits: pub struct bch_sb_error_entry_cpu_bits {
+            id: u16,
+            nr: u48,
+        },
+        pub first_error_time: u64,
+        pub last_error_time: u64,
+    }
+}
+
+c_typedef! {
+    #[c("DARRAY(struct bch_sb_error_entry_cpu) bch_sb_errors_cpu")]
+    pub type bch_sb_errors_cpu = DArray<c::bch_sb_error_entry_cpu>;
+}
+
+/*
+ * Block statuses we count separately: what the device said is the first
+ * thing worth knowing from a filesystem that's logging IO errors - media
+ * errors mean the drive is going, timeouts mean it's hanging, transport
+ * errors point at the fabric, and INVAL means the request itself was
+ * rejected: not an error the device hit, an error in what we handed it.
+ *
+ * Curated by hand rather than generated from BLK_ERRS(): sb error ids are
+ * permanent on-disk numbers, so we don't spend them on statuses that can't
+ * reach a bcachefs completion - DM_REQUEUE is consumed inside dm, and the
+ * zone codes want zoned device support we don't have. Anything left out
+ * counts as blk_sts_unknown; to promote one, add it here and add a
+ * numbered entry in errors_format.rs - the build breaks if you forget.
+ */
+c_xmacro! {
+    BCH_BLK_STS_SB_ERRS(x) {
+        (NOTSUPP, notsupp),
+        (TIMEOUT, timeout),
+        (NOSPC, nospc),
+        (TRANSPORT, transport),
+        (TARGET, target),
+        (RESV_CONFLICT, resv_conflict),
+        (MEDIUM, medium),
+        (PROTECTION, protection),
+        (RESOURCE, resource),
+        (IOERR, ioerr),
+        (AGAIN, again),
+        (DEV_RESOURCE, dev_resource),
+        (OFFLINE, offline),
+        (DURATION_LIMIT, duration_limit),
+        (INVAL, inval),
+        (REMOVED, removed),
+    }
+}
+
+/*
+ * Decompression failures we count separately: an extent that won't
+ * decompress is a different animal from one that won't read or won't
+ * checksum - as far as the checksum can tell the data came off the device
+ * intact, and then didn't decode. Counting per compression type answers
+ * the first question such a report raises, which is whether one algorithm
+ * is at fault or all of them are.
+ *
+ * The zstd codes separate that further: corruption_detected and
+ * checksum_wrong say the compressed data is bad, dst_size_too_small and
+ * memory_allocation say we drove zstd wrong or couldn't allocate.
+ *
+ * Curated by hand for the same reason as the block statuses above - sb
+ * error ids are permanent on-disk numbers. zstd defines 27 error codes,
+ * most of which zstd_decompress_dctx() can't return for the single raw
+ * frame we hand it; those count as data_decompress_err_zstd_unknown, and
+ * anything not a decompress errcode at all as data_decompress_err_unknown.
+ * To promote one, add it here and add a numbered entry in
+ * errors_format.rs, and a KEY_TYPE_ERRORS() reason - the build breaks if
+ * you forget.
+ */
+c_xmacro! {
+    BCH_DECOMPRESS_SB_ERRS(x) {
+        (decompress_exceeded_max_encoded_extent, exceeded_max_encoded_extent),
+        (decompress_lz4_old, lz4_old),
+        (decompress_lz4, lz4),
+        (decompress_gzip, gzip),
+        (decompress_gzip_size_mismatch, gzip_size_mismatch),
+        (decompress_zstd_src_len_bad, zstd_src_len_bad),
+        (decompress_zstd_size_mismatch, zstd_size_mismatch),
+        (ZSTD_error_corruption_detected, zstd_corruption_detected),
+        (ZSTD_error_checksum_wrong, zstd_checksum_wrong),
+        (ZSTD_error_prefix_unknown, zstd_prefix_unknown),
+        (ZSTD_error_srcSize_wrong, zstd_src_size_wrong),
+        (ZSTD_error_dstSize_tooSmall, zstd_dst_size_too_small),
+        (ZSTD_error_memory_allocation, zstd_memory_allocation),
+    }
+}
diff --git a/fs/bcachefs/sb/ext.rs b/fs/bcachefs/sb/ext.rs
new file mode 100644
index 0000000..6f5f310
--- /dev/null
+++ b/fs/bcachefs/sb/ext.rs
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! The superblock's ext section: what recovery is to do on the next mount -
+//! passes to run, errors to fix silently, btrees that lost data - and since
+//! it grew, what's been learned of the btrees over the filesystem's life.
+
+use core::mem::{offset_of, size_of};
+
+use crate::c;
+use crate::fs::Fs;
+use crate::init::passes;
+use crate::sb::errors::prt_error_ids;
+use crate::sb::io::SbFieldOps;
+use crate::types::Le64;
+use crate::util::bitmap::LeBitmap;
+use crate::util::vstructs::{Validated, Unvalidated};
+use crate::util::Printbuf;
+
+type Section = c::bch_sb_field_ext<Validated>;
+
+fn prt_btrees(out: &mut Printbuf, what: &str, btrees: Le64) {
+    write!(out, "{what}:\t");
+    crate::util::names::prt_set::<c::btree_id>(out, btrees.get());
+    out.newline();
+}
+
+/// Whether @e has the field it grew at @off: only if a version that knew of
+/// it wrote the section.
+fn has(e: &Section, off: usize) -> bool {
+    e.as_bytes().len() >= off + size_of::<Le64>()
+}
+
+/// Its validate is the arm's: a section shorter than the 88 bytes of the
+/// fields from before it grew isn't one.
+impl SbFieldOps for Section {
+    fn to_text(out: &mut Printbuf, _fs: Option<&Fs>, _sb: &c::bch_sb<Unvalidated>,
+                e: &c::bch_sb_field_ext<Unvalidated>) {
+        write!(out, "Recovery passes required:\t");
+        passes::prt_stable(out, e.recovery_passes_required[0].get());
+        out.newline();
+
+        write!(out, "Errors to silently fix:\t");
+        let silent = LeBitmap::from_words(&e.errors_silent).iter();
+        prt_error_ids(out, silent.take_while(|&id| id < c::BCH_FSCK_ERR_MAX as usize)
+                                 .map(|id| c::bch_sb_error_id(id as u32)));
+        out.newline();
+
+        prt_btrees(out, "Btrees with missing data", e.btrees_lost_data());
+
+        if has(e, offset_of!(c::bch_sb_field_ext__whole, btrees_lost_data_ever)) {
+            prt_btrees(out, "Btrees that have ever lost data", e.btrees_lost_data_ever());
+        }
+        if has(e, offset_of!(c::bch_sb_field_ext__whole, btrees_clean)) {
+            prt_btrees(out, "Btrees validated clean", e.btrees_clean());
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::btree::types::btree_id_str;
+    use crate::types::Le32;
+    use crate::util::vstructs::{cast_plain_mut, plain_bytes_mut, Head, Unvalidated, VStruct};
+
+    /// An ext section of @u64s, @buf's first, as the superblock's printer
+    /// prints it - by its type.
+    fn to_text(buf: &mut [u64], u64s: usize) -> String {
+        // a superblock of no sections: its header
+        let mut sb = [0u64; size_of::<Head<c::bch_sb>>() / size_of::<u64>()];
+        let sb_bytes = plain_bytes_mut(&mut sb[..]);
+        cast_plain_mut::<Head<c::bch_sb>>(sb_bytes).unwrap().set_val_u64s(0);
+        let sb = c::bch_sb::<Unvalidated>::from_bytes(sb_bytes).unwrap();
+
+        let b = plain_bytes_mut(buf);
+        let f = cast_plain_mut::<Head<c::bch_sb_field>>(b).unwrap();
+        f.set_val_u64s(u64s);
+        f.type_ = Le32::new(c::bch_sb_field_type::BCH_SB_FIELD_ext.0);
+        let f = c::bch_sb_field::<Unvalidated>::from_bytes(b).unwrap();
+
+        let mut out = Printbuf::new();
+        crate::sb::io::field_ops_to_text(&mut out, None, sb, f);
+        out.as_str().to_owned()
+    }
+
+    /// The fields it grew are printed only if it has them: 88 bytes has
+    /// neither, 112 btrees_lost_data_ever, 120 btrees_clean too.
+    #[test]
+    fn to_text_grown_fields() {
+        let mut buf = [0u64; 15];
+        buf[3] = 1 << 2 | 1;                    // errors_silent: ids 0 and 2
+        buf[13] = 1;                            // btrees_lost_data_ever: btree 0
+        buf[14] = 1;                            // btrees_clean: btree 0
+
+        let names: Vec<_> = [0, 2].map(|id| c::bch_sb_error_id(id).name().unwrap()).into();
+        let lines = |u64s| to_text(&mut buf.clone(), u64s).lines().map(str::to_owned).collect::<Vec<_>>();
+
+        let l = lines(11);
+        assert_eq!(l.len(), 3);
+        assert!(l[1].ends_with(&names.join(",")), "{}", l[1]);
+
+        let l = lines(14);
+        assert_eq!(l.len(), 4);
+        assert!(l[3].starts_with("Btrees that have ever lost data") && l[3].ends_with(&btree_id_str(0)));
+
+        let l = lines(15);
+        assert_eq!(l.len(), 5);
+        assert!(l[4].starts_with("Btrees validated clean") && l[4].ends_with(&btree_id_str(0)));
+    }
+}
