+// SPDX-License-Identifier: GPL-2.0
+
+//! The walks over a BioRange:
+//!
+//! - Its chunks, by iterating it: virtually contiguous, the walk for its
+//!   data. As much of a bvec as is in the direct map - all of it, in
+//!   userspace or without HIGHMEM - at its page_address(); a highmem page is
+//!   a chunk of its own, kmapped while it's used. Data access - copies,
+//!   zeroing, the mapped bytes - is the chunk's, so highmem goes no further
+//!   than here.
+//! - Its segments: the bvecs as they are, for what's done to the bvecs
+//!   themselves; their pages may not all be mapped, so no data access.
+//! - Its folios, in the kernel: for the vfs glue, what's done to folios.
+//!   Pages, in userspace, are 4K of an address, and nothing there walks them.
+//!   Each folio of a walk is as much of it as the bvec has - not a page at a
+//!   time, as C's bio_for_each_folio() (vfs/io.h), over single-page bvecs, was.
+
+use core::iter::FusedIterator;
+use core::marker::PhantomData;
+use core::ptr::NonNull;
+
+use super::BioRange;
+use crate::c;
+use crate::util::kernel::PAGE_SIZE;
+
+/// Page @n of the run starting at @page: in the kernel, one struct page after
+/// another, as bvec_iter_page(); in userspace, a page is its address.
+///
+/// # Safety
+/// @page is a bvec's, which has at least n + 1 pages.
+pub(crate) unsafe fn nth_page(page: *mut c::page, n: usize) -> *mut c::page {
+    // SAFETY: the caller's
+    #[cfg(kernel)]
+    return unsafe { page.add(n) };
+    // SAFETY: the caller's
+    #[cfg(not(kernel))]
+    return unsafe { page.byte_add(n * PAGE_SIZE) };
+}
+
+/// # Safety
+/// @page is a page, not highmem.
+pub(super) unsafe fn page_address(page: NonNull<c::page>) -> NonNull<u8> {
+    // SAFETY: the caller's
+    #[cfg(kernel)]
+    return NonNull::new(unsafe { c::rust_page_address(page.as_ptr()) }.cast())
+        .expect("a lowmem page's address");
+    #[cfg(not(kernel))]
+    return page.cast();
+}
+
+/// # Safety
+/// @page is a page.
+#[cfg(all(kernel, CONFIG_HIGHMEM))]
+unsafe fn highmem(page: *mut c::page) -> bool {
+    // SAFETY: the caller's
+    unsafe { c::rust_page_highmem(page) }
+}
+
+/// Where a chunk's bytes are, and how many of a bvec's @len from @offset in
+/// @page that is: in the direct map, as many as are; or a highmem page's, to
+/// its end.
+///
+/// # Safety
+/// @page is a bvec's, with @len bytes of it from @offset.
+unsafe fn chunk_at(page: NonNull<c::page>, offset: u32, len: u32) -> (At, u32) {
+    #[cfg(all(kernel, CONFIG_HIGHMEM))]
+    // SAFETY: the caller's
+    if unsafe { highmem(page.as_ptr()) } {
+        return (At::Highmem { page, offset }, len.min(PAGE_SIZE as u32 - offset));
+    }
+    // and the lowmem pages after it, up to a highmem one
+    #[cfg(all(kernel, CONFIG_HIGHMEM))]
+    let len = {
+        let (mut n, mut i) = (PAGE_SIZE as u32 - offset, 1);
+        // SAFETY: the bvec's pages - @len runs on past n
+        while n < len && !unsafe { highmem(nth_page(page.as_ptr(), i)) } {
+            n += PAGE_SIZE as u32;
+            i += 1;
+        }
+        n.min(len)
+    };
+    // SAFETY: lowmem, and @offset into it
+    (At::Direct(unsafe { page_address(page).add(offset as usize) }), len)
+}
+
+impl BioRange<'_> {
+    fn walkable(&self) -> bool {
+        !self.is_empty() && !self.bio.no_advance_iter()
+    }
+
+    /// Where it starts - the page, and where in it - and how much of that
+    /// bvec it has; None if a walk is done.
+    fn head(&self) -> Option<(NonNull<c::page>, u32, u32)> {
+        if !self.walkable() {
+            return None;
+        }
+        let mp_offset = self.mp_offset() as usize;
+        // SAFETY: a page of the bvec it starts in
+        let page = unsafe { nth_page(self.bvec().bv_page, mp_offset / PAGE_SIZE) };
+        let page = NonNull::new(page).expect("a bvec's page");
+        Some((page, (mp_offset % PAGE_SIZE) as u32, self.mp_len()))
+    }
+}
+
+pub struct Walk<'a, T> {
+    rest: BioRange<'a>,
+    step: fn(&mut BioRange<'a>) -> Option<T>,
+}
+
+pub type Chunks<'a>   = Walk<'a, Chunk<'a>>;
+pub type Segments<'a> = Walk<'a, Segment<'a>>;
+#[cfg(kernel)]
+pub type Folios<'a>   = Walk<'a, FolioVec<'a>>;
+
+impl<'a, T> Walk<'a, T> {
+    pub(super) fn new(rest: BioRange<'a>, step: fn(&mut BioRange<'a>) -> Option<T>) -> Self {
+        Self { rest, step }
+    }
+
+    pub fn remaining(&self) -> BioRange<'a> {
+        self.rest
+    }
+}
+
+impl<T> Iterator for Walk<'_, T> {
+    type Item = T;
+
+    fn next(&mut self) -> Option<T> {
+        (self.step)(&mut self.rest)
+    }
+
+    /// Each step is at least a byte.
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        if self.rest.walkable() { (1, Some(self.rest.len() as usize)) } else { (0, Some(0)) }
+    }
+}
+
+impl<T> FusedIterator for Walk<'_, T> {}
+
+// ── Chunks ───────────────────────────────────────────────────────────────
+
+/// Its memory may be written while it's read - a user's page under direct
+/// IO, a page another IO maps too - so it's never a &[u8]: copied, or handed
+/// over as a pointer.
+///
+/// # Invariants
+/// @at is @len bytes of the bio's, mapped as one.
+pub struct Chunk<'a> {
+    at:   At,
+    len:  u32,
+    _bio: PhantomData<&'a ()>,
+}
+
+enum At {
+    Direct(NonNull<u8>),
+    /// A highmem page, mapped when it's used
+    #[cfg(all(kernel, CONFIG_HIGHMEM))]
+    Highmem { page: NonNull<c::page>, offset: u32 },
+}
+
+impl Chunk<'_> {
+    pub fn len(&self) -> u32 {
+        self.len
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.len == 0
+    }
+
+    /// The bytes may change under @f, as above.
+    pub fn with_mapped<R>(&self, f: impl FnOnce(*mut u8, usize) -> R) -> R {
+        match self.at {
+            At::Direct(p) => f(p.as_ptr(), self.len as usize),
+            #[cfg(all(kernel, CONFIG_HIGHMEM))]
+            // SAFETY: the chunk's page - mapped, then unmapped before anything
+            // else is
+            At::Highmem { page, offset } => unsafe {
+                let p = c::kmap_local_page(page.as_ptr()).cast::<u8>();
+                let r = f(p.add(offset as usize), self.len as usize);
+                c::kunmap_local(p.cast());
+                r
+            },
+        }
+    }
+
+    /// As much as both have, copied: how much.
+    pub fn copy_to(&self, dst: &mut [u8]) -> usize {
+        // SAFETY: n of the chunk's bytes, mapped, into n of @dst
+        self.with_mapped(|p, len| {
+            let n = len.min(dst.len());
+            unsafe { core::ptr::copy_nonoverlapping(p, dst.as_mut_ptr(), n) };
+            n
+        })
+    }
+
+    /// As copy_to().
+    pub fn copy_from(&self, src: &[u8]) -> usize {
+        // SAFETY: n of @src into n of the chunk's bytes, mapped
+        self.with_mapped(|p, len| {
+            let n = len.min(src.len());
+            unsafe { core::ptr::copy_nonoverlapping(src.as_ptr(), p, n) };
+            n
+        })
+    }
+
+    pub fn zero(&self) {
+        // SAFETY: the chunk's bytes, mapped
+        self.with_mapped(|p, len| unsafe { core::ptr::write_bytes(p, 0, len) })
+    }
+}
+
+pub(super) fn chunk<'a>(rest: &mut BioRange<'a>) -> Option<Chunk<'a>> {
+    let (page, offset, len) = rest.head()?;
+    // SAFETY: the bvec the walk is in, from where it's at
+    let (at, len) = unsafe { chunk_at(page, offset, len) };
+    rest.advance_in_bvec(len);
+
+    // INVARIANT: chunk_at()'s
+    Some(Chunk { at, len, _bio: PhantomData })
+}
+
+// ── Segments ─────────────────────────────────────────────────────────────
+
+/// May run on from @page into the pages after it.
+pub struct Segment<'a> {
+    pub page:   NonNull<c::page>,
+    pub offset: u32,
+    pub len:    u32,
+    _bio:       PhantomData<&'a ()>,
+}
+
+pub(super) fn segment<'a>(rest: &mut BioRange<'a>) -> Option<Segment<'a>> {
+    let (page, offset, len) = rest.head()?;
+    rest.advance_in_bvec(len);
+    Some(Segment { page, offset, len, _bio: PhantomData })
+}
+
+// ── Folios ───────────────────────────────────────────────────────────────
+
+#[cfg(kernel)]
+pub struct FolioVec<'a> {
+    pub folio:  NonNull<c::folio>,
+    pub offset: usize,
+    pub len:    usize,
+    _bio:       PhantomData<&'a ()>,
+}
+
+#[cfg(kernel)]
+pub(super) fn folio<'a>(rest: &mut BioRange<'a>) -> Option<FolioVec<'a>> {
+    let (page, offset, len) = rest.head()?;
+    // SAFETY: a bvec's page, and the folio it's of
+    let (folio, offset, len) = unsafe {
+        let folio = c::rust_page_folio(page.as_ptr());
+        let offset = c::rust_folio_page_idx(folio, page.as_ptr()) as usize * PAGE_SIZE + offset as usize;
+        (folio, offset, (c::rust_folio_size(folio) - offset).min(len as usize))
+    };
+    rest.advance_in_bvec(len as u32);
+
+    Some(FolioVec {
+        folio: NonNull::new(folio).expect("a page's folio"),
+        offset,
+        len,
+        _bio: PhantomData,
+    })
+}
+
+#[cfg(all(test, not(kernel)))]
+mod tests {
+    use super::super::{Bio, BioBuf, BioOwner, BioRange};
+    use crate::c;
+    use crate::errcode::BchError;
+
+    /// A bio of three bvecs over three buffers - not virtually adjacent, so
+    /// three chunks: walked whole, from its position advanced into the
+    /// second, and from a position saved; copied out of, into and zeroed; a
+    /// walk stopped part way says what's left; a completed bio's _all walk
+    /// is all of it; a discard has no chunks.
+    #[test]
+    fn ranges_and_chunks() {
+        let (mut a, mut b, mut c_) = ([1u8; 8], [2u8; 4], [3u8; 6]);
+        let mut buf = BioBuf::<Bio>::new::<BchError, _>(core::ptr::null_mut(), 3, 0, |bio| bio.init()).unwrap();
+        for x in [&mut a[..], &mut b[..], &mut c_[..]] {
+            // SAFETY: a buffer that outlives the bio, into one of its 3 bvecs
+            unsafe { buf.bio_mut().map(x.as_mut_ptr(), x.len()) };
+        }
+        let lens = |r: BioRange<'_>| r.into_iter().map(|s| s.len()).collect::<Vec<_>>();
+        assert_eq!(lens(buf.range_all()), [8, 4, 6]);
+        assert_eq!(buf.range_all().segments().map(|s| s.len).collect::<Vec<_>>(), [8, 4, 6]);
+
+        let mut r = buf.bio().range();
+        assert_eq!(r.len(), 18);
+        r.advance(10);
+        assert_eq!(lens(r), [2, 6]);
+
+        let pos = r.pos();
+        let mut out = [0u8; 8];
+        assert_eq!(r.copy_to(&mut out), 8);
+        assert_eq!(out, [2, 2, 3, 3, 3, 3, 3, 3]);
+        // SAFETY: a position of this bio, just taken
+        assert_eq!(unsafe { buf.bio().range_at(pos) }.copy_from(&[9; 3]), 3);
+
+        let mut chunks = buf.range_all().into_iter();
+        chunks.next();
+        assert_eq!(chunks.remaining().len(), 10);
+
+        let mut tail = buf.bio().range();
+        tail.advance(16);
+        tail.zero();
+
+        // what only the block layer does: the IO completed, then the bio a
+        // discard
+        buf.bio_mut().raw_mut().bi_iter.bi_size = 0;
+        assert_eq!((lens(buf.bio().range()), lens(buf.range_all())), (vec![], vec![8, 4, 6]));
+
+        buf.bio_mut().raw_mut().bi_opf = c::req_op_REQ_OP_DISCARD;
+        assert_eq!(lens(buf.range_all()), []);
+
+        drop(buf);
+        assert_eq!((a, b, c_), ([1; 8], [2, 2, 9, 9], [9, 3, 3, 3, 0, 0]));
+    }
+
+    /// A mapping's bvecs are its own: dropped, the bio has none, so none
+    /// outlives the buffer's borrow.
+    #[test]
+    fn mapping_ends_with_its_borrow() {
+        let buf = [5u8; 512];
+        let mut bio = BioBuf::<Bio>::new::<BchError, _>(core::ptr::null_mut(), 1,
+                                                        c::req_op_REQ_OP_WRITE, |b| b.init()).unwrap();
+        let m = bio.map_write(&buf);
+        assert_eq!(m.owner.range_all().len(), 512);
+        drop(m);
+        assert_eq!(bio.range_all().len(), 0);
+    }
+}
diff --git a/fs/bcachefs/util/bio/owned.rs b/fs/bcachefs/util/bio/owned.rs
new file mode 100644
index 0000000..582b2c5
--- /dev/null
+++ b/fs/bcachefs/util/bio/owned.rs
@@ -0,0 +1,413 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A bio's owners. Each owns a T that ends in its bio - HasBio: the bio is
+//! the T's last field, and the T is found from it by that offset.
+//!
+//! - BioBox<T>: a ref on a bio from a BioSet<T>, a bioset whose front_pad is
+//!   the rest of the T. bio_put() on drop.
+//! - BioBuf<T>: a T and its inline bvecs, in one allocation of their own.
+//!   BioBufPtr<T> is one as a thin pointer, for C's struct bio * fields.
+//!
+//! They deref to the T, and change it through Pin<&mut T>: the T holds its
+//! bio, which is pinned.
+//!
+//! A T is made around its bio: the bioset, or BioBuf::new(), puts the bio
+//! where it goes, then the caller's initializer does the rest of the T - its
+//! bio field from BioInPlace::init(), which writes nothing.
+//!
+//! Submitting (RawBio::submit()) turns the owner into its bio for the block
+//! layer; the endio turns it back, and hands it to Endio::endio().
+
+use core::alloc::Layout;
+use core::marker::PhantomData;
+use core::ops::Deref;
+use core::pin::Pin;
+use core::ptr::NonNull;
+
+use pin_init::PinInit;
+
+use super::{Bio, BioOwner};
+use crate::c;
+use crate::errcode::{ret_to_result_void, BchError};
+use crate::util::alloc::{init_at, kfree, kzalloc, KBox};
+use crate::util::ffi::Opaque;
+
+/// # Safety
+/// BIO_OFFSET is the offset of a Bio field that ends the struct, #[repr(C)]. If the
+/// struct projects its pinning - #[pin_data] - that field is #[pin]: so
+/// BioBox::as_mut()'s Pin<&mut Self> never hands it out unpinned, to be
+/// moved off its bvecs.
+pub unsafe trait HasBio: Sized {
+    const BIO_OFFSET: usize;
+}
+
+// SAFETY: a bio, at its own start
+unsafe impl HasBio for Bio {
+    const BIO_OFFSET: usize = 0;
+}
+
+/// HasBio for $t, by its Bio field $f: checked to be a Bio, and last - not
+/// that it's #[pin], which HasBio asks of a struct with #[pin_data].
+#[macro_export]
+macro_rules! has_bio {
+    ($t:ty, $f:ident) => {
+        // SAFETY: a Bio field, below, that ends the struct
+        unsafe impl $crate::util::bio::HasBio for $t {
+            const BIO_OFFSET: usize = {
+                let off = ::core::mem::offset_of!($t, $f);
+                assert!(off + ::core::mem::size_of::<$crate::util::bio::Bio>() == ::core::mem::size_of::<$t>(),
+                        concat!(stringify!($t), ": its bio isn't last"));
+                off
+            };
+        }
+        const _: fn(&$t) -> &$crate::util::bio::Bio = |t| &t.$f;
+    };
+}
+
+fn bio_of<T: HasBio>(t: *mut T) -> *mut c::bio {
+    t.cast::<u8>().wrapping_add(T::BIO_OFFSET).cast()
+}
+
+/// # Safety
+/// @bio is a T's.
+unsafe fn of_bio<T: HasBio>(bio: *mut c::bio) -> *mut T {
+    // SAFETY: the caller's
+    unsafe { bio.byte_sub(T::BIO_OFFSET).cast() }
+}
+
+pub struct BioInPlace(*mut c::bio);
+
+impl BioInPlace {
+    pub fn init<E>(self) -> impl PinInit<Bio, E> {
+        let bio = self.0;
+        // SAFETY: writes nothing, the bio being there - its slot, checked
+        unsafe {
+            ::pin_init::pin_init_from_closure(move |slot: *mut Bio| {
+                assert_eq!(slot.cast::<c::bio>(), bio, "BioInPlace: another bio's slot");
+                Ok(())
+            })
+        }
+    }
+}
+
+// ── BioSet, BioBox ───────────────────────────────────────────────────────
+
+/// Rust's, made by new() and destroyed on drop - in a struct C may share, as
+/// its struct bio_set - or C's, borrowed by from_c().
+#[repr(transparent)]
+pub struct BioSet<T: HasBio> {
+    set: Opaque<c::bio_set>,
+    _t:  PhantomData<fn() -> T>,
+}
+
+impl<T: HasBio> BioSet<T> {
+    /// @pool_size bios held in reserve, and bvecs with them if @need_bvecs:
+    /// for bios allocated with more than fit inline. Nothing to undo if it
+    /// fails.
+    pub fn new(pool_size: u32, need_bvecs: bool) -> impl PinInit<Self, BchError> {
+        let flags = if need_bvecs { c::BIOSET_NEED_BVECS as i32 } else { 0 };
+        // SAFETY: initialized in place, where it stays - pinned
+        unsafe {
+            ::pin_init::pin_init_from_closure(move |slot: *mut Self| {
+                ret_to_result_void(c::bioset_init(slot.cast(), pool_size, T::BIO_OFFSET as u32, flags))
+            })
+        }
+    }
+
+    /// Panics if its front_pad isn't a T's.
+    pub fn from_c(set: &c::bio_set) -> &Self {
+        assert_eq!(set.front_pad as usize, T::BIO_OFFSET, "a bioset of another type's bios");
+        // SAFETY: a transparent bio_set
+        unsafe { &*core::ptr::from_ref(set).cast() }
+    }
+
+    /// A T with a bio for @bdev, @opf, of @nr_vecs bvecs - inline, or the
+    /// set's - and its other fields from @init. GFP_KERNEL: NOIO or NOFS is
+    /// the caller's memalloc scope's. Fails only if @init does, or past
+    /// BIO_MAX_VECS or the set's bvec pool; otherwise it waits on the mempool.
+    ///
+    /// Which deadlocks, if what it waits for is a bio this task holds from
+    /// the set, unsubmitted: one at a time, or a pool as big as how many are
+    /// held at once.
+    pub fn alloc<E, I>(&self, bdev: *mut c::block_device, nr_vecs: u16, opf: u32,
+                       init: impl FnOnce(BioInPlace) -> I) -> Result<BioBox<T>, E>
+    where
+        I: PinInit<T, E>,
+        E: From<BchError>,
+    {
+        // SAFETY: a live bioset
+        let bio = unsafe { c::bio_alloc_bioset(bdev, nr_vecs as _, opf as _, c::GFP_KERNEL, self.set.as_ptr()) };
+        if bio.is_null() {
+            return Err(BchError::from(c::ENOMEM).into());
+        }
+        // SAFETY: front_pad bytes before it, a T's - by from_c()'s check
+        let t = unsafe { of_bio::<T>(bio) };
+        // SAFETY: the T, its bio there, the rest for @init
+        match unsafe { init_at(init(BioInPlace(bio)), t) } {
+            // SAFETY: a bio's T
+            Ok(()) => Ok(BioBox(unsafe { NonNull::new_unchecked(t) })),
+            Err(e) => {
+                // SAFETY: the bio just allocated, its one ref
+                unsafe { c::bio_put(bio) };
+                Err(e)
+            }
+        }
+    }
+}
+
+impl<T: HasBio> Drop for BioSet<T> {
+    /// Its bios are all back: its owner's teardown waits for them.
+    fn drop(&mut self) {
+        // SAFETY: new()'s, never moved: a C bioset is only ever borrowed
+        unsafe { c::bioset_exit(self.set.as_ptr()) }
+    }
+}
+
+pub struct BioBox<T: HasBio>(NonNull<T>);
+
+// SAFETY: a T, as a Box's: what has the box has the T
+unsafe impl<T: HasBio + Send> Send for BioBox<T> {}
+
+// SAFETY: the T's bio, and back - container_of()
+unsafe impl<T: HasBio> RawBio for BioBox<T> {
+    fn into_raw(self) -> *mut c::bio {
+        let bio = bio_of(self.0.as_ptr());
+        core::mem::forget(self);
+        bio
+    }
+
+    unsafe fn from_raw(bio: *mut c::bio) -> Self {
+        // SAFETY: the caller's
+        Self(unsafe { NonNull::new_unchecked(of_bio::<T>(bio)) })
+    }
+}
+
+impl<T: HasBio> Deref for BioBox<T> {
+    type Target = T;
+
+    fn deref(&self) -> &T {
+        // SAFETY: the T, live while it's had
+        unsafe { self.0.as_ref() }
+    }
+}
+
+impl<T: HasBio> BioBox<T> {
+    pub fn as_mut(&mut self) -> Pin<&mut T> {
+        // SAFETY: the T, live while it's had, and the box's alone - a bio in
+        // flight has given up its box; never moved from where its set made it
+        unsafe { Pin::new_unchecked(self.0.as_mut()) }
+    }
+}
+
+// SAFETY: the box's bio, its only ref
+unsafe impl<T: HasBio> BioOwner for BioBox<T> {
+    fn bio(&self) -> &Bio {
+        // SAFETY: the T's bio
+        unsafe { Bio::from_raw(bio_of(self.0.as_ptr())) }
+    }
+
+    fn bio_mut(&mut self) -> Pin<&mut Bio> {
+        // SAFETY: as bio()'s, and the box's alone, as in as_mut()
+        unsafe { Bio::from_raw_mut(bio_of(self.0.as_ptr())) }
+    }
+}
+
+impl<T: HasBio> Drop for BioBox<T> {
+    fn drop(&mut self) {
+        // SAFETY: the T and its ref, dropped then put - which frees it to its
+        // set, if the ref's the last
+        unsafe {
+            core::ptr::drop_in_place(self.0.as_ptr());
+            c::bio_put(bio_of(self.0.as_ptr()));
+        }
+    }
+}
+
+// ── BioBuf ───────────────────────────────────────────────────────────────
+
+/// A T, then its bio's bvecs.
+#[repr(C)]
+struct Inline<T> {
+    t:    T,
+    vecs: [c::bio_vec],
+}
+
+/// A DST, sized when made. A KBox, not a KVBox: an endio may drop it, and
+/// kvfree() isn't safe in interrupt context.
+pub struct BioBuf<T: HasBio>(KBox<Inline<T>>);
+
+// SAFETY: as BioBox's
+unsafe impl<T: HasBio + Send> Send for BioBuf<T> {}
+
+impl<T: HasBio> BioBuf<T> {
+    /// As BioSet::alloc(), the bvecs inline.
+    pub fn new<E, I>(bdev: *mut c::block_device, nr_vecs: u16, opf: u32,
+                     init: impl FnOnce(BioInPlace) -> I) -> Result<Self, E>
+    where
+        I: PinInit<T, E>,
+        E: From<BchError>,
+    {
+        let layout = Layout::new::<T>()
+            .extend(Layout::array::<c::bio_vec>(nr_vecs.into()).expect("a u16's worth of bvecs"))
+            .expect("a T and its bvecs").0
+            .pad_to_align();
+        let p = kzalloc(layout).map_err(|_| BchError::from(c::ENOMEM))?;
+        let inline = core::ptr::slice_from_raw_parts_mut(p.as_ptr().cast::<c::bio_vec>(), nr_vecs.into())
+            as *mut Inline<T>;
+
+        // SAFETY: the allocation, laid out as Inline<T> with nr_vecs bvecs:
+        // its bio, given its own bvecs, then the rest of the T by @init -
+        // and then a KBox's, as kzalloc() is
+        unsafe {
+            let t = &raw mut (*inline).t;
+            let bio = bio_of(t);
+            c::bio_init(bio, bdev, (&raw mut (*inline).vecs).cast(), nr_vecs, opf as _);
+            match init_at(init(BioInPlace(bio)), t) {
+                Ok(()) => Ok(Self(KBox::from_raw(inline))),
+                Err(e) => {
+                    c::bio_uninit(bio);
+                    kfree(p, layout);
+                    Err(e)
+                }
+            }
+        }
+    }
+}
+
+impl<T: HasBio> Deref for BioBuf<T> {
+    type Target = T;
+
+    fn deref(&self) -> &T {
+        &self.0.t
+    }
+}
+
+// SAFETY: the buffer's bio, its own
+unsafe impl<T: HasBio> BioOwner for BioBuf<T> {
+    fn bio(&self) -> &Bio {
+        // SAFETY: the T's bio
+        unsafe { Bio::from_raw(bio_of(core::ptr::from_ref(&self.0.t).cast_mut())) }
+    }
+
+    fn bio_mut(&mut self) -> Pin<&mut Bio> {
+        // SAFETY: the T's bio, had by &mut
+        unsafe { Bio::from_raw_mut(bio_of(&raw mut self.0.t)) }
+    }
+}
+
+// SAFETY: the T's bio, and back: container_of(), and its bvecs' count -
+// bi_max_vecs, which bio_init() set from it and bio_reset() keeps
+unsafe impl<T: HasBio> RawBio for BioBuf<T> {
+    fn into_raw(self) -> *mut c::bio {
+        let this = core::mem::ManuallyDrop::new(self);
+        // SAFETY: the box, moved out of what's never dropped
+        let inline = KBox::into_raw(unsafe { core::ptr::read(&this.0) });
+        // SAFETY: the box's
+        bio_of(unsafe { &raw mut (*inline).t })
+    }
+
+    unsafe fn from_raw(bio: *mut c::bio) -> Self {
+        // SAFETY: the caller's - a BioBuf<T>'s bio
+        unsafe {
+            let nr = (*bio).bi_max_vecs as usize;
+            let inline = core::ptr::slice_from_raw_parts_mut(of_bio::<T>(bio).cast::<c::bio_vec>(), nr);
+            Self(KBox::from_raw(inline as *mut Inline<T>))
+        }
+    }
+}
+
+impl<T: HasBio> Drop for BioBuf<T> {
+    fn drop(&mut self) {
+        // SAFETY: its bio, idle: the box then drops the T, and frees it all
+        unsafe { c::bio_uninit(self.bio_mut().raw_mut()) }
+    }
+}
+
+/// For a field C shares as a struct bio *: an Option of one is a nullable
+/// pointer, zeroed None, where a BioBuf is a fat one. For as long as such
+/// structs are C's.
+#[repr(transparent)]
+pub struct BioBufPtr<T: HasBio>(NonNull<T>);
+
+// SAFETY: as BioBuf's
+unsafe impl<T: HasBio + Send> Send for BioBufPtr<T> {}
+
+// SAFETY: a NonNull, repr(transparent): an Option of one is a nullable
+// pointer, all zeroes None
+unsafe impl<T: HasBio> ::pin_init::ZeroableOption for BioBufPtr<T> {}
+
+impl<T: HasBio> From<BioBuf<T>> for BioBufPtr<T> {
+    fn from(b: BioBuf<T>) -> Self {
+        // SAFETY: a bio's T: into_raw()'s
+        BioBufPtr(unsafe { NonNull::new_unchecked(of_bio::<T>(b.into_raw())) })
+    }
+}
+
+impl<T: HasBio> Deref for BioBufPtr<T> {
+    type Target = T;
+
+    fn deref(&self) -> &T {
+        // SAFETY: its T, live while it's had
+        unsafe { self.0.as_ref() }
+    }
+}
+
+// SAFETY: the buffer's bio, its own
+unsafe impl<T: HasBio> BioOwner for BioBufPtr<T> {
+    fn bio(&self) -> &Bio {
+        // SAFETY: the T's bio
+        unsafe { Bio::from_raw(bio_of(self.0.as_ptr())) }
+    }
+
+    fn bio_mut(&mut self) -> Pin<&mut Bio> {
+        // SAFETY: the T's bio, had by &mut
+        unsafe { Bio::from_raw_mut(bio_of(self.0.as_ptr())) }
+    }
+}
+
+impl<T: HasBio> Drop for BioBufPtr<T> {
+    fn drop(&mut self) {
+        // SAFETY: a BioBuf's bio, from into_raw(), given back once
+        drop(unsafe { BioBuf::<T>::from_raw(bio_of(self.0.as_ptr())) })
+    }
+}
+
+// ── Submission ───────────────────────────────────────────────────────────
+
+/// # Safety
+/// from_raw() of into_raw()'s bio is the owner given up.
+pub unsafe trait RawBio: BioOwner + Sized {
+    fn into_raw(self) -> *mut c::bio;
+
+    /// # Safety
+    /// @bio is into_raw()'s, of an owner of this type, not since taken back.
+    unsafe fn from_raw(bio: *mut c::bio) -> Self;
+
+    /// 'static: the IO has it for as long as it takes.
+    fn submit<E: Endio<Self>>(self)
+    where
+        Self: Send + 'static,
+    {
+        let bio = self.into_raw();
+        // SAFETY: the bio, the owner's: endio::<Self, E>() takes it back
+        unsafe {
+            (*bio).bi_end_io = Some(endio::<Self, E>);
+            c::submit_bio(bio);
+        }
+    }
+}
+
+/// The result is bio().status(). A type of its own, not O's: one struct's
+/// bios may complete differently by the path that submitted them.
+///
+/// It runs where the IO completes - softirq, or an interrupt - so it may not
+/// sleep, nor may T's Drop, if it drops the owner: what would goes to a
+/// workqueue, with the owner.
+pub trait Endio<O> {
+    fn endio(bio: O);
+}
+
+unsafe extern "C" fn endio<O: RawBio, E: Endio<O>>(bio: *mut c::bio) {
+    // SAFETY: armed by submit() alone, on an O's bio, given up with it
+    E::endio(unsafe { O::from_raw(bio) })
+}
diff --git a/fs/bcachefs/util/bio/pages.rs b/fs/bcachefs/util/bio/pages.rs
new file mode 100644
index 0000000..dbd0d4c
--- /dev/null
+++ b/fs/bcachefs/util/bio/pages.rs
@@ -0,0 +1,119 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Pages a bio owns - the data update's and the write path's bounce buffers -
+//! allocated into its bvecs, and freed from them. Each allocation is at most
+//! the bounce pool's element size, PAGE_SIZE << PAGE_ALLOC_COSTLY_ORDER, and
+//! page aligned in the kernel, as the device's DMA alignment isn't known.
+//!
+//! The bounce pool, c->bio_bounce_bufs, is the fallback that can't fail: its
+//! elements are whole, and taken under bio_bounce_pages_lock, as two
+//! allocators each holding part of the pool would deadlock it. Freeing tells
+//! them apart by size: a bvec of exactly the element size goes back to the
+//! pool.
+
+use core::ffi::{c_int, c_uint};
+use core::ptr::NonNull;
+
+use crate::c;
+use crate::fs::Fs;
+use crate::locking::Lock;
+use crate::util::alloc::AllocError;
+use crate::util::ffi::Opaque;
+use crate::util::kernel::PAGE_SIZE;
+use cstruct_macros::c_export;
+
+use super::iter::page_address;
+
+/// The bounce pool's element size: read.h's BIO_BOUNCE_BUF_POOL_LEN.
+const POOL_LEN: usize = PAGE_SIZE << c::PAGE_ALLOC_COSTLY_ORDER;
+
+// SAFETY: a zeroed mempool is a valid uninitialized one, as in C's
+// kvzalloc()'d bch_fs; bch2_fs_init() initializes it
+unsafe impl ::pin_init::Zeroable for Opaque<c::mempool_t> {}
+
+/// Allocates pages into @bio up to @size bytes, each allocation a multiple of
+/// @bs. On AllocError, what was allocated stays on the bio. The bio must have
+/// the bvecs for them.
+pub fn alloc_pages(bio: &mut c::bio, bs: u32, size: usize, gfp: c::gfp_t) -> Result<(), AllocError> {
+    let bs = bs as usize;
+    assert!(bs.is_power_of_two() && size % bs == 0, "allocating {size} bytes for a bio of {bs} byte blocks");
+
+    while (bio.bi_iter.bi_size as usize) < size {
+        let b = (size - bio.bi_iter.bi_size as usize).min(bs.max(POOL_LEN));
+        assert!(b % bs == 0, "a bio's pages {b} bytes, not a multiple of its {bs} byte blocks");
+
+        // SAFETY: no pointers in
+        let p = NonNull::new(unsafe { c::rust_bio_pages_alloc(b, gfp) }).ok_or(AllocError)?;
+        // SAFETY: a fresh allocation of @b bytes, the bio's now
+        unsafe { c::bio_add_virt_nofail(bio, p.as_ptr(), b as u32) };
+    }
+    Ok(())
+}
+
+/// Allocates the rest of @size from the bounce pool, which waits rather than
+/// fails. It hands out whole elements, so the bio's size is trimmed to @size
+/// after.
+#[c_export]
+pub fn __bch2_bio_alloc_pages_pool(c: &Opaque<c::bch_fs>, bio: &mut c::bio, _bs: c_uint, size: usize, gfp: c::gfp_t) {
+    let fs = Fs::from_c(c);
+    let _lock = Lock::from_c(&fs.bio_bounce_pages_lock).lock();
+
+    while (bio.bi_iter.bi_size as usize) < size {
+        // SAFETY: the filesystem's pool; an element is POOL_LEN bytes, the
+        // bio's now
+        unsafe {
+            let p = c::mempool_alloc_noprof(fs.bio_bounce_bufs.as_ptr(), gfp);
+            c::bio_add_virt_nofail(bio, p, POOL_LEN as u32);
+        }
+    }
+    bio.bi_iter.bi_size = bio.bi_iter.bi_size.min(size as u32);
+}
+
+/// Allocates @size bytes into @bio with alloc_pages(), and the rest from the
+/// bounce pool. The bio must have the bvecs for them.
+#[c_export]
+pub fn bch2_bio_alloc_pages_pool(c: &Opaque<c::bch_fs>, bio: &mut c::bio, bs: c_uint, size: usize, gfp: c::gfp_t) {
+    // short is fine: the pool has the rest
+    let _ = alloc_pages(bio, Fs::from_c(c).opts().block_size.into(), size, gfp);
+    if (bio.bi_iter.bi_size as usize) < size {
+        __bch2_bio_alloc_pages_pool(c, bio, bs, size, gfp);
+    }
+}
+
+/// Frees what alloc_pages() and the bounce pool put on @bio.
+///
+/// # Safety
+/// Each of @bio's bvecs is a whole allocation of one of them, and the bio's
+/// done with: not in flight.
+pub unsafe fn free_pages_pool(fs: &Fs, bio: &mut c::bio) {
+    for i in 0..bio.bi_vcnt as usize {
+        // SAFETY: one of its bvecs
+        let bv = unsafe { *bio.bi_io_vec.add(i) };
+        // SAFETY: the caller's: an allocation of bv_len, at its page's address
+        unsafe {
+            let p = page_address(NonNull::new(bv.bv_page).expect("a bvec's page"))
+                .add(bv.bv_offset as usize).as_ptr().cast();
+            if bv.bv_len as usize == POOL_LEN {
+                c::mempool_free(p, fs.bio_bounce_bufs.as_ptr());
+            } else {
+                c::rust_bio_pages_free(p, bv.bv_len as usize);
+            }
+        }
+    }
+    bio.bi_vcnt = 0;
+}
+
+// ── For C ────────────────────────────────────────────────────────────────
+
+#[c_export]
+pub fn bch2_bio_alloc_pages(bio: &mut c::bio, bs: c_uint, size: usize, gfp: c::gfp_t) -> c_int {
+    alloc_pages(bio, bs, size, gfp).map_or(-(c::ENOMEM as c_int), |()| 0)
+}
+
+/// # Safety
+/// free_pages_pool()'s.
+#[c_export]
+pub unsafe fn bch2_bio_free_pages_pool(c: &Opaque<c::bch_fs>, bio: &mut c::bio) {
+    // SAFETY: the caller's
+    unsafe { free_pages_pool(Fs::from_c(c), bio) }
+}
diff --git a/fs/bcachefs/util/bitmap.rs b/fs/bcachefs/util/bitmap.rs
new file mode 100644
index 0000000..e2f4de8
--- /dev/null
+++ b/fs/bcachefs/util/bitmap.rs
@@ -0,0 +1,394 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Bitmaps: C's `unsigned long d[BITS_TO_LONGS(n)]`, and the bitops on it.
+//!
+//! C uses one array two ways, so here it's two types. Bitmap is the plain
+//! kind - __set_bit() and friends, on a mask nothing else can see: one on the
+//! stack, an allocation request's. AtomicBitmap is the shared kind - set_bit()
+//! and friends, with readers going at it meanwhile: c->devs_online, the
+//! allocator's rw_devs[], write completions marking devs_need_flush. Between
+//! them is the snapshot C takes by copying the struct - `new_rw_devs =
+//! c->allocator.rw_devs[0]`, then __clear_bit() on the copy - which here is
+//! AtomicBitArray::load(), into a BitArray to change.
+//!
+//! Both are unsized, over their words, as the kernel's Rust bitmap is; a
+//! fixed-size one is a BitArray or AtomicBitArray, which derefs to it. Sized
+//! in words, not bits: a [usize; bits_to_longs(BITS)] with BITS a generic
+//! parameter needs generic_const_exprs, which is unstable - so a field says
+//! its size where it's declared, BitArray<{ bits_to_longs(N) }>.
+//!
+//! Nothing here sets a bit past the ones a bitmap is for, so weight() and
+//! iter() needn't know where those end; the one thing that looks for a clear
+//! bit, next_zero(), is told.
+//!
+//! Orderings follow C's bitops: set, clear and test are relaxed, and those
+//! that return the old value - test_and_set_bit() - are fully ordered.
+
+use core::ops::{Deref, DerefMut};
+use core::sync::atomic::{AtomicUsize, Ordering};
+
+use crate::types::Le64;
+
+const BITS: usize = usize::BITS as usize;
+
+/// C's words are unsigned longs.
+const _: () = assert!(size_of::<core::ffi::c_ulong>() == size_of::<usize>());
+
+/// An AtomicBitmap's word, named as C sees it - unsigned long - for a struct
+/// C shares to declare its words with.
+pub type AtomicULong = AtomicUsize;
+
+/// Bit @bit's word, and its mask in that word.
+fn pos(bit: usize) -> (usize, usize) {
+    (bit / BITS, 1 << (bit % BITS))
+}
+
+/// The set bits of word @i, @w, in order: for_each_set_bit()'s inner loop.
+fn word_bits(i: usize, mut w: usize) -> impl Iterator<Item = usize> {
+    core::iter::from_fn(move || {
+        (w != 0).then(|| {
+            let b = w.trailing_zeros() as usize;
+            w &= w - 1;
+            i * BITS + b
+        })
+    })
+}
+
+// ── Plain ────────────────────────────────────────────────────────────────
+
+/// A bitmap nothing else is changing: __set_bit(), __clear_bit(), bitmap_*().
+#[repr(transparent)]
+pub struct Bitmap([usize]);
+
+impl Bitmap {
+    pub fn from_words(w: &[usize]) -> &Bitmap {
+        // SAFETY: repr(transparent) over [usize]
+        unsafe { &*(w as *const [usize] as *const Bitmap) }
+    }
+
+    pub fn from_words_mut(w: &mut [usize]) -> &mut Bitmap {
+        // SAFETY: repr(transparent) over [usize]
+        unsafe { &mut *(w as *mut [usize] as *mut Bitmap) }
+    }
+
+    pub fn words(&self) -> &[usize] {
+        &self.0
+    }
+
+    /// test_bit(): false past the end.
+    pub fn test(&self, bit: usize) -> bool {
+        let (i, m) = pos(bit);
+        self.0.get(i).is_some_and(|w| w & m != 0)
+    }
+
+    /// __set_bit().
+    pub fn set(&mut self, bit: usize) {
+        let (i, m) = pos(bit);
+        self.0[i] |= m;
+    }
+
+    /// __clear_bit().
+    pub fn clear(&mut self, bit: usize) {
+        let (i, m) = pos(bit);
+        self.0[i] &= !m;
+    }
+
+    /// __test_and_set_bit(): whether it was set.
+    pub fn test_and_set(&mut self, bit: usize) -> bool {
+        let was = self.test(bit);
+        self.set(bit);
+        was
+    }
+
+    /// bitmap_weight().
+    pub fn weight(&self) -> u32 {
+        self.0.iter().map(|w| w.count_ones()).sum()
+    }
+
+    /// bitmap_empty().
+    pub fn is_empty(&self) -> bool {
+        self.0.iter().all(|&w| w == 0)
+    }
+
+    /// The set bits, in order: for_each_set_bit().
+    pub fn iter(&self) -> impl Iterator<Item = usize> + '_ {
+        self.0.iter().enumerate().flat_map(|(i, &w)| word_bits(i, w))
+    }
+
+    /// The first clear bit from @start, before @end: find_next_zero_bit().
+    pub fn next_zero(&self, start: usize, end: usize) -> Option<usize> {
+        (start..end).find(|&bit| !self.test(bit))
+    }
+
+    fn zip_mut(&mut self, o: &Bitmap, f: impl Fn(usize, usize) -> usize) {
+        assert_eq!(self.0.len(), o.0.len(), "bitmaps of different sizes");
+        for (a, &b) in self.0.iter_mut().zip(&o.0) {
+            *a = f(*a, b);
+        }
+    }
+
+    /// bitmap_and(), into this one.
+    pub fn and(&mut self, o: &Bitmap) {
+        self.zip_mut(o, |a, b| a & b)
+    }
+
+    /// bitmap_or(), into this one.
+    pub fn or(&mut self, o: &Bitmap) {
+        self.zip_mut(o, |a, b| a | b)
+    }
+
+    /// bitmap_andnot(), into this one: @o's bits cleared.
+    pub fn andnot(&mut self, o: &Bitmap) {
+        self.zip_mut(o, |a, b| a & !b)
+    }
+
+    /// bitmap_andnot() the other way, into this one: @o's bits that this one
+    /// hasn't.
+    pub fn not_and(&mut self, o: &Bitmap) {
+        self.zip_mut(o, |a, b| !a & b)
+    }
+
+    /// bitmap_intersects().
+    pub fn intersects(&self, o: &Bitmap) -> bool {
+        self.0.iter().zip(&o.0).any(|(a, b)| a & b != 0)
+    }
+}
+
+impl PartialEq for Bitmap {
+    /// bitmap_equal().
+    fn eq(&self, o: &Bitmap) -> bool {
+        self.0 == o.0
+    }
+}
+
+impl Eq for Bitmap {}
+
+/// A fixed-size Bitmap, of @W words: C's `unsigned long d[W]`.
+#[repr(transparent)]
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub struct BitArray<const W: usize>([usize; W]);
+
+// SAFETY: integers; all zeroes is empty
+unsafe impl<const W: usize> ::pin_init::Zeroable for BitArray<W> {}
+
+// SAFETY: words, unpadded; any bits are a set
+unsafe impl<const W: usize> crate::util::vstructs::Plain for BitArray<W> {}
+
+impl<const W: usize> Default for BitArray<W> {
+    fn default() -> Self {
+        Self([0; W])
+    }
+}
+
+impl<const W: usize> Deref for BitArray<W> {
+    type Target = Bitmap;
+
+    fn deref(&self) -> &Bitmap {
+        Bitmap::from_words(&self.0)
+    }
+}
+
+impl<const W: usize> DerefMut for BitArray<W> {
+    fn deref_mut(&mut self) -> &mut Bitmap {
+        Bitmap::from_words_mut(&mut self.0)
+    }
+}
+
+// ── Atomic ───────────────────────────────────────────────────────────────
+
+/// A bitmap that's set and cleared under readers: set_bit(), clear_bit().
+/// Each bit is atomic - a reader walking it sees each word as it was when
+/// it got there, not the whole as of one moment.
+#[repr(transparent)]
+pub struct AtomicBitmap([AtomicUsize]);
+
+impl AtomicBitmap {
+    pub fn from_words(w: &[AtomicUsize]) -> &AtomicBitmap {
+        // SAFETY: repr(transparent) over [AtomicUsize]
+        unsafe { &*(w as *const [AtomicUsize] as *const AtomicBitmap) }
+    }
+
+    /// test_bit(): false past the end.
+    pub fn test(&self, bit: usize) -> bool {
+        let (i, m) = pos(bit);
+        self.0.get(i).is_some_and(|w| w.load(Ordering::Relaxed) & m != 0)
+    }
+
+    /// set_bit().
+    pub fn set(&self, bit: usize) {
+        let (i, m) = pos(bit);
+        self.0[i].fetch_or(m, Ordering::Relaxed);
+    }
+
+    /// clear_bit().
+    pub fn clear(&self, bit: usize) {
+        let (i, m) = pos(bit);
+        self.0[i].fetch_and(!m, Ordering::Relaxed);
+    }
+
+    /// Set if @v, else clear: mod_bit().
+    pub fn assign(&self, bit: usize, v: bool) {
+        if v { self.set(bit) } else { self.clear(bit) }
+    }
+
+    /// test_and_set_bit(): whether it was set.
+    pub fn test_and_set(&self, bit: usize) -> bool {
+        let (i, m) = pos(bit);
+        self.0[i].fetch_or(m, Ordering::SeqCst) & m != 0
+    }
+
+    /// test_and_clear_bit(): whether it was set.
+    pub fn test_and_clear(&self, bit: usize) -> bool {
+        let (i, m) = pos(bit);
+        self.0[i].fetch_and(!m, Ordering::SeqCst) & m != 0
+    }
+
+    /// bitmap_weight().
+    pub fn weight(&self) -> u32 {
+        self.0.iter().map(|w| w.load(Ordering::Relaxed).count_ones()).sum()
+    }
+
+    /// The set bits, in order, each word read as it's reached:
+    /// for_each_set_bit().
+    pub fn iter(&self) -> impl Iterator<Item = usize> + '_ {
+        self.0.iter().enumerate().flat_map(|(i, w)| word_bits(i, w.load(Ordering::Relaxed)))
+    }
+
+    /// The first bit from @start, below @end, set here and clear in @not; @not's
+    /// bits past its words count as clear.
+    pub fn next_andnot(&self, not: &AtomicBitmap, start: usize, end: usize) -> Option<usize> {
+        let mut bit = start;
+        while bit < end {
+            let i = bit / BITS;
+            let not_w = not.0.get(i).map_or(0, |w| w.load(Ordering::Relaxed));
+            let w = self.0.get(i)?.load(Ordering::Relaxed) & !not_w & (!0 << (bit % BITS));
+
+            if w != 0 {
+                return Some(i * BITS + w.trailing_zeros() as usize).filter(|&b| b < end);
+            }
+            bit = (i + 1) * BITS;
+        }
+        None
+    }
+}
+
+/// A fixed-size AtomicBitmap, of @W words: C's `unsigned long d[W]`, set_bit()
+/// on.
+#[repr(transparent)]
+pub struct AtomicBitArray<const W: usize>([AtomicUsize; W]);
+
+impl<const W: usize> AtomicBitArray<W> {
+    /// A copy to work on - C's struct copy of a shared mask.
+    pub fn load(&self) -> BitArray<W> {
+        BitArray(core::array::from_fn(|i| self.0[i].load(Ordering::Relaxed)))
+    }
+
+    /// Replace it with @b, a word at a time - readers can see a mix.
+    pub fn store(&self, b: &BitArray<W>) {
+        for (a, &b) in self.0.iter().zip(&b.0) {
+            a.store(b, Ordering::Relaxed);
+        }
+    }
+}
+
+// SAFETY: atomic integers; all zeroes is empty
+unsafe impl<const W: usize> ::pin_init::Zeroable for AtomicBitArray<W> {}
+
+impl<const W: usize> Default for AtomicBitArray<W> {
+    fn default() -> Self {
+        Self([const { AtomicUsize::new(0) }; W])
+    }
+}
+
+impl<const W: usize> Deref for AtomicBitArray<W> {
+    type Target = AtomicBitmap;
+
+    fn deref(&self) -> &AtomicBitmap {
+        AtomicBitmap::from_words(&self.0)
+    }
+}
+
+// ── On disk ──────────────────────────────────────────────────────────────
+
+/// A bitmap on disk - a superblock section's: little-endian u64 words, so
+/// bit i is the same bit on every machine, and the words are u64 aligned as
+/// the structs that hold them are. C's *_bit_le64().
+#[repr(transparent)]
+pub struct LeBitmap([Le64]);
+
+impl LeBitmap {
+    pub fn from_words(w: &[Le64]) -> &LeBitmap {
+        // SAFETY: repr(transparent) over [Le64]
+        unsafe { &*(w as *const [Le64] as *const LeBitmap) }
+    }
+
+    pub fn from_words_mut(w: &mut [Le64]) -> &mut LeBitmap {
+        // SAFETY: repr(transparent) over [Le64]
+        unsafe { &mut *(w as *mut [Le64] as *mut LeBitmap) }
+    }
+
+    /// test_bit_le64(): false past the end.
+    pub fn test(&self, bit: usize) -> bool {
+        self.0.get(bit / 64).is_some_and(|w| w.get() & 1 << (bit % 64) != 0)
+    }
+
+    /// __set_bit_le64().
+    pub fn set(&mut self, bit: usize) {
+        self.0[bit / 64] |= 1 << (bit % 64);
+    }
+
+    /// __clear_bit_le64().
+    pub fn clear(&mut self, bit: usize) {
+        let w = &mut self.0[bit / 64];
+        *w = Le64::new(w.get() & !(1 << (bit % 64)));
+    }
+
+    /// __test_and_set_bit_le64(): whether it was set.
+    pub fn test_and_set(&mut self, bit: usize) -> bool {
+        let was = self.test(bit);
+        self.set(bit);
+        was
+    }
+
+    /// The set bits, in order.
+    pub fn iter(&self) -> impl Iterator<Item = usize> + '_ {
+        self.0.iter().enumerate().flat_map(|(i, w)| {
+            let mut w = w.get();
+            core::iter::from_fn(move || {
+                (w != 0).then(|| {
+                    let b = w.trailing_zeros() as usize;
+                    w &= w - 1;
+                    i * 64 + b
+                })
+            })
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn bitmap(words: &[usize]) -> std::vec::Vec<AtomicUsize> {
+        words.iter().map(|&w| AtomicUsize::new(w)).collect()
+    }
+
+    #[test]
+    fn next_andnot_is_find_next_andnot_bit() {
+        let set = bitmap(&[1 << 3 | 1 << 63, 1 << 0 | 1 << 5]);
+        let not = bitmap(&[1 << 63]);
+        let (set, not) = (AtomicBitmap::from_words(&set), AtomicBitmap::from_words(&not));
+        let none = AtomicBitmap::from_words(&[]);
+
+        assert_eq!(set.next_andnot(none, 0, 128), Some(3));
+        assert_eq!(set.next_andnot(none, 4, 128), Some(63));
+        // masked out, and past the end of @not's words: clear there
+        assert_eq!(set.next_andnot(not, 4, 128), Some(64));
+        assert_eq!(set.next_andnot(not, 65, 128), Some(69));
+        // @end bounds it, mid-word too
+        assert_eq!(set.next_andnot(not, 65, 69), None);
+        assert_eq!(set.next_andnot(none, 70, 128), None);
+        // past the bitmap's words
+        assert_eq!(set.next_andnot(none, 70, 1000), None);
+    }
+}
diff --git a/fs/bcachefs/util/clock.c b/fs/bcachefs/util/clock.c
new file mode 100644
index 0000000..85ce6db
--- /dev/null
+++ b/fs/bcachefs/util/clock.c
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: GPL-2.0
+#include "bcachefs.h"
+#include "clock.h"
+
+#include <linux/freezer.h>
+#include <linux/kthread.h>
+#include <linux/preempt.h>
+
+static inline bool io_timer_cmp(const void *l, const void *r, void __always_unused *args)
+{
+	struct io_timer **_l = (struct io_timer **)l;
+	struct io_timer **_r = (struct io_timer **)r;
+
+	return (*_l)->expire < (*_r)->expire;
+}
+
+static const struct min_heap_callbacks callbacks = {
+	.less = io_timer_cmp,
+	.swp = NULL,
+};
+
+void bch2_io_timer_add(struct io_clock *clock, struct io_timer *timer)
+{
+	spin_lock(&clock->timer_lock);
+
+	if (time_after_eq64((u64) atomic64_read(&clock->now), timer->expire)) {
+		spin_unlock(&clock->timer_lock);
+		timer->fn(timer);
+		return;
+	}
+
+	if (!darray_find(clock->timers, timer))
+		BUG_ON(!min_heap_push(&clock->timers, &timer, &callbacks, NULL));
+
+	spin_unlock(&clock->timer_lock);
+}
+
+void bch2_io_timer_del(struct io_clock *clock, struct io_timer *timer)
+{
+	guard(spinlock)(&clock->timer_lock);
+
+	for (size_t i = 0; i < clock->timers.nr; i++)
+		if (clock->timers.data[i] == timer) {
+			min_heap_del(&clock->timers, i, &callbacks, NULL);
+			return;
+		}
+}
+
+struct io_clock_wait {
+	struct io_timer		io_timer;
+	struct task_struct	*task;
+	int			expired;
+};
+
+static void io_clock_wait_fn(struct io_timer *timer)
+{
+	struct io_clock_wait *wait = container_of(timer,
+				struct io_clock_wait, io_timer);
+
+	wait->expired = 1;
+	wake_up_process(wait->task);
+}
+
+void bch2_io_clock_schedule_timeout(struct io_clock *clock, u64 until)
+{
+	struct io_clock_wait wait = {
+		.io_timer.expire	= until,
+		.io_timer.fn		= io_clock_wait_fn,
+		.io_timer.fn2		= (void *) _RET_IP_,
+		.task			= current,
+	};
+
+	bch2_io_timer_add(clock, &wait.io_timer);
+	schedule();
+	bch2_io_timer_del(clock, &wait.io_timer);
+}
+
+/*
+ * The caller must set TASK_INTERRUPTIBLE before calling: after setting it (and
+ * before calling) the caller can recheck its wakeup condition, and a waker
+ * that changes the condition and then calls wake_up_process() is guaranteed to
+ * either be seen by that check or to wake the schedule_timeout() - no lost
+ * wakeups. This also covers the io timer itself firing as soon as it's added.
+ */
+unsigned long bch2_kthread_io_clock_wait_once(struct io_clock *clock,
+				     u64 io_until, unsigned long cpu_timeout)
+{
+	bool kthread = (current->flags & PF_KTHREAD) != 0;
+	struct io_clock_wait wait = {
+		.io_timer.expire	= io_until,
+		.io_timer.fn		= io_clock_wait_fn,
+		.io_timer.fn2		= (void *) _RET_IP_,
+		.task			= current,
+	};
+
+	bch2_io_timer_add(clock, &wait.io_timer);
+
+	if (!(kthread && kthread_should_stop())) {
+		cpu_timeout = schedule_timeout(cpu_timeout);
+		try_to_freeze();
+	}
+
+	__set_current_state(TASK_RUNNING);
+	bch2_io_timer_del(clock, &wait.io_timer);
+	return cpu_timeout;
+}
+
+void bch2_kthread_io_clock_wait(struct io_clock *clock,
+				u64 io_until, unsigned long cpu_timeout)
+{
+	bool kthread = (current->flags & PF_KTHREAD) != 0;
+
+	while (!(kthread && kthread_should_stop()) &&
+	       cpu_timeout &&
+	       atomic64_read(&clock->now) < io_until) {
+		set_current_state(TASK_INTERRUPTIBLE);
+		cpu_timeout = bch2_kthread_io_clock_wait_once(clock, io_until, cpu_timeout);
+	}
+}
+
+static struct io_timer *get_expired_timer(struct io_clock *clock, u64 now)
+{
+	struct io_timer *ret = NULL;
+
+	if (clock->timers.nr &&
+	    time_after_eq64(now, clock->timers.data[0]->expire)) {
+		ret = *min_heap_peek(&clock->timers);
+		min_heap_pop(&clock->timers, &callbacks, NULL);
+	}
+
+	return ret;
+}
+
+void __bch2_increment_clock(struct io_clock *clock, u64 sectors)
+{
+	struct io_timer *timer;
+	u64 now = atomic64_add_return(sectors, &clock->now);
+
+	guard(spinlock)(&clock->timer_lock);
+
+	while ((timer = get_expired_timer(clock, now)))
+		timer->fn(timer);
+}
+
+__cold void bch2_io_timers_to_text(struct printbuf *out, struct io_clock *clock)
+{
+	u64 now = atomic64_read(&clock->now);
+
+	printbuf_tabstop_push(out, 40);
+	prt_printf(out, "current time:\t%llu\n", now);
+
+	guard(printbuf_atomic)(out);
+	guard(spinlock)(&clock->timer_lock);
+
+	for (unsigned i = 0; i < clock->timers.nr; i++)
+		prt_printf(out, "%ps %ps:\t%llu\n",
+		       clock->timers.data[i]->fn,
+		       clock->timers.data[i]->fn2,
+		       clock->timers.data[i]->expire);
+}
+
+void bch2_io_clock_exit(struct io_clock *clock)
+{
+	free_heap(&clock->timers);
+	free_percpu(clock->pcpu_buf);
+}
+
+int bch2_io_clock_init(struct io_clock *clock)
+{
+	atomic64_set(&clock->now, 0);
+	spin_lock_init(&clock->timer_lock);
+
+	clock->max_slop = IO_CLOCK_PCPU_SECTORS * num_possible_cpus();
+
+	clock->pcpu_buf = alloc_percpu(*clock->pcpu_buf);
+	if (!clock->pcpu_buf)
+		return -BCH_ERR_ENOMEM_io_clock_init;
+
+	if (!init_heap(&clock->timers, NR_IO_TIMERS, GFP_KERNEL))
+		return -BCH_ERR_ENOMEM_io_clock_init;
+
+	return 0;
+}
diff --git a/fs/bcachefs/util/clock.h b/fs/bcachefs/util/clock.h
new file mode 100644
index 0000000..7587850
--- /dev/null
+++ b/fs/bcachefs/util/clock.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_CLOCK_H
+#define _BCACHEFS_CLOCK_H
+
+unsigned long bch2_kthread_io_clock_wait_once(struct io_clock *, u64, unsigned long);
+void bch2_kthread_io_clock_wait(struct io_clock *, u64, unsigned long);
+
+void __bch2_increment_clock(struct io_clock *, u64);
+
+static inline void bch2_increment_clock(struct bch_fs *c, u64 sectors,
+					int rw)
+{
+	struct io_clock *clock = &c->io_clock[rw];
+
+	if (unlikely(this_cpu_add_return(*clock->pcpu_buf, sectors) >=
+		   IO_CLOCK_PCPU_SECTORS))
+		__bch2_increment_clock(clock, this_cpu_xchg(*clock->pcpu_buf, 0));
+}
+
+void bch2_io_clock_schedule_timeout(struct io_clock *, u64);
+
+void bch2_io_timers_to_text(struct printbuf *, struct io_clock *);
+
+void bch2_io_clock_exit(struct io_clock *);
+int bch2_io_clock_init(struct io_clock *);
+
+#endif /* _BCACHEFS_CLOCK_H */
diff --git a/fs/bcachefs/util/clock.rs b/fs/bcachefs/util/clock.rs
new file mode 100644
index 0000000..529904b
--- /dev/null
+++ b/fs/bcachefs/util/clock.rs
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Waiting on an io clock - util/clock.c's clocks of sectors of IO done: a
+//! timer on the clock that wakes the waiter when the clock reaches its
+//! time, and sleep_until() on that or the waiter's own condition, as
+//! bch2_kthread_io_clock_wait_once() and its caller's recheck are in C.
+//!
+//! The timer's on the waiter's stack, in the clock's heap while it waits: a
+//! guard takes it out on the way out, however that is. It fires from the IO
+//! path - __bch2_increment_clock(), any context - so all it does is set a
+//! flag and wake the task; and it fires under the clock's timer_lock, which
+//! taking it out takes too, so once it's out it isn't firing.
+
+use crate::c;
+use crate::util::sleep::{sleep_until, task_waker, Sleep, SleepEnd};
+use core::ffi::c_void;
+use core::sync::atomic::{AtomicBool, Ordering};
+use core::task::Waker;
+
+/// A waiter's timer: io_timer first, so the timer's address is its.
+#[repr(C)]
+struct Wait {
+    timer:   c::io_timer,
+    expired: AtomicBool,
+    waker:   Waker,
+}
+
+unsafe extern "C" fn wait_expired(timer: *mut c::io_timer) {
+    // SAFETY: a Wait's timer, alive while it's on the clock - and it's
+    // taken off before the Wait goes
+    let w = unsafe { &*timer.cast::<Wait>() };
+    w.expired.store(true, Ordering::Release);
+    w.waker.wake_by_ref();
+}
+
+/// Takes the timer off the clock, if it hasn't fired.
+struct OnClock<'a>(&'a c::io_clock, &'a Wait);
+
+impl Drop for OnClock<'_> {
+    fn drop(&mut self) {
+        // SAFETY: the clock's, changed by C under its timer_lock
+        unsafe { c::bch2_io_timer_del(core::ptr::from_ref(self.0).cast_mut(),
+                                      core::ptr::from_ref(&self.1.timer).cast_mut()) };
+    }
+}
+
+impl c::io_clock {
+    /// Sleep, as @how says, until the clock reaches @until - None - or
+    /// @cond() says otherwise, checked after every wake: kthread_should_stop()
+    /// say. @cond runs in the sleep's task state, so it mustn't sleep.
+    pub fn wait_until<T, E: SleepEnd>(&self, until: u64, how: Sleep<E>,
+                                      mut cond: impl FnMut() -> Option<T>) -> Result<Option<T>, E> {
+        let w = Wait {
+            timer:   c::io_timer { fn_: Some(wait_expired), fn2: wait_expired as *mut c_void, expire: until },
+            expired: AtomicBool::new(false),
+            waker:   task_waker(),
+        };
+        // SAFETY: as OnClock's: w stays put, and off the clock before it goes
+        unsafe { c::bch2_io_timer_add(core::ptr::from_ref(self).cast_mut(),
+                                      core::ptr::from_ref(&w.timer).cast_mut()) };
+        let _on_clock = OnClock(self, &w);
+
+        sleep_until(how, || match cond() {
+            Some(v) => Some(Some(v)),
+            None    => w.expired.load(Ordering::Acquire).then_some(None),
+        })
+    }
+}
diff --git a/fs/bcachefs/util/clock_types.rs b/fs/bcachefs/util/clock_types.rs
new file mode 100644
index 0000000..7d0692e
--- /dev/null
+++ b/fs/bcachefs/util/clock_types.rs
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::types::{MinHeap, c_default};
+use crate::util::{Printbuf, ToText};
+use core::ffi::{c_uint, c_void};
+use core::sync::atomic::AtomicI64;
+use cstruct_macros::{c_const, c_extern, c_typedef, CStruct};
+
+c_const! {
+    #[c_int]
+    pub const NR_IO_TIMERS: u32 = c::BCH_SB_MEMBERS_MAX * 3;
+}
+
+/*
+ * Clocks/timers in units of sectors of IO:
+ *
+ * Note - they use percpu batching, so they're only approximate.
+ */
+
+c_typedef! {
+    pub type io_timer_fn = Option<unsafe extern "C" fn(*mut c::io_timer)>;
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, CStruct)]
+pub struct io_timer {
+    pub fn_: c::io_timer_fn,
+    pub fn2: *mut c_void,
+    pub expire: u64,
+}
+c_default!(io_timer);
+
+c_const! {
+    /* Amount to buffer up on a percpu counter */
+    #[c_int]
+    pub const IO_CLOCK_PCPU_SECTORS: u32 = 128;
+}
+
+c_typedef! {
+    #[c("DEFINE_MIN_HEAP(struct io_timer *, io_timer_heap) io_timer_heap")]
+    pub type io_timer_heap = MinHeap<*mut c::io_timer>;
+}
+
+#[repr(C)]
+#[derive(CStruct)]
+pub struct io_clock {
+    pub now: AtomicI64,
+    #[c("u16 __percpu *pcpu_buf")]
+    pub pcpu_buf: *mut u16,
+    pub max_slop: c_uint,
+
+    pub timer_lock: c::spinlock_t,
+    pub timers: c::io_timer_heap,
+}
+c_default!(io_clock);
+
+c_extern! {
+    pub fn bch2_io_timer_add(clock: *mut c::io_clock, timer: *mut c::io_timer);
+    pub fn bch2_io_timer_del(clock: *mut c::io_clock, timer: *mut c::io_timer);
+    pub fn bch2_io_timers_to_text(out: *mut c::printbuf, clock: *mut c::io_clock);
+}
+
+impl ToText for io_clock {
+    /// The clock, and its pending timers.
+    fn to_text(&self, out: &mut Printbuf) {
+        unsafe { bch2_io_timers_to_text(out.as_raw(), core::ptr::from_ref(self).cast_mut()) }
+    }
+}
diff --git a/fs/bcachefs/util/closure.rs b/fs/bcachefs/util/closure.rs
new file mode 100644
index 0000000..d772dd1
--- /dev/null
+++ b/fs/bcachefs/util/closure.rs
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! C's closures (vendor/closure.h), where Rust meets C that's built on them -
+//! to go as that C does:
+//!
+//! - refs on a closure: closure_return_sync() waits for them, so a walker can
+//!   use what it found after dropping the lock it found it under;
+//! - a closure on the stack, to hand to C that waits by putting it on a
+//!   waitlist - the allocator - and to sync on;
+//! - a waitlist, for what C waits on with its closure: a stripe buffer's
+//!   memory, whose waiters are the write path's.
+
+use crate::c;
+use crate::util::ffi::Opaque;
+use crate::util::refcount::{RefGuard, Refcount, TryRefcount};
+use core::cell::UnsafeCell;
+use core::marker::PhantomPinned;
+use core::pin::Pin;
+use core::ptr::NonNull;
+use pin_init::{pin_data, pinned_drop, PinInit};
+
+/// A ref on a closure. Its tryget() is closure_get_not_zero(): it fails once
+/// the closure has none left - it's finished, or finishing.
+///
+/// On an Opaque: whoever holds a ref may put it from any thread, writing the
+/// closure under every other holder's shared reference.
+pub type ClosureRef = RefGuard<Opaque<c::closure>>;
+
+// SAFETY: a closure's refcount is atomic, changed through a shared pointer;
+// closure_get() and a closure_get_not_zero() that succeeds take a ref
+unsafe impl Refcount for Opaque<c::closure> {
+    fn inc(&self) {
+        // SAFETY: as above
+        unsafe { c::closure_get(self.as_ptr()) }
+    }
+
+    unsafe fn dec(&self) {
+        // SAFETY: the caller's ref
+        unsafe { c::closure_put(self.as_ptr()) }
+    }
+}
+
+// SAFETY: as Refcount's
+unsafe impl TryRefcount for Opaque<c::closure> {
+    fn try_inc(&self) -> bool {
+        // SAFETY: as above
+        unsafe { c::closure_get_not_zero(self.as_ptr()) }
+    }
+}
+
+/// C's CLASS(closure_stack). Dropped, it syncs, so nothing's left holding it.
+#[pin_data(PinnedDrop)]
+pub struct StackClosure {
+    cl:   UnsafeCell<c::closure>,
+    #[pin]
+    _pin: PhantomPinned,
+}
+
+impl StackClosure {
+    pub fn new() -> impl PinInit<Self> {
+        // SAFETY: closure_init_stack() initializes all of it, in place
+        unsafe {
+            ::pin_init::pin_init_from_closure(|slot: *mut Self| {
+                c::closure_init_stack(UnsafeCell::raw_get(&raw mut (*slot).cl));
+                Ok(())
+            })
+        }
+    }
+
+    pub fn as_ptr(&self) -> *mut c::closure {
+        self.cl.get()
+    }
+
+    /// As a closure C handed over: what's written for one takes this too.
+    pub fn as_opaque(&self) -> &Opaque<c::closure> {
+        // SAFETY: Opaque is a transparent UnsafeCell, as @cl is; initialized
+        unsafe { &*self.cl.get().cast::<Opaque<c::closure>>() }
+    }
+
+    /// Its refs: one of its own, and one for each waitlist it's on.
+    pub fn nr_remaining(&self) -> u32 {
+        // SAFETY: initialized; the count is atomic
+        unsafe { c::closure_nr_remaining(self.as_ptr()) }
+    }
+
+    pub fn sync(&self) {
+        // SAFETY: initialized; its refcount atomic, the rest the waitlist's
+        unsafe { c::closure_sync(self.as_ptr()) }
+    }
+}
+
+#[pinned_drop]
+impl PinnedDrop for StackClosure {
+    fn drop(self: Pin<&mut Self>) {
+        self.sync()
+    }
+}
+
+/// A ref on @cl, until closure_wake_up(). False if it's waiting already.
+///
+/// # Safety
+/// @cl is a live closure, waiting on nothing else.
+pub unsafe fn closure_wait(list: &c::closure_waitlist, cl: NonNull<c::closure>) -> bool {
+    // SAFETY: a waitlist is a lockless list, added to through a shared
+    // pointer; @cl the caller's
+    unsafe { c::bch2_closure_wait(core::ptr::from_ref(list).cast_mut(), cl.as_ptr()) }
+}
+
+/// Whether anything's waiting on @list - a hint, racing its adds and wakes.
+pub fn closure_has_waiters(list: &c::closure_waitlist) -> bool {
+    // SAFETY: a lockless list's head, which its adds and wakes swap: read
+    // once, as READ_ONCE()
+    !unsafe { core::ptr::read_volatile(&raw const list.list.first) }.is_null()
+}
+
+/// Each waiter's ref put.
+pub fn closure_wake_up(list: &c::closure_waitlist) {
+    // SAFETY: as closure_wait()'s
+    unsafe { c::closure_wake_up(core::ptr::from_ref(list).cast_mut()) }
+}
+
+/// Sleep until @cond, woken by @list's closure_wake_up()s: C's
+/// closure_wait_event(). @cond is checked on the list, so a wake between the
+/// check and the sleep isn't lost. For a list C wakes - a wait Rust has end
+/// to end is a futex's, util/futex.rs.
+pub fn closure_wait_event(list: &c::closure_waitlist, mut cond: impl FnMut() -> bool) {
+    if cond() {
+        return;
+    }
+
+    pin_init::stack_pin_init!(let cl = StackClosure::new());
+    let clp = NonNull::new(cl.as_ptr()).expect("a closure on the stack");
+    loop {
+        // SAFETY: ours, waiting on nothing else - each wake_up() puts the ref
+        // this takes before the next
+        unsafe { closure_wait(list, clp) };
+        if cond() {
+            break;
+        }
+        cl.sync();
+    }
+    // off the waitlist, before it goes
+    closure_wake_up(list);
+}
diff --git a/fs/bcachefs/util/cuckoo.rs b/fs/bcachefs/util/cuckoo.rs
new file mode 100644
index 0000000..7be800d
--- /dev/null
+++ b/fs/bcachefs/util/cuckoo.rs
@@ -0,0 +1,849 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A cuckoo hash table looked up without a lock, under RCU: a set of u64s, or
+//! a map to entries that hold their own keys - in two ways or three, and
+//! hashed by a BuildHasher, as std's HashMap is: SipHash-1-3, by default, or
+//! hash_64()'s golden ratio (util/hash.rs) where a lookup's cost matters more
+//! than keys with structure colliding.
+//!
+//! Keys are std's: an item - the u64, or the entry it points to - is Hash +
+//! Eq, and a lookup takes anything it Borrows, as HashSet::get() does; an
+//! entry's Hash and Eq are its key's. An entry the map doesn't own can hold
+//! its own place in it, and its key - a Registration - so that dropping the
+//! entry takes it out.
+//!
+//! # The buffer
+//!
+//! One RcuArray: the seeds, as its header, and 2^bits slots. A key has a slot
+//! in each way, which its hash gives; a slot holds an item
+//! (CuckooItem) in one atomic word - a key, complemented, so the zeroes a
+//! buffer is allocated as are empty and u64::MAX can't be one, or a pointer
+//! to an entry, null for none. A lookup checks a slot per way: at most that
+//! many cache misses.
+//!
+//! The hasher's built from the seeds - S: From<[u64; 2]> - and keyed by them,
+//! so a key's slots are as if independent, whatever structure the keys have:
+//! two from one hash - i, and i ^ delta, delta odd, so each is the other's
+//! other - and for three ways a third from a second hasher, its key's first
+//! word another seed.
+//!
+//! The ways. Two fill to about half the table, three to most of it, so the
+//! table grows - a rehash, into a buffer twice the size with new seeds -
+//! before an insert would take it past 45%, for two, short of where inserts
+//! start to fail, or three quarters, for three. An insert that finds no room
+//! anyway rehashes with the item - new seeds at that size, then the next size
+//! up - and one that can't allocate fails with the table as it was. A table
+//! only shrinks by clear().
+//!
+//! The seeds and bits are mirrored outside the buffer, so a lookup hashes
+//! while it follows the pointer, not after. A rehash can race that, pairing
+//! one buffer's seeds with another's slots: a hit is still a hit - the key's
+//! in the buffer - and only a miss compares mirror and buffer, looking again
+//! with the buffer's own seeds on the rare mismatch.
+//!
+//! # Readers and writers
+//!
+//! Writers take the table's lock, a ByteLock - a mutex, zeroed unlocked, so a
+//! table is still valid zeroed - so they're one at a time, each seeing slots
+//! only it changes, and a rehash allocates, and sleeps, under it. (One lock
+//! for now; lockless writers, by cmpxchg, are for later.) A reader takes
+//! nothing, and sees a key a write isn't touching, always:
+//!
+//! - A slot changes by one atomic store: an item into an empty slot, or empty
+//!   into one with an item. A reader loads it once and compares the key - the
+//!   item's, or its entry's. An entry's key doesn't change while it's in a
+//!   table, and it stays valid until a grace period after it's out
+//!   (Entry::new()), so a hit returns its key's entry whatever the slot held
+//!   before or since.
+//! - An insert that has to evict finds its chain first - each occupant to
+//!   another of its slots - to an empty one, changing nothing, then moves it
+//!   from the empty end: each item is copied into a slot that's empty before
+//!   its own is emptied, so every item is in one of its slots at every
+//!   moment. A lookup can still miss one that moved during it - reading its
+//!   new slot before the copy, its old one after - so the writer counts each
+//!   move between the copy and the emptying, and a lookup that misses looks
+//!   again between two loads of the count, retrying if it changed. A hit
+//!   needs no count, and doesn't read it. So nothing waits on the writer -
+//!   one preempted mid-chain leaves every item findable - and a hit reads
+//!   nothing the writer writes but the slots.
+//!
+//! A writer's view of the buffer, locked(), is a borrow the types don't end:
+//! rehash() and clear() free the buffer after a grace period the writer isn't
+//! in, and take &self like everything else. So this file keeps to it:
+//! rehash() reads the old buffer only in its fill, before the replace, and
+//! put() takes no view across one.
+//!
+//! # Faults
+//!
+//! With CONFIG_BCACHEFS_TESTS a table has Faults, given by the torture test
+//! (debug/tests/cuckoo.rs), for what load alone rarely reaches: windows
+//! inside moves and between a lookup's slots, failed allocations, a packed
+//! table - and Seen, counts of how often each rare path ran. Without, Faults
+//! is zero sized and every hook a constant.
+
+use arrayvec::ArrayVec;
+use core::borrow::Borrow;
+use core::hash::{BuildHasher, Hash};
+use core::marker::PhantomData;
+use core::ptr::NonNull;
+use core::sync::atomic::{fence, AtomicPtr, AtomicU32, AtomicU64, AtomicUsize};
+use core::sync::atomic::Ordering::{self, Acquire, Relaxed, Release};
+
+use crate::locking::{ByteLock, Guard, Lock};
+use crate::types::CacheAligned;
+use crate::util::alloc::AllocError;
+use crate::util::backref::BackRef;
+use crate::util::kernel::random_u64;
+use crate::util::rcu::{read_lock, RcuArray, RcuElement, ReadGuard};
+use crate::util::siphash::SipHash13Key;
+
+/// The longest chain of moves an insert follows before it rehashes.
+const MAX_KICKS: usize = 32;
+
+/// An insert's chain of slots: u32s, as an RcuArray is at most INT_MAX bytes.
+type Path = ArrayVec<u32, { MAX_KICKS + 1 }>;
+
+/// The smallest table.
+const MIN_BITS: u32 = 2;
+
+/// Count a rare path's running, in Faults::seen.
+macro_rules! saw {
+    ($faults:expr, $what:ident) => {
+        #[cfg(CONFIG_BCACHEFS_TESTS)]
+        $faults.seen.$what.fetch_add(1, Relaxed);
+    };
+}
+
+/// A buffer's hashers' keys: its first, and a third way's first word.
+type Seeds = [u64; 3];
+
+// ── The hash ─────────────────────────────────────────────────────────────
+
+/// @key's slot in each of @W ways, in a table of 2^@bits hashed by @S keyed
+/// with @seeds. For zero @bits - a Mirror not yet written - any index, in the
+/// table or past it.
+fn slots<const W: usize, S: BuildHasher + From<[u64; 2]>, K: ?Sized + Hash>(seeds: Seeds, bits: u32, key: &K) -> [usize; W] {
+    let hash = |k0| S::from([k0, seeds[1]]).hash_one(key);
+    let mask = (1usize << bits) - 1;
+    let h = hash(seeds[0]);
+    // the top bits: a multiplicative hash's best
+    let i = h.wrapping_shr(64 - bits) as usize & mask;
+    core::array::from_fn(|w| match w {
+        0 => i,
+        1 => i ^ (((h >> 32) as usize | 1) & mask),
+        _ => hash(seeds[2]).wrapping_shr(64 - bits) as usize & mask,
+    })
+}
+
+// ── What a table holds ───────────────────────────────────────────────────
+
+/// What a table's slots hold, a word each.
+///
+/// XXX: not cuckoo's. Atomic, load() and store() are util/projections'
+/// AtomicWord again - with orderings, and None for empty: an empty niche
+/// (Option<NonNull<E>>, NonZeroU64) would retire the complemented u64, and
+/// storable() with it. And target() is Borrow, but for an entry's deref
+/// being unsafe - which is the RCU types' to say: see Entry.
+///
+/// # Safety
+/// Atomic owns nothing, so a bytewise copy is another; all zeroes is empty;
+/// load() gives back what store() stored.
+pub unsafe trait CuckooItem: Copy {
+    type Atomic: Send + Sync;
+
+    /// What it is, or points to: hashed and compared as its key.
+    type Target: ?Sized + Hash + Eq;
+
+    /// # Safety
+    /// The item's in a table: read from a slot in a read-side section, or
+    /// by the writer - an entry's valid until a grace period after it's out.
+    unsafe fn target(&self) -> &Self::Target;
+
+    /// Whether it can go in a table at all.
+    fn storable(self) -> bool {
+        true
+    }
+
+    fn load(a: &Self::Atomic, o: Ordering) -> Option<Self>;
+    fn store(a: &Self::Atomic, v: Option<Self>, o: Ordering);
+}
+
+// SAFETY: an AtomicU64, holding the key complemented: zero is empty
+unsafe impl CuckooItem for u64 {
+    type Atomic = AtomicU64;
+    type Target = u64;
+
+    unsafe fn target(&self) -> &u64 {
+        self
+    }
+
+    fn storable(self) -> bool {
+        self != u64::MAX
+    }
+
+    fn load(a: &AtomicU64, o: Ordering) -> Option<u64> {
+        Some(a.load(o)).filter(|&k| k != 0).map(|k| !k)
+    }
+
+    fn store(a: &AtomicU64, v: Option<u64>, o: Ordering) {
+        a.store(v.map_or(0, |k| !k), o)
+    }
+}
+
+/// A pointer to an entry, as a map holds it.
+///
+/// XXX: not cuckoo's. A pointer to what's freed only after a grace period
+/// is an RCU type - the kernel's RcuBox/ForeignOwnableRcu, ours to have -
+/// and new()'s contract is what that type would make its own.
+pub struct Entry<E>(NonNull<E>);
+
+impl<E> Clone for Entry<E> {
+    fn clone(&self) -> Self {
+        *self
+    }
+}
+
+impl<E> Copy for Entry<E> {}
+
+// SAFETY: a pointer to a Sync entry, which any thread may look at
+unsafe impl<E: Sync> Send for Entry<E> {}
+unsafe impl<E: Sync> Sync for Entry<E> {}
+
+impl<E> Entry<E> {
+    /// # Safety
+    /// @e stays valid, its key - what its Hash and Eq see - unchanged, for as
+    /// long as it's in a table and a grace period after: removed, it's freed
+    /// only after synchronize_rcu(), or by kfree_rcu() - or at once, from a
+    /// table no other thread reads.
+    pub unsafe fn new(e: NonNull<E>) -> Self {
+        Self(e)
+    }
+
+    pub fn as_ptr(self) -> NonNull<E> {
+        self.0
+    }
+}
+
+// SAFETY: an AtomicPtr, null for empty
+unsafe impl<E: Hash + Eq + Sync> CuckooItem for Entry<E> {
+    type Atomic = AtomicPtr<E>;
+    type Target = E;
+
+    unsafe fn target(&self) -> &E {
+        // SAFETY: the caller's, and new()'s
+        unsafe { self.0.as_ref() }
+    }
+
+    fn load(a: &AtomicPtr<E>, o: Ordering) -> Option<Self> {
+        NonNull::new(a.load(o)).map(Self)
+    }
+
+    fn store(a: &AtomicPtr<E>, v: Option<Self>, o: Ordering) {
+        a.store(v.map_or(core::ptr::null_mut(), |e| e.0.as_ptr()), o)
+    }
+}
+
+#[repr(transparent)]
+struct Slot<I: CuckooItem>(I::Atomic);
+
+// SAFETY: CuckooItem's: owning nothing, and all zeroes empty
+unsafe impl<I: CuckooItem> RcuElement for Slot<I> {}
+
+impl<I: CuckooItem> Slot<I> {
+    /// A reader's view.
+    fn load(&self) -> Option<I> {
+        I::load(&self.0, Acquire)
+    }
+
+    /// The writer's view.
+    fn load_locked(&self) -> Option<I> {
+        I::load(&self.0, Relaxed)
+    }
+
+    fn set(&self, i: I) {
+        I::store(&self.0, Some(i), Release)
+    }
+
+    fn clear(&self) {
+        I::store(&self.0, None, Release)
+    }
+}
+
+/// The published buffer's seeds and bits - or another buffer's, if a rehash
+/// raced, naming the wrong slots or ones past the end.
+struct Mirror {
+    seeds: [AtomicU64; 3],
+    bits:  AtomicU32,
+}
+
+impl Mirror {
+    fn load(&self) -> (Seeds, u32) {
+        (self.seeds.each_ref().map(|s| s.load(Relaxed)), self.bits.load(Relaxed))
+    }
+
+    fn store(&self, seeds: &Seeds, bits: u32) {
+        self.seeds.iter().zip(seeds).for_each(|(m, &s)| m.store(s, Relaxed));
+        self.bits.store(bits, Relaxed);
+    }
+}
+
+/// Whether 2^@bits slots of @W ways take @nr items: see the top of the file.
+fn fits<const W: usize>(bits: u32, nr: usize, faults: &Faults) -> bool {
+    let slots = 1usize << bits;
+    if faults.dense() {
+        nr <= slots
+    } else if W == 2 {
+        nr * 20 <= slots * 9
+    } else {
+        nr * 4 <= slots * 3
+    }
+}
+
+/// A buffer's seeds and slots, as a reader has them in its read-side section,
+/// or the writer: so its items are live.
+struct Table<'a, I: CuckooItem, S, const W: usize> {
+    seeds:  Seeds,
+    slots:  &'a [Slot<I>],
+    faults: &'a Faults,
+    hash:   PhantomData<fn() -> S>,
+}
+
+impl<'a, I: CuckooItem, S: BuildHasher + From<[u64; 2]>, const W: usize> Table<'a, I, S, W> {
+    fn new(seeds: Seeds, slots: &'a [Slot<I>], faults: &'a Faults) -> Self {
+        Self { seeds, slots, faults, hash: PhantomData }
+    }
+
+    fn bits(&self) -> u32 {
+        self.slots.len().trailing_zeros()
+    }
+
+    fn index<K: ?Sized + Hash>(&self, key: &K) -> [usize; W] {
+        slots::<W, S, K>(self.seeds, self.bits(), key)
+    }
+
+    fn key<'i>(&self, i: &'i I) -> &'i I::Target {
+        // SAFETY: a Table's items are live: see the struct
+        unsafe { i.target() }
+    }
+
+    /// @key's item, if slot @i - which may be past this buffer - holds it.
+    fn get<Q: ?Sized + Eq>(&self, i: usize, key: &Q) -> Option<I>
+    where I::Target: Borrow<Q>
+    {
+        self.slots.get(i)?.load().filter(|it| self.key(it).borrow() == key)
+    }
+
+    /// @key's item, from the slots this buffer's seeds name: for a lookup
+    /// whose Mirror was another buffer's.
+    #[cold]
+    fn get_raced<Q: ?Sized + Hash + Eq>(&self, key: &Q) -> Option<I>
+    where I::Target: Borrow<Q>
+    {
+        saw!(self.faults, raced);
+        self.index(key).into_iter().find_map(|i| self.get(i, key))
+    }
+
+    /// Writer: the slot holding @key.
+    fn find_locked<Q: ?Sized + Hash + Eq>(&self, key: &Q) -> Option<&'a Slot<I>>
+    where I::Target: Borrow<Q>
+    {
+        self.index(key).into_iter()
+            .map(|i| &self.slots[i])
+            .find(|s| s.load_locked().is_some_and(|i| self.key(&i).borrow() == key))
+    }
+
+    /// Writer: what the table holds.
+    fn iter_locked(&self) -> impl Iterator<Item = I> + use<'a, I, S, W> {
+        self.slots.iter().filter_map(Slot::load_locked)
+    }
+
+    /// Where @key, which isn't in the table, can go, into @path: one of its
+    /// slots, empty, or a chain from one - walk(). False if there's none.
+    fn find_path(&self, key: &I::Target, path: &mut Path) -> bool {
+        let own = self.index(key);
+        if let Some(&i) = own.iter().find(|&&i| self.slots[i].load_locked().is_none()) {
+            path.push(i as u32);
+            return true;
+        }
+        own.into_iter().any(|start| {
+            path.clear();
+            self.walk(start, path)
+        })
+    }
+
+    /// A chain of slots from @start to an empty one, into @path: each the one
+    /// before's occupant's other slot - an empty one if it has one, else the
+    /// last not on the chain - and none twice, so moving them from the empty
+    /// end empties each in turn for the one before. False if it comes to
+    /// nothing within MAX_KICKS moves.
+    fn walk(&self, start: usize, path: &mut Path) -> bool {
+        let mut s = start;
+
+        loop {
+            if path.try_push(s as u32).is_err() {
+                return false;
+            }
+            let Some(item) = self.slots[s].load_locked() else { return true };
+
+            let others = self.index(self.key(&item)).into_iter().filter(|&o| !path.contains(&(o as u32)));
+            let empty = others.clone().find(|&o| self.slots[o].load_locked().is_none());
+            let Some(n) = empty.or_else(|| others.last()) else { return false };
+            s = n;
+        }
+    }
+
+    /// Insert @item, whose key isn't in the table, along find_path()'s chain,
+    /// counting each move in @moves: false, and nothing moved, if there's no
+    /// chain.
+    fn insert(&self, item: I, moves: &AtomicU64) -> bool {
+        let mut path = Path::new();
+        if !self.find_path(self.key(&item), &mut path) {
+            return false;
+        }
+
+        for w in path.windows(2).rev() {
+            let (from, to) = (&self.slots[w[0] as usize], &self.slots[w[1] as usize]);
+            to.set(from.load_locked().expect("on the path: occupied"));
+            self.faults.move_window();
+            moves.fetch_add(1, Release);
+            self.faults.move_window();
+            from.clear();
+        }
+        self.slots[path[0] as usize].set(item);
+        true
+    }
+}
+
+/// See the top of the file: of @I - u64s, or Entry<E> - hashed by @S, in @W
+/// ways, two or three. Zeroed, it's empty, with no buffer: the first insert
+/// allocates one.
+///
+/// repr(C): what a hit reads, which only a rehash writes - and the faults, in
+/// a test - apart from what writers write on every insert.
+#[repr(C)]
+pub struct Cuckoo<I: CuckooItem = u64, S = SipHash13Key, const W: usize = 2> {
+    mirror:  Mirror,
+    table:   RcuArray<Slot<I>, Seeds>,
+    faults:  Faults,
+    _writer: CacheAligned,
+    /// The writers'
+    lock:    Lock<ByteLock>,
+    /// Items moved by inserts, ever: read only by a lookup that misses.
+    moves:   AtomicU64,
+    /// Items, for when to grow.
+    nr:      AtomicUsize,
+    hash:    PhantomData<fn() -> S>,
+}
+
+/// The writers' lock, held.
+type Held<'a> = Guard<'a, ByteLock>;
+
+// SAFETY: atomics, an RcuArray, no bytes, an unlocked ByteLock, Faults'
+// integers and atomics, and a PhantomData: all valid zeroed
+unsafe impl<I: CuckooItem, S: BuildHasher + From<[u64; 2]>, const W: usize> ::pin_init::Zeroable for Cuckoo<I, S, W> {}
+
+impl<I: CuckooItem, S: BuildHasher + From<[u64; 2]>, const W: usize> Default for Cuckoo<I, S, W> {
+    fn default() -> Self {
+        ::pin_init::Zeroable::zeroed()
+    }
+}
+
+impl<I: CuckooItem, S: BuildHasher + From<[u64; 2]>, const W: usize> Cuckoo<I, S, W> {
+    const WAYS: () = assert!(W == 2 || W == 3, "cuckoo: two ways or three");
+
+    /// @key's item, in a read-side section of its own.
+    pub fn get<Q: ?Sized + Hash + Eq>(&self, key: &Q) -> Option<I>
+    where I::Target: Borrow<Q>
+    {
+        self.get_rcu(key, &read_lock())
+    }
+
+    pub fn contains<Q: ?Sized + Hash + Eq>(&self, key: &Q) -> bool
+    where I::Target: Borrow<Q>
+    {
+        self.get(key).is_some()
+    }
+
+    /// @key's item, under @g's section.
+    pub fn get_rcu<Q: ?Sized + Hash + Eq>(&self, key: &Q, g: &ReadGuard) -> Option<I>
+    where I::Target: Borrow<Q>
+    {
+        let mirror = self.mirror.load();
+        let () = Self::WAYS;
+        let slots = slots::<W, S, Q>(mirror.0, mirror.1, key);
+
+        if let Some(i) = self.probe(key, g, mirror, slots) {
+            return Some(i);
+        }
+        loop {
+            let moves = self.moves.load(Acquire);
+            if let Some(i) = self.probe(key, g, mirror, slots) {
+                return Some(i);
+            }
+            fence(Acquire);
+            if self.moves.load(Relaxed) == moves {
+                return None;
+            }
+            saw!(self.faults, retry);
+        }
+    }
+
+    /// @key's item, from @slots - its, under @mirror, which may be another
+    /// buffer's - or from the buffer's own if the mirror was stale.
+    fn probe<Q: ?Sized + Hash + Eq>(&self, key: &Q, g: &ReadGuard, mirror: (Seeds, u32), slots: [usize; W])
+        -> Option<I>
+    where I::Target: Borrow<Q>
+    {
+        let (seeds, buf) = self.table.read_head(g)?;
+        let t = Table::<I, S, W>::new(*seeds, buf, &self.faults);
+
+        let hit = slots.into_iter().find_map(|i| {
+            self.faults.read_window();
+            t.get(i, key)
+        });
+        hit.or_else(|| (mirror != (*seeds, t.bits())).then(|| t.get_raced(key)).flatten())
+    }
+
+    /// An empty table, with @faults injected.
+    #[cfg(CONFIG_BCACHEFS_TESTS)]
+    pub fn with_faults(faults: Faults) -> Self {
+        Self { faults, ..Self::default() }
+    }
+
+    #[cfg(CONFIG_BCACHEFS_TESTS)]
+    pub fn faults(&self) -> &Faults {
+        &self.faults
+    }
+
+    #[cfg(CONFIG_BCACHEFS_TESTS)]
+    pub fn moved(&self) -> u64 {
+        self.moves.load(Relaxed)
+    }
+}
+
+impl<E: Hash + Eq + Sync, S: BuildHasher + From<[u64; 2]>, const W: usize> Cuckoo<Entry<E>, S, W> {
+    /// @key's entry, for as long as @g's read-side section.
+    pub fn get_entry<'g, Q: ?Sized + Hash + Eq>(&self, key: &Q, g: &'g ReadGuard) -> Option<&'g E>
+    where E: Borrow<Q>
+    {
+        // SAFETY: in the table during @g's section, so valid until it ends
+        // (Entry::new())
+        self.get_rcu(key, g).map(|e| unsafe { e.0.as_ref() })
+    }
+}
+
+// ── Writers ──────────────────────────────────────────────────────────────
+
+impl<I: CuckooItem, S: BuildHasher + From<[u64; 2]>, const W: usize> Cuckoo<I, S, W> {
+    /// The buffer, as the holder of the writers' lock, @g, has it: not to be
+    /// kept past a rehash() or clear() - see the top of the file.
+    fn locked<'a>(&'a self, g: &Held<'_>) -> Option<Table<'a, I, S, W>> {
+        debug_assert!(core::ptr::eq(g.lock(), &self.lock));
+        // SAFETY: we hold the writers' lock, and no replace() comes while the
+        // view is in use
+        unsafe { self.table.get_head_locked() }
+            .map(|(seeds, slots)| Table::new(*seeds, slots, &self.faults))
+    }
+
+    /// @item, in place of what had its key, if anything: that. Fails, with
+    /// the table unchanged, only if it can't allocate.
+    pub fn insert(&self, item: I) -> Result<Option<I>, AllocError> {
+        self.put(&self.lock.lock(), item, true)
+    }
+
+    /// @item, if nothing has its key: else what does, as the error, and @item
+    /// isn't in. Fails, with the table unchanged, only if it can't allocate.
+    pub fn insert_new(&self, item: I) -> Result<Result<(), I>, AllocError> {
+        Ok(self.put(&self.lock.lock(), item, false)?.map_or(Ok(()), Err))
+    }
+
+    /// insert(), or if not @replace insert_new(): what had @item's key.
+    fn put(&self, g: &Held<'_>, item: I, replace: bool) -> Result<Option<I>, AllocError> {
+        let () = Self::WAYS;
+        assert!(item.storable(), "cuckoo: an item that can't be in a table");
+
+        let t = self.locked(g);
+        if let Some(s) = t.as_ref().and_then(|t| t.find_locked(t.key(&item))) {
+            let old = s.load_locked().expect("found: occupied");
+            if replace {
+                s.set(item);
+            }
+            return Ok(Some(old));
+        }
+
+        let nr = self.nr.load(Relaxed) + 1;
+        let room = t.filter(|t| fits::<W>(t.bits(), nr, &self.faults));
+        if !room.is_some_and(|t| t.insert(item, &self.moves)) {
+            return self.rehash(g, item).map(|()| None);
+        }
+        self.nr.store(nr, Relaxed);
+        Ok(None)
+    }
+
+    /// Take @key out: its item, if it was in.
+    pub fn remove<Q: ?Sized + Hash + Eq>(&self, key: &Q) -> Option<I>
+    where I::Target: Borrow<Q>
+    {
+        let g = self.lock.lock();
+        let s = self.locked(&g)?.find_locked(key)?;
+        let old = s.load_locked();
+        s.clear();
+        self.nr.fetch_sub(1, Relaxed);
+        old
+    }
+
+    /// Empty it, freeing its buffer after a grace period.
+    pub fn clear(&self) {
+        let _g = self.lock.lock();
+        // SAFETY: we hold the writers' lock
+        unsafe { self.table.clear() }
+        self.nr.store(0, Relaxed);
+    }
+
+    /// The table's invariant, checked - every item in one of its slots, and in
+    /// only one, and as many as it counts: how many, or what's broken. For
+    /// tests, and debugging: it walks every slot.
+    pub fn check(&self) -> Result<usize, &'static str> {
+        let g = self.lock.lock();
+        let Some(t) = self.locked(&g) else { return Ok(0) };
+        let mut nr = 0;
+
+        for s in t.slots {
+            let Some(i) = s.load_locked() else { continue };
+            match t.find_locked(t.key(&i)) {
+                None => return Err("cuckoo: an item in a slot it doesn't hash to"),
+                Some(f) if !core::ptr::eq(f, s) => return Err("cuckoo: an item in two slots"),
+                Some(_) => nr += 1,
+            }
+        }
+        if nr != self.nr.load(Relaxed) {
+            return Err("cuckoo: an item count that isn't the items");
+        }
+        Ok(nr)
+    }
+
+    /// A new buffer with every item, and @item: see the top of the file. On
+    /// an error the table is unchanged.
+    fn rehash(&self, g: &Held<'_>, item: I) -> Result<(), AllocError> {
+        let old = self.locked(g);
+        let nr = self.nr.load(Relaxed) + 1;
+
+        let faults = &self.faults;
+        let mut bits = old.as_ref().map_or(MIN_BITS, Table::bits);
+        while !fits::<W>(bits, nr, faults) {
+            bits += 1;
+        }
+
+        // The new buffer's moves are before anyone can see it: not counted,
+        // and no windows
+        let (moves, unpublished) = (AtomicU64::new(0), Faults::default());
+
+        loop {
+            if faults.alloc_fail() {
+                return Err(AllocError);
+            }
+            for _ in 0..3 {
+                let seeds: Seeds = core::array::from_fn(|_| random_u64());
+                // SAFETY: we hold the writers' lock; @old's slots don't
+                // change under us, and nothing reads them past the replace()
+                let fit = unsafe {
+                    self.table.rebuild_head(1 << bits, seeds, |slots| {
+                        let t = Table::<I, S, W>::new(seeds, slots, &unpublished);
+                        old.iter().flat_map(Table::iter_locked).chain([item])
+                            .all(|i| t.insert(i, &moves))
+                            .then_some(()).ok_or(())
+                    })
+                }?;
+                if fit.is_ok() {
+                    saw!(faults, rehash);
+                    self.mirror.store(&seeds, bits);
+                    self.nr.store(nr, Relaxed);
+                    return Ok(());
+                }
+            }
+            saw!(faults, grown);
+            bits += 1;
+        }
+    }
+}
+
+// ── An entry's own registration ──────────────────────────────────────────
+
+/// An entry's place in a map, and its key, held by the entry: dropping it
+/// takes the entry out. A reference each way, owning neither - the table
+/// points to the entry, the entry to the table - so the entry is pinned while
+/// it's in, and leaves as it's dropped. Made by new(), the entry's Hash, Eq
+/// and Borrow<K> are key()'s, which nothing can change; an entry that holds
+/// its key itself is registered by register(), and this held beside it.
+///
+/// The table is a BackRef: it outlives its entries.
+pub struct Registration<K, E, S = SipHash13Key, const W: usize = 2>
+where K: Hash + Eq, E: Hash + Eq + Sync + Borrow<K>, S: BuildHasher + From<[u64; 2]>
+{
+    table: BackRef<Cuckoo<Entry<E>, S, W>>,
+    entry: NonNull<E>,
+    key:   K,
+}
+
+// SAFETY: shared or sent, it gives out only the key, and its drop takes the
+// table's lock; @entry is compared, never followed
+unsafe impl<K, E, S, const W: usize> Send for Registration<K, E, S, W>
+where K: Hash + Eq + Send, E: Hash + Eq + Sync + Borrow<K>, S: BuildHasher + From<[u64; 2]>
+{}
+unsafe impl<K, E, S, const W: usize> Sync for Registration<K, E, S, W>
+where K: Hash + Eq + Sync, E: Hash + Eq + Sync + Borrow<K>, S: BuildHasher + From<[u64; 2]>
+{}
+
+/// Why a Registration wasn't made: its key's in the table already - another
+/// entry's, which stays - or the table couldn't grow.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RegisterError {
+    Exists,
+    Alloc,
+}
+
+impl From<AllocError> for RegisterError {
+    fn from(_: AllocError) -> Self {
+        RegisterError::Alloc
+    }
+}
+
+impl<K, E, S, const W: usize> Registration<K, E, S, W>
+where K: Hash + Eq, E: Hash + Eq + Sync + Borrow<K>, S: BuildHasher + From<[u64; 2]>
+{
+    /// Registers @e in @table under @key until this is dropped. It's made in
+    /// place as a field of @e, so the insert hashes @e through it. Fails,
+    /// leaving the table unchanged, if @key is in it already or it can't grow.
+    ///
+    /// # Safety
+    /// Entry::new()'s, but for the key, which is this one's; @table outlives
+    /// this; and @e is the entry this is a field of, being pin-initialized -
+    /// pin-init's &this - with this its first field, so dropped first, and
+    /// initialized last.
+    pub unsafe fn new<'w>(table: &'w Cuckoo<Entry<E>, S, W>, key: K, e: NonNull<E>)
+        -> impl ::pin_init::PinInit<Self, RegisterError> + use<'w, K, E, S, W>
+    {
+        let init = move |slot: *mut Self| {
+            // SAFETY: @slot is ours to write, pin-init's; @table outlives
+            // this, the caller's
+            unsafe { slot.write(Self { table: BackRef::new(table), entry: e, key }) };
+            // SAFETY: the caller's
+            let err = match table.insert_new(unsafe { Entry::new(e) }) {
+                Ok(Ok(())) => return Ok(()),
+                Ok(Err(_)) => RegisterError::Exists,
+                Err(_)     => RegisterError::Alloc,
+            };
+            // SAFETY: just written; its drop finds nothing of ours to take
+            // out - an entry that's in already isn't @e
+            unsafe { core::ptr::drop_in_place(slot) };
+            Err(err)
+        };
+        // SAFETY: @slot is initialized on Ok, and not on Err; nothing moves it
+        unsafe { ::pin_init::pin_init_from_closure(init) }
+    }
+
+    /// Registers @e in @table under @key until this is dropped, for an entry
+    /// that holds its key itself, rather than through this: it's inserted
+    /// first, and this is held beside it - an Option, say. The entry doesn't
+    /// move while it's in; this can. Fails as new() does.
+    ///
+    /// # Safety
+    /// Entry::new()'s, for @e, whose key is @key while it's in; and @table
+    /// outlives this.
+    pub unsafe fn register(table: &Cuckoo<Entry<E>, S, W>, key: K, e: NonNull<E>) -> Result<Self, RegisterError> {
+        // SAFETY: the caller's
+        match table.insert_new(unsafe { Entry::new(e) }) {
+            // SAFETY: the caller's
+            Ok(Ok(())) => Ok(Self { table: unsafe { BackRef::new(table) }, entry: e, key }),
+            Ok(Err(_)) => Err(RegisterError::Exists),
+            Err(_)     => Err(RegisterError::Alloc),
+        }
+    }
+
+    pub fn key(&self) -> &K {
+        &self.key
+    }
+}
+
+impl<K, E, S, const W: usize> Drop for Registration<K, E, S, W>
+where K: Hash + Eq, E: Hash + Eq + Sync + Borrow<K>, S: BuildHasher + From<[u64; 2]>
+{
+    /// Out, if the slot is still this entry's: an insert() of its key may
+    /// have put another in its place.
+    fn drop(&mut self) {
+        let table = &*self.table;
+        let g = table.lock.lock();
+        let Some(s) = table.locked(&g).and_then(|t| t.find_locked(&self.key)) else { return };
+        if s.load_locked().is_some_and(|i| i.0 == self.entry) {
+            s.clear();
+            table.nr.fetch_sub(1, Relaxed);
+        }
+    }
+}
+
+// ── Faults, for the torture test ─────────────────────────────────────────
+
+/// What the torture test injects into one table.
+#[cfg(CONFIG_BCACHEFS_TESTS)]
+#[derive(Default)]
+pub struct Faults {
+    /// Spins inside each move, between its copy, its count and its emptying
+    /// - and a yield, the writer off CPU mid-chain, holding the writers' lock.
+    pub move_window: u32,
+    /// Spins in a lookup before each slot it reads.
+    pub read_window: u32,
+    /// One in this many buffer allocations fails (0: none).
+    pub alloc_fail:  u32,
+    /// The table grows only when it's full: inserts walk long chains, and
+    /// rehash to find room.
+    pub dense:       bool,
+    pub seen:        Seen,
+}
+
+/// How often each rare path ran: that a test reached them.
+#[cfg(CONFIG_BCACHEFS_TESTS)]
+#[derive(Default)]
+pub struct Seen {
+    /// Lookups that missed and retried: a move was counted during them.
+    pub retry:  AtomicU64,
+    /// Lookups that missed and looked again with the buffer's own seeds.
+    pub raced:  AtomicU64,
+    pub rehash: AtomicU64,
+    /// Rehashes whose seeds didn't fit at a size, trying a bigger table.
+    pub grown:  AtomicU64,
+}
+
+#[cfg(CONFIG_BCACHEFS_TESTS)]
+fn spins(n: u32) {
+    (0..n).for_each(|_| core::hint::spin_loop());
+}
+
+#[cfg(CONFIG_BCACHEFS_TESTS)]
+impl Faults {
+    fn move_window(&self) {
+        if self.move_window != 0 {
+            spins(self.move_window);
+            crate::util::kernel::cond_resched();
+        }
+    }
+
+    fn read_window(&self) { spins(self.read_window) }
+
+    fn alloc_fail(&self) -> bool {
+        self.alloc_fail != 0 && crate::util::kernel::random_u64_below(self.alloc_fail.into()) == 0
+    }
+
+    fn dense(&self) -> bool { self.dense }
+}
+
+#[cfg(not(CONFIG_BCACHEFS_TESTS))]
+#[derive(Default)]
+pub struct Faults;
+
+#[cfg(not(CONFIG_BCACHEFS_TESTS))]
+impl Faults {
+    fn move_window(&self) {}
+    fn read_window(&self) {}
+    fn alloc_fail(&self) -> bool { false }
+    fn dense(&self) -> bool { false }
+}
