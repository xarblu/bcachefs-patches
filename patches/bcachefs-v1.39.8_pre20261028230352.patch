+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_INODE_H
+#define _BCACHEFS_INODE_H
+
+#include "btree/bkey.h"
+#include "btree/bkey_methods.h"
+#include "snapshots/snapshot.h"
+
