diff --git a/fs/bcachefs/alloc/check.rs b/fs/bcachefs/alloc/check.rs
new file mode 100644
index 0000000..a50a06f
--- /dev/null
+++ b/fs/bcachefs/alloc/check.rs
@@ -0,0 +1,841 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Alloc btree fsck - check.c's, as it converts: check_alloc_info, which
+//! checks the btrees derived from the alloc btree against it - need_discard,
+//! freespace and bucket_gens - and check_alloc_to_lru_refs, the lrus; and
+//! freespace initialization.
+//!
+//! The alloc btree is authoritative for its buckets, the others indexes of
+//! it: repairs go both ways, entries an alloc key says should be there and
+//! aren't, and entries no alloc key accounts for. Keys for buckets that don't
+//! exist, in any of them, are deleted - which is why the alloc walk visits
+//! keys past a device's last bucket, and for devices that don't exist.
+//!
+//! An alloc key's check ends at a need_discard or freespace error that isn't
+//! fixed - declined, or fsck -n: need_discard_or_freespace_err()'s
+//! Ok(false).
+//!
+//! The freespace key check is the allocator's too, before it takes a bucket:
+//! check_freespace_key(), whose caller - FreespaceCheck - says how a bad
+//! entry's repaired. The allocator can't commit there, so it spawns a
+//! recheck that does.
+//!
+//! The injection tests for every error here: ktest's alloc-inject.ktest and
+//! lru-inject.ktest.
+
+use crate::alloc::background::{alloc_to_v4, bucket_do_freespace_index, BucketGensPos, FreespacePos, NeedDiscardPos};
+use crate::alloc::buckets::bucket_to_u64;
+use crate::alloc::lru::{lru_check_set, lru_mod, per_dev_fragmentation_lru, LruId, LruPos};
+use crate::accounting::{data_type, data_type_from_u8};
+use crate::btree::bkey::prelude::*;
+use crate::btree::bkey::{bkey_eq, bkey_lt, bkey_min, bpos_lt, pos, BkeySC, POS_MAX, POS_MIN, SPOS_MAX};
+use crate::btree::iter::{is_restart, lockrestart_do, polonius_key, BtreeIter, BtreeIterFlags, BtreeTrans,
+                         CommitFlags, TransAttempt, UpdateTriggerFlags};
+use crate::btree::write_buffer::WbMaybeFlush;
+use crate::c;
+use crate::errcode::{ret_to_c, BchError};
+use crate::fs::Fs;
+use crate::init::error::id;
+use crate::init::passes;
+use crate::init::progress::Progress;
+use crate::sb::members::DevRef;
+use crate::util::ffi::Opaque;
+use crate::util::kernel::{local_clock, READ};
+use crate::{bch_err, bch_info, bch_verbose, fsck_err, fsck_err_flags, fsck_err_on};
+use crate::c::bch_errcode;
+use crate::c::bch_fsck_flags as F;
+use core::ffi::c_int;
+use cstruct_macros::c_export;
+
+const KEY_TYPE_SET: u8 = c::bch_bkey_type::KEY_TYPE_set.0 as u8;
+
+// ── Walking the alloc btree, holes and all ───────────────────────────────
+
+/// A key in the alloc btree, or a hole: positions @start to @end with no key.
+enum KeyOrHole<'k> {
+    Key(BkeySC<'k>),
+    Hole { start: c::bpos, end: c::bpos },
+}
+
+/// The key at @iter, or the hole there - as far as @end, the end of @iter's
+/// leaf node, and U32_MAX positions on, whichever comes first: as
+/// BTREE_ITER_slots does for an extents btree, on a btree that isn't one.
+/// bch2_get_key_or_hole().
+fn get_key_or_hole<'k, 't>(t: &'k TransAttempt<'_, 't>, iter: &'k mut BtreeIter<'t>, mut end: c::bpos)
+    -> Result<KeyOrHole<'k>, BchError>
+{
+    let (iter, k) = iter.peek_slot_shared(t)?;
+    if k.k.type_ != c::bch_bkey_type::KEY_TYPE_deleted.0 as u8 {
+        return Ok(KeyOrHole::Key(k));
+    }
+
+    let start = iter.pos();
+
+    // SAFETY: nothing unlocks while we look
+    if let Some(leaf) = unsafe { iter.leaf(t) } {
+        let leaf_end = leaf.node().key.k.p;
+        if leaf_end != SPOS_MAX {
+            end = bkey_min(end, leaf_end.nosnap_successor());
+        }
+    }
+    end = bkey_min(end, pos(start.inode, start.offset.wrapping_add(u64::from(u32::MAX) - 1)));
+
+    // btree node min/max is a closed interval, peek_max() takes a half open
+    // one:
+    let mut iter2 = iter.copy();
+    iter2.peek_max(t, end)?;
+    let next = iter2.pos();
+    assert!(next.offset < start.offset.wrapping_add(u64::from(u32::MAX)),
+            "hole from {start} to {next}: past U32_MAX positions");
+
+    Ok(KeyOrHole::Hole { start, end: next })
+}
+
+/// @bucket, moved up to @ca's first bucket - or, past its last, to the next
+/// device's first, @ca following: false if there's no next device.
+/// next_bucket().
+fn next_bucket(fs: &Fs, ca: &mut Option<DevRef>, bucket: &mut c::bpos) -> bool {
+    if let Some(dev) = ca.as_ref() {
+        bucket.offset = bucket.offset.max(dev.mi.get().first_bucket.into());
+        if bucket.offset < dev.mi.get().nbuckets {
+            return true;
+        }
+
+        *ca = None;
+        bucket.inode += 1;
+        bucket.offset = 0;
+    }
+
+    *ca = fs.next_dev(bucket.inode as u32);
+    if let Some(dev) = ca.as_ref() {
+        *bucket = pos(dev.dev_idx.into(), dev.mi.get().first_bucket.into());
+    }
+    ca.is_some()
+}
+
+/// get_key_or_hole() over the alloc btree, for the buckets there are: a hole
+/// outside every device's buckets skipped - to the next device's first
+/// bucket, unless a key comes first, a key for a bucket that doesn't exist -
+/// and one that runs past its device's last bucket cut there. None at the
+/// end; @iter back shared, for updates at the key. @ca: the device of a hole
+/// returned. bch2_get_key_or_real_bucket_hole().
+fn get_key_or_real_bucket_hole<'k, 't>(
+    t:    &'k TransAttempt<'_, 't>,
+    iter: &'k mut BtreeIter<'t>,
+    ca:   &mut Option<DevRef>,
+) -> Result<Option<(&'k BtreeIter<'t>, KeyOrHole<'k>)>, BchError> {
+    let fs = t.fs();
+
+    loop {
+        let (start, end) = match get_key_or_hole(t, iter, POS_MAX)? {
+            KeyOrHole::Key(k) => {
+                fs.dev_iterate(ca, k.k.p.inode as u32);
+                // XXX polonius: returned here, @iter used below
+                let k = unsafe { polonius_key(k) };
+                return Ok(Some((&*iter, KeyOrHole::Key(k))));
+            }
+            KeyOrHole::Hole { start, end } => (start, end),
+        };
+
+        fs.dev_iterate(ca, end.inode as u32);
+
+        if !ca.as_ref().is_some_and(|ca| ca.bucket_valid(start.offset)) {
+            let mut next = start;
+            let next_dev = next_bucket(fs, ca, &mut next);
+
+            if let Some(k) = iter.peek(t)? {
+                if !next_dev || bpos_lt(k.k.p, next) {
+                    // XXX polonius: returned here, @iter used below
+                    let k = unsafe { polonius_key(k) };
+                    return Ok(Some((&*iter, KeyOrHole::Key(k))));
+                }
+            }
+
+            if !next_dev {
+                return Ok(None);
+            }
+
+            iter.set_pos(next);
+            continue;
+        }
+
+        let nbuckets = ca.as_ref().expect("checked above").mi.get().nbuckets;
+        let end = if end.offset > nbuckets { pos(end.inode, nbuckets) } else { end };
+
+        return Ok(Some((&*iter, KeyOrHole::Hole { start, end })));
+    }
+}
+
+// ── Alloc keys ───────────────────────────────────────────────────────────
+
+/// A bucket in alloc key @alloc_k incorrectly @set, or not, in need_discard
+/// (@discard) or freespace: reported, and, if @repair, offered to fix.
+/// Ok(false) - ignored, or not fixed - ends the check of @alloc_k.
+pub(crate) fn need_discard_or_freespace_err(
+    t:       &TransAttempt<'_, '_>,
+    alloc_k: BkeySC<'_>,
+    set:     bool,
+    discard: bool,
+    repair:  bool,
+) -> Result<bool, BchError> {
+    let flags = F::FSCK_CAN_IGNORE | if repair { F::FSCK_CAN_FIX } else { F::empty() };
+    let (err, btree) = if discard {
+        (id::need_discard_key_wrong, c::btree_id::need_discard)
+    } else {
+        (id::freespace_key_wrong, c::btree_id::freespace)
+    };
+
+    match fsck_err_flags!(t, POS_MIN, flags, err, "bucket incorrectly {}set in {} btree\n{}",
+                          if set { "" } else { "un" }, btree, alloc_k.to_text(t.fs())) {
+        Err(e) if e.matches(bch_errcode::BCH_ERR_fsck_errors_not_fixed) => Ok(false),
+        r => r,
+    }
+}
+
+/// Alloc key @alloc_k, at @alloc_iter, against need_discard, freespace,
+/// bucket_gens and the stripes btree: bch2_check_alloc_key().
+fn check_alloc_key<'t>(
+    t:            &TransAttempt<'_, 't>,
+    alloc_k:      BkeySC<'_>,
+    alloc_iter:   &BtreeIter<'t>,
+    iters:        &mut DerivedIters<'t>,
+    last_flushed: &mut WbMaybeFlush,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+    let bucket = alloc_k.k.p;
+
+    let ca = fs.dev_bucket_tryget_noerror(bucket);
+    if fsck_err_on!(t, ca.is_none(), id::alloc_key_to_missing_dev_bucket,
+                    "alloc key for invalid device:bucket {}:{}", { bucket.inode }, { bucket.offset })? {
+        t.delete_at(alloc_iter, UpdateTriggerFlags::empty())?;
+    }
+    let Some(ca) = ca else { return Ok(()) };
+
+    if ca.mi.get().freespace_initialized == 0 {
+        return Ok(());
+    }
+
+    let mut a = t.alloc_to_v4_mut(alloc_k)?;
+
+    if data_type_from_u8(a.v().data_type) == data_type::need_discard {
+        iters.discard.set_pos(NeedDiscardPos::new(bucket, a.v()).to_bpos());
+        let (discard_iter, k) = iters.discard.peek_slot_shared(t)?;
+        let missing = k.k.type_ != KEY_TYPE_SET;
+
+        if missing {
+            last_flushed.maybe_flush(t, alloc_k)?;
+
+            if !need_discard_or_freespace_err(t, alloc_k, false, true, true)? {
+                return Ok(());
+            }
+            t.bit_mod_buffered(c::btree_id::need_discard, discard_iter.pos(), true)?;
+        }
+    }
+
+    iters.freespace.set_pos(FreespacePos::new(bucket, a.v()).to_bpos());
+    let (freespace_iter, k) = iters.freespace.peek_slot_shared(t)?;
+
+    let is_free = data_type_from_u8(a.v().data_type) == data_type::free;
+    if (k.k.type_ != 0) != is_free {
+        if !need_discard_or_freespace_err(t, alloc_k, !is_free, false, true)? {
+            return Ok(());
+        }
+        t.bit_mod_iter(freespace_iter, is_free)?;
+    }
+
+    let gens_pos = BucketGensPos::new(bucket);
+    iters.bucket_gens.set_pos(gens_pos.key);
+    let (bucket_gens_iter, k) = iters.bucket_gens.peek_slot_shared(t)?;
+
+    let bucket_gen = gens_pos.bucket_gen(k);
+    if fsck_err_on!(t, a.v().generation != bucket_gen, id::bucket_gens_key_wrong,
+                    "incorrect gen in bucket_gens btree (got {} should be {})\n{}",
+                    bucket_gen, a.v().generation, alloc_k.to_text(fs))? {
+        let mut g = match k.arm::<c::BucketGens>() {
+            Some(g) => t.bkey_reassemble(g)?,
+            None => {
+                let mut g = t.bkey_alloc_typed::<c::BucketGens>()?;
+                g.k_mut().p = gens_pos.key;
+                g
+            }
+        };
+        g.v_mut().gens[gens_pos.idx] = a.v().generation;
+        t.update(bucket_gens_iter, &g, UpdateTriggerFlags::empty())?;
+    }
+
+    let nr_stripes = t.bucket_nr_stripes(bucket)?;
+
+    if fsck_err_on!(t, a.v().stripe_refcount != nr_stripes, id::alloc_key_stripe_refcount_wrong,
+                    "alloc key with incorrect stripe_refcount, should be {}\n{}",
+                    nr_stripes, alloc_k.to_text(fs))? {
+        a.v_mut().stripe_refcount = nr_stripes;
+        t.update(alloc_iter, &a, UpdateTriggerFlags::empty())?;
+    }
+    Ok(())
+}
+
+/// The alloc btree's hole from @start, buckets of @ca, against the freespace
+/// btree - @end cut to the freespace key there: bch2_check_alloc_hole_freespace().
+fn check_alloc_hole_freespace<'t>(
+    t:              &TransAttempt<'_, 't>,
+    ca:             &c::bch_dev,
+    start:          c::bpos,
+    end:            &mut c::bpos,
+    freespace_iter: &mut BtreeIter<'t>,
+) -> Result<(), BchError> {
+    if ca.mi.get().freespace_initialized == 0 {
+        return Ok(());
+    }
+
+    freespace_iter.set_pos(start);
+    let (freespace_iter, k) = freespace_iter.peek_slot_shared(t)?;
+    *end = bkey_min(k.k.p, *end);
+
+    let p = freespace_iter.pos();
+    if fsck_err_on!(t, k.k.type_ != KEY_TYPE_SET, id::freespace_hole_missing,
+                    "hole in alloc btree missing in freespace btree\ndevice {} buckets {}-{}",
+                    { p.inode }, { p.offset }, { end.offset })? {
+        let size = (end.offset - p.offset).min(u32::MAX.into());
+
+        let mut u = t.bkey_alloc_typed::<c::Set>()?;
+        u.k_mut().p = pos(p.inode, p.offset + size);
+        u.k_mut().size = size as u32;
+        t.update(freespace_iter, &u, UpdateTriggerFlags::empty())?;
+    }
+    Ok(())
+}
+
+/// The alloc btree's hole from @start against the bucket_gens btree: gens
+/// there zero - @end cut to the bucket_gens key there:
+/// bch2_check_alloc_hole_bucket_gens().
+fn check_alloc_hole_bucket_gens<'t>(
+    t:                &TransAttempt<'_, 't>,
+    start:            c::bpos,
+    end:              &mut c::bpos,
+    bucket_gens_iter: &mut BtreeIter<'t>,
+) -> Result<(), BchError> {
+    let start_pos = BucketGensPos::new(start);
+    let end_pos = BucketGensPos::new(*end);
+
+    bucket_gens_iter.set_pos(start_pos.key);
+    let (bucket_gens_iter, k) = bucket_gens_iter.peek_slot_shared(t)?;
+
+    let gens_end = if bkey_eq(start_pos.key, end_pos.key) {
+        end_pos.idx
+    } else {
+        c::KEY_TYPE_BUCKET_GENS_NR as usize
+    };
+
+    if let Some(g) = k.arm::<c::BucketGens>() {
+        let mut gens = g.v().gens;
+        let mut need_update = false;
+
+        for i in start_pos.idx..gens_end {
+            let b = BucketGensPos { key: k.k.p, idx: i }.bucket();
+            if fsck_err_on!(t, gens[i] != 0, id::bucket_gens_hole_wrong,
+                            "hole in alloc btree at {}:{} with nonzero gen in bucket_gens btree ({})",
+                            { b.inode }, { b.offset }, gens[i])? {
+                gens[i] = 0;
+                need_update = true;
+            }
+        }
+
+        if need_update {
+            let mut u = t.bkey_reassemble(g)?;
+            u.v_mut().gens = gens;
+            t.update(bucket_gens_iter, &u, UpdateTriggerFlags::empty())?;
+        }
+    }
+
+    *end = bkey_min(*end, BucketGensPos { key: k.k.p.nosnap_successor(), idx: 0 }.bucket());
+    Ok(())
+}
+
+/// The btrees derived from the alloc btree, that its keys and holes are
+/// checked against: an iterator on each.
+struct DerivedIters<'t> {
+    discard:     BtreeIter<'t>,
+    freespace:   BtreeIter<'t>,
+    bucket_gens: BtreeIter<'t>,
+}
+
+/// The alloc key or hole at @iter, checked and committed, and @iter on past
+/// it - false at the end: check_btree_alloc_iter().
+fn check_btree_alloc_iter<'t>(
+    t:            &TransAttempt<'_, 't>,
+    ca:           &mut Option<DevRef>,
+    iter:         &mut BtreeIter<'t>,
+    iters:        &mut DerivedIters<'t>,
+    progress:     &Progress<'_>,
+    last_flushed: &mut WbMaybeFlush,
+) -> Result<bool, BchError> {
+    passes::cancelled(t.fs())?;
+
+    let next = {
+        let Some((alloc_iter, k)) = get_key_or_real_bucket_hole(t, iter, ca)? else {
+            return Ok(false);
+        };
+
+        progress.update(t, alloc_iter)?;
+
+        match k {
+            KeyOrHole::Key(k) => {
+                check_alloc_key(t, k, alloc_iter, iters, last_flushed)?;
+                k.k.p.nosnap_successor()
+            }
+            KeyOrHole::Hole { start, end } => {
+                let mut next = end;
+                let ca = ca.as_ref().expect("a hole is in a device's buckets");
+                check_alloc_hole_freespace(t, ca, start, &mut next, &mut iters.freespace)?;
+                check_alloc_hole_bucket_gens(t, start, &mut next, &mut iters.bucket_gens)?;
+                next
+            }
+        }
+    };
+
+    t.commit(None, CommitFlags::NO_ENOSPC)?;
+
+    iter.set_pos(next);
+    Ok(true)
+}
+
+/// Every alloc key and hole, against need_discard, freespace and bucket_gens:
+/// check_btree_alloc().
+fn check_btree_alloc(fs: &Fs, trans: &BtreeTrans<'_>) -> Result<(), BchError> {
+    let progress = Progress::recovery(fs, c"check_btree_alloc", &[c::btree_id::alloc], &[]);
+
+    let mut iter = BtreeIter::new(trans, c::btree_id::alloc, POS_MIN, BtreeIterFlags::PREFETCH);
+    let mut iters = DerivedIters {
+        discard:     BtreeIter::new(trans, c::btree_id::need_discard, POS_MIN, BtreeIterFlags::PREFETCH),
+        freespace:   BtreeIter::new(trans, c::btree_id::freespace, POS_MIN,
+                                    BtreeIterFlags::PREFETCH | BtreeIterFlags::TRIM),
+        bucket_gens: BtreeIter::new(trans, c::btree_id::bucket_gens, POS_MIN, BtreeIterFlags::PREFETCH),
+    };
+
+    let mut last_flushed = WbMaybeFlush::new()?;
+    let mut ca = None;
+
+    while lockrestart_do(trans, |t| {
+        check_btree_alloc_iter(t, &mut ca, &mut iter, &mut iters, &progress, &mut last_flushed)
+    })? {}
+
+    Ok(())
+}
+
+// ── need_discard, freespace, bucket_gens ─────────────────────────────────
+
+/// Need_discard entry @iter against the bucket's alloc key:
+/// bch2_check_discard_key().
+fn check_discard_key(t: &TransAttempt<'_, '_>, iter: &BtreeIter<'_>, last_flushed: &mut WbMaybeFlush)
+    -> Result<(), BchError>
+{
+    let fs = t.fs();
+    let p = NeedDiscardPos::from_bpos(iter.pos());
+    let bucket = p.bucket;
+
+    if fs.dev_bucket_tryget_noerror(bucket).is_none() {
+        if fsck_err!(t, id::need_discard_freespace_key_to_invalid_dev_bucket,
+                     "entry in {} btree for nonexistant dev:bucket {}:{}",
+                     iter.btree(), { bucket.inode }, { bucket.offset })? {
+            t.bit_mod_buffered(c::btree_id::need_discard, iter.pos(), false)?;
+        }
+        return Ok(());
+    }
+
+    let mut alloc_iter = BtreeIter::new(t, c::btree_id::alloc, bucket, BtreeIterFlags::empty());
+    let alloc_k = alloc_iter.peek_slot(t)?.expect("a slot always has a key");
+    let a = alloc_to_v4(alloc_k);
+
+    if data_type_from_u8(a.data_type) != data_type::need_discard ||
+       a.journal_seq_empty != p.journal_seq_empty {
+        last_flushed.maybe_flush(t, alloc_k)?;
+
+        if fsck_err!(t, id::need_discard_freespace_key_bad, "{}\nincorrectly set at {}:{}:{}:0",
+                     alloc_k.to_text(fs), iter.btree(), { iter.pos().inode }, { iter.pos().offset })? {
+            t.bit_mod_buffered(c::btree_id::need_discard, iter.pos(), false)?;
+        }
+    }
+    Ok(())
+}
+
+// ── Freespace entries ────────────────────────────────────────────────────
+
+/// Who checks a freespace entry against its bucket's alloc key: how a bad
+/// one's reported, and repaired.
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) enum FreespaceCheck {
+    /// check_alloc_info: deleted in place, the attempt restarted.
+    Fsck,
+    /// The allocator, about to take the bucket: committed state only, as
+    /// bucket_alloc_scan() reads it, and not logged. A commit here would
+    /// recurse into the allocator, so a recheck is spawned to repair it.
+    Allocator,
+    /// That recheck: silent.
+    Recheck,
+}
+
+impl FreespaceCheck {
+    fn fsck_flags(self) -> F {
+        F::FSCK_CAN_FIX | F::FSCK_CAN_IGNORE | match self {
+            Self::Fsck      => F::empty(),
+            Self::Allocator => F::FSCK_ERR_NO_LOG,
+            Self::Recheck   => F::FSCK_ERR_SILENT,
+        }
+    }
+}
+
+/// Freespace entry @iter against its bucket's alloc key: the bucket's gen
+/// and journal_seq_empty, if it's good. A bad one - for a bucket that doesn't
+/// exist, or isn't free, or of other gen bits - is reported, and if fsck says
+/// fix, deleted as @who repairs.
+pub(crate) fn check_freespace_key(t: &TransAttempt<'_, '_>, iter: &BtreeIter<'_>, who: FreespaceCheck)
+    -> Result<(u8, u64), BchError>
+{
+    let fs = t.fs();
+    let flags = who.fsck_flags();
+    let pos = FreespacePos::from_bpos(iter.pos());
+    let bad = |fix: bool| Err(if fix {
+        delete_freespace_key(t, iter, who)
+    } else {
+        fs.err(bch_errcode::BCH_ERR_bucket_not_allocatable)
+    });
+
+    let mut alloc_iter = BtreeIter::new(t, c::btree_id::alloc, pos.bucket, match who {
+        FreespaceCheck::Allocator => BtreeIterFlags::CACHED | BtreeIterFlags::COMMITTED,
+        _                         => BtreeIterFlags::empty(),
+    });
+    let ret = (|| {
+        let alloc_k = alloc_iter.peek_slot(t)?.expect("a slot always has a key");
+
+        if !fs.dev_bucket_exists(pos.bucket) {
+            return bad(fsck_err_flags!(t, POS_MIN, flags, id::need_discard_freespace_key_to_invalid_dev_bucket,
+                                       "entry in {} btree for nonexistant dev:bucket {}:{}",
+                                       iter.btree(), { pos.bucket.inode }, { pos.bucket.offset })?);
+        }
+
+        let a = alloc_to_v4(alloc_k);
+        let want = FreespacePos::new(pos.bucket, &a);
+        if data_type_from_u8(a.data_type) != data_type::free || pos != want {
+            return bad(fsck_err_flags!(t, POS_MIN, flags, id::need_discard_freespace_key_bad,
+                                       "{}\nincorrectly set at {}:{}:{}:0 (genbits {} should be {})",
+                                       alloc_k.to_text(fs), iter.btree(), { iter.pos().inode },
+                                       { iter.pos().offset }, pos.genbits, want.genbits)?);
+        }
+
+        Ok((a.generation, a.journal_seq_empty))
+    })();
+    alloc_iter.set_dontneed();
+    ret
+}
+
+/// Bad freespace entry @iter deleted, and the error the check ends with: in
+/// place, the attempt restarted - or for the allocator, by a recheck spawned,
+/// and bucket_not_allocatable.
+fn delete_freespace_key(t: &TransAttempt<'_, '_>, iter: &BtreeIter<'_>, who: FreespaceCheck) -> BchError {
+    let fs = t.fs();
+    if who == FreespaceCheck::Allocator {
+        let pos = c::bbpos { btree: iter.btree(), pos: iter.pos() };
+        // No write ref - the filesystem is going read-only - and it is left for fsck
+        let _ = fs.spawn_write(move |fs| async move {
+            let _ = crate::bch_err_fn!(&*fs, recheck_freespace_key(&fs, pos));
+        });
+        return fs.err(bch_errcode::BCH_ERR_bucket_not_allocatable);
+    }
+
+    match t.bit_mod_iter(iter, false).and_then(|()| t.commit(None, CommitFlags::NO_ENOSPC)) {
+        Ok(()) => t.restart(bch_errcode::BCH_ERR_transaction_restart_commit),
+        Err(e) => e,
+    }
+}
+
+/// check_freespace_key(), repairing in place: an entry left bad - fsck said
+/// not to fix it - isn't an error.
+fn repair_freespace_key(t: &TransAttempt<'_, '_>, iter: &BtreeIter<'_>, who: FreespaceCheck)
+    -> Result<(), BchError>
+{
+    match check_freespace_key(t, iter, who) {
+        Err(e) if e.matches(bch_errcode::BCH_ERR_bucket_not_allocatable) => Ok(()),
+        r => r.map(|_| ()),
+    }
+}
+
+/// The allocator's repair: the freespace entry at @pos checked again, in a
+/// transaction of its own, if it's still there.
+fn recheck_freespace_key(fs: &Fs, pos: c::bbpos) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+    lockrestart_do(&trans, |t| {
+        let mut iter = BtreeIter::new(t, pos.btree, pos.pos, BtreeIterFlags::empty());
+        let k = iter.peek_slot(t)?.expect("a slot always has a key");
+        if k.k.key_type() != c::bch_bkey_type::KEY_TYPE_set {
+            return Ok(());
+        }
+        repair_freespace_key(t, &iter, FreespaceCheck::Recheck)
+    })
+}
+
+/// Bucket_gens key @k, at @iter, against the device's buckets - gens for
+/// buckets that exist were checked against their alloc keys:
+/// bch2_check_bucket_gens_key().
+fn check_bucket_gens_key(t: &TransAttempt<'_, '_>, iter: &BtreeIter<'_>, k: BkeySC<'_>)
+    -> Result<(), BchError>
+{
+    let fs = t.fs();
+    let g = k.arm::<c::BucketGens>().expect("only bucket_gens keys in the bucket_gens btree");
+    let start = BucketGensPos { key: k.k.p, idx: 0 }.bucket().offset;
+    let end = BucketGensPos { key: k.k.p.nosnap_successor(), idx: 0 }.bucket().offset;
+
+    let Some(ca) = fs.dev_get(k.k.p.inode as u32) else {
+        if fsck_err!(t, id::bucket_gens_to_invalid_dev, "bucket_gens key for invalid device:\n{}",
+                     k.to_text(fs))? {
+            t.delete_at(iter, UpdateTriggerFlags::empty())?;
+        }
+        return Ok(());
+    };
+
+    let first_bucket = u64::from(ca.mi.get().first_bucket);
+    let nbuckets = ca.mi.get().nbuckets;
+
+    if fsck_err_on!(t, end <= first_bucket || start >= nbuckets, id::bucket_gens_to_invalid_buckets,
+                    "bucket_gens key for invalid buckets:\n{}", k.to_text(fs))? {
+        return t.delete_at(iter, UpdateTriggerFlags::empty());
+    }
+
+    let mut gens = g.v().gens;
+    let mut need_update = false;
+
+    for b in (start..first_bucket).chain(nbuckets..end) {
+        let i = (b & u64::from(c::KEY_TYPE_BUCKET_GENS_MASK)) as usize;
+        if fsck_err_on!(t, gens[i] != 0, id::bucket_gens_nonzero_for_invalid_buckets,
+                        "bucket_gens key has nonzero gen for invalid bucket")? {
+            gens[i] = 0;
+            need_update = true;
+        }
+    }
+
+    if need_update {
+        let mut u = t.bkey_reassemble(g)?;
+        u.v_mut().gens = gens;
+        t.update(iter, &u, UpdateTriggerFlags::empty())?;
+    }
+    Ok(())
+}
+
+// ── check_alloc_info ─────────────────────────────────────────────────────
+
+fn check_alloc_info(fs: &Fs) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+
+    check_btree_alloc(fs, &trans)?;
+
+    {
+        let mut last_flushed = WbMaybeFlush::new()?;
+        let mut iter = BtreeIter::new(&trans, c::btree_id::need_discard, POS_MIN, BtreeIterFlags::PREFETCH);
+        iter.for_each_commit(&trans, None, CommitFlags::NO_ENOSPC, |t, iter, _| {
+            passes::cancelled(fs)?;
+            check_discard_key(t, iter, &mut last_flushed)
+        })?;
+    }
+
+    // The freespace btree, every position of its keys:
+    {
+        let mut iter = BtreeIter::new(&trans, c::btree_id::freespace, POS_MIN,
+                                      BtreeIterFlags::PREFETCH | BtreeIterFlags::TRIM);
+        loop {
+            passes::cancelled(fs)?;
+
+            let t = trans.begin();
+            let k = match iter.peek(&t) {
+                Ok(None)    => break,
+                Ok(Some(k)) => Ok(*k.k),
+                Err(e)      => Err(e),
+            };
+            let ret = k.and_then(|k| repair_freespace_key(&t, &iter, FreespaceCheck::Fsck).map(|()| k));
+
+            match ret {
+                Ok(_) => {}
+                Err(e) if is_restart(&e) => continue,
+                Err(e) => {
+                    if let Ok(k) = k {
+                        bch_err!(fs, "while checking {k}");
+                    }
+                    return Err(e);
+                }
+            }
+
+            iter.set_pos(iter.pos().nosnap_successor());
+        }
+    }
+
+    let mut iter = BtreeIter::new(&trans, c::btree_id::bucket_gens, POS_MIN, BtreeIterFlags::PREFETCH);
+    iter.for_each_commit(&trans, None, CommitFlags::NO_ENOSPC, |t, iter, k| {
+        passes::cancelled(fs)?;
+        check_bucket_gens_key(t, iter, k)
+    })
+}
+
+crate::recovery_pass!(bch2_check_alloc_info => check_alloc_info);
+
+// ── check_alloc_to_lru_refs ──────────────────────────────────────────────
+
+/// Alloc key @alloc_k, at @alloc_iter, against the lrus it should be in - its
+/// device's fragmentation lru, and for cached data, its read lru:
+/// bch2_check_alloc_to_lru_ref().
+fn check_alloc_to_lru_ref<'t>(
+    t:            &TransAttempt<'_, 't>,
+    alloc_iter:   &BtreeIter<'t>,
+    alloc_k:      BkeySC<'_>,
+    last_flushed: &mut WbMaybeFlush,
+) -> Result<(), BchError> {
+    let fs = t.fs();
+    let dev = alloc_k.k.p.inode as u32;
+    let Some(ca) = fs.dev_get(dev) else { return Ok(()) };
+
+    let mut a = alloc_to_v4(alloc_k);
+    let target = bucket_to_u64(alloc_k.k.p);
+
+    let lru_idx = a.lru_idx_fragmentation(&ca);
+    if lru_idx != 0 {
+        let pos = LruPos::new(LruId::Fragmentation { dev }.id(), lru_idx, target);
+
+        // per_dev_fragmentation_lru upgrade: the per-device entry is either
+        // missing or was just written by check_lrus' migration and is sitting
+        // unflushed in the write buffer, which reads as missing - either way
+        // the lookup can't win, and the write buffer flush it triggers is far
+        // more expensive than just recreating the entry unconditionally:
+        if !per_dev_fragmentation_lru(fs) {
+            lru_mod(t, pos, true)?;
+        } else {
+            lru_check_set(t, pos, alloc_k, last_flushed.borrow())?;
+        }
+    }
+
+    if data_type_from_u8(a.data_type) == data_type::cached {
+        if fsck_err_on!(t, a.io_time[READ] == 0, id::alloc_key_cached_but_read_time_zero,
+                        "cached bucket with read_time 0\n{}", alloc_k.to_text(fs))? {
+            let mut a_mut = t.alloc_to_v4_mut(alloc_k)?;
+            a_mut.v_mut().io_time[READ] = fs.current_io_time(READ);
+            t.update(alloc_iter, &a_mut, UpdateTriggerFlags::NORUN)?;
+            a = *a_mut.v();
+        }
+
+        lru_check_set(t, LruPos::new(LruId::Read { dev }.id(), a.io_time[READ], target), alloc_k,
+                      last_flushed.borrow())?;
+    }
+    Ok(())
+}
+
+fn check_alloc_to_lru_refs(fs: &Fs) -> Result<(), BchError> {
+    let mut last_flushed = WbMaybeFlush::new()?;
+    let progress = Progress::recovery(fs, c"bch2_check_alloc_to_lru_refs", &[c::btree_id::alloc], &[]);
+
+    let trans = crate::btree_trans!(fs);
+    let mut iter = BtreeIter::new(&trans, c::btree_id::alloc, POS_MIN, BtreeIterFlags::PREFETCH);
+    iter.for_each_commit(&trans, None, CommitFlags::NO_ENOSPC, |t, iter, k| {
+        progress.update(t, iter)?;
+        last_flushed.inc();
+        check_alloc_to_lru_ref(t, iter, k, &mut last_flushed)
+    })?;
+
+    crate::data::ec::check::check_stripe_refs(&trans)
+}
+
+crate::recovery_pass!(bch2_check_alloc_to_lru_refs => check_alloc_to_lru_refs);
+
+// ── Freespace initialization ─────────────────────────────────────────────
+
+/// The alloc key or hole at @iter, short of @end, into the freespace,
+/// need_discard and need_gc_gens btrees, committed, and @iter on past it:
+/// dev_freespace_init_iter().
+fn dev_freespace_init_iter<'t>(t: &TransAttempt<'_, 't>, ca: &c::bch_dev, iter: &mut BtreeIter<'t>,
+                               end: c::bpos) -> Result<(), BchError> {
+    match get_key_or_hole(t, iter, end)? {
+        // Live keys, one at a time:
+        KeyOrHole::Key(k) => {
+            bucket_do_freespace_index(t, ca, k, &alloc_to_v4(k), true)?;
+            t.commit(None, CommitFlags::NO_ENOSPC)?;
+
+            iter.advance();
+        }
+        KeyOrHole::Hole { start, end } => {
+            let mut freespace = t.bkey_alloc_typed::<c::Set>()?;
+            freespace.k_mut().p = end;
+            freespace.k_mut().size = (end.offset - start.offset) as u32;
+
+            t.insert(c::btree_id::freespace, freespace, UpdateTriggerFlags::empty())?;
+            t.commit(None, CommitFlags::NO_ENOSPC)?;
+
+            iter.set_pos(end);
+        }
+    }
+    Ok(())
+}
+
+/// Device @ca's buckets @bucket_start to @bucket_end, from the alloc btree
+/// into the freespace, need_discard and need_gc_gens btrees, and its member
+/// marked freespace_initialized: bch2_dev_freespace_init().
+fn dev_freespace_init(fs: &Fs, ca: &c::bch_dev, bucket_start: u64, bucket_end: u64) -> Result<(), BchError> {
+    let dev = u32::from(ca.dev_idx);
+    let end = pos(dev.into(), bucket_end);
+
+    assert!(bucket_start <= bucket_end, "bucket range {bucket_start}-{bucket_end}");
+    assert!(bucket_end <= ca.mi.get().nbuckets, "bucket {bucket_end} past {} buckets", ca.mi.get().nbuckets);
+
+    let trans = crate::btree_trans!(fs);
+    let mut iter = BtreeIter::new(&trans, c::btree_id::alloc,
+                                  pos(dev.into(), bucket_start.max(ca.mi.get().first_bucket.into())),
+                                  BtreeIterFlags::PREFETCH);
+
+    let mut last_updated = local_clock();
+    while bkey_lt(iter.pos(), end) {
+        if local_clock() > last_updated + 10 * u64::from(c::NSEC_PER_SEC) {
+            bch_info!(fs, "{}: bch2_dev_freespace_init: currently at {}/{}",
+                      ca, { iter.pos().offset }, ca.mi.get().nbuckets);
+            last_updated = local_clock();
+        }
+
+        lockrestart_do(&trans, |t| dev_freespace_init_iter(t, ca, &mut iter, end))?;
+    }
+
+    fs.sb_lock().fs_member_mut(dev).set_freespace_initialized(true);
+    Ok(())
+}
+
+#[c_export]
+pub fn bch2_dev_freespace_init(c: &Opaque<c::bch_fs>, ca: &c::bch_dev, bucket_start: u64, bucket_end: u64)
+    -> c_int
+{
+    ret_to_c(dev_freespace_init(Fs::from_c(c), ca, bucket_start, bucket_end))
+}
+
+/// Every device whose freespace isn't initialized - checked on every mount,
+/// for a crash in the middle of adding a device: bch2_fs_freespace_init().
+fn fs_freespace_init(fs: &Fs) -> Result<(), BchError> {
+    if fs.sb.features.get() & (1 << c::bch_sb_feature::BCH_FEATURE_small_image.0) != 0 {
+        return Ok(());
+    }
+
+    let mut doing_init = false;
+    for ca in fs.members() {
+        if ca.mi.get().freespace_initialized != 0 {
+            continue;
+        }
+
+        if !doing_init {
+            bch_info!(fs, "initializing freespace");
+            doing_init = true;
+        }
+
+        dev_freespace_init(fs, &ca, 0, ca.mi.get().nbuckets)?;
+    }
+
+    if doing_init {
+        fs.write_super(&mut fs.sb_lock());
+        bch_verbose!(fs, "done initializing freespace");
+    }
+    Ok(())
+}
+
+#[c_export]
+pub fn bch2_fs_freespace_init(c: &Opaque<c::bch_fs>) -> c_int {
+    ret_to_c(fs_freespace_init(Fs::from_c(c)))
+}
diff --git a/fs/bcachefs/alloc/check_backpointers.rs b/fs/bcachefs/alloc/check_backpointers.rs
new file mode 100644
index 0000000..892b3c3
--- /dev/null
+++ b/fs/bcachefs/alloc/check_backpointers.rs
@@ -0,0 +1,1033 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! fsck of the backpointer btrees (backpointers.rs): three passes, each
+//! checking one direction of the index.
+//!
+//! - check_btree_backpointers: every backpointer is on a device, in a bucket
+//!   that exists.
+//! - check_extents_to_backpointers: every pointer has its backpointer. It
+//!   sums each bucket's backpointers against its alloc key's sector counts,
+//!   then walks every btree's pointers into the buckets that come up short,
+//!   with the backpointer btree's nodes holding them pinned. The buckets are
+//!   recorded in each device's bucket bitmaps, which copygc reads too.
+//!   Two keys claiming the same space - a double allocation - are resolved
+//!   here: gc only marks the bucket `multiple`. A dropped loser's trigger
+//!   deletes the winner's backpointer, so the drop gets a commit of its own
+//!   and the winner's is written after it; and once the walk is done, a
+//!   `multiple` bucket whose backpointers agree gets their type.
+//! - check_backpointers_to_extents: every backpointer points to something
+//!   that points back - walked in target order, through BpScanIter.
+//!
+//! Before calling a key missing, a pass flushes the write buffer and looks
+//! again - see backpointers.rs.
+
+use crate::accounting::bucket_data_type;
+use crate::alloc::background::alloc_to_v4;
+use crate::alloc::backpointers::{backpointer_del, backpointers_match, backpointers_maybe_flush,
+                                 bucket_backpointer_mod, extent_ptr_to_bp, get_key, BackpointerPos,
+                                 BpScanIter};
+use crate::alloc::capacity::DiskReservation;
+use crate::alloc::check_data::{bkey_drop_device_and_update, kill_replica_if_checksum_bad};
+use crate::btree::bkey::prelude::*;
+use crate::btree::bkey::{pos, spos, BkeyI, BkeySC, POS_MAX, POS_MIN, SPOS_MAX};
+use crate::btree::bkey_buf::BkeyBuf;
+use crate::btree::cache::BtreeCachePins;
+use crate::btree::iter::{commit_do, lockrestart_do, BtreeIter, BtreeIterFlags, BtreeTrans, CommitFlags,
+                         TransAttempt, UpdateTriggerFlags};
+use crate::btree::write_buffer::{WbFlush, WbMaybeFlush};
+use crate::c;
+use crate::data::extents::Extents;
+use crate::data::ptrs::{crc_is_compressed, extents_match, BkeyVPtrs, Ptrs};
+use crate::data::reflink::make_extent_indirect;
+use crate::errcode::{bch_errcode, ret_to_c, BchError};
+use crate::fs::Fs;
+use crate::init::damage;
+use crate::init::error::id;
+use crate::init::passes;
+use crate::init::progress::Progress;
+use crate::types::bits_to_longs;
+use crate::util::bitmap::{AtomicBitmap, AtomicULong};
+use crate::util::log::{log_msg_start, print_str, LogLevel, LogMsg, Ratelimit};
+use crate::util::rcu::{read_lock, ReadGuard};
+use crate::util::{Printbuf, ToText};
+use crate::{fsck_err, inode_fsck_err, prt};
+use core::ffi::c_int;
+use core::ops::{ControlFlow, RangeInclusive};
+use core::sync::atomic::Ordering;
+use cstruct_macros::c_export;
+
+// ── fsck: check_btree_backpointers ───────────────────────────────────────
+
+fn check_backpointer_has_valid_bucket(t: &TransAttempt<'_, '_>, k: BkeySC<'_>,
+                                      last_flushed: &mut WbMaybeFlush) -> Result<(), BchError> {
+    if k.k.key_type() != c::bch_bkey_type::KEY_TYPE_backpointer {
+        return Ok(());
+    }
+
+    let fs = t.fs();
+    let bucket = {
+        let rcu = read_lock();
+        fs.dev_rcu(k.k.p.inode as u32, &rcu).map(|ca| BackpointerPos::from_bpos(fs, k.k.p).bucket(ca))
+    };
+
+    let Some(bucket) = bucket else {
+        backpointers_maybe_flush(t, k, last_flushed.borrow())?;
+
+        if fsck_err!(t, id::backpointer_to_missing_device, "backpointer for missing device:\n{}",
+                     k.to_text(fs))? {
+            backpointer_del(t, c::btree_id::backpointers, k.k.p)?;
+        }
+        return Ok(());
+    };
+
+    let mut alloc_iter = BtreeIter::new(t, c::btree_id::alloc, bucket, BtreeIterFlags::empty());
+    let alloc_k = alloc_iter.peek_slot(t)?.expect("a slot always has a key");
+
+    if alloc_k.k.key_type() != c::bch_bkey_type::KEY_TYPE_alloc_v4 {
+        backpointers_maybe_flush(t, k, last_flushed.borrow())?;
+
+        let p = alloc_iter.pos();
+        if fsck_err!(t, id::backpointer_to_missing_alloc, "backpointer for nonexistent alloc key: {}:{}:0\n{}",
+                     { p.inode }, { p.offset }, k.to_text(fs))? {
+            backpointer_del(t, c::btree_id::backpointers, k.k.p)?;
+        }
+    }
+    Ok(())
+}
+
+fn check_btree_backpointers(fs: &Fs) -> Result<(), BchError> {
+    let progress = Progress::recovery(fs, c"bch2_check_btree_backpointers", &[c::btree_id::backpointers], &[]);
+    let mut last_flushed = WbMaybeFlush::new()?;
+
+    let trans = crate::btree_trans!(fs);
+    let mut iter = BtreeIter::new(&trans, c::btree_id::backpointers, POS_MIN, BtreeIterFlags::empty());
+    iter.for_each_commit(&trans, None, CommitFlags::NO_ENOSPC, |t, iter, k| {
+        progress.update(t, iter)?;
+        check_backpointer_has_valid_bucket(t, k, &mut last_flushed)
+    })
+}
+
+crate::recovery_pass!(bch2_check_btree_backpointers => check_btree_backpointers);
+
+// ── fsck: an extent's backpointer ────────────────────────────────────────
+
+fn bp_missing(t: &TransAttempt<'_, '_>, extent: BkeySC<'_>, bp: &mut BkeyI<c::Backpointer>,
+              bp_found: BkeySC<'_>) -> Result<(), BchError> {
+    let fs = t.fs();
+    let mut buf = Printbuf::new();
+    prt!(&mut buf, "missing backpointer\nfor:  {}", extent.to_text(fs));
+    prt!(&mut buf, "\nwant: {}", BkeySC::<c::Backpointer>::from(&*bp).to_text(fs));
+    if !bp_found.k.is_deleted() {
+        prt!(&mut buf, "\ngot:  {}", bp_found.to_text(fs));
+    }
+
+    if fsck_err!(t, id::ptr_to_missing_backpointer, "{}", buf)? {
+        bucket_backpointer_mod(t, extent, bp, true)?;
+    }
+    Ok(())
+}
+
+/// A pointer to a bucket @dev doesn't have counts as stale.
+fn bkey_dev_ptr_stale(fs: &Fs, k: BkeySC<'_, Ptrs>, dev: u32) -> bool {
+    let rcu = read_lock();
+    let Some(ca) = fs.dev_rcu(dev, &rcu) else { return false };
+
+    let stale = k.ptrs(fs).any(|p| u32::from(p.dev()) == dev && ca.ptr_stale(p, &rcu).is_none_or(|s| s != 0));
+    stale
+}
+
+fn drop_double_allocation(t: &TransAttempt<'_, '_>, btree: c::btree_id, level: u8, k: BkeySC<'_, Ptrs>,
+                          dev: u32)
+    -> Result<(), BchError>
+{
+    bkey_drop_device_and_update(t, btree, level.into(), k, dev,
+                                c::bch_key_type_errors::KEY_TYPE_ERROR_double_allocation)
+}
+
+/// Of two keys claiming the same space, the loser's pointer has just been
+/// dropped, its update queued; @winner keeps the space. The drop's trigger
+/// deletes the loser's backpointer - blind, through the write buffer, and at
+/// the position the winner's is at. So the drop is committed on its own and
+/// the winner's backpointer written after it, the later write winning; then
+/// the walk restarts, its keys stale. The bucket gc left `multiple` is
+/// check_extents_to_backpointers()'s to recompute, at its end.
+fn double_allocation_dropped(t: &TransAttempt<'_, '_>, winner: BkeySC<'_>,
+                             mut winner_bp: BkeyI<c::Backpointer>) -> Result<(), BchError> {
+    let winner_k = BkeyBuf::from_key(winner);
+
+    // the drop may pad the key back to its durability, charged to a reservation
+    let res = DiskReservation::new(t.fs());
+    t.commit(Some(&res), CommitFlags::NO_ENOSPC)?;
+
+    bucket_backpointer_mod(t, (&winner_k).into(), &mut winner_bp, true)?;
+    t.commit(None, CommitFlags::NO_ENOSPC)?;
+
+    Err(t.restart(bch_errcode::BCH_ERR_transaction_restart_nested))
+}
+
+/// One of two extents sharing physical space, and its logical range in the overlap.
+struct DupExtent<'k> {
+    btree:   c::btree_id,
+    level:   u8,
+    k:       BkeySC<'k>,
+    overlap: core::ops::Range<u64>,
+}
+
+/// Just the overlapping part of each becomes a reflink_p of one shared reflink_v;
+/// the rest of each stays an extent, split off when the reflink_p is inserted.
+fn extents_to_reflink<'a>(t: &TransAttempt<'a, '_>, e1: &DupExtent<'_>, e2: &DupExtent<'_>)
+    -> Result<(), BchError>
+{
+    let fs = t.fs();
+    // as C's: a u32
+    let overlap_size = (e1.overlap.end - e1.overlap.start) as u32;
+    assert_eq!(u64::from(overlap_size), e2.overlap.end - e2.overlap.start, "overlaps of different sizes");
+
+    let p1 = e1.k.k.p;
+    let mut iter1 = BtreeIter::new_level(t, e1.btree, p1, e1.level.into(), BtreeIterFlags::INTENT);
+    t.iter_traverse(&mut iter1)?;
+
+    // With room for the reflink_p make_extent_indirect() makes it, in place
+    let mut k1_mut = t.bkey_reassemble_room(e1.k, size_of::<BkeyI<c::ReflinkP>>())?;
+    {
+        let mut e = k1_mut.as_mut().arm::<Extents>().expect("an extent");
+        e.cut_front_in_place(fs, spos(p1.inode, e1.overlap.start, p1.snapshot));
+        e.cut_back_in_place(spos(p1.inode, e1.overlap.end, p1.snapshot));
+    }
+
+    make_extent_indirect(t, &iter1, &mut k1_mut, false)?;
+
+    let r_v_idx = k1_mut.as_ref().arm::<c::ReflinkP>().expect("a reflink_p, as just made").v.idx();
+
+    let p2 = e2.k.k.p;
+    let mut iter2 = BtreeIter::new_level(t, e2.btree, p2, e2.level.into(), BtreeIterFlags::INTENT);
+    t.iter_traverse(&mut iter2)?;
+
+    let mut rp = t.bkey_alloc_typed::<c::ReflinkP>()?;
+    let k = rp.k_mut();
+    k.p = spos(p2.inode, e2.overlap.end, p2.snapshot);
+    k.size = overlap_size;
+    k.bversion = e2.k.k.bversion;
+    rp.v_mut().set_idx(r_v_idx);
+
+    t.update(&iter2, &rp, UpdateTriggerFlags::INTERNAL_SNAPSHOT_NODE)
+}
+
+fn check_bp_dup(t: &TransAttempt<'_, '_>, extent: BkeySC<'_, Ptrs>, bp: &mut BkeyI<c::Backpointer>,
+                other_bp: BkeySC<'_, c::Backpointer>) -> Result<(), BchError> {
+    let fs = t.fs();
+    let dev = bp.k.p.inode as u32;
+    let btree = c::btree_id(bp.v.btree_id.into());
+    let ov = *other_bp.v();
+    let other_btree = c::btree_id(ov.btree_id.into());
+
+    let mut other_extent_iter = BtreeIter::uninit();
+    let other_extent = match get_key(t, other_bp, &mut other_extent_iter, BtreeIterFlags::empty(), None, false) {
+        Err(e) if e.matches(bch_errcode::BCH_ERR_backpointer_to_overwritten_btree_node) =>
+            return bp_missing(t, extent.into(), bp, other_bp.into()),
+        Err(e)      => return Err(e),
+        Ok(None)    => return bp_missing(t, extent.into(), bp, other_bp.into()),
+        Ok(Some(k)) => k.arm::<Ptrs>().expect("a key a backpointer matches has pointers"),
+    };
+
+    let extent_bp = BkeyI { k: bp.k, v: bp.v };
+    let other_bp = BkeyI { k: *other_bp.k, v: ov };
+
+    if bkey_dev_ptr_stale(fs, other_extent, dev) {
+        drop_double_allocation(t, other_btree, ov.level, other_extent, dev)?;
+        return double_allocation_dropped(t, extent.into(), extent_bp);
+    }
+
+    if extents_match(fs, extent.into(), other_extent.into()) {
+        let mut msg = LogMsg::new(fs);
+        prt!(&mut msg, "duplicate versions of same extent, deleting smaller\n{}\n{}",
+             extent.to_text(fs), other_extent.to_text(fs));
+
+        return if other_extent.k.size <= extent.k.size {
+            drop_double_allocation(t, other_btree, ov.level, other_extent, dev)?;
+            double_allocation_dropped(t, extent.into(), extent_bp)
+        } else {
+            drop_double_allocation(t, btree, bp.v.level, extent, dev)?;
+            double_allocation_dropped(t, other_extent.into(), other_bp)
+        };
+    }
+
+    if kill_replica_if_checksum_bad(t, other_btree, ov.level.into(), other_extent, btree, extent, dev)? {
+        return double_allocation_dropped(t, extent.into(), extent_bp);
+    }
+    if kill_replica_if_checksum_bad(t, btree, bp.v.level.into(), extent, other_btree, other_extent, dev)? {
+        return double_allocation_dropped(t, other_extent.into(), other_bp);
+    }
+
+    // Both replicas verify clean: a physical region is referenced from two
+    // distinct logical positions, possibly with partial overlap. This can
+    // happen after btree topology recovery from media errors - convert the
+    // overlapping portion to a reflink_v shared by two reflink_p's so neither
+    // file loses data. Non-overlapping prefix/suffix of each extent stays as
+    // a regular extent.
+    //
+    // Only valid for leaf extents; btree pointers can't be reflinked.
+    let is_extent = |k: BkeySC<'_, Ptrs>| k.k.key_type() == c::bch_bkey_type::KEY_TYPE_extent;
+    if is_extent(extent) && is_extent(other_extent) {
+        let (bp_sub, other_bp_sub) = {
+            let rcu = read_lock();
+            let Some(ca) = fs.dev_rcu(dev, &rcu) else { return Ok(()) };
+            (BackpointerPos::from_bpos(fs, bp.k.p).bucket_and_offset(ca).1,
+             BackpointerPos::from_bpos(fs, other_bp.k.p).bucket_and_offset(ca).1)
+        };
+
+        // as C's: u32s
+        let overlap_sub_start = bp_sub.max(other_bp_sub);
+        let overlap_sub_end = bp_sub.wrapping_add(bp.v.bucket_len)
+            .min(other_bp_sub.wrapping_add(ov.bucket_len));
+        if overlap_sub_end <= overlap_sub_start {
+            return Ok(()); // bps don't actually overlap
+        }
+
+        // The physical overlap is a logical one only for uncompressed data.
+        // Compressed data can't be split: two extents share it whole, if each
+        // is the same view of the same data, or can't be repaired here
+        let ptr_to_dev = |k: BkeySC<'_, Ptrs>| k.has_device_decode(fs, dev)
+            .expect("a pointer to the backpointer's device").p;
+        let (p1, p2) = (ptr_to_dev(extent), ptr_to_dev(other_extent));
+        let (k1_start, k2_start, overlap_len) = if crc_is_compressed(&p1.crc) || crc_is_compressed(&p2.crc) {
+            let same_view = p1.ptr.offset() == p2.ptr.offset() &&
+                p1.crc.compressed_size == p2.crc.compressed_size &&
+                p1.crc.offset == p2.crc.offset &&
+                p1.crc.live_size == p2.crc.live_size &&
+                extent.k.size == other_extent.k.size;
+            if !same_view {
+                let mut msg = LogMsg::new(fs);
+                prt!(&mut msg, "duplicate compressed extents pointing to overlapping space on dev {dev}, \
+                                not the same data - can't share them\n{}\n{}",
+                     extent.to_text(fs), other_extent.to_text(fs));
+                return fs.throw(bch_errcode::BCH_ERR_fsck_repair_unimplemented);
+            }
+            (extent.k.start_offset(), other_extent.k.start_offset(), u64::from(extent.k.size))
+        } else {
+            (extent.k.start_offset() + u64::from(overlap_sub_start - bp_sub),
+             other_extent.k.start_offset() + u64::from(overlap_sub_start - other_bp_sub),
+             u64::from(overlap_sub_end - overlap_sub_start))
+        };
+
+        let mut buf = Printbuf::new();
+        prt!(&mut buf, "duplicate extents pointing to overlapping space on dev {}, converting overlap to reflink\n{}\n{}",
+             { bp.k.p.inode }, extent.to_text(fs), other_extent.to_text(fs));
+
+        // Both files are damaged - sharing physical space means at least one
+        // of them reads the other's bytes. The pos-ful report records against
+        // the first inode; record the second explicitly (KEY_TYPE_extent only
+        // lives in the extents btree, so both attribute):
+        if inode_fsck_err!(t, extent.k.p, id::dup_extents_to_reflink, "{}", buf)? {
+            damage::record(t, other_extent.k.p, id::dup_extents_to_reflink)?;
+            extents_to_reflink(t,
+                &DupExtent { btree, level: bp.v.level, k: extent.into(), overlap: k1_start..k1_start + overlap_len },
+                &DupExtent { btree: other_btree, level: ov.level, k: other_extent.into(),
+                             overlap: k2_start..k2_start + overlap_len })?;
+        }
+        return Ok(());
+    }
+
+    let mut msg = LogMsg::new(fs);
+    prt!(&mut msg, "duplicate extents pointing to same space on dev {}\n{}\n{}",
+         { bp.k.p.inode }, extent.to_text(fs), other_extent.to_text(fs));
+    fs.throw(bch_errcode::BCH_ERR_fsck_repair_unimplemented)
+}
+
+/// Repairs as check_extents_to_backpointers does: makes a missing one, resolves
+/// one that's someone else's.
+pub fn check_bp_exists(t: &TransAttempt<'_, '_>, extent: BkeySC<'_, Ptrs>, bp: &mut BkeyI<c::Backpointer>,
+                       mut last_flushed: WbFlush<'_>) -> Result<(), BchError> {
+    let mut bp_iter = BtreeIter::new(t, bp.v.bp_btree(), bp.k.p, BtreeIterFlags::empty());
+    let bp_found = bp_iter.peek_slot(t)?.expect("a slot always has a key");
+
+    match bp_found.arm::<c::Backpointer>() {
+        None => {
+            last_flushed.maybe_flush(t, extent.into())?;
+            bp_missing(t, extent.into(), bp, bp_found)
+        }
+        Some(found) if !backpointers_match(found.v(), &bp.v) => {
+            last_flushed.maybe_flush(t, extent.into())?;
+            check_bp_dup(t, extent, bp, found)
+        }
+        Some(_) => Ok(()),
+    }
+}
+
+// ── fsck: check_extents_to_backpointers ──────────────────────────────────
+//
+// Backpointers are checked by bucket, not one by one: each bucket's, of its
+// generation, are summed against its alloc key's sector counts. More than
+// it says, and they're checked against what they point to; not what it
+// says, and the bucket goes in ca->bucket_backpointer_mismatch - and
+// _empty, if there are none - for the walk of every extent and btree node
+// pointer that follows, which checks the pointers into those buckets.
+
+/// An alloc key's sector counts, or what its backpointers add up to.
+#[derive(Default, PartialEq)]
+struct BucketSectors {
+    dirty:  u32,
+    cached: u32,
+    stripe: u32,
+}
+
+impl BucketSectors {
+    fn of(a: &c::AllocV4) -> Self {
+        Self { dirty: a.dirty_sectors, cached: a.cached_sectors, stripe: a.stripe_sectors }
+    }
+
+    fn add(&mut self, bp: &c::Backpointer) {
+        use c::bch_data_type as dt;
+        let counter = match c::bch_data_type(bp.data_type.into()) {
+            dt::BCH_DATA_btree | dt::BCH_DATA_user    => &mut self.dirty,
+            dt::BCH_DATA_cached                       => &mut self.cached,
+            dt::BCH_DATA_stripe | dt::BCH_DATA_parity => &mut self.stripe,
+            _ => return,
+        };
+        // as C's: u32s
+        *counter = counter.wrapping_add(bp.bucket_len);
+    }
+
+    fn any_over(&self, a: &Self) -> bool {
+        self.dirty > a.dirty || self.cached > a.cached || self.stripe > a.stripe
+    }
+
+    fn is_empty(&self) -> bool {
+        self.dirty.wrapping_add(self.stripe).wrapping_add(self.cached) == 0
+    }
+}
+
+/// If the backpointers are over, they're checked against what they point to, once
+/// (@checked_bad), and the attempt restarted; if off, the bucket goes in the
+/// bitmaps. Returns whether it did.
+fn check_bucket_backpointer_mismatch(t: &TransAttempt<'_, '_>, alloc_k: BkeySC<'_>,
+                                     mut last_flushed: WbFlush<'_>, checked_bad: &mut c::bpos)
+    -> Result<bool, BchError>
+{
+    use c::bch_data_type as dt;
+
+    let fs = t.fs();
+    let a = alloc_to_v4(alloc_k);
+
+    if matches!(c::bch_data_type(a.data_type.into()), dt::BCH_DATA_sb | dt::BCH_DATA_journal | dt::BCH_DATA_parity) {
+        return Ok(false);
+    }
+
+    let Some(ca) = fs.dev_bucket_tryget_noerror(alloc_k.k.p) else { return Ok(false) };
+    let bp_range = BackpointerPos::bucket_range(&ca, alloc_k.k.p);
+    let before_bucket_gen = fs.version_upgrade_complete().0 <
+        c::bcachefs_metadata_version::bcachefs_metadata_version_backpointer_bucket_gen.0;
+
+    let mut sectors = BucketSectors::default();
+    let mut nr_deletes = 0u32;
+    let mut need_commit = false;
+
+    let mut iter = BtreeIter::new(t, c::btree_id::backpointers, *bp_range.start(), BtreeIterFlags::empty());
+    iter.for_each_max_norestart(t, *bp_range.end(), |_, bp_k| {
+        let Some(bp) = bp_k.arm::<c::Backpointer>() else { return Ok(ControlFlow::Continue(())) };
+        let v = *bp.v();
+
+        if before_bucket_gen && (v.bucket_gen != a.generation || { v.flags } != 0) {
+            backpointer_del(t, c::btree_id::backpointers, bp_k.k.p)?;
+            nr_deletes += 1;
+
+            if nr_deletes > 256 {
+                t.commit(None, CommitFlags::NO_ENOSPC)?;
+                t.trans().write_buffer_flush_sync()?;
+                return Err(t.restart(bch_errcode::BCH_ERR_transaction_restart_write_buffer_flush));
+            }
+
+            need_commit = true;
+            return Ok(ControlFlow::Continue(()));
+        }
+
+        if v.bucket_gen == a.generation {
+            sectors.add(&v);
+        }
+        Ok(ControlFlow::<()>::Continue(()))
+    })?;
+
+    if need_commit {
+        t.commit(None, CommitFlags::NO_ENOSPC)?;
+    }
+
+    let have = BucketSectors::of(&a);
+
+    if sectors.any_over(&have) {
+        if *checked_bad != alloc_k.k.p {
+            *checked_bad = alloc_k.k.p;
+            check_bucket_backpointers_to_extents(t.trans(), &ca, alloc_k.k.p, last_flushed)?;
+            return Err(t.restart(bch_errcode::BCH_ERR_transaction_restart_nested));
+        }
+
+        backpointers_maybe_flush(t, alloc_k, last_flushed.reborrow())?;
+
+        let p = alloc_k.k.p;
+        let mut msg = LogMsg::new(fs);
+        prt!(&mut msg, "backpointer sectors > bucket sectors, but found no bad backpointers\n\
+                        bucket {}:{} data type ", { p.inode }, { p.offset });
+        c::bch_data_type(a.data_type.into()).to_text(&mut msg);
+        prt!(&mut msg, ", counters\n");
+        if sectors.dirty > have.dirty {
+            prt!(&mut msg, "dirty: {} > {}\n", sectors.dirty, have.dirty);
+        }
+        if sectors.cached > have.cached {
+            prt!(&mut msg, "cached: {} > {}\n", sectors.cached, have.cached);
+        }
+        if sectors.stripe > have.stripe {
+            prt!(&mut msg, "stripe: {} > {}\n", sectors.stripe, have.stripe);
+        }
+
+        // as C's: whatever of the bucket it reads
+        let mut iter = BtreeIter::new(t, c::btree_id::backpointers, *bp_range.start(), BtreeIterFlags::empty());
+        let _ = iter.for_each_max_norestart(t, *bp_range.end(), |_, bp_k| {
+            prt!(&mut msg, "{}\n", bp_k.to_text(fs));
+            Ok(ControlFlow::<()>::Continue(()))
+        });
+        crate::warn_on!(true);
+    }
+
+    if sectors == have {
+        return Ok(false);
+    }
+
+    // Post 1.14 upgrade, we assume that backpointers are mostly correct and
+    // a sector count mismatch is probably due to a write buffer race.
+    //
+    // Pre upgrade, we expect all the buckets to be wrong, a write buffer
+    // flush is pointless:
+    if !before_bucket_gen {
+        if c::bch_data_type(a.data_type.into()) == dt::BCH_DATA_btree {
+            t.trans().unlock_long();
+            fs.btree_interior_updates_flush();
+        }
+        backpointers_maybe_flush(t, alloc_k, last_flushed)?;
+    }
+
+    ca.bucket_backpointer_mismatch.set(&ca, alloc_k.k.p.offset)?;
+    if sectors.is_empty() {
+        ca.bucket_backpointer_empty.set(&ca, alloc_k.k.p.offset)?;
+    }
+    Ok(true)
+}
+
+/// Schedules check_extents_to_backpointers - ratelimited from copygc, until 1/128
+/// of the device's buckets are short.
+pub(crate) fn check_one_bucket_backpointer_mismatch(trans: &BtreeTrans<'_>, ca: &c::bch_dev, bucket: u64,
+                                         copygc: bool, mut last_flushed: WbFlush<'_>)
+    -> Result<(), BchError>
+{
+    let fs = ca.fs();
+
+    // Outside the restart loop: after checking a bucket with too many
+    // backpointers against their extents, check_bucket_backpointer_mismatch()
+    // restarts - reset this and it does that forever.
+    let mut checked_bad = POS_MAX;
+    let had_mismatch = lockrestart_do(trans, |t| {
+        // Not BTREE_ITER_cached: scrub calls this once per bucket for a whole
+        // device (bch2_move_data_phys() fills in the gaps between
+        // backpointers), and a cached iterator would leave a key cache entry
+        // behind for every one of them. Uncached still sees a dirty cached key
+        // - alloc is a cached btree, so bch2_btree_iter_flags() gives us
+        // BTREE_ITER_with_key_cache, which consults an existing entry without
+        // creating one.
+        let mut alloc_iter = BtreeIter::new(t, c::btree_id::alloc, pos(ca.dev_idx.into(), bucket),
+                                            BtreeIterFlags::empty());
+        let k = alloc_iter.peek_slot(t)?.expect("a slot always has a key");
+        check_bucket_backpointer_mismatch(t, k, last_flushed.reborrow(), &mut checked_bad)
+    })?;
+
+    if !had_mismatch {
+        return Ok(());
+    }
+
+    let nr = ca.bucket_backpointer_mismatch.nr();
+    let allowed = if copygc { ca.mi.get().nbuckets >> 7 } else { 0 };
+
+    let mut buf = Printbuf::new();
+    log_msg_start(&mut buf, ca.name());
+    prt!(&mut buf, "Detected missing backpointers in bucket {bucket}, now have {nr}/{} with missing\n",
+         { ca.mi.get().nbuckets });
+
+    let flags = if nr < allowed {
+        c::bch_run_recovery_pass_flags::RUN_RECOVERY_PASS_ratelimit
+    } else {
+        c::bch_run_recovery_pass_flags::from_bits_retain(0)
+    };
+    // as C's: the message says whether it's scheduled
+    let _ = passes::run_explicit(fs, &mut buf,
+                                 c::bch_recovery_pass::BCH_RECOVERY_PASS_check_extents_to_backpointers, flags);
+
+    static RATELIMIT: Ratelimit = Ratelimit::new();
+    if !RATELIMIT.suppress(fs, c"bch2_check_bucket_backpointer_mismatch") {
+        print_str(fs, LogLevel::ERR, &mut buf);
+    }
+    Ok(())
+}
+
+/// # Safety
+/// @trans isn't in an attempt; @last_flushed is the caller's.
+#[c_export]
+pub unsafe fn bch2_check_bucket_backpointer_mismatch<'t>(trans: &'t BtreeTrans<'t>, ca: &c::bch_dev,
+                                                         bucket: u64, copygc: bool,
+                                                         last_flushed: *mut c::wb_maybe_flush) -> c_int {
+    let last_flushed = unsafe { WbFlush::from_raw(last_flushed) }.expect("a wb_maybe_flush");
+    ret_to_c(check_one_bucket_backpointer_mismatch(trans, ca, bucket, copygc, last_flushed))
+}
+
+struct ExtentsToBpState {
+    bp_range:     RangeInclusive<c::bpos>,
+    last_flushed: WbMaybeFlush,
+}
+
+/// A bucket with no backpointers has them all put back without looking.
+fn check_extent_to_backpointers(t: &TransAttempt<'_, '_>, s: &mut ExtentsToBpState, btree: c::btree_id,
+                                level: u32, k: BkeySC<'_>) -> Result<(), BchError> {
+    let fs = t.fs();
+    let Some(kp) = k.arm::<Ptrs>() else { return Ok(()) };
+
+    for d in kp.ptrs_decoded(fs) {
+        let mut bp = extent_ptr_to_bp(fs, btree, level, k, &d);
+        let dev = u32::from(d.p.ptr.dev());
+
+        if dev == c::BCH_SB_MEMBER_INVALID {
+            if d.p.has_ec {
+                check_bp_exists(t, kp, &mut bp, s.last_flushed.borrow())?;
+            }
+            continue;
+        }
+
+        let empty = {
+            let rcu = read_lock();
+            let Some(ca) = fs.dev_rcu(dev, &rcu) else { continue };
+
+            if d.p.ptr.cached() != 0 && ca.ptr_stale(&d.p.ptr, &rcu).is_none_or(|s| s != 0) {
+                continue;
+            }
+
+            let b = ca.ptr_bucket(&d.p.ptr);
+            if !ca.bucket_backpointer_mismatch.test(b) {
+                continue;
+            }
+            ca.bucket_backpointer_empty.test(b)
+        };
+
+        if !s.bp_range.contains(&bp.k.p) {
+            continue;
+        }
+
+        if !empty {
+            check_bp_exists(t, kp, &mut bp, s.last_flushed.borrow())?;
+        } else {
+            bucket_backpointer_mod(t, k, &mut bp, true)?;
+        }
+    }
+    Ok(())
+}
+
+/// The root's key is checked a level above the root. Returns the root's level.
+fn check_btree_root_to_backpointers(t: &TransAttempt<'_, '_>, s: &mut ExtentsToBpState, btree: c::btree_id)
+    -> Result<u32, BchError>
+{
+    let fs = t.fs();
+    let root_level = fs.btree_id_root(btree.0).expect("a btree with a root").c.level;
+
+    let mut iter = BtreeIter::new_level(t, btree, POS_MIN, root_level.into(), BtreeIterFlags::empty());
+    let b = iter.peek_node(t)?.expect("a btree's root node");
+
+    if !fs.btree_id_root(b.c.btree_id.into()).is_some_and(|root| core::ptr::eq(root, b)) {
+        return Err(t.restart(bch_errcode::BCH_ERR_transaction_restart_lock_root_race));
+    }
+
+    let level = u32::from(b.c.level);
+    check_extent_to_backpointers(t, s, btree, level + 1, BkeySC::from(b.key_i()))?;
+    Ok(level)
+}
+
+fn check_extents_to_backpointers_pass(fs: &Fs, trans: &BtreeTrans<'_>, s: &mut ExtentsToBpState)
+    -> Result<(), BchError>
+{
+    let progress = Progress::recovery_masks(fs, c"extents_to_backpointers", crate::BTREE_HAS_DATA_PTRS_MASK, !0);
+    // extents btree updates always require a disk res passed in
+    let res = DiskReservation::new(fs);
+
+    for btree in (0..fs.btree_id_nr_alive()).map(c::btree_id) {
+        let depth = if btree.has_data_ptrs() { 0 } else { 1 };
+
+        let mut root_level = 0;
+        commit_do(trans, Some(&res), CommitFlags::NO_ENOSPC, |t| {
+            root_level = check_btree_root_to_backpointers(t, s, btree)?;
+            Ok(())
+        })?;
+
+        for level in (depth..=root_level).rev() {
+            let mut iter = BtreeIter::new_level(trans, btree, POS_MIN, level, BtreeIterFlags::PREFETCH);
+            iter.for_each_commit(trans, Some(&res), CommitFlags::NO_ENOSPC, |t, iter, k| {
+                progress.update(t, iter)?;
+                s.last_flushed.inc();
+                check_extent_to_backpointers(t, s, btree, level, k)
+            })?;
+        }
+    }
+    Ok(())
+}
+
+/// gc marks a bucket holding two types of data `multiple`, and leaves it to
+/// this pass to resolve; once it has, the bucket's backpointers agree on a
+/// type, and that is the bucket's again. They're read from the btree: the
+/// caller flushes the write buffer first.
+fn bucket_multiple_resolved(t: &TransAttempt<'_, '_>, ca: &c::bch_dev, bucket: u64) -> Result<(), BchError> {
+    use c::bch_data_type as dt;
+
+    let fs = t.fs();
+    let bucket = pos(ca.dev_idx.into(), bucket);
+    let mut iter = BtreeIter::new(t, c::btree_id::alloc, bucket, BtreeIterFlags::empty());
+    let a = alloc_to_v4(iter.peek_slot(t)?.expect("a slot always has a key"));
+
+    if c::bch_data_type(a.data_type.into()) != dt::BCH_DATA_multiple {
+        return Ok(());
+    }
+
+    let bp_range = BackpointerPos::bucket_range(ca, bucket);
+    let mut data_type = None;
+    let mut mixed = false;
+    let mut iter = BtreeIter::new(t, c::btree_id::backpointers, *bp_range.start(), BtreeIterFlags::empty());
+    iter.for_each_max_norestart(t, *bp_range.end(), |_, bp_k| {
+        let Some(bp) = bp_k.arm::<c::Backpointer>() else { return Ok(ControlFlow::Continue(())) };
+        if bp.v().bucket_gen != a.generation {
+            return Ok(ControlFlow::Continue(()));
+        }
+
+        let bp_type = c::bch_data_type(bp.v().data_type.into());
+        mixed = data_type.is_some_and(|d| bucket_data_type(d) != bucket_data_type(bp_type));
+        data_type.get_or_insert(bp_type);
+        Ok(if mixed { ControlFlow::Break(()) } else { ControlFlow::Continue(()) })
+    })?;
+
+    let Some(data_type) = data_type.filter(|_| !mixed) else { return Ok(()) };
+
+    let mut new = t.start_alloc_update(bucket, UpdateTriggerFlags::empty())?;
+    let a = new.v_mut();
+    a.data_type = dt::BCH_DATA_free.0 as u8;
+    a.set_data_type(data_type);
+
+    let mut msg = LogMsg::new(fs);
+    prt!(&mut msg, "bucket {}:{}: double allocation resolved, data type multiple -> ",
+         { bucket.inode }, { bucket.offset });
+    c::bch_data_type(a.data_type.into()).to_text(&mut msg);
+    Ok(())
+}
+
+/// Buckets with none don't count - theirs are recreated without looking. A
+/// btree_ptr has no min_key, so might.
+fn backpointer_node_has_missing(fs: &Fs, k: BkeySC<'_>) -> bool {
+    use c::bch_bkey_type as t;
+
+    match k.k.key_type() {
+        t::KEY_TYPE_btree_ptr_v2 => {
+            let rcu = read_lock();
+            let mut p = k.arm::<c::BtreePtrV2>().expect("a btree_ptr_v2").v().min_key;
+
+            while p.inode <= k.k.p.inode && p.inode < u64::from(fs.sb.nr_devices.get()) {
+                if let Some(ca) = fs.dev_rcu(p.inode as u32, &rcu) {
+                    let bucket = BackpointerPos::from_bpos(fs, p).bucket(ca);
+                    let nbuckets = ca.mi.get().nbuckets;
+                    let mismatch = ca.bucket_backpointer_mismatch.words(&rcu);
+                    let empty = ca.bucket_backpointer_empty.words(&rcu);
+
+                    let next = AtomicBitmap::from_words(mismatch)
+                        .next_andnot(AtomicBitmap::from_words(empty),
+                                     bucket.offset.min(nbuckets) as usize, nbuckets as usize);
+
+                    if let Some(next) = next {
+                        let next = pos(bucket.inode, next as u64);
+                        if *BackpointerPos::bucket_range(ca, next).end() <= k.k.p {
+                            return true;
+                        }
+                    }
+                }
+                p = spos(p.inode + 1, 0, 0);
+            }
+            false
+        }
+        t::KEY_TYPE_btree_ptr => true,
+        _ => false,
+    }
+}
+
+fn btree_node_get_and_pin(t: &TransAttempt<'_, '_>, pins: &BtreeCachePins<'_>, k: &BkeyI, btree: c::btree_id,
+                          level: u32) -> Result<(), BchError> {
+    let mut iter = BtreeIter::new_level(t, btree, k.k.p, level, BtreeIterFlags::empty());
+    if let Some(b) = iter.peek_node(t)? {
+        pins.node(b);
+    }
+    Ok(())
+}
+
+/// All prefetched first, so they're read in parallel. Returns where the pinned
+/// range ends.
+fn pin_backpointer_nodes_with_missing(fs: &Fs, trans: &BtreeTrans<'_>, pins: &BtreeCachePins<'_>,
+                                      start: c::bpos) -> Result<c::bpos, BchError> {
+    let node_size = i64::from(fs.opts.btree_node_size);
+    let mut tmp = BkeyBuf::new();
+
+    pins.unpin();
+
+    let mut mem_may_pin = pins.budget() as i64;
+    let mut iter = BtreeIter::new_level(trans, c::btree_id::backpointers, start, 1, BtreeIterFlags::PREFETCH);
+    iter.for_each(trans, |t, iter, k| {
+        if !backpointer_node_has_missing(fs, k) {
+            return Ok(ControlFlow::Continue(()));
+        }
+
+        mem_may_pin -= node_size;
+        if mem_may_pin <= 0 {
+            return Ok(ControlFlow::Break(()));
+        }
+
+        tmp.reassemble(k);
+        iter.prefetch_child(t, tmp.as_ref())?;
+        Ok(ControlFlow::Continue(()))
+    })?;
+
+    let mut end = SPOS_MAX;
+    let mut pinned = SPOS_MAX;
+    let mut mem_may_pin = pins.budget() as i64;
+    let mut iter = BtreeIter::new_level(trans, c::btree_id::backpointers, start, 1, BtreeIterFlags::PREFETCH);
+    iter.for_each(trans, |t, _, k| {
+        if !backpointer_node_has_missing(fs, k) {
+            return Ok(ControlFlow::Continue(()));
+        }
+
+        mem_may_pin -= node_size;
+        if mem_may_pin <= 0 {
+            end = pinned;
+            return Ok(ControlFlow::Break(()));
+        }
+
+        tmp.reassemble(k);
+        btree_node_get_and_pin(t, pins, tmp.as_ref(), c::btree_id::backpointers, 0)?;
+        pinned = tmp.as_ref().k.p;
+        Ok(ControlFlow::Continue(()))
+    })?;
+
+    Ok(end)
+}
+
+fn check_extents_to_backpointers(fs: &Fs) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+    let pins = fs.btree_cache_pins();
+    let mut s = ExtentsToBpState { bp_range: POS_MIN..=SPOS_MAX, last_flushed: WbMaybeFlush::new()? };
+    let mut checked_bad = POS_MAX;
+
+    let mut iter = BtreeIter::new(&trans, c::btree_id::alloc, POS_MIN, BtreeIterFlags::PREFETCH);
+    iter.for_each(&trans, |t, _, k| {
+        passes::cancelled(fs)?;
+        check_bucket_backpointer_mismatch(t, k, s.last_flushed.borrow(), &mut checked_bad)?;
+        Ok(ControlFlow::<()>::Continue(()))
+    })?;
+
+    let (mut nr_buckets, mut nr_mismatches, mut nr_empty) = (0u64, 0u64, 0u64);
+    for ca in fs.members() {
+        nr_buckets += ca.mi.get().nbuckets;
+        nr_mismatches += ca.bucket_backpointer_mismatch.nr();
+        nr_empty += ca.bucket_backpointer_empty.nr();
+    }
+
+    #[cfg(not(CONFIG_BCACHEFS_DEBUG))]
+    if nr_mismatches == 0 {
+        return Ok(());
+    }
+
+    crate::bch_info!(fs, "scanning for missing backpointers in {}/{nr_buckets} buckets, \
+                          {nr_empty} buckets with no backpointers", nr_mismatches.wrapping_sub(nr_empty));
+
+    let ret = (|| {
+        let mut start = POS_MIN;
+        loop {
+            let end = pin_backpointer_nodes_with_missing(fs, &trans, &pins, start)?;
+
+            if start == POS_MIN && end != SPOS_MAX {
+                crate::bch_info!(fs, "bch2_check_extents_to_backpointers(): alloc info does not fit in ram, \
+                                      running in multiple passes with {} nodes per pass",
+                                 pins.budget() / u64::from(fs.opts.btree_node_size));
+            }
+
+            if start != POS_MIN || end != SPOS_MAX {
+                crate::bch_verbose!(fs, "check_extents_to_backpointers(): {start}-{end}");
+            }
+
+            s.bp_range = start..=end;
+            check_extents_to_backpointers_pass(fs, &trans, &mut s)?;
+
+            if end == SPOS_MAX {
+                break;
+            }
+            start = end.successor();
+        }
+
+        trans.write_buffer_flush_sync()?;
+        for ca in fs.members() {
+            for b in (0..ca.mi.get().nbuckets).filter(|&b| ca.bucket_backpointer_mismatch.test(b)) {
+                commit_do(&trans, None, CommitFlags::NO_ENOSPC, |t| bucket_multiple_resolved(t, &ca, b))?;
+            }
+        }
+        Ok(())
+    })();
+
+    for ca in fs.members() {
+        ca.bucket_backpointer_mismatch.free();
+        ca.bucket_backpointer_empty.free();
+    }
+    ret
+}
+
+crate::recovery_pass!(bch2_check_extents_to_backpointers => check_extents_to_backpointers);
+
+// ── fsck: check_backpointers_to_extents ──────────────────────────────────
+
+fn check_one_backpointer(t: &TransAttempt<'_, '_>, range: &RangeInclusive<c::bbpos>,
+                         bp: BkeySC<'_, c::Backpointer>, last_flushed: WbFlush<'_>)
+    -> Result<(), BchError>
+{
+    if !range.contains(&bp.v().target()) {
+        return Ok(());
+    }
+
+    let mut iter = BtreeIter::uninit();
+    match get_key(t, bp, &mut iter, BtreeIterFlags::empty(), Some(last_flushed), true) {
+        Err(e) if e.matches(bch_errcode::BCH_ERR_backpointer_to_overwritten_btree_node) => Ok(()),
+        r => r.map(|_| ()),
+    }
+}
+
+/// Inside the caller's attempt: a restart is the caller's.
+fn check_bucket_backpointers_to_extents(trans: &BtreeTrans<'_>, ca: &c::bch_dev, bucket: c::bpos,
+                                        last_flushed: WbFlush<'_>) -> Result<(), BchError> {
+    let restart_count = trans.restart_count();
+    let range = BackpointerPos::bucket_range(ca, bucket);
+
+    BpScanIter::new(c::btree_id::backpointers, *range.start(), None)
+        .for_each(trans, *range.end(), last_flushed, |t, bp, last_flushed| {
+            check_one_backpointer(t, &(c::bbpos::MIN..=c::bbpos::MAX), bp, last_flushed)
+        })?;
+
+    // make sure bad backpointers that were deleted are visible
+    trans.write_buffer_flush_sync()?;
+    if trans.restart_count() != restart_count {
+        return Err(BchError::from(bch_errcode::BCH_ERR_transaction_restart_nested));
+    }
+    Ok(())
+}
+
+fn check_backpointers_to_extents_pass(fs: &Fs, trans: &BtreeTrans<'_>, range: RangeInclusive<c::bbpos>)
+    -> Result<(), BchError>
+{
+    let mut last_flushed = WbMaybeFlush::new()?;
+    let btrees = [c::btree_id::backpointers, c::btree_id::stripe_backpointers];
+    let progress = Progress::recovery(fs, c"backpointers_to_extents", &btrees, &[]);
+
+    for btree in btrees {
+        BpScanIter::new(btree, POS_MIN, Some(&progress))
+            .for_each(trans, POS_MAX, last_flushed.borrow(), |t, bp, last_flushed| {
+                check_one_backpointer(t, &range, bp, last_flushed)
+            })?;
+    }
+    Ok(())
+}
+
+fn check_backpointers_to_extents(fs: &Fs) -> Result<(), BchError> {
+    let trans = crate::btree_trans!(fs);
+    let pins = fs.btree_cache_pins();
+    let leaves = 1 << c::btree_id::extents.0 | 1 << c::btree_id::reflink.0;
+    let mut start = c::bbpos::MIN;
+
+    loop {
+        let end = pins.pin(&trans, leaves, !0, start..=c::bbpos::MAX)?;
+
+        if start == c::bbpos::MIN && end != c::bbpos::MAX {
+            crate::bch_verbose!(fs, "bch2_check_backpointers_to_extents(): extents do not fit in ram, \
+                                     running in multiple passes with {} nodes per pass",
+                                pins.budget() / u64::from(fs.opts.btree_node_size));
+        }
+
+        if start != c::bbpos::MIN || end != c::bbpos::MAX {
+            crate::bch_verbose!(fs, "check_backpointers_to_extents(): {start}-{end}");
+        }
+
+        check_backpointers_to_extents_pass(fs, &trans, start..=end)?;
+
+        if end == c::bbpos::MAX {
+            return Ok(());
+        }
+        start = end.successor();
+    }
+}
+
+crate::recovery_pass!(bch2_check_backpointers_to_extents => check_backpointers_to_extents);
+
+// ── Bucket bitmaps ───────────────────────────────────────────────────────
+
+impl c::bucket_bitmap {
+    pub fn nr(&self) -> u64 {
+        self.bits.nr.get()
+    }
+
+    /// Empty if it isn't allocated.
+    pub fn words<'a>(&'a self, rcu: &'a ReadGuard) -> &'a [AtomicULong] {
+        self.bits.buckets.read(rcu)
+    }
+
+    pub fn test(&self, b: u64) -> bool {
+        self.bits.buckets.with(|w| AtomicBitmap::from_words(w).test(b as usize))
+    }
+
+    /// The first allocates the bitmap.
+    pub fn set(&self, ca: &c::bch_dev, b: u64) -> Result<(), BchError> {
+        let mut l = self.bits.lock();
+        let w = l.published();
+
+        if w.buckets.with(|words| words.is_empty()) {
+            w.buckets.rebuild(bits_to_longs(ca.mi.get().nbuckets as usize), |_| ())
+                .or_else(|_| ca.fs().throw(bch_errcode::BCH_ERR_ENOMEM_backpointer_mismatches_bitmap))?;
+        }
+
+        if !w.buckets.with(|words| AtomicBitmap::from_words(words).test_and_set(b as usize)) {
+            *w.nr.place() += 1;
+        }
+        Ok(())
+    }
+
+    /// Only if it's allocated: a copy, the old words freed after a grace period.
+    pub fn resize(&self, ca: &c::bch_dev, nbuckets: u64) -> Result<(), BchError> {
+        let mut l = self.bits.lock();
+        let w = l.published();
+
+        if w.buckets.with(|old| old.is_empty()) {
+            return Ok(());
+        }
+
+        w.buckets.rebuild(bits_to_longs(nbuckets as usize), |new| {
+            w.buckets.with(|old| {
+                for (n, o) in new.iter_mut().zip(old) {
+                    *n.get_mut() = o.load(Ordering::Relaxed);
+                }
+            })
+        })
+        .or_else(|_| ca.fs().throw(bch_errcode::BCH_ERR_ENOMEM_backpointer_mismatches_bitmap))
+    }
+
+    /// The words are freed after a grace period.
+    pub fn free(&self) {
+        let mut l = self.bits.lock();
+        let w = l.published();
+
+        w.buckets.clear();
+        w.nr.set(0);
+    }
+}
+
+#[c_export]
+pub fn bch2_bucket_bitmap_free(b: &c::bucket_bitmap) {
+    b.free()
+}
