+// SPDX-License-Identifier: GPL-2.0
+
+//! rust_types_gen: writes the C of the types defined in Rust that C shares.
+//!
+//!   rust_types_gen RECORDS SRC OUT_DIR [ROOT]
+//!
+//! RECORDS is the .discard.bch_cstruct section of the fs crate's target
+//! object, as objcopy -O binary extracts it - see lib.rs for what's in it.
+//! Each source file's records, in order, are a header in OUT_DIR, named for
+//! the file's path under SRC, the crate's source root: foo/types.rs gives
+//! foo/types_gen.h, foo/bar_types.rs foo/bar_gen.h - and foo/bar.rs's, what
+//! C calls of the Rust that is bar.c (#[c_export]), follow bar_types.rs's in
+//! foo/bar_gen.h. Run from where rustc ran: a record's file is file!(),
+//! which is relative to that - or, if rustc remapped source paths
+//! (--remap-path-prefix, as kernels since 7.0 build with), relative to ROOT,
+//! the kernel's srcroot. A Rust-only field is opaque storage of its
+//! size and alignment; after the definitions come _Static_asserts of the
+//! Rust layout, so a C declaration that doesn't match its Rust type fails
+//! the C build, naming the field - and of the ioctl numbers, which C and
+//! Rust each compute.
+//!
+//! The records are from the target build, with its configuration: the C is
+//! that configuration's, #[cfg] already resolved.
+//!
+//! A host program of its own, with no dependencies: built and run before the
+//! C, on any build host.
+
+use std::collections::BTreeMap;
+use std::fmt::Write as _;
+use std::process::exit;
+
+include!("cstruct.rs");
+
+const HEADER: &str = "/* SPDX-License-Identifier: GPL-2.0 */\n";
+
+const RECORD_MAGIC: &[u8; 4] = b"CSR1";
+
+/// One record: see lib.rs.
+struct Record {
+    file:   String,
+    line:   u32,
+    text:   String,
+    nums:   Vec<u64>,
+}
+
+/// A struct's layout, from its record's numbers.
+struct Layout {
+    size:   u64,
+    align:  u64,
+    /// Each field's offset, size and alignment, in order.
+    fields: Vec<(u64, u64, u64)>,
+    /// Each #[c_lock] field's lock size, and the offsets in its Lock of what
+    /// it protects and what it publishes, in order.
+    locks:  Vec<(u64, u64, u64)>,
+}
+
+fn records(mut b: &[u8]) -> Result<Vec<Record>, String> {
+    fn u32_at(b: &[u8], at: usize) -> Result<u32, String> {
+        b.get(at..at + 4)
+            .map(|s| u32::from_le_bytes(s.try_into().unwrap()))
+            .ok_or_else(|| "record truncated".to_string())
+    }
+    fn str_at(b: &[u8], at: &mut usize) -> Result<String, String> {
+        let len = u32_at(b, *at)? as usize;
+        let s = b.get(*at + 4..*at + 4 + len).ok_or("record truncated")?;
+        *at += 4 + len;
+        String::from_utf8(s.to_vec()).map_err(|_| "record has a string that isn't UTF-8".to_string())
+    }
+
+    let mut out = Vec::new();
+    loop {
+        // The compiler may align each record's static: padding is zeroes.
+        while b.first() == Some(&0) {
+            b = &b[1..];
+        }
+        if b.is_empty() {
+            return Ok(out);
+        }
+        if !b.starts_with(RECORD_MAGIC) {
+            return Err(format!("record {}: bad magic", out.len()));
+        }
+        let len = u32_at(b, 4)? as usize;
+        let r = b.get(..len).ok_or("record truncated")?;
+        let line = u32_at(r, 8)?;
+        let mut at = 12;
+        let file = str_at(r, &mut at)?;
+        let text = str_at(r, &mut at)?;
+        let n = u32_at(r, at)? as usize;
+        at += 4;
+        let nums = (0..n)
+            .map(|i| r.get(at + 8 * i..at + 8 * i + 8).map(|s| u64::from_le_bytes(s.try_into().unwrap())))
+            .collect::<Option<Vec<_>>>()
+            .ok_or("record truncated")?;
+        if at + 8 * n != len {
+            return Err(format!("{file}:{line}: record length doesn't match its contents"));
+        }
+        out.push(Record { file, line, text, nums });
+        b = &b[len..];
+    }
+}
+
+/// The header for source file @file, under @src: foo/bar_types.rs - foo/bar.h's
+/// types and what Rust calls of it - is foo/bar_gen.h, and foo/bar.rs - what
+/// C calls of Rust - too, as is foo/bar_c_export.rs, bar.rs's wrappers for C;
+/// foo/types.rs is foo/types_gen.h.
+///
+/// @file is where rustc ran from - or, relative, under @root, if there's one:
+/// what rustc remapped the source paths to be relative to.
+fn gen_header(src: &std::path::Path, root: Option<&std::path::Path>, file: &str) -> Result<String, String> {
+    let path = std::fs::canonicalize(file)
+        .or_else(|e| match root {
+            Some(root) if std::path::Path::new(file).is_relative() => std::fs::canonicalize(root.join(file)),
+            _ => Err(e),
+        })
+        .map_err(|e| format!("{file}: {e} - rust_types_gen runs from where rustc did, \
+                              or is given the root rustc remaps source paths to"))?;
+    let rel = path.strip_prefix(src)
+        .map_err(|_| format!("{file} isn't under {}", src.display()))?;
+    let rel = rel.to_str().ok_or_else(|| format!("{file}: not UTF-8"))?;
+    let stem = rel.trim_end_matches(".rs");
+    let stem = stem.strip_suffix("_types")
+        .or_else(|| stem.strip_suffix("_c_export"))
+        .unwrap_or(stem);
+    Ok(stem.to_string() + "_gen.h")
+}
+
+/// The structs and unions @c, verbatim C, defines - `struct NAME {` or `union
+/// NAME {` opening a line - as their names and C types: what a Rust type of
+/// the name, opaque, is to a prototype.
+fn verbatim_types(c: &str) -> Vec<(String, String)> {
+    c.lines()
+        .filter_map(|l| {
+            let l = l.trim();
+            let (kind, rest) = l.split_once(' ')?;
+            let name = rest.strip_suffix('{')?.trim();
+            (matches!(kind, "struct" | "union") &&
+             !name.is_empty() && name.chars().all(|ch| ch.is_alphanumeric() || ch == '_'))
+                .then(|| (name.to_string(), format!("{kind} {name}")))
+        })
+        .collect()
+}
+
+/// The typedefs @c's DEFINE_DARRAY*()s make - util/darray.h:
+/// DEFINE_DARRAY(foo) and the like are darray_foo, DEFINE_DARRAY_NAMED(name,
+/// ...) name.
+fn darray_typedefs(c: &str) -> Vec<String> {
+    let mut out = Vec::new();
+    for (i, _) in c.match_indices("DEFINE_DARRAY") {
+        let rest = &c[i + "DEFINE_DARRAY".len()..];
+        let Some(open) = rest.find('(') else { continue };
+        let variant = &rest[..open];
+        let arg = rest[open + 1..].split(|ch: char| ch == ',' || ch == ')').next().unwrap_or("").trim();
+        if arg.is_empty() || !arg.chars().all(|ch| ch.is_alphanumeric() || ch == '_') {
+            continue;
+        }
+        match variant {
+            "_NAMED" | "_NAMED_FREE_ITEM" => out.push(arg.to_string()),
+            "" | "_PREALLOCATED" | "_FREE_ITEM" => out.push(format!("darray_{arg}")),
+            _ => {}
+        }
+    }
+    out
+}
+
+/// The type a record defines, and the types it holds by value - the ones C
+/// must see defined first. A pointer needs only a declaration.
+fn defines_and_holds(r: &Record) -> (Option<String>, Vec<String>) {
+    // `c::foo`, `[foo; N]` -> foo; a pointer or reference -> nothing
+    fn held(ty: &str) -> Option<String> {
+        let mut t = ty.trim();
+        if t.starts_with('*') || t.starts_with('&') {
+            return None;
+        }
+        while let Some(inner) = t.strip_prefix('[').and_then(|s| s.rsplit_once(';')).map(|(e, _)| e.trim()) {
+            t = inner;
+        }
+        let t = t.rsplit("::").next().unwrap_or(t).trim();
+        t.chars().all(|ch| ch.is_alphanumeric() || ch == '_').then(|| t.to_string())
+    }
+    match parse_items(&r.text).ok().and_then(|mut items| items.pop()) {
+        Some(CItem::Struct(def)) =>
+            (Some(def.name.clone()), def.fields.iter().filter_map(|f| held(&f.ty)).collect()),
+        Some(CItem::Typedef(t)) => (Some(t.name.clone()), held(&t.ty).into_iter().collect()),
+        Some(CItem::Bitfield(b)) => (Some(b.name.clone()), Vec::new()),
+        Some(CItem::TaggedUnion(tu)) => (Some(tu.name.clone()),
+            tu.arms.iter().map(|a| a.ty.as_str()).chain(tu.pad.as_deref()).filter_map(held).collect()),
+        _ => (None, Vec::new()),
+    }
+}
+
+/// @rs, in line order, reordered so a type comes after the types of this file
+/// it holds by value: a nested definition (nestify, a tagged_union!'s arms)
+/// is on a later line than what holds it, or the same one - a macro's
+/// expansion, all at its invocation. Among records of one line, the ones
+/// nothing else there holds go first, each laying out what it holds in its
+/// own order, depth first: arm types in arm order, nested types in field
+/// order - not in whatever order rustc emitted them, which isn't the same
+/// from one build to the next; the rest of a line's, by their text. Records
+/// on lines of their own keep line order. A cycle is left as it is, for C
+/// to complain.
+fn in_dependency_order(rs: Vec<&Record>) -> Vec<&Record> {
+    let info: Vec<_> = rs.iter().map(|r| defines_and_holds(r)).collect();
+    let by_name: BTreeMap<&str, usize> = info.iter().enumerate()
+        .filter_map(|(i, (d, _))| d.as_deref().map(|d| (d, i)))
+        .collect();
+    let held_on_its_line = |i: usize| info[i].0.as_deref().is_some_and(|d| {
+        info.iter().enumerate().any(|(j, (_, holds))| j != i && rs[j].line == rs[i].line &&
+                                                      holds.iter().any(|h| h == d))
+    });
+    let mut order: Vec<usize> = (0..rs.len()).collect();
+    order.sort_by(|&i, &j| (rs[i].line, held_on_its_line(i), &rs[i].text)
+                            .cmp(&(rs[j].line, held_on_its_line(j), &rs[j].text)));
+
+    fn visit(i: usize, info: &[(Option<String>, Vec<String>)], by_name: &BTreeMap<&str, usize>,
+             visited: &mut [bool], out: &mut Vec<usize>) {
+        if std::mem::replace(&mut visited[i], true) {
+            return;
+        }
+        for h in &info[i].1 {
+            if let Some(&j) = by_name.get(h.as_str()) {
+                visit(j, info, by_name, visited, out);
+            }
+        }
+        out.push(i);
+    }
+    let mut visited = vec![false; rs.len()];
+    let mut out = Vec::with_capacity(rs.len());
+    for i in order {
+        visit(i, &info, &by_name, &mut visited, &mut out);
+    }
+    out.into_iter().map(|i| rs[i]).collect()
+}
+
+/// Include guard for @header: foo/types_gen.h -> _BCACHEFS_FOO_TYPES_GEN_H.
+fn guard(header: &str) -> String {
+    let mut g = String::from("_BCACHEFS_");
+    g.extend(header.chars().map(|c| if c.is_alphanumeric() { c.to_ascii_uppercase() } else { '_' }));
+    g
+}
+
+/// The layout of struct @def from @nums, checked against its fields.
+fn layout(def: &CStructDef, nums: &[u64]) -> Result<Layout, String> {
+    let n = def.fields.len();
+    let locks = def.fields.iter().filter(|f| f.lock.is_some()).count();
+    match nums {
+        [size, align, rest @ ..] if rest.len() == 3 * (n + locks) => Ok(Layout {
+            size:   *size,
+            align:  *align,
+            fields: rest[..3 * n].chunks(3).map(|f| (f[0], f[1], f[2])).collect(),
+            locks:  rest[3 * n..].chunks(3).map(|l| (l[0], l[1], l[2])).collect(),
+        }),
+        _ => Err(format!("{}: record has {} numbers for {n} fields, {locks} locks", def.name, nums.len())),
+    }
+}
+
+/// Check that C places the members of bitfield type @bf where Rust does: the
+/// offset asserts can't see inside the storage word. Rust has the word at
+/// byte @offset, members packed into it one after another, least significant
+/// first. C starts from the end of the field before, byte @prev_end, and - in
+/// a struct that isn't @packed - aligns a plain member to its type, and starts
+/// a new unit of a bitfield member's type rather than let it straddle one.
+/// Little-endian bitfields only: big-endian C declares the members reversed,
+/// to put each at the same bits of the same word. An enum member's unit is
+/// the enum's size, from @enums - the C enum's too, which the headers assert.
+fn check_bitfield(bf: &CBitfieldDef, offset: u64, prev_end: u64, packed: bool,
+                  enums: &BTreeMap<String, u64>) -> Result<(), String> {
+    let storage = int_bits(&bf.storage)
+        .ok_or_else(|| format!("{}: storage {} isn't an integer", bf.name, bf.storage))? as u64;
+    let align_up = |pos: u64, unit: u64| pos.div_ceil(unit) * unit;
+
+    let mut rust = offset * 8;
+    let mut c = prev_end * 8;
+    for (name, ty, width) in &bf.fields {
+        let width = *width as u64;
+        // padding: Rust's alone - C skips by itself, which the next
+        // member's position checks
+        if is_bitfield_pad(name) {
+            rust += width;
+            continue;
+        }
+        let ty = bf.c_type(ty);
+        let unit = unit_bits(ty).map(u64::from)
+            .or_else(|| ty.trim().rsplit("::").next().and_then(|e| enums.get(e)).map(|size| size * 8))
+            .ok_or_else(|| format!("{}.{name}: {ty} isn't an integer, bool or enum", bf.name))?;
+        if !packed && (width == unit || c / unit != (c + width - 1) / unit) {
+            c = align_up(c, unit);
+        }
+        if c != rust {
+            return Err(format!("{}.{name}: C puts it at bit {c}, Rust at bit {rust} - the word must be \
+                                where C's member types put it", bf.name));
+        }
+        c += width;
+        rust += width;
+    }
+    if rust != (offset * 8) + storage {
+        return Err(format!("{}: members are {} bits, storage {}", bf.name, rust - offset * 8, bf.storage));
+    }
+    Ok(())
+}
+
+/// The asserts of @def's fields, as members of C type @ty at offset @base in
+/// it, named @prefix + name: a type written in its field's place has no name
+/// of its own, so its fields are asserted through @ty - an anonymous member's
+/// as @ty's own, a #[c_inline] or #[c_struct_group] member's as member.field,
+/// the first element's of an array of them, member[0].field.
+fn field_asserts(out: &mut String, ty: &str, def: &CStructDef, base: u64, prefix: &str,
+                 items: &[CItem], layouts: &BTreeMap<String, Layout>) {
+    let mut locks = layouts[&def.name].locks.iter();
+    for (f, (offset, size, _)) in def.fields.iter().zip(&layouts[&def.name].fields) {
+        let offset = base + offset;
+        let name = format!("{prefix}{}", f.name);
+        if let Some(decl) = &f.lock {
+            let &(lock_size, protected, published) = locks.next().expect("a lock's numbers for each #[c_lock]");
+            let lock = format!("{prefix}{}", lock_name(decl).expect("checked when parsed"));
+            member_asserts(out, ty, &lock, offset, lock_size);
+            let [g, p] = lock_defs(f, items).unwrap_or_else(|e| die(format!("{}.{e}", def.name)));
+            for (inner, at) in [(g, protected), (p, published)] {
+                if let Some(inner) = inner {
+                    field_asserts(out, ty, inner, offset + at, prefix, items, layouts);
+                }
+            }
+            continue;
+        }
+        if let Some(inner) = in_place_def(f, items) {
+            if f.inline || f.group {
+                member_asserts(out, ty, &name, offset, *size);
+                let first = "[0]".repeat(array_of(&f.ty).map_or(0, |(_, dims)| dims.matches('[').count()));
+                field_asserts(out, ty, inner, offset, &format!("{name}{first}."), items, layouts);
+            } else {
+                field_asserts(out, ty, inner, offset, prefix, items, layouts);
+            }
+            continue;
+        }
+        if f.anon || f.bitfield {
+            continue;
+        }
+        member_asserts(out, ty, &name, offset, *size);
+    }
+}
+
+/// The asserts of member @name of C type @ty: its offset, and its size.
+fn member_asserts(out: &mut String, ty: &str, name: &str, offset: u64, size: u64) {
+    let _ = writeln!(out, "_Static_assert(__builtin_offsetof({ty}, {name}) == {offset}, \
+                           \"{ty}.{name}: offset differs from Rust's\");");
+    // Zero-sized: a flexible array, which C can't take the size of.
+    if size != 0 {
+        let _ = writeln!(out, "_Static_assert(sizeof((({ty} *) 0)->{name}) == {size}, \
+                               \"{ty}.{name}: size differs from Rust's\");");
+    }
+}
+
+/// The header for one source file's records, in order. @structs: every
+/// struct, union and typedef recorded, any file's - Rust name to C type - for
+/// the fields whose type is one.
+fn file_h(header: &str, records: &[&Record], structs: &BTreeMap<String, String>,
+          enums: &BTreeMap<String, u64>)
+    -> Result<String, String>
+{
+    let mut items = Vec::new();
+    let mut layouts = BTreeMap::new();
+    let mut enum_sizes = Vec::new();
+    let mut sames = Vec::new();
+    let mut rcu_arrays = BTreeMap::new();
+    let mut opcodes = Vec::new();
+    for r in records {
+        let at = |e: String| format!("{}:{}: {e}", r.file, r.line);
+        let mut parsed = parse_items(&r.text).map_err(at)?;
+        // A c_const! is one record: its constants, and their values in order.
+        if !parsed.is_empty() && parsed.iter().all(|i| matches!(i, CItem::Const(_))) {
+            if parsed.len() != r.nums.len() {
+                return Err(at(format!("{} values for {} constants", r.nums.len(), parsed.len())));
+            }
+            for (mut item, &v) in parsed.into_iter().zip(&r.nums) {
+                if let CItem::Const(c) = &mut item {
+                    c.value = if rust_int_signed(&c.ty) { format!("{}", v as i64) } else { format!("{v}") };
+                }
+                items.push(item);
+            }
+            continue;
+        }
+        let mut item = match (parsed.pop(), parsed.is_empty()) {
+            (Some(item), true) => item,
+            _ => return Err(at("a record is one item".into())),
+        };
+        match &mut item {
+            CItem::Struct(def) => {
+                layouts.insert(def.name.clone(), layout(def, &r.nums).map_err(at)?);
+            }
+            // The values, as rustc evaluated them, for the expressions.
+            CItem::Enum(e) => {
+                let [size, align, values @ ..] = r.nums.as_slice() else {
+                    return Err(at("an enum's record has its size, alignment and values".into()));
+                };
+                if values.len() != e.variants.len() {
+                    return Err(at(format!("{} values for {} variants", values.len(), e.variants.len())));
+                }
+                let signed = e.repr.starts_with('i');
+                for (variant, &v) in e.variants.iter_mut().zip(values) {
+                    variant.value = Some(match (e.kind, signed) {
+                        (CEnumKind::Flags, _) => format!("{v:#x}"),
+                        (_, true) => format!("{}", v as i64),
+                        (_, false) => format!("{v}"),
+                    });
+                }
+                if let Some(name) = &e.name {
+                    enum_sizes.push((name.clone(), *size, *align));
+                }
+            }
+            // Each opcode as Rust made it - none in a build that has no
+            // Rust ones (see fs/util/ioctl.rs).
+            CItem::Ioctl(io) => match r.nums.len() {
+                0 => {}
+                n if n == io.entries.len() =>
+                    opcodes.extend(io.entries.iter().map(|e| e.name.clone()).zip(r.nums.iter().copied())),
+                n => return Err(at(format!("{n} opcodes for {} ioctls", io.entries.len()))),
+            },
+            CItem::RcuArray(a) => {
+                let &[nr, head, tail] = r.nums.as_slice() else {
+                    return Err(at("a c_rcu_array!'s record has its nr, header and elements' offsets".into()));
+                };
+                rcu_arrays.insert(a.alias.clone(), [nr, head, tail]);
+            }
+            CItem::Same(s) => {
+                let [size, align, offsets @ ..] = r.nums.as_slice() else {
+                    return Err(at("a c_same!'s record has the type's size and alignment".into()));
+                };
+                if offsets.len() != s.fields.len() {
+                    return Err(at(format!("{} offsets for {} fields", offsets.len(), s.fields.len())));
+                }
+                sames.push((s.c_type.clone(), *size, *align,
+                            s.fields.iter().cloned().zip(offsets.iter().copied()).collect::<Vec<_>>()));
+            }
+            // The Rust layout C's must have: the tag at 0, every arm at the
+            // payload offset - as for a c_same!.
+            CItem::TaggedUnion(tu) => {
+                let [size, align, payload] = r.nums.as_slice() else {
+                    return Err(at("a tagged_union!'s record has its size, alignment and payload offset".into()));
+                };
+                let mut offsets = vec![(c_ident(&tu.tag_field), 0)];
+                offsets.extend(tu.arms.iter().map(|a| (c_ident(&a.name), *payload)));
+                sames.push((tu.c_type(), *size, *align, offsets));
+            }
+            _ => {}
+        }
+        push_item(&mut items, item);
+    }
+
+    // Every misplaced bitfield, not just the first.
+    let mut misplaced = Vec::new();
+    for item in &items {
+        let CItem::Struct(def) = item else { continue };
+        let fields = &layouts[&def.name].fields;
+        for (i, (f, (offset, _, _))) in def.fields.iter().zip(fields).enumerate() {
+            if !f.bitfield {
+                continue;
+            }
+            let prev_end = i.checked_sub(1).map_or(0, |p| fields[p].0 + fields[p].1);
+            let bf = items.iter().find_map(|i| match i {
+                CItem::Bitfield(b) if b.name == bitfield_type(&f.ty) => Some(b),
+                _ => None,
+            }).ok_or_else(|| format!("{}.{}: #[c_bitfield], but {} isn't a #[bitfield] type in {header}",
+                                     def.name, f.name, f.ty))?;
+            if let Err(e) = check_bitfield(bf, *offset, prev_end, def.repr.packed.is_some(), enums) {
+                misplaced.push(format!("{}.{}: {e}", def.name, f.name));
+            }
+        }
+    }
+    if !misplaced.is_empty() {
+        return Err(misplaced.join("\n"));
+    }
+
+    // A field whose type is a recorded struct is that struct; any other
+    // without a C rendering is Rust's alone: opaque storage, aligned as Rust
+    // aligns it - up to the struct's packing.
+    let opaque = |def: &CStructDef, f: &CFieldDef| -> Result<String, String> {
+        if let Some(c_type) = structs.get(f.ty.trim()) {
+            return Ok(format!("{c_type}\t{}", f.name));
+        }
+        let i = def.fields.iter().position(|x| x.name == f.name).unwrap();
+        let (_, size, align) = layouts[&def.name].fields[i];
+        let align = match def.repr.packed.as_deref() {
+            Some(p) => align.min(p.parse().map_err(|_| format!("packed({p}) isn't a number"))?),
+            None => align,
+        };
+        Ok(if align > 1 {
+            format!("unsigned char\t{}[{size}] __aligned({align})", f.name)
+        } else {
+            format!("unsigned char\t{}[{size}]", f.name)
+        })
+    };
+    // util/darray.h's own darray_foos are typedefs too (types/lib.rs's
+    // darrays has them for Rust)
+    let kind = |name: &str| structs.get(name).cloned()
+        .or_else(|| name.starts_with("darray_").then(|| name.to_string()));
+    let body = emit_items(&items, &opaque, &kind)?;
+
+    // The Rust layout, which C must have: every field C names, and each
+    // enum's size - C picks an enum's type from its values.
+    let mut asserts = String::new();
+    for (name, size, align) in &enum_sizes {
+        let _ = write!(asserts, "\n_Static_assert(sizeof(enum {name}) == {size}, \"enum {name}: size differs from Rust's\");\n\
+                                 _Static_assert(_Alignof(enum {name}) == {align}, \"enum {name}: alignment differs from Rust's\");\n");
+    }
+    // C types defined by C that are Rust types: C's must be the Rust type's.
+    for (ty, size, align, fields) in &sames {
+        let _ = write!(asserts, "\n_Static_assert(sizeof({ty}) == {size}, \"{ty}: size differs from Rust's\");\n\
+                                 _Static_assert(_Alignof({ty}) == {align}, \"{ty}: alignment differs from Rust's\");\n");
+        for (f, offset) in fields {
+            let _ = writeln!(asserts, "_Static_assert(__builtin_offsetof({ty}, {f}) == {offset}, \
+                                       \"{ty}.{f}: offset differs from Rust's\");");
+        }
+    }
+    // A type written in its field's place has no name in C: its fields are
+    // asserted through the struct it's in.
+    let in_place = in_place_types(&items);
+    for item in &items {
+        let CItem::Struct(def) = item else { continue };
+        if in_place.contains(&def.name.as_str()) {
+            continue;
+        }
+        let l = &layouts[&def.name];
+        let ty = def.c_type();
+        let _ = write!(asserts, "\n_Static_assert(sizeof({ty}) == {}, \"{ty}: size differs from Rust's\");\n\
+                                 _Static_assert(_Alignof({ty}) == {}, \"{ty}: alignment differs from Rust's\");\n",
+                       l.size, l.align);
+        field_asserts(&mut asserts, &ty, def, 0, "", &items, &layouts);
+    }
+    // A c_rcu_array!'s struct: where RcuArray's buffer has nr, the header's
+    // fields and the elements.
+    for item in &items {
+        let CItem::RcuArray(a) = item else { continue };
+        let [nr, head, tail] = rcu_arrays[&a.alias];
+        let ty = format!("struct {}", a.c_name);
+        let mut offsets = vec![(a.nr.clone(), nr)];
+        if let Some(def) = rcu_array_head(a, &items) {
+            for (f, (offset, _, _)) in def.fields.iter().zip(&layouts[&def.name].fields) {
+                offsets.push((c_ident(&f.name), head + offset));
+            }
+        }
+        offsets.push((a.elems.clone(), tail));
+        asserts.push('\n');
+        for (f, offset) in offsets {
+            let _ = writeln!(asserts, "_Static_assert(__builtin_offsetof({ty}, {f}) == {offset}, \
+                                       \"{ty}.{f}: offset differs from RcuArray's\");");
+        }
+    }
+    // The ioctl numbers: C's _IO*() and Rust's, each from the target's own
+    // constants, must make the same one.
+    if !opcodes.is_empty() {
+        asserts.push('\n');
+    }
+    for (name, op) in &opcodes {
+        let _ = writeln!(asserts, "_Static_assert({name} == {op:#x}U, \"{name}: differs from Rust's opcode\");");
+    }
+
+    let g = guard(header);
+    Ok(format!("{HEADER}/* Generated by rust_types_gen from the fs crate's records: do not edit. */\n\
+                #ifndef {g}\n#define {g}\n{body}{asserts}\n#endif /* {g} */\n"))
+}
+
+/// Write @contents to @path unless it's already there: a rerun doesn't
+/// rebuild every C object.
+fn write_if_changed(path: &std::path::Path, contents: &str) -> std::io::Result<()> {
+    if std::fs::read_to_string(path).is_ok_and(|old| old == contents) {
+        return Ok(());
+    }
+    if let Some(dir) = path.parent() {
+        std::fs::create_dir_all(dir)?;
+    }
+    std::fs::write(path, contents)
+}
+
+fn die(msg: String) -> ! {
+    eprintln!("rust_types_gen: {msg}");
+    exit(1);
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+
+    match args.as_slice() {
+        [_, records_file, src, out_dir, root @ ..] if root.len() <= 1 => {
+            let root = root.first().map(std::path::Path::new);
+            let b = std::fs::read(records_file).unwrap_or_else(|e| die(format!("reading {records_file}: {e}")));
+            let recs = records(&b).unwrap_or_else(|e| die(format!("{records_file}: {e}")));
+            let src = std::fs::canonicalize(src).unwrap_or_else(|e| die(format!("{src}: {e}")));
+
+            let mut files: BTreeMap<&str, Vec<&Record>> = BTreeMap::new();
+            let mut structs = BTreeMap::new();
+            let mut enums = BTreeMap::new();
+            for r in &recs {
+                files.entry(&r.file).or_default().push(r);
+                match parse_items(&r.text).ok().and_then(|mut items| items.pop()) {
+                    // by C's name and Rust's - a family's definition, X__whole
+                    // or X__head, by X too, the type code names
+                    Some(CItem::Struct(def)) => {
+                        let rust = def.rust_ident();
+                        let family = rust.strip_suffix("__whole").or_else(|| rust.strip_suffix("__head"));
+                        for n in [Some(def.name.as_str()), Some(rust), family].into_iter().flatten() {
+                            structs.insert(n.to_string(), def.c_type());
+                        }
+                    }
+                    Some(CItem::TaggedUnion(tu)) => {
+                        structs.insert(tu.name.clone(), tu.c_type());
+                    }
+                    // a C typedef: by its own name - u##_bits in an x-macro
+                    // struct body is u96 as well as u64
+                    Some(CItem::Typedef(t)) => { structs.insert(t.name.clone(), t.name.clone()); }
+                    // a field of one is C's pointer to its buffer's struct
+                    Some(CItem::RcuArray(a)) => {
+                        structs.insert(a.alias.clone(), format!("struct {} __rcu *", a.c_name));
+                    }
+                    // how a prototype names it
+                    Some(CItem::Enum(CEnumDef { name: Some(n), .. })) => {
+                        structs.insert(n.clone(), format!("enum {n}"));
+                        if let Some(&size) = r.nums.first() {
+                            enums.insert(n.clone(), size);
+                        }
+                    }
+                    // a darray type is C's typedef, which its DEFINE_DARRAY*()
+                    // makes: Rust's is a DArray alias, with no record
+                    Some(CItem::Verbatim(v)) => {
+                        for n in darray_typedefs(&v.text) {
+                            structs.insert(n.clone(), n);
+                        }
+                        // a Rust type's own definition wins
+                        for (n, ty) in verbatim_types(&v.text) {
+                            structs.entry(n).or_insert(ty);
+                        }
+                    }
+                    _ => {}
+                }
+            }
+            // foo_types.rs's records, then foo.rs's
+            let mut headers: BTreeMap<String, Vec<(&str, Vec<&Record>)>> = BTreeMap::new();
+            for (file, rs) in files {
+                let header = gen_header(&src, root, file).unwrap_or_else(|e| die(e));
+                let srcs = headers.entry(header).or_default();
+                srcs.push((file, rs));
+                srcs.sort_by_key(|(f, _)| !f.ends_with("_types.rs"));
+            }
+            // Every header's errors, not just the first's.
+            let mut errors = Vec::new();
+            for (header, srcs) in headers {
+                let rs: Vec<&Record> = srcs.into_iter()
+                    .flat_map(|(_, mut rs)| {
+                        rs.sort_by_key(|r| r.line);
+                        in_dependency_order(rs)
+                    })
+                    .collect();
+                let h = match file_h(&header, &rs, &structs, &enums) {
+                    Ok(h) => h,
+                    Err(e) => { errors.push(e); continue; }
+                };
+                let path = std::path::Path::new(out_dir).join(&header);
+                write_if_changed(&path, &h).unwrap_or_else(|e| die(format!("writing {}: {e}", path.display())));
+            }
+            if !errors.is_empty() {
+                die(errors.join("\n"));
+            }
+        }
+        _ => die("usage: rust_types_gen RECORDS SRC OUT_DIR [ROOT]".into()),
+    }
+}
diff --git a/fs/bcachefs/util/alloc.rs b/fs/bcachefs/util/alloc.rs
new file mode 100644
index 0000000..2eae204
--- /dev/null
+++ b/fs/bcachefs/util/alloc.rs
@@ -0,0 +1,495 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Fallible allocation for code shared by both builds: the kernel's
+//! kernel::alloc in-kernel, bcachefs-shim's copy of the same API in userspace.
+//! An allocation failure is an AllocError to handle, never an abort.
+
+#[cfg(kernel)]
+pub use kernel::alloc::{flags, AllocError, Flags, KBox, KVVec};
+
+#[cfg(not(kernel))]
+pub use bcachefs_shim::alloc::{flags, AllocError, Flags, KVVec};
+/// In userspace, a Box is a KBox.
+#[cfg(not(kernel))]
+pub type KBox<T> = std::boxed::Box<T>;
+
+/// A @T for C to hold, built in place by @init in memory that starts zeroed -
+/// padding too, as kvzalloc()'s did - and pinned there: a KVBox in-kernel,
+/// given up to a raw pointer. free_pinned() takes it back. Fails with @init's
+/// error, or the allocation's.
+pub fn alloc_pinned<T, E: From<AllocError>>(init: impl ::pin_init::PinInit<T, E>) -> Result<*mut T, E> {
+    alloc_in::<false, T, E>(init, flags::GFP_KERNEL)
+}
+
+/// Drop and free @p.
+///
+/// # Safety
+/// @p is from alloc_pinned(), and nothing uses it after.
+pub unsafe fn free_pinned<T>(p: *mut T) {
+    #[cfg(kernel)]
+    drop(unsafe { kernel::alloc::KVBox::from_raw(p) });
+    #[cfg(not(kernel))]
+    drop(unsafe { std::boxed::Box::from_raw(p) });
+}
+
+/// alloc_pinned(), kmalloc()'d - a KBox in-kernel - for what's freed from
+/// any context: kfree() is safe anywhere, and kvfree() isn't - vfree() may
+/// sleep, outside interrupt context.
+pub fn kalloc_pinned<T, E: From<AllocError>>(init: impl ::pin_init::PinInit<T, E>) -> Result<*mut T, E> {
+    alloc_in::<true, T, E>(init, flags::GFP_KERNEL)
+}
+
+/// The allocator's Flags for @gfp, which is GFP_NOWAIT or GFP_KERNEL - the
+/// two allocate_dropping_locks() tries.
+pub fn gfp_flags(gfp: crate::c::gfp_t) -> Flags {
+    if gfp == crate::c::GFP_NOWAIT {
+        flags::GFP_NOWAIT
+    } else {
+        assert!(gfp == crate::c::GFP_KERNEL, "gfp_flags() of a mask that's neither GFP_NOWAIT nor GFP_KERNEL");
+        flags::GFP_KERNEL
+    }
+}
+
+/// kalloc_pinned(), allocating as @gfp says - GFP_NOWAIT, say, with btree
+/// locks held. Userspace ignores it.
+pub fn kalloc_pinned_gfp<T, E: From<AllocError>>(init: impl ::pin_init::PinInit<T, E>, gfp: Flags)
+    -> Result<*mut T, E>
+{
+    alloc_in::<true, T, E>(init, gfp)
+}
+
+/// @b's value, out of its box: *b, for a std Box - which the kernel's isn't,
+/// so it has into_inner().
+pub fn kbox_into_inner<T>(b: KBox<T>) -> T {
+    #[cfg(kernel)]
+    { KBox::into_inner(b) }
+    #[cfg(not(kernel))]
+    { *b }
+}
+
+pub fn kbox_pin_init<T, E: From<AllocError>>(init: impl ::pin_init::PinInit<T, E>)
+    -> Result<core::pin::Pin<KBox<T>>, E>
+{
+    // SAFETY: kalloc_pinned()'s is a KBox's allocation, pinned
+    Ok(unsafe { core::pin::Pin::new_unchecked(KBox::from_raw(kalloc_pinned(init)?)) })
+}
+
+/// @layout's worth of memory, zeroed, as a KBox allocates: for a KBox of an
+/// unsized type it can't make itself - a struct ending in a slice - by
+/// KBox::from_raw(). Or kfree(), if it's never made.
+pub fn kzalloc(layout: core::alloc::Layout) -> Result<core::ptr::NonNull<u8>, AllocError> {
+    #[cfg(kernel)]
+    {
+        use kernel::alloc::{allocator::Kmalloc, flags::__GFP_ZERO, Allocator, NumaNode};
+
+        Ok(Kmalloc::alloc(layout, flags::GFP_KERNEL | __GFP_ZERO, NumaNode::NO_NODE)?.cast())
+    }
+    // SAFETY: not zero sized, by the caller's use
+    #[cfg(not(kernel))]
+    core::ptr::NonNull::new(unsafe { std::alloc::alloc_zeroed(layout) }).ok_or(AllocError)
+}
+
+/// # Safety
+/// @p is kzalloc()'s, of @layout, and nothing uses it after.
+pub unsafe fn kfree(p: core::ptr::NonNull<u8>, layout: core::alloc::Layout) {
+    // SAFETY: the caller's
+    #[cfg(kernel)]
+    unsafe { <kernel::alloc::allocator::Kmalloc as kernel::alloc::Allocator>::free(p, layout) };
+    // SAFETY: the caller's
+    #[cfg(not(kernel))]
+    unsafe { std::alloc::dealloc(p.as_ptr(), layout) };
+}
+
+/// @p - kmalloc()'d, or null - as @new bytes, what was there kept: krealloc(),
+/// for a buffer C owns and kfree()s. Of no size the caller knows, as C's
+/// aren't. GFP_KERNEL, the caller's memalloc scope saying the rest.
+///
+/// # Safety
+/// @p is null, or kmalloc()'s and not used after unless this fails.
+pub unsafe fn krealloc(p: *mut u8, new: usize) -> Result<core::ptr::NonNull<u8>, AllocError> {
+    // Kmalloc::realloc() wants the old allocation's layout, which nobody has
+    #[cfg(kernel)]
+    {
+        use kernel::bindings::{krealloc_node_align, GFP_KERNEL, NUMA_NO_NODE};
+
+        // SAFETY: the caller's
+        core::ptr::NonNull::new(unsafe { krealloc_node_align(p.cast(), new, 1, GFP_KERNEL, NUMA_NO_NODE) }.cast())
+            .ok_or(AllocError)
+    }
+    // SAFETY: the caller's
+    #[cfg(not(kernel))]
+    core::ptr::NonNull::new(unsafe { bcachefs_shim::alloc::krealloc(p, new) }).ok_or(AllocError)
+}
+
+/// @size bytes kmalloc()'d, uninitialized, as @gfp says: for a buffer of no
+/// size anyone keeps - C's kfree(), or c::rust_kfree(), takes it back.
+pub fn kmalloc(size: usize, gfp: Flags) -> Result<core::ptr::NonNull<u8>, AllocError> {
+    #[cfg(kernel)]
+    {
+        use kernel::alloc::{allocator::Kmalloc, Allocator, NumaNode};
+
+        let layout = core::alloc::Layout::from_size_align(size, 1).map_err(|_| AllocError)?;
+        Ok(Kmalloc::alloc(layout, gfp, NumaNode::NO_NODE)?.cast())
+    }
+    // SAFETY: a new allocation
+    #[cfg(not(kernel))]
+    {
+        let _ = gfp;
+        core::ptr::NonNull::new(unsafe { bcachefs_shim::alloc::krealloc(core::ptr::null_mut(), size) })
+            .ok_or(AllocError)
+    }
+}
+
+/// kmalloc()'s alignment of @n bytes: to the largest power of two in it, up
+/// to a page - what IO into it, O_DIRECT's in userspace, needs.
+fn kv_layout(n: usize) -> Result<core::alloc::Layout, AllocError> {
+    let align = if n == 0 { 1 } else { 1 << n.ilog2() };
+    let align = align.clamp(size_of::<u64>(), crate::util::kernel::PAGE_SIZE);
+    core::alloc::Layout::from_size_align(n, align).map_err(|_| AllocError)
+}
+
+/// @p, @old bytes of kvmalloc()'d memory - or none, null - as @new bytes,
+/// what was there kept and the rest zeroed: kvrealloc(), __GFP_ZERO.
+/// Aligned as kmalloc() aligns @new. kvfree_sized() takes it back.
+pub fn kvrealloc_zeroed(p: *mut u8, old: usize, new: usize) -> Result<core::ptr::NonNull<u8>, AllocError> {
+    #[cfg(kernel)]
+    {
+        use kernel::alloc::{allocator::KVmalloc, flags::__GFP_ZERO, Allocator, NumaNode};
+
+        // SAFETY: @p is KVmalloc's, of @old bytes, or null
+        Ok(unsafe {
+            KVmalloc::realloc(core::ptr::NonNull::new(p), kv_layout(new)?, kv_layout(old)?,
+                              flags::GFP_KERNEL | __GFP_ZERO, NumaNode::NO_NODE)
+        }?.cast())
+    }
+    // A new allocation and a copy: realloc() keeps the old one's alignment
+    #[cfg(not(kernel))]
+    // SAFETY: @p is std::alloc's, of @old bytes, or null
+    unsafe {
+        let q = core::ptr::NonNull::new(std::alloc::alloc_zeroed(kv_layout(new)?)).ok_or(AllocError)?;
+        if let Some(p) = core::ptr::NonNull::new(p) {
+            q.as_ptr().copy_from_nonoverlapping(p.as_ptr(), old.min(new));
+            std::alloc::dealloc(p.as_ptr(), kv_layout(old)?);
+        }
+        Ok(q)
+    }
+}
+
+/// @p, @old bytes of kvmalloc()'d memory - or none, null - as @new bytes,
+/// what was there kept: kvrealloc(). @gfp for where it can't sleep -
+/// GFP_NOWAIT, under a spinlock; elsewhere GFP_KERNEL, the caller's memalloc
+/// scope saying the rest. Aligned as kmalloc() aligns @new; kvfree_sized()
+/// takes it back.
+pub fn kvrealloc(p: *mut u8, old: usize, new: usize, gfp: Flags)
+    -> Result<core::ptr::NonNull<u8>, AllocError>
+{
+    #[cfg(kernel)]
+    {
+        use kernel::alloc::{allocator::KVmalloc, Allocator, NumaNode};
+
+        // SAFETY: @p is KVmalloc's, of @old bytes, or null
+        Ok(unsafe {
+            KVmalloc::realloc(core::ptr::NonNull::new(p), kv_layout(new)?, kv_layout(old)?,
+                              gfp, NumaNode::NO_NODE)
+        }?.cast())
+    }
+    // A new allocation and a copy: realloc() keeps the old one's alignment
+    #[cfg(not(kernel))]
+    // SAFETY: @p is std::alloc's, of @old bytes, or null
+    unsafe {
+        let _ = gfp;
+        let q = core::ptr::NonNull::new(std::alloc::alloc(kv_layout(new)?)).ok_or(AllocError)?;
+        if let Some(p) = core::ptr::NonNull::new(p) {
+            q.as_ptr().copy_from_nonoverlapping(p.as_ptr(), old.min(new));
+            std::alloc::dealloc(p.as_ptr(), kv_layout(old)?);
+        }
+        Ok(q)
+    }
+}
+
+/// # Safety
+/// @p is kvrealloc_zeroed()'s or kvrealloc()'s, of @size bytes, and nothing
+/// uses it after.
+pub unsafe fn kvfree_sized(p: core::ptr::NonNull<u8>, size: usize) {
+    let layout = kv_layout(size).expect("its allocation's");
+    // SAFETY: the caller's
+    #[cfg(kernel)]
+    unsafe { <kernel::alloc::allocator::KVmalloc as kernel::alloc::Allocator>::free(p, layout) };
+    // SAFETY: the caller's
+    #[cfg(not(kernel))]
+    unsafe { std::alloc::dealloc(p.as_ptr(), layout) };
+}
+
+// ── Aligned boxes ────────────────────────────────────────────────────────
+//
+// ABox<T, A>, and AVec<T, A> to build one: a Box, and a Vec, whose memory is
+// aligned to A - ConstAlign<N> - as IO into it needs. In userspace they're
+// aligned-vec's; in-kernel, which has no global allocator for the crate's,
+// the same API over kvmalloc - the part of it that's used. Memory's as the
+// task's memalloc scope allows: no flags.
+
+#[cfg(not(kernel))]
+pub use aligned_vec::{ABox, AVec, Alignment, ConstAlign};
+
+#[cfg(kernel)]
+pub use abox::{ABox, AVec, Alignment, ConstAlign};
+
+#[cfg(kernel)]
+mod abox {
+    use super::AllocError;
+    use core::alloc::Layout;
+    use core::marker::PhantomData;
+    use core::ptr::NonNull;
+    use kernel::alloc::{allocator::KVmalloc, flags::GFP_KERNEL, Allocator, NumaNode};
+
+    /// An alignment, as aligned-vec's: here only the compile-time one.
+    pub trait Alignment {
+        const ALIGN: usize;
+    }
+
+    #[derive(Clone, Copy)]
+    pub struct ConstAlign<const ALIGN: usize>;
+
+    impl<const N: usize> Alignment for ConstAlign<N> {
+        const ALIGN: usize = N;
+    }
+
+    pub struct AVec<T, A: Alignment> {
+        p:   NonNull<T>,
+        len: usize,
+        cap: usize,
+        _a:  PhantomData<A>,
+    }
+
+    // SAFETY: owns its Ts, as a Vec does
+    unsafe impl<T: Send, A: Alignment> Send for AVec<T, A> {}
+    unsafe impl<T: Sync, A: Alignment> Sync for AVec<T, A> {}
+
+    fn layout<T, A: Alignment>(n: usize) -> Result<Layout, AllocError> {
+        Layout::array::<T>(n).and_then(|l| l.align_to(A::ALIGN)).map_err(|_| AllocError)
+    }
+
+    impl<T, A: Alignment> AVec<T, A> {
+        /// Empty: room's made as it's reserved. @align is A's, as the crate's.
+        pub fn new(_align: usize) -> Self {
+            const { assert!(size_of::<T>() != 0, "an AVec of a zero sized type") };
+            AVec { p: NonNull::dangling(), len: 0, cap: 0, _a: PhantomData }
+        }
+
+        pub fn len(&self) -> usize {
+            self.len
+        }
+
+        /// Room for exactly @additional more.
+        pub fn try_reserve_exact(&mut self, additional: usize) -> Result<(), AllocError> {
+            if additional <= self.cap - self.len {
+                return Ok(());
+            }
+            let cap = self.len.checked_add(additional).ok_or(AllocError)?;
+            let old = (self.cap != 0).then_some(self.p.cast());
+            // SAFETY: @old is KVmalloc's, of its layout, or none
+            let p = unsafe {
+                KVmalloc::realloc(old, layout::<T, A>(cap)?, layout::<T, A>(self.cap)?, GFP_KERNEL, NumaNode::NO_NODE)
+            }?;
+            self.p = p.cast();
+            self.cap = cap;
+            Ok(())
+        }
+
+        /// # Safety
+        /// @len is within its capacity, and that many of it initialized.
+        pub unsafe fn set_len(&mut self, len: usize) {
+            self.len = len;
+        }
+
+        /// As a boxed slice. Not one with room left: the crate's shrinks to
+        /// fit, which nothing here needs.
+        pub fn into_boxed_slice(self) -> ABox<[T], A> {
+            assert_eq!(self.len, self.cap, "into_boxed_slice() of an AVec with room left");
+            let this = core::mem::ManuallyDrop::new(self);
+            ABox { p: NonNull::slice_from_raw_parts(this.p, this.len), _a: PhantomData }
+        }
+    }
+
+    impl<T, A: Alignment> Drop for AVec<T, A> {
+        fn drop(&mut self) {
+            // SAFETY: its @len, initialized; its memory, of @cap, KVmalloc's
+            unsafe {
+                core::ptr::slice_from_raw_parts_mut(self.p.as_ptr(), self.len).drop_in_place();
+                if self.cap != 0 {
+                    KVmalloc::free(self.p.cast(), layout::<T, A>(self.cap).expect("its allocation's"));
+                }
+            }
+        }
+    }
+
+    pub struct ABox<T: ?Sized, A: Alignment> {
+        p:  NonNull<T>,
+        _a: PhantomData<A>,
+    }
+
+    // SAFETY: owns its T, as a Box does
+    unsafe impl<T: ?Sized + Send, A: Alignment> Send for ABox<T, A> {}
+    unsafe impl<T: ?Sized + Sync, A: Alignment> Sync for ABox<T, A> {}
+
+    impl<T: ?Sized, A: Alignment> core::ops::Deref for ABox<T, A> {
+        type Target = T;
+
+        fn deref(&self) -> &T {
+            // SAFETY: its own, live
+            unsafe { self.p.as_ref() }
+        }
+    }
+
+    impl<T: ?Sized, A: Alignment> core::ops::DerefMut for ABox<T, A> {
+        fn deref_mut(&mut self) -> &mut T {
+            // SAFETY: its own, live, borrowed mutably
+            unsafe { self.p.as_mut() }
+        }
+    }
+
+    impl<T: ?Sized, A: Alignment> Drop for ABox<T, A> {
+        fn drop(&mut self) {
+            // SAFETY: its own, live; KVmalloc's, laid out as it is, aligned to A
+            unsafe {
+                let layout = Layout::for_value(self.p.as_ref()).align_to(A::ALIGN).expect("its allocation's");
+                self.p.as_ptr().drop_in_place();
+                if layout.size() != 0 {
+                    KVmalloc::free(self.p.cast(), layout);
+                }
+            }
+        }
+    }
+}
+
+/// @init run on @slot: PinInit's __init() - __pinned_init(), before the
+/// kernel's pin-init v2 (7.3).
+///
+/// # Safety
+/// As PinInit's: @slot is a T's, and stays put if @init needs it to.
+pub unsafe fn init_at<T, E>(init: impl ::pin_init::PinInit<T, E>, slot: *mut T) -> Result<(), E> {
+    // SAFETY: the caller's
+    #[cfg(bch_pin_init_v2)]
+    return unsafe { init.__init(slot) };
+    // SAFETY: the caller's
+    #[cfg(not(bch_pin_init_v2))]
+    return unsafe { init.__pinned_init(slot) };
+}
+
+fn alloc_in<const KMALLOC: bool, T, E: From<AllocError>>(init: impl ::pin_init::PinInit<T, E>,
+                                                          #[allow(unused_variables)] gfp: Flags)
+    -> Result<*mut T, E>
+{
+    #[cfg(kernel)]
+    {
+        use core::pin::Pin;
+        use kernel::alloc::{flags::__GFP_ZERO, KBox, KVBox};
+        use kernel::init::InPlaceInit;
+
+        let gfp = gfp | __GFP_ZERO;
+        // SAFETY: pinned still: given up to its holder, which frees it
+        Ok(unsafe {
+            if KMALLOC {
+                KBox::into_raw(Pin::into_inner_unchecked(KBox::try_pin_init(init, gfp)?))
+            } else {
+                KVBox::into_raw(Pin::into_inner_unchecked(KVBox::try_pin_init(init, gfp)?))
+            }
+        })
+    }
+    #[cfg(not(kernel))]
+    {
+        let layout = std::alloc::Layout::new::<T>();
+        // SAFETY: not zero sized - what C holds a pointer to has bytes
+        let p = unsafe { std::alloc::alloc_zeroed(layout) }.cast::<T>();
+        if p.is_null() {
+            return Err(AllocError.into());
+        }
+        // SAFETY: valid for writes, and it won't move: it's C's from here
+        match unsafe { init_at(init, p) } {
+            Ok(()) => Ok(p),
+            Err(e) => {
+                // SAFETY: alloc_zeroed()'s, with this layout; a failed init
+                // has dropped what it made
+                unsafe { std::alloc::dealloc(p.cast(), layout) };
+                Err(e)
+            }
+        }
+    }
+}
+
+/// A darray C owns, lent to Rust as a KVVec while this lives; given back -
+/// its buffer, length and capacity, however the vector grew it - when it
+/// drops, even unwinding, so C's darray_exit() frees it as ever. Zero copy:
+/// a darray is kvmalloc()'d and kvfree()'d, as a KVVec is in-kernel; in
+/// userspace, posix_memalign()'d and free()'d, which the shim's Vec's malloc()
+/// allocator reallocs and frees.
+pub struct DArrayLoan<'d, T> {
+    d: &'d mut crate::types::DArray<T>,
+    v: core::mem::ManuallyDrop<KVVec<T>>,
+}
+
+impl<'d, T> DArrayLoan<'d, T> {
+    /// # Safety
+    /// @d is a darray: @nr of its @size initialized, its buffer kvmalloc()'d -
+    /// none of C's preallocated storage, which DArray<T> has none of.
+    pub unsafe fn new(d: &'d mut crate::types::DArray<T>) -> Self {
+        let data = if d.size != 0 { d.data } else { core::ptr::NonNull::dangling().as_ptr() };
+        // SAFETY: the caller's; NULL, for an empty darray, made dangling
+        let v = unsafe { KVVec::from_raw_parts(data, d.nr, d.size) };
+        DArrayLoan { d, v: core::mem::ManuallyDrop::new(v) }
+    }
+}
+
+impl<T> core::ops::Deref for DArrayLoan<'_, T> {
+    type Target = KVVec<T>;
+
+    fn deref(&self) -> &KVVec<T> {
+        &self.v
+    }
+}
+
+impl<T> core::ops::DerefMut for DArrayLoan<'_, T> {
+    fn deref_mut(&mut self) -> &mut KVVec<T> {
+        &mut self.v
+    }
+}
+
+impl<T> Drop for DArrayLoan<'_, T> {
+    fn drop(&mut self) {
+        // SAFETY: taken once, here; nothing reads it after
+        let v = unsafe { core::mem::ManuallyDrop::take(&mut self.v) };
+        let (data, nr, size) = v.into_raw_parts();
+        self.d.data = if size != 0 { data } else { core::ptr::null_mut() };
+        self.d.nr   = nr;
+        self.d.size = size;
+    }
+}
+
+/// Free darray @d, left empty: C's darray_exit(), for a darray a Rust type
+/// owns and drops.
+///
+/// # Safety
+/// As DArrayLoan::new(): @d is a darray, its buffer kvmalloc()'d.
+pub unsafe fn darray_exit<T>(d: &mut crate::types::DArray<T>) {
+    // SAFETY: the caller's; the vector it was lent as dropped, freeing the
+    // buffer, and an empty one given back
+    *unsafe { DArrayLoan::new(d) } = KVVec::new();
+}
+
+/// What darray @d holds, now a KVVec's, @d left empty: for a darray C filled
+/// for Rust.
+///
+/// # Safety
+/// As DArrayLoan::new().
+pub unsafe fn darray_take<T>(d: &mut crate::types::DArray<T>) -> KVVec<T> {
+    // SAFETY: the caller's; an empty vector given back for it
+    core::mem::replace(&mut *unsafe { DArrayLoan::new(d) }, KVVec::new())
+}
+
+/// Insert @v at @idx, moving what's after it up one: neither build's KVVec
+/// has insert(), so it's a push and a rotate.
+pub fn kvvec_insert<T>(vec: &mut KVVec<T>, idx: usize, v: T) -> Result<(), AllocError> {
+    vec.push(v, flags::GFP_KERNEL)?;
+    vec[idx..].rotate_right(1);
+    Ok(())
+}
diff --git a/fs/bcachefs/util/backref.rs b/fs/bcachefs/util/backref.rs
new file mode 100644
index 0000000..315f146
--- /dev/null
+++ b/fs/bcachefs/util/backref.rs
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! BackRef<T>: a pointer to something that outlives it, which it can't
+//! borrow.
+//!
+//! The case: an object owned by T - directly, or through a container T owns -
+//! points back at T. A stripe being made points at its filesystem, which owns
+//! it. A lifetime can't say that: T would contain things borrowing T. What
+//! makes it sound is an ordering Rust can't see - T's owner drains what holds
+//! a BackRef before T goes - so the constructor is unsafe, and that ordering
+//! is its contract, promised once where the BackRef is made rather than at
+//! every use.
+//!
+//! What's reached through the BackRef is another matter: get() is a
+//! &'static T, for what its holder keeps beside it and hands T to by
+//! reference - a stripe being made's disk reservation, its pins on open
+//! buckets. new()'s caller can't promise where safe code puts that, so get()
+//! is unsafe: its caller promises what it goes into is drained with the
+//! holder.
+//!
+//! Every access is through a shared reference, and so must every other
+//! access to T be while BackRefs exist: a BackRef hands out &T whenever it's
+//! asked, and that's only sound alongside other &T - T's mutation interior,
+//! as Fs's is.
+//!
+//! This is the stopgap. What makes it safe is in the design notes,
+//! rust-contexts-and-backrefs: a #[context] declaring where a type lives, so
+//! it can't be constructed anywhere else, and existential lifetimes - a
+//! lifetime guaranteeing T exists, granting no access, held by the container
+//! - so the drop ordering is the compiler's to check.
+
+use core::ops::Deref;
+use core::ptr::NonNull;
+
+/// A pointer, to C: repr(transparent), for a field C reads as T *.
+#[repr(transparent)]
+pub struct BackRef<T: ?Sized + Sync>(NonNull<T>);
+
+impl<T: ?Sized + Sync> BackRef<T> {
+    /// # Safety
+    /// @t outlives this BackRef, and what's handed a reference from it - its
+    /// owner drains what holds one, and what that holds, before it goes - and
+    /// is only accessed through shared references meanwhile.
+    pub unsafe fn new(t: &T) -> Self {
+        BackRef(NonNull::from(t))
+    }
+
+    /// # Safety
+    /// What's handed it is drained with this BackRef's holder, before @t goes.
+    pub unsafe fn get(&self) -> &'static T
+    where
+        T: 'static,
+    {
+        // SAFETY: new()'s, and the caller's
+        unsafe { self.0.as_ref() }
+    }
+}
+
+impl<T: ?Sized + Sync> Deref for BackRef<T> {
+    type Target = T;
+
+    fn deref(&self) -> &T {
+        // SAFETY: new()'s
+        unsafe { self.0.as_ref() }
+    }
+}
+
+// SAFETY: a &T for as long as it lives, by new()'s contract - and a &T is
+// Send and Sync when T is Sync
+unsafe impl<T: ?Sized + Sync> Send for BackRef<T> {}
+unsafe impl<T: ?Sized + Sync> Sync for BackRef<T> {}
diff --git a/fs/bcachefs/util/backtrace.rs b/fs/bcachefs/util/backtrace.rs
new file mode 100644
index 0000000..c4b0972
--- /dev/null
+++ b/fs/bcachefs/util/backtrace.rs
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Backtraces as text: a frame a line, each address's symbol with its name
+//! demangled.
+//!
+//! What resolves an address differs by where we run, and nothing else does.
+//! In the kernel it's kallsyms, through %pB - "name+0xoff/0xsize [module]";
+//! in userspace, the shim's bch2_prt_symbol(), libunwind and libdw - "name+0xoff
+//! file:line". Either way the name comes first and has no '+' in it, and it's
+//! mangled where it's Rust's: kallsyms keeps symbols as the compiler emitted
+//! them (v0, -Csymbol-mangling-version=v0), and the kernel has no demangler -
+//! scripts/decode_stacktrace.sh runs one offline. So the name is demangled
+//! here, for both, and the rest of the line printed as it came.
+//!
+//! Callers print a lock owner's stack from lock debugging - anywhere, as deep
+//! as the stack goes - so a symbol costs the stack little: the kernel's
+//! scratch for it is on the stack, a symbol's length, and demangling is on
+//! the heap (util/demangle.rs), GFP_NOWAIT, the name printed raw if that
+//! fails.
+
+use crate::c;
+use crate::prt;
+use crate::util::demangle::prt_demangled;
+use crate::util::Printbuf;
+use core::ffi::c_ulong;
+use cstruct_macros::{c_export, c_extern};
+
+// bch2_prt_symbol(): @addr's symbol, "name+0xoff", and " file:line" if libdw
+// knows it - linux/stacktrace.c, the userspace shim's %pB.
+c_extern! {
+    #[cfg(not(kernel))]
+    pub fn bch2_prt_symbol(out: *mut c::printbuf, addr: c_ulong);
+}
+
+/// @sym, a symbol "name..." as the symbolizer printed it, to @out: the name
+/// demangled - a Rust name, mangled; anything else as it is.
+fn prt_symbol_demangled(out: &mut Printbuf, sym: &str) {
+    let (name, rest) = sym.split_at(sym.find('+').unwrap_or(sym.len()));
+
+    prt_demangled(out, name);
+    prt!(out, "{rest}");
+}
+
+/// @addr's symbol, demangled, to @out.
+#[cfg(kernel)]
+pub(crate) fn prt_symbol(out: &mut Printbuf, addr: c_ulong) {
+    let mut buf = [0u8; c::KSYM_SYMBOL_LEN as usize];
+    // SAFETY: @buf outlives @sym, which writes nothing past it
+    let mut sym = unsafe { Printbuf::new_extern(buf.as_mut_ptr().cast(), buf.len()) };
+
+    // SAFETY: our printbuf; %pB takes the address as a pointer
+    unsafe { c::bch2_prt_printf(sym.as_raw(), c"%pB".as_ptr().cast(), addr as *const core::ffi::c_void) };
+    prt_symbol_demangled(out, sym.as_str());
+}
+
+/// @addr's symbol, demangled, to @out.
+#[cfg(not(kernel))]
+pub(crate) fn prt_symbol(out: &mut Printbuf, addr: c_ulong) {
+    let mut sym = Printbuf::new();
+
+    // SAFETY: our printbuf
+    unsafe { bch2_prt_symbol(sym.as_raw(), addr) };
+    prt_symbol_demangled(out, sym.as_str());
+}
+
+/// @stack, a frame a line, as the kernel prints them: "[<0>] " and the
+/// frame's symbol.
+pub fn prt_backtrace(out: &mut Printbuf, stack: &[c_ulong]) {
+    for &addr in stack {
+        prt!(out, "[<0>] ");
+        prt_symbol(out, addr);
+        out.newline();
+    }
+}
+
+/// # Safety
+/// @stack is a darray C filled: @nr addresses at @data.
+#[c_export]
+pub unsafe fn bch2_prt_backtrace(out: &mut Printbuf, stack: &c::bch_stacktrace) {
+    let frames = if stack.nr == 0 {
+        &[][..]
+    } else {
+        // SAFETY: the caller's - nr addresses at data, nonnull as nr isn't 0
+        unsafe { core::slice::from_raw_parts(stack.data, stack.nr) }
+    };
+    prt_backtrace(out, frames);
+}
diff --git a/fs/bcachefs/util/bio.rs b/fs/bcachefs/util/bio.rs
new file mode 100644
index 0000000..83c7a2a
--- /dev/null
+++ b/fs/bcachefs/util/bio.rs
@@ -0,0 +1,502 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! struct bio, from Rust. The terms, used bare here and in iter.rs and
+//! owned.rs:
+//!
+//! - A bio describes one block IO: device, op, sector, a position in its
+//!   data, and its bvecs - (page, offset, len), in an array that may be
+//!   inline, right after the bio in its allocation. Bio is a view of one; its
+//!   c::bio is private, read through raw().
+//! - Its data is what the bvecs point at. A position is a bvec_iter: a bvec,
+//!   an offset into it, and the bytes left. The bio's own is bi_iter, which
+//!   the block layer advances as the IO completes. A BioRange is a position
+//!   and its bio; walking one gives chunks, virtually contiguous pieces of the
+//!   data, or segments, the bvecs as they are, or folios (iter.rs).
+//! - Its owner is what allocated it and holds it (owned.rs): a BioBox, a ref
+//!   from a BioSet, or a BioBuf, a struct and its inline bvecs in one
+//!   allocation. Only the owner builds a bio, submits it, and walks all of its
+//!   bvecs wherever its position is - range_all(), C's _all walks. Anything
+//!   with a &Bio may read it, and walk its data from a position.
+//! - Mapping a buffer adds it to the bvecs, until the bio's next reset().
+//!   Mapped ties that to a borrow of the buffer, resetting the bio on drop.
+//! - In flight: submitted, until its endio. An async submit consumes the
+//!   owner, and its endio is given it back (RawBio::submit()), so nothing
+//!   reaches a bio in flight - but submit_gathered(), the superblock's,
+//!   which is why it's unsafe. Those states are what make reading a bio's
+//!   fields through &Bio safe.
+//! - Pinned: inline bvecs make a bio self-referential, so it's never moved,
+//!   and changed only through Pin<&mut Bio> - its own methods, given one by
+//!   its owner's bio_mut().
+//!
+//! After Andreas Hindborg's kernel::block::bio, from his rnull series
+//! (git.kernel.org a.hindborg/linux.git, rnull-v6.19-rc5, 41e04e1bb2e6): the
+//! kernel crate vendored here hasn't got it, and couldn't serve userspace. So
+//! it's over c::bio here, in both builds - the shim's bio_vec laid out as the
+//! kernel's.
+
+use core::marker::{PhantomData, PhantomPinned};
+use core::pin::Pin;
+use core::ptr::NonNull;
+
+use crate::c;
+use crate::errcode::{ret_to_result_void, BchError};
+use crate::prt;
+use crate::util::gather::GatherRef;
+use crate::util::{Printbuf, ToText};
+use crate::util::volatile::VolatileSlice;
+
+mod iter;
+mod owned;
+pub mod pages;
+
+#[cfg(kernel)]
+pub use iter::{FolioVec, Folios};
+pub use iter::{Chunk, Chunks, Segment, Segments, Walk};
+#[cfg(kernel)]
+pub(crate) use iter::nth_page;
+pub use owned::{BioBox, BioBuf, BioBufPtr, BioInPlace, BioSet, Endio, HasBio, RawBio};
+
+// A bvec_iter's offset into its bvec, as a place: bi_offset - bi_bvec_done
+// before 7.3, and in the shim.
+#[cfg(kernel)]
+#[macro_use]
+mod compat {
+    #[cfg(linux_ge = "7.3")]
+    macro_rules! bi_offset { ($i:expr) => { $i.bi_offset } }
+    #[cfg(not(linux_ge = "7.3"))]
+    macro_rules! bi_offset { ($i:expr) => { $i.bi_bvec_done } }
+}
+#[cfg(not(kernel))]
+macro_rules! bi_offset { ($i:expr) => { $i.bi_bvec_done } }
+
+/// How many bvecs mapping @len bytes at @p takes: a page each for vmalloc
+/// memory, one for the direct map.
+pub fn buf_nr_bvecs(p: *const u8, len: usize) -> usize {
+    use crate::util::kernel::PAGE_SIZE;
+    // SAFETY: an address, only compared
+    #[cfg(kernel)]
+    if unsafe { c::is_vmalloc_addr(p.cast()) } {
+        return (len + (p as usize & (PAGE_SIZE - 1))).div_ceil(PAGE_SIZE);
+    }
+    let _ = (p, len, PAGE_SIZE);
+    1
+}
+
+#[repr(transparent)]
+pub struct Bio {
+    bio:  c::bio,
+    _pin: PhantomPinned,
+}
+
+// SAFETY: a bio is no thread's - submitted on one, completed on another. Not
+// Sync: two holders of a &Bio could write its data at once.
+unsafe impl Send for Bio {}
+
+impl Bio {
+    /// # Safety
+    /// @ptr is a bio, valid for 'a, and not in flight.
+    pub unsafe fn from_raw<'a>(ptr: *const c::bio) -> &'a Self {
+        // SAFETY: the caller's; Bio is a transparent c::bio
+        unsafe { &*ptr.cast() }
+    }
+
+    /// # Safety
+    /// As from_raw()'s, and nothing else has it for 'a.
+    unsafe fn from_raw_mut<'a>(ptr: *mut c::bio) -> Pin<&'a mut Self> {
+        // SAFETY: the caller's; a bio never moves
+        unsafe { Pin::new_unchecked(&mut *ptr.cast()) }
+    }
+
+    pub fn raw(&self) -> &c::bio {
+        &self.bio
+    }
+
+    /// For its own methods, and C's: never moved out of.
+    fn raw_mut(self: Pin<&mut Self>) -> &mut c::bio {
+        // SAFETY: not moved, as above
+        unsafe { &mut self.get_unchecked_mut().bio }
+    }
+
+    pub fn range(&self) -> BioRange<'_> {
+        BioRange { bio: self, iter: self.bio.bi_iter }
+    }
+
+    /// Its data from @pos: a position saved from it, its bi_iter before the IO
+    /// advanced it or a range's pos().
+    ///
+    /// # Safety
+    /// @pos is a position of this bio: within its bvecs, as many bytes of
+    /// them after it as bi_size says.
+    // XXX: unsafe, as a position carries nothing saying which bio it's of. A
+    // lifetime tying them together may make this safe, once bcachefs walks its
+    // bios this way throughout.
+    pub unsafe fn range_at(&self, pos: c::bvec_iter) -> BioRange<'_> {
+        BioRange { bio: self, iter: pos }
+    }
+
+    /// It, then the bios chained after it by bi_next.
+    pub fn chain_iter(&self) -> BioIterator<'_> {
+        BioIterator { bio: Some(NonNull::from(self)), _p: PhantomData }
+    }
+
+    pub fn has_data(&self) -> bool {
+        self.bio.bi_iter.bi_size != 0 && !self.no_advance_iter()
+    }
+
+    /// A discard, or a write of zeroes: a size, and no bvecs.
+    fn no_advance_iter(&self) -> bool {
+        [c::req_op_REQ_OP_DISCARD, c::req_op_REQ_OP_SECURE_ERASE, c::req_op_REQ_OP_WRITE_ZEROES]
+            .contains(&self.op())
+    }
+
+    fn op(&self) -> u32 {
+        self.bio.bi_opf & ((1 << c::REQ_OP_BITS) - 1)
+    }
+
+    /// @len bytes of @buf mapped. Panics if they don't fit, where
+    /// __bio_add_page() would write past the bvecs. For a buffer kept by other
+    /// means than a borrow - a stripe buffer's blocks, kept by the IO's round;
+    /// map_read() and map_write() borrow it.
+    ///
+    /// # Safety
+    /// @buf is the allocators' - in the direct map, or vmalloc - and outlives
+    /// its place in the bvecs; nothing has the bio in flight.
+    pub(crate) unsafe fn map(self: Pin<&mut Self>, buf: *mut u8, len: usize) {
+        let len = u32::try_from(len).expect("mapping a buffer of 4G or more into a bio");
+        let bio = self.raw_mut();
+        #[cfg(kernel)]
+        // SAFETY: the caller's
+        if unsafe { c::is_vmalloc_addr(buf.cast()) } {
+            assert!(unsafe { c::bio_add_vmalloc(bio, buf.cast(), len) },
+                    "mapping {len} bytes of vmalloc memory: more pages than the bio's bvecs");
+            return;
+        }
+        assert!(bio.bi_vcnt < bio.bi_max_vecs, "mapping {len} bytes: the bio's bvecs are full");
+        // SAFETY: the caller's, and a bvec free
+        unsafe { c::bio_add_virt_nofail(bio, buf.cast(), len) };
+    }
+
+    pub fn reset(self: Pin<&mut Self>, bdev: *mut c::block_device, opf: u32) {
+        // SAFETY: had by &mut, so not in flight
+        unsafe { c::bio_reset(self.raw_mut(), bdev, opf as _) }
+    }
+
+    pub fn set_sector(self: Pin<&mut Self>, sector: u64) {
+        self.raw_mut().bi_iter.bi_sector = sector;
+    }
+
+    /// Its size, for a bio with no data to size it by: a discard's.
+    pub fn set_size(self: Pin<&mut Self>, bytes: u32) {
+        self.raw_mut().bi_iter.bi_size = bytes;
+    }
+
+    /// Its completed IO's result: a BCH_ERR_BLK_STS_* errcode on failure.
+    pub fn status(&self) -> Result<(), BchError> {
+        match self.bio.bi_status {
+            0  => Ok(()),
+            // SAFETY: a status
+            st => Err(unsafe { c::blk_status_to_bch_err(st) }.into()),
+        }
+    }
+
+    /// A clone's bvecs are its parent's, and its bi_vcnt 0.
+    pub fn cloned(&self) -> bool {
+        self.bio.bi_flags & (1 << c::BIO_CLONED as u32) != 0
+    }
+
+    /// # Safety
+    /// @idx is one of its bvecs - bi_vcnt of them, or its parent's, a clone's.
+    unsafe fn bvec(&self, idx: u32) -> c::bio_vec {
+        // SAFETY: the caller's
+        unsafe { *self.bio.bi_io_vec.add(idx as usize) }
+    }
+}
+
+impl ToText for Bio {
+    fn to_text(&self, out: &mut Printbuf) {
+        let iter = self.bio.bi_iter;
+        prt!(out, "bio {:p}: vcnt {}, idx {}, size {:#x}, offset {:#x}",
+             self, self.bio.bi_vcnt, iter.bi_idx, iter.bi_size, bi_offset!(iter));
+    }
+}
+
+/// # Safety
+/// bio() is the implementor's own, which nothing else has - in flight, or
+/// to build on - while it's had.
+pub unsafe trait BioOwner {
+    fn bio(&self) -> &Bio;
+
+    fn bio_mut(&mut self) -> Pin<&mut Bio>;
+
+    /// Panics on a clone.
+    fn range_all(&self) -> BioRange<'_> {
+        let bio = self.bio();
+        assert!(!bio.cloned(), "the _all walk of a cloned bio: its bvecs are its parent's");
+        // SAFETY: its own bvecs, bi_vcnt of them
+        let size = (0..u32::from(bio.bio.bi_vcnt)).map(|i| unsafe { bio.bvec(i) }.bv_len).sum();
+        // INVARIANT: from its first bvec, all of them
+        BioRange {
+            bio,
+            iter: c::bvec_iter { bi_size: size, ..Default::default() },
+        }
+    }
+
+    fn submit_wait(&mut self) -> Result<(), BchError> {
+        // SAFETY: the owner's bio, held for the IO
+        ret_to_result_void(unsafe { c::submit_bio_wait(self.bio_mut().raw_mut()) })
+    }
+
+    /// Panics if the bio isn't a read, or hasn't the bvecs for @buf.
+    fn map_read<'a>(&'a mut self, buf: &'a mut [u8]) -> Mapped<'a, Self, &'a mut [u8]>
+    where
+        Self: Sized,
+    {
+        assert_eq!(self.bio().op(), c::req_op_REQ_OP_READ, "map_read() of a bio for another op");
+        // SAFETY: @buf's borrowed as long as the mapping is
+        unsafe { self.bio_mut().map(buf.as_mut_ptr(), buf.len()) };
+        Mapped { owner: self, _buf: PhantomData }
+    }
+
+    /// Panics if the bio isn't a write, or hasn't the bvecs for @buf.
+    fn map_write<'a>(&'a mut self, buf: &'a [u8]) -> Mapped<'a, Self, &'a [u8]>
+    where
+        Self: Sized,
+    {
+        assert_eq!(self.bio().op(), c::req_op_REQ_OP_WRITE, "map_write() of a bio for another op");
+        // SAFETY: as map_read()'s; a write only reads it
+        unsafe { self.bio_mut().map(buf.as_ptr().cast_mut(), buf.len()) };
+        Mapped { owner: self, _buf: PhantomData }
+    }
+}
+
+/// An owner's bio mapped to a buffer it borrows: B is the borrow, &mut [u8]
+/// for a read and & for a write. Dropping it resets the bio, so no bvec
+/// outlives the borrow.
+pub struct Mapped<'a, O: BioOwner, B> {
+    owner: &'a mut O,
+    _buf:  PhantomData<B>,
+}
+
+impl<O: BioOwner, B> Mapped<'_, O, B> {
+    pub fn submit_wait(&mut self) -> Result<(), BchError> {
+        self.owner.submit_wait()
+    }
+
+    /// Submitted, @r put when it completes. The mapping stays until the bio's
+    /// next reset().
+    ///
+    /// sb/io's alone: the bio isn't given up, as an async submit's is, so
+    /// it's reachable in flight. It goes once the superblock's IO consumes
+    /// its bio.
+    ///
+    /// # Safety
+    /// Nothing touches the bio, or the buffer it's mapped to, until @r's
+    /// Gather has been waited on; nor walks or submits the bio until its next
+    /// reset().
+    pub unsafe fn submit_gathered(self, r: GatherRef<()>) {
+        let mut this = core::mem::ManuallyDrop::new(self);
+        let bio = this.owner.bio_mut().raw_mut();
+        bio.bi_private = r.into_raw().cast_mut().cast();
+        bio.bi_end_io = Some(gathered_endio);
+        // SAFETY: the owner's, built for this IO; the caller keeps it, and
+        // the buffer, from being touched until it's done
+        unsafe { c::submit_bio(bio) };
+    }
+}
+
+unsafe extern "C" fn gathered_endio(bio: *mut c::bio) {
+    // SAFETY: submit_gathered()'s, whose ref is bi_private
+    drop(unsafe { GatherRef::<()>::from_raw((*bio).bi_private.cast()) })
+}
+
+impl<O: BioOwner, B> Drop for Mapped<'_, O, B> {
+    fn drop(&mut self) {
+        let bio = self.owner.bio().raw();
+        let (bdev, opf) = (bio.bi_bdev, bio.bi_opf);
+        self.owner.bio_mut().reset(bdev, opf);
+    }
+}
+
+/// # Invariants
+/// @iter is a position of @bio: within its bvecs, bi_size bytes of them
+/// after it.
+#[derive(Clone, Copy)]
+pub struct BioRange<'a> {
+    bio:  &'a Bio,
+    iter: c::bvec_iter,
+}
+
+impl<'a> BioRange<'a> {
+    pub fn bio(&self) -> &'a Bio {
+        self.bio
+    }
+
+    pub fn len(&self) -> u32 {
+        self.iter.bi_size
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.len() == 0
+    }
+
+    /// Where it starts, to save for range_at().
+    pub fn pos(&self) -> c::bvec_iter {
+        self.iter
+    }
+
+    /// Panics past its end.
+    pub fn advance(&mut self, mut bytes: u32) {
+        assert!(bytes <= self.len(), "advancing a bio range of {} bytes by {bytes}", self.len());
+        if self.bio.no_advance_iter() {
+            self.iter.bi_sector += u64::from(bytes >> 9);
+            self.iter.bi_size -= bytes;
+            return;
+        }
+        while bytes != 0 {
+            let n = bytes.min(self.mp_len());
+            self.advance_in_bvec(n);
+            bytes -= n;
+        }
+    }
+
+    /// Its first @bytes. Panics past its end.
+    pub fn take(mut self, bytes: u32) -> Self {
+        assert!(bytes <= self.len(), "the first {bytes} bytes of a bio range of {}", self.len());
+        self.iter.bi_size = bytes;
+        self
+    }
+
+    pub fn segments(self) -> Segments<'a> {
+        Walk::new(self, iter::segment)
+    }
+
+    #[cfg(kernel)]
+    pub fn folios(self) -> Folios<'a> {
+        Walk::new(self, iter::folio)
+    }
+
+    /// As much as both have, copied: how much.
+    pub fn copy_to(&self, dst: &mut [u8]) -> usize {
+        let mut done = 0;
+        for chunk in *self {
+            if done == dst.len() {
+                break;
+            }
+            done += chunk.copy_to(&mut dst[done..]);
+        }
+        done
+    }
+
+    /// As copy_to().
+    pub fn copy_from(&self, src: &[u8]) -> usize {
+        let mut done = 0;
+        for chunk in *self {
+            if done == src.len() {
+                break;
+            }
+            done += chunk.copy_from(&src[done..]);
+        }
+        done
+    }
+
+    /// As much as both have, into @dst: as copy_to(), for memory that can't be
+    /// a slice.
+    pub fn copy_to_volatile(&self, dst: VolatileSlice<'_>) -> usize {
+        let mut done = 0;
+        for chunk in *self {
+            if done == dst.len() {
+                break;
+            }
+            let n = (chunk.len() as usize).min(dst.len() - done);
+            // SAFETY: n of the chunk's bytes, mapped, into n of @dst
+            chunk.with_mapped(|p, _| unsafe { core::ptr::copy_nonoverlapping(p, dst.as_ptr().add(done), n) });
+            done += n;
+        }
+        done
+    }
+
+    /// As copy_to_volatile().
+    pub fn copy_from_volatile(&self, src: VolatileSlice<'_>) -> usize {
+        let mut done = 0;
+        for chunk in *self {
+            if done == src.len() {
+                break;
+            }
+            let n = (chunk.len() as usize).min(src.len() - done);
+            // SAFETY: n of @src into n of the chunk's bytes, mapped
+            chunk.with_mapped(|p, _| unsafe { core::ptr::copy_nonoverlapping(src.as_ptr().add(done), p, n) });
+            done += n;
+        }
+        done
+    }
+
+    pub fn zero(&self) {
+        for chunk in *self {
+            chunk.zero();
+        }
+    }
+
+    // ── bvec.h's arithmetic, on the position: each as the function named ──
+
+    /// __bvec_iter_bvec()
+    fn bvec(&self) -> c::bio_vec {
+        debug_assert!(!self.is_empty());
+        // SAFETY: the invariant - not empty, so its start is in a bvec
+        unsafe { self.bio.bvec(self.iter.bi_idx) }
+    }
+
+    /// mp_bvec_iter_offset(): past the bvec's first page, if it spans pages
+    fn mp_offset(&self) -> u32 {
+        self.bvec().bv_offset + bi_offset!(self.iter)
+    }
+
+    /// mp_bvec_iter_len()
+    fn mp_len(&self) -> u32 {
+        self.len().min(self.bvec().bv_len - bi_offset!(self.iter))
+    }
+
+    /// bio_advance_iter_single(): @bytes within the bvec
+    fn advance_in_bvec(&mut self, bytes: u32) {
+        debug_assert!(bytes <= self.mp_len());
+        let bv_len = self.bvec().bv_len;
+        self.iter.bi_sector += u64::from(bytes >> 9);
+        self.iter.bi_size -= bytes;
+        bi_offset!(self.iter) += bytes;
+        if bi_offset!(self.iter) == bv_len {
+            // INVARIANT: the next bvec, if there's anything left
+            self.iter.bi_idx += 1;
+            bi_offset!(self.iter) = 0;
+        }
+    }
+}
+
+impl<'a> IntoIterator for BioRange<'a> {
+    type Item = Chunk<'a>;
+    type IntoIter = Chunks<'a>;
+
+    fn into_iter(self) -> Chunks<'a> {
+        Walk::new(self, iter::chunk)
+    }
+}
+
+/// # Invariants
+/// @bio is None, or a bio valid for 'a.
+pub struct BioIterator<'a> {
+    bio: Option<NonNull<Bio>>,
+    _p:  PhantomData<&'a Bio>,
+}
+
+impl<'a> Iterator for BioIterator<'a> {
+    type Item = &'a Bio;
+
+    fn next(&mut self) -> Option<&'a Bio> {
+        let bio = self.bio.take()?;
+        // SAFETY: by the invariant
+        let bio = unsafe { bio.as_ref() };
+        // INVARIANT: the next is a bio of the chain too
+        self.bio = NonNull::new(bio.bio.bi_next.cast());
+        Some(bio)
+    }
+}
+
+impl core::iter::FusedIterator for BioIterator<'_> {}
