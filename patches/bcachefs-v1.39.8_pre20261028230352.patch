+// SPDX-License-Identifier: GPL-2.0
+
+//! Reconcile scans: work the work btrees can't find - every extent, the
+//! metadata, a device's, an inode's, the stripes, the pending extents -
+//! requested by option and device changes, and done by the reconcile thread.
+//!
+//! A requested scan is a cookie: a KEY_TYPE_cookie in BTREE_ID_reconcile_scan,
+//! at the scan's cookie_pos(), its value a generation. Requesting bumps it.
+//! The thread reads it - a ScanCookie - does the scan, then complete()s it:
+//! deletes it only if the generation hasn't moved, so a scan requested again
+//! meanwhile, for a change the pass may have missed, is done again.
+//!
+//! Positions are pos(0, n): fs 0, metadata 1, pending 2, stripes 3, a device
+//! 32 + its index, an inode its number, BCACHEFS_ROOT_INO up. Nonzero inodes
+//! are reconcile's btree node backpointers. One of 4..31 is a scan type this
+//! version doesn't know - a newer one's - and is done as an fs scan, which
+//! covers anything narrower: a downgrade loses no scan.
+
+use crate::alloc::backpointers::{backpointer_get_key, BpScanIter};
+use crate::alloc::capacity::DiskReservation;
+use crate::btree::bkey::prelude::*;
+use crate::btree::bkey::{bpos_ge, pos, BkeyI, BkeySC, POS_MIN};
+use crate::btree::iter::{commit_do, lockrestart_do, BtreeIter, BtreeIterFlags, BtreeLevels, BtreeTrans,
+                         CommitFlags, TransAttempt, UpdateTriggerFlags};
+use crate::btree::write_buffer::{WbFlush, WbMaybeFlush};
+use crate::c;
+use crate::data::ec::stripe::WidenCache;
+use crate::data::moving::{key_sectors, MovingCtxt};
+use crate::data::reconcile::needs_reconcile::update_reconcile_opts;
+use crate::errcode::{ret_to_c, BchError};
+use crate::namei::inum_snapshot_to_path;
+use crate::fs::Fs;
+use crate::inode_opts::{get_io_opts, PerSnapshotIoOpts};
+use crate::locking::Lock;
+use crate::sb::counters::events;
+use crate::util::kthread::Kthread;
+use crate::util::Printbuf;
+use crate::{bch_err, SPOS_MAX};
+use core::ffi::c_int;
+use core::ops::Range;
+use cstruct_macros::c_export;
+
+impl c::reconcile_scan {
+    /// The scan for everything.
+    pub fn fs() -> Self {
+        Self::from_arm(c::reconcile_scan_fs {})
+    }
+
+    /// Its cookie's offset in its position: the encoding.
+    fn cookie(&self) -> u64 {
+        use c::ReconcileScanRef as S;
+        match self.get().expect("a scan of a known type") {
+            S::fs(_)       => c::RECONCILE_SCAN_COOKIE_fs.into(),
+            S::metadata(_) => c::RECONCILE_SCAN_COOKIE_metadata.into(),
+            S::pending(_)  => c::RECONCILE_SCAN_COOKIE_pending.into(),
+            S::stripes(_)  => c::RECONCILE_SCAN_COOKIE_stripes.into(),
+            S::device(&d)  => u64::from(c::RECONCILE_SCAN_COOKIE_device + d),
+            S::inum(&i)    => i,
+        }
+    }
+
+    /// Where its cookie is, in BTREE_ID_reconcile_scan.
+    pub fn cookie_pos(&self) -> c::bpos {
+        pos(0, self.cookie())
+    }
+
+    /// The scan whose cookie is @cookie - None for a type this version
+    /// doesn't know.
+    pub fn from_cookie(cookie: u64) -> Option<Self> {
+        Some(match cookie {
+            v if v >= c::BCACHEFS_ROOT_INO.into() => Self::from_arm::<c::reconcile_scan_inum>(v),
+            v if v >= c::RECONCILE_SCAN_COOKIE_device.into() =>
+                Self::from_arm::<c::reconcile_scan_device>((v - u64::from(c::RECONCILE_SCAN_COOKIE_device)) as u32),
+            v if v == c::RECONCILE_SCAN_COOKIE_pending.into()  => Self::from_arm(c::reconcile_scan_pending {}),
+            v if v == c::RECONCILE_SCAN_COOKIE_stripes.into()  => Self::from_arm(c::reconcile_scan_stripes {}),
+            v if v == c::RECONCILE_SCAN_COOKIE_metadata.into() => Self::from_arm(c::reconcile_scan_metadata {}),
+            v if v == c::RECONCILE_SCAN_COOKIE_fs.into()       => Self::fs(),
+            _ => return None,
+        })
+    }
+
+    /// The scan whose cookie is @cookie: one of a type this version doesn't
+    /// know, reported, is an fs scan - see the top of the file.
+    fn at_cookie(fs: &Fs, cookie: u64) -> Self {
+        Self::from_cookie(cookie).unwrap_or_else(|| {
+            bch_err!(fs, "unknown reconcile scan cookie {cookie}");
+            Self::fs()
+        })
+    }
+
+    /// Its type, and which device - by name - or inode - by path, looked up
+    /// in a transaction of its own.
+    pub fn to_text(&self, out: &mut Printbuf, fs: &Fs) {
+        write!(out, "{}", self.type_());
+        match self.get() {
+            Ok(c::ReconcileScanRef::device(&d)) => {
+                write!(out, ": ");
+                fs.member_name_to_text(out, d);
+            }
+            Ok(c::ReconcileScanRef::inum(&i)) => {
+                write!(out, ": ");
+                let trans = crate::btree_trans!(fs);
+                let _ = lockrestart_do(&trans, |t| {
+                    let restore = out.state_save();
+                    inum_snapshot_to_path(t, i, 0, out).inspect_err(|_| out.state_restore(restore))
+                });
+            }
+            _ => {}
+        }
+    }
+}
+
+impl TransAttempt<'_, '_> {
+    /// Request @scan: its cookie's generation bumped, queued in the attempt.
+    pub fn request_scan(&self, scan: c::reconcile_scan) -> Result<(), BchError> {
+        let p = scan.cookie_pos();
+        let mut iter = BtreeIter::new(self, c::btree_id::reconcile_scan, p, BtreeIterFlags::INTENT);
+        let k = iter.peek_slot(self)?.expect("a slot");
+
+        let mut n = BkeyI::<c::Cookie>::new();
+        n.k.p = p;
+        n.v.cookie = (cookie_generation(k) + 1).into();
+        let n = self.bkey_copy(n.as_ref())?;
+        self.update(&iter, &n, UpdateTriggerFlags::empty())
+    }
+
+    /// Whether @scan is requested: its cookie's there.
+    pub fn scan_requested(&self, scan: c::reconcile_scan) -> Result<bool, BchError> {
+        let mut iter = BtreeIter::new(self, c::btree_id::reconcile_scan, scan.cookie_pos(), BtreeIterFlags::empty());
+        Ok(iter.peek_slot(self)?.expect("a slot").arm::<c::Cookie>().is_some())
+    }
+}
+
+impl Fs {
+    /// Request @scan, committed - and kick reconcile, if @wakeup.
+    pub fn request_scan(&self, scan: c::reconcile_scan, wakeup: bool) -> Result<(), BchError> {
+        let trans = crate::btree_trans!(self);
+        commit_do(&trans, None, CommitFlags::NO_ENOSPC, |t| t.request_scan(scan))?;
+        if wakeup {
+            self.reconcile_wakeup();
+        }
+        Ok(())
+    }
+}
+
+/// A cookie's generation: 0 for none.
+fn cookie_generation(k: BkeySC<'_>) -> u64 {
+    k.arm::<c::Cookie>().map_or(0, |c| c.v().cookie.get())
+}
+
+/// A requested scan as the reconcile thread found it: its cookie, at the
+/// generation it was then.
+#[derive(Clone, Copy)]
+pub struct ScanCookie {
+    pub scan:   c::reconcile_scan,
+    pos:        c::bpos,
+    generation: u64,
+}
+
+impl ScanCookie {
+    /// Cookie key @k's - None for a key that isn't one.
+    pub fn from_key(fs: &Fs, k: BkeySC<'_>) -> Option<Self> {
+        let generation = k.arm::<c::Cookie>()?.v().cookie.get();
+        Some(ScanCookie { scan: c::reconcile_scan::at_cookie(fs, k.k.p.offset), pos: k.k.p, generation })
+    }
+
+    /// The scan's done: delete its cookie, unless it's been requested again
+    /// since - whether it was.
+    pub fn complete(self, trans: &BtreeTrans<'_>) -> Result<bool, BchError> {
+        let fs = trans.fs();
+        let mut now = 0;
+        commit_do(trans, None, CommitFlags::NO_ENOSPC, |t| {
+            let mut iter = BtreeIter::new(t, c::btree_id::reconcile_scan, self.pos, BtreeIterFlags::INTENT);
+            now = cookie_generation(iter.peek_slot(t)?.expect("a slot"));
+            if now == self.generation {
+                t.delete_at(&iter, UpdateTriggerFlags::empty())?;
+            }
+            Ok(())
+        })?;
+
+        let deleted = now == self.generation;
+        fs.event_inc_trace(events::reconcile_clear_scan, |out| {
+            self.scan.to_text(out, fs);
+            write!(out, "\nscan started with cookie {} now have {}\n", self.generation, now);
+            write!(out, "{}deleting scan cookie\n", if deleted { "" } else { "not " });
+        });
+        Ok(deleted)
+    }
+}
+
+// ── Option changes in flight ─────────────────────────────────────────────
+//
+// An option change brackets itself with requests - pre and post - so writers'
+// triggers re-derive their keys' reconcile state as the new option lands. A
+// pass that scans while the change is half applied must not complete the
+// cookie: on the error path nothing requests it again. So pre registers the
+// cookie, then requests it, and the reconcile thread doesn't start a scan
+// whose cookie is registered; a pass that started before can't complete it
+// either, the request having moved its generation. The registrations are the
+// change's, dropped when it's done (OptChange).
+//
+// One change at a time - each holds opt_change_lock - so they're the cookies
+// of that one, OPT_CHANGE_SCANS_MAX at most; one cookie twice, from a
+// change that requests it for two options, is two.
+
+/// The most scans one option change requests.
+const OPT_CHANGE_SCANS_MAX: usize = 4;
+
+/// The scans the option change in progress has requested, by cookie.
+pub struct OptChangeScans {
+    nr:      usize,
+    cookies: [u64; OPT_CHANGE_SCANS_MAX],
+}
+
+impl OptChangeScans {
+    pub const fn new() -> Self {
+        OptChangeScans { nr: 0, cookies: [0; OPT_CHANGE_SCANS_MAX] }
+    }
+}
+
+impl Fs {
+    /// An option change is about to change what @scan covers: registered,
+    /// then requested, so writers re-derive against the new option as it
+    /// lands.
+    pub fn opt_change_scan_pre(&self, scan: c::reconcile_scan) -> Result<(), BchError> {
+        Lock::from_c(&self.opt_change_lock).assert_held();
+        {
+            let mut s = self.reconcile.opt_change_scans.lock();
+            assert!(s.nr < OPT_CHANGE_SCANS_MAX, "an option change requesting more than {OPT_CHANGE_SCANS_MAX} scans");
+            let nr = s.nr;
+            s.cookies[nr] = scan.cookie();
+            s.nr += 1;
+        }
+        let trans = crate::btree_trans!(self);
+        commit_do(&trans, None, CommitFlags::NO_ENOSPC, |t| t.request_scan(scan))
+    }
+
+    /// The option change has landed: @scan requested again, now against the
+    /// new option, and reconcile kicked - even if the request failed. Its
+    /// registration is dropped with the change, not here.
+    pub fn opt_change_scan_post(&self, scan: c::reconcile_scan) -> Result<(), BchError> {
+        let trans = crate::btree_trans!(self);
+        let ret = commit_do(&trans, None, CommitFlags::NO_ENOSPC, |t| t.request_scan(scan));
+        self.reconcile_wakeup();
+        ret
+    }
+
+    /// The option change is done, landed or not: OptChange's drop.
+    pub fn opt_change_scans_done(&self) {
+        self.reconcile.opt_change_scans.lock().nr = 0;
+    }
+
+    /// Whether the option change in progress has requested the scan of
+    /// @cookie: the reconcile thread doesn't start it.
+    pub fn scan_in_flight(&self, cookie: u64) -> bool {
+        let s = self.reconcile.opt_change_scans.lock();
+        s.cookies[..s.nr].contains(&cookie)
+    }
+}
+
+// ── Doing them ───────────────────────────────────────────────────────────
+//
+// A scan brings each key it covers in line with its options -
+// update_reconcile_opts(), which queues the work the key now needs - in an
+// attempt per key, committed. It stops (reconcile_scan_stop) if the thread's
+// told to or reconcile's been disabled, its cookie left for the next pass to
+// start again.
+//
+// Each scan counts what it saw in the scan stats, and sets their position as
+// it goes, for the moving contexts' listing - the pass made them the
+// context's.
+
+const NO_ENOSPC: CommitFlags = CommitFlags::NO_ENOSPC;
+
+fn stop(fs: &Fs) -> Result<(), BchError> {
+    if Kthread::should_stop() || !fs.reconcile_enabled() {
+        return Err(c::bch_errcode::BCH_ERR_reconcile_scan_stop.into());
+    }
+    Ok(())
+}
+
+impl ScanCookie {
+    /// Do the scan, then complete it - not a pending scan, which the pass
+    /// completes after its pending phases. The sectors it saw, plus one, so a
+    /// pass that made work for the next doesn't wait - none if it didn't run.
+    ///
+    /// Not a scan the option change in progress has requested: now it would
+    /// see the change half applied, and could complete the cookie - so not
+    /// until it's settled, and opt_change_scan_post()'s wakeup brings the
+    /// thread back.
+    pub fn run<'f>(self, ctxt: &MovingCtxt<'f>, s: &mut PerSnapshotIoOpts, last_flushed: &mut WbMaybeFlush)
+        -> Result<u64, BchError>
+    {
+        use c::ReconcileScanRef as S;
+        let fs: &'f Fs = ctxt.trans().fs();
+
+        if fs.scan_in_flight(self.pos.offset) {
+            return Ok(0);
+        }
+
+        let stats = &fs.reconcile.scan_stats;
+        stats.reset("reconcile_scan");
+        ctxt.set_stats(stats);
+
+        let scan = &self.scan;
+        match scan.get() {
+            Ok(S::fs(_))       => scan_fs(ctxt, scan, s, false)?,
+            Ok(S::metadata(_)) => scan_fs(ctxt, scan, s, true)?,
+            Ok(S::device(&d))  => scan_device(ctxt, scan, d, last_flushed)?,
+            Ok(S::stripes(_))  => scan_stripes(ctxt)?,
+            Ok(S::inum(&i))    => scan_btree(ctxt, scan, s, c::btree_id::extents, 0..1,
+                                             pos(i, 0), pos(i, u64::MAX))?,
+            Ok(S::pending(_)) | Err(_) => {}
+        }
+
+        if !matches!(scan.get(), Ok(S::pending(_))) {
+            self.complete(ctxt.trans())?;
+        }
+        Ok(stats.sectors_seen() + 1)
+    }
+}
+
+/// Every btree's node pointers, and with @metadata unset the extents' and
+/// reflink btrees' leaves.
+fn scan_fs(ctxt: &MovingCtxt<'_>, scan: &c::reconcile_scan, s: &mut PerSnapshotIoOpts, metadata: bool)
+    -> Result<(), BchError>
+{
+    let fs = ctxt.trans().fs();
+    fs.reconcile.progress.init_masks(fs, None, if metadata { 0 } else { !0 }, !0);
+
+    for btree in 0..fs.btree_id_nr_alive() {
+        if fs.btree_id_root(btree).is_none() {
+            continue;
+        }
+        let btree = c::btree_id(btree);
+        let leaves = !metadata && (btree == c::btree_id::extents || btree == c::btree_id::reflink);
+        scan_btree(ctxt, scan, s, btree, u32::from(!leaves)..c::BTREE_MAX_DEPTH, POS_MIN, SPOS_MAX)?;
+    }
+    Ok(())
+}
+
+/// @btree's keys at @levels, from @start to @end. An inode's - a scan of the
+/// extents from a nonzero inode - follows its reflink pointers that may
+/// update options, to the indirect extents they share.
+fn scan_btree(ctxt: &MovingCtxt<'_>, scan: &c::reconcile_scan, s: &mut PerSnapshotIoOpts, btree: c::btree_id,
+              levels: Range<u32>, start: c::bpos, end: c::bpos) -> Result<(), BchError>
+{
+    let trans = ctxt.trans();
+    let fs = trans.fs();
+    let res = DiskReservation::new(fs);
+
+    BtreeLevels { btree, levels, start, end }.for_each_commit(trans, Some(&res), NO_ENOSPC, |t, iter, level, k| {
+        ctxt.stats().walked(iter, key_sectors(fs, k));
+        fs.reconcile.progress.update(t, iter)?;
+        res.put();
+        stop(fs)?;
+
+        let opts = get_io_opts(t, Some(&mut **s), k)?;
+        update_opts(t, Some(&mut **s), &opts, iter, level, k, scan)?;
+
+        if let Some(refs) = k.arm::<c::ReflinkP>()
+            .filter(|p| start.inode != 0 && p.v().may_update_options())
+            .map(|p| p.refd()) {
+            t.ignore_restarts(|trans| scan_indirect(trans, scan, &res, refs, s, &opts))?;
+        }
+        Ok(())
+    })
+}
+
+/// The indirect extents a reflink pointer holds references on, @refs, given
+/// @opts - its inode's: do_reconcile_scan_indirect().
+fn scan_indirect(trans: &BtreeTrans<'_>, scan: &c::reconcile_scan, res: &DiskReservation<'_>, refs: Range<u64>,
+                 s: &mut PerSnapshotIoOpts, opts: &c::bch_inode_opts) -> Result<(), BchError>
+{
+    let mut iter = BtreeIter::new(trans, c::btree_id::reflink, pos(0, refs.start),
+                                  BtreeIterFlags::INTENT | BtreeIterFlags::NOT_EXTENTS);
+    iter.for_each_commit(trans, Some(res), NO_ENOSPC, |t, iter, k| {
+        if bpos_ge(k.k.start_pos(), pos(0, refs.end)) {
+            return Err(c::bch_errcode::BCH_ERR_fc_break.into());
+        }
+        res.put();
+        update_opts(t, Some(&mut **s), opts, iter, 0, k, scan)
+    })
+}
+
+/// Device @dev's data, through its backpointers: what a change to its state
+/// or durability changes.
+fn scan_device(ctxt: &MovingCtxt<'_>, scan: &c::reconcile_scan, dev: u32, last_flushed: &mut WbMaybeFlush)
+    -> Result<(), BchError>
+{
+    let trans = ctxt.trans();
+    let fs = trans.fs();
+    let mut bps = BpScanIter::new(c::btree_id::backpointers, pos(dev.into(), 0), None);
+
+    bps.for_each(trans, pos(dev.into(), u64::MAX), last_flushed.borrow(), |t, bp, last_flushed| {
+        ctxt.stats().set_pos(c::bbpos { btree: c::btree_id::backpointers, pos: bp.k.p });
+        stop(fs)?;
+        scan_bp(t, scan, bp, last_flushed)?;
+        t.commit(Some(&DiskReservation::new(fs)), NO_ENOSPC)
+    })
+}
+
+/// What backpointer @bp points to - not an erasure coded extent: it's
+/// handled at its stripe.
+fn scan_bp(t: &TransAttempt<'_, '_>, scan: &c::reconcile_scan, bp: BkeySC<'_, c::Backpointer>,
+           last_flushed: WbFlush<'_>) -> Result<(), BchError>
+{
+    if bp.v().erasure_coded() {
+        return Ok(());
+    }
+
+    let fs = t.fs();
+    let level = bp.v().level.into();
+    let mut iter = BtreeIter::uninit();
+    let Some((iter, k)) = backpointer_get_key(t, bp, &mut iter, BtreeIterFlags::INTENT, last_flushed)? else {
+        return Ok(());
+    };
+
+    fs.reconcile.scan_stats.add_sectors_seen(key_sectors(fs, k));
+    let opts = get_io_opts(t, None, k)?;
+    update_opts(t, None, &opts, iter, level, k, scan)
+}
+
+/// The stripes' can_widen, against the RW members their disk labels have
+/// now - what a device's state changing changes.
+fn scan_stripes(ctxt: &MovingCtxt<'_>) -> Result<(), BchError> {
+    let trans = ctxt.trans();
+    let fs = trans.fs();
+    let mut cache = WidenCache::new();
+    fs.reconcile.progress.init_masks(fs, None, 1 << c::btree_id::stripes.0, 0);
+
+    let mut iter = BtreeIter::new(trans, c::btree_id::stripes, POS_MIN, BtreeIterFlags::PREFETCH);
+    iter.for_each_commit(trans, None, NO_ENOSPC, |t, iter, k| {
+        ctxt.stats().walked(iter, fs.btree_sectors().into());
+        fs.reconcile.progress.update(t, iter)?;
+        stop(fs)?;
+
+        let Some(s) = k.arm::<c::Stripe>() else { return Ok(()) };
+        let want = cache.can_widen(fs, s.v())?;
+        if s.v().can_widen() != want {
+            let mut u = t.bkey_make_mut(iter, s, UpdateTriggerFlags::empty())?;
+            u.v_mut().bits.set_can_widen(want);
+        }
+        Ok(())
+    })
+}
+
+/// update_reconcile_opts(), for a scan: traced as the scan's.
+fn update_opts(t: &TransAttempt<'_, '_>, s: Option<&mut c::per_snapshot_io_opts>, opts: &c::bch_inode_opts,
+               iter: &BtreeIter<'_>, level: u32, k: BkeySC<'_>, scan: &c::reconcile_scan) -> Result<(), BchError>
+{
+    let fs = t.fs();
+    let sectors = if level == 0 { k.k.size.into() } else { fs.btree_sectors().into() };
+    let msg = |out: &mut Printbuf| write!(out, "{}", k.to_text(fs));
+
+    macro_rules! trace {
+        ($(($n:ident)),* $(,)?) => { crate::paste! {
+            match scan.type_() {
+                $(c::reconcile_scan_type::[<RECONCILE_SCAN_ $n>] =>
+                    fs.event_add_trace(events::[<reconcile_scan_ $n>], sectors, msg),)*
+            }
+        } };
+    }
+    c::RECONCILE_SCAN_TYPES!(trace);
+
+    update_reconcile_opts(t, s, opts, iter, level, k, c::set_needs_reconcile_ctx::SET_NEEDS_RECONCILE_opt_change)
+}
+
+// ── C's ──────────────────────────────────────────────────────────────────
+//
+// dev.c's, until it's Rust.
+
+#[c_export]
+pub fn bch2_set_reconcile_needs_scan(c: &Fs, s: c::reconcile_scan, wakeup: bool) -> c_int {
+    ret_to_c(c.request_scan(s, wakeup))
+}
+
+/// The set_fs_needs_reconcile recovery pass, once, upgrading from
+/// rebalance_work: an fs scan, which gives every extent its reconcile state.
+#[c_export]
+pub fn bch2_set_fs_needs_reconcile(c: &Fs) -> c_int {
+    ret_to_c(c.request_scan(c::reconcile_scan::fs(), true))
+}
diff --git a/fs/bcachefs/data/reconcile/trigger.c b/fs/bcachefs/data/reconcile/trigger.c
new file mode 100644
index 0000000..2b46cc3
--- /dev/null
+++ b/fs/bcachefs/data/reconcile/trigger.c
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include "bcachefs.h"
+
+#include "btree/interior.h"
+#include "btree/update.h"
+
+#include "data/reconcile/trigger.h"
+
+#include "init/error.h"
+
+struct bkey_s_c reconcile_bp_get_key(struct btree_trans *trans,
+				     struct btree_iter *iter,
+				     struct bkey_s_c_backpointer bp)
+{
+	struct bch_fs *c = trans->c;
+	int ret = 0;
+	CLASS(printbuf, buf)();
+
+	/*
+	 * we're still using fsck_err() here, which does a goto, which has
+	 * problems with CLASS()
+	 */
+	CLASS(btree_iter_uninit, iter2)(trans);
+
+	/* don't allow bps to non btree nodes: */
+	if (fsck_err_on(!bp.v->level,
+			trans, reconcile_bp_to_leaf_node_key,
+			"reconcile bp to leaf node key\n%s",
+			(bch2_bkey_val_to_text(&buf, c, bp.s_c), buf.buf))) {
+		ret =   bch2_btree_delete(trans, BTREE_ID_reconcile_scan, bp.k->p, 0) ?:
+			bch2_trans_commit(trans, NULL, NULL, BCH_TRANS_COMMIT_no_enospc);
+		return ret ? bkey_s_c_err(ret) : bkey_s_c_null;
+	}
+
+	bch2_trans_node_iter_init(trans, iter, bp.v->btree_id, bp.v->pos, 0, bp.v->level, 0);
+
+	/* walk down a level - we need to have the node pointed to locked, not
+	 * the parent node, for synchronization with btree_node_update_key when
+	 * the node isn't yet written */
+
+	bch2_trans_node_iter_init(trans, &iter2, bp.v->btree_id, bp.v->pos, 0, bp.v->level - 1, 0);
+	struct btree *b = bch2_btree_iter_peek_node(&iter2);
+	if (IS_ERR(b))
+		return bkey_s_c_err(PTR_ERR(b));
+
+	struct bkey_s_c k = bkey_s_c_null;
+	if (b) {
+		if (btree_node_will_make_reachable(b))
+			return bkey_s_c_null;
+
+		k = bkey_i_to_s_c(&b->key);
+		if (bpos_eq(bp.k->p, bch2_bkey_get_reconcile_bp_pos(c, k)))
+			return k;
+	}
+
+	prt_printf(&buf, "reconcile backpointer to missing/incorrect btree ptr\n");
+	bch2_bkey_val_to_text(&buf, c, bp.s_c);
+	prt_newline(&buf);
+	if (k.k)
+		bch2_bkey_val_to_text(&buf, c, k);
+	else
+		prt_str(&buf, "(no key)");
+
+	if (b) {
+		prt_newline(&buf);
+		bch2_bkey_val_to_text(&buf, c, bkey_i_to_s_c(&b->key));
+	}
+
+	if (fsck_err(trans, reconcile_bp_to_missing_btree_ptr, "%s", buf.buf))
+		ret =   bch2_btree_delete(trans, BTREE_ID_reconcile_scan, bp.k->p, 0) ?:
+			bch2_trans_commit(trans, NULL, NULL, BCH_TRANS_COMMIT_no_enospc);
+fsck_err:
+	return ret ? bkey_s_c_err(ret) : bkey_s_c_null;
+}
diff --git a/fs/bcachefs/data/reconcile/trigger.h b/fs/bcachefs/data/reconcile/trigger.h
new file mode 100644
index 0000000..9b11dd6
--- /dev/null
+++ b/fs/bcachefs/data/reconcile/trigger.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_RECONCILE_TRIGGER_H
+#define _BCACHEFS_RECONCILE_TRIGGER_H
+
+#include "data/extents.h"
+#include "data/reconcile/needs_reconcile_gen.h"
+#include "data/reconcile/trigger_gen.h"
+#include "fs/inode_opts_gen.h"
+
+static inline struct bpos data_to_rb_work_pos(enum btree_id btree, struct bpos pos)
+{
+	if (btree == BTREE_ID_reflink ||
+	    btree == BTREE_ID_stripes)
+		pos = bpos_min(pos, POS(0, U64_MAX));
+
+	if (btree == BTREE_ID_extents)
+		pos = bpos_max(pos, POS(BCACHEFS_ROOT_INO, 0));
+
+	if (btree == BTREE_ID_reflink)
+		pos.inode++;
+	return pos;
+}
+
+static inline struct bbpos rb_work_to_data_pos(struct bpos pos)
+{
+	if (!pos.inode)
+		return BBPOS(BTREE_ID_stripes, pos);
+	if (pos.inode < BCACHEFS_ROOT_INO) {
+		--pos.inode;
+		return BBPOS(BTREE_ID_reflink, pos);
+	}
+	return BBPOS(BTREE_ID_extents, pos);
+}
+
+static inline enum reconcile_work_id rb_work_id(const struct bch_extent_reconcile *r)
+{
+	if (!r || !r->need_rb)
+		return RECONCILE_WORK_none;
+	if (r->pending)
+		return RECONCILE_WORK_pending;
+	if (r->hipri)
+		return RECONCILE_WORK_hipri;
+	return RECONCILE_WORK_normal;
+}
+
+static inline enum reconcile_work_id rb_work_id_phys(enum reconcile_work_id w)
+{
+	return w == RECONCILE_WORK_pending ? RECONCILE_WORK_none : w;
+}
+
+static inline struct bch_extent_reconcile io_opts_to_reconcile_opts(struct bch_fs *c,
+								    struct bch_inode_opts *opts)
+{
+	return (struct bch_extent_reconcile) {
+		.type = BIT(BCH_EXTENT_ENTRY_reconcile),
+#define x(_name)							\
+		._name = opts->_name,					\
+		._name##_from_inode = opts->_name##_from_inode,
+		BCH_RECONCILE_OPTS()
+#undef x
+	};
+};
+
+static inline struct bch_backpointer rb_bp(enum btree_id btree, unsigned level, struct bkey_s_c k)
+{
+	return (struct bch_backpointer) {
+		.btree_id	= btree,
+		.level		= level,
+		.pos		= k.k->p,
+	};
+}
+
+static inline struct per_snapshot_io_opts per_snapshot_io_opts_init(struct bch_fs *c)
+{
+	return (struct per_snapshot_io_opts) {
+		/* io_opts->fs_io_opts will be initialized when we know the key type */
+		.fs_io_opts.change_cookie = c->opt_change_cookie - 1,
+	};
+}
+
+static inline void per_snapshot_io_opts_exit(struct per_snapshot_io_opts *io_opts)
+{
+	darray_exit(&io_opts->d);
+}
+
+DEFINE_CLASS(per_snapshot_io_opts, struct per_snapshot_io_opts,
+	     per_snapshot_io_opts_exit(&_T),
+	     per_snapshot_io_opts_init(c),
+	     struct bch_fs *c);
+
+#endif /* _BCACHEFS_RECONCILE_TRIGGER_H */
diff --git a/fs/bcachefs/data/reconcile/trigger.rs b/fs/bcachefs/data/reconcile/trigger.rs
new file mode 100644
index 0000000..b79549a
--- /dev/null
+++ b/fs/bcachefs/data/reconcile/trigger.rs
@@ -0,0 +1,417 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Reconcile's state in a key - trigger.c's, as it converts: the reconcile
+//! entry, what work is pending and the io options it was computed from, and a
+//! btree node pointer's reconcile_bp entry, its backpointer's position in the
+//! reconcile_scan btree.
+
+use crate::{accounting, bkey_fsck_err_on, fsck_err};
+use crate::alloc::disk_groups::Target;
+use crate::btree::bkey::{bpos_max, bpos_min, pos, BkeySC, BkeyV, BkeyVal};
+use crate::btree::bkey_methods::TriggerOp;
+use crate::btree::iter::{BtreeIter, BtreeIterFlags, NoRoom, TransAttempt, TransBkey, UpdateTriggerFlags};
+use crate::c;
+use crate::data::ptrs::{BkeyVPtrs, BkeyVPtrsMut, ExtentEntry, ExtentEntryMut, Ptrs, PtrsMut};
+use crate::errcode::BchError;
+use crate::fs::Fs;
+use crate::init::error::{id, BkeyValidate};
+use crate::util::vstructs::{plain_bytes, Validated};
+use crate::util::{Printbuf, ToText};
+use core::mem::size_of;
+use cstruct_macros::c_export;
+
+/// The work btree a key with @r is tracked in: rb_work_id().
+pub fn rb_work_id(r: Option<&c::bch_extent_reconcile>) -> c::reconcile_work_id {
+    use c::reconcile_work_id as w;
+    match r {
+        Some(r) if r.need_rb() != 0 =>
+            if r.pending() != 0 { w::RECONCILE_WORK_pending }
+            else if r.hipri() != 0 { w::RECONCILE_WORK_hipri }
+            else { w::RECONCILE_WORK_normal },
+        _ => w::RECONCILE_WORK_none,
+    }
+}
+
+impl c::reconcile_work_id {
+    /// The btree this work is tracked in, none for none: reconcile_work_btree[].
+    pub fn btree(self) -> Option<c::btree_id> {
+        use c::reconcile_work_id as w;
+        Some(match self {
+            w::RECONCILE_WORK_hipri   => c::btree_id::reconcile_hipri,
+            w::RECONCILE_WORK_normal  => c::btree_id::reconcile_work,
+            w::RECONCILE_WORK_pending => c::btree_id::reconcile_pending,
+            _ => return None,
+        })
+    }
+
+    /// The work its backpointers' phys bits track: pending work has none,
+    /// as there's nothing to move yet - rb_work_id_phys().
+    pub fn phys(self) -> Self {
+        if self == Self::RECONCILE_WORK_pending { Self::RECONCILE_WORK_none } else { self }
+    }
+
+    /// The phys btree work with this id is tracked in, by bucket position:
+    /// reconcile_work_phys_btree[].
+    pub fn phys_btree(self) -> Option<c::btree_id> {
+        use c::reconcile_work_id as w;
+        Some(match self {
+            w::RECONCILE_WORK_hipri  => c::btree_id::reconcile_hipri_phys,
+            w::RECONCILE_WORK_normal => c::btree_id::reconcile_work_phys,
+            _ => return None,
+        })
+    }
+}
+
+/// Where a key at @p in @btree is in the work btrees: stripes at inode 0,
+/// reflink at 1 - its inode 0, moved up - and extents, whose inodes start at
+/// BCACHEFS_ROOT_INO, after them. data_to_rb_work_pos().
+pub fn data_to_rb_work_pos(btree: c::btree_id, mut p: c::bpos) -> c::bpos {
+    use c::btree_id as b;
+    if btree == b::reflink || btree == b::stripes {
+        p = bpos_min(p, pos(0, u64::MAX));
+    }
+    if btree == b::extents {
+        p = bpos_max(p, pos(c::BCACHEFS_ROOT_INO as u64, 0));
+    }
+    if btree == b::reflink {
+        p.inode += 1;
+    }
+    p
+}
+
+/// The data btree position at @p in the work btrees: rb_work_to_data_pos(),
+/// data_to_rb_work_pos() backwards.
+pub fn rb_work_to_data_pos(mut p: c::bpos) -> c::bbpos {
+    let btree = if p.inode == 0 {
+        c::btree_id::stripes
+    } else if p.inode < c::BCACHEFS_ROOT_INO as u64 {
+        p.inode -= 1;
+        c::btree_id::reflink
+    } else {
+        c::btree_id::extents
+    };
+    c::bbpos { btree, pos: p }
+}
+
+/// What a key carries for reconcile: a key with pointers' entries, and any
+/// key's work btree.
+pub trait BkeyVReconcile: BkeyV {
+    /// Its reconcile entry: bch2_bkey_reconcile_opts().
+    fn reconcile_opts(&self, fs: &Fs) -> Option<&c::bch_extent_reconcile>
+    where Self: BkeyVPtrs
+    {
+        self.extent_entries(fs).find_map(|e| match e {
+            ExtentEntry::reconcile(r) => Some(r),
+            _ => None,
+        })
+    }
+
+    /// The index its reconcile_bp entry has, 0 without one:
+    /// bch2_bkey_get_reconcile_bp().
+    fn reconcile_bp_idx(&self, fs: &Fs) -> u64
+    where Self: BkeyVPtrs
+    {
+        self.extent_entries(fs).find_map(|e| match e {
+            ExtentEntry::reconcile_bp(bp) => Some(bp.idx()),
+            _ => None,
+        }).unwrap_or(0)
+    }
+
+    /// Its reconcile backpointer's position: its work id, and its
+    /// reconcile_bp entry's index. bch2_bkey_get_reconcile_bp_pos().
+    fn reconcile_bp_pos(&self, fs: &Fs) -> c::bpos
+    where Self: BkeyVPtrs
+    {
+        pos(rb_work_id(self.reconcile_opts(fs)).0.into(), self.reconcile_bp_idx(fs))
+    }
+
+    /// The work btree it's tracked in - a stripe's by its needs_reconcile, as
+    /// stripes have no reconcile entry: bch2_bkey_reconcile_work_id().
+    fn reconcile_work_id(&self, fs: &Fs) -> c::reconcile_work_id
+    where Self::V: BkeyVal<State = Validated>
+    {
+        let key = self.as_sc();
+        if let Some(s) = key.arm::<c::Stripe>() {
+            return if s.v().needs_reconcile() != 0 {
+                c::reconcile_work_id::RECONCILE_WORK_hipri
+            } else {
+                c::reconcile_work_id::RECONCILE_WORK_none
+            };
+        }
+        key.arm::<Ptrs>().map_or(c::reconcile_work_id::RECONCILE_WORK_none, |k| rb_work_id(k.reconcile_opts(fs)))
+    }
+}
+
+impl<K: BkeyV> BkeyVReconcile for K {}
+
+impl TransBkey<'_, '_, PtrsMut> {
+    /// Its reconcile_bp entry made @idx - dropped for 0, appended if it has
+    /// none: bch2_bkey_set_reconcile_bp().
+    pub fn set_reconcile_bp(&mut self, fs: &Fs, idx: u64) -> Result<(), NoRoom> {
+        let bp = self.extent_entries_mut_at(fs).find_map(|(at, e)| match e {
+            ExtentEntryMut::reconcile_bp(bp) => Some((at, bp)),
+            _ => None,
+        });
+
+        match bp {
+            Some((at, _)) if idx == 0 => self.drop_entry(fs, at),
+            Some((_, bp)) => bp.set_idx(idx),
+            None if idx != 0 => {
+                let end = self.entries_end();
+                self.insert_entry(end, &[c::bch_extent_reconcile_bp::new().with_idx(idx).into_bits()])?;
+            }
+            None => {}
+        }
+        Ok(())
+    }
+}
+
+// ── reconcile backpointers ───────────────────────────────────────────────
+
+/// The reconcile backpointer btree node pointer @k, in @btree at @level, has:
+/// rb_bp().
+pub(crate) fn rb_bp(btree: c::btree_id, level: u32, k: BkeySC<'_>) -> c::Backpointer {
+    c::Backpointer { btree_id: btree.0 as u8, level: level as u8, pos: k.k.p, ..Default::default() }
+}
+
+/// Delete btree node pointer @k's reconcile backpointer at @bp_pos - if it is
+/// @k's; else that's reported, and there's nothing to delete:
+/// reconcile_bp_del().
+fn del_reconcile_bp(t: &TransAttempt<'_, '_>, btree: c::btree_id, level: u32, k: BkeySC<'_>,
+                    bp_pos: c::bpos) -> Result<(), BchError> {
+    let fs = t.fs();
+    let mut iter = BtreeIter::new(t, c::btree_id::reconcile_scan, bp_pos, BtreeIterFlags::INTENT);
+    let bp_k = iter.peek_slot(t)?.expect("a slot");
+    let want = rb_bp(btree, level, k);
+
+    if !bp_k.arm::<c::Backpointer>().is_some_and(|bp| plain_bytes(bp.v()) == plain_bytes(&want)) {
+        fsck_err!(t, id::btree_ptr_to_bad_reconcile_bp,
+                  "btree ptr points to bad/missing reconcile bp\n{}\n{}", k.to_text(fs), bp_k.to_text(fs))?;
+        return Ok(());
+    }
+    t.delete_at(&iter, UpdateTriggerFlags::empty())
+}
+
+/// A reconcile backpointer to btree node pointer @k, in the first empty slot
+/// of work id @work's: where it went. reconcile_bp_add().
+pub(crate) fn add_reconcile_bp(t: &TransAttempt<'_, '_>, btree: c::btree_id, level: u32, k: BkeySC<'_>,
+                    work: u64) -> Result<c::bpos, BchError> {
+    let mut iter = BtreeIter::uninit();
+    t.bkey_get_empty_slot(&mut iter, c::btree_id::reconcile_scan, pos(work, 1), pos(work, u64::MAX))?;
+
+    let mut bp = t.bkey_alloc_typed::<c::Backpointer>()?;
+    bp.k_mut().p = iter.pos();
+    *bp.v_mut() = rb_bp(btree, level, k);
+    t.update(&iter, &bp, UpdateTriggerFlags::empty())?;
+    Ok(iter.pos())
+}
+
+// ── the trigger ──────────────────────────────────────────────────────────
+
+/// What a reconcile entry counts toward reconcile_work accounting: its need_rb
+/// bits - their accounting types are BCH_RECONCILE_OPTS()'s order - pending in
+/// place of target and replicas, or high_priority added: rb_accounting_counters().
+fn rb_accounting_counters(r: Option<&c::bch_extent_reconcile>) -> u32 {
+    use c::bch_reconcile_accounting_type as a;
+    let Some(r) = r else { return 0 };
+    let mut ret = u32::from(r.need_rb());
+    if r.pending() != 0 {
+        ret |= 1 << a::BCH_RECONCILE_ACCOUNTING_pending.0;
+        ret &= !(1 << a::BCH_RECONCILE_ACCOUNTING_target.0 | 1 << a::BCH_RECONCILE_ACCOUNTING_replicas.0);
+    } else if r.hipri() != 0 {
+        ret |= 1 << a::BCH_RECONCILE_ACCOUNTING_high_priority.0;
+    }
+    ret
+}
+
+/// dev_leaving accounting for @k's pointers moving off their devices - @r's
+/// ptrs_moving, by index among the pointers - unless the move is pending:
+/// trigger_dev_counters().
+fn trigger_dev_counters(t: &TransAttempt<'_, '_>, sectors: Option<u32>, k: BkeySC<'_>,
+                        r: Option<&c::bch_extent_reconcile>, flags: UpdateTriggerFlags) -> Result<(), BchError> {
+    let Some(r) = r.filter(|r| r.ptrs_moving() != 0 && r.pending() == 0) else { return Ok(()) };
+    let Some(k) = k.arm::<Ptrs>() else { return Ok(()) };
+
+    for (i, d) in k.ptrs_decoded(t.fs()).enumerate() {
+        if u32::from(r.ptrs_moving()) >> i & 1 != 0 {
+            let v = i64::from(sectors.unwrap_or(d.p.crc.compressed_size));
+            let v = if flags.contains(UpdateTriggerFlags::OVERWRITE) { -v } else { v };
+            let acct = c::disk_accounting_pos::from_arm(c::bch_acct_dev_leaving { dev: d.ptr.dev().into() });
+            accounting::add(t, &acct, &[v], flags.contains(UpdateTriggerFlags::GC))?;
+        }
+    }
+    Ok(())
+}
+
+/// Reconcile's part of the extent trigger, for a key with or getting a
+/// reconcile entry: bch2_trigger_extent_reconcile(). The key's work btree bit
+/// - or a btree node pointer's reconcile backpointer, moved to its new work
+/// id's and recorded in its reconcile_bp entry - then the reconcile_work
+/// accounting and dev_leaving counters.
+pub(crate) fn trigger_extent_reconcile(t: &TransAttempt<'_, '_>, op: &mut TriggerOp<'_>) -> Result<(), BchError> {
+    let fs = t.fs();
+    let old_r = op.old.arm::<Ptrs>().and_then(|k| k.reconcile_opts(fs).copied());
+    let new_r = BkeySC::from(&op.new).untyped().arm::<Ptrs>().and_then(|k| k.reconcile_opts(fs).copied());
+
+    let needs_trigger = |r: Option<c::bch_extent_reconcile>| r.is_some_and(|r| r.need_rb() | r.ptrs_moving() != 0);
+    if !needs_trigger(old_r) && !needs_trigger(new_r) {
+        return Ok(());
+    }
+
+    let (old_r, new_r) = (old_r.as_ref(), new_r.as_ref());
+    let flags = op.flags;
+
+    if flags.contains(UpdateTriggerFlags::TRANSACTIONAL) {
+        let (old_work, new_work) = (rb_work_id(old_r), rb_work_id(new_r));
+
+        if op.level == 0 {
+            if old_work != new_work {
+                // the work btrees index reflink and stripes ahead of extents
+                let pos = data_to_rb_work_pos(op.btree, op.new.k.p);
+                for (w, set) in [(old_work, false), (new_work, true)] {
+                    if let Some(btree) = w.btree() {
+                        t.bit_mod_buffered(btree, pos, set)?;
+                    }
+                }
+            }
+        } else {
+            let old_bp = op.old.arm::<Ptrs>().map_or(0, |k| k.reconcile_bp_idx(fs));
+            let mut bp = pos(old_work.0.into(), old_bp);
+
+            if bp.inode != u64::from(new_work.0) && bp.offset != 0 {
+                del_reconcile_bp(t, op.btree, op.level, op.old, bp)?;
+                bp.offset = 0;
+            }
+            bp.inode = new_work.0.into();
+
+            if flags.contains(UpdateTriggerFlags::INSERT) {
+                let (btree, level) = (op.btree, op.level);
+                let needed = u32::from(op.new.k.u64s) +
+                    (size_of::<c::bch_extent_reconcile_bp>() / size_of::<u64>()) as u32;
+                let k = op.new_with_room(t, needed)?;
+
+                if bp.inode != 0 && bp.offset == 0 {
+                    bp = add_reconcile_bp(t, btree, level, k.as_sc(), bp.inode)?;
+                }
+                k.arm::<PtrsMut>().expect("a btree node pointer, whose entries can be edited")
+                    .set_reconcile_bp(fs, bp.offset)
+                    .expect("room for a reconcile_bp entry: just made");
+            }
+        }
+    }
+
+    if flags.intersects(UpdateTriggerFlags::TRANSACTIONAL | UpdateTriggerFlags::GC) {
+        let new = BkeySC::from(&op.new).untyped();
+        // a btree node's sectors, where its pointer's size is 0
+        let sectors = (op.level != 0).then(|| fs.btree_sectors());
+        let old_size = i64::from(sectors.unwrap_or(op.old.k.size));
+        let new_size = i64::from(sectors.unwrap_or(new.k.size));
+
+        let (old_a, new_a) = (rb_accounting_counters(old_r), rb_accounting_counters(new_r));
+        let mut delta = if old_size == new_size { old_a ^ new_a } else { old_a | new_a };
+
+        while delta != 0 {
+            let ty = delta.trailing_zeros();
+            delta &= delta - 1;
+
+            // [data, metadata] sectors
+            let mut v = [0i64; 2];
+            let i = usize::from(sectors.is_some());
+            if old_a >> ty & 1 != 0 {
+                v[i] -= old_size;
+            }
+            if new_a >> ty & 1 != 0 {
+                v[i] += new_size;
+            }
+            let acct = c::disk_accounting_pos::from_arm(c::bch_acct_reconcile_work { type_: ty as u8 });
+            accounting::add(t, &acct, &v, flags.contains(UpdateTriggerFlags::GC))?;
+        }
+
+        trigger_dev_counters(t, sectors, op.old, old_r, flags - UpdateTriggerFlags::INSERT)?;
+        trigger_dev_counters(t, sectors, new, new_r, flags - UpdateTriggerFlags::OVERWRITE)?;
+    }
+    Ok(())
+}
+
+/// A reconcile entry against itself: bch2_extent_reconcile_validate().
+pub fn extent_reconcile_validate(v: &BkeyValidate<'_, '_>, r: &c::bch_extent_reconcile) -> Result<(), BchError> {
+    bkey_fsck_err_on!(v, r.pending() != 0 && r.need_rb() == 0, id::extent_reconcile_bad_pending,
+                      "pending incorrectly set")?;
+    bkey_fsck_err_on!(v, r.hipri() != 0 &&
+                         r.need_rb() & (1 << c::bch_reconcile_opts::BCH_RECONCILE_data_replicas.0) == 0,
+                      id::extent_reconcile_bad_hipri, "hipri incorrectly set")?;
+    bkey_fsck_err_on!(v, r.data_replicas() == 0, id::extent_reconcile_bad_replicas, "bad replicas")
+}
+
+/// The io options a reconcile entry, or a rebalance_v1 one, holds - each
+/// marked if it's the inode's: what the two to_text share.
+macro_rules! reconcile_opts_to_text {
+    ($out:expr, $fs:expr, $r:expr) => {{
+        let (out, fs, r): (&mut Printbuf, Option<&Fs>, _) = ($out, $fs, $r);
+        let from_inode = |out: &mut Printbuf, v: u8| if v != 0 { write!(out, " (inode)") };
+        let target = |out: &mut Printbuf, t: u16| match fs {
+            Some(fs) => fs.target_to_text(out, Target::decode(t.into())),
+            None => write!(out, "{t}"),
+        };
+
+        write!(out, "replicas={}", r.data_replicas());
+        from_inode(out, r.data_replicas_from_inode());
+
+        write!(out, " checksum=");
+        c::bch_csum_opt(r.data_checksum().into()).to_text(out);
+        from_inode(out, r.data_checksum_from_inode());
+
+        if r.background_compression() != 0 || r.background_compression_from_inode() != 0 {
+            write!(out, " background_compression=");
+            crate::data::compress::opt_to_text(out, r.background_compression().into());
+            from_inode(out, r.background_compression_from_inode());
+        }
+        if r.background_target() != 0 || r.background_target_from_inode() != 0 {
+            write!(out, " background_target=");
+            target(out, r.background_target());
+            from_inode(out, r.background_target_from_inode());
+        }
+        if r.promote_target() != 0 || r.promote_target_from_inode() != 0 {
+            write!(out, " promote_target=");
+            target(out, r.promote_target());
+            from_inode(out, r.promote_target_from_inode());
+        }
+        if r.erasure_code() != 0 || r.erasure_code_from_inode() != 0 {
+            write!(out, " ec={}", r.erasure_code());
+            from_inode(out, r.erasure_code_from_inode());
+        }
+    }};
+}
+
+/// bch2_extent_rebalance_v1_to_text().
+pub fn extent_rebalance_v1_to_text(out: &mut Printbuf, fs: Option<&Fs>, r: &c::bch_extent_rebalance_v1) {
+    reconcile_opts_to_text!(out, fs, r);
+}
+
+/// What it needs, then its options: bch2_extent_reconcile_to_text().
+pub fn extent_reconcile_to_text(out: &mut Printbuf, fs: Option<&Fs>, r: &c::bch_extent_reconcile) {
+    write!(out, "need_rb=");
+    crate::util::names::prt_set::<c::bch_reconcile_opts>(out, r.need_rb().into());
+    if r.hipri() != 0 {
+        write!(out, " hipri");
+    }
+    if r.pending() != 0 {
+        write!(out, " pending");
+    }
+    write!(out, " ");
+    reconcile_opts_to_text!(out, fs, r);
+}
+
+// ── C's ──────────────────────────────────────────────────────────────────
+
+#[c_export]
+pub fn bch2_bkey_reconcile_work_id(c: &Fs, k: BkeySC<'_>) -> c::reconcile_work_id {
+    k.reconcile_work_id(c)
+}
+
+/// POS_MIN for a key without pointers.
+#[c_export]
+pub fn bch2_bkey_get_reconcile_bp_pos(c: &Fs, k: BkeySC<'_>) -> c::bpos {
+    k.arm::<Ptrs>().map_or(pos(0, 0), |k| k.reconcile_bp_pos(c))
+}
+
