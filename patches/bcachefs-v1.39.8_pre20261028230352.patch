+static int kern_soh_to_loglevel(const char *fmt)
+{
+	if (fmt[0] == KERN_SOH[0] &&
+	    fmt[1] >= '0' && fmt[1] <= '9')
+		return fmt[1] - '0';
+	else
+		return -1;
+}
+
+static unsigned loglevel_opt(struct bch_fs *c)
+{
+	return c->loglevel ?: c->opts.verbose ? 7: 6;
+}
+
+void bch2_print_str_loglevel(struct bch_fs *c, int loglevel, const char *str)
+{
+	unsigned len = strlen(str);
+	/*
+	 * printbufs leave extra spaces from indent level after the last
+	 * newline; strip them
+	 */
+	unsigned l = len;
+	while (l && str[l - 1] == ' ')
+		--l;
+	if (!l || str[l - 1] == '\n')
+		len = l;
+	if (!len)
+		return;
+
+	if (loglevel < 0)
+		loglevel = c->prev_loglevel;
+	else
+		c->prev_loglevel = loglevel;
+
+	if (loglevel > loglevel_opt(c))
+		return;
+
+#ifdef __KERNEL__
+	static const char *prefixes[] = {
+		KERN_SOH "0",
+		KERN_SOH "1",
+		KERN_SOH "2",
+		KERN_SOH "3",
+		KERN_SOH "4",
+		KERN_SOH "5",
+		KERN_SOH "6",
+		KERN_SOH "7",
+	};
+	const char *prefix = loglevel < ARRAY_SIZE(prefixes) ? prefixes[loglevel] : KERN_SOH;
+#else
+	const char *prefix = "";
+#endif
+
+#ifdef __KERNEL__
+	struct stdio_redirect *stdio = bch2_fs_stdio_redirect_log(c);
+
+	if (unlikely(stdio)) {
+		bch2_stdio_redirect_write(stdio, true, str, len);
+		return;
+	}
+#endif
+	bch2_print_string_as_lines(prefix, str);
+}
+
+void bch2_print_str(struct bch_fs *c, const char *prefix, const char *str)
+{
+	/* Nothing to print? Nothing to do: */
+	if (!str)
+		return;
+
+	bch2_print_str_loglevel(c, kern_soh_to_loglevel(prefix), str);
+}
+
+void bch2_print_str_user(struct bch_fs *c, const char *str)
+{
+	if (!str)
+		return;
+
+#ifdef __KERNEL__
+	struct stdio_redirect *stdio = bch2_fs_stdio_redirect_user(c);
+
+	if (unlikely(stdio)) {
+		bch2_stdio_redirect_write(stdio, true, str, strlen(str));
+		return;
+	}
+#endif
+	/*
+	 * Can't double-write: bch2_print_str() reaches a redirect only through
+	 * bch2_fs_stdio_redirect_log(), which is NULL in every case that got here.
+	 */
+	bch2_print_str(c, KERN_ERR, str);
+}
+
+__printf(2, 0)
+static void bch2_print_maybe_redirect(struct stdio_redirect *stdio, const char *fmt, va_list args)
+{
+#ifdef __KERNEL__
+	if (unlikely(stdio)) {
+		if (fmt[0] == KERN_SOH[0])
+			fmt += 2;
+
+		/* We may be in atomic context, and nonblocking drops what won't fit */
+		CLASS(printbuf, buf)();
+		printbuf_atomic_inc(&buf);
+		prt_vprintf(&buf, fmt, args);
+		if (!buf.allocation_failure)
+			bch2_stdio_redirect_write(stdio, true, buf.buf, buf.pos);
+		return;
+	}
+#endif
+	vprintk(fmt, args);
+}
+
+void __bch2_print(struct bch_fs *c, const char *fmt, ...)
+{
+	int loglevel = kern_soh_to_loglevel(fmt);
+	if (loglevel < 0)
+		loglevel = c->prev_loglevel;
+	else
+		c->prev_loglevel = loglevel;
+
+	if (loglevel > loglevel_opt(c))
+		return;
+
+#ifndef __KERNEL__
+	if (fmt[0] == KERN_SOH[0])
+		fmt += 2;
+#endif
+
+	struct stdio_redirect *stdio = bch2_fs_stdio_redirect_log(c);
+
+	va_list args;
+	va_start(args, fmt);
+	bch2_print_maybe_redirect(stdio, fmt, args);
+	va_end(args);
+}
