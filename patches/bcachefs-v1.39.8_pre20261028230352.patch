@@ -0,0 +1,8 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_ALLOC_DISCARD_H
+#define _BCACHEFS_ALLOC_DISCARD_H
+
+#include "alloc/buckets.h"
+#include "alloc/discard_gen.h"
