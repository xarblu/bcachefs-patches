+		prt_printf(&buf, "%s\n", trans->fn);
+		bch2_btree_path_to_text_short(&buf, trans, path_pos, trans->paths + path_pos);
+		prt_printf(&buf, "new pos: ");
+		bch2_bpos_to_text(&buf, *pos);
