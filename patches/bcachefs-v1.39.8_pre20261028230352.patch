+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::types::c_default;
+use crate::util::ffi::c_char;
+use core::ffi::{c_int, c_uint, c_void};
+use cstruct_macros::{CStruct, bitfield, c_const, c_enum, c_extern};
+use nestify::nest;
+
+c_enum! {
+    #[closed]
+    pub enum printbuf_si: u32 {
+        PRINTBUF_UNITS_2,       /* use binary powers of 2^10 */
+        PRINTBUF_UNITS_10,      /* use powers of 10^3 (standard SI) */
+    }
+}
+
+c_const! {
+    #[c_int]
+    pub const PRINTBUF_INLINE_TABSTOPS: u32 = 8;
+}
+
+nest! {
+    #[repr(C)]
+    #[derive(CStruct)]
+    pub struct printbuf {
+        pub buf: *mut c_char,
+        pub size: c_uint,
+        pub pos: c_uint,
+        pub last_newline: c_uint,
+        pub last_field: c_uint,
+        pub indent: c_uint,
+        /*
+         * If nonzero, allocations will be done with GFP_ATOMIC:
+         */
+        pub atomic: u8,
+        #[c_bitfield]
+        #>[bitfield(u8)]
+        pub bits: pub struct printbuf_bits {
+            allocation_failure:     bool,
+            heap_allocated:         bool,
+            overflow:               bool,
+            /* Ratelimited or already printed */
+            suppress:               bool,
+            #[bits(1)] pub si_units: c::printbuf_si,
+            human_readable_units:   bool,
+            has_indent_or_tabstops: bool,
+            may_vmalloc:            bool,
+        },
+        pub nr_tabstops: u8,
+
+        /*
+         * Do not modify directly: use printbuf_tabstop_add(),
+         * printbuf_tabstop_get()
+         */
+        pub cur_tabstop: u8,
+        pub _tabstops: [u8; c::PRINTBUF_INLINE_TABSTOPS as usize],
+    }
+}
+c_default!(printbuf);
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, CStruct)]
+pub struct printbuf_restore {
+    pub pos: c_uint,
+    pub last_newline: c_uint,
+    pub last_field: c_uint,
+    pub indent: c_uint,
+    pub cur_tabstop: u8,
+}
+
+c_extern! {
+    pub fn bch2_printbuf_exit(buf: *mut c::printbuf);
+    pub fn bch2_printbuf_make_room_gfp(buf: *mut c::printbuf, extra: c_uint, gfp: c::gfp_t) -> c_int;
+    pub fn bch2_printbuf_tabstops_reset(buf: *mut c::printbuf);
+    pub fn bch2_printbuf_tabstop_push(buf: *mut c::printbuf, spaces: c_uint) -> c_int;
+    pub fn bch2_printbuf_indent_add(buf: *mut c::printbuf, spaces: c_uint);
+    pub fn bch2_printbuf_indent_sub(buf: *mut c::printbuf, spaces: c_uint);
+    pub fn bch2_printbuf_indent_add_nextline(buf: *mut c::printbuf, spaces: c_uint);
+    pub fn bch2_prt_newline(buf: *mut c::printbuf);
+    pub fn bch2_prt_tab(out: *mut c::printbuf);
+    pub fn bch2_prt_tab_rjust(buf: *mut c::printbuf);
+    pub fn bch2_printbuf_tabstop_align(buf: *mut c::printbuf);
+    pub fn bch2_prt_bytes_indented(out: *mut c::printbuf, str: *const c_char, count: c_uint);
+    pub fn bch2_prt_human_readable_u64(out: *mut c::printbuf, v: u64);
+    pub fn bch2_prt_units_u64(out: *mut c::printbuf, v: u64);
+    pub fn bch2_prt_bitflags(out: *mut c::printbuf, list: *const *const c_char, flags: u64);
+    pub fn rust_prt_bytes(out: *mut c::printbuf, b: *const c_void, n: c_uint);
+    #[c_printf(2, 3)]
+    pub fn bch2_prt_printf(out: *mut c::printbuf, fmt: *const c_char, ...);
+}
diff --git a/fs/bcachefs/util/projections.rs b/fs/bcachefs/util/projections.rs
new file mode 100644
index 0000000..3010fb9
--- /dev/null
+++ b/fs/bcachefs/util/projections.rs
@@ -0,0 +1,705 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Field projections and places: what's projected through and assigned to,
+//! and the fakes that stand in for projecting and for places until the
+//! language has them.
+//!
+//! Field projections - a Rust project goal, which the Rust-for-Linux RcuMutex
+//! is the motivating case for - will let a pointer type say what projecting
+//! it to a field gives, and custom places what a load and a store through
+//! one are: w.current_passes |= bit on a published word, sb.csum_type = x on
+//! a superblock bitfield, v.btrees_lost_data on a short value. Until then,
+//! in order - the fakes marked XXX where they are, to go when the real ones
+//! arrive:
+//!
+//! - Places: FakePlaceRead and FakePlaceWrite, a place's load and store as
+//!   methods - get(), set(), and place(): a FakePlaceRef, the value loaded
+//!   to assign to through a &mut and stored back when it drops, so the real
+//!   operators work - *w.nr.place() += 1, *w.passes.place() |= bit. Through
+//!   &self, as a Cell's: what allows a store is how its writer was had - a
+//!   held lock's guard, a &mut of what it's in - not the call. Fakes, all.
+//!   The places here have get(), set() and place() inherent too, the traits
+//!   calling them: callers need no import - fs.sb.version.get() - and the
+//!   traits are for what's generic over places, FakePlaceRef first.
+//!
+//! - Publishing: Publish and published!(), projection faked by a mirror, for
+//!   what a Lock publishes (locking/): a struct and its Writer,
+//!   laid out the same, so the guard's published() is the &P::Writer of its
+//!   own P, and field syntax reaches each leaf as its writer has it. The
+//!   mirror goes; the lock stays.
+//!
+//! - Volatile words: Volatile, a word read by anyone and written one writer
+//!   at a time - not an atomic, whose writers race each other - and
+//!   VolatileWriter, it as its writer has it. A value of more words is one
+//!   only if it's TearSafe: a reader may see it torn, and its type says
+//!   that's fine. They stay; their places go.
+//!
+//! - Published once: PublishedOnce, a value set once by its lock's holder
+//!   and read by anyone from then on - a key a running filesystem gains,
+//!   and never loses. Not a place: it's set, not stored to.
+//!
+//! - Views: View and ViewMut, a value as many of its bytes as there are -
+//!   fewer, for one written before its type grew: a superblock section,
+//!   journal entry or key value from an older version. A field past the end
+//!   reads as zero, and setting one is an error, ShortField; a Floored
+//!   type's fields every value has are fields of its View already. They
+//!   stay; how they're projected - project(), and the v.field() methods
+//!   #[derive(View)] makes of it, since a short value can't be a &T to
+//!   project a reference from - goes. A View's fields read through
+//!   FakePlaceRead; ViewMut's set() is its own, as it can fail.
+//!
+//! Bitfields aren't faked as places: a field access names memory that
+//! exists, so *x.offset can't be a u64 loaded from its word - the copy has to
+//! be made by a call, and then the call's receiver, & or &mut, is fixed.
+//! They have their getters, set_x() and update_x(f) until the real ones
+//! arrive.
+
+use core::cell::UnsafeCell;
+use core::marker::PhantomData;
+use core::mem::{align_of, size_of, MaybeUninit};
+use core::ops::{Deref, DerefMut};
+use core::sync::atomic::{AtomicBool, AtomicI16, AtomicI32, AtomicI64, AtomicI8, AtomicIsize, AtomicU16, AtomicU32,
+                         AtomicU64, AtomicU8, AtomicUsize, Ordering};
+
+use crate::util::vstructs::{Native, Plain};
+
+// ── Places ───────────────────────────────────────────────────────────────
+
+/// A place to read: what a load through it gives.
+pub trait FakePlaceRead {
+    type Value: Copy;
+
+    fn get(&self) -> Self::Value;
+}
+
+/// A place to write: a store through it.
+pub trait FakePlaceWrite: FakePlaceRead {
+    fn set(&self, v: Self::Value);
+
+    /// It, as a place to assign to: *w.nr.place() += 1, *w.passes.place()
+    /// |= bit - its value, loaded, to change through a &mut, and stored back
+    /// when the FakePlaceRef drops, at the end of the statement.
+    // XXX Deprecated when real field projections arrive: compound assignment
+    // through a projected place - w.current_passes |= bit - instead.
+    fn place(&self) -> FakePlaceRef<'_, Self>
+    where
+        Self: Sized,
+    {
+        FakePlaceRef { place: self, v: self.get(), dirty: false }
+    }
+}
+
+/// A FakePlaceWrite's value, loaded, to change in place: stored back when
+/// it drops, if it was changed - a FakePlaceRef only read stores nothing,
+/// so *a.place() = (*a.place()).max(x) keeps the assignment.
+///
+/// A statement's worth, not a binding's: one held across another store to
+/// the same place stores its stale copy over it when it drops. The borrow
+/// checker doesn't see that - both borrow the place shared - so writers had
+/// through &mut of what they're in, as a Lock's guard's published(),
+/// keep the window to one writer reference.
+#[must_use = "a FakePlaceRef stores when it drops - assign through it, *p += 1"]
+pub struct FakePlaceRef<'a, P: FakePlaceWrite> {
+    place: &'a P,
+    v:     P::Value,
+    dirty: bool,
+}
+
+impl<P: FakePlaceWrite> Deref for FakePlaceRef<'_, P> {
+    type Target = P::Value;
+
+    fn deref(&self) -> &P::Value {
+        &self.v
+    }
+}
+
+impl<P: FakePlaceWrite> DerefMut for FakePlaceRef<'_, P> {
+    fn deref_mut(&mut self) -> &mut P::Value {
+        self.dirty = true;
+        &mut self.v
+    }
+}
+
+impl<P: FakePlaceWrite> Drop for FakePlaceRef<'_, P> {
+    fn drop(&mut self) {
+        if self.dirty {
+            self.place.set(self.v);
+        }
+    }
+}
+
+// ── Publishing ───────────────────────────────────────────────────────────
+
+/// What a Lock publishes: read through &Self by anyone, held or not
+/// - and written through &Self::Writer, which only its lock's guard hands
+/// out: the same bytes, its leaves able to write. A struct of them is
+/// published!(); its leaves are Volatile words and RcuArrays.
+///
+/// # Safety
+/// Writer is laid out as Self: a &Self is a valid &Writer. What Writer
+/// writes, &Self's readers may read meanwhile: each leaf's writes are atomic,
+/// or published as RCU publishes.
+pub unsafe trait Publish {
+    type Writer;
+}
+
+// SAFETY: nothing to write
+unsafe impl Publish for () {
+    type Writer = ();
+}
+
+// SAFETY: element for element, each T's
+unsafe impl<T: Publish, const N: usize> Publish for [T; N] {
+    type Writer = [T::Writer; N];
+}
+
+/// A struct a Lock publishes, and its writer: the struct as declared,
+/// #[repr(C)], and NameWriter - each field as its writer has it, the Publish
+/// Writer of its type - which the lock's guard hands out. Fields are Publish
+/// types: Volatile words, RcuArrays, arrays of them, other published!()
+/// structs.
+#[macro_export]
+macro_rules! published {
+    (
+        $(#[$m:meta])*
+        $vis:vis struct $name:ident {
+            $($(#[$fm:meta])* $fvis:vis $field:ident: $ty:ty),* $(,)?
+        }
+    ) => { ::paste::paste! {
+        $(#[$m])*
+        #[repr(C)]
+        $vis struct $name {
+            $($(#[$fm])* $fvis $field: $ty),*
+        }
+
+        #[doc = ::core::concat!(::core::stringify!($name), ", as its lock's holder has it.")]
+        #[repr(C)]
+        $vis struct [<$name Writer>] {
+            $($fvis $field: <$ty as $crate::util::projections::Publish>::Writer),*
+        }
+
+        // SAFETY: field for field, each its type's Writer - laid out as it is
+        // (Publish), and checked
+        unsafe impl $crate::util::projections::Publish for $name {
+            type Writer = [<$name Writer>];
+        }
+
+        const _: () = {
+            assert!(::core::mem::size_of::<$name>() == ::core::mem::size_of::<[<$name Writer>]>());
+            assert!(::core::mem::align_of::<$name>() == ::core::mem::align_of::<[<$name Writer>]>());
+            $(assert!(::core::mem::offset_of!($name, $field) ==
+                      ::core::mem::offset_of!([<$name Writer>], $field));)*
+        };
+    } };
+}
+
+// ── Volatile words ───────────────────────────────────────────────────────
+
+/// A value with an atomic of its own size: what a Volatile is stored as - or,
+/// for a TearSafe value of more than a word, Torn.
+///
+/// # Safety
+/// Atomic is laid out as Self is, and all zeroes is a Self: a Volatile in
+/// zeroed memory - as C allocates its structs - is a valid one.
+pub unsafe trait AtomicWord: Copy {
+    type Atomic;
+
+    fn load(a: &Self::Atomic) -> Self;
+    fn store(a: &Self::Atomic, v: Self);
+}
+
+macro_rules! atomic_word {
+    ($($t:ty => $a:ty),* $(,)?) => { $(
+        // SAFETY: core's atomic of the same type; zeroes are 0, or false
+        unsafe impl AtomicWord for $t {
+            type Atomic = $a;
+
+            fn load(a: &$a) -> $t {
+                a.load(Ordering::Relaxed)
+            }
+
+            fn store(a: &$a, v: $t) {
+                a.store(v, Ordering::Relaxed)
+            }
+        }
+    )* };
+}
+atomic_word!(bool => AtomicBool, u8 => AtomicU8, u16 => AtomicU16, u32 => AtomicU32, u64 => AtomicU64,
+             usize => AtomicUsize, i8 => AtomicI8, i16 => AtomicI16, i32 => AtomicI32, i64 => AtomicI64,
+             isize => AtomicIsize);
+
+/// A value of more than a word whose readers are fine with seeing it torn -
+/// each word as some write left it, not all from the same one: a position
+/// read for progress, say. That a torn one is a valid value is Plain's -
+/// memory safety; that it's an acceptable one is the type's to say, and
+/// can't be wrong in a way that's unsafe. tear_safe!() says it, and makes
+/// the type an AtomicWord whose storage is Torn, so a Volatile of it is read
+/// and written a word at a time. A one-word value can't tear: it's an
+/// AtomicWord of its own.
+pub trait TearSafe: Plain + Copy {}
+
+/// A TearSafe value as a Volatile holds it: loaded and stored a word at a
+/// time - of its alignment, up to a u64 - by relaxed atomics.
+#[repr(transparent)]
+pub struct Torn<T>(UnsafeCell<T>);
+
+// SAFETY: every access is a word's atomic load or store
+unsafe impl<T: TearSafe + Send> Sync for Torn<T> {}
+
+trait Word: Copy {
+    /// # Safety
+    /// @p is an aligned, live word, accessed only atomically meanwhile.
+    unsafe fn load(p: *mut Self) -> Self;
+    /// # Safety
+    /// As load()'s.
+    unsafe fn store(p: *mut Self, v: Self);
+}
+
+macro_rules! word {
+    ($($t:ty => $a:ty),*) => { $(
+        impl Word for $t {
+            unsafe fn load(p: *mut $t) -> $t {
+                // SAFETY: the caller's
+                unsafe { <$a>::from_ptr(p) }.load(Ordering::Relaxed)
+            }
+
+            unsafe fn store(p: *mut $t, v: $t) {
+                // SAFETY: the caller's
+                unsafe { <$a>::from_ptr(p) }.store(v, Ordering::Relaxed)
+            }
+        }
+    )* };
+}
+word!(u8 => AtomicU8, u16 => AtomicU16, u32 => AtomicU32, u64 => AtomicU64);
+
+/// # Safety
+/// @src and @dst are @n word-aligned words each.
+unsafe fn load_words<W: Word>(src: *mut W, dst: *mut W, n: usize) {
+    for i in 0..n {
+        // SAFETY: the caller's
+        unsafe { dst.add(i).write(W::load(src.add(i))) }
+    }
+}
+
+/// # Safety
+/// As load_words()'s.
+unsafe fn store_words<W: Word>(src: *const W, dst: *mut W, n: usize) {
+    for i in 0..n {
+        // SAFETY: the caller's
+        unsafe { W::store(dst.add(i), src.add(i).read()) }
+    }
+}
+
+impl<T: TearSafe> Torn<T> {
+    /// A word: T's alignment, up to a u64's - which a T is a whole number of.
+    const WORD: usize = if align_of::<T>() < size_of::<u64>() { align_of::<T>() } else { size_of::<u64>() };
+    const WORDS: usize = size_of::<T>() / Self::WORD;
+
+    pub fn load(&self) -> T {
+        let mut v = MaybeUninit::<T>::uninit();
+        let (src, dst) = (self.0.get(), v.as_mut_ptr());
+        // SAFETY: the cell's words, aligned as T is, into @v's; T is Plain, so
+        // every byte written, whatever the words are is a T
+        unsafe {
+            match Self::WORD {
+                1 => load_words::<u8>(src.cast(), dst.cast(), Self::WORDS),
+                2 => load_words::<u16>(src.cast(), dst.cast(), Self::WORDS),
+                4 => load_words::<u32>(src.cast(), dst.cast(), Self::WORDS),
+                _ => load_words::<u64>(src.cast(), dst.cast(), Self::WORDS),
+            }
+            v.assume_init()
+        }
+    }
+
+    pub fn store(&self, v: T) {
+        let (src, dst) = (core::ptr::from_ref(&v), self.0.get());
+        // SAFETY: @v's words, into the cell's, as load()'s
+        unsafe {
+            match Self::WORD {
+                1 => store_words::<u8>(src.cast(), dst.cast(), Self::WORDS),
+                2 => store_words::<u16>(src.cast(), dst.cast(), Self::WORDS),
+                4 => store_words::<u32>(src.cast(), dst.cast(), Self::WORDS),
+                _ => store_words::<u64>(src.cast(), dst.cast(), Self::WORDS),
+            }
+        }
+    }
+}
+
+/// @T is TearSafe, and a Volatile of it is loaded and stored a word at a time.
+#[macro_export]
+macro_rules! tear_safe {
+    ($($t:ty),* $(,)?) => { $(
+        impl $crate::util::projections::TearSafe for $t {}
+
+        // SAFETY: Torn is laid out as @T is, and @T is Plain: zeroes are one
+        unsafe impl $crate::util::projections::AtomicWord for $t {
+            type Atomic = $crate::util::projections::Torn<$t>;
+
+            fn load(a: &Self::Atomic) -> $t {
+                a.load()
+            }
+
+            fn store(a: &Self::Atomic, v: $t) {
+                a.store(v)
+            }
+        }
+    )* };
+}
+
+/// A @T read by anyone, a word at a time, as C reads its fields. Relaxed
+/// loads and stores, as C's plain ones: a reader sees each word as it was
+/// written, not two of them as of one moment. To C, a plain @T.
+///
+/// Volatile, not atomic: its writers don't race each other, only its
+/// readers. set() is a store, for a field with one writer - a thread's own
+/// state, published - and a read-modify-write is a load and a store - place()
+/// - not an atomic one, so it's a VolatileWriter's: had where writing is
+/// serialized, a Lock's guard. A word several writers change at once is an
+/// atomic, written with its fetch_add()s, and never a FakePlaceWrite: a
+/// place's load and store would lose another writer's update between them.
+#[repr(transparent)]
+pub struct Volatile<T: AtomicWord>(T::Atomic);
+
+impl<T: AtomicWord> Volatile<T> {
+    pub fn get(&self) -> T {
+        T::load(&self.0)
+    }
+
+    /// Store @v, by its one writer.
+    pub fn set(&self, v: T) {
+        T::store(&self.0, v)
+    }
+}
+
+impl<T: AtomicWord> FakePlaceRead for Volatile<T> {
+    type Value = T;
+
+    fn get(&self) -> T {
+        Volatile::get(self)
+    }
+}
+
+// SAFETY: AtomicWord's - zeroes are a @T
+unsafe impl<T: AtomicWord> ::pin_init::Zeroable for Volatile<T> {}
+
+// SAFETY: VolatileWriter is a Volatile; its stores are atomic
+unsafe impl<T: AtomicWord> Publish for Volatile<T> {
+    type Writer = VolatileWriter<T>;
+}
+
+/// A Volatile, as its writer has it: the other writers excluded, so a
+/// read-modify-write through place() is whole.
+#[repr(transparent)]
+pub struct VolatileWriter<T: AtomicWord>(Volatile<T>);
+
+impl<T: AtomicWord> VolatileWriter<T> {
+    pub fn get(&self) -> T {
+        self.0.get()
+    }
+
+    pub fn set(&self, v: T) {
+        self.0.set(v)
+    }
+
+    /// FakePlaceWrite::place(): *w.nr.place() += 1.
+    // XXX Deprecated when real field projections arrive, as that is.
+    pub fn place(&self) -> FakePlaceRef<'_, Self> {
+        FakePlaceWrite::place(self)
+    }
+}
+
+impl<T: AtomicWord> FakePlaceRead for VolatileWriter<T> {
+    type Value = T;
+
+    fn get(&self) -> T {
+        VolatileWriter::get(self)
+    }
+}
+
+impl<T: AtomicWord> FakePlaceWrite for VolatileWriter<T> {
+    fn set(&self, v: T) {
+        VolatileWriter::set(self, v)
+    }
+}
+
+// ── Published once ───────────────────────────────────────────────────────
+
+#[cfg(kernel)]
+use kernel::sync::SetOnce;
+#[cfg(not(kernel))]
+use bcachefs_shim::sync::SetOnce;
+
+/// Unset, or set for good: read without the lock, set only by its holder,
+/// once - PublishedOnceWriter. Zeroed, it's unset.
+#[repr(transparent)]
+pub struct PublishedOnce<T>(SetOnce<T>);
+
+impl<T> PublishedOnce<T> {
+    pub fn get(&self) -> Option<&T> {
+        self.0.as_ref()
+    }
+}
+
+/// A PublishedOnce, as its lock's holder has it.
+#[repr(transparent)]
+pub struct PublishedOnceWriter<T>(SetOnce<T>);
+
+impl<T> PublishedOnceWriter<T> {
+    /// Whether this set it: if it was already, @v is dropped.
+    pub fn set(&self, v: T) -> bool {
+        self.0.populate(v)
+    }
+}
+
+// SAFETY: SetOnce's zeroes are its unset state
+unsafe impl<T> ::pin_init::Zeroable for PublishedOnce<T> {}
+
+// SAFETY: the same SetOnce, whose set is atomic
+unsafe impl<T> Publish for PublishedOnce<T> {
+    type Writer = PublishedOnceWriter<T>;
+}
+
+// SAFETY: a RustOnly of the same size and alignment: a @T, as its Writer has
+// it - laid out as it is, as Publish says
+unsafe impl<T: Publish, const U64S: usize, const ALIGN: usize> Publish for crate::types::RustOnly<T, U64S, ALIGN>
+where
+    crate::types::Align<ALIGN>: crate::types::AlignMarker,
+{
+    type Writer = crate::types::RustOnly<T::Writer, U64S, ALIGN>;
+}
+
+// ── Views ────────────────────────────────────────────────────────────────
+
+/// ViewMut::set() on a field past the end of a view's bytes: one a shorter,
+/// older version of the type it's in doesn't have. Growing the value is its
+/// owner's job, not a field write's.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ShortField {
+    /// The type the bytes are a value of.
+    pub ty:    &'static str,
+    /// The field, if one was projected to - and where it is in @ty.
+    pub field: &'static str,
+    pub at:    usize,
+    pub size:  usize,
+    /// How many of @ty's bytes there are.
+    pub len:   usize,
+}
+
+impl core::fmt::Display for ShortField {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        let Self { ty, field, at, size, len } = *self;
+        let field = if field.is_empty() { "bytes" } else { field };
+        write!(f, "{ty}: {field} at {at}..{} is past its end ({len} bytes); grow it first", at + size)
+    }
+}
+
+#[cfg(feature = "std")]
+impl std::error::Error for ShortField {}
+
+/// A T, and as many of its bytes as there are - fewer, for one written before
+/// T grew: a superblock section, journal entry or key value from an older
+/// version. One field of a View is a View of that field: #[derive(View)]'s
+/// projections.
+///
+/// Read, a field past the end is zero - an older version's missing fields
+/// are, as C's get_minsize() and bkey_val_copy_pad() zero them - and nothing
+/// past the end is ever read: those bytes are whatever comes next.
+///
+/// That a short value is an older version, not a truncated one, rests on its
+/// count having been validated: the bytes a View is made over are as many as
+/// its header says. Not for untrusted bytes - dump's, off a damaged disk.
+///
+/// A Floored type's fields that every value has are fields of its View
+/// already: s.subvol, not s.subvol().
+pub struct View<'a, T> {
+    /// T's first byte: the value's, @at further on - and maybe past its end
+    p:   *const u8,
+    at:  usize,
+    /// How many of the value's bytes there are
+    end: usize,
+    _t:  PhantomData<&'a T>,
+}
+
+impl<T> Clone for View<'_, T> {
+    fn clone(&self) -> Self {
+        *self
+    }
+}
+
+impl<T> Copy for View<'_, T> {}
+
+impl<'a, T: Plain> View<'a, T> {
+    /// The T at the start of @bytes, as much of it as they hold.
+    pub fn new(bytes: &'a [u8]) -> Self {
+        Self { p: bytes.as_ptr(), at: 0, end: bytes.len(), _t: PhantomData }
+    }
+
+    /// How many of its bytes there are, up to its size.
+    fn len(&self) -> usize {
+        self.end.saturating_sub(self.at).min(size_of::<T>())
+    }
+
+    /// The U at @off in it, its field @_field - named as ViewMut's are, for
+    /// set()'s errors: what #[derive(View)]'s projections return. A wrong @off
+    /// reads the wrong bytes, never bytes that aren't there.
+    // XXX Deprecated when real field projections arrive, with the methods
+    // #[derive(View)] makes of it: e.btrees_lost_data() becomes
+    // e.btrees_lost_data.
+    pub fn project<U: Plain>(&self, off: usize, _field: &'static str) -> View<'a, U> {
+        View { p: self.p.wrapping_add(off), at: self.at.saturating_add(off), end: self.end, _t: PhantomData }
+    }
+
+    /// Its value, as T: what's past the end reads as zero.
+    fn read(&self) -> T {
+        let mut v = MaybeUninit::<T>::zeroed();
+        // SAFETY: len() of its bytes are there, into a zeroed T - and any
+        // bytes are a T
+        unsafe {
+            core::ptr::copy_nonoverlapping(self.p, v.as_mut_ptr().cast::<u8>(), self.len());
+            v.assume_init()
+        }
+    }
+
+    /// Its bytes and the value's past them - a flexible array's, a message's
+    /// - to the value's end.
+    pub fn as_bytes(&self) -> &'a [u8] {
+        // SAFETY: the value's bytes, from ours to its end - none if we're past it
+        unsafe { core::slice::from_raw_parts(self.p, self.end.saturating_sub(self.at)) }
+    }
+
+    /// It, whole: None if any of it is past the end, or it isn't aligned.
+    pub fn whole(&self) -> Option<&'a T> {
+        (self.len() == size_of::<T>() && self.p as usize % align_of::<T>() == 0)
+            // SAFETY: all of it is there, aligned - and any bytes are a T
+            .then(|| unsafe { &*self.p.cast::<T>() })
+    }
+}
+
+impl<T: Plain + Native> View<'_, T> {
+    /// Its value - the integer, for a little-endian one: what's past the end
+    /// reads as zero.
+    pub fn get(&self) -> T::Native {
+        self.read().to_native()
+    }
+}
+
+impl<T: Plain + Native> FakePlaceRead for View<'_, T>
+where
+    T::Native: Copy,
+{
+    type Value = T::Native;
+
+    fn get(&self) -> T::Native {
+        View::get(self)
+    }
+}
+
+/// A View that can set fields - those there are: one past the end is an
+/// error, not a write.
+pub struct ViewMut<'a, T> {
+    p:     *mut u8,
+    at:    usize,
+    end:   usize,
+    ty:    &'static str,
+    field: &'static str,
+    _t:    PhantomData<&'a mut T>,
+}
+
+impl<'a, T: Plain> ViewMut<'a, T> {
+    /// The T at the start of @bytes, as much of it as they hold.
+    pub fn new(bytes: &'a mut [u8]) -> Self {
+        Self { p: bytes.as_mut_ptr(), at: 0, end: bytes.len(), ty: core::any::type_name::<T>(),
+               field: "", _t: PhantomData }
+    }
+
+    /// It, read-only.
+    pub fn as_view(&self) -> View<'_, T> {
+        View { p: self.p, at: self.at, end: self.end, _t: PhantomData }
+    }
+
+    /// As View::project().
+    // XXX Deprecated when real field projections arrive, as View's.
+    pub fn project<U: Plain>(&mut self, off: usize, field: &'static str) -> ViewMut<'_, U> {
+        ViewMut { p: self.p.wrapping_add(off), at: self.at.saturating_add(off), end: self.end, ty: self.ty,
+                  field, _t: PhantomData }
+    }
+
+    /// As View::whole(), mutably.
+    pub fn whole_mut(self) -> Option<&'a mut T> {
+        (self.as_view().len() == size_of::<T>() && self.p as usize % align_of::<T>() == 0)
+            // SAFETY: as View::whole()
+            .then(|| unsafe { &mut *self.p.cast::<T>() })
+    }
+}
+
+impl<T: Plain + Native> FakePlaceRead for ViewMut<'_, T>
+where
+    T::Native: Copy,
+{
+    type Value = T::Native;
+
+    fn get(&self) -> T::Native {
+        ViewMut::get(self)
+    }
+}
+
+impl<T: Plain + Native> ViewMut<'_, T> {
+    /// As View::get().
+    pub fn get(&self) -> T::Native {
+        self.as_view().get()
+    }
+
+    /// Set it to @v - the integer, for a little-endian one - if all of it is
+    /// there.
+    pub fn set(&mut self, v: T::Native) -> Result<(), ShortField> {
+        if self.as_view().len() < size_of::<T>() {
+            return Err(ShortField { ty: self.ty, field: self.field, at: self.at,
+                                    size: size_of::<T>(), len: self.end });
+        }
+        let v = T::from_native(v);
+        // SAFETY: all of it is there; @v is Plain, so all its bytes are
+        // initialized - and the value they land in is Plain, as new() required
+        unsafe { core::ptr::copy_nonoverlapping((&raw const v).cast::<u8>(), self.p, size_of::<T>()) };
+        Ok(())
+    }
+}
+
+/// A type whose values may be shorter than it, but never shorter than Min:
+/// the fields every valid one has. A View of it derefs to them, so they're
+/// fields - v.subvol - and only the later ones are projected, reading as
+/// zero past the end. A sized key type's value is one, Min all of it: a key
+/// type that grew is a #[grown] family.
+///
+/// # Safety
+/// Min is Self's first fields, at the same offsets.
+pub unsafe trait Floored {
+    type Min;
+}
+
+impl<'a, T: Plain + Floored> View<'a, T>
+where
+    T::Min: Plain,
+{
+    /// Its fields every valid one has. A View of fewer bytes than those
+    /// wasn't made by what floors it - a typed key's v() - and is a bug.
+    fn min(&self) -> &'a T::Min {
+        let (ty, len) = (core::any::type_name::<T>(), self.len());
+        assert!(len >= size_of::<T::Min>(),
+                "{ty}: {len} bytes, fewer than every valid one has ({})", size_of::<T::Min>());
+        assert!(self.p as usize % align_of::<T::Min>() == 0,
+                "{ty} at {:p}: not aligned to {}", self.p, align_of::<T::Min>());
+        // SAFETY: that many bytes are there, aligned - and any bytes are a Min
+        unsafe { &*self.p.cast::<T::Min>() }
+    }
+}
+
+impl<T: Plain + Floored> Deref for View<'_, T>
+where
+    T::Min: Plain,
+{
+    type Target = T::Min;
+
+    fn deref(&self) -> &T::Min {
+        self.min()
+    }
+}
diff --git a/fs/bcachefs/util/raid.rs b/fs/bcachefs/util/raid.rs
new file mode 100644
index 0000000..fdde2f4
--- /dev/null
+++ b/fs/bcachefs/util/raid.rs
@@ -0,0 +1,300 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! RAID parity over a stripe's blocks - data, then P, then Q, each a slice of
+//! one length: P is raid5's, an xor, and Q raid6's. generate() makes the
+//! parity of the data; recover() rebuilds the blocks it's told failed from the
+//! rest.
+//!
+//! In-kernel it's lib/raid's raid6 and xor - which 7.1 and 7.2 renamed - with
+//! generate() and recover() built here as raid/raid.h's raid_gen() and raid_rec(),
+//! which userspace has. Each C call has a wrapper that takes slices and checks
+//! what the C asks of them: every block one length, a multiple of 512 bytes
+//! (in userspace, 64); in-kernel, 64 byte aligned, and for raid6's recovery a
+//! page at most, page aligned; and the failed blocks in order, in range, and
+//! no more than the parity. That they're slices, &mut - or & where only read -
+//! is what the C assumes and doesn't say: no block aliases another.
+//!
+//! A stripe of one data block is copies of it - P its xor, Q its first power -
+//! which lib/raid's raid6, wanting four blocks, isn't asked for.
+//!
+//! Userspace's raid_rec() stands a zero block - raid_zero()'s, as long as the
+//! blocks - in for what it's rebuilding: it's given a page, once, and
+//! recover() goes a page at a time.
+
+use crate::c;
+use crate::util::kernel::PAGE_SIZE;
+use arrayvec::ArrayVec;
+use core::ffi::{c_int, c_void};
+
+/// The most blocks a stripe has.
+const MAX_BLOCKS: usize = c::BCH_BKEY_PTRS_MAX as usize;
+
+/// The most parity blocks: bcachefs's, though raid/raid.h has six.
+const MAX_PARITY: usize = 2;
+
+/// What a block's length is a multiple of.
+#[cfg(kernel)]
+const MULTIPLE: usize = 512;
+#[cfg(not(kernel))]
+const MULTIPLE: usize = 64;
+
+type Ptrs = ArrayVec<*mut c_void, MAX_BLOCKS>;
+
+/// @b is a block of @bytes: see the top of the file.
+fn check(b: &[u8], bytes: usize) {
+    assert!(bytes != 0 && bytes % MULTIPLE == 0, "raid: blocks of {bytes} bytes");
+    assert_eq!(b.len(), bytes, "raid: blocks of different lengths");
+    #[cfg(kernel)]
+    assert!(b.as_ptr().addr() % 64 == 0, "raid: a block at {:p}, not 64 byte aligned", b.as_ptr());
+}
+
+/// @blocks, checked, for C - and their length.
+fn ptrs(blocks: &mut [&mut [u8]]) -> (Ptrs, usize) {
+    let bytes = blocks.first().map_or(0, |b| b.len());
+    let p = blocks.iter_mut()
+        .map(|b| {
+            check(b, bytes);
+            b.as_mut_ptr().cast()
+        })
+        .collect();
+    (p, bytes)
+}
+
+/// How many of @blocks, @np of them parity, are data.
+fn nr_data(blocks: &[&mut [u8]], np: usize) -> usize {
+    assert!((1..=MAX_PARITY).contains(&np) && blocks.len() > np && blocks.len() <= MAX_BLOCKS,
+            "raid: {} blocks, {np} of them parity", blocks.len());
+    blocks.len() - np
+}
+
+/// Block @from of @blocks, into block @to.
+fn copy_block(blocks: &mut [&mut [u8]], from: usize, to: usize) {
+    let (lo, hi) = blocks.split_at_mut(from.max(to));
+    let (src, dst) = if from < to { (&*lo[from], &mut *hi[0]) } else { (&*hi[0], &mut *lo[to]) };
+    dst.copy_from_slice(src);
+}
+
+/// The parity of @blocks - its last @np, one or two - from the rest.
+pub fn generate(blocks: &mut [&mut [u8]], np: usize) {
+    let nd = nr_data(blocks, np);
+
+    if nd == 1 {
+        (1..blocks.len()).for_each(|p| copy_block(blocks, 0, p));
+    } else {
+        imp::generate(blocks, nd, np)
+    }
+}
+
+/// The blocks of @blocks that @failed names - in order, parity included -
+/// rebuilt from the rest, @np of them parity.
+pub fn recover(blocks: &mut [&mut [u8]], np: usize, failed: &[u8]) {
+    let nd = nr_data(blocks, np);
+    assert!(failed.len() <= np &&
+            failed.is_sorted_by(|a, b| a < b) &&
+            failed.last().is_none_or(|&f| usize::from(f) < blocks.len()),
+            "raid: rebuilding blocks {failed:?} of {}, {np} of them parity", blocks.len());
+
+    if failed.is_empty() {
+        return;
+    }
+
+    if nd == 1 {
+        let good = (0..blocks.len()).find(|&i| !failed.contains(&(i as u8))).expect("checked: a block left");
+        failed.iter().for_each(|&f| copy_block(blocks, good, f.into()));
+    } else {
+        imp::recover(blocks, nd, np, failed)
+    }
+}
+
+// ── In-kernel: lib/raid ──────────────────────────────────────────────────
+
+#[cfg(kernel)]
+mod imp {
+    use super::*;
+
+    /// @dest ^= each of @srcs: xor_gen(), which 7.1 made of xor_blocks(), at
+    /// most MAX_XOR_BLOCKS at a time.
+    fn xor_gen(dest: &mut [u8], srcs: &[&[u8]]) {
+        if srcs.is_empty() {
+            return;
+        }
+
+        let bytes = dest.len();
+        check(dest, bytes);
+        srcs.iter().for_each(|s| check(s, bytes));
+        // only read
+        let mut p: Ptrs = srcs.iter().map(|s| s.as_ptr().cast_mut().cast()).collect();
+
+        // SAFETY: checked - each @bytes, aligned - and @dest not one of @srcs
+        #[cfg(linux_ge = "7.1")]
+        unsafe { c::xor_gen(dest.as_mut_ptr().cast(), p.as_mut_ptr(), p.len() as u32, bytes as u32) }
+        #[cfg(not(linux_ge = "7.1"))]
+        for p in p.chunks_mut(c::MAX_XOR_BLOCKS as usize) {
+            // SAFETY: as above
+            unsafe { c::xor_blocks(p.len() as u32, bytes as u32, dest.as_mut_ptr().cast(), p.as_mut_ptr()) }
+        }
+    }
+
+    /// P and Q, @blocks' last two, from the rest: raid6's gen_syndrome().
+    fn gen_syndrome(blocks: &mut [&mut [u8]]) {
+        assert!(blocks.len() >= 4, "raid6 over {} blocks", blocks.len());
+        let (mut p, bytes) = ptrs(blocks);
+
+        // SAFETY: checked - each block's @bytes, aligned, and its own
+        #[cfg(linux_ge = "7.2")]
+        unsafe { c::raid6_gen_syndrome(p.len() as c_int, bytes, p.as_mut_ptr()) }
+        #[cfg(not(linux_ge = "7.2"))]
+        {
+            // SAFETY: set up once, at raid6's init
+            let f = unsafe { (*&raw const c::raid6_call).gen_syndrome }.expect("raid6's gen_syndrome");
+            // SAFETY: as above
+            unsafe { f(p.len() as c_int, bytes, p.as_mut_ptr()) }
+        }
+    }
+
+    /// @blocks for raid6's recovery, which is of a page at most, page aligned.
+    fn recov_ptrs(blocks: &mut [&mut [u8]]) -> (Ptrs, usize) {
+        assert!(blocks.len() >= 4, "raid6 over {} blocks", blocks.len());
+        let (p, bytes) = ptrs(blocks);
+        assert!(bytes <= PAGE_SIZE && p.iter().all(|p| p.addr() % PAGE_SIZE == 0),
+                "raid6 recovery of {bytes} bytes, or not page aligned");
+        (p, bytes)
+    }
+
+    /// Data blocks @faila and @failb, from the rest and P and Q.
+    fn recov_2data(blocks: &mut [&mut [u8]], faila: usize, failb: usize) {
+        assert!(faila < failb && failb < blocks.len() - 2, "raid6 recovery of data blocks {faila} and {failb}");
+        let (mut p, bytes) = recov_ptrs(blocks);
+        let (disks, faila, failb) = (p.len() as c_int, faila as c_int, failb as c_int);
+
+        // SAFETY: checked
+        #[cfg(linux_ge = "7.2")]
+        unsafe { c::raid6_recov_2data(disks, bytes, faila, failb, p.as_mut_ptr()) }
+        #[cfg(not(linux_ge = "7.2"))]
+        {
+            // SAFETY: set up once, at raid6's init
+            let f = unsafe { *&raw const c::raid6_2data_recov }.expect("raid6's 2data_recov");
+            // SAFETY: as above
+            unsafe { f(disks, bytes, faila, failb, p.as_mut_ptr()) }
+        }
+    }
+
+    /// Data block @faila and P, from the rest and Q.
+    fn recov_datap(blocks: &mut [&mut [u8]], faila: usize) {
+        assert!(faila < blocks.len() - 2, "raid6 recovery of data block {faila}");
+        let (mut p, bytes) = recov_ptrs(blocks);
+        let (disks, faila) = (p.len() as c_int, faila as c_int);
+
+        // SAFETY: checked
+        #[cfg(linux_ge = "7.2")]
+        unsafe { c::raid6_recov_datap(disks, bytes, faila, p.as_mut_ptr()) }
+        #[cfg(not(linux_ge = "7.2"))]
+        {
+            // SAFETY: set up once, at raid6's init
+            let f = unsafe { *&raw const c::raid6_datap_recov }.expect("raid6's datap_recov");
+            // SAFETY: as above
+            unsafe { f(disks, bytes, faila, p.as_mut_ptr()) }
+        }
+    }
+
+    /// Block @failed of @blocks, the xor of the others.
+    fn raid5_rec(blocks: &mut [&mut [u8]], failed: usize) {
+        let (before, rest) = blocks.split_at_mut(failed);
+        let (dest, after) = rest.split_first_mut().expect("raid5 recovery of a block it hasn't");
+        let mut srcs = before.iter().chain(after.iter()).map(|b| &**b);
+
+        let first = srcs.next().expect("raid5 recovery from nothing");
+        dest.copy_from_slice(first);
+        xor_gen(dest, &srcs.collect::<ArrayVec<&[u8], MAX_BLOCKS>>());
+    }
+
+    /// Data block @faila, and data block @failb or P, from the rest - a page
+    /// at a time, as raid6's recovery goes.
+    fn raid6_rec(blocks: &mut [&mut [u8]], faila: usize, failb: usize) {
+        let (nd, bytes) = (blocks.len() - 2, blocks[0].len());
+
+        for offset in (0..bytes).step_by(PAGE_SIZE) {
+            let end = (offset + PAGE_SIZE).min(bytes);
+            let mut page: ArrayVec<&mut [u8], MAX_BLOCKS> = blocks.iter_mut().map(|b| &mut b[offset..end]).collect();
+
+            if failb < nd {
+                recov_2data(&mut page, faila, failb)
+            } else {
+                recov_datap(&mut page, faila)
+            }
+        }
+    }
+
+    pub(super) fn generate(blocks: &mut [&mut [u8]], nd: usize, np: usize) {
+        match np {
+            1 => raid5_rec(blocks, nd),
+            _ => gen_syndrome(blocks),
+        }
+    }
+
+    pub(super) fn recover(blocks: &mut [&mut [u8]], nd: usize, np: usize, failed: &[u8]) {
+        let f = |i: usize| usize::from(failed[i]);
+
+        match failed.len() {
+            // data, or P
+            1 if f(0) <= nd => raid5_rec(&mut blocks[..nd + 1], f(0)),
+            // Q
+            1 => gen_syndrome(blocks),
+            // data and data, or data and P
+            2 if f(1) <= nd => raid6_rec(blocks, f(0), f(1)),
+            // data and Q
+            2 if f(0) < nd => {
+                raid5_rec(&mut blocks[..nd + 1], f(0));
+                gen_syndrome(blocks);
+            }
+            // P and Q
+            _ => generate(blocks, nd, np),
+        }
+    }
+}
+
+// ── Userspace: raid/raid.h ───────────────────────────────────────────────
+
+#[cfg(not(kernel))]
+mod imp {
+    use super::*;
+    use std::sync::Once;
+
+    /// raid_rec()'s zero block, a page: recover() goes a page at a time.
+    static ZERO: [u8; PAGE_SIZE] = [0; PAGE_SIZE];
+
+    /// raid_init(), which picks the implementations, and raid_zero(): before
+    /// anything else of raid.h's.
+    fn init() {
+        static INIT: Once = Once::new();
+
+        // SAFETY: once; @ZERO is only read
+        INIT.call_once(|| unsafe {
+            c::raid_init();
+            c::raid_zero(ZERO.as_ptr().cast_mut().cast());
+        });
+    }
+
+    pub(super) fn generate(blocks: &mut [&mut [u8]], nd: usize, np: usize) {
+        init();
+        let (mut p, bytes) = ptrs(blocks);
+        // SAFETY: checked - each block's @bytes, and its own
+        unsafe { c::raid_gen(nd as c_int, np as c_int, bytes, p.as_mut_ptr()) }
+    }
+
+    pub(super) fn recover(blocks: &mut [&mut [u8]], nd: usize, np: usize, failed: &[u8]) {
+        init();
+        let mut ir: ArrayVec<c_int, MAX_PARITY> = failed.iter().map(|&f| f.into()).collect();
+        let bytes = blocks[0].len();
+
+        for offset in (0..bytes).step_by(PAGE_SIZE) {
+            let end = (offset + PAGE_SIZE).min(bytes);
+            let mut page: ArrayVec<&mut [u8], MAX_BLOCKS> = blocks.iter_mut().map(|b| &mut b[offset..end]).collect();
+            let (mut p, bytes) = ptrs(&mut page);
+
+            // SAFETY: checked - each block's @bytes, and its own, and @ir as
+            // recover() checked @failed; the zero block, a page, as long
+            unsafe { c::raid_rec(ir.len() as c_int, ir.as_mut_ptr(), nd as c_int, np as c_int, bytes, p.as_mut_ptr()) }
+        }
+    }
+}
