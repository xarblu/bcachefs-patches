+        (b"test_placed_container", test_placed_container),
+        #[cfg(CONFIG_BCACHEFS_TESTS)]
+        (b"test_cuckoo", cuckoo::test_cuckoo),
+        #[cfg(CONFIG_BCACHEFS_TESTS)]
+        (b"test_cuckoo_torture", cuckoo::test_cuckoo_torture),
