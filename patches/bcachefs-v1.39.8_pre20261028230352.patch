index 0000000..23bfeb8
--- /dev/null
+++ b/fs/bcachefs/util/file.rs
@@ -0,0 +1,427 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A file's operations from a trait. A type implements FileOps, under
+//! #[vtable], and FileVTable::<P>::OPS is the file_operations of a file whose
+//! state is P (FileData): each op filled in only where it's implemented,
+//! release() always - FileData's - and in-kernel .owner this module, so it
+//! isn't unloaded under an open file. P is the file's private data - the
+//! ops' type, or one holding it - unless it says otherwise: a regular file's
+//! ops are its inode's (vfs/file.rs). The kernel crate's own (MiscDevice,
+//! debugfs's) are tied to their users; this is MiscDevice's shape, for any
+//! file, in both builds - the tools serve debugfs files over http, through
+//! the shim's debugfs and these same ops.
+//!
+//! The private data is a Pin<KBox<T>>: made by open() for a file opened by
+//! path (debugfs's), or handed to NewFile::new() for a file made for
+//! userspace with its object already there (thread_with_file's) - an
+//! anonymous inode's, on a reserved fd that install() hands over.
+//!
+//! UserBuf is a read() or write()'s buffer in userspace, and how far the call
+//! has got: what it moved is what it returns, even if it then fails. Its
+//! copies are copy_to_user()'s, which may fault and sleep, or - for copies
+//! made under a spinlock - the nofault ones, of what fault_in_*() made
+//! present.
+//!
+//! poll() is kernel only, and its queue is ours, not the kernel crate's
+//! PollCondVar: that one's drop calls __wake_up_pollfree(), which isn't
+//! exported to modules.
+
+use crate::c;
+use crate::errcode::BchError;
+use crate::util::alloc::KBox;
+use crate::util::ffi::{c_char, Opaque};
+use crate::util::ops::{from_raw, SelfOf};
+use core::ffi::c_int;
+use core::pin::Pin;
+
+#[cfg(kernel)]
+use {
+    crate::errcode::errptr_to_result,
+    core::ffi::{c_uint, c_void},
+    core::marker::PhantomData,
+    core::mem::MaybeUninit,
+    core::ptr::NonNull,
+    kernel::fs::file::FileDescriptorReservation,
+    kernel::sync::aref::ARef,
+    crate::util::kernel::current_comm,
+};
+
+// long, as the bindings have it: the kernel's is isize, core's i64
+#[cfg(kernel)]
+use kernel::ffi::{c_long as CLong, c_ulong as CUlong};
+
+#[repr(transparent)]
+pub struct File(Opaque<c::file>);
+
+impl File {
+    /// # Safety
+    /// @f is a file, open for 'a.
+    pub unsafe fn from_raw<'a>(f: *mut c::file) -> &'a File {
+        unsafe { &*f.cast::<File>() }
+    }
+
+    pub fn as_ptr(&self) -> *mut c::file {
+        self.0.as_ptr()
+    }
+
+    /// The dentry it was opened by.
+    #[cfg(kernel)]
+    pub fn dentry(&self) -> *mut c::dentry {
+        // 6.18 made f_path a const union member, __f_path its writable alias
+        #[cfg(linux_ge = "6.18")]
+        unsafe { (*self.as_ptr()).__bindgen_anon_1.f_path.dentry }
+        #[cfg(not(linux_ge = "6.18"))]
+        unsafe { (*self.as_ptr()).f_path.dentry }
+    }
+
+    /// FMODE_*: set at open.
+    #[cfg(kernel)]
+    pub fn mode(&self) -> c::fmode_t {
+        unsafe { (*self.as_ptr()).f_mode }
+    }
+
+    /// O_*: as READ_ONCE(), as fcntl() changes them.
+    #[cfg(kernel)]
+    pub fn flags(&self) -> u32 {
+        unsafe { core::ptr::read_volatile(&raw const (*self.as_ptr()).f_flags) }
+    }
+
+    #[cfg(kernel)]
+    pub fn nonblock(&self) -> bool {
+        self.flags() & c::O_NONBLOCK != 0
+    }
+}
+
+crate::vfs_ops! {
+    pub trait FileOps: Send + Sync for c::file_operations, FileVTable<P: FileData> = P::Ops, |ops| {
+        assert!(!<P::Ops>::HAS_OPEN || P::OPENABLE, "open() makes the ops' type, not the private data");
+        ops.release = Some(Self::release);
+        #[cfg(kernel)]
+        {
+            ops.owner = &raw mut kernel::bindings::__this_module;
+        }
+    };
+
+    /// For a file opened by path: its private data.
+    fn open(inode: &Opaque<c::inode>, file: &File) -> Result<Pin<KBox<Self>>, BchError>
+        => extern (inode: *mut c::inode, file: *mut c::file) -> c_int
+    {
+        // SAFETY: a file being opened, and its inode
+        let (i, f) = unsafe { (&*inode.cast::<Opaque<c::inode>>(), File::from_raw(file)) };
+        match <P::Ops>::open(i, f) {
+            Ok(p) => {
+                unsafe { (*file).private_data = into_private(P::opened(p)) };
+                0
+            }
+            Err(e) => e.class(),
+        }
+    };
+    fn read(&self = file, file: &File, buf: &mut UserBuf) -> Result<(), BchError>
+        => extern (file: *mut c::file, buf: *mut c_char, len: usize, _ppos: *mut c::loff_t) -> isize
+    {
+        let mut u = UserBuf::new(buf, len);
+        // SAFETY: an open file of P's
+        let r = unsafe { P::ops_of(file).read(File::from_raw(file), &mut u) };
+        u.ret(r)
+    };
+    #[cfg(kernel)]
+    fn write(&self = file, file: &File, buf: &mut UserBuf) -> Result<(), BchError>
+        => extern (file: *mut c::file, buf: *const c_char, len: usize, _ppos: *mut c::loff_t) -> isize
+    {
+        let mut u = UserBuf::new(buf, len);
+        // SAFETY: an open file of P's
+        let r = unsafe { P::ops_of(file).write(File::from_raw(file), &mut u) };
+        u.ret(r)
+    };
+    #[cfg(kernel)]
+    fn poll(&self = file, file: &File, pt: PollTable<'_>) -> u32;
+    /// What close(2) returns.
+    #[cfg(kernel)]
+    fn flush(&self = file, file: &File) -> c_int
+        => extern (file: *mut c::file, _id: c::fl_owner_t) -> c_int
+    {
+        // SAFETY: an open file of P's
+        unsafe { P::ops_of(file).flush(File::from_raw(file)) }
+    };
+    #[cfg(kernel)]
+    fn unlocked_ioctl(&self = file, file: &File, cmd: c_uint, arg: CUlong) -> CLong;
+    #[cfg(kernel)]
+    fn compat_ioctl(&self = file, file: &File, cmd: c_uint, arg: CUlong) -> CLong;
+    /// The new position.
+    #[cfg(kernel)]
+    fn llseek(&self = file, file: &File, offset: i64, whence: c_int) -> c::loff_t;
+    #[cfg(kernel)]
+    fn iterate_shared(&self = file, file: &File, ctx: *mut c::dir_context) -> Result<(), BchError>;
+    #[cfg(kernel)]
+    fn fsync(&self = file, file: &File, start: i64, end: i64, datasync: c_int)
+        -> Result<(), BchError>;
+    /// A mapping about to be made: its vm_ops, and whether it may be.
+    #[cfg(kernel)]
+    #[cfg(linux_ge = "6.17")]
+    fn mmap_prepare(desc: &mut c::vm_area_desc) -> Result<(), BchError>;
+    #[cfg(kernel)]
+    #[cfg(not(linux_ge = "6.17"))]
+    fn mmap(&self = file, file: &File, vma: &mut c::vm_area_struct) -> Result<(), BchError>;
+}
+
+from_raw! {
+    &'a File = *mut c::file => |r| File::from_raw(r);
+}
+
+#[cfg(kernel)]
+from_raw! {
+    PollTable<'a> = *mut c::poll_table => |r| PollTable(r, PhantomData);
+}
+
+// SAFETY: SelfOf's: a file of FileVTable::<P>'s is P's, its ops P::ops_of()'s
+impl<P: FileData> SelfOf<P> for *mut c::file {
+    type Out = P::Ops;
+    unsafe fn self_of<'a>(&self) -> &'a P::Ops { unsafe { P::ops_of(*self) } }
+}
+
+/// A file's state: by default its private data - the T whose ops the file
+/// has, or something holding one, as a thread's file holds the thread, and
+/// what it runs on - made by open() or NewFile::new(), dropped at release.
+pub trait FileData: Sized + Send + Sync + 'static {
+    type Ops: FileOps;
+
+    /// What FileOps::open() makes is the private data itself.
+    const OPENABLE: bool = false;
+
+    fn ops(&self) -> &Self::Ops;
+
+    /// The ops of @file.
+    ///
+    /// # Safety
+    /// @file is an open file of this type's - FileVTable::<Self>'s.
+    unsafe fn ops_of<'a>(file: *mut c::file) -> &'a Self::Ops {
+        unsafe { file_data::<Self>(file) }.ops()
+    }
+
+    /// The file's last use: its private data dropped.
+    ///
+    /// # Safety
+    /// As ops_of()'s, and nothing of @file used after.
+    unsafe fn release(file: *mut c::file) {
+        // SAFETY: open()'s or NewFile::new()'s
+        drop(unsafe { from_private::<Self>((*file).private_data) });
+    }
+
+    fn opened(_p: Pin<KBox<Self::Ops>>) -> Pin<KBox<Self>> {
+        unreachable!("not OPENABLE")
+    }
+}
+
+impl<T: FileOps> FileData for T {
+    type Ops = T;
+    const OPENABLE: bool = true;
+
+    fn ops(&self) -> &T {
+        self
+    }
+
+    fn opened(p: Pin<KBox<T>>) -> Pin<KBox<T>> {
+        p
+    }
+}
+
+impl<P: FileData> FileVTable<P> {
+    unsafe extern "C" fn release(_inode: *mut c::inode, file: *mut c::file) -> c_int {
+        // SAFETY: an open file of P's, its last use
+        unsafe { P::release(file) };
+        0
+    }
+}
+
+fn into_private<T>(p: Pin<KBox<T>>) -> *mut core::ffi::c_void {
+    // SAFETY: from_private() takes it back, pinned
+    KBox::into_raw(unsafe { Pin::into_inner_unchecked(p) }).cast()
+}
+
+/// # Safety
+/// @p is into_private()'s, of a T, and no one else's.
+unsafe fn from_private<T>(p: *mut core::ffi::c_void) -> Pin<KBox<T>> {
+    unsafe { Pin::new_unchecked(KBox::from_raw(p.cast())) }
+}
+
+/// # Safety
+/// @file is an open file of P's - its file_operations FileVTable::<P>'s.
+pub unsafe fn file_data<'a, P: FileData>(file: *mut c::file) -> &'a P {
+    unsafe { &*(*file).private_data.cast::<P>() }
+}
+
+/// A file made for userspace, not yet given it: install() does.
+#[cfg(kernel)]
+pub struct NewFile<P: FileData> {
+    fd:   FileDescriptorReservation,
+    file: ARef<kernel::fs::File>,
+    _p:   PhantomData<P>,
+}
+
+#[cfg(kernel)]
+impl<P: FileData> NewFile<P> {
+    /// An anonymous inode's file, of @data, named for the caller: O_CLOEXEC,
+    /// readable and writable as its ops are.
+    pub fn new(data: Pin<KBox<P>>) -> Result<Self, BchError> {
+        let name = current_comm();
+        let flags = c::O_CLOEXEC | match (<P::Ops>::HAS_READ, <P::Ops>::HAS_WRITE) {
+            (true,  true)  => c::O_RDWR,
+            (true,  false) => c::O_RDONLY,
+            (false, true)  => c::O_WRONLY,
+            (false, false) => 0,
+        };
+        let fd = FileDescriptorReservation::get_unused_fd_flags(flags)?;
+
+        let p = into_private(data);
+        let file = unsafe {
+            c::anon_inode_getfile(name.as_cstr().as_ptr().cast(), &FileVTable::<P>::OPS, p, flags as c_int)
+        };
+        match errptr_to_result(NonNull::new(file).expect("a file, or an error")) {
+            // SAFETY: anon_inode_getfile()'s ref, now ours
+            Ok(f) => Ok(NewFile { fd, file: unsafe { ARef::from_raw(f.cast()) }, _p: PhantomData }),
+            Err(e) => {
+                // SAFETY: no file took it
+                drop(unsafe { from_private::<P>(p) });
+                Err(e)
+            }
+        }
+    }
+
+    pub fn data(&self) -> &P {
+        // SAFETY: ours, and not released: no fd's installed
+        unsafe { file_data::<P>(self.file.as_ptr()) }
+    }
+
+    /// A ref on the file, for the caller to fput().
+    pub fn get_file(&self) -> NonNull<c::file> {
+        ARef::into_raw(self.file.clone()).cast()
+    }
+
+    /// The fd - from here userspace may close it at any moment.
+    pub fn install(self) -> c_int {
+        let fd = self.fd.reserved_fd();
+        self.fd.fd_install(self.file);
+        fd as c_int
+    }
+}
+
+#[cfg(kernel)]
+pub struct PollTable<'a>(*mut c::poll_table, PhantomData<&'a ()>);
+
+#[cfg(kernel)]
+impl PollTable<'_> {
+    pub fn wait(&self, file: &File, q: &PollQueue) {
+        // SAFETY: the file being polled, its table, and a queue that lives
+        // as long as the file
+        unsafe { c::rust_poll_wait(file.as_ptr(), q.0.as_ptr(), self.0) };
+    }
+}
+
+/// What poll() waits on: a wait_queue_head_t, poll_wait() taking nothing
+/// else. It must live as long as the file - in its private data - which is
+/// what makes it safe to free without POLLFREE: __fput() takes epoll's
+/// entries off it, eventpoll_release(), before ->release() frees it.
+#[cfg(kernel)]
+#[repr(transparent)]
+pub struct PollQueue(Opaque<c::wait_queue_head>);
+
+// SAFETY: C's, which any thread may wait on and wake
+#[cfg(kernel)]
+unsafe impl Send for PollQueue {}
+#[cfg(kernel)]
+unsafe impl Sync for PollQueue {}
+
+#[cfg(kernel)]
+impl PollQueue {
+    pub fn new() -> impl ::pin_init::PinInit<Self> {
+        let key = ::kernel::static_lock_class!().as_ptr().cast();
+        // SAFETY: init can't fail; the head's pinned from here on
+        unsafe {
+            ::pin_init::pin_init_from_closure(move |slot: *mut Self| {
+                c::__init_waitqueue_head((*slot).0.as_ptr(), c"poll".as_ptr().cast(), key);
+                Ok(())
+            })
+        }
+    }
+
+    pub fn wake(&self) {
+        unsafe { c::__wake_up(self.0.as_ptr(), kernel::task::TASK_NORMAL, 0, core::ptr::null_mut()) };
+    }
+}
+
+/// A read() or write()'s buffer in userspace, and how far the call has got.
+pub struct UserBuf {
+    addr:   usize,
+    len:    usize,
+    copied: usize,
+}
+
+impl UserBuf {
+    fn new(ubuf: *const c_char, len: usize) -> Self {
+        UserBuf { addr: ubuf as usize, len, copied: 0 }
+    }
+
+    pub fn len(&self) -> usize {
+        self.len
+    }
+
+    fn ptr(&self) -> *mut c_char {
+        self.addr as *mut c_char
+    }
+
+    fn advance(&mut self, n: usize) {
+        self.addr   += n;
+        self.len    -= n;
+        self.copied += n;
+    }
+
+    /// What the call returns: what it moved, if anything, else @r's error.
+    fn ret(&self, r: Result<(), BchError>) -> isize {
+        if self.copied != 0 {
+            self.copied as isize
+        } else {
+            r.map_or_else(|e| e.class() as isize, |()| 0)
+        }
+    }
+
+    /// As much of @src as fits, by copy_to_user(), which may fault: how much
+    /// went - short only if it faulted.
+    pub fn copy_to(&mut self, src: &[u8]) -> usize {
+        let n = src.len().min(self.len);
+        let left = unsafe { c::copy_to_user(self.ptr().cast(), src.as_ptr().cast_mut().cast(), n as _) } as usize;
+        self.advance(n - left);
+        n - left
+    }
+}
+
+#[cfg(kernel)]
+impl UserBuf {
+    /// How much of it is present to write, faulting it in as far as it can.
+    pub fn fault_in_writeable(&self) -> usize {
+        self.len - unsafe { c::rust_fault_in_writeable(self.ptr(), self.len) }
+    }
+
+    pub fn fault_in_readable(&self) -> usize {
+        self.len - unsafe { c::rust_fault_in_readable(self.ptr(), self.len) }
+    }
+
+    /// All of @src, without faulting - or none of it, if any wasn't present.
+    pub fn copy_to_nofault(&mut self, src: &[u8]) -> bool {
+        let ok = src.len() <= self.len &&
+            unsafe { c::copy_to_user_nofault(self.ptr().cast(), src.as_ptr().cast(), src.len()) } == 0;
+        if ok {
+            self.advance(src.len());
+        }
+        ok
+    }
+
+    /// @dst filled, without faulting - or not, if any wasn't present.
+    pub fn copy_from_nofault(&mut self, dst: &mut [MaybeUninit<u8>]) -> bool {
+        let ok = dst.len() <= self.len &&
+            unsafe { c::copy_from_user_nofault(dst.as_mut_ptr().cast(), self.ptr().cast::<c_void>(), dst.len()) } == 0;
+        if ok {
+            self.advance(dst.len());
+        }
+        ok
+    }
+}
diff --git a/fs/bcachefs/util/futex.rs b/fs/bcachefs/util/futex.rs
new file mode 100644
index 0000000..ae1b7b8
--- /dev/null
+++ b/fs/bcachefs/util/futex.rs
@@ -0,0 +1,264 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A futex: sleep until a word changes from a value we saw, woken by the
+//! word's address. The kernel's are for userspace addresses and aren't
+//! exported, and its syscall implements only 32 bit ones; this is
+//! bcachefs's, in Rust, the same in both builds, on a byte or a word.
+//!
+//! It's wait_event() without the waitlist on the fast path. A waiter reads
+//! the word, checks its condition, and only if it's going to sleep calls
+//! futex_wait() with the value it read - which compares it again under the
+//! bucket lock, so a change in between, and the wake that came with it,
+//! isn't lost: it returns at once. A lock waits on its own word (ByteLock);
+//! an eventcount is a counter every wake bumps.
+//!
+//! Waiters queue in a static table of buckets, hashed by address, as the
+//! kernel's futexes and wait_var_event() do. futex_wake() takes a bucket's
+//! lock only if its count says someone's waiting - the kernel futex's
+//! ordering (kernel/futex/waitwake.c). The waiter increments the count,
+//! fences, reads the word; the waker writes the word, fences, reads the
+//! count. One sees the other's write: the waiter sees the new value and
+//! doesn't sleep, or the waker sees the waiter.
+//!
+//! An address is hashed and compared, never dereferenced, so waking one
+//! whose memory is gone is fine: whatever's there now is woken spuriously,
+//! and every waiter rechecks.
+//!
+//! A waiter's entry is on its stack, on its bucket's list while it sleeps.
+//! The waker takes it off and marks it woken, under the bucket lock, and
+//! wakes it once the lock is dropped. The waiter, woken or not - a signal, a
+//! timeout - takes the lock once more on its way out, and takes its entry off
+//! if it's still on: so the waker is done with it before it goes, as List
+//! requires, and a wake meant for one waiter that it took is a wake it
+//! reports.
+//!
+//! The waiter is a Waker: for now always a blocking wait's task_waker(). A
+//! task awaiting would queue an entry holding its own, woken the same way.
+
+use crate::list;
+use crate::locking::{spinlock_t, Lock};
+use core::sync::atomic::{fence, AtomicBool, AtomicU32, AtomicU8, AtomicUsize, Ordering};
+use crate::util::list::ListLinks;
+use crate::util::sleep::{sleep_until, task_waker, Sleep, SleepEnd};
+use core::cell::UnsafeCell;
+use core::ptr;
+use core::task::Waker;
+use cstruct_macros::c_export;
+
+/// A word futex_wait() can wait on.
+pub trait FutexWord {
+    type Val: Copy + Eq;
+    fn load(&self, order: Ordering) -> Self::Val;
+}
+
+macro_rules! futex_word {
+    ($($atomic:ty: $val:ty),*) => {
+        $(impl FutexWord for $atomic {
+            type Val = $val;
+            fn load(&self, order: Ordering) -> $val {
+                <$atomic>::load(self, order)
+            }
+        })*
+    };
+}
+
+futex_word!(AtomicU8: u8, AtomicU32: u32, AtomicUsize: usize);
+
+const BUCKET_BITS: u32 = 8;
+
+#[repr(align(64))]
+struct Bucket {
+    waiters: AtomicUsize,
+    list:    Lock<spinlock_t, list!(Entry, links)>,
+}
+
+struct Table([Bucket; 1 << BUCKET_BITS]);
+
+// Zeroed, until bch2_futex_init() - before anything can wait - makes each
+// bucket's lock a lock and its list a list.
+static TABLE: Table = unsafe { core::mem::zeroed() };
+
+fn bucket(addr: usize) -> &'static Bucket {
+    // hash_ptr(): times the golden ratio, the top bits
+    let h = (addr as u64).wrapping_mul(0x61c8864680b583eb) >> (64 - BUCKET_BITS);
+    &TABLE.0[h as usize]
+}
+
+/// Before anything can wait: at module init, in both builds.
+#[c_export]
+pub fn bch2_futex_init() {
+    #[cfg(kernel)]
+    let key = ::kernel::static_lock_class!().as_ptr().cast();
+    #[cfg(not(kernel))]
+    let key = ptr::null_mut();
+
+    for b in &TABLE.0 {
+        // SAFETY: zeroed, and nothing can take it until we return; static
+        unsafe {
+            let Ok(()) = b.list.init_zeroed(c"futex bucket", key);
+            b.list.lock().init();
+        }
+    }
+}
+
+struct Entry {
+    links:  ListLinks,
+    addr:   usize,
+    /// Off the list by the waker: set last, under the lock
+    woken:  AtomicBool,
+    /// Whoever takes the entry off the list owns it
+    waker:  UnsafeCell<Option<Waker>>,
+}
+
+// SAFETY: its waker is touched only by whoever took it off the list - once
+unsafe impl Sync for Entry {}
+
+/// Sleep, as @how says, while *@w == @expected, until a futex_wake() on @w.
+/// Returns at once if it isn't equal; may return spuriously - the caller
+/// checks its condition again either way.
+pub fn futex_wait<W: FutexWord, E: SleepEnd>(w: &W, expected: W::Val, how: Sleep<E>) -> Result<(), E> {
+    futex_wait_or(w, expected, how, || false)
+}
+
+/// futex_wait(), returning too on any wake that finds @woken(): for a waiter
+/// whose condition isn't all futex words - kthread_should_stop(), which
+/// kthread_stop() follows with a wake_up_process(), not a futex_wake(), or
+/// whatever else C changes and wakes a task for. @woken runs in the sleep's
+/// task state, so it mustn't sleep.
+///
+/// A waiter on several futex words - two EventCounts - would want a
+/// vectored wait instead, its entry on each word's bucket: none does yet.
+pub fn futex_wait_or<W: FutexWord, E: SleepEnd>(w: &W, expected: W::Val, how: Sleep<E>,
+                                                mut woken: impl FnMut() -> bool) -> Result<(), E> {
+    let addr = ptr::from_ref(w).addr();
+    let b = bucket(addr);
+
+    b.waiters.fetch_add(1, Ordering::Relaxed);
+    fence(Ordering::SeqCst);
+
+    let entry = Entry {
+        links:  ListLinks::new(),
+        addr,
+        woken:  AtomicBool::new(false),
+        waker:  UnsafeCell::new(Some(task_waker())),
+    };
+
+    let mut ret = Ok(());
+    let mut list = b.list.lock();
+    if w.load(Ordering::Relaxed) == expected {
+        // SAFETY: init()ed; the entry's on no list, and is taken off below,
+        // with the lock held, before it goes
+        unsafe { list.push_back(&entry) };
+        drop(list);
+
+        ret = sleep_until(how, || (entry.woken.load(Ordering::Acquire) || woken()).then_some(()));
+
+        // woken or not, the lock again: so the waker's done with it
+        list = b.list.lock();
+        // SAFETY: if it's on a list, it's this one; if it's not, it was woken
+        if !unsafe { list.remove(&entry) } {
+            ret = Ok(());
+        }
+    }
+    drop(list);
+
+    b.waiters.fetch_sub(1, Ordering::Relaxed);
+    ret
+}
+
+/// Wake up to @n waiters on @addr; how many it woke. From any context, an
+/// endio's included.
+pub fn futex_wake(addr: *const (), n: usize) -> usize {
+    fence(Ordering::SeqCst);
+
+    let addr = addr.addr();
+    let b = bucket(addr);
+    if b.waiters.load(Ordering::Relaxed) == 0 {
+        return 0;
+    }
+
+    // Woken a batch at a time, after the lock's dropped
+    const BATCH: usize = 8;
+    let mut woken = 0;
+    loop {
+        let mut batch: [Option<Waker>; BATCH] = [const { None }; BATCH];
+        let mut nr = 0;
+        let mut more = false;
+        {
+            let mut list = b.list.lock();
+            let mut c = list.cursor_mut();
+            while let Some(e) = c.current() {
+                if nr == BATCH || woken + nr == n {
+                    more = woken + nr < n;
+                    break;
+                }
+                if e.addr != addr {
+                    c.move_next();
+                    continue;
+                }
+                c.remove_current();
+                // SAFETY: we took it off: its waker is ours
+                batch[nr] = unsafe { (*e.waker.get()).take() };
+                e.woken.store(true, Ordering::Release);
+                nr += 1;
+            }
+        }
+
+        for w in batch.iter_mut().take(nr) {
+            w.take().expect("a queued futex waiter without its Waker").wake();
+        }
+        woken += nr;
+
+        if !more {
+            return woken;
+        }
+    }
+}
+
+/// wait_event(), on a futex: for a condition over state that isn't a futex
+/// word. Every change to the state is followed by a wake(), which bumps the
+/// count; a waiter reads the count before checking its condition, so a
+/// change after the check leaves the count moved and the wait returns.
+#[repr(transparent)]
+pub struct EventCount(AtomicU32);
+
+// SAFETY: zeroed, it's new()'s
+unsafe impl ::pin_init::Zeroable for EventCount {}
+
+impl EventCount {
+    pub const fn new() -> Self {
+        EventCount(AtomicU32::new(0))
+    }
+
+    /// Read before checking the condition, for wait().
+    pub fn snapshot(&self) -> u32 {
+        self.0.load(Ordering::Acquire)
+    }
+
+    /// Sleep until a wake() after @seen - or at once, if there's been one.
+    pub fn wait<E: SleepEnd>(&self, seen: u32, how: Sleep<E>) -> Result<(), E> {
+        futex_wait(&self.0, seen, how)
+    }
+
+    /// Sleep until @cond: checked after every wake(), and every other wake
+    /// too, as wait_event() does - so @cond may be over what isn't this
+    /// count, kthread_should_stop() say. It runs in the sleep's task state
+    /// as well, so it mustn't sleep, and more than once a wake.
+    pub fn wait_until<T, E: SleepEnd + Copy>(&self, how: Sleep<E>,
+                                             mut cond: impl FnMut() -> Option<T>)
+        -> Result<T, E>
+    {
+        loop {
+            let seen = self.snapshot();
+            if let Some(v) = cond() {
+                return Ok(v);
+            }
+            futex_wait_or(&self.0, seen, how, || cond().is_some())?;
+        }
+    }
+
+    pub fn wake(&self) {
+        self.0.fetch_add(1, Ordering::Release);
+        futex_wake(ptr::from_ref(&self.0).cast(), usize::MAX);
+    }
+}
diff --git a/fs/bcachefs/util/gather.rs b/fs/bcachefs/util/gather.rs
new file mode 100644
index 0000000..d63c6bb
--- /dev/null
+++ b/fs/bcachefs/util/gather.rs
@@ -0,0 +1,632 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A count of things in flight, each folding what it produced into one
+//! result, and a wait for the last: what a closure is in C for its refs -
+//! closure_get() before each bio, closure_put() in its endio, closure_sync()
+//! - without the continuation, which is the executor's: a task awaits the
+//! Gather. A fork-join's jobs folding their errors, first one wins; a flush's
+//! shards summing their counters; () for a barrier on IOs that free
+//! themselves; or a KVVec of what each put, taken as they come - reaped.
+//!
+//!     stack_pin_init!(let g = Gather::<Result<(), BchError>>::new());
+//!     let r = g.get();                // one more in flight
+//!     r.put(ret);                     // folded in; dropped unput, nothing is
+//!     let ret = g.wait_sync();        // or g.wait().resume_on(..).await
+//!
+//! It's waited on by & - everything in it is atomic - so one in something
+//! shared is waited on by whoever's job that is: a task's, by its
+//! JoinHandle. One wait at a time, as there's one slot for the waiter: a
+//! second, while one's under way, is a bug, and panics. What's in flight
+//! holds refs - GatherRef, Send and Sync - got from the owner before it
+//! waits, or from a ref. Made, a Gather holds one ref of its own, the
+//! owner's, as closure_init()'s; the wait drops it, so the count only
+//! reaches zero once the owner waits, and never goes from zero back up.
+//!
+//! A ref has no lifetime. What keeps the Gather there for it is that a
+//! Gather is only ever made pinned (PinInit), so its Drop runs before its
+//! memory is reused - and its Drop waits for every ref outstanding. So a ref
+//! can go anywhere - to C, an endio's private pointer, through into_raw() -
+//! and the owner's frame waits for it. Await or wait before it's dropped:
+//! that Drop sleeps.
+//!
+//! No lock: what's put folds into atomics - Fold, a trait on the result -
+//! from any context, an endio's included, and the count, whether the owner
+//! has waited and whether a waiter is registered are one word, changed by
+//! cmpxchg, as closure_sub() changes a closure's.
+//!
+//! A Gather<KVVec<T>> collects what's put instead: each put is pushed,
+//! under an irqsave spinlock, onto a vec that has room for it. A put can't
+//! allocate, so the owner makes the room, getting each ref by try_get() -
+//! which can fail, where get() can't; get() on one doesn't build. The owner
+//! take()s what's been put so far while refs are still out, without waiting
+//! for the rest: reaping.
+//!
+//! The waiter is a Waker in a slot, as raw parts: an await's, or a sync
+//! wait's - which sleeps as closure_sync() does - waking its task, with a ref
+//! on it. The waiter fills it, then sets WAITING; the last put reads it, then
+//! clears WAITING with the cmpxchg that takes the count to zero. That
+//! cmpxchg is the putter's last touch of the Gather - after it the owner may
+//! see zero, return and free it - and gives the putter the Waker: it wakes
+//! it, holding nothing of the Gather's.
+//!
+//! An await polled with a new Waker takes its old one back - clearing
+//! WAITING - and refills the slot, setting WAITING again and bumping a
+//! generation in the same word: a put that read the slot before the refill
+//! fails its cmpxchg, rather than taking a slot that changed under it. An
+//! await dropped takes its Waker back the same way. One forgotten keeps the
+//! wait - another panics - till the Gather's drop takes both back.
+//!
+//! The Waker is woken in the last put's context - an endio's, interrupt
+//! context perhaps - so its wake must be safe there: the executor's is.
+
+use crate::c;
+use crate::errcode::{BchError, FirstErr};
+use crate::locking::Lock;
+use crate::new_lock;
+use crate::util::alloc::{flags::GFP_KERNEL, AllocError, KVVec};
+use crate::util::sleep::{sleep_until, task_waker, Sleep};
+use crate::util::task::Resumable;
+use core::marker::{PhantomData, PhantomPinned};
+use core::mem::ManuallyDrop;
+use core::pin::Pin;
+use core::ptr::{null_mut, NonNull};
+use core::sync::atomic::{AtomicPtr, AtomicU32, AtomicUsize, Ordering};
+use core::task::{Context, Poll, RawWaker, RawWakerVTable, Waker};
+use pin_init::{pin_data, pin_init, PinInit};
+
+/// A Gather's result, and how what its refs put is folded into it:
+/// concurrently, from any context - an endio's - so into atomics.
+pub trait Fold: Sized {
+    /// What a ref puts.
+    type Item;
+    /// Where the puts fold in.
+    type Acc: Sync;
+
+    /// Puts need room made for them, before each ref's got: try_get().
+    const RESERVES: bool = false;
+
+    /// The accumulator, as it is with nothing put.
+    fn acc() -> impl PinInit<Self::Acc>;
+    fn fold(acc: &Self::Acc, v: Self::Item);
+    /// The result, once every ref is put - as often as it's asked for.
+    fn result(acc: &Self::Acc) -> Self;
+
+    /// Room for @refs more puts than have been: from the owner, who alone
+    /// makes room, so it's not racing another's.
+    fn reserve(_acc: &Self::Acc, _refs: usize) -> Result<(), AllocError> {
+        Ok(())
+    }
+}
+
+/// Nothing to fold: a barrier.
+impl Fold for () {
+    type Item = ();
+    type Acc = ();
+
+    fn acc() -> impl PinInit<()> {}
+    fn fold(_: &(), _: ()) {}
+    fn result(_: &()) {}
+}
+
+/// The first error put, or Ok.
+impl Fold for Result<(), BchError> {
+    type Item = Self;
+    type Acc = FirstErr;
+
+    fn acc() -> impl PinInit<FirstErr> {
+        FirstErr::new()
+    }
+
+    fn fold(acc: &FirstErr, v: Self) {
+        if let Err(e) = v {
+            acc.set(e);
+        }
+    }
+
+    fn result(acc: &FirstErr) -> Self {
+        acc.result()
+    }
+}
+
+/// What each ref put, in the order put. The result is what's been put since
+/// it was last asked for - as Gather::take()'s, which has it while refs are
+/// still out.
+///
+/// Its room: a put pushes within capacity, and only the owner grows it - in
+/// reserve(), outside the lock, by a new vec it moves the puts into - so
+/// capacity is kept at least the puts so far plus the refs out. A ref
+/// counted when room's made either has put - in the vec - or hasn't, as a
+/// put pushes before its ref's dropped from the count.
+impl<T: Send> Fold for KVVec<T> {
+    type Item = T;
+    type Acc = Lock<c::spinlock_t, KVVec<T>>;
+
+    const RESERVES: bool = true;
+
+    fn acc() -> impl PinInit<Self::Acc> {
+        new_lock!(KVVec::new())
+    }
+
+    fn fold(acc: &Self::Acc, v: T) {
+        let pushed = acc.lock().push_within_capacity(v).is_ok();
+        assert!(pushed, "Gather<KVVec> put with no room: a ref not from try_get()");
+    }
+
+    fn result(acc: &Self::Acc) -> Self {
+        core::mem::take(&mut *acc.lock())
+    }
+
+    fn reserve(acc: &Self::Acc, refs: usize) -> Result<(), AllocError> {
+        let (len, cap) = {
+            let v = acc.lock();
+            (v.len(), v.capacity())
+        };
+        if len + refs <= cap {
+            return Ok(());
+        }
+
+        let mut new = KVVec::with_capacity((len + refs).max(cap * 2), GFP_KERNEL)?;
+        let mut v = acc.lock();
+        for x in v.drain_all() {
+            // puts since are no more than the refs that were out: they fit
+            let pushed = new.push_within_capacity(x).is_ok();
+            debug_assert!(pushed);
+        }
+        core::mem::swap(&mut *v, &mut new);
+        drop(v);
+        // the old buffer freed with the lock dropped
+        Ok(())
+    }
+}
+
+/// The width of a Gather's state word: its low half counts refs, and above
+/// that are three flags and a generation. usize by default; u32 to save
+/// space, where 2^16 refs and a 13 bit generation will do; u64 for 2^32
+/// refs on 32 bit targets that have 64 bit atomics. Worked in as u64.
+pub trait Width: sealed::Sealed {
+    type Atomic: Send + Sync;
+    const BITS: u32;
+
+    fn new(v: u64) -> Self::Atomic;
+    fn load(a: &Self::Atomic, order: Ordering) -> u64;
+    /// AcqRel, Acquire on failure: every change to the word orders what's
+    /// around it.
+    fn compare_exchange_weak(a: &Self::Atomic, old: u64, new: u64) -> Result<u64, u64>;
+}
+
+mod sealed {
+    pub trait Sealed {}
+}
+
+macro_rules! width {
+    ($t:ty, $atomic:ty) => {
+        impl sealed::Sealed for $t {}
+
+        impl Width for $t {
+            type Atomic = $atomic;
+            const BITS: u32 = <$t>::BITS;
+
+            fn new(v: u64) -> $atomic {
+                <$atomic>::new(v as $t)
+            }
+
+            fn load(a: &$atomic, order: Ordering) -> u64 {
+                a.load(order) as u64
+            }
+
+            fn compare_exchange_weak(a: &$atomic, old: u64, new: u64) -> Result<u64, u64> {
+                a.compare_exchange_weak(old as $t, new as $t, Ordering::AcqRel, Ordering::Acquire)
+                    .map(|v| v as u64)
+                    .map_err(|v| v as u64)
+            }
+        }
+    };
+}
+
+width!(u32, AtomicU32);
+#[cfg(target_has_atomic = "64")]
+width!(u64, core::sync::atomic::AtomicU64);
+width!(usize, AtomicUsize);
+
+/// Everything in it is atomic: refs reach it through a pointer, and its
+/// waiter by &.
+#[pin_data(PinnedDrop)]
+pub struct Gather<T: Fold, W: Width = usize> {
+    state:  W::Atomic,
+    waiter: Slot,
+    #[pin]
+    acc:    T::Acc,
+    #[pin]
+    _pin:   PhantomPinned,
+}
+
+/// The waiter's Waker, as raw parts, for the last put: written by the waiter
+/// only with WAITING clear, read by a put only after seeing it set.
+struct Slot {
+    data:   AtomicPtr<()>,
+    vtable: AtomicPtr<RawWakerVTable>,
+}
+
+type RawParts = (*mut (), *mut RawWakerVTable);
+
+impl Slot {
+    const fn new() -> Self {
+        Slot { data: AtomicPtr::new(null_mut()), vtable: AtomicPtr::new(null_mut()) }
+    }
+
+    fn read(&self) -> RawParts {
+        (self.data.load(Ordering::Relaxed), self.vtable.load(Ordering::Relaxed))
+    }
+
+    /// @w given up to the slot: its parts, which own it.
+    fn write(&self, w: Waker) -> RawParts {
+        let w = ManuallyDrop::new(w);
+        let (data, vtable) = (w.data().cast_mut(), core::ptr::from_ref(w.vtable()).cast_mut());
+        self.data.store(data, Ordering::Relaxed);
+        self.vtable.store(vtable, Ordering::Relaxed);
+        (data, vtable)
+    }
+
+    fn will_wake(&self, w: &Waker) -> bool {
+        self.read() == (w.data().cast_mut(), core::ptr::from_ref(w.vtable()).cast_mut())
+    }
+}
+
+/// # Safety
+/// From Slot::write(), and owned: taken once.
+unsafe fn waker_from((data, vtable): RawParts) -> Waker {
+    // SAFETY: the caller's
+    unsafe { Waker::from_raw(RawWaker::new(data, &*vtable)) }
+}
+
+impl<T: Fold, W: Width> Gather<T, W> {
+    /* The state word: */
+    /// Refs not put: the owner's, until it waits, and every GatherRef's.
+    const COUNT:   u64 = (1 << (W::BITS / 2)) - 1;
+    /// The slot holds a waiter: the last put takes it.
+    const WAITING: u64 = 1 << (W::BITS / 2);
+    /// The owner has waited: its ref is dropped.
+    const WAITED:  u64 = Self::WAITING << 1;
+    /// A wait is under way - a Wait, or a sync wait - and the slot is its:
+    /// one at a time.
+    const IN_WAIT: u64 = Self::WAITING << 2;
+    /// Bumped each time the slot is filled; wraps out of the word's top.
+    const GEN:     u64 = Self::WAITING << 3;
+
+    pub fn new() -> impl PinInit<Self> {
+        pin_init!(Self {
+            state:  W::new(1),
+            waiter: Slot::new(),
+            acc     <- T::acc(),
+            _pin:   PhantomPinned,
+        })
+    }
+
+    /// A ref: one more thing in flight - from the owner, before it waits.
+    pub fn get(&self) -> GatherRef<T, W> {
+        const { assert!(!T::RESERVES, "this Gather's refs are try_get()") };
+        self.owner_get()
+    }
+
+    /// A ref, with room made for its put: for a Fold that RESERVES.
+    pub fn try_get(&self) -> Result<GatherRef<T, W>, AllocError> {
+        let state = W::load(&self.state, Ordering::Relaxed);
+        Self::assert_owner(state);
+        // the owner's ref counted too: one put it won't make, room to spare
+        T::reserve(&self.acc, (state & Self::COUNT) as usize + 1)?;
+        Ok(self.get_ref())
+    }
+
+    fn owner_get(&self) -> GatherRef<T, W> {
+        Self::assert_owner(W::load(&self.state, Ordering::Relaxed));
+        self.get_ref()
+    }
+
+    fn assert_owner(state: u64) {
+        assert!(state & Self::WAITED == 0, "Gather::get() after its owner waited: get from a ref");
+    }
+
+    /// A ref, from someone holding one.
+    fn get_ref(&self) -> GatherRef<T, W> {
+        // checked before it's changed: a panic leaves the word as it was
+        let mut old = W::load(&self.state, Ordering::Relaxed);
+        loop {
+            assert!(old & Self::COUNT != 0, "Gather ref got with none held");
+            assert!(old & Self::COUNT != Self::COUNT, "Gather: too many refs");
+            match W::compare_exchange_weak(&self.state, old, old + 1) {
+                Ok(_)    => return GatherRef(NonNull::from(self)),
+                Err(cur) => old = cur,
+            }
+        }
+    }
+
+    /// Fold @v in, if there's one, and drop a ref: the last wakes the waiter.
+    fn put(&self, v: Option<T::Item>) {
+        if let Some(v) = v {
+            T::fold(&self.acc, v);
+        }
+
+        let mut old = W::load(&self.state, Ordering::Acquire);
+        loop {
+            assert!(old & Self::COUNT != 0, "Gather put without a ref");
+            let mut new = old - 1;
+            // raw parts, the waiter's if the cmpxchg is the last put's
+            let mut waiter = None;
+            if new & (Self::COUNT|Self::WAITING) == Self::WAITING {
+                new &= !Self::WAITING;
+                waiter = Some(self.waiter.read());
+            }
+            match W::compare_exchange_weak(&self.state, old, new) {
+                Ok(_) => {
+                    // the Gather may be gone: what's ours is the waiter
+                    if let Some(w) = waiter {
+                        // SAFETY: read with WAITING set, unchanged since: GEN
+                        unsafe { waker_from(w) }.wake();
+                    }
+                    return;
+                }
+                Err(cur) => old = cur,
+            }
+        }
+    }
+
+    /// A wait begun: the slot ours, till end_wait().
+    fn begin_wait(&self) {
+        // checked before it's changed: a panic leaves the word as it was
+        let mut old = W::load(&self.state, Ordering::Relaxed);
+        loop {
+            assert!(old & Self::IN_WAIT == 0, "Gather waited on twice at once");
+            match W::compare_exchange_weak(&self.state, old, old | Self::IN_WAIT) {
+                Ok(_)    => return,
+                Err(cur) => old = cur,
+            }
+        }
+    }
+
+    fn end_wait(&self) {
+        let mut old = W::load(&self.state, Ordering::Relaxed);
+        while let Err(cur) = W::compare_exchange_weak(&self.state, old, old & !Self::IN_WAIT) {
+            old = cur;
+        }
+    }
+
+    /// The owner's ref dropped, the first time; whether every ref's put.
+    fn start_wait(&self) -> bool {
+        let mut old = W::load(&self.state, Ordering::Acquire);
+        while old & Self::WAITED == 0 {
+            match W::compare_exchange_weak(&self.state, old, (old - 1) | Self::WAITED) {
+                Ok(_)    => old = (old - 1) | Self::WAITED,
+                Err(cur) => old = cur,
+            }
+        }
+        old & Self::COUNT == 0
+    }
+
+    /// Every ref put, the owner's too.
+    fn done(&self) -> bool {
+        W::load(&self.state, Ordering::Acquire) & (Self::WAITED|Self::COUNT) == Self::WAITED
+    }
+
+    /// Leave @w for the last put, the owner having waited - or have it
+    /// back, if every ref's been put. A waiter still left - a Wait forgotten
+    /// rather than dropped - is taken back first: the slot's only written
+    /// with WAITING clear.
+    fn register(&self, w: Waker) -> Result<(), Waker> {
+        self.unregister();
+
+        let raw = self.waiter.write(w);
+
+        let mut old = W::load(&self.state, Ordering::Acquire);
+        loop {
+            debug_assert!(old & (Self::WAITED|Self::WAITING) == Self::WAITED);
+            if old & Self::COUNT == 0 {
+                // SAFETY: never published
+                return Err(unsafe { waker_from(raw) });
+            }
+            let new = (old | Self::WAITING).wrapping_add(Self::GEN);
+            match W::compare_exchange_weak(&self.state, old, new) {
+                Ok(_)    => return Ok(()),
+                Err(cur) => old = cur,
+            }
+        }
+    }
+
+    /// Take back the waiter left - unless the last put has: then it's done.
+    fn unregister(&self) -> bool {
+        let mut old = W::load(&self.state, Ordering::Acquire);
+        while old & Self::WAITING != 0 {
+            match W::compare_exchange_weak(&self.state, old, old & !Self::WAITING) {
+                Ok(_) => {
+                    // SAFETY: ours again: WAITING is clear
+                    drop(unsafe { waker_from(self.waiter.read()) });
+                    return true;
+                }
+                Err(cur) => old = cur,
+            }
+        }
+        false
+    }
+
+    /// Wait for every ref to be put, sleeping TASK_IDLE - no hung task
+    /// warnings - and take the result.
+    pub fn wait_sync(&self) -> T {
+        self.wait_sync_state(false)
+    }
+
+    /// wait_sync(), freezable: for refs whose holders freeze in place - kthreads
+    /// that do - whose owner must too.
+    pub fn wait_sync_freezable(&self) -> T {
+        self.wait_sync_state(true)
+    }
+
+    fn wait_sync_state(&self, freezable: bool) -> T {
+        self.begin_wait();
+        if !self.start_wait() && self.register(task_waker()).is_ok() {
+            let how = if freezable { Sleep::IDLE.freezable() } else { Sleep::IDLE };
+            let Ok(()) = sleep_until(how, || self.done().then_some(()));
+        }
+        self.end_wait();
+        T::result(&self.acc)
+    }
+
+    /// Wait for every ref to be put, asynchronously, for the result.
+    pub fn wait(&self) -> Wait<'_, T, W> {
+        self.begin_wait();
+        Wait { g: self, registered: false }
+    }
+}
+
+impl<T: Send, W: Width> Gather<KVVec<T>, W> {
+    /// What's been put since the last take, in @out - emptied first - with
+    /// refs still out: the puts move into the buffer @out had, which is
+    /// given the room theirs had, so any yet to come still fit.
+    pub fn take(&self, out: &mut KVVec<T>) -> Result<(), AllocError> {
+        out.clear();
+        // only the owner - us - changes it
+        let cap = self.acc.lock().capacity();
+        if out.capacity() < cap {
+            out.reserve(cap, GFP_KERNEL)?;
+        }
+        core::mem::swap(&mut *self.acc.lock(), out);
+        Ok(())
+    }
+}
+
+#[pin_init::pinned_drop]
+impl<T: Fold, W: Width> PinnedDrop for Gather<T, W> {
+    fn drop(self: Pin<&mut Self>) {
+        // Not waited on - its owner returned early, or an await of it was
+        // dropped - and refs may be out, raw ones in C's hands: wait them
+        // out. It's pinned, so it's where they point until it's freed. A
+        // Wait forgotten still has the wait: nothing waits on what's being
+        // dropped, so it's ours.
+        if !self.done() {
+            self.end_wait();
+            self.wait_sync_state(false);
+        }
+    }
+}
+
+/// A ref on a Gather: put with a value, or dropped without one.
+#[must_use = "a ref is put as soon as it's dropped"]
+pub struct GatherRef<T: Fold, W: Width = usize>(NonNull<Gather<T, W>>);
+
+// SAFETY: a Gather is atomics, and stays where it is until every ref is put;
+// what's put crosses to the owner's thread, so T::Item: Send
+unsafe impl<T: Fold, W: Width> Send for GatherRef<T, W> where T::Item: Send {}
+unsafe impl<T: Fold, W: Width> Sync for GatherRef<T, W> where T::Item: Send {}
+
+impl<T: Fold, W: Width> GatherRef<T, W> {
+    fn gather(&self) -> &Gather<T, W> {
+        // SAFETY: a ref holds the Gather where it is: its Drop waits for it
+        unsafe { self.0.as_ref() }
+    }
+
+    /// Another ref, for something this one's holder starts.
+    pub fn get(&self) -> GatherRef<T, W> {
+        const { assert!(!T::RESERVES, "this Gather's refs are try_get(), by its owner") };
+        self.gather().get_ref()
+    }
+
+    /// Fold @v into the result, and drop the ref.
+    pub fn put(self, v: T::Item) {
+        let g = ManuallyDrop::new(self);
+        g.gather().put(Some(v));
+    }
+
+    /// The ref as a pointer, for C - an endio's private - to put with
+    /// from_raw().put().
+    pub fn into_raw(self) -> *const Gather<T, W> {
+        ManuallyDrop::new(self).0.as_ptr()
+    }
+
+    /// The ref into_raw() made.
+    ///
+    /// # Safety
+    /// @g is from into_raw(), and this is the one from_raw() of it.
+    pub unsafe fn from_raw(g: *const Gather<T, W>) -> Self {
+        GatherRef(NonNull::new(g.cast_mut()).unwrap())
+    }
+}
+
+impl<T: Fold, W: Width> Drop for GatherRef<T, W> {
+    fn drop(&mut self) {
+        self.gather().put(None);
+    }
+}
+
+/// A GatherRef with no one holder - a count's, put by the count's last put,
+/// from any context: so taken through &, once, by whoever takes it first.
+/// Send and Sync as the ref is.
+pub struct GatherRefSlot<T: Fold, W: Width = usize> {
+    r:  AtomicPtr<Gather<T, W>>,
+    _r: PhantomData<GatherRef<T, W>>,
+}
+
+impl<T: Fold, W: Width> GatherRefSlot<T, W> {
+    pub const fn new() -> Self {
+        GatherRefSlot { r: AtomicPtr::new(null_mut()), _r: PhantomData }
+    }
+
+    /// @r, to hold till it's taken: the slot's empty.
+    pub fn set(&self, r: GatherRef<T, W>) {
+        let p = r.into_raw().cast_mut();
+        let old = self.r.swap(p, Ordering::AcqRel);
+        assert!(old.is_null(), "a GatherRefSlot set twice");
+    }
+
+    /// Its ref, if it hasn't been taken.
+    pub fn take(&self) -> Option<GatherRef<T, W>> {
+        let p = self.r.swap(null_mut(), Ordering::AcqRel);
+        // SAFETY: set()'s into_raw(), swapped out once: ours alone
+        (!p.is_null()).then(|| unsafe { GatherRef::from_raw(p) })
+    }
+}
+
+impl<T: Fold, W: Width> Drop for GatherRefSlot<T, W> {
+    fn drop(&mut self) {
+        drop(self.take());
+    }
+}
+
+/// Gather::wait()'s: the result, once every ref is put - awaited through
+/// resume_on(). Dropped unfinished, it takes its Waker back.
+#[must_use = "a wait does nothing unless awaited"]
+pub struct Wait<'a, T: Fold, W: Width = usize> {
+    g:          &'a Gather<T, W>,
+    /// Our Waker is in the slot.
+    registered: bool,
+}
+
+impl<T: Fold, W: Width> Resumable for Wait<'_, T, W> {
+    type Output = T;
+
+    fn poll_resume(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<T> {
+        let this = self.get_mut();
+        let g = this.g;
+        if g.start_wait() {
+            return Poll::Ready(T::result(&g.acc));
+        }
+        // still left, and as it would be: the slot's only ours to change
+        if this.registered && g.waiter.will_wake(cx.waker()) {
+            return Poll::Pending;
+        }
+        this.registered = false;
+        match g.register(cx.waker().clone()) {
+            Ok(()) => {
+                this.registered = true;
+                Poll::Pending
+            }
+            Err(_w) => Poll::Ready(T::result(&g.acc)),
+        }
+    }
+}
+
+impl<T: Fold, W: Width> Drop for Wait<'_, T, W> {
+    fn drop(&mut self) {
+        if self.registered {
+            self.g.unregister();
+        }
+        self.g.end_wait();
+    }
+}
