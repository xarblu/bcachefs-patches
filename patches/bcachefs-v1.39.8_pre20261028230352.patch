diff --git a/fs/bcachefs/util/module_param.rs b/fs/bcachefs/util/module_param.rs
new file mode 100644
index 0000000..9cceb91
--- /dev/null
+++ b/fs/bcachefs/util/module_param.rs
@@ -0,0 +1,205 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Module parameters defined in Rust: module_param!(), as C's
+//! module_param_named() and MODULE_PARM_DESC() together.
+//!
+//! Not the kernel crate's (kernel::module_param): that's for its module!()
+//! macro - our module's init is C - and only for parameters set at load, a
+//! SetOnce with perm 0, so nothing in sysfs. Ours are C's: the kernel_param in
+//! __param points at C's own param_ops_bool/uint/int, which parse, print and
+//! store the value, at load and, as perm allows, through
+//! /sys/module/bcachefs/parameters/ while the module is loaded.
+//!
+//! The value is an atomic with the C type's layout - AtomicBool is bool's,
+//! AtomicU32 unsigned int's. param_ops_* store to it through kernel_param.arg
+//! with plain C stores, under kernel_param_lock(); Rust loads it relaxed, as
+//! C reads a module parameter: an untorn read of a value that may change
+//! underneath, ordered against nothing.
+//!
+//! Loadable only, as bcachefs is (DKMS): the name has no "bcachefs." prefix,
+//! and kernel_param.mod is __this_module, which only a module has.
+//!
+//! The registration and the .modinfo strings are #[used(compiler)], as the
+//! kernel crate's are: plain #[used] is used(linker) from Rust 1.89, and the
+//! retain flag that sets gives each static its own section - which modpost,
+//! expecting one .modinfo, doesn't read. used_with_arg is in the features
+//! kbuild allows non-rust/ code from 6.16, our oldest kernel.
+//!
+//! Userspace has no module parameters: there the static is the value, always
+//! its default.
+
+use core::sync::atomic::{AtomicBool, AtomicI32, AtomicU32, Ordering};
+
+/// A type a module parameter can have: one C's param_ops_* handle.
+pub trait ParamType: Copy {
+    /// The value's storage: the C type's layout, which param_ops_* store to.
+    type Value: Sync;
+    /// The C type, as module_param() takes it and modinfo shows it.
+    const C_NAME: &'static str;
+    /// C's ops for it.
+    #[cfg(kernel)]
+    const OPS: *const kernel::bindings::kernel_param_ops;
+
+    fn load(v: &Self::Value) -> Self;
+}
+
+/// A module parameter's value: the static module_param!() defines.
+#[repr(transparent)]
+pub struct ModuleParam<T: ParamType>(T::Value);
+
+impl<T: ParamType> ModuleParam<T> {
+    pub fn get(&self) -> T {
+        T::load(&self.0)
+    }
+
+    /// Where param_ops_* store: the kernel_param's arg.
+    #[doc(hidden)]
+    pub const fn as_arg(&self) -> *mut core::ffi::c_void {
+        (&raw const self.0).cast_mut().cast()
+    }
+}
+
+macro_rules! param_types {
+    ($($t:ty: $value:ty, $c_name:literal, $ops:ident;)*) => {$(
+        impl ParamType for $t {
+            type Value = $value;
+            const C_NAME: &'static str = $c_name;
+            #[cfg(kernel)]
+            const OPS: *const kernel::bindings::kernel_param_ops =
+                &raw const kernel::bindings::$ops;
+
+            fn load(v: &$value) -> Self {
+                v.load(Ordering::Relaxed)
+            }
+        }
+
+        impl ModuleParam<$t> {
+            pub const fn new(v: $t) -> Self {
+                Self(<$value>::new(v))
+            }
+        }
+    )*};
+}
+
+param_types! {
+    bool: AtomicBool, "bool", param_ops_bool;
+    u32:  AtomicU32,  "uint", param_ops_uint;
+    i32:  AtomicI32,  "int",  param_ops_int;
+}
+
+/// kernel_param, which holds raw pointers, made Sync for a static: only the
+/// module loader and sysfs touch it, under kernel_param_lock().
+#[cfg(kernel)]
+#[doc(hidden)]
+#[repr(transparent)]
+pub struct KernelParam(pub kernel::bindings::kernel_param);
+
+#[cfg(kernel)]
+unsafe impl Sync for KernelParam {}
+
+/// @perm, checked as C's VERIFY_OCTAL_PERMISSIONS() does - at compile time,
+/// in the static's initializer.
+#[doc(hidden)]
+pub const fn verify_perm(perm: u16) -> u16 {
+    let (u, g, o) = ((perm >> 6) & 7, (perm >> 3) & 7, perm & 7);
+    assert!(perm <= 0o777, "module parameter permissions out of range");
+    assert!(u & 4 >= g & 4 && g & 4 >= o & 4,
+            "module parameter readable by group or other, but not user or group");
+    assert!(u & 2 >= g & 2, "module parameter writable by group, but not user");
+    assert!(o & 2 == 0, "module parameter writable by other");
+    perm
+}
+
+/// The length of the NUL-terminated concatenation of @parts.
+#[doc(hidden)]
+pub const fn modinfo_len(parts: &[&str]) -> usize {
+    let mut len = 1;
+    let mut i = 0;
+    while i < parts.len() {
+        len += parts[i].len();
+        i += 1;
+    }
+    len
+}
+
+/// A .modinfo string: @parts concatenated, NUL-terminated; LEN is
+/// modinfo_len() of them.
+#[doc(hidden)]
+pub const fn modinfo<const LEN: usize>(parts: &[&str]) -> [u8; LEN] {
+    let mut out = [0u8; LEN];
+    let mut at = 0;
+    let mut i = 0;
+    while i < parts.len() {
+        let b = parts[i].as_bytes();
+        let mut j = 0;
+        while j < b.len() {
+            assert!(b[j] != 0, "modinfo string contains a NUL byte");
+            out[at] = b[j];
+            at += 1;
+            j += 1;
+        }
+        i += 1;
+    }
+    out
+}
+
+/// A module parameter, as C's module_param_named() and MODULE_PARM_DESC():
+///
+/// ```text
+/// module_param! {
+///     pub(crate) static snapshot_delete_bail_before_inodes: bool = false;
+///     #[cfg(CONFIG_BCACHEFS_DEBUG)]
+///     perm = 0o644, desc = "Cancel snapshot deletion before the inode keys are deleted";
+/// }
+/// ```
+///
+/// The static is a ModuleParam, read with get(), under the parameter's name;
+/// attributes before `perm` gate the parameter's registration, not the static,
+/// so a debug-only parameter reads as its default in other builds, as C's
+/// #ifdef'd module_param() leaves its variable.
+#[macro_export]
+macro_rules! module_param {
+    (
+        $(#[$attr:meta])*
+        $vis:vis static $name:ident: $t:ty = $default:expr;
+        $(#[$reg:meta])*
+        perm = $perm:expr, desc = $desc:literal $(;)?
+    ) => {
+        $(#[$attr])*
+        #[allow(non_upper_case_globals)]
+        $vis static $name: $crate::util::module_param::ModuleParam<$t> =
+            $crate::util::module_param::ModuleParam::<$t>::new($default);
+
+        #[cfg(kernel)]
+        $(#[$reg])*
+        const _: () = {
+            use $crate::util::module_param::{modinfo, modinfo_len, verify_perm, KernelParam,
+                                             ParamType};
+
+            #[link_section = "__param"]
+            #[used(compiler)]
+            static PARAM: KernelParam = KernelParam(::kernel::bindings::kernel_param {
+                name:  ::core::concat!(::core::stringify!($name), "\0").as_ptr().cast(),
+                mod_:  &raw mut ::kernel::bindings::__this_module,
+                ops:   <$t as ParamType>::OPS,
+                perm:  verify_perm($perm),
+                level: -1,
+                flags: 0,
+                __bindgen_anon_1: ::kernel::bindings::kernel_param__bindgen_ty_1 {
+                    arg: $name.as_arg(),
+                },
+            });
+
+            const PARMTYPE: &[&str] =
+                &["parmtype=", ::core::stringify!($name), ":", <$t as ParamType>::C_NAME];
+            #[link_section = ".modinfo"]
+            #[used(compiler)]
+            static PARMTYPE_INFO: [u8; modinfo_len(PARMTYPE)] = modinfo(PARMTYPE);
+
+            const PARM: &[&str] = &["parm=", ::core::stringify!($name), ":", $desc];
+            #[link_section = ".modinfo"]
+            #[used(compiler)]
+            static PARM_INFO: [u8; modinfo_len(PARM)] = modinfo(PARM);
+        };
+    };
+}
diff --git a/fs/bcachefs/util/names.rs b/fs/bcachefs/util/names.rs
new file mode 100644
index 0000000..b918658
--- /dev/null
+++ b/fs/bcachefs/util/names.rs
@@ -0,0 +1,197 @@
+// SPDX-License-Identifier: GPL-2.0
+//! What an enum built from an x-macro list is named: Names, which c_enum!
+//! implements for each.
+//!
+//! A static description, not a visitor: ENTRIES is each variant's name and
+//! value - a flags type's, its bit - and a value with none is "(unknown 7)".
+//! Free to make, as it's only data; a dense table by
+//! value, as C's string tables are, is names_by_value!(T), made where it's
+//! wanted.
+//!
+//! What prints them is generic code over that, not code per enum: c_enum!'s
+//! ToText for an open enum is a call to prt_name(), one copy, and #[inline] -
+//! an enum nothing prints costs nothing.
+
+use core::ffi::CStr;
+use core::marker::PhantomData;
+
+use crate::util::ffi::c_char;
+use crate::util::{Join, Printbuf, ToText};
+
+pub trait Names {
+    /// Each labelled variant's name and value - a flags type's, its bit - in
+    /// the list's order.
+    const ENTRIES: &'static [(&'static str, u64)];
+}
+
+/// @v's name in @entries.
+pub fn name_of(entries: &[(&'static str, u64)], v: u64) -> Option<&'static str> {
+    entries.iter().find(|&&(_, e)| e == v).map(|&(n, _)| n)
+}
+
+/// @v's name in @entries, or "(unknown @v)".
+pub fn prt_name(out: &mut Printbuf, entries: &[(&'static str, u64)], v: u64) {
+    match name_of(entries, v) {
+        Some(name) => write!(out, "{name}"),
+        None       => write!(out, "(unknown {v})"),
+    };
+}
+
+/// The names of the bits set in @v, comma separated.
+pub fn prt_flags(out: &mut Printbuf, entries: &[(&'static str, u64)], v: u64) {
+    let set = entries.iter().filter(|&&(_, bit)| bit < 64 && v & 1 << bit != 0);
+    write!(out, "{}", Join(",", set.map(|&(name, _)| name)));
+}
+
+/// The names of @T's values, indexed by value - "" for a value none has: a
+/// table where one's wanted, for an enum whose values are dense - an option's
+/// choices, C's string tables. Built at compile time: two names for one value
+/// fail the build.
+#[macro_export]
+macro_rules! names_by_value {
+    ($t:ty) => {{
+        const N: usize = $crate::util::names::table_len(<$t as $crate::util::names::Names>::ENTRIES);
+        const T: [&str; N] = $crate::util::names::by_value(<$t as $crate::util::names::Names>::ENTRIES);
+        &T
+    }};
+}
+
+/// The length a table of @entries needs: the largest value, plus one.
+pub const fn table_len(entries: &[(&'static str, u64)]) -> usize {
+    let mut len = 0;
+    let mut i = 0;
+    while i < entries.len() {
+        if entries[i].1 as usize + 1 > len {
+            len = entries[i].1 as usize + 1;
+        }
+        i += 1;
+    }
+    len
+}
+
+/// @entries' names, each at its value.
+pub const fn by_value<const N: usize>(entries: &[(&'static str, u64)]) -> [&'static str; N] {
+    let mut names = [""; N];
+    let mut i = 0;
+    while i < entries.len() {
+        let (name, v) = entries[i];
+        assert!(names[v as usize].is_empty(), "two names for one value");
+        names[v as usize] = name;
+        i += 1;
+    }
+    names
+}
+
+/// A flags type's bit, for @mask: a flag is one bit.
+pub const fn bit(mask: u64) -> u64 {
+    assert!(mask.is_power_of_two(), "a flag that isn't one bit");
+    mask.trailing_zeros() as u64
+}
+
+/// The values set in @mask - a bit each - by name, comma separated: a set of
+/// @T, a btree id mask's ids.
+#[inline]
+pub fn prt_set<T: Names>(out: &mut Printbuf, mask: u64) {
+    prt_flags(out, T::ENTRIES, mask)
+}
+
+/// prt_set(), for a format string: `prt!(out, "{}", set::<T>(mask))`.
+pub fn set<T: Names>(mask: u64) -> Set<T> {
+    Set(mask, PhantomData)
+}
+
+pub struct Set<T>(u64, PhantomData<T>);
+
+impl<T: Names> ToText for Set<T> {
+    fn to_text(&self, out: &mut Printbuf) {
+        prt_set::<T>(out, self.0)
+    }
+}
+
+// ── C's string tables ────────────────────────────────────────────────────
+
+/// The length of @T's C table: its values, and the NULL after.
+pub const fn c_table_len<T: Names>() -> usize {
+    table_len(T::ENTRIES) + 1
+}
+
+/// @T's names as C's string tables have them - by value, each NUL
+/// terminated, NULL for a value none has, and NULL after the last - for a
+/// static of [*const c_char; c_table_len::<T>()]. Built at compile time: the
+/// names, NUL terminated, in a static of their own, and the table into it.
+#[macro_export]
+macro_rules! c_names_table {
+    ($t:ty) => {{
+        const E: &[(&str, u64)] = <$t as $crate::util::names::Names>::ENTRIES;
+        static BUF: [u8; $crate::util::names::nul_len(E)] = $crate::util::names::nul_names(E);
+        $crate::util::names::c_table(&BUF, E)
+    }};
+}
+
+/// The length of @entries' names, each NUL terminated.
+pub const fn nul_len(entries: &[(&str, u64)]) -> usize {
+    let mut len = 0;
+    let mut i = 0;
+    while i < entries.len() {
+        len += entries[i].0.len() + 1;
+        i += 1;
+    }
+    len
+}
+
+/// @entries' names, each NUL terminated, in order.
+pub const fn nul_names<const B: usize>(entries: &[(&str, u64)]) -> [u8; B] {
+    let mut buf = [0; B];
+    let (mut i, mut at) = (0, 0);
+    while i < entries.len() {
+        let name = entries[i].0.as_bytes();
+        let mut j = 0;
+        while j < name.len() {
+            buf[at + j] = name[j];
+            j += 1;
+        }
+        at += name.len() + 1;
+        i += 1;
+    }
+    buf
+}
+
+/// C's table of @entries' names, nul_names()'s @buf: by value, NULL for a
+/// value none has, and NULL after the last.
+pub const fn c_table<const N: usize>(buf: &'static [u8], entries: &[(&str, u64)]) -> [*const c_char; N] {
+    let mut t = [core::ptr::null(); N];
+    let (mut i, mut at) = (0, 0);
+    while i < entries.len() {
+        t[entries[i].1 as usize] = buf.as_ptr().wrapping_add(at).cast();
+        at += entries[i].0.len() + 1;
+        i += 1;
+    }
+    t
+}
+
+/// @T's names as C strings, by value - "" for a value none has: for what
+/// wants &CStr, sysfs's file names. Built at compile time, as
+/// c_names_table!'s.
+#[macro_export]
+macro_rules! cstr_names {
+    ($t:ty) => {{
+        const E: &[(&str, u64)] = <$t as $crate::util::names::Names>::ENTRIES;
+        static BUF: [u8; $crate::util::names::nul_len(E)] = $crate::util::names::nul_names(E);
+        $crate::util::names::cstr_table::<{ $crate::util::names::table_len(E) }>(&BUF, E)
+    }};
+}
+
+/// @entries' names, nul_names()'s @buf, as C strings, by value.
+pub const fn cstr_table<const N: usize>(buf: &'static [u8], entries: &[(&str, u64)]) -> [&'static CStr; N] {
+    let mut t = [c""; N];
+    let (mut i, mut at) = (0, 0);
+    while i < entries.len() {
+        t[entries[i].1 as usize] = match CStr::from_bytes_until_nul(buf.split_at(at).1) {
+            Ok(name) => name,
+            Err(_)   => panic!("nul_names() without its NUL"),
+        };
+        at += entries[i].0.len() + 1;
+        i += 1;
+    }
+    t
+}
diff --git a/fs/bcachefs/util/ops.rs b/fs/bcachefs/util/ops.rs
new file mode 100644
index 0000000..42bc1c6
--- /dev/null
+++ b/fs/bcachefs/util/ops.rs
@@ -0,0 +1,227 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! The kernel's operation tables - file_operations, and the VFS's super,
+//! inode and export operations - as traits, each from one declaration:
+//! vfs_ops!.
+//!
+//! The header names the trait, the C table, and the vtable that fills it in,
+//! `$VTable<P: Bound> = Impl`: generic over P, what the kernel object's
+//! private pointer points to, Impl the implementor had from it - P itself
+//! for the VFS's, P::Ops for a file's.
+//!
+//! An op is its Rust signature. From it come the trait method - unreachable
+//! unless given a body; #[vtable] sets HAS_* for what an impl has - the
+//! extern "C" adapter, and the table, OPS, then whatever the header's
+//! `|ops| { }` sets.
+//!
+//! The adapter takes each argument as the kernel passes its Rust type -
+//! FromRaw::Raw, one raw type to each - and converts it; the return goes
+//! through IntoRaw to whatever the table's field has, as Result<(),
+//! BchError> is an int to one op and an ERR_PTR to another. Where the raw
+//! arguments don't map one to one, the adapter is written out, after `=>
+//! extern`.
+//!
+//! `&self = arg` makes an op a method, &self had from arg by SelfOf. Ops that
+//! dereference raw pointers go in `unsafe { }`, their contract the kernel's.
+//!
+//! FromRaw's impls say once a type what the kernel guarantees of what it
+//! passes: referenced, and ours, for the call. IntoRaw's class errors.
+
+// The tools' file ops are open and read, their adapters written out: none of
+// the converting is used there
+#![cfg_attr(not(kernel), allow(dead_code, unused_imports))]
+
+use core::ffi::c_int;
+
+use crate::errcode::{ret_to_class, BchError};
+
+/// A raw argument an op is passed, as its trait method takes it: each Rust
+/// type from the one raw type the kernel passes it as.
+pub(crate) trait FromRaw: Sized {
+    type Raw;
+
+    /// # Safety
+    /// @r is what the kernel passes: live, and ours, for the call.
+    unsafe fn from_raw(r: Self::Raw) -> Self;
+}
+
+/// A trait method's return, as the op returns it.
+pub(crate) trait IntoRaw<R> {
+    fn into_raw(self) -> R;
+}
+
+impl<T> IntoRaw<T> for T {
+    fn into_raw(self) -> T { self }
+}
+
+/// What &self is had from, for a `&self = arg` op of a vtable over P.
+pub(crate) trait SelfOf<P> {
+    type Out;
+
+    /// # Safety
+    /// As FromRaw's, and its private pointer a P's.
+    unsafe fn self_of<'a>(&self) -> &'a Self::Out;
+}
+
+/// FromRaw impls, one a line: the Rust type, the raw one, and the one had
+/// from the other, under FromRaw's contract.
+macro_rules! from_raw {
+    ($($(#[doc = $d:expr])* $t:ty = $raw:ty => |$r:ident| $e:expr;)*) => {$(
+        $(#[doc = $d])*
+        impl<'a> $crate::util::ops::FromRaw for $t {
+            type Raw = $raw;
+            #[allow(unused_unsafe)]
+            unsafe fn from_raw($r: $raw) -> Self { unsafe { $e } }
+        }
+    )*};
+}
+pub(crate) use from_raw;
+
+/// IntoRaw impls, as from_raw!'s.
+macro_rules! into_raw {
+    ($($(#[doc = $d:expr])* $t:ty => $raw:ty: |$v:ident| $e:expr;)*) => {$(
+        $(#[doc = $d])*
+        impl $crate::util::ops::IntoRaw<$raw> for $t {
+            fn into_raw(self) -> $raw { let $v = self; $e }
+        }
+    )*};
+}
+pub(crate) use into_raw;
+
+// What's passed as it's taken: the scalars, and raw pointers
+macro_rules! as_passed {
+    ($($t:ty),*) => {$( impl FromRaw for $t { type Raw = $t; unsafe fn from_raw(r: $t) -> $t { r } } )*};
+}
+as_passed!(bool, u16, u32, u64, usize, i32, i64);
+
+impl<T> FromRaw for *mut T {
+    type Raw = *mut T;
+    unsafe fn from_raw(r: *mut T) -> *mut T { r }
+}
+
+impl<T> FromRaw for *const T {
+    type Raw = *const T;
+    unsafe fn from_raw(r: *const T) -> *const T { r }
+}
+
+into_raw! {
+    Result<(), BchError> => c_int: |r| ret_to_class(r);
+}
+
+/// See the file comment.
+#[macro_export]
+macro_rules! vfs_ops {
+    (
+        $(#[$tm:meta])*
+        $vis:vis trait $Trait:ident $(: $sup:ident $(+ $sups:ident)*)? for $Ops:ty,
+            $VTable:ident<$P:ident: $Bound:path> = $Impl:ty $(, |$o:ident| $init:block)?;
+        $( $(#[doc = $doc:expr])* $(#[cfg($cfg:meta)])*
+           fn $name:ident ( $(&self = $sa:ident ,)? $($arg:ident : $ty:ty),* $(,)? )
+              $(-> $ret:ty)? $({ $($body:tt)* })?
+              $(=> extern ( $($xarg:ident : $xty:ty),* ) $(-> $xret:ty)? { $($xbody:tt)* })? ; )*
+        $( unsafe {
+            $( $(#[doc = $udoc:expr])* $(#[cfg($ucfg:meta)])*
+               fn $uname:ident ( $(&self = $usa:ident ,)? $($uarg:ident : $uty:ty),* $(,)? )
+                  $(-> $uret:ty)? $({ $($ubody:tt)* })? ; )*
+        } )?
+    ) => { $crate::paste! {
+        $(#[$tm])*
+        $vis trait $Trait: Sized + 'static $(+ $sup $(+ $sups)*)? {
+            $(
+                $(#[cfg($cfg)])*
+                const [<HAS_ $name:upper>]: bool = $crate::vfs_ops!(@has $({ $($body)* })?);
+                $crate::vfs_ops!(@method [$(#[doc = $doc])* $(#[cfg($cfg)])*] [] [$($sa)?]
+                                 $name [$($arg: $ty),*] [$($ret)?] [$($($body)*)?]);
+            )*
+            $($(
+                $(#[cfg($ucfg)])*
+                const [<HAS_ $uname:upper>]: bool = $crate::vfs_ops!(@has $({ $($ubody)* })?);
+                $crate::vfs_ops!(@method [$(#[doc = $udoc])* $(#[cfg($ucfg)])*] [unsafe] [$($usa)?]
+                                 $uname [$($uarg: $uty),*] [$($uret)?] [$($($ubody)*)?]);
+            )*)?
+        }
+
+        $vis struct $VTable<$P>(::core::marker::PhantomData<$P>);
+
+        impl<$P: $Bound> $VTable<$P> {
+            $vis const OPS: $Ops = {
+                // SAFETY: zero is NULL, "not implemented"
+                let mut ops: $Ops = unsafe { ::core::mem::zeroed() };
+                $( $(#[cfg($cfg)])* if <$Impl>::[<HAS_ $name:upper>] { ops.$name = Some(Self::$name); } )*
+                $($( $(#[cfg($ucfg)])* if <$Impl>::[<HAS_ $uname:upper>] { ops.$uname = Some(Self::$uname); } )*)?
+                $( let ops = { let mut $o = ops; $init $o }; )?
+                ops
+            };
+
+            $(
+                $crate::vfs_ops!(@adapter_fn [$(#[cfg($cfg)])*] [$P $Impl] [$($sa)?]
+                                 $name [$($arg: $ty),*] [$($ret)?]
+                                 [$( ($($xarg: $xty),*) [$($xret)?] { $($xbody)* } )?]);
+            )*
+            $($(
+                $crate::vfs_ops!(@adapter_fn [$(#[cfg($ucfg)])*] [$P $Impl] [$($usa)?]
+                                 $uname [$($uarg: $uty),*] [$($uret)?] []);
+            )*)?
+        }
+    } };
+
+    (@has { $($body:tt)* }) => { true };
+    (@has) => { false };
+
+    // The trait method: &self for a `&self = arg` op; the body given, or one
+    // that can't be reached - it's not in the vtable
+    (@method [$($attr:tt)*] [$($u:ident)?] [$sa:ident] $name:ident [$($arg:ident: $ty:ty),*]
+             [$($ret:ty)?] [$($body:tt)*]) => {
+        $($attr)* $($u)? fn $name(&self, $($arg: $ty),*) $(-> $ret)? {
+            $crate::vfs_ops!(@body [$($arg)*] $($body)*)
+        }
+    };
+    (@method [$($attr:tt)*] [$($u:ident)?] [] $name:ident [$($arg:ident: $ty:ty),*]
+             [$($ret:ty)?] [$($body:tt)*]) => {
+        $($attr)* $($u)? fn $name($($arg: $ty),*) $(-> $ret)? {
+            $crate::vfs_ops!(@body [$($arg)*] $($body)*)
+        }
+    };
+    (@body [$($arg:ident)*]) => {{
+        $(let _ = $arg;)*
+        unreachable!("not in the vtable")
+    }};
+    (@body [$($arg:ident)*] $($body:tt)+) => {{ $($body)+ }};
+
+    // The adapter: written out; or each argument taken as the kernel passes
+    // its type, and converted, the method called - on &self, had from the
+    // argument while it's still raw - and the return converted to what the
+    // table's field has
+    (@adapter_fn [$($cfg:tt)*] $pi:tt $sa:tt $name:ident $args:tt $ret:tt
+                 [($($xarg:ident: $xty:ty),*) [$($xret:ty)?] { $($xbody:tt)* }]) => {
+        $($cfg)*
+        unsafe extern "C" fn $name($($xarg: $xty),*) $(-> $xret)? { $($xbody)* }
+    };
+    (@adapter_fn $cfg:tt $pi:tt $sa:tt $name:ident $args:tt [] []) => {
+        $crate::vfs_ops!(@adapter_fn $cfg $pi $sa $name $args [()] []);
+    };
+    (@adapter_fn [$($cfg:tt)*] [$P:ident $Impl:ty] [$($sa:ident)?] $name:ident
+                 [$($arg:ident: $ty:ty),*] [$ret:ty] []) => {
+        $($cfg)*
+        unsafe extern "C" fn $name<RawRet>($($arg: <$ty as $crate::util::ops::FromRaw>::Raw),*) -> RawRet
+        where $ret: $crate::util::ops::IntoRaw<RawRet>
+        {
+            $crate::vfs_ops!(@call [$P $Impl] [$($sa)?] $name [$($arg: $ty),*])
+        }
+    };
+    (@call [$P:ident $Impl:ty] [$sa:ident] $name:ident [$($arg:ident: $ty:ty),*]) => {
+        // SAFETY: FromRaw's and SelfOf's
+        unsafe {
+            let this: &$Impl = $crate::util::ops::SelfOf::<$P>::self_of(&$sa);
+            $(let $arg: $ty = $crate::util::ops::FromRaw::from_raw($arg);)*
+            $crate::util::ops::IntoRaw::into_raw(this.$name($($arg),*))
+        }
+    };
+    (@call [$P:ident $Impl:ty] [] $name:ident [$($arg:ident: $ty:ty),*]) => {
+        // SAFETY: FromRaw's
+        unsafe {
+            $(let $arg: $ty = $crate::util::ops::FromRaw::from_raw($arg);)*
+            $crate::util::ops::IntoRaw::into_raw(<$Impl>::$name($($arg),*))
+        }
+    };
+}
diff --git a/fs/bcachefs/util/os_str.rs b/fs/bcachefs/util/os_str.rs
new file mode 100644
index 0000000..e819f9e
--- /dev/null
+++ b/fs/bcachefs/util/os_str.rs
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Names - filenames, xattr names: bytes, not UTF-8. That's std's OsStr, on
+//! unix; userspace uses it, and the kernel build, which is no_std, gets a
+//! copy of the part of its interface we use.
+//!
+//! Written against std's: `OsStr::from_bytes()` and `.as_bytes()` with
+//! OsStrExt in scope, the same in both builds.
+//!
+//! C's struct qstr is the same thing, with no lifetime: qstr() and
+//! qstr_name() convert at the boundary.
+
+use crate::c;
+
+#[cfg(feature = "std")]
+pub use std::{ffi::OsStr, os::unix::ffi::OsStrExt};
+
+#[cfg(not(feature = "std"))]
+pub use no_std::{OsStr, OsStrExt};
+
+#[cfg(not(feature = "std"))]
+mod no_std {
+    use core::fmt;
+
+    /// std::ffi::OsStr, as on unix: any bytes.
+    #[repr(transparent)]
+    #[derive(PartialEq, Eq, PartialOrd, Ord, Hash)]
+    pub struct OsStr([u8]);
+
+    impl OsStr {
+        pub fn len(&self) -> usize {
+            self.0.len()
+        }
+
+        pub fn is_empty(&self) -> bool {
+            self.0.is_empty()
+        }
+    }
+
+    /// std::os::unix::ffi::OsStrExt.
+    pub trait OsStrExt {
+        fn from_bytes(slice: &[u8]) -> &Self;
+        fn as_bytes(&self) -> &[u8];
+    }
+
+    impl OsStrExt for OsStr {
+        fn from_bytes(slice: &[u8]) -> &OsStr {
+            // repr(transparent): an OsStr is its bytes
+            unsafe { &*(slice as *const [u8] as *const OsStr) }
+        }
+
+        fn as_bytes(&self) -> &[u8] {
+            &self.0
+        }
+    }
+
+    /// As std's: the bytes, escaped where they aren't printable ASCII.
+    impl fmt::Debug for OsStr {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            write!(f, "\"{}\"", self.0.escape_ascii())
+        }
+    }
+}
+
+/// @name as C's qstr, which points at it: for a C call, which mustn't keep
+/// it.
+pub fn qstr(name: &OsStr) -> c::qstr {
+    let name = name.as_bytes();
+    c::qstr {
+        __bindgen_anon_1: c::qstr__bindgen_ty_1 {
+            __bindgen_anon_1: c::qstr__bindgen_ty_1__bindgen_ty_1 {
+                hash: 0,
+                len:  name.len() as u32,
+            },
+        },
+        name: name.as_ptr(),
+    }
+}
+
+/// The NUL-terminated name at @p, without the NUL.
+///
+/// # Safety
+/// @p is a NUL-terminated string, valid for 'a.
+pub unsafe fn cstr_name<'a>(p: *const crate::util::ffi::c_char) -> &'a OsStr {
+    OsStr::from_bytes(unsafe { core::ffi::CStr::from_ptr(p.cast()) }.to_bytes())
+}
+
+/// The name C's qstr @q points at.
+///
+/// # Safety
+/// @q points at its len bytes, and they outlive 'a.
+pub unsafe fn qstr_name<'a>(q: &c::qstr) -> &'a OsStr {
+    let len = unsafe { q.__bindgen_anon_1.__bindgen_anon_1.len } as usize;
+    let bytes = if len == 0 { &[] } else { unsafe { core::slice::from_raw_parts(q.name, len) } };
+    OsStr::from_bytes(bytes)
+}
diff --git a/fs/bcachefs/util/par.rs b/fs/bcachefs/util/par.rs
new file mode 100644
index 0000000..d575b75
--- /dev/null
+++ b/fs/bcachefs/util/par.rs
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Fork-join, as rayon's scope() and std::thread::scope(): jobs run in
+//! parallel - each on a kthread of its own, or on a workqueue, the caller's
+//! choice - borrowing from their caller, and all joined before scope()
+//! returns. A job's name is its kthread's, seen in ps - a thread's cost
+//! each - or its worker's description while it runs, in workqueue dumps and
+//! backtraces, a workqueue's workers being lighter. For a long-lived thread
+//! of one's own, a daemon, there's util::kthread.
+//!
+//! The jobs the scope's body spawns are made, not started, until it returns:
+//! then they're started together - if it succeeded. If it didn't, none of
+//! them runs, and its error is the scope's; a job's error is the scope's
+//! only when its body succeeded, the first by the order they were spawned.
+//!
+//! Only the body spawns: a Scope isn't Sync, so a job can't take it along.
+//! Nothing needs a job spawning more; when something does, rayon's way -
+//! a job handed a scope of its own - is how it'd go.
+//!
+//! The join sleeps TASK_IDLE, without hung task warnings - as
+//! closure_sync_unbounded() does, what C's fan-outs mostly join with.
+//! scope_freezable() is for jobs that freeze in place: its join is
+//! freezable, and so are its kthreads (Kthread::set_freezable()); a
+//! workqueue's workers are as the queue is, WQ_FREEZABLE.
+//!
+//! A job can't borrow its caller's transaction - BtreeTrans isn't Sync - so
+//! each gets its own, as C's workers do.
+//!
+//! A job is a task (util::task) - spawn_unstarted(), on its own kthread or
+//! the workqueue - whose future runs the job's closure; joined by its
+//! JoinHandle. That's what makes borrowing sound: the scope joins every
+//! task it started, and drops every one it didn't, before it returns - as
+//! std::thread::scope() joins its threads.
+
+use crate::c;
+use crate::errcode::BchError;
+use crate::util::alloc::{flags::GFP_KERNEL, KVVec};
+use crate::util::task::{spawn_unstarted, JoinHandle, Spawn, Unstarted};
+use crate::util::workqueue::Queue;
+use crate::util::Printbuf;
+use core::cell::RefCell;
+use core::fmt;
+use core::marker::PhantomData;
+
+/// Where a scope's jobs run.
+#[derive(Clone, Copy)]
+pub enum Backend<'a> {
+    /// A kthread each.
+    Kthreads,
+    /// On a workqueue.
+    Workqueue(&'a Queue),
+}
+
+type Ret = Result<(), BchError>;
+
+enum Job {
+    Made(Unstarted<Ret>),
+    Started(JoinHandle<Ret>),
+    Moved,
+}
+
+/// The body's: not Sync - only the body spawns.
+pub struct Scope<'scope, 'env: 'scope> {
+    backend:   Backend<'env>,
+    freezable: bool,
+    /// What the body's spawned, in order.
+    jobs:      RefCell<KVVec<Job>>,
+    scope:     PhantomData<&'scope mut &'scope ()>,
+    env:       PhantomData<&'env mut &'env ()>,
+}
+
+/// Run @f, which spawns jobs on @backend that may borrow what outlives the
+/// call; if it succeeded, start them, and join them: @f's error, or else the
+/// first a job returned.
+pub fn scope<'env, F>(backend: Backend<'env>, f: F) -> Ret
+where
+    F: for<'scope> FnOnce(&'scope Scope<'scope, 'env>) -> Ret,
+{
+    run_scope(backend, false, f)
+}
+
+/// scope(), for jobs that freeze in place: their kthreads freezable, and the
+/// join, as their caller must be too.
+pub fn scope_freezable<'env, F>(backend: Backend<'env>, f: F) -> Ret
+where
+    F: for<'scope> FnOnce(&'scope Scope<'scope, 'env>) -> Ret,
+{
+    run_scope(backend, true, f)
+}
+
+fn run_scope<'env, F>(backend: Backend<'env>, freezable: bool, f: F) -> Ret
+where
+    F: for<'scope> FnOnce(&'scope Scope<'scope, 'env>) -> Ret,
+{
+    let scope = Scope {
+        backend,
+        freezable,
+        jobs:  RefCell::new(KVVec::new()),
+        scope: PhantomData,
+        env:   PhantomData,
+    };
+    let ret = f(&scope);
+
+    // @f failed, or unwound: its jobs dropped unstarted, with @jobs
+    let mut jobs = scope.jobs.take();
+    ret?;
+
+    for job in jobs.iter_mut() {
+        if let Job::Made(u) = core::mem::replace(job, Job::Moved) {
+            *job = Job::Started(u.start());
+        }
+    }
+
+    let mut ret = Ok(());
+    for job in jobs.iter_mut() {
+        if let Job::Started(h) = core::mem::replace(job, Job::Moved) {
+            let r = if freezable { h.join_sync_freezable() } else { h.join_sync() };
+            if ret.is_ok() {
+                ret = r;
+            }
+        }
+    }
+    ret
+}
+
+impl<'scope, 'env> Scope<'scope, 'env> {
+    /// @f, named @name, made to run on the scope's backend when the body
+    /// returns. Nothing's run if it can't be made.
+    pub fn spawn<F>(&'scope self, name: fmt::Arguments<'_>, f: F) -> Ret
+    where
+        F: FnOnce() -> Ret + Send + 'scope,
+    {
+        // SAFETY: what @f borrows outlives 'scope, and run_scope() joins or
+        // drops every job before 'scope ends; the queue is 'env's
+        let job = unsafe {
+            match self.backend {
+                Backend::Kthreads => {
+                    let thread = Spawn::Thread { name, freezable: self.freezable };
+                    spawn_unstarted(thread, move || async move { f() })?
+                }
+                Backend::Workqueue(wq) => {
+                    let desc = worker_desc(name);
+                    spawn_unstarted(Spawn::Queue(wq), move || async move {
+                        c::bch2_set_worker_desc(desc.as_ptr().cast());
+                        f()
+                    })?
+                }
+            }
+        };
+        // not pushed, it's dropped: discarded
+        self.jobs.borrow_mut().push(Job::Made(job), GFP_KERNEL)?;
+        Ok(())
+    }
+}
+
+/// @name, as set_worker_desc() takes it: WORKER_DESC_LEN, NUL included -
+/// it'd truncate there anyway.
+fn worker_desc(name: fmt::Arguments<'_>) -> [u8; 32] {
+    let mut buf = Printbuf::new();
+    write!(buf, "{name}");
+    let name = buf.as_c_str().to_bytes();
+    let mut desc = [0u8; 32];
+    let len = name.len().min(desc.len() - 1);
+    desc[..len].copy_from_slice(&name[..len]);
+    desc
+}
diff --git a/fs/bcachefs/util/percpu.rs b/fs/bcachefs/util/percpu.rs
new file mode 100644
index 0000000..bd17820
--- /dev/null
+++ b/fs/bcachefs/util/percpu.rs
@@ -0,0 +1,603 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Per-CPU data in the structs C allocates it in - a `T __percpu *` field -
+//! typed and operated on from Rust. The kernel has no per-CPU operations for
+//! Rust (as of 7.3 a posted series is x86_64 only, and userspace has none), so
+//! these are ours: C's operations, with C's contract.
+//!
+//! Per-CPU data is of two kinds, which want different things:
+//!
+//! - Counters - counters.now, io_done, ca->usage, capacity.pcpu's usage and
+//!   online_reserved: added to on whatever CPU the adder is on, from any
+//!   context, and only read as the sum over every CPU. Each CPU's copy is a
+//!   signed delta - a reservation taken on one CPU is put on another - so the
+//!   adds wrap, and a sum is exact only with the adders excluded: one that
+//!   races them can come out negative. Counters says how a T sums - wrapping,
+//!   and clamped for racing reads - field by field for a struct, by
+//!   #[derive(Fieldwise)].
+//!
+//! - Slots a CPU owns - capacity.pcpu's reservation caches, a cache of a
+//!   freed object: changed by their own CPU, by a read-modify-write or an
+//!   xchg or cmpxchg, and at most reset by another. A slot is a Volatile:
+//!   every access a relaxed atomic, so another CPU's reset is a store like
+//!   any other - each_cpu() reaches every CPU's - and one racing this CPU's
+//!   read-modify-write may be lost, which is what a slot is for.
+//!
+//! The types:
+//!
+//! - PerCpu<T> is the field. alloc() - or C - allocates it at init, and
+//!   free() frees it at exit; between, it's live for every possible CPU,
+//!   which every operation takes as given, as C's do. Not Copy: nothing holds
+//!   it past its struct.
+//! - PerCpuRef<'a, T> borrows it, or a part of it - at(i), percpu_field!() -
+//!   as every CPU's copy: sum() over all of them; read(), add(), set(),
+//!   xchg() and cmpxchg() on this CPU's, each one operation.
+//! - CpuCopy<'a, T> is one CPU's, from cpus(), read volatile: to sum part of
+//!   a T - percpu_field!() of each - in one sweep over the CPUs, where a sum
+//!   of each part would be a sweep apiece and sum() reads all of T.
+//! - ThisCpu<'g, T> is this CPU's copy, while a CpuGuard - preemption off -
+//!   keeps it this CPU: a place, as util/projections.rs's are, or add() of a
+//!   delta to a struct of counters; a slot's, its Volatile.
+//!
+//! What's atomic is C's contract and no more: a this_cpu operation is whole
+//! against this CPU - its interrupts and preemption - not against another CPU
+//! writing the same copy. arm64's happen to be, x86's aren't, so nothing may
+//! lean on it. ThisCpu's read-modify-write is a load and a store, as C's
+//! under preempt_disable() are: an interrupt adding to the same copy between
+//! them is lost, so a counter interrupts add to goes through PerCpuRef::add().
+//! Another CPU's copy is only read volatile, never through a reference: it
+//! may be being written.
+//!
+//! A per-CPU pointer isn't an address - on x86 it's an offset from %gs - so
+//! nothing projects through one: a field's offset is taken in a T on the
+//! stack, and a CPU's copy is found by its CPU's offset.
+//!
+//! On x86_64 and arm64 the operations are inline, as C's are, their asm the
+//! kernel's own: from the headers of the kernel built against
+//! (percpu_asm.rs.S, preprocessed by Makefile.rust), so what that kernel
+//! patches at boot - arm64's tpidr_el1 or tpidr_el2, its LL/SC or LSE - is
+//! that kernel's, never a copy falling behind it.
+//!
+//! - x86_64: one %gs-relative instruction - mov, add, cmpxchg, and xchg as
+//!   C's cmpxchg loop - none LOCKed.
+//! - arm64: this CPU's offset from tpidr, then a load, the kernel's add,
+//!   LSE's ldadd or LL/SC, or util/atomic.rs's swp or cas for xchg and
+//!   cmpxchg. The add leaves preemption on, where C's disables it: a task
+//!   moved between reading the offset and adding adds, atomically, to the
+//!   CPU it left - right for a counter, which is only ever summed. The load
+//!   likewise reads the CPU it left. xchg and cmpxchg disable it, as C's do.
+//! - Elsewhere, and in userspace - whose per-CPU areas are per thread, found
+//!   through a C thread-local - C's, out of line.
+//!
+//! C's everywhere, out of line: per_cpu_ptr() and the possible CPUs, for the
+//! sums; preempt_disable() and _enable(), for CpuGuard; this_cpu_ptr() but on
+//! arm64. Around a ThisCpu on x86 that's three calls where C makes none - a
+//! cost for a slowpath, not yet for anything hotter.
+
+use core::ffi::{c_int, c_uint, c_void};
+use core::marker::PhantomData;
+use core::mem::{align_of, size_of, MaybeUninit};
+use cstruct_macros::c_extern;
+
+use crate::c;
+use crate::util::alloc::AllocError;
+use crate::util::projections::{AtomicWord, FakePlaceRef, FakePlaceWrite, FakePlaceRead, Volatile};
+
+c_extern! {
+    pub fn bch2_this_cpu_add_u64(pcp: *mut u64, val: u64);
+    pub fn bch2_this_cpu_xchg_u64(pcp: *mut u64, val: u64) -> u64;
+    pub fn bch2_this_cpu_cmpxchg_u64(pcp: *mut u64, old: u64, new: u64) -> u64;
+    pub fn bch2_this_cpu_ptr(pcp: *mut c_void) -> *mut c_void;
+    pub fn bch2_per_cpu_ptr(pcp: *mut c_void, cpu: c_uint) -> *mut c_void;
+    pub fn bch2_cpu_possible_next(cpu: c_int) -> c_int;
+    pub fn bch2_preempt_disable();
+    pub fn bch2_preempt_enable();
+}
+
+// ── The operations, an arch's own ────────────────────────────────────────
+//
+// Safety, for each: @pcp is a per-CPU u64 - a T, for this_cpu_ptr() -
+// allocated for every possible CPU and live.
+
+#[cfg(all(kernel, target_arch = "x86_64"))]
+mod arch {
+    use super::{bch2_this_cpu_ptr, CpuGuard};
+
+    include!(concat!(env!("OUT_DIR"), "/percpu_asm.rs"));
+
+    #[inline(always)]
+    pub(super) unsafe fn this_cpu_read(pcp: *mut u64) -> u64 {
+        let val: u64;
+        unsafe {
+            core::arch::asm!(this_cpu_read_asm!(), ptr = in(reg) pcp, val = out(reg) val,
+                             options(att_syntax, nostack, readonly, preserves_flags));
+        }
+        val
+    }
+
+    #[inline(always)]
+    pub(super) unsafe fn this_cpu_add(pcp: *mut u64, val: u64) {
+        unsafe {
+            core::arch::asm!(this_cpu_add_asm!(), ptr = in(reg) pcp, val = in(reg) val,
+                             options(att_syntax, nostack));
+        }
+    }
+
+    #[inline(always)]
+    pub(super) unsafe fn this_cpu_ptr<T>(pcp: *mut T, _g: &CpuGuard) -> *mut T {
+        unsafe { bch2_this_cpu_ptr(pcp.cast()).cast() }
+    }
+
+    #[inline(always)]
+    pub(super) unsafe fn this_cpu_xchg(pcp: *mut u64, val: u64) -> u64 {
+        let old: u64;
+        unsafe {
+            core::arch::asm!(this_cpu_xchg_asm!(), ptr = in(reg) pcp, new = in(reg) val,
+                             out("rax") old, options(att_syntax, nostack));
+        }
+        old
+    }
+
+    #[inline(always)]
+    pub(super) unsafe fn this_cpu_cmpxchg(pcp: *mut u64, old: u64, new: u64) -> u64 {
+        let prev: u64;
+        unsafe {
+            core::arch::asm!(this_cpu_cmpxchg_asm!(), ptr = in(reg) pcp, new = in(reg) new,
+                             inout("rax") old => prev, options(att_syntax, nostack));
+        }
+        prev
+    }
+}
+
+#[cfg(all(kernel, target_arch = "aarch64"))]
+mod arch {
+    use super::CpuGuard;
+    use core::sync::atomic::{AtomicU64, Ordering};
+
+    include!(concat!(env!("OUT_DIR"), "/percpu_asm.rs"));
+
+    /// This CPU's copy of @pcp - while the task stays on it.
+    #[inline(always)]
+    fn my_cpu<T>(pcp: *mut T) -> *mut T {
+        let off: usize;
+        // SAFETY: reads tpidr, as the kernel patched it
+        unsafe {
+            core::arch::asm!(my_cpu_offset_asm!(), off = out(reg) off,
+                             options(nomem, nostack, preserves_flags));
+        }
+        pcp.wrapping_byte_add(off)
+    }
+
+    #[inline(always)]
+    pub(super) unsafe fn this_cpu_read(pcp: *mut u64) -> u64 {
+        unsafe { AtomicU64::from_ptr(my_cpu(pcp)) }.load(Ordering::Relaxed)
+    }
+
+    #[inline(always)]
+    pub(super) unsafe fn this_cpu_add(pcp: *mut u64, val: u64) {
+        unsafe {
+            core::arch::asm!(this_cpu_add_asm!(), ptr = in(reg) my_cpu(pcp), val = in(reg) val,
+                             tmp = out(reg) _, retry = out(reg) _, options(nostack));
+        }
+    }
+
+    #[inline(always)]
+    pub(super) unsafe fn this_cpu_ptr<T>(pcp: *mut T, _g: &CpuGuard) -> *mut T {
+        my_cpu(pcp)
+    }
+
+    #[inline(always)]
+    pub(super) unsafe fn this_cpu_xchg(pcp: *mut u64, val: u64) -> u64 {
+        let g = CpuGuard::new();
+        unsafe { AtomicU64::from_ptr(this_cpu_ptr(pcp, &g)) }.swap(val, Ordering::Relaxed)
+    }
+
+    #[inline(always)]
+    pub(super) unsafe fn this_cpu_cmpxchg(pcp: *mut u64, old: u64, new: u64) -> u64 {
+        let g = CpuGuard::new();
+        match unsafe { AtomicU64::from_ptr(this_cpu_ptr(pcp, &g)) }
+            .compare_exchange(old, new, Ordering::Relaxed, Ordering::Relaxed) {
+            Ok(v) | Err(v) => v,
+        }
+    }
+}
+
+#[cfg(not(all(kernel, any(target_arch = "x86_64", target_arch = "aarch64"))))]
+mod arch {
+    use super::{bch2_this_cpu_add_u64, bch2_this_cpu_cmpxchg_u64, bch2_this_cpu_ptr,
+                bch2_this_cpu_xchg_u64, CpuGuard};
+
+    pub(super) unsafe fn this_cpu_read(pcp: *mut u64) -> u64 {
+        unsafe { core::ptr::read_volatile(bch2_this_cpu_ptr(pcp.cast()).cast::<u64>()) }
+    }
+
+    pub(super) unsafe fn this_cpu_add(pcp: *mut u64, val: u64) {
+        unsafe { bch2_this_cpu_add_u64(pcp, val) }
+    }
+
+    pub(super) unsafe fn this_cpu_ptr<T>(pcp: *mut T, _g: &CpuGuard) -> *mut T {
+        unsafe { bch2_this_cpu_ptr(pcp.cast()).cast() }
+    }
+
+    pub(super) unsafe fn this_cpu_xchg(pcp: *mut u64, val: u64) -> u64 {
+        unsafe { bch2_this_cpu_xchg_u64(pcp, val) }
+    }
+
+    pub(super) unsafe fn this_cpu_cmpxchg(pcp: *mut u64, old: u64, new: u64) -> u64 {
+        unsafe { bch2_this_cpu_cmpxchg_u64(pcp, old, new) }
+    }
+}
+
+use arch::{this_cpu_add, this_cpu_cmpxchg, this_cpu_ptr, this_cpu_read, this_cpu_xchg};
+
+/// Preemption off while it lives. Not Send or Sync: it's this CPU's.
+pub struct CpuGuard(PhantomData<*const ()>);
+
+impl CpuGuard {
+    #[allow(clippy::new_without_default)]
+    pub fn new() -> Self {
+        unsafe { bch2_preempt_disable() };
+        CpuGuard(PhantomData)
+    }
+}
+
+impl Drop for CpuGuard {
+    fn drop(&mut self) {
+        unsafe { bch2_preempt_enable() };
+    }
+}
+
+fn possible_cpus() -> impl Iterator<Item = c_uint> {
+    let mut cpu: c_int = -1;
+    core::iter::from_fn(move || {
+        cpu = unsafe { bch2_cpu_possible_next(cpu) };
+        (cpu >= 0).then_some(cpu as c_uint)
+    })
+}
+
+// ── PerCpu, and its copies ───────────────────────────────────────────────
+
+/// C's `T __percpu *`: see the top of the file.
+#[repr(transparent)]
+pub struct PerCpu<T>(*mut T);
+
+// Null: not yet allocated, as C's init finds it.
+unsafe impl<T> ::pin_init::Zeroable for PerCpu<T> {}
+
+/// A PerCpu, or a part of one, for as long as it's borrowed.
+pub struct PerCpuRef<'a, T>(*mut T, PhantomData<&'a PerCpu<T>>);
+
+impl<T> Clone for PerCpuRef<'_, T> {
+    fn clone(&self) -> Self {
+        *self
+    }
+}
+
+impl<T> Copy for PerCpuRef<'_, T> {}
+
+impl<T: ::pin_init::Zeroable> PerCpu<T> {
+    /// Every possible CPU's copy, zeroed: alloc_percpu().
+    pub fn alloc() -> Result<Self, AllocError> {
+        // In the kernel, __alloc_percpu() is a macro - alloc_hooks() over
+        // pcpu_alloc_noprof() - which kernel Rust calls directly, as its
+        // allocator does krealloc_noprof()
+        #[cfg(kernel)]
+        let p = unsafe { c::pcpu_alloc_noprof(size_of::<T>(), align_of::<T>(), false, c::GFP_KERNEL) };
+        #[cfg(not(kernel))]
+        let p = unsafe { c::__alloc_percpu(size_of::<T>(), align_of::<T>()) };
+        if p.is_null() { Err(AllocError) } else { Ok(PerCpu(p.cast())) }
+    }
+
+    /// alloc(), as a field's initializer.
+    pub fn init() -> impl ::pin_init::Init<Self, AllocError> {
+        // SAFETY: the slot written, or nothing done
+        unsafe {
+            ::pin_init::init_from_closure(|slot: *mut Self| {
+                slot.write(Self::alloc()?);
+                Ok(())
+            })
+        }
+    }
+}
+
+impl<T> PerCpu<T> {
+    /// Whether it's been allocated - and not freed.
+    pub fn allocated(&self) -> bool {
+        !self.0.is_null()
+    }
+
+    /// free_percpu(): unallocated after, as before alloc().
+    pub fn free(&mut self) {
+        unsafe { c::free_percpu(self.0.cast()) };
+        self.0 = core::ptr::null_mut();
+    }
+
+    pub fn get(&self) -> PerCpuRef<'_, T> {
+        PerCpuRef(self.0, PhantomData)
+    }
+
+    pub fn this_cpu<'g>(&'g self, g: &'g CpuGuard) -> ThisCpu<'g, T> {
+        self.get().this_cpu(g)
+    }
+}
+
+impl<T, const N: usize> PerCpu<[T; N]> {
+    pub fn at(&self, i: usize) -> PerCpuRef<'_, T> {
+        self.get().at(i)
+    }
+}
+
+/// How far into a @T the field @f projects to is: in a T on the stack, never
+/// read.
+fn field_offset<T, U>(f: impl FnOnce(*const T) -> *const U) -> usize {
+    let t = MaybeUninit::<T>::uninit();
+    f(t.as_ptr()) as usize - t.as_ptr() as usize
+}
+
+/// A field of a PerCpuRef or ThisCpu: percpu_field!(c.capacity.pcpu.get(),
+/// online_reserved[slot]).
+#[macro_export]
+macro_rules! percpu_field {
+    ($p:expr, $($f:tt)+) => {{
+        let p = $p;
+        // SAFETY: a field of *t, projected without reading it
+        unsafe { p.field(|t| ::core::ptr::addr_of!((*t).$($f)+)) }
+    }};
+}
+
+impl<'a, T> PerCpuRef<'a, T> {
+    /// A C `T __percpu *` that isn't a PerCpu: a table's entry's counters.
+    ///
+    /// # Safety
+    /// @p is a percpu allocation of a @T, live for 'a.
+    pub unsafe fn from_raw(p: *mut T) -> Self {
+        PerCpuRef(p, PhantomData)
+    }
+
+    /// percpu_field!()'s.
+    ///
+    /// # Safety
+    /// @f only projects @t to a field of it, reading nothing.
+    pub unsafe fn field<U>(self, f: impl FnOnce(*const T) -> *const U) -> PerCpuRef<'a, U> {
+        PerCpuRef(self.0.wrapping_byte_add(field_offset(f)).cast(), PhantomData)
+    }
+
+    /// Each possible CPU's copy.
+    #[inline]
+    pub fn cpus(self) -> impl Iterator<Item = CpuCopy<'a, T>> {
+        possible_cpus().map(move |cpu| CpuCopy(unsafe { bch2_per_cpu_ptr(self.0.cast(), cpu) }.cast(), PhantomData))
+    }
+
+    pub fn this_cpu<'g>(self, g: &'g CpuGuard) -> ThisCpu<'g, T>
+        where 'a: 'g
+    {
+        ThisCpu(unsafe { this_cpu_ptr(self.0, g) }, PhantomData)
+    }
+}
+
+impl<'a, T, const N: usize> PerCpuRef<'a, [T; N]> {
+    pub fn at(self, i: usize) -> PerCpuRef<'a, T> {
+        assert!(i < N);
+        PerCpuRef(self.0.cast::<T>().wrapping_add(i), PhantomData)
+    }
+}
+
+impl<T: Counters> PerCpu<T> {
+    pub fn sum(&self) -> T {
+        self.get().sum()
+    }
+
+    pub fn sum_nonnegative(&self) -> T {
+        self.get().sum_nonnegative()
+    }
+}
+
+impl<T: Counters> PerCpuRef<'_, T> {
+    /// Exact only with the adders excluded.
+    pub fn sum(&self) -> T {
+        let mut cpus = self.cpus().map(|c| c.get());
+        let first = cpus.next().expect("CPU 0 is always possible");
+        cpus.fold(first, T::wrapping_add)
+    }
+
+    /// For a read that races the adds.
+    pub fn sum_nonnegative(&self) -> T {
+        self.sum().clamp_nonnegative()
+    }
+}
+
+impl PerCpuRef<'_, u64> {
+    /// This CPU's, or the one the task was just on: for a cmpxchg() to start
+    /// from, which fails unless it's this CPU's value now.
+    #[inline(always)]
+    pub fn read(&self) -> u64 {
+        unsafe { this_cpu_read(self.0) }
+    }
+
+    #[inline(always)]
+    pub fn add(&self, v: u64) {
+        unsafe { this_cpu_add(self.0, v) }
+    }
+
+    /// This CPU's to @v, every other's to 0.
+    ///
+    /// # Safety
+    /// An add racing it may or may not count. Whether that's sound is up to
+    /// what the variable is for - or there are no adders yet.
+    pub unsafe fn set(&self, v: u64) {
+        for cpu in possible_cpus() {
+            // SAFETY: a live CPU's copy; another CPU's, written as read
+            unsafe { core::ptr::write_volatile(bch2_per_cpu_ptr(self.0.cast(), cpu).cast::<u64>(), 0) };
+        }
+        self.xchg(v);
+    }
+
+    #[inline(always)]
+    pub fn xchg(&self, v: u64) -> u64 {
+        unsafe { this_cpu_xchg(self.0, v) }
+    }
+
+    /// Err(what it was), if it wasn't @old.
+    #[inline(always)]
+    pub fn cmpxchg(&self, old: u64, new: u64) -> Result<u64, u64> {
+        match unsafe { this_cpu_cmpxchg(self.0, old, new) } {
+            v if v == old => Ok(v),
+            v             => Err(v),
+        }
+    }
+}
+
+impl<'a, T: AtomicWord, const N: usize> PerCpuRef<'a, [Volatile<T>; N]> {
+    /// Each possible CPU's slots: Volatiles, anyone's to load and store.
+    pub fn each_cpu(self) -> impl Iterator<Item = &'a [Volatile<T>; N]> {
+        // SAFETY: a live CPU's copy, for 'a; a Volatile's every access is
+        // atomic, so a shared reference races nothing
+        possible_cpus().map(move |cpu| unsafe { &*bch2_per_cpu_ptr(self.0.cast(), cpu).cast::<[Volatile<T>; N]>() })
+    }
+}
+
+impl<'a> PerCpuRef<'a, Volatile<u64>> {
+    /// The slot as a word: its read() and cmpxchg(), this CPU's.
+    pub fn word(self) -> PerCpuRef<'a, u64> {
+        // Volatile<u64> is laid out as a u64 (repr(transparent))
+        PerCpuRef(self.0.cast(), PhantomData)
+    }
+}
+
+/// One CPU's copy, from PerCpuRef::cpus(): see the top of the file.
+pub struct CpuCopy<'a, T>(*const T, PhantomData<&'a PerCpu<T>>);
+
+impl<T> Clone for CpuCopy<'_, T> {
+    fn clone(&self) -> Self {
+        *self
+    }
+}
+
+impl<T> Copy for CpuCopy<'_, T> {}
+
+impl<'a, T> CpuCopy<'a, T> {
+    /// percpu_field!()'s.
+    ///
+    /// # Safety
+    /// @f only projects @t to a field of it, reading nothing.
+    #[inline]
+    pub unsafe fn field<U>(self, f: impl FnOnce(*const T) -> *const U) -> CpuCopy<'a, U> {
+        CpuCopy(self.0.wrapping_byte_add(field_offset(f)).cast(), PhantomData)
+    }
+}
+
+impl<T: Copy> CpuCopy<'_, T> {
+    #[inline]
+    pub fn get(&self) -> T {
+        // SAFETY: a live CPU's copy, written as it's read
+        unsafe { core::ptr::read_volatile(self.0) }
+    }
+}
+
+/// This CPU's copy, as a place: see the top of the file.
+pub struct ThisCpu<'g, T>(*mut T, PhantomData<&'g CpuGuard>);
+
+impl<T> Clone for ThisCpu<'_, T> {
+    fn clone(&self) -> Self {
+        *self
+    }
+}
+
+impl<T> Copy for ThisCpu<'_, T> {}
+
+impl<'g, T> ThisCpu<'g, T> {
+    /// percpu_field!()'s.
+    ///
+    /// # Safety
+    /// @f only projects @t to a field of it, reading nothing.
+    pub unsafe fn field<U>(self, f: impl FnOnce(*const T) -> *const U) -> ThisCpu<'g, U> {
+        ThisCpu(self.0.wrapping_byte_add(field_offset(f)).cast(), PhantomData)
+    }
+}
+
+impl<'g, T: AtomicWord> core::ops::Deref for ThisCpu<'g, Volatile<T>> {
+    type Target = Volatile<T>;
+
+    fn deref(&self) -> &Volatile<T> {
+        // SAFETY: this CPU's copy, live while the guard is; a Volatile's
+        // every access is atomic
+        unsafe { &*self.0 }
+    }
+}
+
+impl<'g, T, const N: usize> ThisCpu<'g, [T; N]> {
+    pub fn at(self, i: usize) -> ThisCpu<'g, T> {
+        assert!(i < N);
+        ThisCpu(self.0.cast::<T>().wrapping_add(i), PhantomData)
+    }
+}
+
+impl<T: Copy> ThisCpu<'_, T> {
+    pub fn get(&self) -> T {
+        unsafe { core::ptr::read_volatile(self.0) }
+    }
+
+    pub fn set(&self, v: T) {
+        unsafe { core::ptr::write_volatile(self.0, v) }
+    }
+
+    /// As a place, to read-modify-write: `*x.place() += 1`.
+    pub fn place(&self) -> FakePlaceRef<'_, Self> {
+        FakePlaceWrite::place(self)
+    }
+}
+
+impl<T: Counters> ThisCpu<'_, T> {
+    /// Not atomic as a whole: a load and a store of the struct.
+    pub fn add(&self, delta: T) {
+        self.set(self.get().wrapping_add(delta))
+    }
+}
+
+impl<T: Copy> FakePlaceRead for ThisCpu<'_, T> {
+    type Value = T;
+
+    fn get(&self) -> T {
+        ThisCpu::get(self)
+    }
+}
+
+impl<T: Copy> FakePlaceWrite for ThisCpu<'_, T> {
+    fn set(&self, v: T) {
+        ThisCpu::set(self, v)
+    }
+}
+
+// ── Counters ─────────────────────────────────────────────────────────────
+
+/// How a counter, or a struct or array of them, sums: see the top of the
+/// file. A struct gets it with #[fieldwise(Counters::wrapping_add(rhs),
+/// Counters::clamp_nonnegative)].
+pub trait Counters: Copy {
+    fn wrapping_add(self, rhs: Self) -> Self;
+    fn clamp_nonnegative(self) -> Self;
+}
+
+impl Counters for u64 {
+    #[inline]
+    fn wrapping_add(self, rhs: u64) -> u64 {
+        u64::wrapping_add(self, rhs)
+    }
+
+    #[inline]
+    fn clamp_nonnegative(self) -> u64 {
+        (self as i64).max(0) as u64
+    }
+}
+
+impl<T: Counters, const N: usize> Counters for [T; N] {
+    #[inline]
+    fn wrapping_add(self, rhs: Self) -> Self {
+        core::array::from_fn(|i| self[i].wrapping_add(rhs[i]))
+    }
+
+    #[inline]
+    fn clamp_nonnegative(self) -> Self {
+        self.map(Counters::clamp_nonnegative)
+    }
+}
diff --git a/fs/bcachefs/util/percpu_asm.rs.S b/fs/bcachefs/util/percpu_asm.rs.S
new file mode 100644
index 0000000..4ecca92
--- /dev/null
+++ b/fs/bcachefs/util/percpu_asm.rs.S
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * util/percpu.rs's asm, from the headers of the kernel the module is built
+ * against - what the kernel patches at boot, arm64's alternatives and their
+ * cpucap numbers, is as that kernel has it. Run through the C preprocessor
+ * with the C build's flags; what follows the cut is Rust, so it can't hold
+ * an apostrophe or a line starting with a hash.
+ */
+
+#include <linux/percpu.h>
+#ifdef CONFIG_ARM64
+#include <asm/alternative-macros.h>
+#include <asm/lse.h>
+#endif
+
+// Cut here.
+
+#if defined(CONFIG_X86_64) && defined(CONFIG_SMP)
+
+macro_rules! this_cpu_read_asm {
+    () => { concat_literals!("movq %" __stringify(__percpu_seg) ":({ptr}), {val}") };
+}
+
+macro_rules! this_cpu_add_asm {
+    () => { concat_literals!("addq {val}, %" __stringify(__percpu_seg) ":({ptr})") };
+}
+
+macro_rules! this_cpu_cmpxchg_asm {
+    () => { concat_literals!("cmpxchgq {new}, %" __stringify(__percpu_seg) ":({ptr})") };
+}
+
+macro_rules! this_cpu_xchg_asm {
+    () => { concat_literals!("movq %" __stringify(__percpu_seg) ":({ptr}), %rax\n"
+                             "2:\tcmpxchgq {new}, %" __stringify(__percpu_seg) ":({ptr})\n"
+                             "\tjnz 2b") };
+}
+
+#elif defined(CONFIG_X86_64)
+
+macro_rules! this_cpu_read_asm {
+    () => { concat_literals!("movq ({ptr}), {val}") };
+}
+
+macro_rules! this_cpu_add_asm {
+    () => { concat_literals!("addq {val}, ({ptr})") };
+}
+
+macro_rules! this_cpu_cmpxchg_asm {
+    () => { concat_literals!("cmpxchgq {new}, ({ptr})") };
+}
+
+macro_rules! this_cpu_xchg_asm {
+    () => { concat_literals!("movq ({ptr}), %rax\n"
+                             "2:\tcmpxchgq {new}, ({ptr})\n"
+                             "\tjnz 2b") };
+}
+
+#elif defined(CONFIG_ARM64)
+
+macro_rules! my_cpu_offset_asm {
+    () => { concat_literals!(ALTERNATIVE("mrs {off}, tpidr_el1",
+                                         "mrs {off}, tpidr_el2",
+                                         ARM64_HAS_VIRT_HOST_EXTN)) };
+}
+
+macro_rules! this_cpu_add_asm {
+    () => { concat_literals!(ARM64_LSE_ATOMIC_INSN(
+        "1:\tldxr\t{tmp}, [{ptr}]\n"
+        "\tadd\t{tmp}, {tmp}, {val}\n"
+        "\tstxr\t{retry:w}, {tmp}, [{ptr}]\n"
+        "\tcbnz\t{retry:w}, 1b",
+        "ldadd\t{val}, {tmp}, [{ptr}]\n"
+        __nops(3))) };
+}
+
+#endif
diff --git a/fs/bcachefs/util/place.rs b/fs/bcachefs/util/place.rs
new file mode 100644
index 0000000..a89c185
--- /dev/null
+++ b/fs/bcachefs/util/place.rs
@@ -0,0 +1,665 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A value's place: the field of a parent it lives at - and container_of()
+//! from it, safe because the type system knows the value is there.
+//!
+//! container_of() needs two things true: the value is a P's field - its
+//! location - and the P is valid while it's used. This is the first: a type
+//! that's Placed is, every value of it, its parent's field N, so its
+//! container() is a safe call. The parent's validity is the parent's own:
+//! a &child borrowed from it is had only while it is.
+//!
+//! #[placed(Fs.snapshots)] on the type is all that's written, on it or its
+//! parent - cstruct-macros' place.rs is what it makes:
+//!
+//! - Field<N> is a struct's field N, a hash of its name - name("snapshots")
+//!   - with its type and offset: a field as a type, which the language doesn't
+//!   have yet. It's field representing types' Field (field_of!(), nightly),
+//!   faked as util/projections.rs's fakes are, to go when they arrive.
+//!   #[derive(Init)] makes one for each field of the structs it's on.
+//!
+//! - At<B, N> is the proof: a field the placed type holds, zero bytes, that
+//!   only at() makes. Nothing else can - its fields are private, and it's
+//!   not Clone, Default or Zeroable - so neither a literal nor a zeroed value
+//!   nor a pin_init!() of the type can be had anywhere: a value of it is one
+//!   at() made.
+//!
+//! - at() makes it, called only by InitAt<N>'s init(): B's initializer for
+//!   field N, which #[placed] implements on B and B's #[derive(Init)] picks
+//!   for that field - Pick. So the At a field's value is given is its own
+//!   field's: an At is made only in the line that puts it in place. (A
+//!   PinInit can be run anywhere: that's why it can't be a value anyone
+//!   holds, and InitAt::init() is unsafe.)
+//!
+//! - AtIndex<B, N, I> is an array element's: #[placed(B.field[], index =
+//!   name: I)] - its index, which C sees as the field it replaces, as C named
+//!   it, and at_index() writes for each element as the array's InitAt makes
+//!   them. Its container() is the array's offset, plus that many elements.
+//!
+//! - Placed is the child's side - its Parent, and its At, which ties the two
+//!   - and container() the field's address back to its parent's.
+//!
+//! What keeps a placed value at its place is that no value of it can be had
+//! anywhere else - not Pin. A swap of two, through &muts, is harmless: each
+//! is still some parent's field N, and nothing else can be swapped in -
+//! but not two array elements, each holding its index; and that takes a
+//! &mut to the array, the parent's discipline again. The way out is the
+//! parent's: had by value, it can be taken apart - let P {
+//! child, .. } = p - leaving the child nowhere. Fs never is: it lives in its
+//! pinned allocation, a &Fs to everyone. At is !Unpin all the same, for what
+//! needs its address to stay put - C's &c->snapshots.
+//!
+//! container() widens a reference to the child to one to its parent. Under
+//! Tree Borrows that's allowed, the parent's bytes outside the child getting
+//! the permission the child's type implies: read-only, from a type with no
+//! interior mutability - writing an atomic of the parent's through the &P
+//! would be UB - and as a shared reference's, from one with some. So At
+//! holds an UnsafeCell, and every placed type has interior mutability.
+//!
+//! Known gaps, to come back to:
+//!
+//! - The parent's own discipline. A &mut P lets a &p.child and writes to p's
+//!   other fields coexist - split borrows, the paths disjoint - and the &P
+//!   container() makes of the child would see those fields change under it:
+//!   UB. The borrow checker could see that a &child's container() borrows
+//!   all of P, and doesn't know to. And a P had by value can be taken apart,
+//!   as above. So container() is sound only for a parent never had by &mut
+//!   or by value: Fs. Unchecked.
+//!
+//! - Drop. Fields drop in order, so a placed type's own drop would find its
+//!   parent's earlier fields dropped, its container() a &P to them. So it
+//!   has none: #[placed] refuses #[pin_data(PinnedDrop)], pin_data()'s
+//!   check refuses a Drop, and a struct without #[pin_data] gets an empty
+//!   Drop for one to conflict with. A placed type that needs teardown has
+//!   nowhere to put it yet: when one does, its hook must be had without
+//!   container().
+//!
+//! An element of a container - #[placed(Base.field[..])] - has a place too,
+//! but no address in it: it's in the Container at Base's field, wherever
+//! the container keeps it. There's no container() for one; what its place
+//! is for is the guarantee that it never outlives its Base. A Container is
+//! made only at its field - its InitAt, by container() - and its insert()
+//! is the only thing that makes an AtIn, so a T is had only from the
+//! container's insert(); Holds, the container proper's promise, keeps it
+//! there - made in place, dropped in place, never had by value - until the
+//! container drops it, with itself. An element may have a Drop of its own:
+//! its container's whole while it runs.
+//!
+//! An AtIn is given to the element's initializer, and only to that: what
+//! insert() takes is a PlacedInit - sealed, its one implementation made by
+//! placed_init!(), which is written as pin_init!() is and puts the AtIn in
+//! _placed_at, under a name its fields can't name. So the code that wrote
+//! an initializer never has the AtIn - to keep, and make a T somewhere else
+//! with.
+//!
+//! A type lives at one place. One that lives at several, as a kobject or a
+//! work_struct does, is given one by a type parameter: ReffedWork<F, R> is
+//! the work_struct of work function F, whose WorkFunc - from the parent's
+//! #[derive(Init)], for the one field of that type - gives it its At, Placed
+//! as any field's type is (util/workqueue.rs).
+
+use crate::errcode::BchError;
+use crate::util::alloc::{flags::GFP_KERNEL, kbox_pin_init, AllocError, KBox, KVVec};
+use core::cell::UnsafeCell;
+use core::marker::{PhantomData, PhantomPinned};
+use core::mem::size_of;
+use core::pin::Pin;
+use pin_init::{Init, PinInit, Zeroable};
+
+/// A field's name, as Field<N>'s N: its FNV-1a hash.
+pub const fn name(s: &str) -> u64 {
+    let b = s.as_bytes();
+    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+    let mut i = 0;
+    while i < b.len() {
+        h ^= b[i] as u64;
+        h = h.wrapping_mul(0x0000_0100_0000_01b3);
+        i += 1;
+    }
+    h
+}
+
+
+/// Self's field N: its type, and where it is.
+///
+/// # Safety
+/// Self has a field of type Type at OFFSET, named N.
+pub(crate) unsafe trait Field<const N: u64> {
+    type Type;
+    const OFFSET: usize;
+}
+
+/// Proof that what holds it was made at B's field N - by at(), which alone
+/// makes one. Zero bytes, as C's char[0] for it: FFI-safe, as CacheAligned
+/// is, for the C structs that hold one. The UnsafeCell, of no bytes, is so
+/// container() widens to a usable &P - see the file comment.
+#[repr(C)]
+pub(crate) struct At<B, const N: u64> {
+    _c:   UnsafeCell<[u8; 0]>,
+    _b:   PhantomData<fn() -> B>,
+    /// !Unpin - a PhantomData of it, which improper_ctypes skips, as it
+    /// doesn't a PhantomPinned field
+    _pin: PhantomData<PhantomPinned>,
+}
+
+// SAFETY: no bytes, for threads to race on
+unsafe impl<B, const N: u64> Sync for At<B, N> {}
+
+mod sealed {
+    pub(crate) trait Sealed {}
+}
+
+/// What an At says: B's field N - the type there, and where in B the value
+/// holding the At is.
+pub(crate) trait Place: sealed::Sealed {
+    type Base;
+    type Type;
+    fn offset(&self) -> usize;
+}
+
+impl<B, const N: u64> sealed::Sealed for At<B, N> {}
+
+impl<B: Field<N>, const N: u64> Place for At<B, N> {
+    type Base = B;
+    type Type = B::Type;
+    fn offset(&self) -> usize {
+        B::OFFSET
+    }
+}
+
+/// An index, as an array's element holds its own: C's integer for it.
+pub(crate) trait Index: Copy {
+    fn from_usize(i: usize) -> Self;
+    fn to_usize(self) -> usize;
+}
+
+macro_rules! index {
+    ($($t:ty),*) => {$(
+        impl Index for $t {
+            fn from_usize(i: usize) -> Self {
+                Self::try_from(i).expect("an array index past its integer")
+            }
+            fn to_usize(self) -> usize {
+                self as usize
+            }
+        }
+    )*};
+}
+index!(u8, u16, u32, u64, usize);
+
+/// An array, by its element type.
+pub(crate) trait Array {
+    type Elem;
+}
+
+impl<T, const L: usize> Array for [T; L] {
+    type Elem = T;
+}
+
+/// Proof that what holds it was made as element @index of B's array field N
+/// - by at_index(), which alone makes one. The index itself to C: the field
+/// it's in is the element's own index, as C named it.
+#[repr(transparent)]
+pub(crate) struct AtIndex<B, const N: u64, I> {
+    index: I,
+    _c:    UnsafeCell<[u8; 0]>,
+    _b:    PhantomData<fn() -> B>,
+    _pin:  PhantomData<PhantomPinned>,
+}
+
+// SAFETY: its index is never written after at_index() made it
+unsafe impl<B, const N: u64, I: Sync> Sync for AtIndex<B, N, I> {}
+
+impl<B, const N: u64, I: Index> AtIndex<B, N, I> {
+    /// Which element it is, as C's integer for it.
+    pub(crate) fn get(&self) -> I {
+        self.index
+    }
+}
+
+impl<B, const N: u64, I> sealed::Sealed for AtIndex<B, N, I> {}
+
+impl<B: Field<N>, const N: u64, I: Index> Place for AtIndex<B, N, I>
+where
+    B::Type: Array,
+{
+    type Base = B;
+    type Type = <B::Type as Array>::Elem;
+    fn offset(&self) -> usize {
+        B::OFFSET + self.index.to_usize() * size_of::<Self::Type>()
+    }
+}
+
+/// The At for B's field N, given to @init - the field's type's initializer -
+/// for the initializer it returns. Only #[placed]'s InitAt calls it.
+///
+/// # Safety
+/// What it returns is run into B's field N, of a B being initialized.
+#[doc(hidden)]
+pub(crate) unsafe fn at<B: Field<N>, const N: u64, I, E>(init: impl FnOnce(At<B, N>) -> I) -> I
+where
+    I: PinInit<B::Type, E>,
+{
+    init(At { _c: UnsafeCell::new([]), _b: PhantomData, _pin: PhantomData })
+}
+
+/// The AtIndex for element @i of B's array field N, given to @init - the
+/// element type's initializer - for the initializer it returns. Only
+/// #[placed]'s InitAt calls it, for each element.
+///
+/// # Safety
+/// What it returns is run into element @i of B's field N, of a B being
+/// initialized.
+#[doc(hidden)]
+pub(crate) unsafe fn at_index<B: Field<N>, const N: u64, X: Index, I, E>(
+    i:    usize,
+    init: impl FnOnce(AtIndex<B, N, X>) -> I,
+) -> I
+where
+    B::Type: Array,
+    I: PinInit<<B::Type as Array>::Elem, E>,
+{
+    init(AtIndex { index: X::from_usize(i), _c: UnsafeCell::new([]), _b: PhantomData, _pin: PhantomData })
+}
+
+/// B's field N's initializer, where a placed type lives there: #[placed]
+/// on the type implements it, its At from at(), for B's #[derive(Init)] to
+/// pick for the field.
+///
+/// # Safety
+/// init() gives its field an At: what it returns is run into B's field N.
+#[doc(hidden)]
+pub(crate) unsafe trait InitAt<const N: u64>: Field<N> {
+    /// # Safety
+    /// What it returns is run into Self's field N, of a Self being
+    /// initialized.
+    unsafe fn init() -> impl PinInit<Self::Type, BchError>;
+}
+
+/// #[derive(Init)]'s initializer for B's field N, without #[init]: its
+/// InitAt, if a placed type lives there, else zeroed - picked by which
+/// trait's pick() method resolution finds first, PickPlaced's on a Pick,
+/// before PickZeroed's on a &Pick. A wrong pick doesn't compile: a placed
+/// type isn't Zeroable, and its init() takes only its own field's At. A
+/// placed field must be #[pin]: its initializer's only a PinInit.
+#[doc(hidden)]
+pub(crate) struct Pick<B, const N: u64>(PhantomData<fn() -> B>);
+
+impl<B, const N: u64> Pick<B, N> {
+    pub(crate) fn new() -> Self {
+        Pick(PhantomData)
+    }
+}
+
+#[doc(hidden)]
+pub(crate) trait PickPlaced<T> {
+    /// # Safety
+    /// As InitAt::init()'s.
+    unsafe fn pick(&self) -> impl PinInit<T, BchError>;
+}
+
+impl<B: InitAt<N>, const N: u64> PickPlaced<B::Type> for Pick<B, N> {
+    unsafe fn pick(&self) -> impl PinInit<B::Type, BchError> {
+        // SAFETY: the caller's
+        unsafe { B::init() }
+    }
+}
+
+#[doc(hidden)]
+pub(crate) trait PickZeroed<T> {
+    /// # Safety
+    /// None: unsafe as PickPlaced's is, the call being the same.
+    unsafe fn pick(&self) -> impl Init<T>;
+}
+
+impl<B: Field<N>, const N: u64> PickZeroed<B::Type> for &Pick<B, N>
+where
+    B::Type: Zeroable,
+{
+    unsafe fn pick(&self) -> impl Init<B::Type> {
+        pin_init::init_zeroed()
+    }
+}
+
+/// Every Self is its parent's field: it holds an At, which at() made where
+/// the At says. #[placed] implements it.
+///
+/// # Safety
+/// Self has a field of type Self::At, so a Self is had only from an
+/// initializer at() was given.
+pub(crate) unsafe trait Placed: Sized {
+    /// What it's the field of.
+    type Parent;
+    /// Its proof - which ties Parent to where at() made it.
+    #[doc(hidden)]
+    type At: Place<Type = Self, Base = Self::Parent>;
+
+    /// Its At field, of the Self at @p.
+    ///
+    /// # Safety
+    /// @p points to a Self.
+    #[doc(hidden)]
+    unsafe fn placed_at_raw(p: *const Self) -> *const Self::At;
+
+    /// The parent this is the field of.
+    fn container(&self) -> &Self::Parent {
+        // SAFETY: a Self, borrowed
+        unsafe { container_of(self) }
+    }
+}
+
+/// container(), from a pointer: for a placed value had only by one - behind
+/// an Opaque, which C writes through.
+///
+/// # Safety
+/// @p points to a live Self, initialized - had for 'a.
+pub(crate) unsafe fn container_of<'a, T: Placed>(p: *const T) -> &'a T::Parent {
+    // SAFETY: Placed's - p is in a parent, its At's offset() in it, the At
+    // fixed once made; had for 'a, so the parent's live for 'a. Its known
+    // gap, the parent's discipline: see the file comment
+    unsafe {
+        let at = &*T::placed_at_raw(p);
+        &*p.byte_sub(at.offset()).cast::<T::Parent>()
+    }
+}
+
+// ── Paths ────────────────────────────────────────────────────────────────
+
+/// A path from a value, as a type - for a field's type to name what's
+/// reached from the struct it's in: a ReffedWork's ref. Here is the value;
+/// Up<P> the parent of what P reaches, by its container(); FieldOf<P, N>
+/// field N of what P reaches, by Field<N>; ElemOf<P, I> element I of the
+/// array P reaches; Through<P> what the pointer P reaches points to - a
+/// BackRef. field!() writes one: from bch_fs_snapshots, field!(super.writes)
+/// - FieldOf<Up<Here>, N> - is the write refs of its Fs.
+///
+/// A path of every step but Through stays within what the value it starts
+/// from is in: Within.
+pub(crate) struct Here;
+
+pub(crate) struct Up<P>(PhantomData<P>);
+
+pub(crate) struct FieldOf<P, const N: u64>(PhantomData<P>);
+
+pub(crate) struct ElemOf<P, const I: usize>(PhantomData<P>);
+
+pub(crate) struct Through<P>(PhantomData<P>);
+
+/// A path within what the value it starts from is in: no Through - so a ref
+/// on a count it reaches keeps the value.
+pub(crate) trait Within {}
+
+impl Within for Here {}
+impl<P: Within> Within for Up<P> {}
+impl<P: Within, const N: u64> Within for FieldOf<P, N> {}
+impl<P: Within, const I: usize> Within for ElemOf<P, I> {}
+
+/// Each of the path types: one path, where a tuple of them is several. An
+/// impl for one and an impl for a tuple can't overlap through this, as they
+/// could through Path<T>: a downstream crate could implement Path<ItsType>
+/// for a tuple.
+pub(crate) trait OnePath {}
+
+impl OnePath for Here {}
+impl<P> OnePath for Up<P> {}
+impl<P, const N: u64> OnePath for FieldOf<P, N> {}
+impl<P, const I: usize> OnePath for ElemOf<P, I> {}
+impl<P> OnePath for Through<P> {}
+
+/// A path from the struct a field's in, as a type: its fields by name,
+/// elements of an array field by index, what a pointer field points to by ->,
+/// and super for its parent - `field!(super.writes)`, `field!(super.super.c)`,
+/// `field!(io_ref[WRITE])`, `field!(fs->writes)`.
+#[macro_export]
+macro_rules! field {
+    ($($path:tt)+) => {
+        $crate::__field_path!($crate::util::place::Here; $($path)+)
+    };
+}
+
+#[doc(hidden)]
+#[macro_export]
+macro_rules! __field_path {
+    ($p:ty;) => {
+        $p
+    };
+    ($p:ty; super $(. $($rest:tt)+)?) => {
+        $crate::__field_path!($crate::util::place::Up<$p>; $($($rest)+)?)
+    };
+    ($p:ty; $f:ident -> $($rest:tt)+) => {
+        $crate::__field_path!(
+            $crate::util::place::Through<
+                $crate::util::place::FieldOf<$p, { $crate::util::place::name(stringify!($f)) }>>;
+            $($rest)+)
+    };
+    ($p:ty; $f:ident [ $i:expr ] $(. $($rest:tt)+)?) => {
+        $crate::__field_path!(
+            $crate::util::place::ElemOf<
+                $crate::util::place::FieldOf<$p, { $crate::util::place::name(stringify!($f)) }>,
+                { $i }>;
+            $($($rest)+)?)
+    };
+    ($p:ty; $f:ident $(. $($rest:tt)+)?) => {
+        $crate::__field_path!(
+            $crate::util::place::FieldOf<$p, { $crate::util::place::name(stringify!($f)) }>;
+            $($($rest)+)?)
+    };
+}
+
+/// What path Self reaches from a T.
+pub(crate) trait Path<T> {
+    type To;
+    fn get(t: &T) -> &Self::To;
+}
+
+impl<T> Path<T> for Here {
+    type To = T;
+    fn get(t: &T) -> &T {
+        t
+    }
+}
+
+impl<T, P: Path<T>> Path<T> for Up<P>
+where
+    P::To: Placed + 'static,
+{
+    type To = <P::To as Placed>::Parent;
+    fn get(t: &T) -> &Self::To {
+        P::get(t).container()
+    }
+}
+
+impl<T, P: Path<T>, const N: u64> Path<T> for FieldOf<P, N>
+where
+    P::To: Field<N> + 'static,
+{
+    type To = <P::To as Field<N>>::Type;
+    fn get(t: &T) -> &Self::To {
+        let b: *const P::To = P::get(t);
+        // SAFETY: Field<N>'s - its field of that type, at that offset - in
+        // a B borrowed for as long
+        unsafe { &*b.byte_add(<P::To as Field<N>>::OFFSET).cast() }
+    }
+}
+
+impl<T, P, E, const I: usize, const N: usize> Path<T> for ElemOf<P, I>
+where
+    P: Path<T, To = [E; N]>,
+{
+    type To = E;
+    fn get(t: &T) -> &E {
+        const { assert!(I < N, "an array path's index past its end") };
+        &P::get(t)[I]
+    }
+}
+
+impl<T, P: Path<T>> Path<T> for Through<P>
+where
+    P::To: core::ops::Deref + 'static,
+    <P::To as core::ops::Deref>::Target: Sized,
+{
+    type To = <P::To as core::ops::Deref>::Target;
+    fn get(t: &T) -> &Self::To {
+        P::get(t)
+    }
+}
+
+// ── Elements of a container ──────────────────────────────────────────────
+
+/// Every Self lives in the container at Base's field - a Container, which
+/// Self's #[placed(Base.field[..])] makes there: a Self is had only from
+/// that container's insert(), and dies in it. So none outlives its Base.
+///
+/// # Safety
+/// Self has a field of type AtIn<Self>, so a Self is had only from a
+/// PlacedInit its Container's insert() ran.
+pub(crate) unsafe trait PlacedIn: Sized {
+    type Base;
+}
+
+/// Proof that what holds it was made by its container's insert(), which
+/// alone makes one. Zero bytes, as At, and as At an UnsafeCell and !Unpin.
+#[repr(C)]
+pub(crate) struct AtIn<T> {
+    _c:   UnsafeCell<[u8; 0]>,
+    _t:   PhantomData<fn() -> T>,
+    _pin: PhantomData<PhantomPinned>,
+}
+
+// SAFETY: no bytes, for threads to race on
+unsafe impl<T> Sync for AtIn<T> {}
+
+/// What a Container keeps its elements in.
+///
+/// # Safety
+/// An element gets in only by insert(), made in place and never moved; it
+/// leaves only by retain(), dropped; and what's held is dropped when the
+/// container is. No element is had by value, before or after.
+pub(crate) unsafe trait Holds<T>: Sized {
+    fn empty() -> Self;
+    fn insert<E: From<AllocError>>(&mut self, init: impl PinInit<T, E>) -> Result<(), E>;
+    fn iter<'a>(&'a self) -> impl Iterator<Item = &'a T> where T: 'a;
+    /// Keep the elements @f says to; drop the rest.
+    fn retain(&mut self, f: impl FnMut(&T) -> bool);
+}
+
+// SAFETY: each element in a pinned box of its own, made there; room for
+// its box is made first, so an element made is an element held
+unsafe impl<T> Holds<T> for KVVec<Pin<KBox<T>>> {
+    fn empty() -> Self {
+        KVVec::new()
+    }
+
+    fn insert<E: From<AllocError>>(&mut self, init: impl PinInit<T, E>) -> Result<(), E> {
+        self.reserve(1, GFP_KERNEL)?;
+        let b = kbox_pin_init(init)?;
+        self.push(b, GFP_KERNEL).expect("room reserved");
+        Ok(())
+    }
+
+    fn iter<'a>(&'a self) -> impl Iterator<Item = &'a T> where T: 'a {
+        self[..].iter().map(|b| &**b)
+    }
+
+    fn retain(&mut self, mut f: impl FnMut(&T) -> bool) {
+        KVVec::retain(self, |b| f(&**b))
+    }
+}
+
+/// The container of a placed field's elements: T's #[placed(Base.field[..])]
+/// makes it, at Base's field - its InitAt, by container(), the only way to
+/// have one - and its insert() is the only thing that makes a T. It keeps
+/// its C to itself: no &mut C, and no T by value, for an element to leave
+/// by.
+pub(crate) struct Container<T, C> {
+    c:  C,
+    _t: PhantomData<fn() -> T>,
+}
+
+impl<T: PlacedIn, C: Holds<T>> Container<T, C> {
+    /// Make an element here, by @init - placed_init!()'s, given its AtIn.
+    pub(crate) fn insert<E: From<AllocError>>(&mut self, init: impl PlacedInit<T, E>) -> Result<(), E> {
+        self.c.insert(init.__init(AtIn { _c: UnsafeCell::new([]), _t: PhantomData, _pin: PhantomData }))
+    }
+
+    pub(crate) fn iter(&self) -> impl Iterator<Item = &T> {
+        self.c.iter()
+    }
+
+    /// Keep the elements @f says to; drop the rest.
+    pub(crate) fn retain(&mut self, f: impl FnMut(&T) -> bool) {
+        self.c.retain(f)
+    }
+}
+
+/// An element's initializer, for its container's insert(): placed_init!()'s,
+/// which is pin_init!()'s, but for the element's _placed_at - which it's
+/// given the AtIn for, by insert(). Sealed, its one implementation made by
+/// the macro alone: so the code that wrote the initializer never has the
+/// AtIn, to put anywhere else.
+pub(crate) trait PlacedInit<T, E>: sealed::Sealed {
+    #[doc(hidden)]
+    fn __init(self, at: AtIn<T>) -> impl PinInit<T, E>;
+}
+
+/// placed_init!()'s PlacedInit: a closure of the AtIn.
+#[doc(hidden)]
+pub(crate) struct InitIn<T, F>(F, PhantomData<fn() -> T>);
+
+impl<T, F> InitIn<T, F> {
+    /// # Safety
+    /// @f puts the AtIn it's given in the T's _placed_at, and nowhere else:
+    /// placed_init!()'s.
+    #[doc(hidden)]
+    pub(crate) unsafe fn __new(f: F) -> Self {
+        InitIn(f, PhantomData)
+    }
+}
+
+impl<T, F> sealed::Sealed for InitIn<T, F> {}
+
+impl<T, E, I: PinInit<T, E>, F: FnOnce(AtIn<T>) -> I> PlacedInit<T, E> for InitIn<T, F> {
+    fn __init(self, at: AtIn<T>) -> impl PinInit<T, E> {
+        (self.0)(at)
+    }
+}
+
+/// An element's initializer, written as pin_init!()'s is, but for its
+/// _placed_at: that's its container's to give it, by insert().
+///
+/// ```text
+/// fn new(n: u64) -> impl PlacedInit<Self, BchError> {
+///     placed_init!(Self { n }? BchError)
+/// }
+/// // elems.insert(Elem::new(n))?
+/// ```
+#[macro_export]
+macro_rules! placed_init {
+    ($t:path { $($fields:tt)* } $(? $e:ty)?) => {{
+        // the AtIn's name is the macro's: the fields can't name it
+        let f = move |__placed_at| ::pin_init::pin_init!($t { _placed_at: __placed_at, $($fields)* } $(? $e)?);
+        // SAFETY: the AtIn goes in _placed_at, and nowhere else
+        unsafe { $crate::util::place::InitIn::__new(f) }
+    }};
+}
+
+/// The Container for B's field N - its InitAt's, which #[placed] on the
+/// element type makes.
+///
+/// # Safety
+/// What it returns is run into B's field N, of a B being initialized.
+#[doc(hidden)]
+pub(crate) unsafe fn container<B, const N: u64, T, C>() -> impl PinInit<Container<T, C>, BchError>
+where
+    B: Field<N, Type = Container<T, C>>,
+    T: PlacedIn<Base = B>,
+    C: Holds<T>,
+{
+    // SAFETY: all of it written
+    unsafe {
+        pin_init::init_from_closure(|slot: *mut Container<T, C>| {
+            slot.write(Container { c: C::empty(), _t: PhantomData });
+            Ok(())
+        })
+    }
+}
