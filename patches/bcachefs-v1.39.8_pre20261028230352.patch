diff --git a/fs/bcachefs/sb/clean.rs b/fs/bcachefs/sb/clean.rs
new file mode 100644
index 0000000..330c895
--- /dev/null
+++ b/fs/bcachefs/sb/clean.rs
@@ -0,0 +1,294 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! BCH_SB_FIELD_clean: btree roots, and a few other things, are recovered
+//! from the journal after an unclean shutdown - but after a clean shutdown, to
+//! avoid having to read the journal, we can store them in the superblock.
+//!
+//! The section is a list of journal entries, stored exactly as they would be
+//! in the journal, after a header saying which journal seq they're as of.
+
+use core::ffi::c_int;
+use core::mem::size_of;
+use core::sync::atomic::Ordering::Relaxed;
+
+use cstruct_macros::c_export;
+use zerocopy::IntoBytes;
+
+use crate::btree::bkey::BkeySCToText;
+use crate::btree::interior::btree_roots_to_journal_entries;
+use crate::c;
+use crate::errcode::{bch_errcode, err_ptr, ret_to_c, ret_to_result_void as ret_to_result, BchError};
+use crate::fs::{Fs, SbLockGuard};
+use crate::journal::entries::{EntryWriter, NoRoom};
+use crate::sb::io::{entries_end, SbFieldOps};
+use crate::types::{Le32, Le64};
+use crate::util::alloc::{flags::GFP_KERNEL, KVVec};
+use crate::util::ffi::Opaque;
+use crate::util::vstructs::{bytes_of_mut, Head, Unvalidated, UnvalidatedEntriesMut, Validated, VstructRef};
+use crate::util::{Printbuf, ToText};
+use crate::{bch_err, fsck_err, mustfix_fsck_err_on, prt};
+use crate::sb::io::SbResize;
+
+type Section = c::bch_sb_field_clean;
+
+const SECTION_HEAD: usize = size_of::<Head<Section>>();
+
+/// Nothing of its own to validate: its header whole, and an entry overrunning
+/// its end, are sb_field_validate()'s, and the entries themselves are
+/// validated late, with the filesystem - bch2_sb_clean_validate_late().
+impl SbFieldOps for Section {
+    fn to_text(out: &mut Printbuf, fs: Option<&Fs>, _sb: &c::bch_sb<Unvalidated>,
+                f: &c::bch_sb_field_clean<Unvalidated>) {
+        write!(out, "flags:          {:x}\n", f.flags.get());
+        write!(out, "journal_seq:    {}\n", f.journal_seq.get());
+
+        let fs = fs.map_or(core::ptr::null_mut(), Fs::as_ptr);
+        for e in f.entries().map_while(Result::ok) {
+            if e.type_ == c::bch_jset_entry_type::BCH_JSET_ENTRY_btree_keys.0 as u8 && e.u64s() == 0 {
+                continue;
+            }
+            // SAFETY: a whole entry; C takes NULL for no filesystem
+            unsafe { c::bch2_journal_entry_to_text(out.as_raw(), fs, e.as_ffi().cast_mut()) };
+            out.newline();
+        }
+    }
+
+    fn entries_end(b: &[u8]) -> Option<usize> {
+        entries_end::<c::jset_entry<Validated>>(b, SECTION_HEAD, |_| true)
+    }
+}
+
+// ── Recovery's: the section read, and checked against the journal ──────────
+
+/// Its journal entries validated as the journal's are - which takes the
+/// filesystem, as a superblock section's validate can't: of a superblock of
+/// @version, @big_endian; @write for one about to be written. In place, as C
+/// may fix an entry up as it validates it.
+fn validate_late(fs: &Fs, version: u16, big_endian: bool, f: &mut Section, write: bool)
+    -> Result<(), BchError>
+{
+    let mut from = c::bkey_validate_context::default();
+    from.set_from(c::bkey_validate_from::BKEY_VALIDATE_superblock);
+    from.set_flags(if write { c::bch_validate_flags::BCH_VALIDATE_write } else { c::bch_validate_flags::empty() });
+
+    for e in UnvalidatedEntriesMut::<c::jset_entry<Unvalidated>>::new(&mut bytes_of_mut(f)[SECTION_HEAD..]) {
+        // whole: sb_field_validate() has repaired or refused a section with
+        // one overrunning its end
+        let e = e.map_err(|_| BchError::from(bch_errcode::BCH_ERR_invalid_sb_clean))?;
+        // SAFETY: a whole entry, ours to change
+        ret_to_result(unsafe {
+            c::bch2_journal_entry_validate(fs.as_ptr(), core::ptr::null_mut(), e.as_ffi_mut(),
+                                           version.into(), big_endian.into(), from)
+        })?;
+    }
+    Ok(())
+}
+
+impl Fs {
+    /// A copy of the clean section, validated - for recovery, which uses it
+    /// after sb_lock is dropped and the superblock may have changed, and
+    /// frees it with kvfree().
+    fn read_superblock_clean(&self) -> Result<*mut Head<c::bch_sb_field_clean>, BchError> {
+        let mut sb = self.sb_lock();
+        let (version, big_endian) = (sb.sb().version.get(), sb.sb().big_endian());
+
+        let Some(f) = sb.field::<Section>() else {
+            if fsck_err!(self, c::bch_sb_error_id::BCH_FSCK_ERR_sb_clean_missing,
+                         "superblock marked clean but clean section not present")? {
+                sb.sb_mut().set_clean(false);
+                sb.published().clean.set(0);
+            }
+            return Err(bch_errcode::BCH_ERR_invalid_sb_clean.into());
+        };
+
+        let bytes = f.as_bytes();
+        let mut copy = KVVec::from_elem(0u64, bytes.len() / size_of::<u64>(), GFP_KERNEL)
+            .map_err(|_| BchError::from(bch_errcode::BCH_ERR_ENOMEM_read_superblock_clean))?;
+        copy.as_mut_bytes().copy_from_slice(bytes);
+
+        // SAFETY: a copy of a validated section, as long as its count says
+        let clean = unsafe { Section::from_ffi_mut(copy.as_mut_ptr().cast()) };
+        validate_late(self, version, big_endian, clean, false)?;
+
+        let (p, _, _) = copy.into_raw_parts();
+        Ok(p.cast())
+    }
+}
+
+#[c_export]
+pub fn bch2_read_superblock_clean(c: &Opaque<c::bch_fs>) -> *mut Head<c::bch_sb_field_clean> {
+    Fs::from_c(c).read_superblock_clean().unwrap_or_else(err_ptr)
+}
+
+type Key<'a> = VstructRef<'a, c::bkey_i, Validated>;
+
+/// A btree root's entry in @entries, if there is one: its level, and its key
+/// - None for an entry with no key.
+fn btree_root<'a>(mut entries: impl Iterator<Item = &'a c::jset_entry>, id: u32)
+    -> Option<(u8, Option<Key<'a>>)>
+{
+    let e = entries.find(|e| e.type_ == c::bch_jset_entry_type::BCH_JSET_ENTRY_btree_root.0 as u8 &&
+                              u32::from(e.btree_id) == id)?;
+    Some((e.level, e.entries().next()))
+}
+
+/// A btree root's key in an error message.
+struct RootText<'a>(&'a Fs, &'a Option<(u8, Option<Key<'a>>)>);
+
+impl ToText for RootText<'_> {
+    fn to_text(&self, out: &mut Printbuf) {
+        match self.1 {
+            None               => write!(out, "(none)"),
+            Some((l, None))    => write!(out, "l={l} (no key)"),
+            Some((l, Some(k))) => prt!(out, "l={l} {}", BkeySCToText { k: k.key().into(), fs: self.0 }),
+        }
+    }
+}
+
+impl Fs {
+    /// Whether the clean section @clean agrees with @j, the journal's last
+    /// entry, after a clean shutdown: its seq, and every btree root. False if
+    /// its seq doesn't - it's of no use then - and an error if a root doesn't
+    /// and that can't be fixed.
+    fn verify_superblock_clean(&self, clean: &Section, j: &c::jset) -> Result<bool, BchError> {
+        if mustfix_fsck_err_on!(self, j.seq != clean.journal_seq,
+                c::bch_sb_error_id::BCH_FSCK_ERR_sb_clean_journal_seq_mismatch,
+                "superblock journal seq ({}) doesn't match journal ({}) after clean shutdown",
+                clean.journal_seq.get(), j.seq.get())? {
+            return Ok(false);
+        }
+
+        for id in 0..c::btree_id::BTREE_ID_NR.0 {
+            let sb = btree_root(clean.entries(), id);
+            let journal = btree_root(j.entries(), id);
+            if sb.is_none() && journal.is_none() {
+                continue;
+            }
+
+            let same = match (&sb, &journal) {
+                (Some((l1, Some(k1))), Some((l2, Some(k2)))) => l1 == l2 && k1.as_bytes() == k2.as_bytes(),
+                _ => false,
+            };
+            mustfix_fsck_err_on!(self, !same, c::bch_sb_error_id::BCH_FSCK_ERR_sb_clean_btree_root_mismatch,
+                "superblock btree root {id} doesn't match journal after clean shutdown\n\
+                 sb:      {}\n\
+                 journal: {}\n", RootText(self, &sb), RootText(self, &journal))?;
+        }
+        Ok(true)
+    }
+}
+
+/// # Safety
+/// *@cleanp is from bch2_read_superblock_clean(), and @j the last journal
+/// entry, validated.
+#[c_export]
+pub unsafe fn bch2_verify_superblock_clean(c: &Opaque<c::bch_fs>, cleanp: *mut *mut Head<c::bch_sb_field_clean>,
+                                           j: *mut Head<c::jset>) -> c_int {
+    // SAFETY: the caller's
+    let (clean, j) = unsafe { (Section::from_ffi(*cleanp), c::jset::<Validated>::from_ffi(j)) };
+    match Fs::from_c(c).verify_superblock_clean(clean, j) {
+        Ok(true) => 0,
+        Ok(false) => {
+            // SAFETY: a KVVec's buffer, which nothing uses after
+            unsafe {
+                c::rust_kvfree((*cleanp).cast());
+                *cleanp = core::ptr::null_mut();
+            }
+            0
+        }
+        Err(e) => ret_to_c(Err::<(), _>(e)),
+    }
+}
+
+// ── Writing it, at a clean shutdown ──────────────────────────────────────────
+
+/// The bytes super_entries_add_common() writes.
+const COMMON_BYTES: usize = size_of::<c::jset_entry_usage>() + 2 * size_of::<c::jset_entry_clock>();
+
+/// The entries every journal write carries, and the clean section: the key
+/// version, and both io clocks' times.
+fn super_entries_add_common(fs: &Fs, w: &mut EntryWriter<'_>) -> Result<(), NoRoom> {
+    let mut u = c::jset_entry_usage::default();
+    u.entry.type_ = c::bch_jset_entry_type::BCH_JSET_ENTRY_usage.0 as u8;
+    u.entry.btree_id = c::bch_fs_usage_type::BCH_FS_USAGE_key_version.0 as u8;
+    u.v = Le64::new(fs.key_version.load(Relaxed) as u64);
+    w.push_entry(u)?;
+
+    for (rw, clock) in fs.io_clock.iter().enumerate() {
+        let mut e = c::jset_entry_clock::default();
+        e.entry.type_ = c::bch_jset_entry_type::BCH_JSET_ENTRY_clock.0 as u8;
+        e.rw = rw as u8;
+        e.time = Le64::new(clock.now.load(Relaxed) as u64);
+        w.push_entry(e)?;
+    }
+    Ok(())
+}
+
+/// super_entries_add_common(), for C's journal write: at *@end, which it
+/// moves past them.
+///
+/// # Safety
+/// There's room for them at *@end.
+#[c_export]
+pub unsafe fn bch2_journal_super_entries_add_common(c: &Opaque<c::bch_fs>, end: *mut *mut Head<c::jset_entry>,
+                                                    _seq: u64) {
+    // SAFETY: the caller's - room for these
+    let buf = unsafe { core::slice::from_raw_parts_mut((*end).cast(), COMMON_BYTES) };
+    super_entries_add_common(Fs::from_c(c), &mut EntryWriter::new(buf)).expect("sized for them");
+    // SAFETY: as long as what was written
+    unsafe { *end = (*end).byte_add(COMMON_BYTES) };
+}
+
+/// Marked dirty, for a write with the journal in use.
+pub(crate) fn fs_mark_dirty(sb: &mut SbLockGuard<'_>) {
+    let sb = sb.sb_mut();
+    sb.set_clean(false);
+    sb.features[0] |= c::BCH_SB_FEATURES_ALWAYS;
+}
+
+/// Marked clean: the clean section written, so the next mount needn't read
+/// the journal - its btree roots, the key version and io clocks, as of the
+/// journal's seq now. The flag is set once the section is written and valid:
+/// on an error, logged, the superblock stays dirty, and the next mount reads
+/// the journal.
+pub(crate) fn fs_mark_clean(fs: &Fs, guard: &mut SbLockGuard<'_>) {
+    let mut sb = fs.sb_resize(guard);
+    if sb.sb().clean() {
+        return;
+    }
+
+    let (version, big_endian) = (sb.sb().version.get(), sb.sb().big_endian());
+    sb.sb_mut().compat[0] |= 1 << c::bch_sb_compat::BCH_COMPAT_alloc_info.0 |
+                             1 << c::bch_sb_compat::BCH_COMPAT_alloc_metadata.0;
+
+    let u64s = SECTION_HEAD / size_of::<u64>() + fs.journal.entry_u64s_reserved as usize;
+    let Some(f) = sb.field_resize::<Section>(u64s as u32) else {
+        bch_err!(fs, "error resizing superblock while setting filesystem clean");
+        return;
+    };
+
+    f.flags = Le32::new(0);
+    f.journal_seq = Le64::new(fs.journal.seq.load(Relaxed) as u64);
+    // Trying to catch outstanding bug:
+    assert!(f.journal_seq.get() <= i64::MAX as u64, "journal seq {} past S64_MAX", f.journal_seq.get());
+
+    let entries = &mut bytes_of_mut(f)[SECTION_HEAD..];
+    let mut w = EntryWriter::new(entries);
+    if super_entries_add_common(fs, &mut w).and_then(|()| btree_roots_to_journal_entries(fs, &mut w, 0)).is_err() {
+        bch_err!(fs, "error setting filesystem clean: its entries overran entry_u64s_reserved");
+        return;
+    }
+    let written = w.len();
+    entries[written..].fill(0);
+
+    // this should be in the write path, and we should be validating every
+    // superblock section:
+    if validate_late(fs, version, big_endian, f, true).is_err() {
+        bch_err!(fs, "error writing marking filesystem clean: validate error");
+        return;
+    }
+    sb.sb_mut().set_clean(true);
+
+    // SAFETY: under sb_lock, which it needs
+    unsafe { c::bch2_journal_pos_from_member_info_set(fs.as_ptr()) };
+}
diff --git a/fs/bcachefs/sb/counters.h b/fs/bcachefs/sb/counters.h
new file mode 100644
index 0000000..63e0dab
--- /dev/null
+++ b/fs/bcachefs/sb/counters.h
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_SB_COUNTERS_H
+#define _BCACHEFS_SB_COUNTERS_H
+
+#include "bcachefs.h"
+#include "sb/io.h"
+
+/* The counters themselves are counters.rs's: sb/counters_gen.h, in bcachefs.h */
+
+#define counter_typecheck(_name, _type)					\
+	BUILD_BUG_ON(bch2_counter_flags[BCH_COUNTER_##_name] != _type)
+
+#define event_inc(_c, _name)						\
+do {									\
+	counter_typecheck(_name, TYPE_COUNTER);				\
+	this_cpu_inc((_c)->counters.now[BCH_COUNTER_##_name]);		\
+} while (0)
+
+#define event_add(_c, _name, _nr)					\
+do {									\
+	counter_typecheck(_name, TYPE_SECTORS);				\
+	this_cpu_add((_c)->counters.now[BCH_COUNTER_##_name], _nr);	\
+} while (0)
+
+#define __event_trace(_c, _name, _buf, ...)				\
+do {									\
+	CLASS(printbuf, _buf)();					\
+	printbuf_indent_add_nextline(&_buf, 2);				\
+	__VA_ARGS__;							\
+	trace_##_name(_c, _buf.buf);					\
+} while (0)
+
+#define event_trace(_c, _name, _buf, ...)				\
+do {									\
+	if (trace_##_name##_enabled()) {				\
+		__event_trace(_c, _name, _buf, __VA_ARGS__);		\
+	}								\
+} while (0)
+
+#define event_add_trace(_c, _name, _nr, ...)				\
+do {									\
+	event_trace(_c, _name, __VA_ARGS__);				\
+	event_add(_c, _name, _nr);					\
+} while (0)
+
+#define event_inc_trace(_c, _name, ...)					\
+do {									\
+	event_trace(_c, _name, __VA_ARGS__);				\
+	event_inc(_c, _name);						\
+} while (0)
+
+/*
+ * _fn variants: the tracepoint body is supplied as a function-call expression,
+ * so the call site's if-block contains nothing but the call instruction. The
+ * called function (typically __cold __noinline) does the printbuf+trace work
+ * out-of-line, keeping the hot path tight in icache regardless of whether
+ * the compiler's cold-partition pass honors the asm-goto-derived probability.
+ */
+#define event_trace_fn(_c, _name, _fn_call)				\
+do {									\
+	if (trace_##_name##_enabled())					\
+		_fn_call;						\
+} while (0)
+
+#define event_add_trace_fn(_c, _name, _nr, _fn_call)			\
+do {									\
+	event_trace_fn(_c, _name, _fn_call);				\
+	event_add(_c, _name, _nr);					\
+} while (0)
+
+#define event_inc_trace_fn(_c, _name, _fn_call)				\
+do {									\
+	event_trace_fn(_c, _name, _fn_call);				\
+	event_inc(_c, _name);						\
+} while (0)
+
+#endif // _BCACHEFS_SB_COUNTERS_H
diff --git a/fs/bcachefs/sb/counters.rs b/fs/bcachefs/sb/counters.rs
new file mode 100644
index 0000000..2f46383
--- /dev/null
+++ b/fs/bcachefs/sb/counters.rs
@@ -0,0 +1,407 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Events - sb/counters.h's event_inc(), event_add() and event_trace() - for
+//! Rust, each event a type; C's macros are as they were.
+//!
+//! An event is one of BCH_PERSISTENT_COUNTERS() (counters_format.rs): a
+//! counter in the filesystem's counters.now[], per CPU, and the tracepoint of
+//! the same name every counter has (debug/trace.h). Its type, events::<name>,
+//! carries what the counter counts - occurrences (TYPE_COUNTER) or sectors
+//! (TYPE_SECTORS) - so event_inc() takes the one and event_add() the other,
+//! as C's counter_typecheck() checks.
+//!
+//! Counters are util/percpu.rs's PerCpu, added to on this CPU. A tracepoint is
+//! checked as C's trace_<name>_enabled() is, a static branch on its key -
+//! util/jump_label.rs's static_branch_unlikely!() - so a disabled one costs a NOP; its
+//! message is built only once it's on, out of line, as __event_trace() builds
+//! it, and handed to C's rust_do_trace_<name>(), which debug/trace.c makes for
+//! every tracepoint with CREATE_RUST_TRACE_POINTS. Userspace has no
+//! tracepoints: none is ever on.
+//!
+//! XXX: a tracepoint fired only from Rust gets no __tracepoint_check entry, as
+//! C's use sites leave, so a WARN_ON_UNUSED_TRACEPOINTS build calls it unused.
+
+use core::ffi::c_int;
+
+use cstruct_macros::c_export;
+
+use crate::c;
+use crate::errcode::BchError;
+use crate::util::vstructs::Unvalidated;
+use crate::fs::{Fs, SbLockGuard};
+use crate::prt;
+use crate::sb::io::{sb_field_u64s, SbFieldOps};
+use crate::types::Le64;
+use crate::util::ffi::Opaque;
+use crate::util::kernel::{nsecs_to_jiffies, NSEC_PER_SEC};
+use crate::util::workqueue::Queue;
+use crate::util::Printbuf;
+use crate::sb::io::SbResize;
+
+/// What an event's counter counts.
+pub trait Kind {}
+
+/// Occurrences: TYPE_COUNTER, counted with event_inc().
+pub enum Count {}
+
+/// An amount in sectors: TYPE_SECTORS, added with event_add().
+pub enum Sectors {}
+
+impl Kind for Count {}
+impl Kind for Sectors {}
+
+/// One of BCH_PERSISTENT_COUNTERS(): its counter, and its tracepoint.
+pub trait Event: Copy {
+    type Kind: Kind;
+
+    /// Its counter's index in counters.now[]: BCH_COUNTER_<name>.
+    const IDX: usize;
+
+    /// Whether its tracepoint is on: trace_<name>_enabled().
+    fn trace_enabled() -> bool;
+
+    /// Fire its tracepoint, with @msg: trace_<name>().
+    fn trace(fs: &Fs, msg: &Printbuf);
+}
+
+macro_rules! event_kind {
+    (TYPE_COUNTER) => { Count };
+    (TYPE_SECTORS) => { Sectors };
+}
+
+macro_rules! events {
+    ($(($name:ident, $id:tt, $ty:tt $(, $($rest:tt)*)?)),* $(,)?) => { ::paste::paste! {
+        /// The events of BCH_PERSISTENT_COUNTERS(), each a type.
+        #[allow(non_camel_case_types)]
+        pub mod events {
+            $(
+                #[derive(Clone, Copy)]
+                pub struct $name;
+            )*
+        }
+
+        $(
+            impl Event for events::$name {
+                type Kind = event_kind!($ty);
+
+                const IDX: usize = c::[<BCH_COUNTER_ $name>] as usize;
+
+                #[cfg(all(kernel, CONFIG_TRACEPOINTS))]
+                #[inline(always)]
+                fn trace_enabled() -> bool {
+                    // SAFETY: a tracepoint's key, which C defines
+                    unsafe {
+                        crate::static_branch_unlikely!(tracepoints::[<__tracepoint_ $name>],
+                                                       c::tracepoint, key)
+                    }
+                }
+
+                #[cfg(not(all(kernel, CONFIG_TRACEPOINTS)))]
+                #[inline(always)]
+                fn trace_enabled() -> bool {
+                    false
+                }
+
+                #[cfg(all(kernel, CONFIG_TRACEPOINTS))]
+                fn trace(fs: &Fs, msg: &Printbuf) {
+                    // SAFETY: @fs is live, and @msg a C string the tracepoint
+                    // copies
+                    unsafe {
+                        tracepoints::[<rust_do_trace_ $name>](fs.as_ptr(), msg.as_c_str().as_ptr());
+                    }
+                }
+
+                #[cfg(not(all(kernel, CONFIG_TRACEPOINTS)))]
+                fn trace(_fs: &Fs, _msg: &Printbuf) {}
+            }
+        )*
+
+        /// The tracepoints, C's: debug/trace.c's.
+        #[cfg(all(kernel, CONFIG_TRACEPOINTS))]
+        mod tracepoints {
+            use crate::c;
+
+            extern "C" {
+                $(
+                    pub(super) static [<__tracepoint_ $name>]: c::tracepoint;
+                    pub(super) fn [<rust_do_trace_ $name>](c: *mut c::bch_fs, str: *const ::core::ffi::c_char);
+                )*
+            }
+        }
+    } };
+}
+c::BCH_PERSISTENT_COUNTERS!(events);
+
+pub struct CounterInfo {
+    pub name: &'static str,
+    pub stable_id: u16,
+    pub is_sectors: bool,
+}
+
+// From BCH_PERSISTENT_COUNTERS(): its entries are (name, stable id, type,
+// description).
+macro_rules! counter_is_sectors {
+    (TYPE_SECTORS) => { true };
+    ($other:tt) => { false };
+}
+macro_rules! counter_table {
+    ($(($name:tt, $id:tt, $ty:tt $(, $($rest:tt)*)?)),* $(,)?) => {
+        pub const COUNTERS: &[CounterInfo] = &[$(
+            CounterInfo { name: stringify!($name), stable_id: $id, is_sectors: counter_is_sectors!($ty) },
+        )*];
+    };
+}
+c::BCH_PERSISTENT_COUNTERS!(counter_table);
+
+impl Fs {
+    /// Count @_e once: event_inc().
+    #[inline(always)]
+    pub fn event_inc<E: Event<Kind = Count>>(&self, _e: E) {
+        self.event_count::<E>(1);
+    }
+
+    /// Add @nr sectors to @_e: event_add().
+    #[inline(always)]
+    pub fn event_add<E: Event<Kind = Sectors>>(&self, _e: E, nr: u64) {
+        self.event_count::<E>(nr);
+    }
+
+    #[inline(always)]
+    fn event_count<E: Event>(&self, nr: u64) {
+        self.counters.now.at(E::IDX).add(nr);
+    }
+
+    /// Fire @e's tracepoint, if it's on, with the message @msg writes - its
+    /// lines after the first indented by 2: event_trace().
+    #[inline(always)]
+    pub fn event_trace<E: Event>(&self, e: E, msg: impl FnOnce(&mut Printbuf)) {
+        if E::trace_enabled() {
+            self.event_trace_on(e, msg);
+        }
+    }
+
+    #[cold]
+    #[inline(never)]
+    fn event_trace_on<E: Event>(&self, _e: E, msg: impl FnOnce(&mut Printbuf)) {
+        let mut buf = Printbuf::new();
+        buf.indent_add_nextline(2);
+        msg(&mut buf);
+        E::trace(self, &buf);
+    }
+
+    /// event_trace(), then event_inc(): event_inc_trace().
+    #[inline(always)]
+    pub fn event_inc_trace<E: Event<Kind = Count>>(&self, e: E, msg: impl FnOnce(&mut Printbuf)) {
+        self.event_trace(e, msg);
+        self.event_inc(e);
+    }
+
+    /// event_trace(), then event_add(): event_add_trace().
+    #[inline(always)]
+    pub fn event_add_trace<E: Event<Kind = Sectors>>(&self, e: E, nr: u64,
+                                                    msg: impl FnOnce(&mut Printbuf)) {
+        self.event_trace(e, msg);
+        self.event_add(e, nr);
+    }
+}
+
+// ── The counters, in memory and in the superblock ──────────────────────────
+//
+// In memory by BCH_COUNTER_* index, COUNTERS' order; in the superblock and the
+// ioctl by stable id. mount[] and recent[] are plain u64s, written racing
+// readers that only print them, as in C.
+
+const NR: usize = c::BCH_COUNTER_NR as usize;
+const NR_STABLE: usize = c::BCH_COUNTER_STABLE_NR as usize;
+
+impl c::bch_fs_counters {
+    /// Counter @i, every CPU's count summed.
+    fn now(&self, i: usize) -> u64 {
+        self.now.at(i).sum()
+    }
+
+    /// For mount[] and recent[], which change under shared references.
+    fn raw(&self) -> *mut Self {
+        core::ptr::from_ref(self).cast_mut()
+    }
+
+    /// The counters that changed in the last ten seconds: each with what
+    /// it's gone up by in each half second since, newest first.
+    pub fn recent_to_text(&self, out: &mut Printbuf) {
+        let oldest = &self.recent[c::NR_RECENT_COUNTERS as usize - 1];
+
+        for (i, ctr) in COUNTERS.iter().enumerate() {
+            let mut prev = self.now(i);
+            if oldest[i] == prev {
+                continue;
+            }
+
+            prt!(out, "{}:", ctr.name);
+            for sample in &self.recent {
+                prt!(out, "\t{}", prev.wrapping_sub(sample[i]));
+                prev = sample[i];
+            }
+            prt!(out, "\n");
+        }
+    }
+}
+
+#[c_export]
+pub fn bch2_sb_recent_counters_to_text(out: &mut Printbuf, ctrs: &c::bch_fs_counters) {
+    ctrs.recent_to_text(out)
+}
+
+impl Fs {
+    pub fn counter_read(&self, idx: usize) -> u64 {
+        assert!(idx < NR);
+        self.counters.now(idx)
+    }
+
+    /// Zero counter @idx - and what's relative to it, its count at mount and
+    /// its recent samples, which would otherwise read as having gone backwards.
+    pub fn counter_reset(&self, idx: usize) {
+        if idx >= NR {
+            return;
+        }
+
+        // SAFETY: an event counted as it's reset may as well not have been
+        unsafe { self.counters.now.at(idx).set(0) };
+        let ctrs = self.counters.raw();
+        // SAFETY: see the top of the section
+        unsafe {
+            (*ctrs).mount[idx] = 0;
+            for sample in &mut (*ctrs).recent {
+                sample[idx] = 0;
+            }
+        }
+    }
+}
+
+impl SbFieldOps for c::bch_sb_field_counters {
+    fn to_text(out: &mut Printbuf, _fs: Option<&Fs>, _sb: &c::bch_sb<Unvalidated>,
+                f: &c::bch_sb_field_counters<Unvalidated>) {
+        for ctr in COUNTERS {
+            if let Some(v) = f.d.get(ctr.stable_id as usize) {
+                prt!(out, "{} \t{}\n", ctr.name, v.get());
+            }
+        }
+    }
+
+    /// The counts now; those it has no slot for are left as they are.
+    fn to_cpu(fs: &Fs, sb: &mut SbLockGuard<'_>) -> Result<(), BchError> {
+        let d: &[Le64] = sb.field::<c::bch_sb_field_counters>().map_or(&[], |f| &f.d);
+        for (i, ctr) in COUNTERS.iter().enumerate() {
+            if let Some(v) = d.get(ctr.stable_id as usize) {
+                // SAFETY: an event counted as it's set may as well not have been
+                unsafe { fs.counters.now.at(i).set(v.get()) };
+            }
+        }
+        Ok(())
+    }
+
+    /// The counters - memory's - with the field grown to a slot for every
+    /// stable id if it can be, else as it is.
+    fn from_cpu(fs: &Fs, guard: &mut SbLockGuard<'_>) -> Result<(), BchError> {
+        let mut sb = fs.sb_resize(guard);
+
+        let u64s = sb_field_u64s::<c::bch_sb_field_counters>(NR_STABLE);
+        let _ = sb.field_get_minsize::<c::bch_sb_field_counters>(u64s);
+        let Some(f) = sb.field_mut::<c::bch_sb_field_counters>() else { return Ok(()) };
+
+        for (i, ctr) in COUNTERS.iter().enumerate() {
+            if let Some(d) = f.d.get_mut(ctr.stable_id as usize) {
+                *d = Le64::new(fs.counters.now(i));
+            }
+        }
+        Ok(())
+    }
+}
+
+crate::fs_delayed_work! {
+    /// Every half second: the counters sampled into recent[], newest first.
+    pub(crate) work RecentCounters: field counters_recent;
+
+    fn run(fs: &Fs) {
+        let ctrs = fs.counters.raw();
+        // SAFETY: see the top of the section
+        let recent = unsafe { &mut (*ctrs).recent };
+        let n = recent.len();
+        recent.copy_within(..n - 1, 1);
+        for (i, v) in recent[0].iter_mut().enumerate() {
+            *v = fs.counters.now(i);
+        }
+
+        Self::queue(fs);
+    }
+}
+
+impl RecentCounters {
+    fn queue(fs: &Fs) {
+        fs.counters_recent.queue(Queue::system_dfl(), nsecs_to_jiffies(NSEC_PER_SEC / 2));
+    }
+}
+
+/// The superblock's counters into memory, as both the counts now and at
+/// mount. A counter the superblock has no slot for starts at 0.
+#[c_export]
+pub fn bch2_fs_counters_init(c: &Opaque<c::bch_fs>) -> c_int {
+    let fs = Fs::from_c(c);
+    let mut sb = fs.sb_lock();
+    let _ = c::bch_sb_field_counters::to_cpu(fs, &mut sb);
+
+    let d: &[Le64] = sb.field::<c::bch_sb_field_counters>().map_or(&[], |f| &f.d);
+    let ctrs = fs.counters.raw();
+    for (i, ctr) in COUNTERS.iter().enumerate() {
+        // SAFETY: filesystem init, before anything reads them
+        unsafe { (*ctrs).mount[i] = d.get(ctr.stable_id as usize).map_or(0, |v| v.get()) };
+    }
+    0
+}
+
+#[c_export]
+pub fn bch2_fs_counters_init_late(c: &Opaque<c::bch_fs>) -> c_int {
+    RecentCounters::queue(Fs::from_c(c));
+    0
+}
+
+/// Before counters.now is freed.
+#[c_export]
+pub fn bch2_fs_counters_exit(c: &Opaque<c::bch_fs>) {
+    Fs::from_c(c).counters_recent.cancel_sync();
+}
+
+// ── BCH_IOCTL_QUERY_COUNTERS ─────────────────────────────────────────────────
+
+#[cfg(not(NO_BCACHEFS_CHARDEV))]
+pub mod ioctl {
+    use super::*;
+    use crate::errcode::{bch_errcode, BchError};
+    use crate::util::ioctl::UserVstruct;
+
+    /// The counters, by stable id, up to the user's @nr of them: now, or at
+    /// mount (BCH_IOCTL_QUERY_COUNTERS_MOUNT). @nr comes back as the number
+    /// filled.
+    pub fn query_counters(fs: &Fs, user: UserVstruct<c::bch_ioctl_query_counters>)
+        -> Result<(), BchError>
+    {
+        let mut arg = user.head()?;
+
+        let flags = u32::from(arg.flags);
+        if flags & !c::BCH_IOCTL_QUERY_COUNTERS_MOUNT != 0 || arg.pad != 0 {
+            return fs.throw(bch_errcode::BCH_ERR_EINVAL_ioctl_query_counters_bad_flags);
+        }
+        let mount = flags & c::BCH_IOCTL_QUERY_COUNTERS_MOUNT != 0;
+
+        arg.nr = arg.nr.min(NR_STABLE as u16);
+        user.set_head(&arg)?;
+
+        let d = user.tail(&arg);
+        for (i, ctr) in COUNTERS.iter().enumerate() {
+            if ctr.stable_id < arg.nr {
+                let v = if mount { fs.counters.mount[i] } else { fs.counters.now(i) };
+                d.set(ctr.stable_id.into(), &v)?;
+            }
+        }
+        Ok(())
+    }
+}
