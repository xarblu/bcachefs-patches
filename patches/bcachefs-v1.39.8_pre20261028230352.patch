+/// The table emptied: for an image stripped of its replicas sections.
+#[c_export]
+pub fn bch2_replicas_clear(c: &Opaque<c::bch_fs>) {
+    *Fs::from_c(c).replicas.write() = ReplicasCpu::new();
+}
