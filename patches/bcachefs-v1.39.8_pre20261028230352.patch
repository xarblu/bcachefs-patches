index 0000000..33f7167
--- /dev/null
+++ b/fs/bcachefs/journal/write.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_JOURNAL_WRITE_H
+#define _BCACHEFS_JOURNAL_WRITE_H
+
+CLOSURE_CALLBACK(bch2_journal_write);
+void bch2_journal_do_writes_locked(struct journal *);
+void bch2_journal_do_writes(struct journal *);
+
+static inline struct jset_entry *jset_entry_init(struct jset_entry **end, size_t size)
+{
+	struct jset_entry *entry = *end;
+	unsigned u64s = DIV_ROUND_UP(size, sizeof(u64));
+
+	memset(entry, 0, u64s * sizeof(u64));
+	/*
+	 * The u64s field counts from the start of data, ignoring the shared
+	 * fields.
+	 */
+	entry->u64s = cpu_to_le16(u64s - 1);
+
+	*end = vstruct_next(*end);
+	return entry;
+}
+
+#endif /* _BCACHEFS_JOURNAL_WRITE_H */
diff --git a/fs/bcachefs/locking/bytelock.rs b/fs/bcachefs/locking/bytelock.rs
new file mode 100644
index 0000000..4d4d9fe
--- /dev/null
+++ b/fs/bcachefs/locking/bytelock.rs
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! ByteLock: a sleeping lock in one byte, for what there are millions of and
+//! no room in - a bucket's gc state, a gc stripe's. Not for contention: it
+//! has no fairness and no lockdep.
+//!
+//! The futex mutex of Drepper's "Futexes Are Tricky", on util/futex.rs. The
+//! byte is 0, unlocked; 1, locked; 2, locked and maybe waited on:
+//!
+//! - lock: 0 to 1. Taken: swap in 2, and futex_wait() while that swap doesn't
+//!   get 0 - and when it does, it's ours, as 2, as there may be others.
+//! - unlock: swap in 0, and futex_wake() one waiter if it was 2. Uncontended,
+//!   lock and unlock are one atomic each.
+//!
+//! It sleeps, where a spinlock would do for how briefly it's held: holders
+//! fsck_err(), which takes a mutex and may allocate.
+//!
+//! Zeroed is unlocked, with nothing to initialize: arrays of them are
+//! allocated zeroed. So there's no lockdep class, and assert_held() can say
+//! only that someone holds it.
+//!
+//! C had these as a bit in an unsigned long overlapping the struct's next
+//! fields, because xchg() on a byte wasn't on every architecture. Rust's byte
+//! atomics are: LLVM masks a word where the CPU has none, and a plain store
+//! to the word's other bytes only makes the LL/SC or CAS retry. C, while it
+//! still takes them, does so through bch2_byte_lock() and bch2_byte_unlock().
+
+use super::{Lock, RawLock, RawTryLock};
+use core::sync::atomic::{AtomicU8, Ordering};
+use crate::util::futex::{futex_wait, futex_wake};
+use crate::util::sleep::Sleep;
+use core::convert::Infallible;
+use core::ffi::{c_void, CStr};
+use cstruct_macros::c_export;
+use pin_init::Zeroable;
+
+const UNLOCKED:  u8 = 0;
+const LOCKED:    u8 = 1;
+const CONTENDED: u8 = 2;
+
+#[repr(transparent)]
+pub struct ByteLock(AtomicU8);
+
+// SAFETY: zeroed is unlocked
+unsafe impl Zeroable for ByteLock {}
+// SAFETY: zeroed, a Lock over a ByteLock is unlocked and initialized - if
+// what it holds is valid zeroed
+unsafe impl<G: Zeroable, P: Zeroable> Zeroable for Lock<ByteLock, G, P> {}
+
+impl ByteLock {
+    fn try_take(&self) -> bool {
+        self.0.compare_exchange(UNLOCKED, LOCKED, Ordering::Acquire, Ordering::Relaxed).is_ok()
+    }
+
+    fn take(&self) {
+        // as C's wait_on_bit_lock(): caught taken where it can't sleep, even
+        // when it wouldn't
+        #[cfg(kernel)]
+        ::kernel::task::might_sleep();
+
+        if !self.try_take() {
+            self.take_contended();
+        }
+    }
+
+    #[cold]
+    fn take_contended(&self) {
+        while self.0.swap(CONTENDED, Ordering::Acquire) != UNLOCKED {
+            let Ok(()) = futex_wait(&self.0, CONTENDED, Sleep::UNINTERRUPTIBLE);
+        }
+    }
+
+    fn release(&self) {
+        if self.0.swap(UNLOCKED, Ordering::Release) == CONTENDED {
+            futex_wake(core::ptr::from_ref(&self.0).cast(), 1);
+        }
+    }
+}
+
+unsafe impl RawLock for ByteLock {
+    type GuardState = ();
+    type InitError = Infallible;
+
+    unsafe fn init(l: *mut Self, _name: &'static CStr, _key: *mut c_void) -> Result<(), Infallible> {
+        unsafe { l.write(ByteLock(AtomicU8::new(UNLOCKED))) };
+        Ok(())
+    }
+
+    unsafe fn lock(&self) {
+        self.take()
+    }
+
+    unsafe fn unlock(&self, _: ()) {
+        self.release()
+    }
+
+    unsafe fn assert_held(&self) {
+        debug_assert_ne!(self.0.load(Ordering::Relaxed), UNLOCKED);
+    }
+}
+
+unsafe impl RawTryLock for ByteLock {
+    unsafe fn try_lock(&self) -> Option<()> {
+        self.try_take().then_some(())
+    }
+}
+
+// ── C's, while C takes them ──────────────────────────────────────────────
+
+/// # Safety
+/// @l is a ByteLock: a byte only ever locked as one, or zeroed.
+#[c_export]
+pub unsafe fn bch2_byte_lock(l: *mut u8) {
+    unsafe { (*l.cast::<ByteLock>()).take() }
+}
+
+/// # Safety
+/// @l is a ByteLock the caller holds.
+#[c_export]
+pub unsafe fn bch2_byte_unlock(l: *mut u8) {
+    unsafe { (*l.cast::<ByteLock>()).release() }
+}
diff --git a/fs/bcachefs/locking/compat.rs b/fs/bcachefs/locking/compat.rs
new file mode 100644
index 0000000..22aee38
--- /dev/null
+++ b/fs/bcachefs/locking/compat.rs
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! What exists because C owns the lock, or holds it calling in - to go as the
+//! C does: a C struct's lock borrowed as a Lock, a Lock whose caller already
+//! holds it, and a Lock C carries held from one Rust call to another.
+
+use super::{Guard, Lock, RawLock};
+use core::mem::{align_of, size_of};
+
+impl<R: RawLock> Lock<R> {
+    /// A lock in a C struct - C's to initialize and free - as a Lock over
+    /// nothing, taken as C takes it.
+    pub fn from_c(raw: &R) -> &Self {
+        const { assert!(size_of::<Self>() == size_of::<R>() && align_of::<Self>() == align_of::<R>()) };
+        // Taking it through a & writes it: sound because C's locks are
+        // Opaques (raw.rs). Borrowed, so never dropped - C frees it.
+        unsafe { &*core::ptr::from_ref(raw).cast() }
+    }
+}
+
+impl<R: RawLock, G, P> Lock<R, G, P> {
+    /// The lock, as a caller holds it - C's, calling in: its guard isn't ours
+    /// to release.
+    ///
+    /// # Safety
+    /// The caller holds the lock exclusively - not as one of its readers -
+    /// and holds it for as long as this guard lives; nothing else this task
+    /// holds has the G.
+    pub unsafe fn held(&self) -> Guard<'_, R, G, P> {
+        self.assert_held();
+        unsafe { Guard::from_held(self, None) }
+    }
+}
+
+// Locked in Rust and released by C, which carries it between: until the C
+// between converts.
+
+impl<R: RawLock<GuardState = ()>, G, P> Guard<'_, R, G, P> {
+    /// Leave the lock held, for C to release.
+    pub fn leave_locked(self) {
+        core::mem::forget(self)
+    }
+}
diff --git a/fs/bcachefs/locking/lock.rs b/fs/bcachefs/locking/lock.rs
new file mode 100644
index 0000000..2ea08c9
--- /dev/null
+++ b/fs/bcachefs/locking/lock.rs
@@ -0,0 +1,431 @@
+// SPDX-License-Identifier: GPL-2.0
+
+use crate::util::projections::Publish;
+use core::cell::UnsafeCell;
+use core::ffi::{c_void, CStr};
+use core::marker::{PhantomData, PhantomPinned};
+use core::ops::{Deref, DerefMut};
+
+/// C's lock state, and how it's initialized, taken and released -
+/// implemented on C's lock types themselves, where the kernel crate's lock
+/// Backend is a marker over them.
+///
+/// # Safety
+/// lock() excludes every other holder until unlock(). All of its state is
+/// interior-mutable - C's locks are Opaques, ours atomics - so it's taken and
+/// released through a shared reference, from any thread. Callers pass an
+/// initialized lock, except to init() - for a C lock, a & to one zeroed
+/// isn't one: a zeroed kernel mutex's wait list is null - and unlock() the
+/// state their lock() returned.
+pub unsafe trait RawLock {
+    /// What releasing it needs: the interrupt state spin_lock_irqsave()
+    /// saved, the memalloc flags a Noio saved, or nothing.
+    type GuardState;
+    /// init()'s, for a lock that allocates: Infallible otherwise.
+    type InitError;
+
+    /// In lockdep class @key, named @name, at @l - uninitialized or zeroed
+    /// memory, which nothing else reaches until it returns; pinned from here
+    /// on.
+    unsafe fn init(l: *mut Self, name: &'static CStr, key: *mut c_void)
+        -> Result<(), Self::InitError>;
+
+    unsafe fn lock(&self) -> Self::GuardState;
+
+    unsafe fn unlock(&self, g: Self::GuardState);
+
+    /// That it's held exclusively - lockdep_assert_held(), and
+    /// lockdep_assert_held_write() for a lock readers can share: a reader
+    /// holding it isn't enough.
+    unsafe fn assert_held(&self);
+
+    /// For a lock that allocates; nothing holds it or will.
+    unsafe fn destroy(&self) {}
+}
+
+/// A RawLock that can be tried: taken only if no one holds it.
+///
+/// # Safety
+/// try_lock() is RawLock's lock(), when it returns Some; when None, nothing's
+/// taken, and nothing's left to release.
+pub unsafe trait RawTryLock: RawLock {
+    unsafe fn try_lock(&self) -> Option<Self::GuardState>;
+}
+
+/// A RawLock that can be taken as one of several of its lockdep class held
+/// at once - the others' order keeping them apart - each a subclass.
+///
+/// # Safety
+/// lock_nested() is RawLock's lock(), but for what lockdep is told.
+pub unsafe trait RawNestedLock: RawLock {
+    unsafe fn lock_nested(&self, subclass: u32) -> Self::GuardState;
+}
+
+/// A RawLock that readers can share: RawLock's lock() and unlock() are the
+/// writer's, alone.
+///
+/// # Safety
+/// lock_shared() excludes the writer, and only the writer, until
+/// unlock_shared(); as RawLock's otherwise.
+pub unsafe trait RawRwLock: RawLock {
+    unsafe fn lock_shared(&self) -> Self::GuardState;
+    unsafe fn unlock_shared(&self, g: Self::GuardState);
+    /// lockdep_assert_held(): by a reader or the writer.
+    unsafe fn assert_held_any(&self);
+}
+
+/// Lock @R, over two things: @G, protected - reached only with it held, its
+/// guard derefs to it - and @P, published: anyone's, the lock derefs to it,
+/// held or not; written through the guard's published(), so the lock a
+/// writer holds is the one it's in. Laid out as C's members, the lock then G
+/// then P, so a struct C shares can declare it as them:
+/// #[c_lock("struct mutex lock")].
+#[repr(C)]
+pub struct Lock<R: RawLock, G = (), P = ()> {
+    raw:       R,
+    protected: UnsafeCell<G>,
+    published: P,
+    // pinned - a kernel lock mustn't move - in a PhantomData: a bare
+    // PhantomPinned isn't FFI-safe in a repr(C) struct, and C's hold these
+    _pin:      PhantomData<PhantomPinned>,
+}
+
+// G is had by one thread at a time, as a std Mutex's; P is every thread's.
+// read() shares G, so it wants G: Sync.
+unsafe impl<R: RawLock, G: Send, P: Send> Send for Lock<R, G, P> {}
+unsafe impl<R: RawLock, G: Send, P: Sync> Sync for Lock<R, G, P> {}
+
+impl<R: RawLock, G, P> Lock<R, G, P> {
+    /// new_lock!()'s, which has a static lockdep key per call site.
+    ///
+    /// # Safety
+    /// @key is a lock class key that lives forever - or null, in userspace.
+    #[doc(hidden)]
+    pub unsafe fn new(g: G, p: P, name: &'static CStr, key: *mut c_void)
+        -> impl ::pin_init::PinInit<Self, R::InitError>
+    {
+        // If init() fails, nothing's written to drop.
+        unsafe {
+            ::pin_init::pin_init_from_closure(move |slot: *mut Self| {
+                R::init(&raw mut (*slot).raw, name, key)?;
+                (&raw mut (*slot).protected).write(UnsafeCell::new(g));
+                (&raw mut (*slot).published).write(p);
+                Ok(())
+            })
+        }
+    }
+
+    /// new(), with @g initialized in place: for a G too big to build on the
+    /// stack and move in - new_lock!(<- init). For a lock whose init() can't
+    /// fail, so that nothing's left to undo if @g's does.
+    ///
+    /// # Safety
+    /// As new()'s.
+    #[doc(hidden)]
+    pub unsafe fn new_init<E>(g: impl ::pin_init::PinInit<G, E>, p: P, name: &'static CStr, key: *mut c_void)
+        -> impl ::pin_init::PinInit<Self, E>
+    where
+        R: RawLock<InitError = core::convert::Infallible>,
+    {
+        unsafe {
+            ::pin_init::pin_init_from_closure(move |slot: *mut Self| {
+                let Ok(()) = R::init(&raw mut (*slot).raw, name, key);
+                // UnsafeCell<G> is laid out as G
+                crate::util::alloc::init_at(g, (&raw mut (*slot).protected).cast::<G>())?;
+                (&raw mut (*slot).published).write(p);
+                Ok(())
+            })
+        }
+    }
+
+    /// For a Lock in zeroed memory that new() can't reach - a static: its
+    /// raw lock initialized in place, G and P as zeroed.
+    ///
+    /// # Safety
+    /// Once, before anything takes it; zeroed is a valid G and P. @key is as
+    /// new()'s.
+    pub unsafe fn init_zeroed(&self, name: &'static CStr, key: *mut c_void) -> Result<(), R::InitError> {
+        unsafe { R::init(core::ptr::from_ref(&self.raw).cast_mut(), name, key) }
+    }
+
+    pub fn lock(&self) -> Guard<'_, R, G, P> {
+        let state = unsafe { self.raw.lock() };
+        Guard { lock: self, state: Some(state), _not_send: PhantomData }
+    }
+
+    /// lock(), as lockdep subclass @subclass: for locks of one class taken
+    /// together, always in the same order.
+    pub fn lock_nested(&self, subclass: u32) -> Guard<'_, R, G, P>
+    where
+        R: RawNestedLock,
+    {
+        let state = unsafe { self.raw.lock_nested(subclass) };
+        Guard { lock: self, state: Some(state), _not_send: PhantomData }
+    }
+
+    /// lock(), if no one holds it.
+    pub fn try_lock(&self) -> Option<Guard<'_, R, G, P>>
+    where
+        R: RawTryLock,
+    {
+        let state = unsafe { self.raw.try_lock() }?;
+        Some(Guard { lock: self, state: Some(state), _not_send: PhantomData })
+    }
+
+    /// Held exclusively - by the writer, for a lock readers share.
+    pub fn assert_held(&self) {
+        unsafe { self.raw.assert_held() }
+    }
+
+    /// Where the G is in a Lock: for C's container_of() from it.
+    pub const PROTECTED_OFFSET: usize = core::mem::offset_of!(Self, protected);
+
+    /// Where the P is: for #[c_lock]'s asserts.
+    pub const PUBLISHED_OFFSET: usize = core::mem::offset_of!(Self, published);
+
+    pub(super) fn raw(&self) -> &R {
+        &self.raw
+    }
+}
+
+impl<R: RawLock, G, P> Deref for Lock<R, G, P> {
+    type Target = P;
+
+    fn deref(&self) -> &P {
+        &self.published
+    }
+}
+
+impl<R: RawRwLock, G: Sync, P> Lock<R, G, P> {
+    pub fn read(&self) -> ReadGuard<'_, R, G, P> {
+        let state = unsafe { self.raw.lock_shared() };
+        ReadGuard { lock: self, state: Some(state), _not_send: PhantomData }
+    }
+
+    pub fn write(&self) -> Guard<'_, R, G, P> {
+        self.lock()
+    }
+
+    pub fn assert_held_any(&self) {
+        unsafe { self.raw.assert_held_any() }
+    }
+}
+
+impl<R: RawLock, G, P> Drop for Lock<R, G, P> {
+    fn drop(&mut self) {
+        unsafe { self.raw.destroy() }
+    }
+}
+
+/// A held Lock: released when dropped, if lock() took it. Not Send: released
+/// by the task that took it, as lockdep checks - and a spin_lock_irqsave()'s
+/// interrupt state is its CPU's.
+#[must_use = "the lock is released as soon as the guard is dropped"]
+pub struct Guard<'a, R: RawLock, G = (), P = ()> {
+    lock:      &'a Lock<R, G, P>,
+    /// None for a lock held by its caller - compat.rs's held(): not ours to
+    /// release
+    state:     Option<R::GuardState>,
+    _not_send: PhantomData<*mut ()>,
+}
+
+impl<'a, R: RawLock, G, P> Guard<'a, R, G, P> {
+    /// # Safety
+    /// @lock is held exclusively: taken with @state, or by our caller for as
+    /// long as the guard lives, if None.
+    pub(super) unsafe fn from_held(lock: &'a Lock<R, G, P>, state: Option<R::GuardState>) -> Self {
+        Guard { lock, state, _not_send: PhantomData }
+    }
+
+    pub(crate) fn lock(&self) -> &'a Lock<R, G, P> {
+        self.lock
+    }
+}
+
+impl<R: RawLock, G, P> Guard<'_, R, G, P> {
+    pub fn protected(&mut self) -> &mut G {
+        self
+    }
+
+    /// Borrows the guard mutably, so writers had through it are one at a time:
+    /// a FakePlaceRef held across another's store is caught, as far as it can
+    /// be.
+    pub fn published(&mut self) -> &P::Writer
+    where
+        P: Publish,
+    {
+        // P::Writer is laid out as P (Publish)
+        unsafe { &*core::ptr::from_ref(&self.lock.published).cast::<P::Writer>() }
+    }
+
+    /// protected() and published() at once: borrowing the guard once for both.
+    pub fn parts(&mut self) -> (&mut G, &P::Writer)
+    where
+        P: Publish,
+    {
+        unsafe {
+            (&mut *self.lock.protected.get(),
+             &*core::ptr::from_ref(&self.lock.published).cast::<P::Writer>())
+        }
+    }
+}
+
+impl<R: RawLock, G, P> Deref for Guard<'_, R, G, P> {
+    type Target = G;
+
+    fn deref(&self) -> &G {
+        unsafe { &*self.lock.protected.get() }
+    }
+}
+
+impl<R: RawLock, G, P> DerefMut for Guard<'_, R, G, P> {
+    fn deref_mut(&mut self) -> &mut G {
+        unsafe { &mut *self.lock.protected.get() }
+    }
+}
+
+impl<R: RawLock, G, P> Drop for Guard<'_, R, G, P> {
+    fn drop(&mut self) {
+        if let Some(state) = self.state.take() {
+            unsafe { self.lock.raw.unlock(state) }
+        }
+    }
+}
+
+#[must_use = "the lock is released as soon as the guard is dropped"]
+pub struct ReadGuard<'a, R: RawRwLock, G = (), P = ()> {
+    lock:      &'a Lock<R, G, P>,
+    // an Option only to be taken in drop()
+    state:     Option<R::GuardState>,
+    _not_send: PhantomData<*mut ()>,
+}
+
+impl<'a, R: RawRwLock, G, P> ReadGuard<'a, R, G, P> {
+    pub fn protected(&self) -> &G {
+        self
+    }
+
+    pub fn published(&self) -> &'a P {
+        &self.lock.published
+    }
+}
+
+impl<R: RawRwLock, G, P> Deref for ReadGuard<'_, R, G, P> {
+    type Target = G;
+
+    fn deref(&self) -> &G {
+        unsafe { &*self.lock.protected.get() }
+    }
+}
+
+impl<R: RawRwLock, G, P> Drop for ReadGuard<'_, R, G, P> {
+    fn drop(&mut self) {
+        if let Some(state) = self.state.take() {
+            unsafe { self.lock.raw.unlock_shared(state) }
+        }
+    }
+}
+
+/// Lock's two halves, for data that can't live in its lock: @G, reached only
+/// with that lock held, and @P, published - anyone's, it derefs to it. Which
+/// lock that is, only the owner of both knows: G is reached through the
+/// owner's methods, which check - here, only unsafely. Laid out as G then P,
+/// as Lock's are.
+#[repr(C)]
+pub struct LockedBy<G, P = ()> {
+    protected: UnsafeCell<G>,
+    published: P,
+}
+
+// As Lock's.
+unsafe impl<G: Send, P: Send> Send for LockedBy<G, P> {}
+unsafe impl<G: Send, P: Sync> Sync for LockedBy<G, P> {}
+
+// SAFETY: as each half
+unsafe impl<G: ::pin_init::Zeroable, P: ::pin_init::Zeroable> ::pin_init::Zeroable for LockedBy<G, P> {}
+
+impl<G, P> LockedBy<G, P> {
+    pub const fn new(protected: G, published: P) -> Self {
+        LockedBy { protected: UnsafeCell::new(protected), published }
+    }
+
+    /// # Safety
+    /// The lock that protects it is held, for as long as the reference
+    /// lives, and nothing has a &mut of it.
+    pub unsafe fn protected(&self) -> &G {
+        unsafe { &*self.protected.get() }
+    }
+
+    /// # Safety
+    /// The lock that protects it is held, for as long as the reference
+    /// lives, and nothing else refers to it.
+    pub unsafe fn protected_mut(&self) -> &mut G {
+        unsafe { &mut *self.protected.get() }
+    }
+}
+
+impl<G, P> Deref for LockedBy<G, P> {
+    type Target = P;
+
+    fn deref(&self) -> &P {
+        &self.published
+    }
+}
+
+// Opaque to TypeInfo, size only: G is the owner's to read.
+impl<G, P> crate::typeinfo::TypeInfo for LockedBy<G, P> {
+    const INFO: &'static crate::typeinfo::StructInfo = &crate::typeinfo::StructInfo {
+        name:   "LockedBy",
+        size:   core::mem::size_of::<Self>(),
+        shape:  crate::typeinfo::Shape::Struct,
+        fields: &[],
+    };
+}
+
+/// A Lock initializer - new_lock!(g), new_lock!(g, p), either with a "name"
+/// last - over @g, publishing @p or nothing, with a lockdep class of its own,
+/// named @name or for the call site. new_lock!(<- init), and
+/// new_lock!(<- init, p, "name"), initialize @g in place, by @init:
+/// Lock::new_init().
+#[macro_export]
+macro_rules! new_lock {
+    (@key) => {{
+        #[cfg(kernel)]
+        let key = ::kernel::static_lock_class!().as_ptr().cast();
+        #[cfg(not(kernel))]
+        let key = ::core::ptr::null_mut();
+        key
+    }};
+    (@init $g:expr, $p:expr, $name:expr) => {{
+        let key = $crate::new_lock!(@key);
+        let g = $g;
+        let p = $p;
+        let name = unsafe { ::core::ffi::CStr::from_bytes_with_nul_unchecked($name.as_bytes()) };
+        unsafe { $crate::locking::Lock::new(g, p, name, key) }
+    }};
+    (@init_in_place $g:expr, $p:expr, $name:expr) => {{
+        let key = $crate::new_lock!(@key);
+        let g = $g;
+        let p = $p;
+        let name = unsafe { ::core::ffi::CStr::from_bytes_with_nul_unchecked($name.as_bytes()) };
+        unsafe { $crate::locking::Lock::new_init(g, p, name, key) }
+    }};
+    (<- $g:expr $(,)?) => {
+        $crate::new_lock!(@init_in_place $g, (), ::core::concat!(::core::file!(), ":", ::core::line!(), "\0"))
+    };
+    (<- $g:expr, $p:expr, $name:literal $(,)?) => {
+        $crate::new_lock!(@init_in_place $g, $p, ::core::concat!($name, "\0"))
+    };
+    ($g:expr $(,)?) => {
+        $crate::new_lock!(@init $g, (), ::core::concat!(::core::file!(), ":", ::core::line!(), "\0"))
+    };
+    ($g:expr, $name:literal $(,)?) => {
+        $crate::new_lock!(@init $g, (), ::core::concat!($name, "\0"))
+    };
+    ($g:expr, $p:expr $(,)?) => {
+        $crate::new_lock!(@init $g, $p, ::core::concat!(::core::file!(), ":", ::core::line!(), "\0"))
+    };
+    ($g:expr, $p:expr, $name:literal $(,)?) => {
+        $crate::new_lock!(@init $g, $p, ::core::concat!($name, "\0"))
+    };
+}
diff --git a/fs/bcachefs/locking/locking.c b/fs/bcachefs/locking/locking.c
new file mode 100644
index 0000000..2186ed8
--- /dev/null
+++ b/fs/bcachefs/locking/locking.c
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: GPL-2.0
+
+/*
+ * The C that Rust's locks call (locking/): what C has as a macro - lockdep's
+ * classes and asserts, spin_lock_irqsave(), PF_MEMALLOC_NOIO - or as a static
+ * inline in one build or the other.
+ *
+ * A lock initialized from Rust has a lockdep class per call site, as C's
+ * init macros give theirs: Rust passes its own, @key.
+ *
+ * These are real (out-of-line) functions, not static inlines: both the fs and
+ * bch_bindgen bindgen passes see locking.h, and a static inline would have
+ * each emit its own wrap_static_fns wrapper for the same symbol - a duplicate
+ * at link. A plain declaration binds to one shared definition.
+ */
+
+#include "bcachefs.h"
+#include "locking/locking.h"
+
+/* noio.rs: the NOIO scope */
+
+unsigned int rust_memalloc_noio_save(void)
+{
+	return memalloc_flags_save(PF_MEMALLOC_NOIO);
+}
+
+void rust_memalloc_flags_restore(unsigned int flags)
+{
+	memalloc_flags_restore(flags);
+}
+
+/* raw.rs: struct mutex */
+
+void rust_mutex_init(struct mutex *lock, const char *name, void *key)
+{
+#ifdef __KERNEL__
+	__mutex_init(lock, name, key);
+#else
+	mutex_init(lock);
+#endif
+}
+
+void rust_mutex_assert_held(struct mutex *lock)
+{
+	lockdep_assert_held(lock);
+}
+
+/* raw.rs: spinlock_t, as the kernel's Rust helper initializes it */
+
+void rust_spin_lock_init(spinlock_t *lock, const char *name, void *key)
+{
+#if defined(__KERNEL__) && defined(CONFIG_DEBUG_SPINLOCK)
+# ifdef CONFIG_PREEMPT_RT
+	__spin_lock_init(lock, name, key, false);
+# else
+	__raw_spin_lock_init(spinlock_check(lock), name, key, LD_WAIT_CONFIG);
+# endif
+#else
+	spin_lock_init(lock);
+#endif
+}
+
+unsigned long rust_spin_lock_irqsave(spinlock_t *lock)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(lock, flags);
+	return flags;
+}
+
+void rust_spin_unlock_irqrestore(spinlock_t *lock, unsigned long flags)
+{
+	spin_unlock_irqrestore(lock, flags);
+}
+
+void rust_spin_lock_assert_held(spinlock_t *lock)
+{
+	lockdep_assert_held(lock);
+}
+
+/* raw.rs: rw_semaphore */
+
+void rust_init_rwsem(struct rw_semaphore *sem, const char *name, void *key)
+{
+#ifdef __KERNEL__
+	__init_rwsem(sem, name, key);
+#else
+	init_rwsem(sem);
+#endif
+}
+
+void rust_rwsem_assert_held(struct rw_semaphore *sem)
+{
+	lockdep_assert_held(sem);
+}
+
+void rust_rwsem_assert_held_write(struct rw_semaphore *sem)
+{
+	lockdep_assert_held_write(sem);
+}
+
+/* raw.rs: percpu_rw_semaphore */
+
+int rust_percpu_init_rwsem(struct percpu_rw_semaphore *sem, const char *name, void *key)
+{
+#ifdef __KERNEL__
+	return __percpu_init_rwsem(sem, name, key);
+#else
+	return percpu_init_rwsem(sem);
+#endif
+}
+
+void rust_percpu_free_rwsem(struct percpu_rw_semaphore *sem)
+{
+	percpu_free_rwsem(sem);
+}
+
+void rust_percpu_down_read(struct percpu_rw_semaphore *sem)
+{
+	percpu_down_read(sem);
+}
+
+void rust_percpu_up_read(struct percpu_rw_semaphore *sem)
+{
+	percpu_up_read(sem);
+}
+
+void rust_percpu_down_write(struct percpu_rw_semaphore *sem)
+{
+	percpu_down_write(sem);
+}
+
+void rust_percpu_up_write(struct percpu_rw_semaphore *sem)
+{
+	percpu_up_write(sem);
+}
+
+void rust_percpu_rwsem_assert_held(struct percpu_rw_semaphore *sem)
+{
+	percpu_rwsem_assert_held(sem);
+}
+
+void rust_percpu_rwsem_assert_held_write(struct percpu_rw_semaphore *sem)
+{
