+++ b/fs/bcachefs/locking/locking.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_LOCKING_H
+#define _BCACHEFS_LOCKING_H
+
+/*
+ * bcachefs's locks that hold a PF_MEMALLOC_NOIO scope while held - struct
+ * mutex_noio and percpu_rwsem_noio, Rust's Noio<R> (locking/noio.rs) - and
+ * their guards, which save the flags before the lock is taken and restore them
+ * after it's released, as Rust's do.
+ */
+
+#include <linux/cleanup.h>
+#include <linux/mutex.h>
+#include <linux/percpu-rwsem.h>
+#include <linux/sched/mm.h>
+
+#include "locking/bytelock_gen.h"
+#include "locking/noio_gen.h"
+#include "locking/raw_gen.h"
+
+static inline void mutex_noio_init(struct mutex_noio *m)
+{
+	mutex_init(&m->lock);
+}
+
+DEFINE_LOCK_GUARD_1(mutex_noio, struct mutex_noio,
+		    _T->flags = memalloc_flags_save(PF_MEMALLOC_NOIO); mutex_lock(&_T->lock->lock),
+		    mutex_unlock(&_T->lock->lock); memalloc_flags_restore(_T->flags),
+		    unsigned int flags)
+
+DEFINE_LOCK_GUARD_1(percpu_read_noio, struct percpu_rwsem_noio,
+		    _T->flags = memalloc_flags_save(PF_MEMALLOC_NOIO); percpu_down_read(&_T->lock->lock),
+		    percpu_up_read(&_T->lock->lock); memalloc_flags_restore(_T->flags),
+		    unsigned int flags)
+
+DEFINE_LOCK_GUARD_1(percpu_write_noio, struct percpu_rwsem_noio,
+		    _T->flags = memalloc_flags_save(PF_MEMALLOC_NOIO); percpu_down_write(&_T->lock->lock),
+		    percpu_up_write(&_T->lock->lock); memalloc_flags_restore(_T->flags),
+		    unsigned int flags)
+
+#endif /* _BCACHEFS_LOCKING_H */
diff --git a/fs/bcachefs/locking/mod.rs b/fs/bcachefs/locking/mod.rs
new file mode 100644
index 0000000..5c9bb1c
--- /dev/null
+++ b/fs/bcachefs/locking/mod.rs
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Locks.
+//!
+//! A lock is C's lock state - struct mutex, spinlock_t, rw_semaphore,
+//! percpu_rw_semaphore - and that's all it is: RawLock (lock.rs) is how one is
+//! initialized, taken and released, implemented on C's types themselves
+//! (raw.rs), in both builds. Lock<R, G, P> is lock R and the things it
+//! protects: G, reached only with it held - its guard derefs to it - and P,
+//! published: read by anyone, held or not - the lock derefs to it - and
+//! written only by its holder. A plain mutex over a T is Lock<c::mutex, T>;
+//! readers share a RawRwLock's, through read(). LockedBy<G, P> is the same two
+//! halves where they can't be in the lock: spread through the objects the
+//! lock's owner reaches, and reached through it.
+//!
+//! Noio<R> (noio.rs) is any lock, held in a PF_MEMALLOC_NOIO scope - itself
+//! a RawLock, C's struct mutex_noio when R is a mutex. A seqmutex
+//! (seqmutex.rs) is a mutex that can be dropped and taken back only if no one
+//! took it meanwhile. SeqLock (seqlock.rs) and ByteLock (bytelock.rs) have no
+//! C state: atomics - SeqLock's readers copying out, ByteLock a sleeping lock
+//! in one byte, on util/futex.rs.
+//!
+//! compat.rs is what exists because C owns the lock or holds it calling in,
+//! and goes as the C does.
+//!
+//! Initializing a lock in place, new_lock!(), gives it a lockdep class of
+//! its own: one per call site, as C's mutex_init() is.
+//!
+//! The C side: locking.h, C's guards for the noio locks; seqmutex.h, C's
+//! seqmutex API; locking.c, the C that Rust calls where C has a macro, or a
+//! static inline in one build or the other.
+
+pub mod bytelock;
+mod compat;
+mod lock;
+mod noio;
+mod raw;
+mod seqlock;
+pub mod seqmutex;
+
+pub use crate::new_lock;
+pub use bytelock::ByteLock;
+pub use raw::{mutex, percpu_rw_semaphore, rw_semaphore, spinlock_t};
+pub use lock::{Guard, Lock, LockedBy, RawLock, RawNestedLock, RawRwLock, RawTryLock, ReadGuard};
+pub use noio::{mutex_noio, percpu_rwsem_noio, MemallocFlags, MutexNoio, Noio, PercpuRwsemNoio};
+pub use seqlock::SeqLock;
+pub use seqmutex::SeqMutexSeq;
diff --git a/fs/bcachefs/locking/noio.rs b/fs/bcachefs/locking/noio.rs
new file mode 100644
index 0000000..b82ad00
--- /dev/null
+++ b/fs/bcachefs/locking/noio.rs
@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! NOIO: a memory-reclaim scope, and the locks that hold one.
+//!
+//! bcachefs holds a PF_MEMALLOC_NOIO scope with certain locks, so what's
+//! allocated under them can't recurse into reclaim IO - a filesystem driving
+//! the block layer directly mustn't let reclaim loop back through the device
+//! it's allocating for. sb_lock above all: pairing each such lock with a
+//! separate guard(memalloc_flags)(PF_MEMALLOC_NOIO) is easy to forget, and
+//! was, on many sb_lock sites - so the scope is the lock's: holding it _is_
+//! the NOIO context, and you can't take it without.
+//!
+//! Noio<R> is any lock R, taken that way: a RawLock that saves the memalloc
+//! flags, then takes R - and releases R, then restores them. Laid out as R,
+//! so Noio<c::mutex> is C's struct mutex_noio and Noio<c::percpu_rw_semaphore>
+//! its struct percpu_rwsem_noio, which C's guards take the same way
+//! (locking.h).
+//!
+//! MemallocFlags is the scope alone - saved on construction, restored on
+//! drop, as memalloc_flags_save() and _restore() pair: scoped (LIFO) use
+//! only. The flag itself stays on the C side (locking.c): the
+//! PF_MEMALLOC_* #defines don't reach Rust.
+
+#![allow(non_camel_case_types)]
+
+use super::{Lock, RawLock, RawRwLock, RawTryLock};
+use crate::cstructs::c;
+use crate::types::c_default;
+use core::ffi::{c_uint, c_void, CStr};
+use cstruct_macros::{c_extern, c_verbatim};
+
+c_extern! {
+    pub fn rust_memalloc_noio_save() -> c_uint;
+    pub fn rust_memalloc_flags_restore(flags: c_uint);
+}
+
+/// A PF_MEMALLOC_NOIO scope: allocations may not recurse into reclaim IO
+/// until it's dropped, which restores the flags it saved.
+#[must_use = "the memalloc scope ends as soon as the guard is dropped"]
+pub struct MemallocFlags {
+    saved: u32,
+}
+
+impl MemallocFlags {
+    pub fn noio() -> Self {
+        Self { saved: unsafe { rust_memalloc_noio_save() } }
+    }
+}
+
+impl Drop for MemallocFlags {
+    fn drop(&mut self) {
+        unsafe { rust_memalloc_flags_restore(self.saved) }
+    }
+}
+
+/// Lock @R, held in a PF_MEMALLOC_NOIO scope: the flags are saved before
+/// it's taken, and restored after it's released.
+#[repr(transparent)]
+pub struct Noio<R>(R);
+
+unsafe impl<R: RawLock> RawLock for Noio<R> {
+    type GuardState = (MemallocFlags, R::GuardState);
+    type InitError = R::InitError;
+
+    unsafe fn init(l: *mut Self, name: &'static CStr, key: *mut c_void) -> Result<(), R::InitError> {
+        unsafe { R::init(l.cast(), name, key) }
+    }
+
+    unsafe fn lock(&self) -> Self::GuardState {
+        let noio = MemallocFlags::noio();
+        (noio, unsafe { self.0.lock() })
+    }
+
+    unsafe fn unlock(&self, (noio, g): Self::GuardState) {
+        unsafe { self.0.unlock(g) };
+        drop(noio);
+    }
+
+    unsafe fn assert_held(&self) {
+        unsafe { self.0.assert_held() }
+    }
+
+    unsafe fn destroy(&self) {
+        unsafe { self.0.destroy() }
+    }
+}
+
+unsafe impl<R: RawTryLock> RawTryLock for Noio<R> {
+    unsafe fn try_lock(&self) -> Option<Self::GuardState> {
+        // not taken: dropped, so restored
+        let noio = MemallocFlags::noio();
+        Some((noio, unsafe { self.0.try_lock() }?))
+    }
+}
+
+unsafe impl<R: RawRwLock> RawRwLock for Noio<R> {
+    unsafe fn lock_shared(&self) -> Self::GuardState {
+        let noio = MemallocFlags::noio();
+        (noio, unsafe { self.0.lock_shared() })
+    }
+
+    unsafe fn unlock_shared(&self, (noio, g): Self::GuardState) {
+        unsafe { self.0.unlock_shared(g) };
+        drop(noio);
+    }
+
+    unsafe fn assert_held_any(&self) {
+        unsafe { self.0.assert_held_any() }
+    }
+}
+
+unsafe impl<R: ::pin_init::Zeroable> ::pin_init::Zeroable for Noio<R> {}
+
+/// C's struct mutex_noio and percpu_rwsem_noio, declared for C below.
+pub type mutex_noio = Noio<c::mutex>;
+pub type percpu_rwsem_noio = Noio<c::percpu_rw_semaphore>;
+
+c_default!(mutex_noio);
+c_default!(percpu_rwsem_noio);
+
+/// Locks over @G held in a NOIO scope: C's mutex_noio and percpu_rwsem_noio,
+/// and what they protect.
+pub type MutexNoio<G = (), P = ()> = Lock<mutex_noio, G, P>;
+pub type PercpuRwsemNoio<G = (), P = ()> = Lock<percpu_rwsem_noio, G, P>;
+
+c_verbatim!(r#"
+/*
+ * Guard-only by design. The saved memalloc flags live in the guard object, so
+ * a raw lock/unlock pair would have nowhere to stash them; scoped use also
+ * guarantees the LIFO nesting that memalloc_flags_save/restore require. Use
+ * guard(mutex_noio)(&m) or scoped_guard(mutex_noio, &m).
+ */
+struct mutex_noio {
+	struct mutex		lock;
+};
+
+/*
+ * For rwsems like capacity.mark_lock that are taken over allocating work.
+ * Guards mirror the kernel's percpu_read/percpu_write, with _noio.
+ *
+ * A few hot paths take the lock raw (percpu_down_read on the inner
+ * percpu_rw_semaphore) rather than via the guard - that's sound only where the
+ * caller is already in a NOIO context (e.g. holding a locked btree_trans);
+ * such sites reach through .lock with a comment saying why.
+ */
+struct percpu_rwsem_noio {
+	struct percpu_rw_semaphore lock;
+};
+"#);
diff --git a/fs/bcachefs/locking/raw.rs b/fs/bcachefs/locking/raw.rs
new file mode 100644
index 0000000..da48020
--- /dev/null
+++ b/fs/bcachefs/locking/raw.rs
@@ -0,0 +1,217 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! C's locks, as RawLocks: struct mutex, spinlock_t (taken irqsave),
+//! rw_semaphore and percpu_rw_semaphore - in both builds, the shim's
+//! pthread-backed ones in userspace.
+//!
+//! Each is C's struct in an Opaque - an UnsafeCell, so it's written through
+//! a shared reference: by whoever takes it, Rust or C. c::mutex and the rest
+//! are these, over the bindings' (cstructs.rs), so the structs C shares hold
+//! them as written - and Lock::from_c() borrows one soundly.
+//!
+//! What C has as a macro or a static inline in one build or the other -
+//! initializing in a lockdep class, lockdep's asserts, spin_lock_irqsave() -
+//! Rust calls through locking.c's rust_* functions.
+
+#![allow(non_camel_case_types)]
+
+use super::RawLock;
+use super::RawRwLock;
+use super::{RawNestedLock, RawTryLock};
+use crate::c;
+use crate::errcode::{ret_to_result_void, BchError};
+use crate::util::ffi::{c_char, Opaque};
+use core::convert::Infallible;
+use core::ffi::{c_int, c_ulong, c_void, CStr};
+use cstruct_macros::c_extern;
+
+#[cfg(kernel)]
+use kernel::bindings as b;
+#[cfg(not(kernel))]
+use bcachefs_shim::c as b;
+
+pub type mutex = Opaque<b::mutex>;
+pub type spinlock_t = Opaque<b::spinlock_t>;
+pub type rw_semaphore = Opaque<b::rw_semaphore>;
+pub type percpu_rw_semaphore = Opaque<b::percpu_rw_semaphore>;
+
+// Zeroed as the structs holding them start; a lock only once their init runs
+unsafe impl ::pin_init::Zeroable for mutex {}
+unsafe impl ::pin_init::Zeroable for spinlock_t {}
+unsafe impl ::pin_init::Zeroable for rw_semaphore {}
+unsafe impl ::pin_init::Zeroable for percpu_rw_semaphore {}
+
+c_extern! {
+    pub fn rust_mutex_init(lock: *mut c::mutex, name: *const c_char, key: *mut c_void);
+    pub fn rust_mutex_assert_held(lock: *mut c::mutex);
+
+    pub fn rust_spin_lock_init(lock: *mut c::spinlock_t, name: *const c_char, key: *mut c_void);
+    pub fn rust_spin_lock_irqsave(lock: *mut c::spinlock_t) -> c_ulong;
+    pub fn rust_spin_unlock_irqrestore(lock: *mut c::spinlock_t, flags: c_ulong);
+    pub fn rust_spin_lock_assert_held(lock: *mut c::spinlock_t);
+
+    pub fn rust_init_rwsem(sem: *mut c::rw_semaphore, name: *const c_char, key: *mut c_void);
+    pub fn rust_rwsem_assert_held(sem: *mut c::rw_semaphore);
+    pub fn rust_rwsem_assert_held_write(sem: *mut c::rw_semaphore);
+
+    pub fn rust_percpu_init_rwsem(sem: *mut c::percpu_rw_semaphore, name: *const c_char,
+                                  key: *mut c_void) -> c_int;
+    pub fn rust_percpu_free_rwsem(sem: *mut c::percpu_rw_semaphore);
+    pub fn rust_percpu_down_read(sem: *mut c::percpu_rw_semaphore);
+    pub fn rust_percpu_up_read(sem: *mut c::percpu_rw_semaphore);
+    pub fn rust_percpu_down_write(sem: *mut c::percpu_rw_semaphore);
+    pub fn rust_percpu_up_write(sem: *mut c::percpu_rw_semaphore);
+    pub fn rust_percpu_rwsem_assert_held(sem: *mut c::percpu_rw_semaphore);
+    pub fn rust_percpu_rwsem_assert_held_write(sem: *mut c::percpu_rw_semaphore);
+}
+
+// ── struct mutex ─────────────────────────────────────────────────────────
+
+unsafe impl RawLock for c::mutex {
+    type GuardState = ();
+    type InitError = Infallible;
+
+    unsafe fn init(l: *mut Self, name: &'static CStr, key: *mut c_void) -> Result<(), Infallible> {
+        unsafe { rust_mutex_init(l, name.as_ptr().cast(), key) };
+        Ok(())
+    }
+
+    unsafe fn lock(&self) {
+        unsafe { c::mutex_lock(self.as_ptr().cast()) }
+    }
+
+    unsafe fn unlock(&self, _: ()) {
+        unsafe { c::mutex_unlock(self.as_ptr().cast()) }
+    }
+
+    unsafe fn assert_held(&self) {
+        unsafe { rust_mutex_assert_held(self.as_ptr().cast()) }
+    }
+}
+
+unsafe impl RawTryLock for c::mutex {
+    unsafe fn try_lock(&self) -> Option<()> {
+        (unsafe { c::mutex_trylock(self.as_ptr().cast()) } as i32 != 0).then_some(())
+    }
+}
+
+// Without lockdep's lock tracking, mutex_lock_nested() is a macro, mutex_lock()
+unsafe impl RawNestedLock for c::mutex {
+    #[cfg(CONFIG_DEBUG_LOCK_ALLOC)]
+    unsafe fn lock_nested(&self, subclass: u32) {
+        unsafe { c::mutex_lock_nested(self.as_ptr().cast(), subclass) }
+    }
+
+    #[cfg(not(CONFIG_DEBUG_LOCK_ALLOC))]
+    unsafe fn lock_nested(&self, _subclass: u32) {
+        unsafe { self.lock() }
+    }
+}
+
+// ── spinlock_t, taken irqsave ────────────────────────────────────────────
+
+// Taken with interrupts off - spin_lock_irqsave() - for what interrupt
+// context takes too, an endio; held, it mustn't sleep. The kernel crate's
+// SpinLock leaves interrupts on. In userspace, where there are no
+// interrupts, it's the shim's spinlock, a pthread mutex.
+unsafe impl RawLock for c::spinlock_t {
+    type GuardState = c_ulong;
+    type InitError = Infallible;
+
+    unsafe fn init(l: *mut Self, name: &'static CStr, key: *mut c_void) -> Result<(), Infallible> {
+        unsafe { rust_spin_lock_init(l, name.as_ptr().cast(), key) };
+        Ok(())
+    }
+
+    unsafe fn lock(&self) -> c_ulong {
+        unsafe { rust_spin_lock_irqsave(self.as_ptr().cast()) }
+    }
+
+    unsafe fn unlock(&self, flags: c_ulong) {
+        unsafe { rust_spin_unlock_irqrestore(self.as_ptr().cast(), flags) }
+    }
+
+    unsafe fn assert_held(&self) {
+        unsafe { rust_spin_lock_assert_held(self.as_ptr().cast()) }
+    }
+}
+
+// ── rw_semaphore ─────────────────────────────────────────────────────────
+
+unsafe impl RawLock for c::rw_semaphore {
+    type GuardState = ();
+    type InitError = Infallible;
+
+    unsafe fn init(l: *mut Self, name: &'static CStr, key: *mut c_void) -> Result<(), Infallible> {
+        unsafe { rust_init_rwsem(l, name.as_ptr().cast(), key) };
+        Ok(())
+    }
+
+    unsafe fn lock(&self) {
+        unsafe { c::down_write(self.as_ptr().cast()) }
+    }
+
+    unsafe fn unlock(&self, _: ()) {
+        unsafe { c::up_write(self.as_ptr().cast()) }
+    }
+
+    unsafe fn assert_held(&self) {
+        unsafe { rust_rwsem_assert_held_write(self.as_ptr().cast()) }
+    }
+}
+
+unsafe impl RawRwLock for c::rw_semaphore {
+    unsafe fn lock_shared(&self) {
+        unsafe { c::down_read(self.as_ptr().cast()) }
+    }
+
+    unsafe fn unlock_shared(&self, _: ()) {
+        unsafe { c::up_read(self.as_ptr().cast()) }
+    }
+
+    unsafe fn assert_held_any(&self) {
+        unsafe { rust_rwsem_assert_held(self.as_ptr().cast()) }
+    }
+}
+
+// ── percpu_rw_semaphore ──────────────────────────────────────────────────
+
+unsafe impl RawLock for c::percpu_rw_semaphore {
+    type GuardState = ();
+    /// The per-CPU counts couldn't be allocated
+    type InitError = BchError;
+
+    unsafe fn init(l: *mut Self, name: &'static CStr, key: *mut c_void) -> Result<(), BchError> {
+        ret_to_result_void(unsafe { rust_percpu_init_rwsem(l, name.as_ptr().cast(), key) })
+    }
+
+    unsafe fn lock(&self) {
+        unsafe { rust_percpu_down_write(self.as_ptr().cast()) }
+    }
+
+    unsafe fn unlock(&self, _: ()) {
+        unsafe { rust_percpu_up_write(self.as_ptr().cast()) }
+    }
+
+    unsafe fn assert_held(&self) {
+        unsafe { rust_percpu_rwsem_assert_held_write(self.as_ptr().cast()) }
+    }
+
+    unsafe fn destroy(&self) {
+        unsafe { rust_percpu_free_rwsem(self.as_ptr().cast()) }
+    }
+}
+
+unsafe impl RawRwLock for c::percpu_rw_semaphore {
+    unsafe fn lock_shared(&self) {
+        unsafe { rust_percpu_down_read(self.as_ptr().cast()) }
+    }
+
+    unsafe fn unlock_shared(&self, _: ()) {
+        unsafe { rust_percpu_up_read(self.as_ptr().cast()) }
+    }
+
+    unsafe fn assert_held_any(&self) {
+        unsafe { rust_percpu_rwsem_assert_held(self.as_ptr().cast()) }
+    }
+}
diff --git a/fs/bcachefs/locking/seqlock.rs b/fs/bcachefs/locking/seqlock.rs
new file mode 100644
index 0000000..e1e242e
--- /dev/null
+++ b/fs/bcachefs/locking/seqlock.rs
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! SeqLock: ours in both builds - the kernel crate has none - and only
+//! atomics, with no C lock under it.
+
+use core::cell::UnsafeCell;
+use core::hint::spin_loop;
+use core::mem::MaybeUninit;
+use core::sync::atomic::{fence, AtomicU32, Ordering};
+
+use crate::util::percpu::CpuGuard;
+
+/// A sequence lock over a T: readers copy the value out without taking
+/// anything, and retry a copy a write overlapped; writers have it alone.
+/// For small state read rarely and written often - a progress indicator
+/// sysfs shows while its work updates it.
+///
+/// The sequence is odd while a write is in progress: taking it from even
+/// to odd is the writers' lock, so there's no lock besides it, and a
+/// second writer spins. A write nested in a write deadlocks.
+///
+/// The reader's copy races with the writer's stores, as C's seqcount
+/// readers' do: it's volatile - the kernel's READ_ONCE() - into a
+/// MaybeUninit, and becomes a T only once the sequence says no write
+/// overlapped it, so a torn copy (half a bbpos, a bool mid-store) is
+/// never a T at all. Rust's memory model would want atomic word-by-word
+/// copies for that race; the kernel's, which this follows, doesn't.
+#[repr(C)]
+pub struct SeqLock<T: Copy> {
+    seq:  AtomicU32,
+    data: UnsafeCell<T>,
+}
+
+// SAFETY: a reader gets a copy of the T, on any thread - T: Send; the T
+// itself is only ever mutated by the one writer.
+unsafe impl<T: Copy + Send> Sync for SeqLock<T> {}
+
+// SAFETY: a zero sequence is even - unlocked - and a zeroed T is a T.
+unsafe impl<T: Copy + ::pin_init::Zeroable> ::pin_init::Zeroable for SeqLock<T> {}
+
+impl<T: Copy> SeqLock<T> {
+    pub const fn new(v: T) -> Self {
+        Self { seq: AtomicU32::new(0), data: UnsafeCell::new(v) }
+    }
+
+    /// The value, as of the last write to finish.
+    pub fn read(&self) -> T {
+        loop {
+            let seq = self.seq.load(Ordering::Acquire);
+            if seq & 1 != 0 {
+                spin_loop();
+                continue;
+            }
+
+            // SAFETY: valid for reads; any bytes are a MaybeUninit
+            let v = unsafe { self.data.get().cast::<MaybeUninit<T>>().read_volatile() };
+
+            fence(Ordering::Acquire);
+            if self.seq.load(Ordering::Relaxed) == seq {
+                // SAFETY: no write overlapped the copy - it's a T, as the
+                // last write left it
+                return unsafe { v.assume_init() };
+            }
+        }
+    }
+
+    /// @f on the value, readers held off - shown what @f leaves, once it
+    /// returns. A panic in @f leaves the sequence odd: write-held, so
+    /// readers spin on it for good.
+    ///
+    /// With preemption off, as C's seqcount writers are: readers spin on an
+    /// odd sequence, and one that can't be preempted - under a spinlock, in
+    /// softirq - spinning on a writer preempted on its CPU never stops. So
+    /// @f mustn't sleep.
+    pub fn write<R>(&self, f: impl FnOnce(&mut T) -> R) -> R {
+        let _cpu = CpuGuard::new();
+
+        let mut seq = self.seq.load(Ordering::Relaxed);
+        loop {
+            if seq & 1 != 0 {
+                spin_loop();
+                seq = self.seq.load(Ordering::Relaxed);
+                continue;
+            }
+            match self.seq.compare_exchange_weak(seq, seq.wrapping_add(1),
+                                                 Ordering::Acquire, Ordering::Relaxed) {
+                Ok(_)    => break,
+                Err(now) => seq = now,
+            }
+        }
+        // The odd sequence, before any of the value's stores:
+        fence(Ordering::Release);
+
+        // SAFETY: the odd sequence is ours - no other writer; readers
+        // discard what they copy meanwhile
+        let ret = f(unsafe { &mut *self.data.get() });
+
+        self.seq.store(seq.wrapping_add(2), Ordering::Release);
+        ret
+    }
+}
+
+// A torn read is silent - a copy that's half one write and half another -
+// so: a writer keeps both halves equal, readers check every copy.
+#[cfg(test)]
+mod tests {
+    use super::SeqLock;
+    use std::sync::atomic::{AtomicBool, Ordering};
+
+    #[test]
+    fn no_torn_reads() {
+        let l = SeqLock::new([0u64; 4]);
+        let done = AtomicBool::new(false);
+
+        std::thread::scope(|s| {
+            for _ in 0..3 {
+                s.spawn(|| {
+                    let mut reads = 0u64;
+                    while !done.load(Ordering::Relaxed) || reads < 1000 {
+                        let v = l.read();
+                        assert!(v.iter().all(|&x| x == v[0]), "torn read: {v:?}");
+                        reads += 1;
+                    }
+                });
+            }
+            let writers: Vec<_> = (0..2).map(|_| s.spawn(|| {
+                for i in 0..200_000u64 {
+                    l.write(|v| *v = [i; 4]);
+                }
+            })).collect();
+            writers.into_iter().for_each(|w| w.join().unwrap());
+            done.store(true, Ordering::Relaxed);
+        });
+    }
+}
diff --git a/fs/bcachefs/locking/seqmutex.h b/fs/bcachefs/locking/seqmutex.h
new file mode 100644
index 0000000..1822da9
--- /dev/null
+++ b/fs/bcachefs/locking/seqmutex.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_SEQMUTEX_H
+#define _BCACHEFS_SEQMUTEX_H
+
+#include <linux/mutex.h>
+
+#include "locking/seqmutex_gen.h"
+
+#define seqmutex_init(_lock)	mutex_init(&(_lock)->lock)
+
+static inline bool seqmutex_trylock(struct seqmutex *lock)
+{
+	return mutex_trylock(&lock->lock);
+}
+
+static inline void seqmutex_lock(struct seqmutex *lock)
+{
+	mutex_lock(&lock->lock);
+	lock->seq++;
+}
+
+static inline u32 seqmutex_unlock(struct seqmutex *lock)
+{
+	u32 seq = lock->seq;
+	mutex_unlock(&lock->lock);
+	return seq;
+}
+
+static inline bool seqmutex_relock(struct seqmutex *lock, u32 seq)
+{
+	if (lock->seq != seq || !mutex_trylock(&lock->lock))
+		return false;
+
+	if (lock->seq != seq) {
+		mutex_unlock(&lock->lock);
+		return false;
+	}
+
+	return true;
+}
+
+#endif /* _BCACHEFS_SEQMUTEX_H */
diff --git a/fs/bcachefs/locking/seqmutex.rs b/fs/bcachefs/locking/seqmutex.rs
new file mode 100644
index 0000000..e553f0b
--- /dev/null
+++ b/fs/bcachefs/locking/seqmutex.rs
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A seqmutex: a mutex, and a count of the times it's been taken - so a
+//! holder can drop it and take it back only if no one else took it
+//! meanwhile, relock(). C's struct, with C's API in seqmutex.h. C reads the
+//! count plainly, outside the lock; Rust, as an atomic.
+
+#![allow(non_camel_case_types)]
+
+use super::{Guard, Lock, RawLock, RawTryLock};
+use crate::cstructs::c;
+use crate::types::c_default;
+use core::convert::Infallible;
+use core::ffi::{c_void, CStr};
+use core::sync::atomic::{AtomicU32, Ordering};
+use cstruct_macros::CStruct;
+
+#[repr(C)]
+#[derive(CStruct)]
+pub struct seqmutex {
+    pub lock: c::mutex,
+    /* C writes it under the mutex */
+    #[c("u32 seq")]
+    pub seq:  AtomicU32,
+}
+c_default!(seqmutex);
+
+unsafe impl RawLock for seqmutex {
+    type GuardState = ();
+    type InitError = Infallible;
+
+    unsafe fn init(l: *mut Self, name: &'static CStr, key: *mut c_void) -> Result<(), Infallible> {
+        unsafe {
+            (&raw mut (*l).seq).write(AtomicU32::new(0));
+            c::mutex::init(&raw mut (*l).lock, name, key)
+        }
+    }
+
+    unsafe fn lock(&self) {
+        unsafe { self.lock.lock() };
+        self.seq.fetch_add(1, Ordering::Relaxed);
+    }
+
+    unsafe fn unlock(&self, _: ()) {
+        unsafe { self.lock.unlock(()) }
+    }
+
+    unsafe fn assert_held(&self) {
+        unsafe { self.lock.assert_held() }
+    }
+}
+
+/// What relock() takes: the count at an unlock.
+pub struct SeqMutexSeq(u32);
+
+impl<G, P> Lock<seqmutex, G, P> {
+    /// Held again, if no one has taken it since the unlock that gave @at.
+    pub fn relock(&self, at: SeqMutexSeq) -> Option<Guard<'_, seqmutex, G, P>> {
+        let l = self.raw();
+        if l.seq.load(Ordering::Relaxed) != at.0 {
+            return None;
+        }
+
+        // retaken, not counted: no one else has taken it
+        unsafe { l.lock.try_lock() }?;
+        let g = unsafe { Guard::from_held(self, Some(())) };
+
+        if l.seq.load(Ordering::Relaxed) != at.0 {
+            return None;    // unlocked, as the guard drops
+        }
+        Some(g)
+    }
+}
+
+impl<G, P> Guard<'_, seqmutex, G, P> {
+    /// Released, with the count relock() takes.
+    pub fn unlock(self) -> SeqMutexSeq {
+        SeqMutexSeq(self.lock().raw().seq.load(Ordering::Relaxed))
+    }
+}
