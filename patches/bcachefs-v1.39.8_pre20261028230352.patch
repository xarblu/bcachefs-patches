index 0000000..5c21081
--- /dev/null
+++ b/fs/bcachefs/util/darray.c
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/log2.h>
+#include <linux/rcupdate.h>
+#include <linux/slab.h>
+#include <linux/version.h>
+#include <linux/vmalloc.h>
+#include "darray.h"
+
+int __bch2_darray_resize_noprof(darray_char *d, size_t element_size, size_t new_size, gfp_t gfp,
+				bool rcu, bool have_prealloc)
+{
+	if (new_size > d->size) {
+		new_size = roundup_pow_of_two(new_size);
+
+		/*
+		 * This is a workaround: kvmalloc() doesn't support > INT_MAX
+		 * allocations, but vmalloc() does.
+		 * The limit needs to be lifted from kvmalloc, and when it does
+		 * we'll go back to just using that.
+		 */
+		size_t bytes;
+		if (unlikely(check_mul_overflow(new_size, element_size, &bytes)))
+			return -ENOMEM;
+
+		void *old = d->data;
+#if defined(__KERNEL__) && LINUX_VERSION_CODE < KERNEL_VERSION(6,18,0)
+		void *new = likely(bytes < INT_MAX)
+			? kvmalloc_noprof(bytes, gfp)
+			: vmalloc_noprof(bytes);
+#else
+		void *new = likely(bytes < INT_MAX)
+			? kvmalloc_node_align_noprof(bytes, 1, gfp, NUMA_NO_NODE)
+			: vmalloc_noprof(bytes);
+#endif
+		if (!new)
+			return -ENOMEM;
+
+		if (d->size)
+			memcpy(new, old, d->size * element_size);
+
+		rcu_assign_pointer(d->data, new);
+		d->size = new_size;
+
+		if (!have_prealloc || old != d->preallocated) {
+			if (!rcu)
+				kvfree(old);
+			else
+				kvfree_rcu_mightsleep(old);
+		}
+	}
+
+	return 0;
+}
diff --git a/fs/bcachefs/util/darray.h b/fs/bcachefs/util/darray.h
new file mode 100644
index 0000000..b85b37f
--- /dev/null
+++ b/fs/bcachefs/util/darray.h
@@ -0,0 +1,193 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_DARRAY_H
+#define _BCACHEFS_DARRAY_H
+
+/*
+ * Dynamic arrays:
+ *
+ * Inspired by CCAN's darray
+ */
+
+#include <linux/cleanup.h>
+#include <linux/slab.h>
+
+#define DARRAY_PREALLOCATED(_type, _nr)					\
+struct {								\
+	size_t nr, size;						\
+	_type *data;							\
+	_type preallocated[_nr];					\
+}
+
+#define DARRAY(_type) DARRAY_PREALLOCATED(_type, 0)
+
+#define __darray_for_each(_d, _i)					\
+	for ((_i) = (_d).data; _i < (_d).data + (_d).nr; _i++)
+
+#define darray_for_each_from(_d, _i, _start)					\
+	for (typeof(&(_d).data[0]) _i = _start; _i < (_d).data + (_d).nr; _i++)
+
+#define darray_for_each(_d, _i)						\
+	darray_for_each_from(_d, _i, (_d).data)
+
+#define darray_for_each_max(_d, _i, _nr)					\
+	for (typeof(&(_d).data[0]) _i = (_d).data; _i < (_d).data + min(_nr, (_d).nr); _i++)
+
+#define darray_for_each_reverse(_d, _i)					\
+	for (typeof(&(_d).data[0]) _i = (_d).data + (_d).nr - 1; _i >= (_d).data && (_d).nr; --_i)
+
+#define darray_init(_d)							\
+do {									\
+	(_d)->nr = 0;							\
+	(_d)->size = ARRAY_SIZE((_d)->preallocated);			\
+	(_d)->data = (_d)->size ? (_d)->preallocated : NULL;		\
+} while (0)
+
+#define darray_exit(_d)							\
+do {									\
+	if (!ARRAY_SIZE((_d)->preallocated) ||				\
+	    (_d)->data != (_d)->preallocated)				\
+		kvfree((_d)->data);					\
+	darray_init(_d);						\
+} while (0)
+
+#define darray_exit_free_item(_d, _free)				\
+do {									\
+	darray_for_each(*(_d), i)					\
+		_free(*i);						\
+	if (!ARRAY_SIZE((_d)->preallocated) ||				\
+	    (_d)->data != (_d)->preallocated)				\
+		kvfree((_d)->data);					\
+	darray_init(_d);						\
+} while (0)
+
+#define DEFINE_DARRAY_CLASS(_type)					\
+DEFINE_CLASS(_type, _type, darray_exit(&(_T)), (_type) {}, void)
+
+#define DEFINE_DARRAY_CLASS_FREE_ITEM(_type, _free)		\
+DEFINE_CLASS(_type, _type, darray_exit_free_item(&(_T), _free), (_type) {}, void)
+
+#define DEFINE_DARRAY_NAMED(_name, _type)				\
+typedef DARRAY(_type)	_name;						\
+DEFINE_DARRAY_CLASS(_name)
+
+#define DEFINE_DARRAY(_type)	DEFINE_DARRAY_NAMED(darray_##_type, _type)
+
+#define DEFINE_DARRAY_PREALLOCATED(_type, _nr)				\
+typedef DARRAY_PREALLOCATED(_type, _nr)	darray_##_type;			\
+DEFINE_DARRAY_CLASS(darray_##_type)
+
+#define DEFINE_DARRAY_NAMED_FREE_ITEM(_name, _type, _free)		\
+typedef DARRAY(_type)	_name;						\
+DEFINE_DARRAY_CLASS_FREE_ITEM(_name, _free)
+
+#define DEFINE_DARRAY_FREE_ITEM(_type, _free)				\
+DEFINE_DARRAY_NAMED_FREE_ITEM(darray_##_type, _type, _free)
+
+DEFINE_DARRAY(char);
+DEFINE_DARRAY(u8)
+DEFINE_DARRAY(u16)
+DEFINE_DARRAY(u32)
+DEFINE_DARRAY(u64)
+
+DEFINE_DARRAY(s8)
+DEFINE_DARRAY(s16)
+DEFINE_DARRAY(s32)
+DEFINE_DARRAY(s64)
+
+DEFINE_DARRAY_NAMED_FREE_ITEM(darray_str, char *, kfree);
+DEFINE_DARRAY_NAMED_FREE_ITEM(darray_const_str, const char *, kfree);
+
+int __bch2_darray_resize_noprof(darray_char *, size_t, size_t, gfp_t, bool, bool);
+
+#define __bch2_darray_resize(...)	alloc_hooks(__bch2_darray_resize_noprof(__VA_ARGS__))
+
+#define __darray_resize(_d, _new_size, _gfp, _rcu)			\
+	(unlikely((_new_size) > (_d)->size)				\
+	 ? __bch2_darray_resize((darray_char *) (_d),			\
+				sizeof((_d)->data[0]),			\
+				(_new_size), (_gfp), _rcu,		\
+				!!ARRAY_SIZE((_d)->preallocated))	\
+	 : 0)
+
+#define darray_resize_gfp(_d, _new_size, _gfp)				\
+	__darray_resize((_d), (_new_size), _gfp, false)
+
+#define darray_resize(_d, _new_size)					\
+	darray_resize_gfp(_d, _new_size, GFP_KERNEL)
+
+#define darray_make_room_gfp(_d, _more, _gfp)				\
+	darray_resize_gfp((_d), (_d)->nr + (_more), _gfp)
+
+#define darray_make_room(_d, _more)					\
+	darray_make_room_gfp(_d, _more, GFP_KERNEL)
+
+#define darray_resize_rcu(_d, _new_size)				\
+	__darray_resize((_d), (_new_size), GFP_KERNEL, true)
+
+#define darray_make_room_rcu(_d, _more)				\
+	darray_resize_rcu((_d), (_d)->nr + (_more))
+
+#define darray_room(_d)		((_d).size - (_d).nr)
+
+#define darray_top(_d)		((_d).data[(_d).nr])
+
+#define darray_push_gfp(_d, _item, _gfp)				\
+({									\
+	int _ret = darray_make_room_gfp((_d), 1, _gfp);			\
+									\
+	if (!_ret)							\
+		(_d)->data[(_d)->nr++] = (_item);			\
+	_ret;								\
+})
+
+#define darray_push(_d, _item)	darray_push_gfp(_d, _item, GFP_KERNEL)
+
+#define darray_pop(_d)		((_d)->data[--(_d)->nr])
+
+#define darray_first(_d)	((_d).data[0])
+#define darray_last(_d)		((_d).data[(_d).nr - 1])
+
+#define darray_insert_item(_d, pos, _item)				\
+({									\
+	size_t _pos = (pos);						\
+	int _ret = darray_make_room((_d), 1);				\
+									\
+	if (!_ret)							\
+		array_insert_item((_d)->data, (_d)->nr, _pos, (_item));	\
+	_ret;								\
+})
+
+#define darray_remove_items(_d, _pos, _nr)				\
+	array_remove_items((_d)->data, (_d)->nr, (_pos) - (_d)->data, _nr)
+
+#define darray_remove_item(_d, _pos)					\
+	array_remove_item((_d)->data, (_d)->nr, (_pos) - (_d)->data)
+
+#define darray_find_p(_d, _i, cond)					\
+({									\
+	typeof(&(_d).data[0]) _ret = NULL;				\
+									\
+	darray_for_each(_d, _i)						\
+		if (cond) {						\
+			_ret = _i;					\
+			break;						\
+		}							\
+	_ret;								\
+})
+
+#define darray_find(_d, _item)	darray_find_p(_d, _i, *_i == _item)
+
+#define darray_sort(_d, _cmp)						\
+	sort_nonatomic((_d).data, (_d).nr, sizeof((_d).data[0]), _cmp, NULL)
+
+#define darray_eytzinger1_sort(_d, _cmp)				\
+	eytzinger1_sort((_d).data, (_d).nr - 1, sizeof((_d).data[0]), _cmp, NULL)
+
+#define darray_eytzinger1_find(_d, _cmp, _search)				\
+({										\
+	int idx = eytzinger1_find((_d).data, (_d).nr - 1, sizeof((_d).data[0]),	\
+				  _cmp, _search);				\
+	idx ? (_d).data + idx : NULL;						\
+})
+
+#endif /* _BCACHEFS_DARRAY_H */
diff --git a/fs/bcachefs/util/darray.rs b/fs/bcachefs/util/darray.rs
new file mode 100644
index 0000000..78496fd
--- /dev/null
+++ b/fs/bcachefs/util/darray.rs
@@ -0,0 +1,109 @@
+// Only DarrayVec uses these, and it is std-only.
+#[cfg(feature = "std")]
+use core::marker::PhantomData;
+#[cfg(feature = "std")]
+use std::mem::ManuallyDrop;
+
+/// A bindgen-generated bcachefs darray type.
+///
+/// # Safety
+///
+/// Implementations must expose the standard bcachefs darray layout:
+/// `nr`, `size`, and `data`, where `data` points to `size` elements of `T`.
+pub unsafe trait Darray<T>: Default {
+	fn nr(&self) -> usize;
+	fn data(&mut self) -> *mut T;
+	fn set_vec_storage(&mut self, data: *mut T, nr: usize, size: usize);
+}
+
+/// Owns a Rust `Vec<T>` while presenting it to C as a bcachefs darray.
+///
+/// This is only for C functions that compact/remove entries by changing `nr`;
+/// they must not reallocate `data` with `darray_make_room()`.
+#[cfg(feature = "std")]
+pub struct DarrayVec<D, T>
+where
+	D: Darray<T>,
+{
+	darray: D,
+	vec:    ManuallyDrop<Vec<T>>,
+	_ty:    PhantomData<T>,
+}
+
+#[cfg(feature = "std")]
+impl<D, T> DarrayVec<D, T>
+where
+	D: Darray<T>,
+{
+	pub fn from_vec(vec: Vec<T>) -> Self {
+		let mut vec = ManuallyDrop::new(vec);
+		let mut darray = D::default();
+
+		darray.set_vec_storage(vec.as_mut_ptr(), vec.len(), vec.capacity());
+
+		Self {
+			darray,
+			vec,
+			_ty: PhantomData,
+		}
+	}
+
+	pub fn into_vec(self) -> Vec<T> {
+		let mut this = ManuallyDrop::new(self);
+
+		unsafe {
+			Vec::from_raw_parts(
+				this.darray.data(),
+				this.darray.nr(),
+				this.vec.capacity(),
+			)
+		}
+	}
+}
+
+#[cfg(feature = "std")]
+impl<D, T> AsMut<D> for DarrayVec<D, T>
+where
+	D: Darray<T>,
+{
+	fn as_mut(&mut self) -> &mut D {
+		&mut self.darray
+	}
+}
+
+#[cfg(feature = "std")]
+impl<D, T> Drop for DarrayVec<D, T>
+where
+	D: Darray<T>,
+{
+	fn drop(&mut self) {
+		unsafe {
+			drop(Vec::from_raw_parts(
+				self.darray.data(),
+				self.darray.nr(),
+				self.vec.capacity(),
+			));
+		}
+	}
+}
+
+#[macro_export]
+macro_rules! impl_darray {
+	($darray:ty, $item:ty) => {
+		unsafe impl $crate::util::darray::Darray<$item> for $darray {
+			fn nr(&self) -> usize {
+				self.nr
+			}
+
+			fn data(&mut self) -> *mut $item {
+				self.data
+			}
+
+			fn set_vec_storage(&mut self, data: *mut $item, nr: usize, size: usize) {
+				self.data = data;
+				self.nr = nr;
+				self.size = size;
+			}
+		}
+	};
+}
diff --git a/fs/bcachefs/util/debugfs.rs b/fs/bcachefs/util/debugfs.rs
new file mode 100644
index 0000000..b839850
--- /dev/null
+++ b/fs/bcachefs/util/debugfs.rs
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! debugfs files, read a piece at a time: a file's text is printed into a
+//! printbuf and copied out as the reader's buffer has room, the rest left for
+//! the next read - so it's never all in memory at once.
+//!
+//! A file's object is borrowed for each read, never held between them:
+//! debugfs_remove() waits out reads in progress and fails later ones, and
+//! release(), which can run after it, doesn't touch it.
+//!
+//! The VFS doesn't serialize reads of one open file - pread() takes no
+//! f_pos_lock - so its state is under a mutex.
+
+use crate::c;
+use crate::errcode::{errptr_to_result, BchError};
+use crate::locking::Lock;
+use crate::new_lock;
+use crate::util::alloc::{kbox_pin_init, KBox};
+use crate::util::ffi::Opaque;
+use crate::util::file::{File, FileOps, FileVTable, UserBuf};
+use crate::util::Printbuf;
+use core::ffi::CStr;
+use core::ops::{ControlFlow, Deref, DerefMut};
+use core::pin::Pin;
+use core::ptr::NonNull;
+use cstruct_macros::vtable;
+use pin_init::{pin_data, pin_init};
+
+/// A debugfs file - the type is the file's cursor, Default at open.
+pub trait DebugFile: Default + Unpin + 'static {
+    /// What the file is of: what create_file() was given.
+    type Obj;
+
+    /// Whether the printbuf may grow with vmalloc(), past kmalloc()'s limit.
+    const MAY_VMALLOC: bool = true;
+
+    /// Print from where the last read left off, until @out is full or there's
+    /// no more.
+    fn read(&mut self, obj: &Self::Obj, out: &mut DebugOut<'_>) -> Result<(), BchError>;
+}
+
+/// A read in progress: derefs to the open file's printbuf.
+pub struct DebugOut<'a> {
+    buf: &'a mut Printbuf,
+    u:   &'a mut UserBuf,
+}
+
+impl DebugOut<'_> {
+    /// Copy out what's printed, as much as fits; Break once the reader's
+    /// buffer is full.
+    pub fn flush(&mut self) -> Result<ControlFlow<()>, BchError> {
+        let pending = self.buf.as_bytes();
+        if !pending.is_empty() {
+            let want = pending.len().min(self.u.len());
+            let copied = self.u.copy_to(pending);
+            self.buf.drop_front(copied);
+
+            if copied != want {
+                return Err(c::EFAULT.into());
+            }
+        }
+
+        Ok(if self.u.len() == 0 { ControlFlow::Break(()) } else { ControlFlow::Continue(()) })
+    }
+
+    /// @next prints the next item - false if that was the last, or there was
+    /// none - flushing after each, until there are no more or @self is full.
+    pub fn print_each(&mut self, mut next: impl FnMut(&mut Printbuf) -> Result<bool, BchError>)
+        -> Result<(), BchError>
+    {
+        while self.flush()?.is_continue() && next(self.buf)? {}
+        Ok(())
+    }
+}
+
+impl Deref for DebugOut<'_> {
+    type Target = Printbuf;
+    fn deref(&self) -> &Printbuf { self.buf }
+}
+
+impl DerefMut for DebugOut<'_> {
+    fn deref_mut(&mut self) -> &mut Printbuf { self.buf }
+}
+
+/* The file */
+
+#[pin_data]
+struct Open<F: DebugFile> {
+    obj: NonNull<F::Obj>,
+    #[pin]
+    state: Lock<c::mutex, (F, Printbuf)>,
+}
+
+// SAFETY: readers share @obj, as C's do; the state's under its lock
+unsafe impl<F: DebugFile> Send for Open<F> {}
+unsafe impl<F: DebugFile> Sync for Open<F> {}
+
+#[vtable]
+impl<F: DebugFile> FileOps for Open<F> {
+    fn open(inode: &Opaque<c::inode>, _file: &File) -> Result<Pin<KBox<Self>>, BchError> {
+        // SAFETY: i_private is create_file()'s @obj
+        let obj = NonNull::new(unsafe { (*inode.as_ptr()).i_private }.cast::<F::Obj>())
+            .expect("debugfs file without its object");
+
+        let mut buf = Printbuf::new();
+        buf.set_may_vmalloc(F::MAY_VMALLOC);
+
+        kbox_pin_init(pin_init!(Open::<F> {
+            obj,
+            state <- new_lock!((F::default(), buf)),
+        }? BchError))
+    }
+
+    fn read(&self, _file: &File, u: &mut UserBuf) -> Result<(), BchError> {
+        // SAFETY: @obj outlives reads
+        let obj = unsafe { self.obj.as_ref() };
+
+        let mut state = self.state.lock();
+        let (cursor, buf) = &mut *state;
+        read_locked(cursor, obj, &mut DebugOut { buf, u })
+    }
+}
+
+fn read_locked<F: DebugFile>(cursor: &mut F, obj: &F::Obj, out: &mut DebugOut<'_>)
+    -> Result<(), BchError>
+{
+    if out.flush()?.is_continue() {
+        cursor.read(obj, out)?;
+    }
+    if out.allocation_failure() {
+        return Err(c::ENOMEM.into());
+    }
+    // the read's done, whether this fills the reader's buffer or not
+    out.flush().map(drop)
+}
+
+/* Creating and removing them */
+
+/// None if debugfs_create_dir() failed, or debugfs is disabled.
+pub fn create_dir(name: &CStr, parent: Option<NonNull<c::dentry>>) -> Option<NonNull<c::dentry>> {
+    let parent = parent.map_or(core::ptr::null_mut(), NonNull::as_ptr);
+    let dir = unsafe { c::debugfs_create_dir(name.as_ptr().cast(), parent) };
+    errptr_to_result(NonNull::new(dir).expect("a dentry, or an error")).ok()
+}
+
+/// Read-only: a DebugFile has no write. Failure is ignored, as in C.
+///
+/// # Safety
+/// @obj outlives the file: it's removed, with remove_recursive(), first.
+pub unsafe fn create_file<F: DebugFile>(name: &CStr, parent: NonNull<c::dentry>, obj: &F::Obj) {
+    unsafe {
+        c::bch2_debugfs_create_file(name.as_ptr().cast(), 0o400, parent.as_ptr(),
+                                    core::ptr::from_ref(obj).cast_mut().cast(),
+                                    &FileVTable::<Open<F>>::OPS);
+    }
+}
+
+pub fn remove_recursive(dir: NonNull<c::dentry>) {
+    // debugfs_remove_recursive() is a macro for it, in-kernel
+    unsafe { c::debugfs_remove(dir.as_ptr()) }
+}
diff --git a/fs/bcachefs/util/demangle.rs b/fs/bcachefs/util/demangle.rs
new file mode 100644
index 0000000..338dc5a
--- /dev/null
+++ b/fs/bcachefs/util/demangle.rs
@@ -0,0 +1,689 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Rust v0 symbol demangling, on the heap: rustc_demangle's v0 printer, as a
+//! loop over a stack of steps in a KVVec instead of recursion.
+//!
+//! Backtraces are printed from wherever lock debugging fires - the bottom of
+//! a deep write path, say - and rustc_demangle's recursive descent takes
+//! kilobytes of stack for a name with nested generics and closures: enough
+//! to overflow a 16K kernel stack. Here the depth is the step stack's, so a
+//! name costs the stack one frame, and the heap a few hundred bytes.
+//!
+//! The output is rustc_demangle's {:#}: no crate disambiguators, no
+//! constants' type suffixes. A step that can't be done - the step stack
+//! can't grow, the name's malformed, or it uses what isn't handled here
+//! (punycode identifiers, const values past integers, bools and chars,
+//! pattern types) - and the name is printed as it came: what's demangled is
+//! right, or it's the raw symbol.
+//!
+//! How v0 reads (the Rust symbol mangling RFC): a symbol is _R, a path, an
+//! optional instantiating crate, and an optional .suffix. Paths, types and
+//! consts nest; each step parses the construct at the cursor, prints its
+//! prefix, and pushes what follows it - the nested construct, then whatever
+//! prints after that - in reverse, so they pop in order. A backref (B<n>) is
+//! the construct at offset n, printed by moving the cursor there, with a
+//! step to move it back. An impl's own path is parsed and not printed: the
+//! steps between Skip and Unskip print nothing, and don't follow backrefs.
+
+use crate::util::alloc::flags::GFP_NOWAIT;
+use crate::util::alloc::{AllocError, KVVec};
+use crate::util::Printbuf;
+use core::fmt::Write;
+
+/// The most a name is demangled to: a backref can repeat what it points at,
+/// so output can be exponential in the input.
+const MAX_OUT: usize = 16 << 10;
+
+/// The most steps pending: a page's worth, so the KVVec is kmalloc()'d -
+/// kvmalloc() of a page or less never falls back to vmalloc - and freed by
+/// kfree(), which a caller under a spinlock can do, where vfree() can't.
+const MAX_STEPS: usize = 4096 / core::mem::size_of::<Step>();
+
+/// Why a name isn't demangled: it's printed raw.
+struct Raw;
+
+impl From<AllocError> for Raw {
+    fn from(_: AllocError) -> Self {
+        Raw
+    }
+}
+
+impl From<core::fmt::Error> for Raw {
+    fn from(_: core::fmt::Error) -> Self {
+        Raw
+    }
+}
+
+#[derive(Clone, Copy)]
+enum Step {
+    Path { in_value: bool },
+    /// A nested path's last segment: namespace @ns, after its parent
+    PathNested { ns: Option<u8> },
+    Type,
+    GenericArg,
+    Const { in_value: bool },
+    /// The elements of a list up to its E, @sep between them: @tuple, a
+    /// tuple's, gets a trailing comma if it has one element
+    List { elem: Elem, sep: &'static str, n: u32, tuple: bool },
+    Lit(&'static str),
+    /// A fn type's return type, after its arguments
+    FnRet,
+    /// The end of a binder of @n lifetimes
+    BinderEnd(u32),
+    /// A dyn type's lifetime, after its traits
+    DynLifetime,
+    /// A trait of a dyn type, through backrefs: when the path's been
+    /// printed, the cursor goes back to @ret
+    DynTrait { ret: Option<usize> },
+    /// A dyn trait's associated type bindings, inside its generics' <...> if
+    /// @open
+    DynAssoc { open: bool },
+    /// Back from a backref
+    Goto(usize),
+    Skip,
+    Unskip,
+}
+
+#[derive(Clone, Copy)]
+enum Elem {
+    Type,
+    GenericArg,
+    DynTrait,
+}
+
+struct Demangler<'s, 'o> {
+    sym:   &'s [u8],
+    at:    usize,
+    out:   &'o mut Printbuf,
+    start: usize,
+    /// Printing suppressed: inside an impl's own path
+    skip:  u32,
+    /// Lifetimes bound by for<...> binders around what's being printed
+    bound: u32,
+    steps: KVVec<Step>,
+}
+
+impl<'s> Demangler<'s, '_> {
+    fn push(&mut self, s: Step) -> Result<(), Raw> {
+        if self.steps.len() == MAX_STEPS {
+            return Err(Raw);
+        }
+        Ok(self.steps.push(s, GFP_NOWAIT)?)
+    }
+
+    fn print(&mut self, s: &str) -> Result<(), Raw> {
+        if self.skip == 0 {
+            self.out.write_str(s)?;
+        }
+        Ok(())
+    }
+
+    fn print_u64(&mut self, v: u64) -> Result<(), Raw> {
+        if self.skip == 0 {
+            write!(self.out, "{v}");
+        }
+        Ok(())
+    }
+
+    fn peek(&self) -> Option<u8> {
+        self.sym.get(self.at).copied()
+    }
+
+    fn eat(&mut self, b: u8) -> bool {
+        let yes = self.peek() == Some(b);
+        self.at += usize::from(yes);
+        yes
+    }
+
+    fn next(&mut self) -> Result<u8, Raw> {
+        let b = self.peek().ok_or(Raw)?;
+        self.at += 1;
+        Ok(b)
+    }
+
+    fn digit_10(&mut self) -> Option<u8> {
+        let d = self.peek().filter(u8::is_ascii_digit)? - b'0';
+        self.at += 1;
+        Some(d)
+    }
+
+    fn integer_62(&mut self) -> Result<u64, Raw> {
+        if self.eat(b'_') {
+            return Ok(0);
+        }
+        let mut x: u64 = 0;
+        while !self.eat(b'_') {
+            let d = match self.next()? {
+                d @ b'0'..=b'9' => d - b'0',
+                d @ b'a'..=b'z' => 10 + d - b'a',
+                d @ b'A'..=b'Z' => 36 + d - b'A',
+                _ => return Err(Raw),
+            };
+            x = x.checked_mul(62).and_then(|x| x.checked_add(d.into())).ok_or(Raw)?;
+        }
+        x.checked_add(1).ok_or(Raw)
+    }
+
+    fn opt_integer_62(&mut self, tag: u8) -> Result<u64, Raw> {
+        if !self.eat(tag) {
+            return Ok(0);
+        }
+        self.integer_62()?.checked_add(1).ok_or(Raw)
+    }
+
+    fn disambiguator(&mut self) -> Result<u64, Raw> {
+        self.opt_integer_62(b's')
+    }
+
+    /// An identifier, ASCII: punycode's not handled.
+    fn ident(&mut self) -> Result<&'s str, Raw> {
+        if self.peek() == Some(b'u') {
+            return Err(Raw);
+        }
+        let mut len = usize::from(self.digit_10().ok_or(Raw)?);
+        if len != 0 {
+            while let Some(d) = self.digit_10() {
+                len = len.checked_mul(10).and_then(|l| l.checked_add(d.into())).ok_or(Raw)?;
+            }
+        }
+        self.eat(b'_');
+
+        let (sym, start) = (self.sym, self.at);
+        self.at = start.checked_add(len).filter(|&end| end <= sym.len()).ok_or(Raw)?;
+        core::str::from_utf8(&sym[start..self.at]).map_err(|_| Raw)
+    }
+
+    /// A backref's target, after its B: before the B, as backrefs point
+    /// backwards.
+    fn backref(&mut self) -> Result<usize, Raw> {
+        let b = self.at - 1;
+        let i = self.integer_62()?;
+        usize::try_from(i).ok().filter(|&i| i < b).ok_or(Raw)
+    }
+
+    /// The construct at a backref, by @step there - or, skipping, nothing.
+    fn follow(&mut self, step: Step) -> Result<(), Raw> {
+        let target = self.backref()?;
+        if self.skip == 0 {
+            self.push(Step::Goto(self.at))?;
+            self.push(step)?;
+            self.at = target;
+        }
+        Ok(())
+    }
+
+    fn hex(&mut self) -> Result<&'s [u8], Raw> {
+        let (sym, start) = (self.sym, self.at);
+        loop {
+            match self.next()? {
+                b'0'..=b'9' | b'a'..=b'f' => {}
+                b'_' => return Ok(&sym[start..self.at - 1]),
+                _ => return Err(Raw),
+            }
+        }
+    }
+
+    fn hex_u64(nibbles: &[u8]) -> Option<u64> {
+        let first = nibbles.iter().position(|&b| b != b'0').unwrap_or(nibbles.len());
+        let nibbles = &nibbles[first..];
+        (nibbles.len() <= 16).then(|| {
+            nibbles.iter().fold(0, |v, &b| v << 4 | u64::from((b as char).to_digit(16).unwrap()))
+        })
+    }
+
+    fn lifetime(&mut self, lt: u64) -> Result<(), Raw> {
+        if self.skip != 0 {
+            return Ok(());
+        }
+        self.print("'")?;
+        if lt == 0 {
+            return self.print("_");
+        }
+        let depth = u64::from(self.bound).checked_sub(lt).ok_or(Raw)?;
+        if depth < 26 {
+            let c = [b'a' + depth as u8];
+            self.print(core::str::from_utf8(&c).unwrap())
+        } else {
+            self.print("_")?;
+            self.print_u64(depth)
+        }
+    }
+
+    /// A binder's lifetimes, for<'a, ...>, if it has any: how many.
+    fn binder(&mut self) -> Result<u32, Raw> {
+        let n = self.opt_integer_62(b'G')?;
+        if self.skip != 0 {
+            return Ok(0);
+        }
+        let n = u32::try_from(n).map_err(|_| Raw)?;
+        if n > 0 {
+            self.print("for<")?;
+            for i in 0..n {
+                if i > 0 {
+                    self.print(", ")?;
+                }
+                self.bound += 1;
+                self.lifetime(1)?;
+            }
+            self.print("> ")?;
+        }
+        Ok(n)
+    }
+
+    /// @s, and everything it pushes.
+    fn run(&mut self, s: Step) -> Result<(), Raw> {
+        self.push(s)?;
+        while let Some(s) = self.steps.pop() {
+            self.step(s)?;
+            if self.out.as_bytes().len() - self.start > MAX_OUT {
+                return Err(Raw);
+            }
+        }
+        Ok(())
+    }
+
+    fn step(&mut self, s: Step) -> Result<(), Raw> {
+        match s {
+            Step::Path { in_value } => self.path(in_value)?,
+            Step::PathNested { ns } => {
+                let dis = self.disambiguator()?;
+                let name = self.ident()?;
+                let empty = name.is_empty();
+                match ns {
+                    Some(ns) => {
+                        self.print("::{")?;
+                        match ns {
+                            b'C' => self.print("closure")?,
+                            b'S' => self.print("shim")?,
+                            _ => self.print(core::str::from_utf8(&[ns]).unwrap())?,
+                        }
+                        if !empty {
+                            self.print(":")?;
+                            self.print(name)?;
+                        }
+                        self.print("#")?;
+                        self.print_u64(dis)?;
+                        self.print("}")?;
+                    }
+                    None if !empty => {
+                        self.print("::")?;
+                        self.print(name)?;
+                    }
+                    None => {}
+                }
+            }
+            Step::Type => self.ty()?,
+            Step::GenericArg => {
+                if self.eat(b'L') {
+                    let lt = self.integer_62()?;
+                    self.lifetime(lt)?;
+                } else if self.eat(b'K') {
+                    self.konst(false)?;
+                } else {
+                    self.ty()?;
+                }
+            }
+            Step::Const { in_value } => self.konst(in_value)?,
+            Step::List { elem, sep, n, tuple } => {
+                if self.eat(b'E') {
+                    if tuple && n == 1 {
+                        self.print(",")?;
+                    }
+                } else {
+                    if n > 0 {
+                        self.print(sep)?;
+                    }
+                    self.push(Step::List { elem, sep, n: n + 1, tuple })?;
+                    self.push(match elem {
+                        Elem::Type       => Step::Type,
+                        Elem::GenericArg => Step::GenericArg,
+                        Elem::DynTrait   => Step::DynTrait { ret: None },
+                    })?;
+                }
+            }
+            Step::Lit(s) => self.print(s)?,
+            Step::FnRet => {
+                if !self.eat(b'u') {
+                    self.print(" -> ")?;
+                    self.push(Step::Type)?;
+                }
+            }
+            Step::BinderEnd(n) => self.bound -= n,
+            Step::DynLifetime => {
+                if !self.eat(b'L') {
+                    return Err(Raw);
+                }
+                let lt = self.integer_62()?;
+                if lt != 0 {
+                    self.print(" + ")?;
+                    self.lifetime(lt)?;
+                }
+            }
+            Step::DynTrait { ret } => {
+                if self.eat(b'B') {
+                    let target = self.backref()?;
+                    if self.skip == 0 {
+                        // printed there, and the bindings read here after
+                        let ret = ret.unwrap_or(self.at);
+                        self.push(Step::DynTrait { ret: Some(ret) })?;
+                        self.at = target;
+                    } else {
+                        self.push(Step::DynAssoc { open: false })?;
+                    }
+                } else {
+                    let open = self.eat(b'I');
+                    self.push(Step::DynAssoc { open })?;
+                    if let Some(ret) = ret {
+                        self.push(Step::Goto(ret))?;
+                    }
+                    if open {
+                        self.push(Step::List { elem: Elem::GenericArg, sep: ", ", n: 0, tuple: false })?;
+                        self.push(Step::Lit("<"))?;
+                    }
+                    self.push(Step::Path { in_value: false })?;
+                }
+            }
+            Step::DynAssoc { open } => {
+                if self.eat(b'p') {
+                    self.print(if open { ", " } else { "<" })?;
+                    let name = self.ident()?;
+                    self.print(name)?;
+                    self.print(" = ")?;
+                    self.push(Step::DynAssoc { open: true })?;
+                    let konst = self.eat(b'K');
+                    self.push(if konst { Step::Const { in_value: false } } else { Step::Type })?;
+                } else if open {
+                    self.print(">")?;
+                }
+            }
+            Step::Goto(at) => self.at = at,
+            Step::Skip => self.skip += 1,
+            Step::Unskip => self.skip -= 1,
+        }
+        Ok(())
+    }
+
+    fn path(&mut self, in_value: bool) -> Result<(), Raw> {
+        match self.next()? {
+            b'C' => {
+                self.disambiguator()?;
+                let name = self.ident()?;
+                self.print(name)?;
+            }
+            b'N' => {
+                let ns = match self.next()? {
+                    ns @ b'A'..=b'Z' => Some(ns),
+                    b'a'..=b'z' => None,
+                    _ => return Err(Raw),
+                };
+                self.push(Step::PathNested { ns })?;
+                self.push(Step::Path { in_value })?;
+            }
+            tag @ (b'M' | b'X' | b'Y') => {
+                self.push(Step::Lit(">"))?;
+                if tag != b'M' {
+                    self.push(Step::Path { in_value: false })?;
+                    self.push(Step::Lit(" as "))?;
+                }
+                self.push(Step::Type)?;
+                self.push(Step::Lit("<"))?;
+                if tag != b'Y' {
+                    // the impl's own path, not printed
+                    self.disambiguator()?;
+                    self.push(Step::Unskip)?;
+                    self.push(Step::Path { in_value: false })?;
+                    self.push(Step::Skip)?;
+                }
+            }
+            b'I' => {
+                self.push(Step::Lit(">"))?;
+                self.push(Step::List { elem: Elem::GenericArg, sep: ", ", n: 0, tuple: false })?;
+                self.push(Step::Lit(if in_value { "::<" } else { "<" }))?;
+                self.push(Step::Path { in_value })?;
+            }
+            b'B' => self.follow(Step::Path { in_value })?,
+            _ => return Err(Raw),
+        }
+        Ok(())
+    }
+
+    fn ty(&mut self) -> Result<(), Raw> {
+        let tag = self.next()?;
+        if let Some(ty) = basic_type(tag) {
+            return self.print(ty);
+        }
+        match tag {
+            b'R' | b'Q' => {
+                self.print("&")?;
+                if self.eat(b'L') {
+                    let lt = self.integer_62()?;
+                    if lt != 0 {
+                        self.lifetime(lt)?;
+                        self.print(" ")?;
+                    }
+                }
+                if tag == b'Q' {
+                    self.print("mut ")?;
+                }
+                self.push(Step::Type)?;
+            }
+            b'P' | b'O' => {
+                self.print(if tag == b'P' { "*const " } else { "*mut " })?;
+                self.push(Step::Type)?;
+            }
+            b'A' | b'S' => {
+                self.print("[")?;
+                self.push(Step::Lit("]"))?;
+                if tag == b'A' {
+                    self.push(Step::Const { in_value: true })?;
+                    self.push(Step::Lit("; "))?;
+                }
+                self.push(Step::Type)?;
+            }
+            b'T' => {
+                self.print("(")?;
+                self.push(Step::Lit(")"))?;
+                self.push(Step::List { elem: Elem::Type, sep: ", ", n: 0, tuple: true })?;
+            }
+            b'F' => {
+                let n = self.binder()?;
+                let unsafe_ = self.eat(b'U');
+                let abi = if self.eat(b'K') {
+                    if self.eat(b'C') {
+                        Some("C")
+                    } else {
+                        let abi = self.ident()?;
+                        if abi.is_empty() {
+                            return Err(Raw);
+                        }
+                        Some(abi)
+                    }
+                } else {
+                    None
+                };
+                if unsafe_ {
+                    self.print("unsafe ")?;
+                }
+                if let Some(abi) = abi {
+                    // a - in the ABI is mangled as _
+                    self.print("extern \"")?;
+                    for (i, part) in abi.split('_').enumerate() {
+                        if i > 0 {
+                            self.print("-")?;
+                        }
+                        self.print(part)?;
+                    }
+                    self.print("\" ")?;
+                }
+                self.print("fn(")?;
+                self.push(Step::BinderEnd(n))?;
+                self.push(Step::FnRet)?;
+                self.push(Step::Lit(")"))?;
+                self.push(Step::List { elem: Elem::Type, sep: ", ", n: 0, tuple: false })?;
+            }
+            b'D' => {
+                self.print("dyn ")?;
+                let n = self.binder()?;
+                self.push(Step::DynLifetime)?;
+                self.push(Step::BinderEnd(n))?;
+                self.push(Step::List { elem: Elem::DynTrait, sep: " + ", n: 0, tuple: false })?;
+            }
+            b'B' => self.follow(Step::Type)?,
+            _ => {
+                // a path: from its tag
+                self.at -= 1;
+                self.path(false)?;
+            }
+        }
+        Ok(())
+    }
+
+    /// A const: of integers, bools and chars - the rest aren't handled.
+    fn konst(&mut self, in_value: bool) -> Result<(), Raw> {
+        let tag = self.next()?;
+        match tag {
+            b'p' => self.print("_")?,
+            b'h' | b't' | b'm' | b'y' | b'o' | b'j' | b'a' | b's' | b'l' | b'x' | b'n' | b'i' => {
+                if matches!(tag, b'a' | b's' | b'l' | b'x' | b'n' | b'i') && self.eat(b'n') {
+                    self.print("-")?;
+                }
+                let hex = self.hex()?;
+                match Self::hex_u64(hex) {
+                    Some(v) => self.print_u64(v)?,
+                    None => {
+                        self.print("0x")?;
+                        self.print(core::str::from_utf8(hex).unwrap())?;
+                    }
+                }
+            }
+            b'b' => match Self::hex_u64(self.hex()?) {
+                Some(0) => self.print("false")?,
+                Some(1) => self.print("true")?,
+                _ => return Err(Raw),
+            },
+            b'c' => {
+                let c = Self::hex_u64(self.hex()?)
+                    .and_then(|v| u32::try_from(v).ok())
+                    .and_then(char::from_u32)
+                    .ok_or(Raw)?;
+                if self.skip == 0 {
+                    self.out.write_char('\'')?;
+                    if c == '"' {
+                        self.out.write_char(c)?;
+                    } else {
+                        for e in c.escape_debug() {
+                            self.out.write_char(e)?;
+                        }
+                    }
+                    self.out.write_char('\'')?;
+                }
+            }
+            b'B' => self.follow(Step::Const { in_value })?,
+            _ => return Err(Raw),
+        }
+        Ok(())
+    }
+}
+
+fn basic_type(tag: u8) -> Option<&'static str> {
+    Some(match tag {
+        b'b' => "bool",
+        b'c' => "char",
+        b'e' => "str",
+        b'u' => "()",
+        b'a' => "i8",
+        b's' => "i16",
+        b'l' => "i32",
+        b'x' => "i64",
+        b'n' => "i128",
+        b'i' => "isize",
+        b'h' => "u8",
+        b't' => "u16",
+        b'm' => "u32",
+        b'y' => "u64",
+        b'o' => "u128",
+        b'j' => "usize",
+        b'f' => "f32",
+        b'd' => "f64",
+        b'z' => "!",
+        b'p' => "_",
+        b'v' => "...",
+        _ => return None,
+    })
+}
+
+/// A suffix rustc_demangle keeps: LLVM's period-delimited words.
+fn symbol_like(s: &[u8]) -> bool {
+    s.iter().all(|&c| c.is_ascii_alphanumeric() || c.is_ascii_punctuation())
+}
+
+/// @sym, a v0 symbol - _R... - demangled to @out: Raw if it can't be, with
+/// what's been written for the caller to take back.
+fn v0(out: &mut Printbuf, sym: &str) -> Result<(), Raw> {
+    let inner = sym.strip_prefix("_R").filter(|s| !s.is_empty()).ok_or(Raw)?.as_bytes();
+    if !inner[0].is_ascii_uppercase() || !inner.is_ascii() {
+        return Err(Raw);
+    }
+
+    let mut d = Demangler {
+        sym:   inner,
+        at:    0,
+        start: out.as_bytes().len(),
+        out,
+        skip:  0,
+        bound: 0,
+        steps: KVVec::new(),
+    };
+    d.steps.reserve(32, GFP_NOWAIT)?;
+
+    d.run(Step::Path { in_value: true })?;
+
+    // the instantiating crate, not printed
+    if d.peek().is_some_and(|b| b.is_ascii_uppercase()) {
+        d.skip += 1;
+        d.run(Step::Path { in_value: false })?;
+        d.skip -= 1;
+    }
+
+    let suffix = &inner[d.at..];
+    if !suffix.is_empty() {
+        if suffix[0] != b'.' || !symbol_like(suffix) {
+            return Err(Raw);
+        }
+        d.out.write_str(core::str::from_utf8(suffix).unwrap())?;
+    }
+    Ok(())
+}
+
+/// A legacy name, _ZN...: std's, prebuilt, in userspace - rustc_demangle's
+/// legacy demangling doesn't recurse.
+#[cfg(not(kernel))]
+fn prt_other(out: &mut Printbuf, sym: &str) {
+    write!(out, "{:#}", rustc_demangle::demangle(sym));
+}
+
+/// In the kernel every Rust name is v0: anything else is C's.
+#[cfg(kernel)]
+fn prt_other(out: &mut Printbuf, sym: &str) {
+    let _ = out.write_str(sym);
+}
+
+/// @sym demangled to @out, as rustc_demangle's {:#}: a v0 name here, on the
+/// heap - as it is, if it can't be - and anything else by prt_other().
+pub fn prt_demangled(out: &mut Printbuf, sym: &str) {
+    // ThinLTO's renaming of internal symbols, which rustc_demangle drops
+    let sym = match sym.find(".llvm.") {
+        Some(i) if sym[i + 6..].bytes().all(|c| matches!(c, b'A'..=b'F' | b'0'..=b'9' | b'@')) => &sym[..i],
+        _ => sym,
+    };
+
+    if sym.starts_with("_R") {
+        let saved = out.state_save();
+        if v0(out, sym).is_err() {
+            out.state_restore(saved);
+            let _ = out.write_str(sym);
+        }
+    } else {
+        prt_other(out, sym);
+    }
+}
diff --git a/fs/bcachefs/util/enumerated_ref.c b/fs/bcachefs/util/enumerated_ref.c
new file mode 100644
index 0000000..cf64d04
--- /dev/null
+++ b/fs/bcachefs/util/enumerated_ref.c
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include "bcachefs.h"
+#include "enumerated_ref.h"
+#include "util.h"
+
+#include <linux/completion.h>
+
+#ifdef ENUMERATED_REF_DEBUG
+void enumerated_ref_get(struct enumerated_ref *ref, unsigned idx)
+{
+	BUG_ON(idx >= ref->nr);
+	atomic_long_inc(&ref->refs[idx]);
+}
+
+bool __enumerated_ref_tryget(struct enumerated_ref *ref, unsigned idx)
+{
+	BUG_ON(idx >= ref->nr);
+	return atomic_long_inc_not_zero(&ref->refs[idx]);
+}
+
+bool enumerated_ref_tryget(struct enumerated_ref *ref, unsigned idx)
+{
+	BUG_ON(idx >= ref->nr);
+	return !ref->dying &&
+		atomic_long_inc_not_zero(&ref->refs[idx]);
+}
+
+void enumerated_ref_put(struct enumerated_ref *ref, unsigned idx)
+{
+	BUG_ON(idx >= ref->nr);
+	long v = atomic_long_dec_return(&ref->refs[idx]);
+
+	BUG_ON(v < 0);
+	if (v)
+		return;
+
+	for (unsigned i = 0; i < ref->nr; i++)
+		if (atomic_long_read(&ref->refs[i]))
+			return;
+
+	if (ref->stop_fn)
+		ref->stop_fn(ref);
+	complete(&ref->stop_complete);
+}
+#endif
+
+#ifndef ENUMERATED_REF_DEBUG
+static void enumerated_ref_kill_cb(struct percpu_ref *percpu_ref)
+{
+	struct enumerated_ref *ref =
+		container_of(percpu_ref, struct enumerated_ref, ref);
+
+	if (ref->stop_fn)
+		ref->stop_fn(ref);
+	complete(&ref->stop_complete);
+}
+#endif
+
+void enumerated_ref_stop_async(struct enumerated_ref *ref)
+{
+	reinit_completion(&ref->stop_complete);
+
+#ifndef ENUMERATED_REF_DEBUG
+	percpu_ref_kill(&ref->ref);
+#else
+	ref->dying = true;
+	for (unsigned i = 0; i < ref->nr; i++)
+		enumerated_ref_put(ref, i);
+#endif
+}
+
+void enumerated_ref_stop(struct enumerated_ref *ref,
+			 const char * const names[])
+{
+	enumerated_ref_stop_async(ref);
+	while (!wait_for_completion_timeout(&ref->stop_complete, HZ * 10)) {
+		CLASS(printbuf, buf)();
+		prt_str(&buf, "Waited for 10 seconds to shutdown enumerated ref\n");
+		prt_str(&buf, "Outstanding refs:\n");
+		enumerated_ref_to_text(&buf, ref, names);
+		printk(KERN_ERR "%s", buf.buf);
+	}
+}
+
+void enumerated_ref_start(struct enumerated_ref *ref)
+{
+#ifndef ENUMERATED_REF_DEBUG
+	percpu_ref_reinit(&ref->ref);
+#else
+	ref->dying = false;
+	for (unsigned i = 0; i < ref->nr; i++) {
+		BUG_ON(atomic_long_read(&ref->refs[i]));
+		atomic_long_inc(&ref->refs[i]);
+	}
+#endif
+}
+
+void enumerated_ref_exit(struct enumerated_ref *ref)
+{
+#ifndef ENUMERATED_REF_DEBUG
+	percpu_ref_exit(&ref->ref);
+#else
+	kfree(ref->refs);
+	ref->refs = NULL;
+	ref->nr = 0;
+#endif
+}
+
+int enumerated_ref_init(struct enumerated_ref *ref, unsigned nr,
+			void (*stop_fn)(struct enumerated_ref *))
+{
+	init_completion(&ref->stop_complete);
+	ref->stop_fn = stop_fn;
+
+#ifndef ENUMERATED_REF_DEBUG
+	return percpu_ref_init(&ref->ref, enumerated_ref_kill_cb,
+			    PERCPU_REF_INIT_DEAD, GFP_KERNEL);
+#else
+	ref->refs = kzalloc(sizeof(ref->refs[0]) * nr, GFP_KERNEL);
+	if (!ref->refs)
+		return -ENOMEM;
+
+	ref->nr = nr;
+	return 0;
+#endif
+}
+
+/*
+ * For Rust: without ENUMERATED_REF_DEBUG these are static inlines. Rust's refs
+ * are kind 0 - every kind list has rust first:
+ */
+void rust_enumerated_ref_get(struct enumerated_ref *ref)
+{
+	enumerated_ref_get(ref, 0);
+}
+
+bool rust___enumerated_ref_tryget(struct enumerated_ref *ref)
+{
+	return __enumerated_ref_tryget(ref, 0);
+}
+
+bool rust_enumerated_ref_tryget(struct enumerated_ref *ref)
+{
+	return enumerated_ref_tryget(ref, 0);
+}
+
+void rust_enumerated_ref_put(struct enumerated_ref *ref)
+{
+	enumerated_ref_put(ref, 0);
+}
+
+bool rust_enumerated_ref_is_zero(struct enumerated_ref *ref)
+{
+	return enumerated_ref_is_zero(ref);
+}
+
+__cold void enumerated_ref_to_text(struct printbuf *out,
+			    struct enumerated_ref *ref,
+			    const char * const names[])
+{
+#ifdef ENUMERATED_REF_DEBUG
+	bch2_printbuf_tabstop_push(out, 32);
+
+	for (unsigned i = 0; i < ref->nr; i++)
+		prt_printf(out, "%s\t%li\n", names[i],
+			   atomic_long_read(&ref->refs[i]));
+#else
+	prt_str(out, "(not in debug mode)\n");
+#endif
+}
diff --git a/fs/bcachefs/util/enumerated_ref.h b/fs/bcachefs/util/enumerated_ref.h
new file mode 100644
index 0000000..7d7b861
--- /dev/null
+++ b/fs/bcachefs/util/enumerated_ref.h
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_ENUMERATED_REF_H
+#define _BCACHEFS_ENUMERATED_REF_H
+
+#include "util/enumerated_ref_gen.h"
+
+/*
+ * A refcount where the users are enumerated: in debug mode, we create sepate
+ * refcounts for each user, to make leaks and refcount errors easy to track
+ * down:
+ */
+
+#ifdef ENUMERATED_REF_DEBUG
+void enumerated_ref_get(struct enumerated_ref *, unsigned);
+bool __enumerated_ref_tryget(struct enumerated_ref *, unsigned);
+bool enumerated_ref_tryget(struct enumerated_ref *, unsigned);
+void enumerated_ref_put(struct enumerated_ref *, unsigned);
+#else
+
+static inline void enumerated_ref_get(struct enumerated_ref *ref, unsigned idx)
+{
+	percpu_ref_get(&ref->ref);
+}
+
+static inline bool __enumerated_ref_tryget(struct enumerated_ref *ref, unsigned idx)
+{
+	return percpu_ref_tryget(&ref->ref);
+}
+
+static inline bool enumerated_ref_tryget(struct enumerated_ref *ref, unsigned idx)
+{
+	return percpu_ref_tryget_live(&ref->ref);
+}
+
+static inline void enumerated_ref_put(struct enumerated_ref *ref, unsigned idx)
+{
+	percpu_ref_put(&ref->ref);
+}
+#endif
+
+static inline bool enumerated_ref_is_zero(struct enumerated_ref *ref)
+{
+#ifndef ENUMERATED_REF_DEBUG
+	return percpu_ref_is_zero(&ref->ref);
+#else
+	for (unsigned i = 0; i < ref->nr; i++)
+		if (atomic_long_read(&ref->refs[i]))
+			return false;
+	return true;
+#endif
+}
+
+void enumerated_ref_stop_async(struct enumerated_ref *);
+void enumerated_ref_stop(struct enumerated_ref *, const char * const[]);
+void enumerated_ref_start(struct enumerated_ref *);
+
+void enumerated_ref_exit(struct enumerated_ref *);
+int enumerated_ref_init(struct enumerated_ref *, unsigned,
+			void (*stop_fn)(struct enumerated_ref *));
+
+struct printbuf;
+void enumerated_ref_to_text(struct printbuf *,
+			    struct enumerated_ref *,
+			    const char * const[]);
+
+#endif /* _BCACHEFS_ENUMERATED_REF_H */
diff --git a/fs/bcachefs/util/enumerated_ref.rs b/fs/bcachefs/util/enumerated_ref.rs
new file mode 100644
index 0000000..d547619
--- /dev/null
+++ b/fs/bcachefs/util/enumerated_ref.rs
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! EnumeratedRef: struct enumerated_ref as a Refcount - a count that's
+//! stopped and waited out, as a percpu_ref is, its refs counted by kind
+//! when debugging. c->writes is one, and ca->io_ref[] two.
+//!
+//! The kinds are a debugging aid, for C's: every kind list has rust first,
+//! so all of Rust's refs are kind 0.
+
+use crate::c;
+use crate::util::refcount::{Refcount, TryRefcount};
+use crate::util::Printbuf;
+
+const _: () = assert!(c::bch_write_ref::BCH_WRITE_REF_rust as u32 == 0);
+const _: () = assert!(c::bch_dev_read_ref::BCH_DEV_READ_REF_rust as u32 == 0);
+const _: () = assert!(c::bch_dev_write_ref::BCH_DEV_WRITE_REF_rust as u32 == 0);
+
+/// Zeroed with what it's in, for C's enumerated_ref_init().
+#[repr(transparent)]
+pub struct EnumeratedRef {
+    r: core::cell::UnsafeCell<c::enumerated_ref>,
+}
+
+// SAFETY: an enumerated_ref is got and put from any thread
+unsafe impl Send for EnumeratedRef {}
+unsafe impl Sync for EnumeratedRef {}
+
+// SAFETY: all zeroes is an enumerated_ref before enumerated_ref_init()
+unsafe impl ::pin_init::Zeroable for EnumeratedRef {}
+
+impl EnumeratedRef {
+    /// No refs held: stopped, or never started.
+    pub fn is_zero(&self) -> bool {
+        unsafe { c::rust_enumerated_ref_is_zero(self.r.get()) }
+    }
+
+    /// The refs held, by kind - @names the kinds', NULL terminated.
+    ///
+    /// # Safety
+    /// @names has an entry for each of this ref's kinds.
+    pub unsafe fn to_text(&self, out: &mut Printbuf, names: *const *const crate::util::ffi::c_char) {
+        unsafe { (*self.r.get()).to_text(out, names) }
+    }
+}
+
+// SAFETY: C's get and put, of kind 0 - first in every kind list, so the
+// debug build's count of it, refs[0], is always there. What an
+// enumerated_ref is in is freed only once it's been stopped, which waits out
+// every ref: the filesystem going read-only for c->writes, a device going
+// offline for its io refs - bch2_dev_free() warns if one's still held
+unsafe impl Refcount for EnumeratedRef {
+    fn inc(&self) {
+        unsafe { c::rust_enumerated_ref_get(self.r.get()) }
+    }
+
+    unsafe fn dec(&self) {
+        unsafe { c::rust_enumerated_ref_put(self.r.get()) }
+    }
+}
+
+// SAFETY: an enumerated_ref's trygets take a ref when they succeed
+unsafe impl TryRefcount for EnumeratedRef {
+    fn try_inc(&self) -> bool {
+        unsafe { c::rust___enumerated_ref_tryget(self.r.get()) }
+    }
+
+    fn try_inc_live(&self) -> bool {
+        unsafe { c::rust_enumerated_ref_tryget(self.r.get()) }
+    }
+}
diff --git a/fs/bcachefs/util/enumerated_ref_types.rs b/fs/bcachefs/util/enumerated_ref_types.rs
new file mode 100644
index 0000000..d5215ea
--- /dev/null
+++ b/fs/bcachefs/util/enumerated_ref_types.rs
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::util::Printbuf;
+use crate::types::c_default;
+use cstruct_macros::{c_extern, CStruct};
+
+#[repr(C)]
+#[derive(Clone, Copy, CStruct)]
+pub struct enumerated_ref {
+    /* C's ENUMERATED_REF_DEBUG, which bcachefs.h defines from this: rustc
+     * sees only the configuration, not what a header derives from it */
+    #[cfg(CONFIG_BCACHEFS_DEBUG)]
+    pub nr: core::ffi::c_uint,
+    #[cfg(CONFIG_BCACHEFS_DEBUG)]
+    pub dying: bool,
+    #[cfg(CONFIG_BCACHEFS_DEBUG)]
+    pub refs: *mut core::sync::atomic::AtomicIsize,
+    #[cfg(not(CONFIG_BCACHEFS_DEBUG))]
+    pub ref_: c::percpu_ref,
+    pub stop_fn: Option<unsafe extern "C" fn(*mut c::enumerated_ref)>,
+    pub stop_complete: c::completion,
+}
+c_default!(enumerated_ref);
+
+c_extern! {
+    pub fn rust_enumerated_ref_get(r: *mut c::enumerated_ref);
+    pub fn rust___enumerated_ref_tryget(r: *mut c::enumerated_ref) -> bool;
+    pub fn rust_enumerated_ref_tryget(r: *mut c::enumerated_ref) -> bool;
+    pub fn rust_enumerated_ref_put(r: *mut c::enumerated_ref);
+    pub fn rust_enumerated_ref_is_zero(r: *mut c::enumerated_ref) -> bool;
+    pub fn enumerated_ref_to_text(out: *mut c::printbuf, r: *mut c::enumerated_ref,
+                                  names: *const *const crate::util::ffi::c_char);
+}
+
+impl enumerated_ref {
+    /// Each kind's count of refs held - @names the kinds', NULL terminated.
+    ///
+    /// # Safety
+    /// @names has an entry for each of this ref's kinds.
+    pub unsafe fn to_text(&self, out: &mut Printbuf,
+                          names: *const *const crate::util::ffi::c_char) {
+        unsafe { enumerated_ref_to_text(out.as_raw(), core::ptr::from_ref(self).cast_mut(), names) }
+    }
+}
diff --git a/fs/bcachefs/util/eytzinger.c b/fs/bcachefs/util/eytzinger.c
new file mode 100644
index 0000000..1f384de
--- /dev/null
+++ b/fs/bcachefs/util/eytzinger.c
@@ -0,0 +1,327 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include "eytzinger.h"
+#include <linux/sched.h>
+
+/**
+ * is_aligned - is this pointer & size okay for word-wide copying?
+ * @base: pointer to data
+ * @size: size of each element
+ * @align: required alignment (typically 4 or 8)
+ *
+ * Returns true if elements can be copied using word loads and stores.
+ * The size must be a multiple of the alignment, and the base address must
+ * be if we do not have CONFIG_HAVE_EFFICIENT_UNALIGNED_ACCESS.
+ *
+ * For some reason, gcc doesn't know to optimize "if (a & mask || b & mask)"
+ * to "if ((a | b) & mask)", so we do that by hand.
+ */
+__attribute_const__ __always_inline
+static bool is_aligned(const void *base, size_t size, unsigned char align)
+{
+	unsigned char lsbits = (unsigned char)size;
+
+	(void)base;
+#ifndef CONFIG_HAVE_EFFICIENT_UNALIGNED_ACCESS
+	lsbits |= (unsigned char)(uintptr_t)base;
+#endif
+	return (lsbits & (align - 1)) == 0;
+}
+
+/**
+ * swap_words_32 - swap two elements in 32-bit chunks
+ * @a: pointer to the first element to swap
+ * @b: pointer to the second element to swap
+ * @n: element size (must be a multiple of 4)
+ *
+ * Exchange the two objects in memory.  This exploits base+index addressing,
+ * which basically all CPUs have, to minimize loop overhead computations.
+ *
+ * For some reason, on x86 gcc 7.3.0 adds a redundant test of n at the
+ * bottom of the loop, even though the zero flag is still valid from the
+ * subtract (since the intervening mov instructions don't alter the flags).
+ * Gcc 8.1.0 doesn't have that problem.
+ */
+static void swap_words_32(void *a, void *b, size_t n)
+{
+	do {
+		u32 t = *(u32 *)(a + (n -= 4));
+		*(u32 *)(a + n) = *(u32 *)(b + n);
+		*(u32 *)(b + n) = t;
+	} while (n);
+}
+
+/**
+ * swap_words_64 - swap two elements in 64-bit chunks
+ * @a: pointer to the first element to swap
+ * @b: pointer to the second element to swap
+ * @n: element size (must be a multiple of 8)
+ *
+ * Exchange the two objects in memory.  This exploits base+index
+ * addressing, which basically all CPUs have, to minimize loop overhead
+ * computations.
+ *
+ * We'd like to use 64-bit loads if possible.  If they're not, emulating
+ * one requires base+index+4 addressing which x86 has but most other
+ * processors do not.  If CONFIG_64BIT, we definitely have 64-bit loads,
+ * but it's possible to have 64-bit loads without 64-bit pointers (e.g.
+ * x32 ABI).  Are there any cases the kernel needs to worry about?
+ */
+static void swap_words_64(void *a, void *b, size_t n)
+{
+	do {
+#ifdef CONFIG_64BIT
+		u64 t = *(u64 *)(a + (n -= 8));
+		*(u64 *)(a + n) = *(u64 *)(b + n);
+		*(u64 *)(b + n) = t;
+#else
+		/* Use two 32-bit transfers to avoid base+index+4 addressing */
+		u32 t = *(u32 *)(a + (n -= 4));
+		*(u32 *)(a + n) = *(u32 *)(b + n);
+		*(u32 *)(b + n) = t;
+
+		t = *(u32 *)(a + (n -= 4));
+		*(u32 *)(a + n) = *(u32 *)(b + n);
+		*(u32 *)(b + n) = t;
+#endif
+	} while (n);
+}
+
+/**
+ * swap_bytes - swap two elements a byte at a time
+ * @a: pointer to the first element to swap
+ * @b: pointer to the second element to swap
+ * @n: element size
+ *
+ * This is the fallback if alignment doesn't allow using larger chunks.
+ */
+static void swap_bytes(void *a, void *b, size_t n)
+{
+	do {
+		char t = ((char *)a)[--n];
+		((char *)a)[n] = ((char *)b)[n];
+		((char *)b)[n] = t;
+	} while (n);
+}
+
+/*
+ * The values are arbitrary as long as they can't be confused with
+ * a pointer, but small integers make for the smallest compare
+ * instructions.
+ */
+#define SWAP_WORDS_64 (swap_r_func_t)0
+#define SWAP_WORDS_32 (swap_r_func_t)1
+#define SWAP_BYTES    (swap_r_func_t)2
+#define SWAP_WRAPPER  (swap_r_func_t)3
+
+struct wrapper {
+	cmp_func_t cmp;
+	swap_func_t swap_func;
+};
+
+/*
+ * The function pointer is last to make tail calls most efficient if the
+ * compiler decides not to inline this function.
+ */
+static void do_swap(void *a, void *b, size_t size, swap_r_func_t swap_func, const void *priv)
+{
+	if (swap_func == SWAP_WRAPPER) {
+		((const struct wrapper *)priv)->swap_func(a, b, (int)size);
+		return;
+	}
+
+	if (swap_func == SWAP_WORDS_64)
+		swap_words_64(a, b, size);
+	else if (swap_func == SWAP_WORDS_32)
+		swap_words_32(a, b, size);
+	else if (swap_func == SWAP_BYTES)
+		swap_bytes(a, b, size);
+	else
+		swap_func(a, b, (int)size, priv);
+}
+
+#define _CMP_WRAPPER ((cmp_r_func_t)0L)
+
+static int do_cmp(const void *a, const void *b, cmp_r_func_t cmp, const void *priv)
+{
+	if (cmp == _CMP_WRAPPER)
+		return ((const struct wrapper *)priv)->cmp(a, b);
+	return cmp(a, b, priv);
+}
+
+static inline int eytzinger1_do_cmp(void *base1, size_t n, size_t size,
+			 cmp_r_func_t cmp_func, const void *priv,
+			 size_t l, size_t r)
+{
+	return do_cmp(base1 + inorder_to_eytzinger1(l, n) * size,
+		      base1 + inorder_to_eytzinger1(r, n) * size,
+		      cmp_func, priv);
+}
+
+static inline void eytzinger1_do_swap(void *base1, size_t n, size_t size,
+			   swap_r_func_t swap_func, const void *priv,
+			   size_t l, size_t r)
+{
+	do_swap(base1 + inorder_to_eytzinger1(l, n) * size,
+		base1 + inorder_to_eytzinger1(r, n) * size,
+		size, swap_func, priv);
+}
+
+void eytzinger1_sort_r(void *base1, size_t n, size_t size,
+		       cmp_r_func_t cmp_func,
+		       swap_r_func_t swap_func,
+		       const void *priv)
+{
+	unsigned i, j, k;
+
+	/* called from 'sort' without swap function, let's pick the default */
+	if (swap_func == SWAP_WRAPPER && !((struct wrapper *)priv)->swap_func)
+		swap_func = NULL;
+
+	if (!swap_func) {
+		if (is_aligned(base1, size, 8))
+			swap_func = SWAP_WORDS_64;
+		else if (is_aligned(base1, size, 4))
+			swap_func = SWAP_WORDS_32;
+		else
+			swap_func = SWAP_BYTES;
+	}
+
+	/* heapify */
+	for (i = n / 2; i >= 1; --i) {
+		/* Find the sift-down path all the way to the leaves. */
+		for (j = i; k = j * 2, k < n;)
+			j = eytzinger1_do_cmp(base1, n, size, cmp_func, priv, k, k + 1) > 0 ? k : k + 1;
+
+		/* Special case for the last leaf with no sibling. */
+		if (j * 2 == n)
+			j *= 2;
+
+		/* Backtrack to the correct location. */
+		while (j != i && eytzinger1_do_cmp(base1, n, size, cmp_func, priv, i, j) >= 0)
+			j /= 2;
+
+		/* Shift the element into its correct place. */
+		for (k = j; j != i;) {
+			j /= 2;
+			eytzinger1_do_swap(base1, n, size, swap_func, priv, j, k);
+		}
+
+		cond_resched();
+	}
+
+	/* sort */
+	for (i = n; i > 1; --i) {
+		eytzinger1_do_swap(base1, n, size, swap_func, priv, 1, i);
+
+		/* Find the sift-down path all the way to the leaves. */
+		for (j = 1; k = j * 2, k + 1 < i;)
+			j = eytzinger1_do_cmp(base1, n, size, cmp_func, priv, k, k + 1) > 0 ? k : k + 1;
+
+		/* Special case for the last leaf with no sibling. */
+		if (j * 2 + 1 == i)
+			j *= 2;
+
+		/* Backtrack to the correct location. */
+		while (j >= 1 && eytzinger1_do_cmp(base1, n, size, cmp_func, priv, 1, j) >= 0)
+			j /= 2;
+
+		/* Shift the element into its correct place. */
+		for (k = j; j > 1;) {
+			j /= 2;
+			eytzinger1_do_swap(base1, n, size, swap_func, priv, j, k);
+		}
+
+		cond_resched();
+	}
+}
+
+void eytzinger1_sort(void *base, size_t n, size_t size,
+		     cmp_func_t cmp_func,
+		     swap_func_t swap_func)
+{
+	struct wrapper w = {
+		.cmp  = cmp_func,
+		.swap_func = swap_func,
+	};
+
+	return eytzinger1_sort_r(base, n, size, _CMP_WRAPPER, SWAP_WRAPPER, &w);
+}
+
+void eytzinger0_sort_r(void *base, size_t n, size_t size,
+		       cmp_r_func_t cmp_func,
+		       swap_r_func_t swap_func,
+		       const void *priv)
+{
+	void *base1 = base - size;
+
+	return eytzinger1_sort_r(base1, n, size, cmp_func, swap_func, priv);
+}
+
+void eytzinger0_sort(void *base, size_t n, size_t size,
+		     cmp_func_t cmp_func,
+		     swap_func_t swap_func)
+{
+	struct wrapper w = {
+		.cmp  = cmp_func,
+		.swap_func = swap_func,
+	};
+
+	return eytzinger0_sort_r(base, n, size, _CMP_WRAPPER, SWAP_WRAPPER, &w);
+}
+
