+
+/// IOPRIO_PRIO_VALUE(IOPRIO_CLASS_IDLE, 0): background IO yields to everyone else's.
+pub(crate) const IOPRIO_IDLE: u16 = 3 << 13;
+
+/// Both scrub types read to check, and must never rewrite what they're checking.
+pub(crate) fn is_scrub(t: Type) -> bool {
+    matches!(t, Type::BCH_DATA_UPDATE_scrub | Type::BCH_DATA_UPDATE_scrub_no_repair)
+}
+
+impl c::data_update_opts {
+    /// A checksummed extent with unchecksummed pointers: we mustn't apply the
+    /// existing checksum to unchecksummed data, or lose the ability to tell
+    /// that replicas differ. So read from the replica being rewritten, and
+    /// rewrite only that one.
+    fn checksummed_and_non_checksummed_handling(&mut self, fs: &Fs, k: BkeySC<'_>) {
+        let Some(kp) = k.arm::<Ptrs>() else { return };
+
+        let paranoia = self.bits.checksum_paranoia() || kp.ptrs_decoded(fs).any(|d| d.p.crc.csum_type == 0);
+        self.bits.set_checksum_paranoia(paranoia);
+        if !paranoia {
+            return;
+        }
+
+        let mut rewrite_found = false;
+        for (i, ptr) in kp.ptrs(fs).enumerate() {
+            let bit = 1u16 << i;
+            if bit & self.ptrs_kill != 0 && ptr.cached() == 0 {
+                if !rewrite_found {
+                    rewrite_found = true;
+                    self.read_dev = ptr.dev().into();
+                } else {
+                    self.ptrs_kill &= !bit;
+                }
+            }
+        }
+    }
+}
+
+fn dev_ptr_bit(fs: &Fs, k: BkeySC<'_>, dev: u32) -> u32 {
+    k.arm::<Ptrs>()
+        .and_then(|k| k.ptrs(fs).position(|ptr| u32::from(ptr.dev()) == dev))
+        .map_or(0, |i| 1 << i)
+}
+
+/// For an update with nothing to write: drops @k's killed pointers and extra
+/// cached pointers, and commits.
+fn extent_drop_ptrs(t: &TransAttempt<'_, '_>, iter: &BtreeIter<'_>, k: BkeySC<'_>,
+                    io_opts: &c::bch_inode_opts, data_opts: &c::data_update_opts) -> Result<(), BchError> {
+    let fs = t.fs();
+    // an extents btree update always wants a reservation passed in
+    let res = DiskReservation::new(fs);
+    let mut n = t.bkey_make_mut_noupdate(k)?;
+
+    if let Some(kp) = BkeyS::from(&mut n).arm::<PtrsMut>() {
+        brand(kp, |mut kp| -> Result<(), BchError> {
+            if data_opts.ptrs_kill_ec != 0 {
+                let m = kp.assume(fs, data_opts.ptrs_kill_ec.into());
+                drop_extra_ec_durability(t, io_opts, &mut kp, m)?;
+            }
+            if data_opts.ptrs_kill != 0 {
+                let m = kp.assume(fs, data_opts.ptrs_kill.into());
+                drop_extra_durability(t, io_opts, kp, m, false)?;
+            }
+            Ok(())
+        })?;
+    }
+
+    // An extent left with no pointers is normalized into what it should be -
+    // KEY_TYPE_error, or a discard for a cached one
+    if let Some(mut kp) = BkeyS::from(&mut n).arm::<Ptrs>() {
+        kp.drop_extra_cached_ptrs(fs, io_opts);
+    }
+
+    // We're not inserting through an extent iterator - an all_snapshots
+    // iterator isn't one - so a deletion takes the plain key deletion path,
+    // not the extent overwrite path
+    if n.k().is_deleted() && !iter.iter_flags().contains(BtreeIterFlags::IS_EXTENTS) {
+        n.k_mut().size = 0;
+    }
+
+    t.relock()?;
+    t.update(iter, &n, UpdateTriggerFlags::INTERNAL_SNAPSHOT_NODE)?;
+    t.commit(Some(&res), CommitFlags::NO_ENOSPC)
+}
+
+impl c::data_update {
+    fn fs(&self) -> &'static Fs {
+        self.op.fs()
+    }
+
+    fn key(&self) -> BkeySC<'_> {
+        BkeySC::from(self.k.key())
+    }
+
+    /// The read and write bios share bvecs and pages: the write writes what
+    /// the read filled in.
+    fn bios_init(&mut self, io_opts: &c::bch_inode_opts, buf_bytes: u32) -> Result<(), BchError> {
+        let fs = self.fs();
+        let block_size = u32::from(fs.opts().block_size);
+        let buf_bytes = buf_bytes.next_multiple_of(block_size);
+        let nr_vecs = buf_bytes.div_ceil(crate::util::kernel::PAGE_SIZE as u32);
+
+        let layout = core::alloc::Layout::array::<c::bio_vec>(nr_vecs as usize).map_err(|_| BchError::from(c::ENOMEM))?;
+        self.bvecs = crate::util::alloc::kzalloc(layout).map_err(|_| BchError::from(c::ENOMEM))?.as_ptr().cast();
+
+        // SAFETY: its bios, and the bvecs just made for them
+        unsafe {
+            c::bio_init(&mut self.rbio.bio, core::ptr::null_mut(), self.bvecs, nr_vecs as u16, c::req_op_REQ_OP_READ as _);
+            c::bio_init(&mut self.op.wbio.bio, core::ptr::null_mut(), self.bvecs, nr_vecs as u16, 0);
+        }
+        if pages::alloc_pages(&mut self.op.wbio.bio, block_size, buf_bytes as usize, c::GFP_KERNEL).is_err() {
+            self.bios_free();
+            return Err(c::ENOMEM.into());
+        }
+
+        self.rbio.init(fs, *io_opts, None);
+        self.rbio.bits_mut().set_data_update(1);
+        self.rbio.bio.bi_iter.bi_size = buf_bytes;
+        self.rbio.bio.bi_iter.bi_sector = self.key().k.start_offset();
+        self.op.wbio.bio.bi_ioprio = IOPRIO_IDLE;
+        Ok(())
+    }
+
+    /// The write bio's pages and the bvecs bios_init() made, freed.
+    fn bios_free(&mut self) {
+        // SAFETY: the pages are alloc_pages()'s, the bvecs bios_init()'s
+        // kzalloc(); neither bio is in flight
+        unsafe {
+            pages::free_pages_pool(self.fs(), &mut self.op.wbio.bio);
+            c::rust_kfree(self.bvecs.cast());
+        }
+        self.bvecs = core::ptr::null_mut();
+    }
+
+    fn trace(&self, ret: c_int) {
+        let fs = self.fs();
+        let size = u64::from(self.key().k.size);
+        match ret_to_result_void(ret) {
+            Ok(()) => fs.event_add_trace(events::data_update, size, |out| self.to_text(out)),
+            Err(e) if e.matches(bch_errcode::BCH_ERR_data_update_done) =>
+                fs.event_add_trace(events::data_update_no_io, size, |out| {
+                    self.to_text(out);
+                    prt!(out, "\nret:\t{e}\n");
+                }),
+            Err(e) if fail_should_trace(self.opts.type_, e) =>
+                fs.event_add_trace(events::data_update_fail, size, |out| {
+                    self.to_text(out);
+                    prt!(out, "\nret:\t{e}\n");
+                }),
+            Err(_) => {}
+        }
+    }
+
+    /// An unwritten extent has no data to move: unwritten space is allocated
+    /// at the destination a piece at a time, each piece's index update done as
+    /// it's allocated. Runs transactions of its own.
+    fn update_unwritten_extent(&mut self, trans: &BtreeTrans<'_>) -> Result<(), BchError> {
+        let fs = self.fs();
+        stack_pin_init!(let cl = StackClosure::new());
+        // SAFETY: the op's own buffer, which the keys stay in
+        unsafe { self.op.insert_keys.init(self.op.inline_keys.as_mut_ptr()) };
+
+        let end = self.key().k.p;
+        let ret = (|| {
+            while self.op.pos < end {
+                let t = trans.begin();
+                let mut iter = BtreeIter::new(&t, self.btree_id, self.op.pos, BtreeIterFlags::SLOTS);
+                let ours = BkeySC::from(self.k.key());
+                if !lockrestart_do(trans, |t| {
+                    let k = iter.peek_slot(t)?.expect("a slot always has a key");
+                    Ok(crate::data::ptrs::extents_match(fs, k, ours))
+                })? {
+                    break;
+                }
+                drop(iter);
+
+                let e = self.op.insert_keys.top();
+                // SAFETY: the keylist's room for the next key
+                unsafe {
+                    (*e).k = c::bkey { type_: c::bch_bkey_type::KEY_TYPE_extent.0 as u8, p: self.op.pos, ..c::bkey::new() }
+                };
+
+                let t = trans.begin();
+                let op = &mut self.op;
+                let nr = op.bits.nr_replicas().into();
+                let r = t.alloc_request(op.target.into(), false, &mut op.devs_have, nr, nr,
+                                        c::bch_watermark::from_bits(op.bits.watermark().into()),
+                                        c::bch_write_flags::from_bits_retain(op.flags.into()), cl.as_ptr())
+                    .and_then(|mut req| t.alloc_sectors(&mut req, op.write_point));
+                let mut wp = match r {
+                    Ok(wp) => wp,
+                    Err(e) if e.matches(bch_errcode::BCH_ERR_operation_blocked) => {
+                        trans.unlock();
+                        cl.sync();
+                        continue;
+                    }
+                    Err(e) => {
+                        if should_print_err(&e) {
+                            bch_err_ratelimited!(fs, "{}(): error allocating for an unwritten extent: {e}",
+                                                 function_name!());
+                        }
+                        return Err(e);
+                    }
+                };
+                let sectors = ((end.offset - op.pos.offset) as u32).min(wp.sectors_free());
+                // SAFETY: the keylist's room for the key, at top()
+                unsafe { (*e).k.resize(sectors) };
+                wp.open_buckets_get(&mut op.open_buckets);
+                // SAFETY: the op's inline keys hold an extent of any width
+                unsafe { wp.append_ptrs(e, sectors) };
+                drop(wp);
+
+                op.pos.offset += u64::from(sectors);
+
+                // SAFETY: the whole key at top()
+                let ek = unsafe { &mut *BkeyI::from_raw_mut(e) };
+                if let Some(mut ek) = BkeyS::from(ek).arm::<PtrsMut>() {
+                    ek.ptrs_mut(fs).for_each(|ptr| ptr.set_unwritten(1));
+                }
+                // SAFETY: as above
+                unsafe { op.insert_keys.push() };
+
+                let r = crate::data::update_index::index_update(trans, self);
+                drop(self.op.open_buckets.drain(fs));
+                r?;
+            }
+            Ok(())
+        })();
+
+        if cl.nr_remaining() != 1 {
+            trans.unlock();
+            cl.sync();
+        }
+        ret
+    }
+
+    /// Sets the update up against @k, in @t's attempt; @iter points at @k, and
+    /// a promote has none. On error everything taken has been given back, and
+    /// data_update_done_* means there's nothing to read.
+    ///
+    /// # Safety
+    /// The update is zeroed, and doesn't move until exit().
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) unsafe fn init(&mut self, t: &TransAttempt<'_, '_>, iter: Option<&BtreeIter<'_>>, moving: Option<&Moving<'_>>,
+                   wp: c::write_point_specifier, io_opts: &c::bch_inode_opts, data_opts: c::data_update_opts,
+                   btree_id: c::btree_id, k: BkeySC<'_>) -> Result<Held, BchError> {
+        let fs = t.fs();
+        let pos = c::bbpos {
+            btree: iter.map_or(c::btree_id::extents, |i| i.btree()),
+            pos:   k.k.p,
+        };
+
+        // SAFETY: the caller's: it stays where it is
+        unsafe { self.k.init() };
+        self.k.reassemble(k);
+
+        self.btree_id = btree_id;
+        self.opts = data_opts;
+        self.ctxt = moving.map_or(core::ptr::null_mut(), Moving::raw);
+        // SAFETY: a context's exit waits for what's in flight in it, and its
+        // stats outlive it
+        self.stats = moving.and_then(Moving::stats_opt).map(|s| unsafe { BackRef::new(s) });
+
+        // SAFETY: an update is done before the filesystem goes
+        unsafe { self.op.init(fs, *io_opts) };
+        self.op.pos = self.k.key().k().start_pos();
+        self.op.version = self.k.key().k().bversion;
+        self.op.target = data_opts.target;
+        self.op.write_point = wp;
+        use c::bch_write_flags as w;
+        self.op.flags |= (w::BCH_WRITE_pages_stable | w::BCH_WRITE_pages_owned | w::BCH_WRITE_data_encoded |
+                          w::BCH_WRITE_move | data_opts.write_flags).bits() as u16;
+        self.op.bits.set_compression_opt(io_opts.background_compression);
+        let watermark = (data_opts.commit_flags.bits() & c::BCH_WATERMARK_MASK)
+            .max(c::bch_watermark::BCH_WATERMARK_normal as u32);
+        self.op.bits.set_watermark(watermark as u8);
+
+        let ret = self.init_body(t, iter, io_opts, pos);
+
+        if let Err(e) = &ret {
+            if !is_restart(e) {
+                self.trace(ret_to_c(Err::<(), _>(*e)));
+            }
+            self.op.res.put();
+            self.k.exit();
+        }
+        ret
+    }
+
+    /// On error, Held's guards - locals till it returns - are dropped; init()
+    /// gives back the rest.
+    fn init_body(&mut self, t: &TransAttempt<'_, '_>, iter: Option<&BtreeIter<'_>>,
+                 io_opts: &c::bch_inode_opts, pos: c::bbpos) -> Result<Held, BchError> {
+        let fs = self.fs();
+        let mut held = Held { in_flight: None, nocow: None, devs: Default::default() };
+        let type_ = self.opts.type_;
+        let k = BkeySC::from(self.k.key());
+
+        let snapshot = k.k.p.snapshot;
+        if type_ != Type::BCH_DATA_UPDATE_scrub_no_repair && snapshot != 0 && !fs.snapshots.exists(snapshot) {
+            let r = match crate::snapshots::check_snapshots::check_key_has_snapshot(t, iter, k) {
+                Ok(false) => Ok(()),
+                // the key was deleted
+                Ok(true) => t.commit(Some(&self.op.res), CommitFlags::NO_ENOSPC)
+                    .and_then(|()| fs.throw(bch_errcode::BCH_ERR_data_update_fail_no_snapshot)),
+                Err(e) => Err(e),
+            };
+            // can't repair yet, waiting on other recovery passes
+            r.map_err(|e| if e.matches(bch_errcode::BCH_ERR_recovery_will_run) {
+                fs.err(bch_errcode::BCH_ERR_data_update_fail_no_snapshot)
+            } else {
+                e
+            })?;
+        }
+
+        if self.opts.extra_replicas != 0 {
+            // the reservation's first charge: op.init() zeroed it
+            self.op.res.add(k.k.size.into(), self.opts.extra_replicas.into(), c::bch_reservation_flags::empty())?;
+        }
+
+        if self.opts.ptrs_kill != 0 && self.op.opts.data_checksum != 0 {
+            self.opts.checksummed_and_non_checksummed_handling(fs, k);
+        }
+
+        let mut buf_bytes = 0u32;
+        let mut unwritten = false;
+        let mut keeping = 0u32;
+        if let Some(kp) = k.arm::<Ptrs>() {
+            let mut bit = 1u32;
+            for d in kp.ptrs_decoded(fs) {
+                let p = &d.p;
+                if bit & u32::from(self.opts.ptrs_kill) == 0 {
+                    keeping += if bit & u32::from(self.opts.ptrs_kill_ec) != 0 {
+                        fs.dev_durability(p.ptr.dev().into(), &read_lock())
+                    } else {
+                        extent_ptr_durability(t, p)?
+                    };
+                    if !self.opts.bits.no_devs_have() && p.ptr.cached() == 0 {
+                        self.op.devs_have.add(p.ptr.dev());
+                    }
+                }
+
+                // An encrypted extent must stay encrypted - but only its class
+                // is forced, not its exact type: reconcile must be able to
+                // change the MAC width, or a wide_macs change livelocks it
+                let csum = c::bch_csum_type(p.crc.csum_type.into());
+                if csum.is_encryption() {
+                    self.op.nonce = (u32::from(p.crc.nonce) + u32::from(p.crc.offset)) as u16;
+                    if !c::bch_csum_type(self.op.bits.csum_type().into()).is_encryption() {
+                        self.op.bits.set_csum_type(p.crc.csum_type);
+                    }
+                }
+
+                if u32::from(p.crc.compression_type) == c::bch_compression_type::BCH_COMPRESSION_TYPE_incompressible.0 {
+                    self.op.bits.set_incompressible(1);
+                }
+
+                buf_bytes = buf_bytes.max(p.crc.uncompressed_size << 9);
+                unwritten |= p.ptr.unwritten() != 0;
+                bit <<= 1;
+            }
+        }
+
+        if !is_scrub(type_) {
+            // A move that only relocates keeps its old pointers if the write
+            // comes up short, so a short write isn't degraded; one restoring
+            // lost durability needs every copy it asks for
+            let d = k.durability(t)?;
+            if d.online >= io_opts.data_replicas {
+                self.op.flags |= c::bch_write_flags::BCH_WRITE_replicas_best_effort.bits() as u16;
+            }
+
+            // Short of data_replicas, don't rereplicate up to it unless
+            // extra_replicas asks: rereplicating is an explicit operation, so
+            // users don't get an unexpected ENOSPC
+            let mut nr = (i32::from(io_opts.data_replicas) - keeping as i32).max(0) as u32 +
+                self.op.res.nr_replicas.get();
+            if keeping == 0 {
+                nr = nr.max(1);
+                self.op.flags &= !(c::bch_write_flags::BCH_WRITE_cached.bits() as u16);
+            }
+            self.op.bits.set_nr_replicas(nr as u8);
+
+            // No new replicas needed: the settings changed since it was
+            // written
+            if nr == 0 {
+                // without @iter, it's a promote
+                if let Some(iter) = iter {
+                    extent_drop_ptrs(t, iter, k, io_opts, &self.opts)?;
+                }
+                return fs.throw(bch_errcode::BCH_ERR_data_update_done_no_writes_needed);
+            }
+
+            // Check that the write can allocate, rather than failing in
+            // bch2_write() after a useless read: alloc_nowait (promotes), a
+            // full or offline target, too little durability on it
+            if type_ != Type::BCH_DATA_UPDATE_copygc {
+                fs.data_update_write_feasible(io_opts, &self.opts, &self.op.devs_have, k, None)?;
+            }
+
+            held.in_flight = fs.data_update_in_flight_add(self, pos)?;
+        } else if unwritten {
+            return fs.throw(bch_errcode::BCH_ERR_data_update_done_unwritten);
+        }
+
+        let k = BkeySC::from(self.k.key());
+        if let Some(kp) = k.arm::<Ptrs>() {
+            for (i, ptr) in kp.ptrs(fs).enumerate() {
+                // the error is a missing device's repair being scheduled
+                held.devs[i] = fs.dev_bkey_tryget(k, ptr.dev().into()).ok().flatten();
+            }
+        }
+
+        if fs.opts().nocow_enabled != 0 {
+            let devs = &held.devs;
+            held.nocow = Some(match nocow_locking::bkey_trylock(fs, k, devs, NocowKind::Copy) {
+                Some(l) => l,
+                None => {
+                    let Some(moving) = self.moving() else {
+                        // a promote mustn't block, or they'd pile up
+                        return fs.throw(bch_errcode::BCH_ERR_nocow_lock_blocked);
+                    };
+                    // @t's transaction is the mover's own here. Wait for the
+                    // locks, or until nothing we have in flight could release
+                    // them - then block for them with the transaction unlocked
+                    let locked = moving.wait_until(|| match nocow_locking::bkey_trylock(fs, k, devs, NocowKind::Copy) {
+                        Some(l) => Some(Some(l)),
+                        None => moving.updates_idle().then_some(None),
+                    });
+                    locked.unwrap_or_else(|| {
+                        t.trans().unlock();
+                        nocow_locking::bkey_lock(fs, Some(t.trans()), k, devs, NocowKind::Copy)
+                    })
+                }
+            });
+        }
+
+        if unwritten {
+            t.ignore_restarts(|trans| self.update_unwritten_extent(trans))?;
+            return fs.throw(bch_errcode::BCH_ERR_data_update_done_unwritten);
+        }
+
+        t.trans().unlock();
+
+        self.bios_init(io_opts, buf_bytes)?;
+
+        self.rbio.bits_mut().set_data_update_verify_decompress(u8::from(type_ == Type::BCH_DATA_UPDATE_scrub));
+        Ok(held)
+    }
+
+    /// Whether there's a write for write() to issue. There isn't for a failed
+    /// read, a scrub with nothing to repair, or IO errors that leave nothing to
+    /// write: then op.error is the update's result.
+    pub fn read_done(&mut self) -> bool {
+        let fs = self.fs();
+        let mut crc = self.rbio.pick.crc;
+        let type_ = self.opts.type_;
+
+        // Before the bitrot fixup below, which clears rbio.ret. The damage is
+        // recorded at btree_id, not the read path's read_pos, which for an
+        // indirect extent is a reflink position
+        if let Err(e) = ret_to_result_void(self.rbio.ret.into()) {
+            if !read_err_benign(e) {
+                if type_ == Type::BCH_DATA_UPDATE_scrub_no_repair {
+                    // the journal scrub can't commit: see bch2_scrub_journal_queue()
+                    let bit = dev_ptr_bit(fs, self.key(), self.rbio.pick.ptr.dev().into());
+                    // SAFETY: its key, which the queue copies
+                    unsafe { bch2_scrub_journal_queue(fs.as_ptr(), self.btree_id, 0, self.k.k, bit, self.rbio.ret.into()) };
+                } else {
+                    // SAFETY: maps an error code; no pointers
+                    let err = unsafe { bch2_data_read_sb_err(self.rbio.ret.into()) };
+                    let (btree, pos) = (self.btree_id, self.key().k.p);
+                    let r = trans_commit_do(fs, None, CommitFlags::NO_ENOSPC,
+                                            |t| crate::init::damage::record_key(t, btree, pos, err));
+                    if let Err(e) = r {
+                        if should_print_err(&e) {
+                            bch_err_ratelimited!(fs, "{}(): error recording a data update's read error: {e}",
+                                                 function_name!());
+                        }
+                    }
+                }
+            }
+        }
+
+        // A bitrotted extent gets a new checksum so it can be moved; its
+        // poison bit keeps reads of it returning errors
+        let poisoned = self.key().arm::<Ptrs>()
+            .is_some_and(|k| k.extent_flags(fs) & (1 << c::bch_extent_flags_e::BCH_EXTENT_FLAG_poisoned.0) != 0);
+        if i32::from(self.rbio.ret) == -(bch_errcode::BCH_ERR_data_read_csum_err.0 as i32) && poisoned {
+            let nonce = crate::data::ptrs::extent_nonce(self.rbio.version, &crc);
+            // SAFETY: the read's bio, done, its data in
+            let bio = unsafe { crate::util::bio::Bio::from_raw(&self.rbio.bio) };
+            crc.csum = fs.checksum_range(c::bch_csum_type(crc.csum_type.into()), nonce, bio.range());
+            self.rbio.ret = 0;
+        }
+
+        if self.rbio.ret != 0 {
+            self.op.error = self.rbio.ret;
+            return false;
+        }
+
+        if type_ == Type::BCH_DATA_UPDATE_scrub_no_repair {
+            if self.opts.ptrs_io_error != 0 {
+                // SAFETY: as above
+                unsafe {
+                    bch2_scrub_journal_queue(fs.as_ptr(), self.btree_id, 0, self.k.k, self.opts.ptrs_io_error.into(), 0)
+                };
+            }
+            return false;
+        }
+
+        if type_ == Type::BCH_DATA_UPDATE_scrub && self.opts.ptrs_io_error == 0 {
+            return false;
+        }
+
+        if self.opts.ptrs_io_error != 0 {
+            let trans = crate::btree_trans!(fs);
+            let k = BkeySC::from(self.k.key());
+            if let Some(kp) = k.arm::<Ptrs>() {
+                let mut nr = u32::from(self.op.bits.nr_replicas());
+                let mut bit = 1u32;
+                for d in kp.ptrs_decoded(fs) {
+                    if bit & u32::from(self.opts.ptrs_io_error) != 0 && bit & u32::from(self.opts.ptrs_kill) == 0 {
+                        if let Ok(dur) = lockrestart_do(&trans, |t| extent_ptr_durability(t, &d.p)) {
+                            nr += dur;
+                        }
+                        self.opts.ptrs_kill |= bit as u16;
+                        self.op.devs_have.drop(d.p.ptr.dev());
+                    }
+                    bit <<= 1;
+                }
+                self.op.bits.set_nr_replicas(nr as u8);
+            }
+
+            if self.op.bits.nr_replicas() == 0 {
+                self.op.error = ret_to_c(crate::data::update_index::index_update_nowrite(&trans, self)) as i16;
+                return false;
+            }
+        }
+
+        assert!(self.op.wbio.bio.bi_vcnt != 0, "a data update's write bio must own its pages");
+
+        self.op.crc = crc;
+        self.op.wbio.bio.bi_iter.bi_size = crc.compressed_size << 9;
+        true
+    }
+
+    /// Issues the write read_done() set up; it completes to op.end_io().
+    pub fn write(&mut self) {
+        // SAFETY: its op, ready to write
+        unsafe { c::closure_call(&mut self.op.cl, Some(bch2_write), core::ptr::null_mut(), core::ptr::null_mut()) };
+    }
+
+    /// Gives back what init() took: @held, the reservation, its place in its
+    /// moving context's counts - whose waiters are woken after the nocow locks
+    /// go - and the bios' memory.
+    pub(crate) fn exit(&mut self, held: Held, ret: c_int) {
+        self.trace(ret);
+        drop(held);
+        self.op.res.put();
+
+        if let Some(moving) = self.moving() {
+            moving.update_done(self.io_seq);
+            moving.wake();
+        }
+
+        self.bios_free();
+    }
+}
+
diff --git a/fs/bcachefs/data/update_feasible.rs b/fs/bcachefs/data/update_feasible.rs
new file mode 100644
index 0000000..951d70a
--- /dev/null
+++ b/fs/bcachefs/data/update_feasible.rs
@@ -0,0 +1,264 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Whether a data update can be done now, checked before reading anything: a
+//! write that can't succeed fails here, with its reason, instead of after a
+//! wasted read. Movers check before setting an update up; init() checks
+//! again, except for copygc.
+//!
+//! The check is on durability: what the update keeps, plus room on the target
+//! for the rest of the replicas - rw devices without a kept copy, with free
+//! buckets at the update's watermark. If copygc could free buckets, the error
+//! is need_copygc and copygc is woken, so the update can come back later;
+//! otherwise it's no_rw_devs. must_ec also needs a stripe head. Reconcile's
+//! btree node rewrites are checked differently: whether a rewrite would
+//! improve anything.
+//!
+//! Each check can explain itself into a trace, for reconcile_set_pending.
+
+use crate::alloc::disk_groups::Target;
+use crate::btree::bkey::{BkeySC, BkeyV};
+use crate::btree::iter::{BtreeTrans, TransAttempt};
+use crate::c;
+use crate::c::bch_errcode;
+use crate::data::copygc;
+use crate::data::durability::{extent_ptr_durability, BkeyVDurability};
+use crate::data::ec::head::{head_get, stripe_head_put};
+use crate::data::ptrs::{BkeyVPtrs, BtreePtrs, Ptrs};
+use crate::errcode::{ret_to_c, BchError};
+use crate::fs::Fs;
+use crate::util::rcu::read_lock;
+use crate::util::Printbuf;
+use core::ffi::c_int;
+use cstruct_macros::c_export;
+
+use c::bch_write_flags as w;
+
+#[derive(Clone, Copy, Default)]
+struct Available {
+    durability:  u32,
+    /// A device had no free buckets, but copygc can make some
+    need_copygc: bool,
+}
+
+fn no_room<T>(fs: &Fs, need_copygc: bool) -> Result<T, BchError> {
+    fs.throw(if need_copygc {
+        bch_errcode::BCH_ERR_data_update_fail_need_copygc
+    } else {
+        bch_errcode::BCH_ERR_data_update_fail_no_rw_devs
+    })
+}
+
+fn watermark(data_opts: &c::data_update_opts) -> c::bch_watermark {
+    c::bch_watermark::from_bits(data_opts.commit_flags.bits() & c::BCH_WATERMARK_MASK)
+}
+
+impl Fs {
+    /// Durability available to a write to @target, 0 meaning every device. A
+    /// cached write counts 1 per device.
+    fn durability_available(&self, data_opts: &c::data_update_opts, data_type: c::bch_data_type,
+                            target: u32, devs_have: &c::bch_devs_list,
+                            mut trace: Option<&mut Printbuf>) -> Available {
+        if let Some(out) = trace.as_deref_mut() {
+            write!(out, "available to write on target=");
+            self.target_to_text(out, Target::decode(target));
+            out.newline();
+        }
+        let mut trace = trace.map(|out| out.indent(2));
+        let mut trace = trace.as_deref_mut().map(Printbuf::atomic);
+
+        let watermark = watermark(data_opts);
+        let cached = data_opts.write_flags.contains(w::BCH_WRITE_cached);
+
+        // copygc::can_make_progress() reads accounting for dev_leaving
+        let _mark = self.mark_lock().read();
+        let rcu = read_lock();
+        let devs = self.target_rw_devs(data_type, Target::decode(target));
+        let mut ret = Available::default();
+
+        for i in devs.d.iter() {
+            if devs_have.has(i as u8) {
+                continue;
+            }
+            let Some(ca) = self.dev_rcu(i as u32, &rcu) else { continue };
+
+            let free = ca.free_buckets_at(&ca.usage_read_fast(), watermark);
+            if free != 0 {
+                ret.durability += if cached { 1 } else { ca.rw_durability() };
+            } else if copygc::can_make_progress(ca) {
+                ret.need_copygc = true;
+                self.copygc_wakeup();
+            }
+
+            if let Some(out) = trace.as_deref_mut() {
+                write!(out, "{}: durability {} free {free} \n",
+                       ca, ca.mi.get().durability);
+            }
+        }
+        ret
+    }
+
+    /// Ignores stripe pointers: btree pointers have none.
+    fn btree_ptr_durability_on_target(&self, k: BkeySC<'_, BtreePtrs>, target: u32) -> u32 {
+        let devs = self.target_rw_devs(c::bch_data_type::BCH_DATA_btree, Target::decode(target));
+        let rcu = read_lock();
+
+        k.ptrs(self)
+            .filter(|ptr| ptr.cached() == 0)
+            .map(|ptr| u32::from(ptr.dev()))
+            .filter(|&dev| dev != c::BCH_SB_MEMBER_INVALID && devs.d.test(dev as usize))
+            .map(|dev| self.dev_durability(dev, &rcu))
+            .sum()
+    }
+
+    fn btree_ptr_has_dev_evacuating(&self, k: BkeySC<'_, BtreePtrs>) -> bool {
+        let rcu = read_lock();
+        k.ptrs(self).any(|ptr| {
+            self.dev_rcu(ptr.dev().into(), &rcu)
+                .is_some_and(|ca| u32::from(ca.mi.get().state) == c::bch_member_state::BCH_MEMBER_STATE_evacuating.0)
+        })
+    }
+
+    /// A btree node rewrite replaces the whole node, so it's worth it only if
+    /// it improves something - replicas on target, durability, getting off an
+    /// evacuating device - without regressing. Node allocation spills off
+    /// target rather than failing, so a rewrite that can't improve placement
+    /// "succeeds" off target and requeues forever; and the replacement gets
+    /// whatever durability the filesystem has, which trades replicas for
+    /// placement if it's less - worth it only to evacuate.
+    fn write_btree_feasible(&self, opts: &c::bch_inode_opts, data_opts: &c::data_update_opts,
+                            k: BkeySC<'_, BtreePtrs>, mut trace: Option<&mut Printbuf>) -> Result<(), BchError> {
+        let evacuating = self.btree_ptr_has_dev_evacuating(k);
+        let replicas = u32::from(opts.data_replicas);
+
+        // Dropping excess replicas is progress regardless of placement
+        if u32::from(k.durability_safe(self).nr_ptrs) > replicas {
+            return Ok(());
+        }
+
+        let none = c::bch_devs_list::default();
+        let btree = c::bch_data_type::BCH_DATA_btree;
+        let target = data_opts.target.into();
+
+        let durability        = u32::from(k.btree_ptr_durability(self).total);
+        let target_durability = self.btree_ptr_durability_on_target(k, target);
+        let on_target         = self.durability_available(data_opts, btree, target, &none, trace.as_deref_mut());
+        let on_fs             = if target != 0 {
+            self.durability_available(data_opts, btree, 0, &none, trace.as_deref_mut())
+        } else {
+            on_target
+        };
+        let need_copygc = on_target.need_copygc || on_fs.need_copygc;
+
+        let improves_placement  = on_target.durability > target_durability;
+        let improves_durability = durability < replicas && on_fs.durability > durability;
+        let degrades            = on_fs.durability < durability.min(replicas);
+
+        let worth_it = if evacuating {
+            on_fs.durability > 0
+        } else {
+            (improves_placement || improves_durability) && !degrades
+        };
+        if worth_it { Ok(()) } else { no_room(self, need_copygc) }
+    }
+
+    pub fn data_update_write_feasible(&self, opts: &c::bch_inode_opts, data_opts: &c::data_update_opts,
+                                      devs_have: &c::bch_devs_list, k: BkeySC<'_>,
+                                      mut trace: Option<&mut Printbuf>) -> Result<(), BchError> {
+        let btree = k.arm::<BtreePtrs>();
+        if let Some(b) = btree.filter(|_| data_opts.type_ == c::bch_data_update_types::BCH_DATA_UPDATE_reconcile) {
+            return self.write_btree_feasible(opts, data_opts, b, trace);
+        }
+
+        let data_type = if btree.is_some() { c::bch_data_type::BCH_DATA_btree } else { c::bch_data_type::BCH_DATA_user };
+        let target = if data_opts.write_flags.contains(w::BCH_WRITE_only_specified_devs) {
+            data_opts.target.into()
+        } else {
+            0
+        };
+
+        if let Some(out) = trace.as_deref_mut() {
+            write!(out, "keeping devices: ");
+            self.devs_list_to_text(out, devs_have);
+            out.newline();
+
+            if data_opts.write_flags.contains(w::BCH_WRITE_alloc_nowait) {
+                write!(out, "nonblocking\n");
+            }
+        }
+
+        let a = self.durability_available(data_opts, data_type, target, devs_have, trace);
+        if a.durability != 0 { Ok(()) } else { no_room(self, a.need_copygc) }
+    }
+}
+
+impl TransAttempt<'_, '_> {
+    /// Ok if the update can be done; otherwise why not, a data_update_fail_*
+    /// or ec_alloc_failed error, explained into @trace too. Getting a stripe
+    /// head takes mutexes, so it can restart.
+    pub fn can_do_data_update(&self, opts: &c::bch_inode_opts, data_opts: &c::data_update_opts,
+                              k: BkeySC<'_>, mut trace: Option<&mut Printbuf>) -> Result<(), BchError> {
+        let fs = self.fs();
+        let mut devs_have = c::bch_devs_list::default();
+        let mut keeping = 0;
+
+        if let Some(k) = k.arm::<Ptrs>() {
+            let mut bit = 1u32;
+            for d in k.ptrs_decoded(fs) {
+                let p = &d.p;
+                let dev = u32::from(p.ptr.dev());
+                if dev != c::BCH_SB_MEMBER_INVALID && bit & u32::from(data_opts.ptrs_kill) == 0 {
+                    // a pointer only losing its stripe keeps its device's durability
+                    keeping += if bit & u32::from(data_opts.ptrs_kill_ec) != 0 {
+                        fs.dev_durability(dev, &read_lock())
+                    } else {
+                        extent_ptr_durability(self, p)?
+                    };
+                    if !data_opts.bits.no_devs_have() && p.ptr.cached() == 0 {
+                        devs_have.add(p.ptr.dev());
+                    }
+                }
+                bit <<= 1;
+            }
+        }
+
+        let replicas = u32::from(opts.data_replicas);
+        if !k.k.is_btree_ptr() && data_opts.extra_replicas == 0 && keeping >= replicas {
+            return Ok(());
+        }
+
+        if let Some(out) = trace.as_deref_mut() {
+            // wraps if keeping exceeds replicas
+            write!(out, "need {} replicas\n", replicas.wrapping_sub(keeping));
+        }
+
+        fs.data_update_write_feasible(opts, data_opts, &devs_have, k, trace)?;
+
+        // Erasure coding that's sure to fail - too few devices, say -
+        // shouldn't cost a read first
+        if data_opts.write_flags.contains(w::BCH_WRITE_must_ec) {
+            // The ec_alloc_failed subtypes park the extent; a restart must
+            // stay one, or an extent that only needed a retry is parked
+            let mut req = self.alloc_request(data_opts.target.into(), false, core::ptr::null_mut(), 0, replicas,
+                                             c::bch_watermark::BCH_WATERMARK_normal, w::empty(),
+                                             core::ptr::null_mut())?;
+            // alloc_request() leaves it to the caller. The write path caps it
+            // from the options; this probe runs uncapped
+            req.ec_max_data_blocks = 0;
+
+            let (_, g, _) = head_get(self, &mut req, 0, None)?;
+            stripe_head_put(fs, g);
+        }
+        Ok(())
+    }
+}
+
+/// # Safety
+/// @trans is in an attempt.
+#[c_export]
+pub unsafe fn bch2_can_do_data_update<'t>(trans: &'t BtreeTrans<'t>, opts: &c::bch_inode_opts,
+                                          data_opts: &c::data_update_opts, k: BkeySC<'_>,
+                                          trace: Option<&mut Printbuf>) -> c_int {
+    // SAFETY: the caller's
+    let t = unsafe { trans.attempt_in_progress() };
+    ret_to_c(t.can_do_data_update(opts, data_opts, k, trace))
+}
diff --git a/fs/bcachefs/data/update_index.rs b/fs/bcachefs/data/update_index.rs
new file mode 100644
index 0000000..f6048dd
--- /dev/null
+++ b/fs/bcachefs/data/update_index.rs
@@ -0,0 +1,503 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! The data update path's index update: once a data update's write is done,
+//! the replicas it wrote go into the extent, in place of the ones it was
+//! moving. Setting the update up, its read and its teardown are in
+//! update.rs.
+//!
+//! An update is of @old, the key as it was when the update was set up. The
+//! btree may have changed since - the extent cut or overwritten, pointers added
+//! or dropped by other movers - so a key now there that isn't @old's data
+//! (extents_match()) is skipped, and the update's masks, of @old's pointers,
+//! are remapped onto the key that is (PtrMask::remap()).
+//!
+//! Per key there are two copies in transaction memory: @new, what the write
+//! wrote, and @insert, what's there, both cut to where they overlap. @insert's
+//! conflicting replicas are dropped, @new's pointers go in - each under its
+//! crc, so ahead of pointers already there unless it brings a crc of its own -
+//! and what isn't needed is dropped or made cached. Each of those renumbers
+//! @insert's pointers and ends its brand, so every mask is remapped afresh for
+//! the next. Both copies have room for what set_needs_reconcile() adds.
+//!
+//! Each key is an attempt of the transaction's walk, committed inside it, as
+//! C's: the trace and where the walk goes on from come after the commit.
+//!
+//! Durability is checked twice. Before the drops, a key that would end up less
+//! durable than it was, and than the options want, is skipped - a race with
+//! erasure coding. After, with the options unchanged since the write started
+//! (the change cookie, reread after a barrier), one that would lose durability
+//! or have none takes the filesystem emergency read-only: it's a bug.
+
+use crate::alloc::capacity::DiskReservation;
+use crate::btree::bkey::{bkey_le, BkeyFamily, BkeyI, BkeySC, BkeyV};
+use crate::btree::iter::{BtreeIter, BtreeIterFlags, BtreeTrans, CommitFlags, CommitOpts, LoopFlow, TransAttempt,
+                         TransBkey, UpdateTriggerFlags};
+use crate::c;
+use crate::c::bch_errcode;
+use crate::data::durability::{drop_extra_durability, drop_extra_ec_durability, BkeyVDurability};
+use crate::data::extents::{BkeyVExtents, Extents};
+use crate::data::update::{ptr_bits_to_text, TYPE_NAMES};
+use crate::data::ptrs::{brand, extents_match, BkeyVPtrs, Branded, PtrMask, Ptrs, PtrsMut};
+use crate::data::reconcile::plan::pending_mod;
+use crate::errcode::{ret_to_c, BchError};
+use crate::fs::Fs;
+use crate::init::error::{count_fsck_err, id};
+use crate::inode_opts::get_io_opts;
+use crate::sb::counters::events;
+use crate::util::log::LogMsg;
+use crate::util::{Printbuf, ToText};
+use crate::{bch_err_fn, log_msg_ratelimited};
+use core::ffi::{c_int, c_uint};
+use core::mem::size_of;
+use core::sync::atomic::{fence, Ordering};
+use cstruct_macros::c_export;
+
+/// Room past a key for set_needs_reconcile(): an entry, and a padding pointer
+/// per replica.
+const RECONCILE_ROOM: usize = (1 + c::BCH_REPLICAS_MAX as usize) * size_of::<u64>();
+
+// The update's keys, narrowed to what they're known to be: of an extents
+// btree, and once one matched @old, of its type - with pointers. One that
+// isn't is a bug, and the panic has the key.
+const MATCHED: &str = "matched the update's key but has no pointers";
+
+fn check_is<F: BkeyFamily + ?Sized>(fs: &Fs, k: BkeySC<'_>, what: &str) {
+    assert!(F::contains(k.k), "data update: {what}: {}", k.to_text(fs));
+}
+
+fn extents_mut<'b, 't>(fs: &Fs, k: &'b mut TransBkey<'_, 't>) -> TransBkey<'b, 't, Extents> {
+    check_is::<Extents>(fs, k.as_sc(), "not a key of an extents btree");
+    k.reborrow().arm::<Extents>().unwrap()
+}
+
+fn ptrs<'b>(fs: &Fs, k: &'b TransBkey<'_, '_>) -> BkeySC<'b, Ptrs> {
+    check_is::<Ptrs>(fs, k.as_sc(), MATCHED);
+    k.as_sc().arm::<Ptrs>().unwrap()
+}
+
+fn ptrs_mut<'b, 't>(fs: &Fs, k: &'b mut TransBkey<'_, 't>) -> TransBkey<'b, 't, PtrsMut> {
+    check_is::<PtrsMut>(fs, k.as_sc(), MATCHED);
+    k.reborrow().arm::<PtrsMut>().unwrap()
+}
+
+/// @f with @insert under a fresh brand, and @bits - a mask of @old's - remapped
+/// onto it.
+fn with_remapped<'b, 't, R>(fs: &Fs, old: BkeySC<'_, Ptrs>, insert: &'b mut TransBkey<'_, 't>, bits: u16,
+                            f: impl for<'i> FnOnce(Branded<'i, TransBkey<'b, 't, PtrsMut>>, PtrMask<'i>) -> R) -> R
+{
+    brand(old, |o| brand(ptrs_mut(fs, insert), |i| {
+        let m = o.remap(fs, o.assume(fs, bits.into()), &i);
+        f(i, m)
+    }))
+}
+
+/// @bits, a mask of @old's pointers, as @new's - none, of a key without them.
+fn remap_bits(fs: &Fs, old: BkeySC<'_>, bits: u32, new: BkeySC<'_>) -> u16 {
+    let (Some(old), Some(new)) = (old.arm::<Ptrs>(), new.arm::<Ptrs>()) else { return 0 };
+    brand(old, |o| brand(new, |n| o.remap(fs, o.assume(fs, bits), &n).bits()))
+}
+
+/// For move.c's journal scrub, until it's Rust.
+#[c_export]
+pub fn ptr_mask_remap(c: &Fs, old: BkeySC<'_>, oldmask: c_uint, new: BkeySC<'_>) -> c_uint {
+    remap_bits(c, old, oldmask, new).into()
+}
+
+/// Index update keys, for the key fail traces and the messages of an update
+/// that went wrong: @new, the key in the btree, @wrote, what the write wrote,
+/// cut to it, @insert, what was going in.
+#[cold]
+fn key_to_text(out: &mut Printbuf, fs: &Fs, u: &c::data_update, new: BkeySC<'_>, wrote: BkeySC<'_>,
+               insert: BkeySC<'_>) {
+    let old = BkeySC::from(u.k.key());
+
+    write!(out, "rewrites found:\t{:b}", remap_bits(fs, old, u.opts.ptrs_kill.into(), insert));
+    out.newline();
+
+    fs.data_update_opts_to_text(out, &u.op.opts, &u.opts);
+
+    write!(out, "\nold:    {}", old.to_text(fs));
+    write!(out, "\nnew:    {}", new.to_text(fs));
+    write!(out, "\nwrote:  {}", wrote.to_text(fs));
+    write!(out, "\ninsert: {}", insert.to_text(fs));
+}
+
+/// A key the update skipped, counted in its stats and traced.
+#[cold]
+#[inline(never)]
+fn count_key_fail(fs: &Fs, u: &c::data_update, new: BkeySC<'_>, wrote: BkeySC<'_>, insert: BkeySC<'_>, msg: &str) {
+    if let Some(stats) = &u.stats {
+        stats.keys_raced.fetch_add(1, Ordering::Relaxed);
+        stats.sectors_raced.fetch_add(insert.k.size.into(), Ordering::Relaxed);
+    }
+
+    fs.event_add_trace(events::data_update_key_fail, insert.k.size.into(), |out| {
+        write!(out, "{msg}\n");
+        key_to_text(out, fs, u, new, wrote, insert);
+    });
+}
+
+/// The update of @k, the slot at @iter, by the front of @u's keylist; where
+/// the walk goes on from.
+fn index_update_key<'t>(t: &TransAttempt<'_, 't>, u: &c::data_update, iter: &BtreeIter<'t>, k: BkeySC<'_>)
+    -> Result<c::bpos, BchError>
+{
+    let fs = t.fs();
+    let old = BkeySC::from(u.k.key());
+
+    /* make a local copy, so that we can trace it after the transaction commit: */
+    let k = t.bkey_make_mut_noupdate(k)?;
+
+    let front = BkeySC::from(u.op.insert_keys.front().expect("an index update of an empty keylist"));
+    let mut new: TransBkey<'_, '_> = t.bkey_reassemble_room(front, front.k.bytes() + RECONCILE_ROOM)?;
+    // and room for @new's pointers
+    let mut insert: TransBkey<'_, '_> =
+        t.bkey_reassemble_room(k.as_sc(), k.k().bytes() + front.k.val_bytes() + RECONCILE_ROOM)?;
+
+    // None of the cuts empties a key: the walk pops each key ending at or
+    // before where it goes on, so @new ends past @pos, and the slot there does
+    let pos = iter.pos();
+    extents_mut(fs, &mut new).cut_front_in_place(fs, pos);
+    extents_mut(fs, &mut insert).cut_front_in_place(fs, pos);
+    let end = new.k().p;
+    extents_mut(fs, &mut insert).cut_back_in_place(end);
+    let end = insert.k().p;
+    extents_mut(fs, &mut new).cut_back_in_place(end);
+
+    let next_pos = insert.k().p;
+
+    if !extents_match(fs, k.as_sc(), old) {
+        count_key_fail(fs, u, k.as_sc(), new.as_sc(), insert.as_sc(), "no match:");
+        return Ok(next_pos);
+    }
+
+    let old = old.arm::<Ptrs>().unwrap_or_else(|| panic!("data update of a key without pointers: {}", old.to_text(fs)));
+
+    /* Don't replace non-cached replicas with cached: */
+    let replacing_non_cached = with_remapped(fs, old, &mut insert, u.opts.ptrs_kill,
+                                             |i, kill| i.ptrs_in(fs, kill).any(|p| p.cached() == 0));
+
+    if replacing_non_cached && ptrs(fs, &new).ptrs(fs).any(|p| p.cached() != 0) {
+        let mut msg = log_msg_ratelimited!(fs);
+        write!(msg, "data update tried to replace non cached data with cached:\n");
+        key_to_text(&mut msg, fs, u, k.as_sc(), new.as_sc(), insert.as_sc());
+        return Ok(next_pos);
+    }
+
+    if !u.opts.bits.no_devs_have() {
+        /*
+         * Drop replicas in the existing extent that conflict with what we just
+         * wrote - but only if they were explicitly specified in ptrs_kill: a
+         * replica that we just wrote might conflict with a replica that we
+         * want to keep, due to racing with another move:
+         */
+        let new_p = ptrs(fs, &new);
+        with_remapped(fs, old, &mut insert, u.opts.ptrs_kill, |i, kill| {
+            let conflicts = i.on_devs_of(fs, &new_p, |_| true) & kill;
+            i.drop_ptrs_mask(fs, conflicts);
+        });
+
+        /*
+         * Any conflicts that are left over were useless writes - perhaps due
+         * to a copygc race. But a new durable pointer doesn't conflict with a
+         * cached pointer on the same device - it replaces it:
+         */
+        let insert_p = ptrs(fs, &insert);
+        let conflicted = brand(ptrs_mut(fs, &mut new), |n| {
+            let conflicts = n.on_devs_of(fs, &insert_p, |p| p.cached() == 0);
+            if !conflicts.is_empty() {
+                fs.event_add_trace(events::data_update_useless_write_fail,
+                                   u64::from(k.k().size) * u64::from(conflicts.bits().count_ones()), |out| {
+                    ptr_bits_to_text(out, conflicts.bits(), "conflicted");
+                    write!(out, "wrote: {}", n.key().to_text(fs));
+                    out.newline();
+                    u.to_text(out);
+                });
+                n.drop_ptrs_mask(fs, conflicts);
+            }
+            !conflicts.is_empty()
+        });
+
+        if conflicted && new.as_sc().val_bytes().is_empty() {
+            count_key_fail(fs, u, k.as_sc(), front, insert.as_sc(), "new replicas conflicted:");
+            return Ok(k.k().p);
+        }
+    }
+
+    /*
+     * Drop all conflicts from the existing extent, not the newly written
+     * replicas:
+     *
+     * When converting an extent to erasure coding, we don't disallow the
+     * write from allocating on the extent's existing devices: we just want a
+     * new replica that will have a stripe pointer added asynchronously by
+     * erasure coding, and it can overwrite whichever device it happens to
+     * land on
+     *
+     * XXX: make sure drop_extra_replicas does not drop the new replica
+     */
+    let new_p = ptrs(fs, &new);
+    brand(ptrs_mut(fs, &mut insert), |i| {
+        let conflicts = i.on_devs_of(fs, &new_p, |_| true);
+        i.drop_ptrs_mask(fs, conflicts);
+    });
+
+    let mut i = ptrs_mut(fs, &mut insert);
+    for p in new_p.ptrs_decoded(fs) {
+        i.insert_decoded_ptr(fs, &p.p).unwrap_or_else(|e| {
+            panic!("data update: {e}, adding the pointers of {} to {}", new_p.to_text(fs), i.to_text(fs))
+        });
+    }
+
+    let opts = get_io_opts(t, None, k.as_sc())?;
+
+    let old_durability = k.as_sc().durability(t)?;
+    let new_durability = insert.as_sc().durability(t)?;
+    let want = u.op.opts.data_replicas.min(opts.data_replicas);
+
+    if new_durability.total < old_durability.total && new_durability.total < want {
+        /*
+         * This can happen when a move - evacuate or copygc - races with an
+         * extent being erasure coded: we replaced a pointer with one on the
+         * same device (so we have to drop it early, to avoid conflicts) which
+         * is no longer erasure coded.
+         *
+         * XXX: trace this
+         */
+        return Ok(next_pos);
+    }
+
+    with_remapped(fs, old, &mut insert, u.opts.ptrs_io_error, |i, m| drop_extra_durability(t, &opts, i, m, true))?;
+    with_remapped(fs, old, &mut insert, u.opts.ptrs_kill_ec, |mut i, m| drop_extra_ec_durability(t, &opts, &mut i, m))?;
+    with_remapped(fs, old, &mut insert, u.opts.ptrs_kill, |i, m| drop_extra_durability(t, &opts, i, m, false))?;
+
+    /* Prefer to drop existing replicas over new - we don't want to drop the
+     * new replica being erasure coded*/
+    // XXX (C's): else prefer to drop new replicas, and if we did, trace that we
+    // did useless work - break up drop_extra_durability() so we can trace what
+    // we're doing (or have it return a mask)
+    if u.opts.bits.no_devs_have() {
+        brand(ptrs_mut(fs, &mut insert), |i| {
+            let m = i.except(fs, i.on_devs_of(fs, &new_p, |_| true));
+            drop_extra_durability(t, &opts, i, m, false)
+        })?;
+    }
+
+    brand(ptrs_mut(fs, &mut insert), |i| { let all = i.all(fs); drop_extra_durability(t, &opts, i, all, false) })?;
+
+    let mut i = ptrs_mut(fs, &mut insert);
+    i.drop_extra_cached_ptrs(fs, &opts);
+    i.propagate_incompressible(fs, k.as_sc());
+
+    let s = t.sum_sector_overwrites(iter, insert.as_ref())?;
+
+    let res = &u.op.res;
+    if s.disk_sectors_delta > res.sectors() as i64 {
+        res.add_physical((s.disk_sectors_delta - res.sectors() as i64) as u64, s.new_nr_replicas,
+                         if s.usage_increasing { c::bch_reservation_flags::empty() }
+                         else { c::bch_reservation_flags::BCH_DISK_RESERVATION_NOFAIL })?;
+    }
+
+    t.log_str(TYPE_NAMES[u.opts.type_ as usize])?;
+    t.log_bkey(u.btree_id, 0, u.k.key())?;
+
+    /* needs k.k->p, the whole key's end - see index_update(): */
+    t.insert_snapshot_whiteouts(u.btree_id, k.k().p, insert.k().p)?;
+
+    /*
+     * This set_needs_reconcile call is only for verifying that the data we
+     * just wrote was written correctly, otherwise we could fail to flag
+     * incorrectly written data due to needs_rb already being set on the
+     * existing extent
+     */
+    new.set_needs_reconcile(t, None, &opts, c::set_needs_reconcile_ctx::SET_NEEDS_RECONCILE_foreground,
+                            u.op.opts.change_cookie)?;
+
+    if u.op.opts.change_cookie == fs.opt_change_cookie.get() {
+        let old_durability = k.as_sc().durability(t)?;
+        let new_durability = insert.as_sc().durability(t)?;
+
+        if ((new_durability.total < old_durability.total && new_durability.total < want) ||
+            new_durability.total == 0) &&
+            {
+                fence(Ordering::SeqCst);
+                u.op.opts.change_cookie == fs.opt_change_cookie.get()
+            }
+        {
+            let mut msg = LogMsg::new(fs);
+            write!(msg, "Data update would have reduced extent durability:\n");
+            write!(msg, "Old extent {}, new {}, option specifies {}\n",
+                   old_durability.total, new_durability.total, opts.data_replicas);
+            key_to_text(&mut msg, fs, u, k.as_sc(), new.as_sc(), insert.as_sc());
+            fs.emergency_read_only(&mut msg);
+            return fs.throw(bch_errcode::BCH_ERR_emergency_ro);
+        }
+    }
+
+    /* This is the real set_needs_reconcile() call */
+    insert.set_needs_reconcile(t, None, &opts, c::set_needs_reconcile_ctx::SET_NEEDS_RECONCILE_foreground,
+                               u.op.opts.change_cookie)?;
+
+    t.update(iter, &insert, UpdateTriggerFlags::INTERNAL_SNAPSHOT_NODE | UpdateTriggerFlags::SET_NEEDS_RECONCILE_DONE)?;
+    t.commit(Some(res), CommitOpts::from(u.opts.commit_flags)
+                        .flags(CommitFlags::NO_CHECK_RW | CommitFlags::NO_ENOSPC))?;
+
+    fs.event_add_trace(events::data_update_key, new.k().size.into(), |out| {
+        write!(out, "\nold: {}", old.to_text(fs));
+        write!(out, "\nk:   {}", k.as_sc().to_text(fs));
+        write!(out, "\nnew: {}", insert.as_sc().to_text(fs));
+    });
+
+    Ok(next_pos)
+}
+
+/// Whether @insert, the keylist's front, is an extent - all a data update's
+/// write writes - logged and counted as an fsck error if it isn't.
+fn insert_is_extent(fs: &Fs, insert: &BkeyI) -> bool {
+    if insert.k().key_type() == c::bch_bkey_type::KEY_TYPE_extent {
+        return true;
+    }
+
+    let mut msg = LogMsg::new(fs);
+    write!(msg, "Got non-extent key to insert in data update path - confused:\n{}",
+           BkeySC::from(insert).to_text(fs));
+    let counted = count_fsck_err(fs, id::data_update_got_non_extent, &mut msg);
+    msg.set_suppressed(!counted);
+    false
+}
+
+pub(crate) fn index_update(trans: &BtreeTrans<'_>, u: &mut c::data_update) -> Result<(), BchError> {
+    let fs = trans.fs();
+    let Some(front) = u.op.insert_keys.front().filter(|k| insert_is_extent(fs, k)) else { return Ok(()) };
+
+    /*
+     * Slots, not BTREE_ITER_trim: each key must be whole. Where @insert ends
+     * before @k, the rewritten part is a key at a new position, insert->k.p,
+     * and descendant snapshots' overwrites of @k, at k.k->p, don't hide it
+     * there: insert_snapshot_whiteouts() adds whiteouts for them by comparing
+     * the two ends - which a trimmed @k would make equal.
+     */
+    let mut iter = BtreeIter::new(trans, u.btree_id, front.k().start_pos(),
+                                  BtreeIterFlags::SLOTS | BtreeIterFlags::INTENT);
+
+    iter.for_each(trans, |t, iter, k| {
+        let next = index_update_key(t, u, iter, k)?;
+
+        while u.op.insert_keys.front().is_some_and(|k| bkey_le(k.k().p, next)) {
+            u.op.insert_keys.pop_front();
+        }
+
+        // the next key's checked before the walk peeks for it, as C's loop
+        Ok(match u.op.insert_keys.front() {
+            Some(front) if insert_is_extent(fs, front) => LoopFlow::ContinueFrom(next),
+            _ => LoopFlow::Break(()),
+        })
+    })
+}
+
+/// @u's index update, in a transaction of its own: the write path's, once the
+/// write op is done.
+#[c_export]
+pub fn bch2_data_update_index_update(u: &mut c::data_update) -> c_int {
+    let trans = crate::btree_trans!(u.op.fs());
+    ret_to_c(index_update(&trans, u))
+}
+
+/// @f on each slot @u's extent covered, an attempt and a commit each.
+fn for_each_old_slot<'t, F>(trans: &'t BtreeTrans<'t>, u: &c::data_update, res: Option<&DiskReservation<'_>>,
+                            mut f: F) -> Result<(), BchError>
+where
+    F: for<'a, 'k> FnMut(&'k TransAttempt<'a, 't>, &'k BtreeIter<'t>, BkeySC<'k>) -> Result<(), BchError>,
+{
+    let old = BkeySC::from(u.k.key());
+    let mut iter = BtreeIter::new(trans, u.btree_id, old.k.start_pos(), BtreeIterFlags::SLOTS | BtreeIterFlags::INTENT);
+    iter.for_each_max_commit(trans, old.k.p, BtreeIterFlags::SLOTS, res,
+                             CommitFlags::NO_CHECK_RW | CommitFlags::NO_ENOSPC, |t, iter, k| {
+        // the slot at @old's end: where C's loop breaks
+        if bkey_le(old.k.p, k.k.start_pos()) {
+            return Ok(());
+        }
+        f(t, iter, k)
+    })
+}
+
+/// The index update for a data update whose write didn't happen, because the
+/// read failed on every replica: drops its ptrs_kill, and logs it.
+pub(crate) fn index_update_nowrite(trans: &BtreeTrans<'_>, u: &c::data_update) -> Result<(), BchError> {
+    let fs = trans.fs();
+    let old = BkeySC::from(u.k.key());
+    let old_p = old.arm::<Ptrs>().unwrap_or_else(|| panic!("data update of a key without pointers: {}", old.to_text(fs)));
+
+    let mut msg = LogMsg::new(fs);
+    write!(msg, "data_update_index_update_nowrite():\n");
+    write!(msg, "old: {}", old.to_text(fs));
+    msg.newline();
+    ptr_bits_to_text(&mut msg, u.opts.ptrs_kill, "ptrs_kill");
+
+    let res = DiskReservation::new(fs);
+
+    assert_eq!(u.opts.ptrs_kill_ec, 0, "a nowrite data update dropping stripe pointers");
+    assert_ne!(u.opts.ptrs_kill, 0, "a nowrite data update with nothing to drop");
+
+    for_each_old_slot(trans, u, Some(&res), |t, iter, k| {
+        write!(msg, "k: {}", k.to_text(fs));
+        msg.newline();
+
+        let Some(kp) = k.arm::<Ptrs>().filter(|_| extents_match(fs, k, old)) else { return Ok(()) };
+        let Some(new) = brand(old_p, |o| brand(kp, |kb| -> Result<_, BchError> {
+            let kill = o.remap(fs, o.assume(fs, u.opts.ptrs_kill.into()), &kb);
+            if kill.is_empty() {
+                return Ok(None);
+            }
+            let new = kb.adopt(fs, t.bkey_reassemble_room(kb.key(), k.k.bytes() + RECONCILE_ROOM)?);
+            Ok(Some(new.drop_ptrs_mask(fs, kill)))
+        }))? else {
+            return Ok(());
+        };
+        let mut new: TransBkey<'_, '_> = new.into();
+
+        let opts = get_io_opts(t, None, k)?;
+        new.set_needs_reconcile(t, None, &opts, c::set_needs_reconcile_ctx::SET_NEEDS_RECONCILE_foreground,
+                                u.op.opts.change_cookie.wrapping_sub(1))?;
+        t.update(iter, &new, UpdateTriggerFlags::INTERNAL_SNAPSHOT_NODE | UpdateTriggerFlags::SET_NEEDS_RECONCILE_DONE)?;
+
+        write!(msg, "new: {}", new.as_sc().to_text(fs));
+        msg.newline();
+        Ok(())
+    })
+}
+
+/// EC allocation failed - the write never happened, but the extent still
+/// needs erasure coding. Mark it pending so reconcile retries from the pending
+/// list instead of the main scan.
+pub(crate) fn ec_alloc_failed(u: &mut c::data_update) {
+    let fs = u.op.fs();
+    let trans = crate::btree_trans!(fs);
+    let old = BkeySC::from(u.k.key());
+    let mut parked = false;
+
+    let ret = bch_err_fn!(fs, for_each_old_slot(&trans, u, None, |t, iter, k| {
+        if !extents_match(fs, k, old) {
+            return Ok(());
+        }
+
+        fs.event_add_trace(events::reconcile_set_pending, k.k.size.into(), |out| {
+            write!(out, "{}\n{}\n", BchError::from_raw(-i32::from(u.op.error)), k.to_text(fs));
+            fs.data_update_opts_to_text(out, &u.op.opts, &u.opts);
+        });
+
+        pending_mod(t, iter, 0, k, true)?;
+        parked = true;
+        Ok(())
+    }));
+
+    /*
+     * Nothing matched: the extent we were reconciling was rewritten or
+     * deleted while our write was in flight, so there was nothing to park.
+     * Distinct error code so the update's exit() still traces it -
+     * ec_alloc_failed itself is suppressed there because it parks.
+     */
+    if ret.is_ok() && !parked {
+        u.op.error = -fs.err(bch_errcode::BCH_ERR_ec_alloc_failed_pending_race).raw() as i16;
+    }
+}
diff --git a/fs/bcachefs/data/update_task.rs b/fs/bcachefs/data/update_task.rs
