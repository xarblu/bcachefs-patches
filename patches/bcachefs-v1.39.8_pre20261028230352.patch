+++ b/fs/bcachefs/util/hash.rs
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! linux/hash.h's hash_64(), for Rust: the golden ratio multiply, its top
+//! bits the hash - and Fold, a core::hash::Hasher that folds a key's words
+//! into the one word it multiplies, so any Hash key has a hash_64(); and
+//! GoldenRatio, the same as a keyed BuildHasher, for a table to hash with.
+//!
+//! Cheap - a multiply a word - and well spread for keys counting up, but
+//! keyed only by xors: for tables whose keys an attacker doesn't choose.
+
+use crate::c;
+use core::hash::{BuildHasher, Hash, Hasher};
+
+/// The top @bits of @v times the golden ratio. Zero @bits: all of it.
+pub fn hash_64(v: u64, bits: u32) -> u64 {
+    v.wrapping_mul(c::GOLDEN_RATIO_64).wrapping_shr(64 - bits)
+}
+
+/// A key's words folded into one, by hash_64()'s multiply: a u64 key's is
+/// itself.
+#[derive(Default)]
+pub struct Fold(u64);
+
+impl Fold {
+    /// @key, folded: what hash_64() takes.
+    pub fn of<K: ?Sized + Hash>(key: &K) -> u64 {
+        let mut f = Fold::default();
+        key.hash(&mut f);
+        f.finish()
+    }
+}
+
+impl Hasher for Fold {
+    fn write(&mut self, bytes: &[u8]) {
+        for w in bytes.chunks(8) {
+            let mut b = [0; 8];
+            b[..w.len()].copy_from_slice(w);
+            self.write_u64(u64::from_le_bytes(b));
+        }
+    }
+
+    fn write_u64(&mut self, w: u64) {
+        self.0 = self.0.wrapping_mul(c::GOLDEN_RATIO_64) ^ w;
+    }
+
+    fn finish(&self) -> u64 {
+        self.0
+    }
+}
+
+/// hash_64() as a keyed BuildHasher: a key's words folded from the first key
+/// word, the second xored in, times the golden ratio - the top bits the best.
+#[derive(Clone, Copy)]
+pub struct GoldenRatio([u64; 2]);
+
+impl From<[u64; 2]> for GoldenRatio {
+    fn from(k: [u64; 2]) -> Self {
+        Self(k)
+    }
+}
+
+impl BuildHasher for GoldenRatio {
+    type Hasher = GoldenRatioHasher;
+
+    fn build_hasher(&self) -> GoldenRatioHasher {
+        GoldenRatioHasher(Fold(self.0[0]), self.0[1])
+    }
+}
+
+pub struct GoldenRatioHasher(Fold, u64);
+
+impl Hasher for GoldenRatioHasher {
+    fn write(&mut self, bytes: &[u8]) {
+        self.0.write(bytes)
+    }
+
+    fn write_u64(&mut self, w: u64) {
+        self.0.write_u64(w)
+    }
+
+    fn finish(&self) -> u64 {
+        (self.0.finish() ^ self.1).wrapping_mul(c::GOLDEN_RATIO_64)
+    }
+}
diff --git a/fs/bcachefs/util/inline_vec.rs b/fs/bcachefs/util/inline_vec.rs
new file mode 100644
index 0000000..37fce0c
--- /dev/null
+++ b/fs/bcachefs/util/inline_vec.rs
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A vector with room for @N elements in itself - on the stack, or in what
+//! holds it - that moves them to the heap when it needs more: C's
+//! DARRAY_PREALLOCATED(), for what's usually small and occasionally isn't.
+//!
+//! The inline half is arrayvec's; the heap half a KVVec, so spilling is the
+//! kernel's allocation, with its flags, and fallible - an AllocError, where
+//! darray_make_room() is -ENOMEM - never the global allocator's, which the
+//! kernel build doesn't have. Once on the heap it stays there: shrinking back
+//! would move the elements again for nothing.
+//!
+//! Its elements are a slice, Deref'd: the slice's methods - iteration,
+//! indexing, sort_unstable - are its. Growing it is reserve(), push() and
+//! insert(), each fallible as the allocation under it is.
+
+use crate::util::alloc::{AllocError, Flags, KVVec};
+use arrayvec::ArrayVec;
+use core::ops::{Deref, DerefMut};
+
+pub enum InlineVec<T, const N: usize> {
+    Inline(ArrayVec<T, N>),
+    Heap(KVVec<T>),
+}
+
+impl<T, const N: usize> InlineVec<T, N> {
+    pub const fn new() -> Self {
+        Self::Inline(ArrayVec::new_const())
+    }
+
+    /// Room for @additional more, moving to the heap if they don't fit
+    /// inline: darray_make_room().
+    pub fn reserve(&mut self, additional: usize, flags: Flags) -> Result<(), AllocError> {
+        match self {
+            Self::Inline(v) if v.len() + additional <= N => Ok(()),
+            Self::Inline(v) => {
+                let mut heap = KVVec::with_capacity(v.len() + additional, flags)?;
+                for x in v.drain(..) {
+                    heap.push(x, flags).expect("pushing within reserved capacity doesn't allocate");
+                }
+                *self = Self::Heap(heap);
+                Ok(())
+            }
+            Self::Heap(v) => v.reserve(additional, flags),
+        }
+    }
+
+    /// @x, added last.
+    pub fn push(&mut self, x: T, flags: Flags) -> Result<(), AllocError> {
+        self.reserve(1, flags)?;
+        match self {
+            Self::Inline(v) => v.push(x),
+            Self::Heap(v) => v.push(x, flags).expect("pushing within reserved capacity doesn't allocate"),
+        }
+        Ok(())
+    }
+
+    /// @x, inserted at @i, the elements from @i on moving up. Panics past the
+    /// end, as slices do.
+    pub fn insert(&mut self, i: usize, x: T, flags: Flags) -> Result<(), AllocError> {
+        assert!(i <= self.len(), "inserting at {i} of {}", self.len());
+        self.push(x, flags)?;
+        self[i..].rotate_right(1);
+        Ok(())
+    }
+}
+
+impl<T, const N: usize> Default for InlineVec<T, N> {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl<T, const N: usize> Deref for InlineVec<T, N> {
+    type Target = [T];
+
+    fn deref(&self) -> &[T] {
+        match self {
+            Self::Inline(v) => v,
+            Self::Heap(v) => v,
+        }
+    }
+}
+
+impl<T, const N: usize> DerefMut for InlineVec<T, N> {
+    fn deref_mut(&mut self) -> &mut [T] {
+        match self {
+            Self::Inline(v) => v,
+            Self::Heap(v) => v,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::util::alloc::flags::GFP_KERNEL;
+
+    #[test]
+    fn spills_past_n_keeping_order() {
+        let mut v = InlineVec::<u32, 2>::new();
+        v.push(1, GFP_KERNEL).unwrap();
+        v.insert(0, 0, GFP_KERNEL).unwrap();
+        assert!(matches!(v, InlineVec::Inline(_)));
+
+        // a third doesn't fit inline: the first two move with it
+        v.insert(1, 5, GFP_KERNEL).unwrap();
+        assert!(matches!(v, InlineVec::Heap(_)));
+        v.push(9, GFP_KERNEL).unwrap();
+        assert_eq!(*v, [0, 5, 1, 9]);
+    }
+
+    #[test]
+    fn reserve_spills_ahead() {
+        let mut v = InlineVec::<u32, 4>::new();
+        v.reserve(4, GFP_KERNEL).unwrap();
+        assert!(matches!(v, InlineVec::Inline(_)), "four fit");
+        v.reserve(5, GFP_KERNEL).unwrap();
+        assert!(matches!(v, InlineVec::Heap(_)), "five don't");
+        assert!(v.is_empty());
+    }
+}
diff --git a/fs/bcachefs/util/ioctl.rs b/fs/bcachefs/util/ioctl.rs
new file mode 100644
index 0000000..292974c
--- /dev/null
+++ b/fs/bcachefs/util/ioctl.rs
@@ -0,0 +1,307 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! ioctl numbers, as the kernel's _IO*() macros make them, and the trait
+//! c_ioctl! (bcachefs_ioctl.rs) gives each ioctl: its number bound to its
+//! argument type, so a call can't pair the wrong two.
+//!
+//! An ioctl number packs a direction, a type (bcachefs's is 0xbc), a number
+//! and the argument's size: asm-generic/ioctl.h's _IOC(), the same packing on
+//! every architecture. What varies is five constants - the widths of the size
+//! and direction fields, and the direction values - which powerpc, mips,
+//! sparc, alpha and parisc override in their asm/ioctl.h. Those come from
+//! bindgen's view of each target's own headers - linux-raw-sys's in
+//! userspace, codegen.h's in-kernel; nothing here restates them. A
+//! hand-written opcode() that had asm-generic's layout everywhere got ppc64le
+//! ENOTTY (#904).
+//!
+//! Not the kernel crate's kernel::ioctl: it has asm-generic's constants on
+//! powerpc from 6.4, where it arrived, through 7.2 - its uapi bindings
+//! included asm-generic/ioctl.h ahead of the arch's, until cdfcaa36ac93.
+//!
+//! The generated header asserts that C's _IO*() make the same numbers.
+//!
+//! In-kernel, the handlers' side. A handler never sees the user's pointer
+//! for an argument of fixed size: input(), output() and inout() copy it as
+//! its number's direction says - in, out, or in and back out on success -
+//! no_arg() is _IO's, and a direction they don't take doesn't compile. A Head<T> argument is
+//! the head of a variable-length one, and there the number's direction is
+//! the head's alone - an array after it may go either way, as
+//! BCH_IOCTL_QUERY_COUNTERS's does: vstruct() hands the handler a
+//! UserVstruct, which reads and writes the head, and the array as the head
+//! counts it - where it starts, what it holds and how many, by the type's
+//! #[counted] field - no further. An argument whose array the type doesn't
+//! count - entries of varying size, the head giving their bytes - is arg()'s:
+//! a UserArg, read and written whole, and the bytes at its array's offset.
+//! What a handler returns, IoctlRet, is the
+//! syscall's value; its errors are returned by the dispatch, as their class.
+
+#![allow(non_snake_case)]
+
+use core::mem::size_of;
+#[cfg(kernel)]
+use crate::c as ioc;
+#[cfg(not(kernel))]
+use linux_raw_sys::general as ioc;
+
+/// An ioctl: its number, its argument's type - () for _IO - and which way
+/// the number says the argument goes, one of dir's.
+pub trait Ioctl {
+    const OPCODE: u32;
+    type Arg;
+    type Dir;
+}
+
+/// The directions _IO*() put in a number, as types: who copies the argument.
+pub mod dir {
+    /// _IO: there's none.
+    pub struct IO;
+    /// _IOR: the kernel writes it.
+    pub struct R;
+    /// _IOW: the kernel reads it.
+    pub struct W;
+    /// _IOWR: both.
+    pub struct WR;
+}
+
+const fn _IOC(dir: u32, ty: u32, nr: u32, size: usize) -> u32 {
+    assert!(ty <= ioc::_IOC_TYPEMASK && nr <= ioc::_IOC_NRMASK);
+    assert!(size <= ioc::_IOC_SIZEMASK as usize, "ioctl argument too big for the size field");
+
+    (dir << ioc::_IOC_DIRSHIFT)
+        | (ty << ioc::_IOC_TYPESHIFT)
+        | (nr << ioc::_IOC_NRSHIFT)
+        | ((size as u32) << ioc::_IOC_SIZESHIFT)
+}
+
+/// No argument.
+pub const fn _IO(ty: u32, nr: u32) -> u32 {
+    _IOC(ioc::_IOC_NONE, ty, nr, 0)
+}
+
+/// The kernel writes the argument.
+pub const fn _IOR<T>(ty: u32, nr: u32) -> u32 {
+    _IOC(ioc::_IOC_READ, ty, nr, size_of::<T>())
+}
+
+/// The kernel reads the argument.
+pub const fn _IOW<T>(ty: u32, nr: u32) -> u32 {
+    _IOC(ioc::_IOC_WRITE, ty, nr, size_of::<T>())
+}
+
+/// The kernel reads and writes the argument.
+pub const fn _IOWR<T>(ty: u32, nr: u32) -> u32 {
+    _IOC(ioc::_IOC_READ | ioc::_IOC_WRITE, ty, nr, size_of::<T>())
+}
+
+#[cfg(kernel)]
+pub use user::*;
+
+#[cfg(kernel)]
+mod user {
+    use super::{dir, Ioctl};
+    use crate::c;
+    use crate::errcode::BchError;
+    use crate::util::alloc::{flags::GFP_KERNEL, KVVec};
+    use crate::util::vstructs::{FlexArray, Head, Unsized};
+    use core::ffi::CStr;
+    use core::marker::PhantomData;
+    use core::mem::size_of;
+    use kernel::ffi::{c_int, c_long};
+    use kernel::transmute::{AsBytes, FromBytes};
+    use kernel::uaccess::{UserPtr, UserSlice};
+
+    pub trait IoctlRet {
+        fn ret(self) -> c_long;
+    }
+
+    impl IoctlRet for () {
+        fn ret(self) -> c_long {
+            0
+        }
+    }
+
+    impl IoctlRet for c_int {
+        fn ret(self) -> c_long {
+            self as c_long
+        }
+    }
+
+    impl IoctlRet for c_long {
+        fn ret(self) -> c_long {
+            self
+        }
+    }
+
+    pub fn input<I, R>(user: UserPtr, f: impl FnOnce(I::Arg) -> Result<R, BchError>)
+        -> Result<c_long, BchError>
+    where
+        I: Ioctl<Dir = dir::W>,
+        I::Arg: FromBytes,
+        R: IoctlRet,
+    {
+        let arg = UserSlice::new(user, size_of::<I::Arg>()).reader().read()?;
+        Ok(f(arg)?.ret())
+    }
+
+    pub fn no_arg<I, R>(f: impl FnOnce() -> Result<R, BchError>) -> Result<c_long, BchError>
+    where
+        I: Ioctl<Dir = dir::IO>,
+        R: IoctlRet,
+    {
+        Ok(f()?.ret())
+    }
+
+    pub fn output<I>(user: UserPtr, f: impl FnOnce() -> Result<I::Arg, BchError>)
+        -> Result<c_long, BchError>
+    where
+        I: Ioctl<Dir = dir::R>,
+        I::Arg: AsBytes,
+    {
+        let arg = f()?;
+        UserSlice::new(user, size_of::<I::Arg>()).writer().write(&arg)?;
+        Ok(0)
+    }
+
+    pub fn inout<I, R>(user: UserPtr, f: impl FnOnce(&mut I::Arg) -> Result<R, BchError>)
+        -> Result<c_long, BchError>
+    where
+        I: Ioctl<Dir = dir::WR>,
+        I::Arg: FromBytes + AsBytes,
+        R: IoctlRet,
+    {
+        let (mut r, mut w) = UserSlice::new(user, size_of::<I::Arg>()).reader_writer();
+        let mut arg = r.read()?;
+        let ret = f(&mut arg)?.ret();
+        w.write(&arg)?;
+        Ok(ret)
+    }
+
+    pub fn vstruct<I, T, R>(user: UserPtr, f: impl FnOnce(UserVstruct<T>) -> Result<R, BchError>)
+        -> Result<c_long, BchError>
+    where
+        I: Ioctl<Arg = Head<T>>,
+        T: ?Sized + Unsized,
+        R: IoctlRet,
+    {
+        Ok(f(UserVstruct { at: user, _t: PhantomData })?.ret())
+    }
+
+    /// A string from userspace, shorter than its limit: EINVAL if it isn't,
+    /// as strndup_user().
+    pub struct UserStr(KVVec<u8>);
+
+    impl UserStr {
+        pub fn read(addr: u64, max: usize) -> Result<Self, BchError> {
+            let mut buf = KVVec::from_elem(0u8, max + 1, GFP_KERNEL)?;
+            let len = UserSlice::new(UserPtr::from_addr(addr as usize), max + 1).reader()
+                .strcpy_into_buf(&mut buf)?.to_bytes().len();
+            if len >= max {
+                return Err(c::EINVAL.into());
+            }
+            buf.truncate(len + 1);
+            Ok(UserStr(buf))
+        }
+
+        pub fn as_cstr(&self) -> &CStr {
+            CStr::from_bytes_with_nul(&self.0).expect("read up to its NUL")
+        }
+    }
+
+    pub fn arg<I, R>(user: UserPtr, f: impl FnOnce(UserArg<I::Arg>) -> Result<R, BchError>)
+        -> Result<c_long, BchError>
+    where
+        I: Ioctl,
+        R: IoctlRet,
+    {
+        Ok(f(UserArg { at: user, _t: PhantomData })?.ret())
+    }
+
+    pub struct UserArg<T> {
+        at: UserPtr,
+        _t: PhantomData<T>,
+    }
+
+    impl<T> UserArg<T> {
+        /// @len bytes from offset @off: its array's, from offset_of!().
+        pub fn bytes_at(&self, off: usize, len: usize) -> UserSlice {
+            UserSlice::new(self.at.wrapping_byte_add(off), len)
+        }
+    }
+
+    impl<T: FromBytes> UserArg<T> {
+        pub fn read(&self) -> Result<T, BchError> {
+            Ok(UserSlice::new(self.at, size_of::<T>()).reader().read()?)
+        }
+    }
+
+    impl<T: AsBytes> UserArg<T> {
+        pub fn write(&self, v: &T) -> Result<(), BchError> {
+            Ok(UserSlice::new(self.at, size_of::<T>()).writer().write(v)?)
+        }
+    }
+
+    impl<T> UserArg<T> {
+        /// Write one field, at offset @off - offset_of!()'s: put_user(), for
+        /// what an ioctl returns of an argument it doesn't write back whole.
+        pub fn write_at<V: AsBytes>(&self, off: usize, v: &V) -> Result<(), BchError> {
+            Ok(self.bytes_at(off, size_of::<V>()).writer().write(v)?)
+        }
+    }
+
+    pub struct UserVstruct<T: ?Sized> {
+        at: UserPtr,
+        _t: PhantomData<T>,
+    }
+
+    impl<T: ?Sized + Unsized> UserVstruct<T> where Head<T>: FlexArray {
+        /// The array after the head, as long as @head says.
+        pub fn tail(&self, head: &Head<T>) -> UserArray<<Head<T> as FlexArray>::Elem> {
+            UserArray {
+                at: self.at.wrapping_byte_add(<Head<T> as FlexArray>::TAIL),
+                nr: head.nr(),
+                _e: PhantomData,
+            }
+        }
+    }
+
+    impl<T: ?Sized + Unsized> UserVstruct<T> where Head<T>: FromBytes {
+        pub fn head(&self) -> Result<Head<T>, BchError> {
+            Ok(UserSlice::new(self.at, size_of::<Head<T>>()).reader().read()?)
+        }
+    }
+
+    impl<T: ?Sized + Unsized> UserVstruct<T> where Head<T>: AsBytes {
+        pub fn set_head(&self, head: &Head<T>) -> Result<(), BchError> {
+            Ok(UserSlice::new(self.at, size_of::<Head<T>>()).writer().write(head)?)
+        }
+    }
+
+    pub struct UserArray<E> {
+        at: UserPtr,
+        nr: usize,
+        _e: PhantomData<E>,
+    }
+
+    impl<E> UserArray<E> {
+        pub fn len(&self) -> usize {
+            self.nr
+        }
+
+        fn slot(&self, i: usize) -> UserSlice {
+            assert!(i < self.nr, "past the {} entries the head gives", self.nr);
+            UserSlice::new(self.at.wrapping_byte_add(i * size_of::<E>()), size_of::<E>())
+        }
+    }
+
+    impl<E: FromBytes> UserArray<E> {
+        pub fn get(&self, i: usize) -> Result<E, BchError> {
+            Ok(self.slot(i).reader().read()?)
+        }
+    }
+
+    impl<E: AsBytes> UserArray<E> {
+        pub fn set(&self, i: usize, v: &E) -> Result<(), BchError> {
+            Ok(self.slot(i).writer().write(v)?)
+        }
+    }
+}
diff --git a/fs/bcachefs/util/jump_label.rs b/fs/bcachefs/util/jump_label.rs
new file mode 100644
index 0000000..36a180c
--- /dev/null
+++ b/fs/bcachefs/util/jump_label.rs
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Static branches: static_branch_unlikely!(), for Rust - ours, not the kernel
+//! crate's. Its macro includes asm made during the kernel's own build,
+//! rust/kernel/generated_arch_static_branch_asm.rs, which a kernel's build
+//! tree for external modules needn't have: mainline's install-extmod-build
+//! ships nothing of rust/, Ubuntu has it in a package of its own, nixpkgs
+//! doesn't have it at all.
+//!
+//! As util/percpu.rs: on x86_64 and arm64, with CONFIG_JUMP_LABEL, it's
+//! inline, as C's is - the asm is the kernel's own, ARCH_STATIC_BRANCH_ASM()
+//! from the headers of the kernel being built against (jump_label_asm.rs.S,
+//! preprocessed by Makefile.rust): a NOP the kernel patches into a jump to the
+//! label when the key is enabled. Elsewhere, and in userspace - where a key
+//! is a plain int - it's C's static_branch_unlikely(), out of line.
+
+use crate::c;
+use cstruct_macros::c_extern;
+
+// C's static_branch_unlikely(), out of line, where Rust has no asm of its own.
+c_extern! {
+    pub fn bch2_static_branch_unlikely(key: *mut c::static_key_false) -> bool;
+}
+
+#[cfg(all(kernel, CONFIG_JUMP_LABEL, any(target_arch = "x86_64", target_arch = "aarch64")))]
+include!(concat!(env!("OUT_DIR"), "/jump_label_asm.rs"));
+
+#[cfg(all(kernel, CONFIG_JUMP_LABEL, any(target_arch = "x86_64", target_arch = "aarch64")))]
+pub(crate) use static_branch_asm;
+
+/// Whether the static key at field @field of @key, a static of type @keytyp
+/// that C defines, is enabled - unlikely, so the branch costs a NOP while it
+/// isn't: static_branch_unlikely(). As the kernel crate's macro takes it: a
+/// symbol, as the asm's __jump_table entry has to name one.
+///
+/// # Safety
+/// @key is a static C defines, its @field a struct static_key_false that only C
+/// writes.
+#[macro_export]
+macro_rules! static_branch_unlikely {
+    ($key:path, $keytyp:ty, $field:ident) => {{
+        #[cfg(all(kernel, CONFIG_JUMP_LABEL, target_arch = "x86_64"))]
+        let enabled = 'enabled: {
+            ::core::arch::asm!(
+                $crate::util::jump_label::static_branch_asm!(),
+                l_yes = label { break 'enabled true; },
+                symb = sym $key,
+                off = const ::core::mem::offset_of!($keytyp, $field),
+                branch = const 0,
+                options(att_syntax),
+            );
+            false
+        };
+
+        #[cfg(all(kernel, CONFIG_JUMP_LABEL, target_arch = "aarch64"))]
+        let enabled = 'enabled: {
+            ::core::arch::asm!(
+                $crate::util::jump_label::static_branch_asm!(),
+                l_yes = label { break 'enabled true; },
+                symb = sym $key,
+                off = const ::core::mem::offset_of!($keytyp, $field),
+                branch = const 0,
+            );
+            false
+        };
+
+        #[cfg(not(all(kernel, CONFIG_JUMP_LABEL, any(target_arch = "x86_64", target_arch = "aarch64"))))]
+        let enabled = $crate::util::jump_label::bch2_static_branch_unlikely(
+            ::core::ptr::addr_of!($key.$field).cast_mut());
+
+        enabled
+    }};
+}
diff --git a/fs/bcachefs/util/jump_label_asm.rs.S b/fs/bcachefs/util/jump_label_asm.rs.S
new file mode 100644
index 0000000..a612d30
--- /dev/null
+++ b/fs/bcachefs/util/jump_label_asm.rs.S
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * util/jump_label.rs's asm, from the headers of the kernel the module is built
+ * against - ARCH_STATIC_BRANCH_ASM(): the NOP the kernel patches into a jump
+ * when the key is enabled, and its __jump_table entry, as that kernel has
+ * them. As percpu_asm.rs.S: run through the C preprocessor with the C build's
+ * flags; what follows the cut is Rust, so it can't hold an apostrophe or a
+ * line starting with a hash.
+ */
+
+#include <linux/jump_label.h>
+
+// Cut here.
+
+#if defined(CONFIG_JUMP_LABEL) && (defined(CONFIG_X86_64) || defined(CONFIG_ARM64))
+
+macro_rules! static_branch_asm {
+    () => { concat_literals!(ARCH_STATIC_BRANCH_ASM("{symb} + {off} + {branch}", "{l_yes}")) };
+}
+
+#endif
diff --git a/fs/bcachefs/util/kernel.rs b/fs/bcachefs/util/kernel.rs
new file mode 100644
index 0000000..ac9a67f
--- /dev/null
+++ b/fs/bcachefs/util/kernel.rs
@@ -0,0 +1,217 @@
+use crate::c;
+
+/// C's READ and WRITE, as indices: io_ref[], io_clock[]...
+pub const READ:  usize = 0;
+pub const WRITE: usize = 1;
+
+pub const NSEC_PER_SEC: u64 = 1_000_000_000;
+
+#[cfg(kernel)]
+pub const PAGE_SIZE: usize = kernel::page::PAGE_SIZE;
+/// The shim's, include/linux/page.h
+#[cfg(not(kernel))]
+pub const PAGE_SIZE: usize = 4096;
+
+/// Ask @shrink to free @nr objects, as memory pressure would: its
+/// scan_objects(), GFP_KERNEL.
+///
+/// # Safety
+/// @shrink is a live shrinker.
+pub unsafe fn shrinker_scan(shrink: *mut c::shrinker, nr: core::ffi::c_ulong) {
+    // SAFETY: integers and a pointer, each valid as zero
+    let mut sc: c::shrink_control = unsafe { core::mem::zeroed() };
+    sc.gfp_mask = c::GFP_KERNEL;
+    sc.nr_to_scan = nr as _;
+
+    let scan = unsafe { (*shrink).scan_objects }.expect("shrinker without scan_objects");
+    unsafe { scan(shrink, &mut sc) };
+}
+
+/// The @i'th CPU of a spread across the online CPUs, NUMA-local ones first:
+/// as cpumask_local_spread(i, NUMA_NO_NODE).
+#[cfg(kernel)]
+pub fn cpumask_local_spread(i: u32) -> u32 {
+    unsafe { c::bch2_cpumask_local_spread(i) }
+}
+
+/// One more than the highest possible CPU number.
+#[cfg(kernel)]
+pub fn nr_cpu_ids() -> u32 {
+    unsafe { c::bch2_nr_cpu_ids() }
+}
+
+/// The smallest IO @bdev takes: bdev_logical_block_size().
+pub fn bdev_logical_block_size(bdev: &c::block_device) -> u32 {
+    // SAFETY: a block device's queue, for as long as it's open
+    #[cfg(kernel)]
+    return unsafe { (*bdev.bd_queue).limits.logical_block_size };
+    // SAFETY: as the kernel's
+    #[cfg(not(kernel))]
+    return unsafe { c::bdev_logical_block_size(core::ptr::from_ref(bdev).cast_mut()) };
+}
+
+/// The most @bdev discards at once, in sectors - 0 if it doesn't:
+/// bdev_max_discard_sectors(). Userspace discards nothing, as its shim says.
+pub fn bdev_max_discard_sectors(bdev: &c::block_device) -> u32 {
+    // SAFETY: a block device's queue, for as long as it's open
+    #[cfg(kernel)]
+    return unsafe { (*bdev.bd_queue).limits.max_discard_sectors };
+    #[cfg(not(kernel))]
+    {
+        let _ = bdev;
+        0
+    }
+}
+
+pub fn random_u64() -> u64 {
+    unsafe { c::bch2_get_random_u64() }
+}
+
+pub fn random_u64_below(ceil: u64) -> u64 {
+    assert!(ceil > 0);
+    unsafe { c::bch2_get_random_u64_below(ceil) }
+}
+
+// local_clock() is a static inline and cond_resched() a macro, so neither has
+// a symbol for Rust: util.c wraps both, as bch2_*, for the kernel and
+// userspace builds alike.
+pub fn local_clock() -> u64 {
+    unsafe { c::bch2_local_clock() }
+}
+
+pub fn cond_resched() {
+    unsafe { c::bch2_cond_resched() }
+}
+
+pub fn msleep(ms: u32) {
+    unsafe { c::bch2_msleep(ms) }
+}
+
+/// The system's memory, in bytes: totalram_pages() of them.
+pub fn totalram_bytes() -> usize {
+    unsafe { c::totalram_pages() as usize * PAGE_SIZE }
+}
+
+/// Jiffies a second.
+pub const HZ: core::ffi::c_ulong = c::HZ as core::ffi::c_ulong;
+
+/// Whether jiffies @a is after @b, across a wrap: time_after().
+pub fn time_after(a: core::ffi::c_ulong, b: core::ffi::c_ulong) -> bool {
+    (b.wrapping_sub(a) as core::ffi::c_long) < 0
+}
+
+/// The kernel's binding returns its own c_ulong, usize; the same width as
+/// core's.
+pub fn nsecs_to_jiffies(ns: u64) -> core::ffi::c_ulong {
+    unsafe { c::nsecs_to_jiffies(ns) as core::ffi::c_ulong }
+}
+
+/// The jiffies count. In the kernel it's a variable the timer interrupt
+/// writes, read as READ_ONCE() would; in userspace C's macro computes it from
+/// sched_clock(), which is local_clock() there.
+pub fn jiffies() -> core::ffi::c_ulong {
+    #[cfg(kernel)]
+    // SAFETY: a word, written whole, so a volatile read can't tear
+    let j = unsafe { core::ptr::read_volatile(&raw const ::kernel::bindings::jiffies) as core::ffi::c_ulong };
+    #[cfg(not(kernel))]
+    let j = nsecs_to_jiffies(local_clock());
+    j
+}
+
+#[cfg(kernel)]
+pub struct Comm([u8; c::TASK_COMM_LEN as usize]);
+
+#[cfg(kernel)]
+impl Comm {
+    pub fn as_cstr(&self) -> &core::ffi::CStr {
+        core::ffi::CStr::from_bytes_until_nul(&self.0).expect("comm is NUL terminated")
+    }
+}
+
+#[cfg(kernel)]
+impl core::fmt::Display for Comm {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        use core::fmt::Write;
+        match self.as_cstr().to_str() {
+            Ok(s) => f.write_str(s),
+            // A comm is bytes: what isn't ASCII, escaped
+            Err(_) => self.as_cstr().to_bytes().iter().try_for_each(|&b| match b.is_ascii() {
+                true  => f.write_char(b as char),
+                false => write!(f, "\\x{b:02x}"),
+            }),
+        }
+    }
+}
+
+#[cfg(kernel)]
+pub fn current_comm() -> Comm {
+    // SAFETY: our own task's comm, which only we set
+    Comm(unsafe { (*c::get_current()).comm })
+}
+
+/// The ids this task's new files are owned by. Its credentials are read as
+/// current_cred() reads them, without RCU: only the task itself replaces its
+/// own, so they live while it looks.
+#[cfg(kernel)]
+pub fn current_fsuid() -> c::kuid_t {
+    unsafe { (*(*c::get_current()).cred).fsuid }
+}
+
+#[cfg(kernel)]
+pub fn current_fsgid() -> c::kgid_t {
+    unsafe { (*(*c::get_current()).cred).fsgid }
+}
+
+/// A number identifying this task while it lives - C's (unsigned long)current
+/// - for hashing by task. In userspace, the thread's.
+pub fn current_id() -> usize {
+    #[cfg(kernel)]
+    // SAFETY: reads this CPU's current task, which is us
+    let id = unsafe { c::get_current() } as usize;
+    #[cfg(not(kernel))]
+    let id = {
+        std::thread_local!(static ME: u8 = const { 0 });
+        ME.with(|me| core::ptr::from_ref(me) as usize)
+    };
+    id
+}
+
+/// Whether this task has been sent a fatal signal: as
+/// fatal_signal_pending(current).
+pub fn fatal_signal_pending() -> bool {
+    unsafe { c::bch2_fatal_signal_pending() }
+}
+
+/// Wall-clock time, in seconds: ktime_get_real_seconds().
+pub fn ktime_get_real_seconds() -> i64 {
+    unsafe { c::ktime_get_real_seconds() as i64 }
+}
+
+/// The monotonic clock, in nanoseconds: ktime_get_ns().
+pub fn ktime_get_ns() -> u64 {
+    unsafe { c::bch2_ktime_get_ns() }
+}
+
+/// The number of CPUs online; in userspace, how many threads can run at once.
+pub fn num_online_cpus() -> u32 {
+    #[cfg(kernel)]
+    let n = unsafe { c::bch2_num_online_cpus() };
+    #[cfg(not(kernel))]
+    let n = std::thread::available_parallelism().map_or(1, |n| n.get() as u32);
+    n
+}
+
+/// A capability, as the kernel's CAP_* - the values are ABI
+/// (uapi/linux/capability.h). Defined here because userspace's capable()
+/// ignores its argument, so it has no CAP_* constants to bind.
+#[derive(Clone, Copy)]
+#[repr(i32)]
+pub enum Capability {
+    Fowner = 3,
+    SysAdmin = 21,
+}
+
+/// Whether the current task has @cap: as capable(). Always, in userspace.
+pub fn capable(cap: Capability) -> bool {
+    unsafe { c::bch2_capable(cap as i32) }
+}
diff --git a/fs/bcachefs/util/kthread.rs b/fs/bcachefs/util/kthread.rs
new file mode 100644
index 0000000..d73c008
--- /dev/null
+++ b/fs/bcachefs/util/kthread.rs
@@ -0,0 +1,205 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A kthread Rust owns: made stopped, woken, stopped - kthread_create(),
+//! wake_up_process(), kthread_stop() - for a long-lived thread, a daemon: the
+//! reconcile thread, copygc, journal reclaim. Jobs fanned out and joined are
+//! util::par's.
+//!
+//! The thread's closure is in an allocation the Kthread owns, freed once the
+//! thread's stopped - not the thread's to free: stopped before it first ran,
+//! the kernel's kthread() never calls its function. Userspace's does, so the
+//! closure isn't run once the thread's been told to stop, in either build.
+//!
+//! A daemon is kicked when there's work for it - kick(): a count bumped, then
+//! a wake. Its thread, handed its side (KthreadSelf), notes the count before a
+//! pass and sleeps after it until the count's moved - or a timer, or a stop -
+//! and whatever it's sleeping in, the wake has it recheck. C's daemons kept the
+//! count themselves, next to an RCU pointer to the thread to wake.
+//!
+//! One implementation for both builds, over C's API - userspace's is
+//! linux/kthread.c - through util.c's wrappers.
+
+use crate::c;
+use crate::errcode::{errptr_to_result, BchError};
+use crate::util::alloc::{alloc_pinned, free_pinned, AllocError};
+use crate::util::Printbuf;
+use core::cell::UnsafeCell;
+use core::ffi::{c_int, c_void};
+use core::fmt;
+use core::ptr::NonNull;
+use core::sync::atomic::{AtomicU32, Ordering};
+
+/// What the thread runs, until it takes it; and its kicks, which outlive it.
+struct Thread<F> {
+    kicks: AtomicU32,
+    f:     UnsafeCell<Option<F>>,
+}
+
+pub struct Kthread {
+    task:   NonNull<c::task_struct>,
+    thread: *mut c_void,
+    /// The Thread's, which lives as long as we do
+    kicks:  NonNull<AtomicU32>,
+    free:   unsafe fn(*mut c_void),
+}
+
+/// The thread's side of its Kthread, handed to its closure: the kicks it's
+/// had - the count Kthread::kick() bumps - to compare against one it saw.
+pub struct KthreadSelf<'a> {
+    kicks: &'a AtomicU32,
+}
+
+impl KthreadSelf<'_> {
+    /// The kicks so far: what a later kicked_since() compares against.
+    pub fn kicks(&self) -> u32 {
+        self.kicks.load(Ordering::Acquire)
+    }
+
+    /// Whether it's been kicked since it saw @seen kicks.
+    pub fn kicked_since(&self, seen: u32) -> bool {
+        self.kicks() != seen
+    }
+}
+
+// SAFETY: a task ref, which any thread may wake, stop and put; the closure,
+// Send, touched by its thread until it's stopped and by drop() after; the
+// kicks, an atomic
+unsafe impl Send for Kthread {}
+unsafe impl Sync for Kthread {}
+
+impl Kthread {
+    /// Thread @name, to run @f once woken - created stopped, as
+    /// kthread_create().
+    pub fn create<F: FnOnce(&KthreadSelf<'_>) + Send + 'static>(name: fmt::Arguments<'_>, f: F)
+        -> Result<Self, BchError>
+    {
+        let thread = alloc_pinned::<Thread<F>, AllocError>(Ok(Thread {
+            kicks: AtomicU32::new(0),
+            f:     UnsafeCell::new(Some(f)),
+        }))?;
+
+        let mut name_buf = Printbuf::new();
+        write!(name_buf, "{name}");
+
+        // SAFETY: @thread is run::<F>'s, until we free it after stopping it
+        let task = unsafe {
+            c::bch2_kthread_create(Some(run::<F>), thread.cast(), name_buf.as_c_str().as_ptr().cast())
+        };
+        let task = match errptr_to_result(NonNull::new(task).expect("kthread_create() gives a task or an error")) {
+            Ok(task) => task,
+            Err(e) => {
+                // SAFETY: the thread wasn't made, so nothing else has it
+                unsafe { free_pinned(thread) };
+                return Err(e);
+            }
+        };
+
+        // Ours, so it can be stopped after it's exited
+        // SAFETY: a task just made
+        unsafe { c::get_task_struct(task.as_ptr()) };
+        // SAFETY: the allocation's, which lives until drop() frees it
+        let kicks = unsafe { NonNull::from(&(*thread).kicks) };
+        Ok(Kthread { task, thread: thread.cast(), kicks, free: free_thread::<F> })
+    }
+
+    /// Start it, or wake it from a sleep: wake_up_process().
+    pub fn wake(&self) {
+        // SAFETY: our task ref
+        unsafe { c::wake_up_process(self.task.as_ptr()) };
+    }
+
+    /// Kick it: its kicks bumped, then woken from whatever it's sleeping in.
+    /// A sleep that's for a kick - KthreadSelf::kicked_since() in its
+    /// condition - ends; any other wakes, rechecks its own, and sleeps on.
+    /// The bump comes first, so a sleep checking after it sees it, and one
+    /// that checked before is woken.
+    pub fn kick(&self) {
+        // SAFETY: the Thread's, which lives as long as we do
+        unsafe { self.kicks.as_ref() }.fetch_add(1, Ordering::Release);
+        self.wake();
+    }
+
+    /// The task, for C that wakes it by pointer.
+    pub fn as_ptr(&self) -> *mut c::task_struct {
+        self.task.as_ptr()
+    }
+
+    /// Whether the current thread is a kthread told to stop:
+    /// kthread_should_stop() - false on a thread that isn't one.
+    pub fn should_stop() -> bool {
+        // SAFETY: plain; it checks PF_KTHREAD first
+        unsafe { c::bch2_kthread_should_stop() }
+    }
+
+    /// Make the current kthread one the freezer stops, as set_freezable():
+    /// it's frozen in place in a freezable sleep (Sleep::freezable()), so
+    /// every long sleep it does must be one, or it holds up suspend.
+    /// Userspace has no freezer.
+    pub fn set_freezable() {
+        // SAFETY: of the current task
+        #[cfg(kernel)]
+        let _ = unsafe { c::set_freezable() };
+    }
+
+    /// Whether the freezer wants the current thread: freezing(current). A
+    /// freezable kthread that can go a long while without a freezable sleep
+    /// - copygc, when there's always more to move - checks between pieces of
+    /// work, and stops to try_to_freeze().
+    pub fn freezing() -> bool {
+        // SAFETY: of the current task
+        #[cfg(kernel)]
+        let f = unsafe { c::freezing(c::bch2_current()) };
+        #[cfg(not(kernel))]
+        let f = false;
+        f
+    }
+
+    /// Freeze here, if the freezer wants us, until thawed: try_to_freeze().
+    /// Whether it froze. With no locks held - they'd stay held till the thaw.
+    pub fn try_to_freeze() -> bool {
+        // SAFETY: of the current task
+        #[cfg(kernel)]
+        let f = unsafe { c::try_to_freeze() };
+        #[cfg(not(kernel))]
+        let f = false;
+        f
+    }
+
+    /// Tell it to stop, and wait for it to: kthread_stop(). It may have
+    /// returned already, or never have run.
+    pub fn stop(self) {}
+}
+
+impl Drop for Kthread {
+    fn drop(&mut self) {
+        // SAFETY: our task ref, put once it's exited; then nothing runs its
+        // closure, so it's ours to free
+        unsafe {
+            c::bch2_kthread_stop(self.task.as_ptr());
+            c::put_task_struct(self.task.as_ptr());
+            (self.free)(self.thread);
+        }
+    }
+}
+
+/// The thread's function: @f, unless it's been told to stop before it ran.
+unsafe extern "C" fn run<F: FnOnce(&KthreadSelf<'_>) + Send + 'static>(data: *mut c_void) -> c_int {
+    if Kthread::should_stop() {
+        return 0;
+    }
+    // SAFETY: the Kthread's, which frees it only once we've exited; ours to
+    // take from, as nothing else touches it while we run
+    let thread = unsafe { &*data.cast::<Thread<F>>() };
+    let f = unsafe { (*thread.f.get()).take() };
+    if let Some(f) = f {
+        f(&KthreadSelf { kicks: &thread.kicks });
+    }
+    0
+}
+
+/// # Safety
+/// @p is a Thread<F> from Kthread::create(), its thread exited.
+unsafe fn free_thread<F>(p: *mut c_void) {
+    // SAFETY: the caller's
+    unsafe { free_pinned(p.cast::<Thread<F>>()) };
+}
diff --git a/fs/bcachefs/util/list.rs b/fs/bcachefs/util/list.rs
new file mode 100644
index 0000000..03dba6e
--- /dev/null
+++ b/fs/bcachefs/util/list.rs
@@ -0,0 +1,269 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! **Don't use this.** An intrusive list can't be made safe: linking an item
+//! is a promise about its lifetime that nothing checks, and every list that
+//! goes wrong goes wrong as use-after-free. New code wants a vector - KVVec,
+//! DArray - and the lists we have are to become vectors. This exists for
+//! what can't be one: the futex's waiters, whose entries live on their
+//! stacks so that waiting can't fail to allocate, and C's lists while C has
+//! them. Anything new needs an extremely good reason, said where it's used.
+//!
+//! include/linux/list.h's circular doubly linked list, in Rust, typed:
+//! List<T, OFFSET> is a list of T linked through the links at OFFSET in each,
+//! made by list!(T, member), which checks the member is links - ListLinks, or
+//! C's struct list_head. Laid out as C's, so C's lists are these too,
+//! from_c().
+//!
+//! What's safe, and why:
+//!
+//! - Holding the list is holding a &List or &mut List: one lives in a
+//!   Lock<R, List<T, OFFSET>>, and from_c() asserts C's is locked. Walking it
+//!   with a cursor, and reordering it - sort() - are safe.
+//! - An item is live, and doesn't move, while it's on the list, and after
+//!   it's taken off until the list's lock is next released: its owner takes
+//!   the lock before freeing it. So a cursor can take an item off and still
+//!   hand it back. Whoever links an item promises that: push_back() is
+//!   unsafe, and so is remove(), which needs the item, if it's on a list, to
+//!   be on this one.
+//!
+//! The links are Cells, written through shared references under the list's
+//! lock; ListLinks, what an item embeds, is Sync on that ground.
+
+use crate::c;
+use core::cell::Cell;
+use core::cmp::Ordering;
+use core::marker::PhantomData;
+use core::ptr;
+
+/// struct list_head.
+#[repr(C)]
+struct ListHead {
+    next: Cell<*const ListHead>,
+    prev: Cell<*const ListHead>,
+}
+
+const _: () = assert!(size_of::<ListHead>() == size_of::<c::list_head>() &&
+                      align_of::<ListHead>() == align_of::<c::list_head>());
+
+impl ListHead {
+    const fn new() -> Self {
+        ListHead { next: Cell::new(ptr::null()), prev: Cell::new(ptr::null()) }
+    }
+
+    /// INIT_LIST_HEAD().
+    fn init(&self) {
+        self.next.set(self);
+        self.prev.set(self);
+    }
+
+    /// No entries - or never init()ed, which is none either.
+    fn is_empty(&self) -> bool {
+        let next = self.next.get();
+        next.is_null() || ptr::eq(next, self)
+    }
+
+    /// list_add_tail(): @new before this one.
+    ///
+    /// # Safety
+    /// The list is held; @new is on none.
+    unsafe fn add_tail(&self, new: &ListHead) {
+        let prev = self.prev.get();
+        new.next.set(self);
+        new.prev.set(prev);
+        unsafe { (*prev).next.set(new) };
+        self.prev.set(new);
+    }
+
+    /// list_del_init().
+    ///
+    /// # Safety
+    /// The list is held, and it's on it.
+    unsafe fn del_init(&self) {
+        let (prev, next) = (self.prev.get(), self.next.get());
+        unsafe {
+            (*next).prev.set(prev);
+            (*prev).next.set(next);
+        }
+        self.init();
+    }
+}
+
+/// What a list's item embeds, to be on it.
+#[repr(transparent)]
+pub struct ListLinks(ListHead);
+
+// SAFETY: touched only through its list, under the list's lock
+unsafe impl Send for ListLinks {}
+unsafe impl Sync for ListLinks {}
+
+impl ListLinks {
+    pub const fn new() -> Self {
+        ListLinks(ListHead::new())
+    }
+}
+
+/// What list!() accepts as a member: links, Rust's or C's.
+pub trait IsLinks {}
+impl IsLinks for ListLinks {}
+impl IsLinks for c::list_head {}
+
+/// A list of T, linked through the links at OFFSET in each: list!().
+#[repr(transparent)]
+pub struct List<T, const OFFSET: usize> {
+    head: ListHead,
+    _t:   PhantomData<*const T>,
+}
+
+/// The List of @T through its member @member, which must be links.
+#[macro_export]
+macro_rules! list {
+    ($T:ty, $member:ident) => {
+        $crate::util::list::List<$T, {
+            fn _member_is_links(t: &$T) -> &impl $crate::util::list::IsLinks { &t.$member }
+            ::core::mem::offset_of!($T, $member)
+        }>
+    };
+}
+
+// SAFETY: the thread holding it is handed &T - T: Sync
+unsafe impl<T: Sync, const OFFSET: usize> Send for List<T, OFFSET> {}
+
+impl<T, const OFFSET: usize> List<T, OFFSET> {
+    const FITS: () = assert!(OFFSET + size_of::<ListHead>() <= size_of::<T>(),
+                             "List: links past the end of their item");
+
+    /// INIT_LIST_HEAD(): empty - from zeroed, which isn't a list yet.
+    ///
+    /// # Safety
+    /// It doesn't move while it has anything on it.
+    pub unsafe fn init(&self) {
+        self.head.init()
+    }
+
+    /// C's, held.
+    ///
+    /// # Safety
+    /// @p is a live list of T, through the list_head at OFFSET in each, whose
+    /// lock is held for 'a, and which nothing else in Rust borrows meanwhile.
+    pub unsafe fn from_c<'a>(p: *mut c::list_head) -> &'a mut Self {
+        let () = Self::FITS;
+        unsafe { &mut *p.cast() }
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.head.is_empty()
+    }
+
+    fn links(item: &T) -> &ListHead {
+        let () = Self::FITS;
+        // SAFETY: list!()'s: the links at OFFSET in a T
+        unsafe { &*ptr::from_ref(item).byte_add(OFFSET).cast() }
+    }
+
+    /// # Safety
+    /// @l is on this list, or was taken off it with the list held since.
+    unsafe fn item<'a>(l: *const ListHead) -> &'a T {
+        unsafe { &*l.byte_sub(OFFSET).cast() }
+    }
+
+    /// list_add_tail().
+    ///
+    /// # Safety
+    /// The list is init()ed. @item is on no list, and is live and doesn't move
+    /// until it's off this one and the list's lock has been released since:
+    /// its owner takes the lock before freeing it.
+    pub unsafe fn push_back(&mut self, item: &T) {
+        unsafe { self.head.add_tail(Self::links(item)) }
+    }
+
+    /// Takes @item off, if it's on: whether it was.
+    ///
+    /// # Safety
+    /// If it's on a list, it's this one.
+    pub unsafe fn remove(&mut self, item: &T) -> bool {
+        let l = Self::links(item);
+        let on = !l.is_empty();
+        if on {
+            unsafe { l.del_init() };
+        }
+        on
+    }
+
+    /// From the front: a place in the list, which can take its item off.
+    pub fn cursor_mut(&mut self) -> CursorMut<'_, T, OFFSET> {
+        let pos = if self.is_empty() { ptr::from_ref(&self.head) } else { self.head.next.get() };
+        CursorMut { list: self, pos }
+    }
+
+    /// Its items in @cmp's order, stably: an insertion sort, from the back,
+    /// for a list kept nearly in order - one in order costs a pass, and each
+    /// item out of order the distance it moves.
+    pub fn sort(&mut self, mut cmp: impl FnMut(&T, &T) -> Ordering) {
+        if self.is_empty() {
+            return;
+        }
+        let head: *const ListHead = &self.head;
+        // SAFETY: everything followed is on the list, which we hold
+        unsafe {
+            let mut cmp = |a, b| cmp(Self::item(a), Self::item(b));
+
+            // the first of the sorted run at the back
+            let mut pos = self.head.prev.get();
+            loop {
+                let e = (*pos).prev.get();
+                if ptr::eq(e, head) {
+                    break;
+                }
+                if cmp(e, pos) != Ordering::Greater {
+                    pos = e;
+                    continue;
+                }
+                // before the first in the run it isn't above - any equal to
+                // it came after it, and still do
+                (*e).del_init();
+                let mut q = (*pos).next.get();
+                while !ptr::eq(q, head) && cmp(q, e) == Ordering::Less {
+                    q = (*q).next.get();
+                }
+                (*q).add_tail(&*e);
+            }
+        }
+    }
+}
+
+/// A place in a held list.
+pub struct CursorMut<'a, T, const OFFSET: usize> {
+    list: &'a mut List<T, OFFSET>,
+    pos:  *const ListHead,
+}
+
+impl<'a, T, const OFFSET: usize> CursorMut<'a, T, OFFSET> {
+    fn at_end(&self) -> bool {
+        ptr::eq(self.pos, &self.list.head)
+    }
+
+    pub fn current(&self) -> Option<&'a T> {
+        // SAFETY: on the list, which we hold for 'a
+        (!self.at_end()).then(|| unsafe { List::<T, OFFSET>::item(self.pos) })
+    }
+
+    pub fn move_next(&mut self) {
+        if !self.at_end() {
+            // SAFETY: on the list
+            self.pos = unsafe { (*self.pos).next.get() };
+        }
+    }
+
+    /// Takes the current item off, onto the next: still live for 'a, the
+    /// list's held for that long.
+    pub fn remove_current(&mut self) -> Option<&'a T> {
+        let item = self.current()?;
+        let cur = self.pos;
+        // SAFETY: on the list, which we hold
+        unsafe {
+            self.pos = (*cur).next.get();
+            (*cur).del_init();
+        }
+        Some(item)
+    }
+}
diff --git a/fs/bcachefs/util/log.rs b/fs/bcachefs/util/log.rs
new file mode 100644
index 0000000..734813b
--- /dev/null
+++ b/fs/bcachefs/util/log.rs
@@ -0,0 +1,565 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Logging, as C's bch_log() family (bcachefs.h): a message is formatted
+//! here, then handed to __bch2_print() whole, so it goes where C's messages go -
+//! the filesystem's loglevel, a stdio redirect, the "previous loglevel" a
+//! continuation line inherits - without any of that being reimplemented.
+//!
+//! In-kernel each message is prefixed with the filesystem's name, as
+//! bch2_log_msg() does under BCACHEFS_LOG_PREFIX; userspace prints it bare.
+//!
+//! What C shares - struct bch_log_msg, and the C this calls - is declared here
+//! too: util/log_gen.h.
+
+#![allow(non_camel_case_types)]
+
+use crate::c;
+use crate::errcode::BchError;
+use crate::fs::Fs;
+use crate::types::c_default;
+use crate::util::ffi::c_char;
+use crate::util::{Printbuf, ToText};
+use core::cell::UnsafeCell;
+use core::ffi::{c_int, c_uint, CStr};
+use core::mem::MaybeUninit;
+use core::sync::atomic::{AtomicBool, Ordering};
+use cstruct_macros::{CStruct, c_enum, c_extern, TypeInfo};
+
+#[repr(C)]
+#[derive(CStruct, TypeInfo)]
+pub struct bch_log_msg {
+    pub c: *mut c::bch_fs,
+    pub loglevel: u8,
+    pub m: c::printbuf,
+}
+c_default!(bch_log_msg);
+
+c_enum! {
+    #[closed]
+    pub enum kern_loglevels: u32 {
+        LOGLEVEL_emerg = 0,
+        LOGLEVEL_alert = 1,
+        LOGLEVEL_crit = 2,
+        LOGLEVEL_err = 3,
+        LOGLEVEL_warning = 4,
+        LOGLEVEL_notice = 5,
+        LOGLEVEL_info = 6,
+        LOGLEVEL_debug = 7,
+    }
+}
+
+c_extern! {
+    #[c_printf(2, 3)]
+    pub fn __bch2_print(c: *mut c::bch_fs, fmt: *const c_char, ...);
+    pub fn bch2_ratelimit_state_init(rs: *mut c::ratelimit_state);
+    pub fn bch2_ratelimit_suppress(c: *mut c::bch_fs, rs: *mut c::ratelimit_state,
+                                   func: *const c_char) -> bool;
+    pub fn bch2_rust_warn(file: *const c_char, line: c_uint);
+    pub fn bch2_print_str_loglevel(c: *mut c::bch_fs, loglevel: c_int, str: *const c_char);
+    pub fn __bch2_log_msg_start(fs_or_dev_name: *const c_char, out: *mut c::printbuf);
+}
+
+/// A printk loglevel: KERN_SOH followed by the level, as C's KERN_* strings.
+#[derive(Clone, Copy)]
+pub struct LogLevel(u8);
+
+impl LogLevel {
+    pub const ERR:    Self = LogLevel(b'3');
+    pub const WARN:   Self = LogLevel(b'4');
+    pub const NOTICE: Self = LogLevel(b'5');
+    pub const INFO:   Self = LogLevel(b'6');
+    pub const DEBUG:  Self = LogLevel(b'7');
+
+    /// As C's LOGLEVEL_* numbers.
+    fn as_int(self) -> i32 {
+        (self.0 - b'0') as i32
+    }
+}
+
+/// Print @msg at @level: what the bch_err!() family expands to.
+pub fn log(fs: &Fs, level: LogLevel, msg: &dyn ToText) {
+    print(fs, level.0, true, msg, true)
+}
+
+/// @msg at @level, of no filesystem - there isn't one yet: pr_err() and the
+/// rest of printk().
+pub fn log_no_fs(level: LogLevel, msg: &dyn ToText) {
+    printk(level, &crate::util::printbuf::Msg(|out: &mut Printbuf| {
+        msg.to_text(out);
+        out.newline();
+    }))
+}
+
+/// @msg at @level, as it stands, where @opts says: its stdio redirect,
+/// in-kernel, if it has one - a fsck through the ioctl's - else printk().
+/// Of no filesystem, before there's one: bch2_print_opts().
+pub fn log_opts(opts: &c::bch_opts, level: LogLevel, msg: &dyn ToText) {
+    #[cfg(kernel)]
+    if opts.stdio != 0 {
+        let mut buf = Printbuf::new();
+        msg.to_text(&mut buf);
+        // SAFETY: @opts' stdio is the fsck thread's redirect, live for as
+        // long as its opts are
+        let stdio = unsafe {
+            crate::util::thread_with_file::StdioRedirect::from_c(opts.stdio as *mut c::stdio_redirect)
+        };
+        let _ = stdio.write(true, buf.as_bytes());
+        return;
+    }
+    #[cfg(not(kernel))]
+    let _ = opts;
+    printk(level, msg)
+}
+
+/// @msg at @level, as it stands.
+fn printk(level: LogLevel, msg: &dyn ToText) {
+    let mut buf = Printbuf::new();
+    buf.write_bytes(&[0x01, level.0]);
+    msg.to_text(&mut buf);
+    let s = buf.as_c_str();
+    // SAFETY: a format, and the string it takes
+    #[cfg(kernel)]
+    unsafe { c::_printk(c"%s".as_ptr().cast(), s.as_ptr()) };
+    // SAFETY: as the kernel's
+    #[cfg(not(kernel))]
+    unsafe { c::printk(c"%s".as_ptr().cast(), s.as_ptr()) };
+}
+
+/// log(), without the newline: a line for log_cont() to finish - C's
+/// bch2_print(c, KERN_INFO bch2_log_msg(c, ...)).
+pub fn log_start(fs: &Fs, level: LogLevel, msg: &dyn ToText) {
+    print(fs, level.0, true, msg, false)
+}
+
+/// The rest of the line log_start() began: KERN_CONT.
+pub fn log_cont(fs: &Fs, msg: &dyn ToText) {
+    print(fs, b'c', false, msg, true)
+}
+
+/// @msg at printk level @level, after the filesystem's name if @prefix, and
+/// a newline if @newline.
+fn print(fs: &Fs, level: u8, prefix: bool, msg: &dyn ToText, newline: bool) {
+    let mut buf = Printbuf::new();
+
+    #[cfg(kernel)]
+    if prefix {
+        write!(buf, "bcachefs ({}): ", fs.name().to_str().unwrap_or("?"));
+    }
+    #[cfg(not(kernel))]
+    let _ = prefix;
+    msg.to_text(&mut buf);
+    if newline {
+        buf.newline();
+    }
+
+    // KERN_SOH, level, then the message as data: a '%' in it is text.
+    let fmt = [0x01, level, b'%', b's', 0];
+    unsafe {
+        __bch2_print(fs.as_ptr(), fmt.as_ptr() as *const c_char, buf.as_raw().buf);
+    }
+}
+
+/// @msg at @level after device @ca's name, as C's bch_dev_log() - in
+/// userspace too, unlike the filesystem's.
+pub fn log_dev(ca: &c::bch_dev, level: LogLevel, msg: &dyn ToText) {
+    let msg = crate::util::printbuf::Msg(|out: &mut Printbuf| {
+        #[cfg(kernel)]
+        write!(out, "bcachefs ({ca}): ");
+        #[cfg(not(kernel))]
+        write!(out, "{ca}: ");
+        msg.to_text(out);
+    });
+    print(ca.fs(), level.0, false, &msg, true)
+}
+
+/// Print @msg at @level as it stands, one line at a time with no prefix -
+/// C's bch2_print_str().
+pub fn print_str(fs: &Fs, level: LogLevel, msg: &mut Printbuf) {
+    let buf = msg.as_raw().buf;
+    if !buf.is_null() {
+        unsafe { bch2_print_str_loglevel(fs.as_ptr(), level.as_int(), buf) };
+    }
+}
+
+/// A message built up in pieces and printed when dropped - C's
+/// CLASS(bch_log_msg). Continuation lines are indented under the first and
+/// raw `\t`/`\r` columns aligned; it goes out whole, through
+/// bch2_print_str_loglevel() as C's does, unless suppressed - by
+/// count_fsck_err(), when it's a repeat or being ratelimited.
+pub struct LogMsg<'a> {
+    fs:    &'a Fs,
+    level: LogLevel,
+    msg:   Printbuf,
+}
+
+/// @name's prefix, in-kernel, and the continuation indent.
+pub fn log_msg_start(out: &mut Printbuf, name: &CStr) {
+    unsafe { __bch2_log_msg_start(name.as_ptr().cast(), out.as_raw()) }
+}
+
+impl<'a> LogMsg<'a> {
+    /// At err.
+    pub fn new(fs: &'a Fs) -> Self {
+        Self::with_level(fs, LogLevel::ERR)
+    }
+
+    pub fn with_level(fs: &'a Fs, level: LogLevel) -> Self {
+        let mut msg = Printbuf::new();
+        log_msg_start(&mut msg, fs.name());
+        LogMsg { fs, level, msg }
+    }
+
+    /// For a message whose level depends on how things turned out.
+    pub fn set_level(&mut self, level: LogLevel) {
+        self.level = level;
+    }
+}
+
+impl core::ops::Deref for LogMsg<'_> {
+    type Target = Printbuf;
+    fn deref(&self) -> &Printbuf { &self.msg }
+}
+
+impl core::ops::DerefMut for LogMsg<'_> {
+    fn deref_mut(&mut self) -> &mut Printbuf { &mut self.msg }
+}
+
+impl Drop for LogMsg<'_> {
+    fn drop(&mut self) {
+        if self.msg.is_suppressed() {
+            return;
+        }
+
+        self.msg.tabstop_align();
+        let buf = self.msg.as_raw().buf;
+        if !buf.is_null() {
+            unsafe { bch2_print_str_loglevel(self.fs.as_ptr(), self.level.as_int(), buf) };
+        }
+    }
+}
+
+/// One call site's ratelimit state, for the _ratelimited log macros: as the
+/// static DEFINE_RATELIMIT_STATE() in C's bch2_ratelimit(). The state holds a
+/// spinlock that has to be initialized at runtime, so it's set up on first use.
+#[doc(hidden)]
+pub struct Ratelimit {
+    claim: AtomicBool,
+    ready: AtomicBool,
+    state: UnsafeCell<MaybeUninit<c::ratelimit_state>>,
+}
+
+// state is initialized once, by whoever claims it, before ready is published;
+// after that only ___ratelimit() touches it, under its lock.
+unsafe impl Sync for Ratelimit {}
+
+impl Default for Ratelimit {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl Ratelimit {
+    pub const fn new() -> Self {
+        Ratelimit {
+            claim: AtomicBool::new(false),
+            ready: AtomicBool::new(false),
+            state: UnsafeCell::new(MaybeUninit::uninit()),
+        }
+    }
+
+    /// Whether to drop a message from @func: as bch2_ratelimit(), which only
+    /// ratelimits with the ratelimit_errors option. A message that races the
+    /// first one's setup of the state isn't ratelimited.
+    pub fn suppress(&self, fs: &Fs, func: &CStr) -> bool {
+        let state = unsafe { (*self.state.get()).as_mut_ptr() };
+
+        if !self.ready.load(Ordering::Acquire) {
+            if self.claim.swap(true, Ordering::AcqRel) {
+                return false;
+            }
+            unsafe { bch2_ratelimit_state_init(state) };
+            self.ready.store(true, Ordering::Release);
+        }
+
+        unsafe { bch2_ratelimit_suppress(fs.as_ptr(), state, func.as_ptr().cast()) }
+    }
+}
+
+/// As C's bch_log_ratelimited(): what the bch_err_ratelimited!() family
+/// expands to, with ratelimit state per call site.
+#[macro_export]
+macro_rules! bch_log_ratelimited {
+    ($fs:expr, $level:expr, $($arg:tt)*) => {{
+        static RATELIMIT: $crate::util::log::Ratelimit = $crate::util::log::Ratelimit::new();
+        let fs: &$crate::fs::Fs = $fs;
+        if !RATELIMIT.suppress(fs, $crate::c_function_name!()) {
+            $crate::util::log::log(fs, $level, $crate::message!($($arg)*));
+        }
+    }};
+}
+
+/// A LogMsg at err, suppressed while this call site is ratelimited: C's
+/// CLASS(bch_log_msg_ratelimited).
+#[macro_export]
+macro_rules! log_msg_ratelimited {
+    ($fs:expr) => {{
+        static RATELIMIT: $crate::util::log::Ratelimit = $crate::util::log::Ratelimit::new();
+        let fs: &$crate::fs::Fs = $fs;
+        let mut msg = $crate::util::log::LogMsg::new(fs);
+        msg.set_suppressed(RATELIMIT.suppress(fs, $crate::c_function_name!()));
+        msg
+    }};
+}
+
+#[macro_export]
+macro_rules! bch_err_ratelimited {
+    ($fs:expr, $($arg:tt)*) => {
+        $crate::bch_log_ratelimited!($fs, $crate::util::log::LogLevel::ERR, $($arg)*)
+    };
+}
+
+#[macro_export]
+macro_rules! bch_warn_ratelimited {
+    ($fs:expr, $($arg:tt)*) => {
+        $crate::bch_log_ratelimited!($fs, $crate::util::log::LogLevel::WARN, $($arg)*)
+    };
+}
+
+#[macro_export]
+macro_rules! bch_info_ratelimited {
+    ($fs:expr, $($arg:tt)*) => {
+        $crate::bch_log_ratelimited!($fs, $crate::util::log::LogLevel::INFO, $($arg)*)
+    };
+}
+
+#[macro_export]
+macro_rules! bch_verbose_ratelimited {
+    ($fs:expr, $($arg:tt)*) => {
+        $crate::bch_log_ratelimited!($fs, $crate::util::log::LogLevel::DEBUG, $($arg)*)
+    };
+}
+
+/// As C's should_print_err(): a restart isn't an error worth reporting.
+pub fn should_print_err(err: &BchError) -> bool {
+    !crate::btree::iter::is_restart(err)
+}
+
+#[macro_export]
+macro_rules! bch_err {
+    ($fs:expr, $($arg:tt)*) => {
+        $crate::util::log::log($fs, $crate::util::log::LogLevel::ERR, $crate::message!($($arg)*))
+    };
+}
+
+#[macro_export]
+macro_rules! bch_warn {
+    ($fs:expr, $($arg:tt)*) => {
+        $crate::util::log::log($fs, $crate::util::log::LogLevel::WARN, $crate::message!($($arg)*))
+    };
+}
+
+#[macro_export]
+macro_rules! bch_notice {
+    ($fs:expr, $($arg:tt)*) => {
+        $crate::util::log::log($fs, $crate::util::log::LogLevel::NOTICE, $crate::message!($($arg)*))
+    };
+}
+
+#[macro_export]
+macro_rules! bch_info {
+    ($fs:expr, $($arg:tt)*) => {
+        $crate::util::log::log($fs, $crate::util::log::LogLevel::INFO, $crate::message!($($arg)*))
+    };
+}
+
+/// As C's bch_verbose(): KERN_DEBUG.
+#[macro_export]
+macro_rules! bch_verbose {
+    ($fs:expr, $($arg:tt)*) => {
+        $crate::util::log::log($fs, $crate::util::log::LogLevel::DEBUG, $crate::message!($($arg)*))
+    };
+}
+
+/// As C's WARN_ON(): the kernel's warning in-kernel - through C, not the
+/// kernel crate's warn_on!(), see bch2_rust_warn() - and what the userspace
+/// shim's WARN_ON() prints otherwise. Evaluates to @cond.
+#[macro_export]
+macro_rules! warn_on {
+    ($cond:expr) => {{
+        let cond: bool = $cond;
+        #[cfg(kernel)]
+        if cond {
+            // SAFETY: a NUL-terminated string literal.
+            unsafe {
+                $crate::util::log::bch2_rust_warn(
+                    concat!(file!(), "\0").as_ptr().cast(),
+                    line!(),
+                )
+            };
+        }
+        #[cfg(not(kernel))]
+        if cond {
+            std::eprintln!("WARNING at {}:{}", file!(), line!());
+        }
+        cond
+    }};
+}
+
+/// As C's WARN_ON_ONCE(): warn_on!(), the first time @cond holds at this
+/// call site. Evaluates to @cond.
+#[macro_export]
+macro_rules! warn_on_once {
+    ($cond:expr) => {{
+        static WARNED: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+        let cond: bool = $cond;
+        if cond && !WARNED.swap(true, core::sync::atomic::Ordering::Relaxed) {
+            $crate::warn_on!(true);
+        }
+        cond
+    }};
+}
+
+/// As C's WARN_ONCE(): warn_on_once!(), with @msg logged before the warning.
+/// Evaluates to @cond.
+#[macro_export]
+macro_rules! warn_once {
+    ($cond:expr, $fs:expr, $($msg:tt)*) => {{
+        static WARNED: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+        let cond: bool = $cond;
+        if cond && !WARNED.swap(true, core::sync::atomic::Ordering::Relaxed) {
+            $crate::bch_err!($fs, $($msg)*);
+            $crate::warn_on!(true);
+        }
+        cond
+    }};
+}
+
+/// The name of the function this is expanded in, as C's __func__ - the
+/// function, not a closure inside it.
+#[macro_export]
+macro_rules! function_name {
+    () => {{
+        fn f() {}
+        let mut name = core::any::type_name_of_val(&f);
+        name = name.strip_suffix("::f").unwrap_or(name);
+        while let Some(n) = name.strip_suffix("::{{closure}}") {
+            name = n;
+        }
+        name.rsplit("::").next().unwrap_or(name)
+    }};
+}
+
+/// As function_name!(), but as a C string that lives forever, for C that
+/// takes __func__.
+#[macro_export]
+macro_rules! c_function_name {
+    () => {{
+        static NAME: $crate::util::log::CFnName = $crate::util::log::CFnName::new();
+        NAME.get($crate::function_name!())
+    }};
+}
+
+/// One call site's function name, for c_function_name!(): Rust only has it at
+/// runtime and unterminated, so it's copied into a static buffer on first use.
+#[doc(hidden)]
+pub struct CFnName {
+    claim: AtomicBool,
+    ready: AtomicBool,
+    buf:   UnsafeCell<[u8; 64]>,
+}
+
+// buf is written once, by whoever claims it, before ready is published, and
+// only read after that.
+unsafe impl Sync for CFnName {}
+
+impl Default for CFnName {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl CFnName {
+    pub const fn new() -> Self {
+        CFnName {
+            claim: AtomicBool::new(false),
+            ready: AtomicBool::new(false),
+            buf:   UnsafeCell::new([0; 64]),
+        }
+    }
+
+    /// @name, NUL-terminated and truncated to fit: "(unknown)" while another
+    /// thread is filling it in.
+    pub fn get(&self, name: &str) -> &CStr {
+        if !self.ready.load(Ordering::Acquire) {
+            if self.claim.swap(true, Ordering::AcqRel) {
+                return c"(unknown)";
+            }
+
+            let buf = unsafe { &mut *self.buf.get() };
+            let n = name.len().min(buf.len() - 1);
+            buf[..n].copy_from_slice(&name.as_bytes()[..n]);
+            buf[n] = 0;
+            self.ready.store(true, Ordering::Release);
+        }
+
+        let buf = unsafe { &*self.buf.get() };
+        CStr::from_bytes_until_nul(buf).expect("buf is NUL-terminated")
+    }
+}
+
+/// As C's bch_err_fn(): report an error from @result, naming the function -
+/// unless it's a restart, which isn't one. Evaluates to @result, so it can
+/// wrap the call: `bch_err_fn!(fs, f())?`.
+#[macro_export]
+macro_rules! bch_err_fn {
+    ($fs:expr, $result:expr) => {{
+        let result = $result;
+        if let Err(e) = &result {
+            let e: $crate::errcode::BchError = (*e).into();
+            if $crate::util::log::should_print_err(&e) {
+                $crate::bch_err!($fs, "{}(): error {}", $crate::function_name!(), e.msg());
+            }
+        }
+        result
+    }};
+}
+
+/// As C's bch_err_msg(): bch_err_fn!(), saying what we were doing. Evaluates
+/// to @result, as bch_err_fn!() does.
+#[macro_export]
+macro_rules! bch_err_msg {
+    ($fs:expr, $result:expr, $($arg:tt)*) => {{
+        let result = $result;
+        if let Err(e) = &result {
+            let e: $crate::errcode::BchError = (*e).into();
+            if $crate::util::log::should_print_err(&e) {
+                $crate::bch_err!($fs, "{}(): error {} {}", $crate::function_name!(),
+                                 $crate::message!($($arg)*), e.msg());
+            }
+        }
+        result
+    }};
+}
+
+#[macro_export]
+macro_rules! bch_err_dev {
+    ($ca:expr, $($arg:tt)*) => {
+        $crate::util::log::log_dev($ca, $crate::util::log::LogLevel::ERR, $crate::message!($($arg)*))
+    };
+}
+
+/// As C's bch_err_msg_dev(): bch_err_msg!(), after the device's name.
+#[macro_export]
+macro_rules! bch_err_msg_dev {
+    ($ca:expr, $result:expr, $($arg:tt)*) => {{
+        let result = $result;
+        if let Err(e) = &result {
+            let e: $crate::errcode::BchError = (*e).into();
+            if $crate::util::log::should_print_err(&e) {
+                $crate::bch_err_dev!($ca, "{}(): error {} {}", $crate::function_name!(),
+                                     $crate::message!($($arg)*), e.msg());
+            }
+        }
+        result
+    }};
+}
diff --git a/fs/bcachefs/util/mean_and_variance.c b/fs/bcachefs/util/mean_and_variance.c
new file mode 100644
index 0000000..9566169
--- /dev/null
+++ b/fs/bcachefs/util/mean_and_variance.c
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Streaming median + MAD estimators (all-time and exponentially-weighted).
+ *
+ * Replaces an earlier sum-of-squares variance implementation; see the
+ * struct comments in mean_and_variance.h for the streaming-estimator
+ * design.
+ */
+
+#include <linux/bug.h>
+#include <linux/compiler.h>
+#include <linux/export.h>
+#include <linux/limits.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+
+#include "mean_and_variance.h"
+
+/**
+ * mean_and_variance_get_mean() - get mean from @s
+ * @s: mean and variance number of samples and their sums
+ */
+s64 mean_and_variance_get_mean(struct mean_and_variance s)
+{
+	return s.n ? div64_u64(s.sum, s.n) : 0;
+}
+EXPORT_SYMBOL_GPL(mean_and_variance_get_mean);
+
+/**
+ * mean_and_variance_get_mad() - get the all-time MAD (median absolute deviation)
+ *
+ * Tracked by stochastic-gradient median on |x − median| with a 1/n step
+ * schedule. Robbins-Monro consistent: converges to the true MAD as n → ∞.
+ */
+u64 mean_and_variance_get_mad(struct mean_and_variance s)
+{
+	return s.n ? s.mad : 0;
+}
+EXPORT_SYMBOL_GPL(mean_and_variance_get_mad);
+
+/**
+ * mean_and_variance_get_stddev() - Gaussian-equivalent dispersion estimate
+ *
+ * Returns 1.4826 · MAD (~σ for Gaussian inputs), approximated as
+ * (mad * 1518) >> 10 (~0.01% error). Preserves the existing "stddev"
+ * readout label.
+ */
+u32 mean_and_variance_get_stddev(struct mean_and_variance s)
+{
+	return s.n ? (s.mad * 1518) >> 10 : 0;
+}
+EXPORT_SYMBOL_GPL(mean_and_variance_get_stddev);
+
+/**
+ * mean_and_variance_get_median() - get the current median estimate.
+ */
+s64 mean_and_variance_get_median(struct mean_and_variance s)
+{
+	return s.median;
+}
+EXPORT_SYMBOL_GPL(mean_and_variance_get_median);
+
+MODULE_AUTHOR("Daniel B. Hill");
+MODULE_LICENSE("GPL");
diff --git a/fs/bcachefs/util/mean_and_variance.h b/fs/bcachefs/util/mean_and_variance.h
new file mode 100644
index 0000000..c22ae28
--- /dev/null
+++ b/fs/bcachefs/util/mean_and_variance.h
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef MEAN_AND_VARIANCE_H_
+#define MEAN_AND_VARIANCE_H_
+
+#include <linux/log2.h>
+#include <linux/math64.h>
+#include <linux/types.h>
+
+#include "util/mean_and_variance_gen.h"
+
+/**
+ * sgm_median_mad_step() - one stochastic-gradient update of median + MAD.
+ * @median:	estimator state
+ * @mad:	estimator state
+ * @x:		new sample
+ * @weight:	log2 of step rate; step = max(mad >> weight, 1)
+ */
+static inline void
+sgm_median_mad_step(s64 *median, u64 *mad, s64 x, u8 weight)
+{
+	u64 step = max_t(u64, *mad >> weight, 1);
+
+	if (x > *median)
+		*median += step;
+	else if (x < *median)
+		*median -= step;
+
+	u64 dev = abs(x - *median);
+
+	if (dev > *mad)
+		*mad += step;
+	else if (dev < *mad && *mad > step)
+		*mad -= step;
+	else if (dev < *mad)
+		*mad = 1;
+}
+
+/**
+ * mean_and_variance_update() - update a mean_and_variance struct with @x.
+ * @weight: 0 selects the all-time (Robbins-Monro 1/n) schedule;
+ *	    nonzero is the EW step weight (half-life ≈ 2^weight samples).
+ *
+ * Always tracks exact sum + n. Median + MAD are updated via the same
+ * stochastic-gradient step kernel; the only difference between the
+ * all-time and EW variants is the step-rate schedule.
+ */
+static inline void
+mean_and_variance_update(struct mean_and_variance *s, s64 x, u8 weight)
+{
+	s->n++;
+	s->sum += x;
+
+	if (s->n == 1) {
+		s->median = x;
+		s->mad = max_t(u64, abs(x), 1);
+		return;
+	}
+
+	if (!weight)
+		weight = ilog2(s->n);
+
+	sgm_median_mad_step(&s->median, &s->mad, x, weight);
+}
+
+s64 mean_and_variance_get_mean(struct mean_and_variance s);
+s64 mean_and_variance_get_median(struct mean_and_variance s);
+u64 mean_and_variance_get_mad(struct mean_and_variance s);
+u32 mean_and_variance_get_stddev(struct mean_and_variance s);
+
+#endif // MEAN_AND_VAIRANCE_H_
diff --git a/fs/bcachefs/util/mean_and_variance_test.c b/fs/bcachefs/util/mean_and_variance_test.c
new file mode 100644
index 0000000..ae8b187
--- /dev/null
+++ b/fs/bcachefs/util/mean_and_variance_test.c
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <kunit/test.h>
+
+#include "mean_and_variance.h"
+
+static void mean_and_variance_basic_test(struct kunit *test)
+{
+	struct mean_and_variance s = {};
+
+	/*
+	 * Mean is exact via sum/n. MAD is a streaming estimator (Robbins-Monro
+	 * 1/n schedule) so we only assert convergence-shaped properties, not
+	 * exact values.
+	 */
+
+	mean_and_variance_update(&s, 2, 0);
+	mean_and_variance_update(&s, 2, 0);
+
+	KUNIT_EXPECT_EQ(test, mean_and_variance_get_mean(s), 2);
+	KUNIT_EXPECT_EQ(test, s.n, 2);
+
+	mean_and_variance_update(&s, 4, 0);
+	mean_and_variance_update(&s, 4, 0);
+
+	KUNIT_EXPECT_EQ(test, mean_and_variance_get_mean(s), 3);
+	KUNIT_EXPECT_EQ(test, s.n, 4);
+
+	/* Many constant samples afterwards: MAD should decay toward 1. */
+	for (int i = 0; i < 4096; i++)
+		mean_and_variance_update(&s, 3, 0);
+	KUNIT_EXPECT_LE(test, mean_and_variance_get_mad(s), 4);
+}
+
+/* Streaming median + MAD: sanity checks on convergence behaviour. */
+
+static void mean_and_variance_weighted_constant_test(struct kunit *test)
+{
+	/* Many samples of a constant: median -> X, MAD -> small. */
+	struct mean_and_variance s = { };
+
+	for (int i = 0; i < 4096; i++) {
+		mean_and_variance_update(&s, 100, 8);
+	}
+
+	KUNIT_EXPECT_EQ(test, mean_and_variance_get_median(s), 100);
+	KUNIT_EXPECT_LE(test, mean_and_variance_get_mad(s), 4);
+}
+
+static void mean_and_variance_weighted_step_test(struct kunit *test)
+{
+	/*
+	 * Switch from one value to another and verify the median moves toward
+	 * the new value (monotonically, while only feeding samples above it).
+	 */
+	struct mean_and_variance s = { };
+	s64 prev_median = 0;
+
+	mean_and_variance_update(&s, 100, 8);
+
+	prev_median = mean_and_variance_get_median(s);
+	for (int i = 0; i < 4096; i++) {
+		mean_and_variance_update(&s, 1000, 8);
+		s64 m = mean_and_variance_get_median(s);
+		KUNIT_EXPECT_GE(test, m, prev_median);
+		prev_median = m;
+	}
+
+	KUNIT_EXPECT_GE(test, mean_and_variance_get_median(s), 900);
+}
+
+static void mean_and_variance_weighted_outlier_test(struct kunit *test)
+{
+	/* One huge outlier shouldn't blow up the dispersion estimate. */
+	struct mean_and_variance s = { };
+
+	for (int i = 0; i < 1024; i++) {
+		mean_and_variance_update(&s, 100, 8);
+	}
+
+	u64 mad_before = mean_and_variance_get_mad(s);
+	mean_and_variance_update(&s, 1000000, 8);
+	u64 mad_after = mean_and_variance_get_mad(s);
+
+	/* MAD can only grow by ~mad_before/256 per sample; bounded growth. */
+	KUNIT_EXPECT_LE(test, mad_after, mad_before + (mad_before >> 7) + 1);
+}
+
+static struct kunit_case mean_and_variance_test_cases[] = {
+	KUNIT_CASE(mean_and_variance_basic_test),
+	KUNIT_CASE(mean_and_variance_weighted_constant_test),
+	KUNIT_CASE(mean_and_variance_weighted_step_test),
+	KUNIT_CASE(mean_and_variance_weighted_outlier_test),
+	{}
+};
+
+static struct kunit_suite mean_and_variance_test_suite = {
+	.name		= "mean and variance tests",
+	.test_cases	= mean_and_variance_test_cases
+};
+
+kunit_test_suite(mean_and_variance_test_suite);
+
+MODULE_AUTHOR("Daniel B. Hill");
+MODULE_DESCRIPTION("bcachefs filesystem mean and variance unit tests");
+MODULE_LICENSE("GPL");
diff --git a/fs/bcachefs/util/mean_and_variance_types.rs b/fs/bcachefs/util/mean_and_variance_types.rs
new file mode 100644
index 0000000..0190e3e
--- /dev/null
+++ b/fs/bcachefs/util/mean_and_variance_types.rs
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use cstruct_macros::CStruct;
+
+/*
+ * Streaming median + MAD (median absolute deviation), via a
+ * stochastic-gradient estimator on the L1 losses:
+ *
+ *	median minimizes E[|X − m|]	→ ∇ = −sign(X − m)
+ *	MAD	minimizes E[||X − m| − d|]	→ ∇ = −sign(|X − m| − d)
+ *
+ * Two update modes share the same struct and the same step kernel:
+ *
+ *  - All-time:  mean_and_variance_update(s, x)
+ *	 step ≈ mad / n (Robbins-Monro 1/n schedule via ilog2(n) shift).
+ *	 Σα diverges, Σα² converges → the estimator is *consistent*,
+ *	 converging to the true (lifetime) median and MAD as n → ∞.
+ *	 Additionally maintains exact sum and count, so the true mean
+ *	 is available via mean_and_variance_get_mean().
+ *
+ *  - Exponentially-weighted: mean_and_variance_update_weighted(s, x, w)
+ *	 step = mad >> w (fixed weight). Asymptotic half-life is 2^w
+ *	 samples; steady-state wobble is ~mad/2^w. Tracks the median of
+ *	 the EW-weighted stream — sum and count fields are ignored.
+ *
+ * Per-sample work is shifts, adds, and sign bits: no multiplication,
+ * no division, no sqrt, no u128. MAD is robust to outliers — a single
+ * 100ms hiccup in a µs stream doesn't blow up the dispersion estimate.
+ * The mad-scaled step makes both modes scale-invariant: same convergence
+ * shape for ns- or s-magnitude inputs, no per-call-site tuning.
+ *
+ * For Gaussian inputs, σ ≈ 1.4826·MAD; the get_stddev helper returns
+ * that scaled value so existing "stddev" readout labels keep meaning
+ * roughly "spread around typical."
+ */
+#[repr(C)]
+#[derive(Clone, Copy, Default, CStruct)]
+pub struct mean_and_variance {
+    pub n: i64,
+    pub sum: i64,
+    pub median: i64,
+    pub mad: u64,
+}
diff --git a/fs/bcachefs/util/mempool.rs b/fs/bcachefs/util/mempool.rs
new file mode 100644
index 0000000..b774c9f
--- /dev/null
+++ b/fs/bcachefs/util/mempool.rs
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! The kernel's mempool - userspace's is linux/mempool.c - of kvmalloc()'d
+//! elements: mempool_init_kvmalloc_pool(), util.c's element allocator.
+//!
+//! A Mempool is set up once, when it's first wanted, and used from then on
+//! without a lock. Its mempool_t is inline, as C's, and set up in place by
+//! whoever claims it first - @state 0 to 1 - so setting it up is safe from
+//! anywhere: a racing caller waits for the claimant's, or claims it again if
+//! that failed. Zeroed, it isn't set up. It's exited when it drops, a no-op on
+//! one never set up. Allocating waits for an element: GFP_KERNEL, the
+//! caller's memalloc scope saying the rest.
+
+use crate::c;
+use crate::errcode::{ret_to_result_void, BchError};
+use crate::util::ffi::Opaque;
+use crate::util::kernel::cond_resched;
+use core::ffi::{c_int, c_void};
+use core::ptr::NonNull;
+use core::sync::atomic::{AtomicU8, Ordering::{Acquire, Release}};
+
+const UNSET: u8 = 0;
+const SETTING_UP: u8 = 1;
+const READY: u8 = 2;
+
+/// # Invariants
+/// @state only goes UNSET -> SETTING_UP -> READY, or back to UNSET if setting
+/// up failed: @pool is set up only at READY, and while SETTING_UP is its one
+/// claimant's alone.
+#[repr(C)]
+pub struct Mempool {
+    pool:  Opaque<c::mempool_t>,
+    state: AtomicU8,
+}
+
+// SAFETY: a mempool is every thread's, behind its own lock - and set up by
+// one, as above
+unsafe impl Send for Mempool {}
+unsafe impl Sync for Mempool {}
+// SAFETY: zeroed is UNSET
+unsafe impl ::pin_init::Zeroable for Mempool {}
+
+impl Mempool {
+    pub fn initialized(&self) -> bool {
+        self.state.load(Acquire) == READY
+    }
+
+    /// Set up with @min_nr elements of @size bytes, if it isn't.
+    pub fn init_kvmalloc(&self, min_nr: usize, size: usize) -> Result<(), BchError> {
+        loop {
+            match self.state.compare_exchange(UNSET, SETTING_UP, Acquire, Acquire) {
+                Ok(_) => {
+                    // SAFETY: claimed; mempool_init() fails having freed what it made
+                    let ret = ret_to_result_void(unsafe {
+                        c::mempool_init_noprof(self.pool.as_ptr(), min_nr as c_int, Some(c::mempool_kvmalloc),
+                                               Some(c::mempool_kvfree), size as *mut c_void)
+                    });
+                    self.state.store(if ret.is_ok() { READY } else { UNSET }, Release);
+                    return ret;
+                }
+                Err(READY) => return Ok(()),
+                // another's setting it up
+                Err(_) => cond_resched(),
+            }
+        }
+    }
+
+    /// An element, freed to the pool on drop.
+    pub fn alloc(&self) -> PoolBuf<'_> {
+        PoolBuf { pool: self, p: self.alloc_raw() }
+    }
+
+    /// alloc(), for C to hold: free_raw() takes it back.
+    pub fn alloc_raw(&self) -> NonNull<u8> {
+        assert!(self.initialized(), "allocating from a mempool not set up");
+        // SAFETY: READY
+        NonNull::new(unsafe { c::mempool_alloc_noprof(self.pool.as_ptr(), c::GFP_KERNEL) }.cast())
+            .expect("mempool_alloc() waits for an element")
+    }
+
+    /// # Safety
+    /// @p is this pool's, not used after.
+    pub unsafe fn free_raw(&self, p: NonNull<u8>) {
+        // SAFETY: the caller's
+        unsafe { c::mempool_free(p.as_ptr().cast(), self.pool.as_ptr()) }
+    }
+}
+
+/// mempool_exit(): a no-op on a pool never set up.
+impl Drop for Mempool {
+    fn drop(&mut self) {
+        // SAFETY: &mut: no one's - nor being set up
+        unsafe { c::mempool_exit(self.pool.as_ptr()) }
+    }
+}
+
+/// An element of a pool, freed back to it when dropped: not zeroed.
+pub struct PoolBuf<'p> {
+    pool: &'p Mempool,
+    p:    NonNull<u8>,
+}
+
+impl PoolBuf<'_> {
+    pub fn as_ptr(&self) -> *mut u8 {
+        self.p.as_ptr()
+    }
+
+    /// Its bytes, as yet anything.
+    pub fn as_uninit_mut(&mut self) -> &mut [core::mem::MaybeUninit<u8>] {
+        // SAFETY: the element, ours - as many bytes as the pool's elements:
+        // its pool_data, as init_kvmalloc() gave mempool_kvmalloc() it
+        unsafe {
+            let size = (*self.pool.pool.as_ptr()).pool_data as usize;
+            core::slice::from_raw_parts_mut(self.p.as_ptr().cast(), size)
+        }
+    }
+}
+
+impl Drop for PoolBuf<'_> {
+    fn drop(&mut self) {
+        // SAFETY: alloc()'s, and ours alone
+        unsafe { self.pool.free_raw(self.p) }
+    }
+}
