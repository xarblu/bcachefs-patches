+
+use std::ffi::CString;
+
+use proc_macro2::{
+    Literal,
+    TokenStream, //
+};
+use quote::{
+    format_ident,
+    quote, //
+};
+use syn::{
+    braced,
+    bracketed,
+    ext::IdentExt,
+    parse::{
+        Parse,
+        ParseStream, //
+    },
+    parse_quote,
+    punctuated::Punctuated,
