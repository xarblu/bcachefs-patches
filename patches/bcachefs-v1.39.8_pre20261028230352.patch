+#[c_export]
+pub fn bch2_replicas_gc_reffed(c: &Opaque<c::bch_fs>) -> c_int {
+    ret_to_c(Fs::from_c(c).replicas_gc_reffed())
+}
+
+#[c_export]
+pub fn bch2_replicas_gc_accounted(c: &Opaque<c::bch_fs>) -> c_int {
+    ret_to_c(Fs::from_c(c).replicas_gc_accounted())
+}
