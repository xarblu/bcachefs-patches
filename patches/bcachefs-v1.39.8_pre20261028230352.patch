+#[test]
+fn union_in_generic_test() {
+    nest! {
+        struct Holder {
+            maybe: Option<union MaybeUnion {
+                x: u32,
+                y: f32,
+            }>,
+        }
+    }
+
+    let h = Holder { maybe: Some(MaybeUnion { y: 1.0 }) };
+    assert_eq!(unsafe { h.maybe.unwrap().x }, 1.0f32.to_bits());
+}
