+    fb.set_signed_two_bits(0);
+    assert_eq!(0, fb.0);
+    assert_eq!(0, fb.signed_two_bits());
+    assert_eq!(0, fb.signed_eight_bits());
+    assert_eq!(0, fb.signed_eight_bits_unaligned());
