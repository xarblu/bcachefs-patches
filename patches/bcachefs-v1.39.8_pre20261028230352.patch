+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+// The VFS's: kernel only, as C's #ifndef NO_BCACHEFS_FS
+#![cfg(not(NO_BCACHEFS_FS))]
+
+use crate::cstructs::c;
+use crate::types::c_default;
+use core::ffi::c_long;
+use cstruct_macros::{bitfield, CStruct};
+use nestify::nest;
+
+#[repr(C)]
+#[derive(CStruct)]
+pub struct dio_read {
+    pub cl: c::closure,
+    pub req: *mut c::kiocb,
+    pub ret: c_long,
+    pub should_dirty: bool,
+    /*
+     * The read's flags. rbio->flags is only set on the rbio the read path
+     * picks for an extent - a split, whenever the read bounces - so the
+     * dio's own rbio doesn't carry them, and the endio has nowhere else to
+     * look.
+     */
+    pub flags: c::bch_read_flags,
+    pub rbio: c::bch_read_bio,
+}
+c_default!(dio_read);
+
+nest! {
+    #[repr(C)]
+    #[derive(CStruct)]
+    pub struct dio_write {
+        pub req: *mut c::kiocb,
+        pub mapping: *mut c::address_space,
+        pub inode: *mut c::bch_inode_info,
+        pub mm: *mut c::mm_struct,
+        pub iov: *const c::iovec,
+        #[c_bitfield]
+        #>[bitfield(u8, ty = u32)]
+        pub bits: pub struct dio_write_bits {
+            loop_:     u1,
+            extending: u1,
+            sync:      u1,
+            sync_done: u1,
+            flush:     u1,
+            __pad:     u3,
+        },
+        pub quota_res: c::quota_res,
+        pub written: u64,
+
+        pub iter: c::iov_iter,
+        pub inline_vecs: [c::iovec; 2],
+
+        /* must be last: */
+        pub op: c::bch_write_op,
+    }
+}
diff --git a/fs/bcachefs/vfs/export.rs b/fs/bcachefs/vfs/export.rs
new file mode 100644
index 0000000..ec83c90
--- /dev/null
+++ b/fs/bcachefs/vfs/export.rs
@@ -0,0 +1,236 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! The export operations: what exportfs, for NFS, has a filesystem do to turn
+//! a file handle back into a dentry connected to the tree. They're a trait,
+//! ExportOps, declared by vfs_ops! (ops.rs) as the super ops are: Self what
+//! s_fs_info points to, Fs, and bch2_export_ops the table, s_export_op.
+//!
+//! A handle is a Fid - inode number, subvolume, generation - or, for a file
+//! that isn't a directory, encoded with its parent, a FidWithParent: packed,
+//! in the u32s exportfs hands over. Turned back, the inode is got from the
+//! inode cache or the btree, and a generation that doesn't match is a file
+//! since deleted and its number reused: ESTALE.
+//!
+//! get_name finds an inode's name in a directory. The inode's backpointer -
+//! bi_dir, bi_dir_offset - is the dirent that made it, so one look finds it,
+//! unless the backpointer is to another directory: a hardlink. Then the
+//! directory's dirents are searched for one that names the inode.
+
+use core::ffi::c_int;
+use core::mem::size_of;
+use core::ptr::{read_unaligned, write_unaligned};
+
+use crate::btree::bkey::{pos, spos};
+use crate::btree::iter::{lockrestart_do, BtreeIter, BtreeIterFlags};
+use crate::c;
+use crate::dirent::{self, Dirent};
+use crate::errcode::{bch_errcode, BchError};
+use crate::fs::Fs;
+use crate::inode;
+use crate::namei::subvol_inum_eq;
+use crate::snapshots::subvolume;
+use crate::util::os_str::OsStrExt;
+use cstruct_macros::{c_export, vtable};
+
+use super::dentry::Dentry;
+use super::inode::{InodeInfo, InodeRef};
+use super::super_block::SuperBlock;
+
+/// A name as get_name returns it: at most NAME_MAX bytes, and a NUL.
+pub(crate) type NameBuf = [u8; c::NAME_MAX as usize + 1];
+
+/// @d's name, as get_name returns it: cut at NAME_MAX.
+fn copy_name(out: &mut NameBuf, d: Dirent<'_>) {
+    let name = d.name().as_bytes();
+    let len = name.len().min(c::NAME_MAX as usize);
+    out[..len].copy_from_slice(&name[..len]);
+    out[len] = 0;
+}
+
+#[repr(C, packed)]
+#[derive(Clone, Copy)]
+struct Fid {
+    inum:       u64,
+    subvol:     u32,
+    generation: u32,
+}
+
+#[repr(C, packed)]
+#[derive(Clone, Copy)]
+struct FidWithParent {
+    fid: Fid,
+    dir: Fid,
+}
+
+/// @T's length in a handle: u32s.
+const fn fh_len<T>() -> usize {
+    size_of::<T>() / size_of::<u32>()
+}
+
+/// Handle @fid, if it's one of ours: of a type of ours, and that type's
+/// length.
+///
+/// # Safety
+/// @fid is exportfs's handle, @len u32s.
+unsafe fn our_handle<'a>(fid: *mut c::fid, len: c_int, fh_type: c_int) -> Option<&'a [u32]> {
+    let fh = unsafe { core::slice::from_raw_parts(fid.cast::<u32>(), len.max(0) as usize) };
+    let len = match fh_type as u32 {
+        c::fid_type_FILEID_BCACHEFS_WITHOUT_PARENT => fh_len::<Fid>(),
+        c::fid_type_FILEID_BCACHEFS_WITH_PARENT    => fh_len::<FidWithParent>(),
+        _ => return None,
+    };
+    (fh.len() == len).then_some(fh)
+}
+
+/// @v into @fh, as a handle of @fh_type: its type and length - or, if @fh is
+/// too short, the length it needs.
+fn encode<T>(fh: &mut [u32], v: T, fh_type: u32) -> Result<(c_int, usize), usize> {
+    let len = fh_len::<T>();
+    if fh.len() < len {
+        return Err(len);
+    }
+    // SAFETY: in bounds; packed, so u32-aligned will do
+    unsafe { write_unaligned(fh.as_mut_ptr().cast::<T>(), v) };
+    Ok((fh_type as c_int, len))
+}
+
+impl InodeInfo {
+    fn fid(&self) -> Fid {
+        let inum = self.inum();
+        Fid { inum: inum.inum, subvol: inum.subvol as u32, generation: self.ei_inode.bi_generation.get() }
+    }
+}
+
+impl Fs {
+    fn nfs_get_inode(&self, fid: Fid) -> Result<InodeRef, BchError> {
+        let inode = InodeInfo::get(self, c::subvol_inum { subvol: fid.subvol as u64, inum: fid.inum })?;
+        if inode.vfs().generation() != fid.generation {
+            return Err(c::ESTALE.into());
+        }
+        Ok(inode)
+    }
+}
+
+crate::vfs_ops! {
+    pub(crate) trait ExportOps for c::export_operations, ExportVTable<T: ExportOps> = T;
+
+    /// @name NAME_MAX + 1 bytes.
+    fn get_name(&self = child, parent: Dentry<'_>, name: &mut NameBuf, child: Dentry<'_>)
+        -> Result<(), BchError>;
+    /// As fh_to_dentry(), the directory @child is in's.
+    fn get_parent(&self = child, child: Dentry<'_>) -> *mut c::dentry;
+
+    unsafe {
+        /// @inode's handle - with @parent's, if given - into @fh, *@max_len
+        /// u32s: its type, and *@max_len its length - or FILEID_INVALID, and
+        /// the length it needs.
+        fn encode_fh(&self = inode, inode: &InodeInfo, fh: *mut u32, max_len: *mut c_int,
+                         parent: Option<&InodeInfo>) -> c_int;
+        /// The dentry handle @fid, @fh_len u32s, of @fh_type names: NULL for
+        /// one that isn't ours, an ERR_PTR, or d_obtain_alias()'s.
+        fn fh_to_dentry(&self = sb, sb: &SuperBlock, fid: *mut c::fid, fh_len: c_int,
+                            fh_type: c_int) -> *mut c::dentry;
+        /// As fh_to_dentry(), the handle's parent's.
+        fn fh_to_parent(&self = sb, sb: &SuperBlock, fid: *mut c::fid, fh_len: c_int,
+                            fh_type: c_int) -> *mut c::dentry;
+    }
+}
+
+#[vtable]
+impl ExportOps for Fs {
+    fn get_name(&self, parent: Dentry<'_>, name: &mut NameBuf, child: Dentry<'_>) -> Result<(), BchError> {
+        let dir = parent.inode();
+        if !dir.vfs().is_dir() {
+            return self.throw(bch_errcode::BCH_ERR_EINVAL_get_name_not_dir);
+        }
+
+        let (dir_inum, inum) = (dir.inum(), child.inode().inum());
+        let trans = crate::btree_trans!(self);
+        lockrestart_do(&trans, |t| {
+            let snapshot = subvolume::get_snapshot(t, dir_inum.subvol as u32)?;
+            let bi = inode::find_by_inum_trans(t, inum, crate::c_function_name!())?;
+
+            if bi.bi_dir == dir_inum.inum {
+                let mut iter = BtreeIter::new(t, c::btree_id::dirents, pos(bi.bi_dir, bi.bi_dir_offset),
+                                              BtreeIterFlags::empty());
+                iter.set_snapshot(snapshot);
+
+                let doesnt_match = || self.err(bch_errcode::BCH_ERR_ENOENT_dirent_doesnt_match_inode);
+                let d = iter.peek_slot(t)?.and_then(Dirent::new).ok_or_else(doesnt_match)?;
+                let target = dirent::read_target(t, dir_inum, d)?.ok_or_else(doesnt_match)?;
+                if subvol_inum_eq(target, inum) {
+                    copy_name(name, d);
+                    return Ok(());
+                }
+            } else {
+                let mut iter = BtreeIter::new(t, c::btree_id::dirents, pos(dir_inum.inum, 0),
+                                              BtreeIterFlags::empty());
+                iter.set_snapshot(snapshot);
+
+                let found = iter.find_max_norestart(t, spos(dir_inum.inum, u64::MAX, u32::MAX), |_, k| {
+                    let Some(d) = Dirent::new(k) else { return Ok(false) };
+                    Ok(dirent::read_target(t, dir_inum, d)?.is_some_and(|target| subvol_inum_eq(target, inum)))
+                })?;
+                if let Some(k) = found {
+                    copy_name(name, Dirent::new(k).expect("a dirent"));
+                    return Ok(());
+                }
+            }
+
+            Err(c::ENOENT.into())
+        })
+    }
+
+    /// The inode's backpointer: its directory, in the parent subvolume if
+    /// it's a subvolume's root.
+    fn get_parent(&self, child: Dentry<'_>) -> *mut c::dentry {
+        let inode = child.inode();
+        let parent_subvol = inode.ei_inode.bi_parent_subvol.get();
+        let parent = c::subvol_inum {
+            subvol: if parent_subvol != 0 { parent_subvol as u64 } else { inode.inum().subvol },
+            inum:   inode.ei_inode.bi_dir.get(),
+        };
+        Dentry::obtain_alias(InodeInfo::get(self, parent))
+    }
+
+    unsafe fn encode_fh(&self, inode: &InodeInfo, fh: *mut u32, max_len: *mut c_int,
+                        parent: Option<&InodeInfo>) -> c_int {
+        // SAFETY: the VFS's
+        let fh = unsafe { core::slice::from_raw_parts_mut(fh, (*max_len).max(0) as usize) };
+        let (fh_type, len) = match parent.filter(|_| !inode.vfs().is_dir()) {
+            Some(dir) => encode(fh, FidWithParent { fid: inode.fid(), dir: dir.fid() },
+                                c::fid_type_FILEID_BCACHEFS_WITH_PARENT),
+            None      => encode(fh, inode.fid(), c::fid_type_FILEID_BCACHEFS_WITHOUT_PARENT),
+        }.unwrap_or_else(|len| (c::fid_type_FILEID_INVALID as c_int, len));
+        unsafe { *max_len = len as c_int };
+        fh_type
+    }
+
+    unsafe fn fh_to_dentry(&self, _sb: &SuperBlock, fid: *mut c::fid, fh_len: c_int, fh_type: c_int)
+        -> *mut c::dentry
+    {
+        // SAFETY: the VFS's
+        let Some(fh) = (unsafe { our_handle(fid, fh_len, fh_type) }) else {
+            return core::ptr::null_mut();
+        };
+        // SAFETY: a Fid's length at least; packed
+        let fid = unsafe { read_unaligned(fh.as_ptr().cast::<Fid>()) };
+        Dentry::obtain_alias(self.nfs_get_inode(fid))
+    }
+
+    unsafe fn fh_to_parent(&self, _sb: &SuperBlock, fid: *mut c::fid, fh_len: c_int, fh_type: c_int)
+        -> *mut c::dentry
+    {
+        // SAFETY: the VFS's
+        let fh = unsafe { our_handle(fid, fh_len, fh_type) };
+        let Some(fh) = fh.filter(|_| fh_type as u32 == c::fid_type_FILEID_BCACHEFS_WITH_PARENT) else {
+            return core::ptr::null_mut();
+        };
+        // SAFETY: a FidWithParent's length; packed
+        let fid = unsafe { read_unaligned(fh.as_ptr().cast::<FidWithParent>()) };
+        Dentry::obtain_alias(self.nfs_get_inode(fid.dir))
+    }
+}
+
+#[c_export]
+pub static bch2_export_ops: c::export_operations = ExportVTable::<Fs>::OPS;
diff --git a/fs/bcachefs/vfs/fdm.h b/fs/bcachefs/vfs/fdm.h
new file mode 100644
index 0000000..d8a104d
--- /dev/null
+++ b/fs/bcachefs/vfs/fdm.h
@@ -0,0 +1,131 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_FS_FDM_H
+#define _BCACHEFS_FS_FDM_H
+
+/*
+ * Faults-disabled-mapping hash table
+ *
+ * Replaces the per-task faults_disabled_mapping field (removed in 7.0)
+ * with a fixed-size cuckoo hash in bch_fs. Used to prevent deadlock
+ * when the page fault handler is invoked for a mapping that is already
+ * being written to by the current task (DIO path).
+ *
+ * Properties:
+ *  - O(1) lookup: exactly three slots to check (3-way cuckoo)
+ *  - No locks: each task only writes/removes its own entry
+ *  - No resize: table is oversized at init, occupancy stays very low
+ *  - Low bit of mapping pointer stolen for dropped_locks signaling
+ *  - Closure waitlist fallback if all slots full (just a read when empty)
+ *
+ * Hash function approach borrowed from buckets_waiting_for_journal:
+ * random seeds with hash_64() give truly independent distributions.
+ * With 3 hash functions and 512 slots at ~16 concurrent tasks,
+ * probability of all 3 slots occupied is ~(16/512)^3 ≈ 0.003%.
+ */
+
+#include <linux/hash.h>
+#include <linux/random.h>
+
+#include "vendor/closure.h"
+
+#include "vfs/fdm_gen.h"
+
+static inline unsigned fdm_hash(struct fdm_hash *ht, int idx,
+				const struct task_struct *task)
+{
+	return hash_64((unsigned long)task ^ ht->hash_seeds[idx], FDM_HASH_BITS);
+}
+
+static inline bool __fdm_has_slot(struct fdm_hash *ht)
+{
+	for (unsigned i = 0; i < FDM_NR_HASH; i++)
+		if (!READ_ONCE(ht->slots[fdm_hash(ht, i, current)].task))
+			return true;
+	return false;
+}
+
+static inline struct address_space *fdm_get(struct fdm_hash *ht)
+{
+	for (unsigned i = 0; i < FDM_NR_HASH; i++) {
+		unsigned h = fdm_hash(ht, i, current);
+		if (READ_ONCE(ht->slots[h].task) == current) {
+			smp_rmb(); /* pair with smp_wmb() in fdm_set */
+			return (void *)(READ_ONCE(ht->slots[h].mapping) & ~1UL);
+		}
+	}
+	return NULL;
+}
+
+static inline bool fdm_dropped_locks(struct fdm_hash *ht)
+{
+	for (unsigned i = 0; i < FDM_NR_HASH; i++) {
+		unsigned h = fdm_hash(ht, i, current);
+		if (READ_ONCE(ht->slots[h].task) == current) {
+			smp_rmb();
+			return READ_ONCE(ht->slots[h].mapping) & 1;
+		}
+	}
+	return false;
+}
+
+static inline void fdm_set_dropped_locks(struct fdm_hash *ht)
+{
+	for (unsigned i = 0; i < FDM_NR_HASH; i++) {
+		unsigned h = fdm_hash(ht, i, current);
+		if (READ_ONCE(ht->slots[h].task) == current) {
+			ht->slots[h].mapping |= 1;
+			return;
+		}
+	}
+}
+
+/*
+ * Insert current task's mapping. Only current ever inserts for itself,
+ * so no lock needed. With 3-way hashing at ~3% occupancy, all three
+ * slots being occupied is vanishingly rare (~0.003%). If it does
+ * happen, sleep on the closure waitlist until a slot frees up.
+ */
+static inline void fdm_set(struct fdm_hash *ht, struct address_space *mapping)
+{
+	for (unsigned i = 0; i < FDM_NR_HASH; i++)
+		EBUG_ON(READ_ONCE(ht->slots[fdm_hash(ht, i, current)].task) == current);
+
+	closure_wait_event(&ht->wait, __fdm_has_slot(ht));
+
+	for (unsigned i = 0; i < FDM_NR_HASH; i++) {
+		unsigned h = fdm_hash(ht, i, current);
+		if (!READ_ONCE(ht->slots[h].task)) {
+			WRITE_ONCE(ht->slots[h].mapping, (unsigned long)mapping);
+			/* mapping must be visible before task (task acts as "valid" marker) */
+			smp_wmb();
+			WRITE_ONCE(ht->slots[h].task, current);
+			return;
+		}
+	}
+
+	/* Lost race after wakeup — retry */
+	fdm_set(ht, mapping);
+}
+
+static inline void fdm_clear(struct fdm_hash *ht)
+{
+	for (unsigned i = 0; i < FDM_NR_HASH; i++) {
+		unsigned h = fdm_hash(ht, i, current);
+		if (READ_ONCE(ht->slots[h].task) == current) {
+			WRITE_ONCE(ht->slots[h].task, NULL);
+			/* Ensure task is cleared before mapping could be reused */
+			smp_wmb();
+			closure_wake_up(&ht->wait);
+			return;
+		}
+	}
+}
+
+static inline void fdm_init(struct fdm_hash *ht)
+{
+	memset(ht, 0, sizeof(*ht));
+	for (unsigned i = 0; i < FDM_NR_HASH; i++)
+		ht->hash_seeds[i] = get_random_u64();
+}
+
+#endif /* _BCACHEFS_FS_FDM_H */
diff --git a/fs/bcachefs/vfs/fdm_types.rs b/fs/bcachefs/vfs/fdm_types.rs
new file mode 100644
index 0000000..21b1223
--- /dev/null
+++ b/fs/bcachefs/vfs/fdm_types.rs
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::types::c_default;
+use core::ffi::c_ulong;
+use cstruct_macros::{c_const, CStruct};
+
+c_const! {
+    #[c_int]
+    pub const FDM_NR_HASH: u32 = 3;
+
+    #[c_int]
+    pub const FDM_HASH_BITS: u32 = 9;
+
+    #[c_int]
+    pub const FDM_HASH_SIZE: u32 = 1 << c::FDM_HASH_BITS;
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, CStruct)]
+pub struct fdm_slot {
+    pub task: *mut c::task_struct,
+    pub mapping: c_ulong, /* address_space * | dropped_locks bit */
+}
+c_default!(fdm_slot);
+
+#[repr(C)]
+#[derive(CStruct)]
+pub struct fdm_hash {
+    pub hash_seeds: [u64; c::FDM_NR_HASH as usize],
+    pub wait: c::closure_waitlist,
+    pub slots: [c::fdm_slot; c::FDM_HASH_SIZE as usize],
+}
+c_default!(fdm_hash);
diff --git a/fs/bcachefs/vfs/fiemap.rs b/fs/bcachefs/vfs/fiemap.rs
new file mode 100644
index 0000000..2cc3ae6
--- /dev/null
+++ b/fs/bcachefs/vfs/fiemap.rs
@@ -0,0 +1,237 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! FIEMAP: a file's mappings, from @start to @end, in sectors.
+//!
+//! A mapping is an extent from the btree, or dirty data in the pagecache over
+//! a hole in it, reported as delalloc. A reflink_p is reported as the part of
+//! the indirect extent it points to, at the file's offsets. Each mapping is
+//! emitted once the next is known, so the last can carry FIEMAP_EXTENT_LAST.
+//!
+//! Where both have something, the btree's extent wins if it starts first. It
+//! should be the pagecache's - we're COW, so dirty data is delalloc - but
+//! bch_folio_state has no per-sector writeback tracking, and clean cached data
+//! would be reported delalloc too. Even then fiemap couldn't report stable
+//! mappings: copygc and rebalance move data, and nothing lets userspace lock
+//! that out.
+//!
+//! Folio locks can't be taken holding btree locks. The pagecache is scanned
+//! nonblocking first, then with the locks dropped. That races with writeback
+//! inserting extents, but so does any fiemap without FIEMAP_FLAG_SYNC: the
+//! range is reported delalloc either way. The transaction is unlocked before
+//! each mapping is emitted, since the copy to userspace may fault.
+//!
+//! C faked a delalloc extent key, with one zeroed pointer, so it could emit
+//! dirty data the same way as an extent. Here it's a variant of Mapping
+//! instead.
+
+use core::ops::Range;
+
+use crate::btree::bkey::prelude::*;
+use crate::btree::bkey::{pos, spos, BkeySC};
+use crate::btree::bkey_buf::BkeyBuf;
+use crate::btree::iter::{lockrestart_do, BtreeIter, BtreeIterFlags, TransAttempt};
+use crate::c;
+use crate::data::extents::{BkeyVExtents, Extents};
+use crate::data::ptrs::{BkeyVPtrs, PtrsMut};
+use crate::data::reflink::lookup_indirect_extent;
+use crate::errcode::{bch_errcode, ret_to_result, ret_to_result_void, BchError};
+use crate::fs::Fs;
+use crate::snapshots::subvolume;
+use cstruct_macros::c_extern;
+
+use super::inode::InodeInfo;
+
+c_extern! {
+    // pagecache.c's, until it's Rust:
+    fn bch2_seek_pagecache_data(vinode: *mut c::inode, start: c::loff_t, end: c::loff_t,
+                                state: core::ffi::c_uint, nonblock: bool) -> c::loff_t;
+    fn bch2_seek_pagecache_hole(vinode: *mut c::inode, start: c::loff_t, end: c::loff_t,
+                                state: core::ffi::c_uint, nonblock: bool) -> c::loff_t;
+}
+
+enum Mapping {
+    Extent(BkeyBuf),
+    Delalloc(Range<u64>),
+}
+
+impl Mapping {
+    fn sectors(&self) -> Range<u64> {
+        match self {
+            Mapping::Extent(k) => k.as_ref().k.start_offset()..k.as_ref().k.p.offset,
+            Mapping::Delalloc(r) => r.clone(),
+        }
+    }
+
+    /// True if @info is full, which ends the walk.
+    fn emit(&self, fs: &Fs, info: &mut c::fiemap_extent_info, flags: u32) -> Result<bool, BchError> {
+        use c::bch_bkey_type as t;
+
+        let mut fill = |logical: u64, physical: u64, len: u64, flags: u32| {
+            ret_to_result(unsafe { c::fiemap_fill_next_extent(info, logical << 9, physical << 9,
+                                                             len << 9, flags) })
+                .map(|full| full != 0)
+        };
+        let block_sectors = fs.block_bytes() >> 9;
+        let unaligned = |sectors: u64| sectors & (block_sectors - 1) != 0;
+
+        let k = match self {
+            Mapping::Extent(k) => BkeySC::from(k),
+            Mapping::Delalloc(r) => {
+                let len = r.end - r.start;
+                let flags = flags | c::FIEMAP_EXTENT_DELALLOC |
+                    if unaligned(len) { c::FIEMAP_EXTENT_NOT_ALIGNED } else { 0 };
+                return fill(r.start, 0, len, flags);
+            }
+        };
+        let (start, len) = (k.k.start_offset(), k.k.size as u64);
+        assert!(len != 0, "fiemap: an empty mapping: {}", k.k);
+
+        if let Some(p) = k.arm::<PtrsMut>() {
+            let flags = flags |
+                if k.k.is::<c::ReflinkV>() { c::FIEMAP_EXTENT_SHARED } else { 0 };
+
+            for d in p.ptrs_decoded(fs) {
+                let mut flags = flags;
+                let mut offset = d.p.ptr.offset();
+
+                if d.p.ptr.unwritten() != 0 {
+                    flags |= c::FIEMAP_EXTENT_UNWRITTEN;
+                }
+                if d.p.crc.compression_type != 0 {
+                    flags |= c::FIEMAP_EXTENT_ENCODED;
+                } else {
+                    offset += u64::from(d.p.crc.offset);
+                }
+                if unaligned(offset) || unaligned(len) {
+                    flags |= c::FIEMAP_EXTENT_NOT_ALIGNED;
+                }
+
+                if fill(start, offset, len, flags)? {
+                    return Ok(true);
+                }
+            }
+            return Ok(false);
+        }
+
+        match k.k.key_type() {
+            t::KEY_TYPE_inline_data | t::KEY_TYPE_indirect_inline_data =>
+                fill(start, 0, len, flags | c::FIEMAP_EXTENT_DATA_INLINE),
+            t::KEY_TYPE_reservation =>
+                fill(start, 0, len, flags | c::FIEMAP_EXTENT_DELALLOC | c::FIEMAP_EXTENT_UNWRITTEN),
+            t::KEY_TYPE_error => Ok(false),
+            _ => {
+                crate::warn_once!(true, fs, "fiemap: unhandled key type: {}", k.k);
+                Ok(false)
+            }
+        }
+    }
+}
+
+/// The first run of dirty data in the pagecache in [@start, @end), in
+/// sectors, or an empty range at @end if there's none.
+fn pagecache_dirty(t: &TransAttempt<'_, '_>, inode: &InodeInfo, start: u64, end: u64)
+    -> Result<Range<u64>, BchError>
+{
+    let vinode = inode.vfs().as_ptr();
+    let (start, end) = ((start << 9) as c::loff_t, (end << 9) as c::loff_t);
+    let loff = |r: c::loff_t| if r < 0 { Err(BchError::from_raw(-r as i32)) } else { Ok(r) };
+
+    let scan = |nonblock| {
+        // SAFETY: an inode the VFS holds
+        let data = loff(unsafe { bch2_seek_pagecache_data(vinode, start, end, 0, nonblock) })?;
+        if data == end {
+            return Ok(end as u64 >> 9..end as u64 >> 9);
+        }
+        let hole = loff(unsafe { bch2_seek_pagecache_hole(vinode, data, end, 0, nonblock) })?;
+        assert!(data != hole, "fiemap: pagecache data at {data} with a hole at the same offset");
+        Ok(data as u64 >> 9..hole as u64 >> 9)
+    };
+
+    match scan(true) {
+        Err(e) if e == BchError::from(c::EAGAIN) => t.drop_locks_do(|| scan(false)),
+        r => r,
+    }
+}
+
+fn next_mapping(t: &TransAttempt<'_, '_>, inode: &InodeInfo, start: u64, end: u64)
+    -> Result<Mapping, BchError>
+{
+    let fs = t.fs();
+    let inum = inode.inum();
+    let snapshot = subvolume::get_snapshot(t, inum.subvol as u32)?;
+
+    let mut iter = BtreeIter::new(t, c::btree_id::extents, spos(inum.inum, start, snapshot),
+                                  BtreeIterFlags::TRIM);
+    let k = iter.peek_max(t, pos(inum.inum, end))?;
+
+    // Before the btree's extent, if there is one: so it's never cut
+    let dirty = pagecache_dirty(t, inode, start, k.map_or(end, |k| k.k.start_offset()))?;
+
+    let k = match k {
+        Some(k) if k.k.start_offset() <= dirty.start => k,
+        _ => return Ok(Mapping::Delalloc(dirty)),
+    };
+    let Some(p) = k.arm::<c::ReflinkP>() else {
+        return Ok(Mapping::Extent(BkeyBuf::from_key(k)));
+    };
+
+    let (start, sectors) = (k.k.start_offset(), k.k.size);
+    let mut offset_into_extent = 0;
+    let mut indirect_iter = BtreeIter::uninit();
+    let indirect = lookup_indirect_extent(t, &mut indirect_iter, &mut offset_into_extent, p, true,
+                                          BtreeIterFlags::empty())?;
+    if indirect.k.is_deleted() {
+        return fs.throw(bch_errcode::BCH_ERR_missing_indirect_extent);
+    }
+
+    let mut buf = BkeyBuf::from_key(indirect);
+    let k = buf.as_mut();
+    let offset_into_extent = offset_into_extent as u64;
+    let sectors = sectors.min(k.k.size - offset_into_extent as u32);
+
+    let cut = pos(k.k.p.inode, k.k.start_offset() + offset_into_extent);
+    k.arm::<Extents>().expect("an indirect extent is an extent").cut_front_in_place(fs, cut);
+    k.k.resize(sectors);
+    k.k.p = spos(inum.inum, start + sectors as u64, snapshot);
+    Ok(Mapping::Extent(buf))
+}
+
+pub(crate) fn fiemap(inode: &InodeInfo, info: &mut c::fiemap_extent_info, start: u64, mut len: u64)
+    -> Result<(), BchError>
+{
+    let fs = inode.fs();
+    ret_to_result_void(unsafe { c::fiemap_prep(inode.vfs().as_ptr(), info, start, &mut len, 0) })?;
+
+    let Some(end) = start.checked_add(len) else {
+        return fs.throw(bch_errcode::BCH_ERR_EINVAL_fiemap_overflow);
+    };
+    let (mut start, end) = (start >> 9, end >> 9);
+
+    let trans = crate::btree_trans!(fs);
+    let mut prev: Option<Mapping> = None;
+
+    while start < end {
+        let cur = lockrestart_do(&trans, |t| next_mapping(t, inode, start, end))?;
+        let s = cur.sectors();
+        assert!(start <= s.start && s.end <= end,
+                "fiemap: mapping {s:?} outside the window {start}..{end}");
+
+        if s.start == end {
+            break;
+        }
+        start = s.end;
+
+        if let Some(prev) = prev.replace(cur) {
+            trans.unlock();
+            if prev.emit(fs, info, 0)? {
+                return Ok(());
+            }
+        }
+    }
+
+    if let Some(prev) = prev {
+        trans.unlock();
+        prev.emit(fs, info, c::FIEMAP_EXTENT_LAST)?;
+    }
+    Ok(())
+}
diff --git a/fs/bcachefs/vfs/file.rs b/fs/bcachefs/vfs/file.rs
new file mode 100644
index 0000000..4de4f63
--- /dev/null
+++ b/fs/bcachefs/vfs/file.rs
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A regular file as an open file: its file_operations, bch2_file_ops, and
+//! the ops of its mappings.
+//!
+//! A regular file has no private data: its state is its inode's, so its ops
+//! are InodeInfo's, &self the file's inode - FileVTable over InodeFile,
+//! whose ops_of() is f_inode. Open checks and release flushes, making and
+//! dropping nothing. The data path's ops - read and write, llseek, fsync,
+//! fallocate, remap_file_range, a mapping's faults - are C's still, or the
+//! kernel's generics, set in the tables as they are.
+//!
+//! A shared writable mapping of a filesystem gone emergency read-only is
+//! refused: its first write fault couldn't get a disk reservation, and
+//! page_mkwrite would SIGBUS. EIO, as ext4 and f2fs return from a shut-down
+//! filesystem. A read-only mapping of a file open for writing - xfs_io's
+//! default - never faults for write, and still maps: generic/743 maps one
+//! while its error injection takes the filesystem down. mprotect() making a
+//! mapping writable later still SIGBUSes, as it always did.
+
+/* DOC(replace-in-place)
+ *
+ * Applications commonly replace a file's contents in one of two ways, often
+ * without fsync. POSIX promises nothing for either, but both get special
+ * handling, as they do on ext4, XFS and btrfs - in one case more strongly.
+ *
+ * **Write a temporary file, then rename it over the original.** When a
+ * rename overwrites an existing file, bcachefs first completes writeback of
+ * the source file's data, so the data's extents are journalled before the
+ * rename is. Combined with prefix consistency this makes the replacement
+ * atomic and complete without any fsync: after a crash, either the old file
+ * is intact, or the rename happened and all of the new file's data is
+ * present; the empty-or-truncated-file outcome cannot occur. This orders the
+ * rename behind the data but does not make the rename itself durable (no
+ * journal flush is issued); an application that must know the replacement has
+ * happened still needs fsync. Plain renames that don't overwrite anything get
+ * no implicit writeback.
+ *
+ * This is stronger than the other filesystems: ext4 (`auto_da_alloc`) and
+ * btrfs only start writeback of the source on an overwriting rename without
+ * waiting for it, so a crash shortly afterwards can still recover an empty
+ * file, and XFS does nothing here. The cost is that each overwriting rename
+ * waits for its source's data to be written, which shows up in workloads that
+ * replace many files this way, such as package managers.
+ *
+ * **Truncate and rewrite** (`O_TRUNC`). Some applications replace a file by
+ * opening it with `O_TRUNC`, writing the new contents and closing it, without
+ * fsync. The truncate is journalled within `journal_flush_delay` (default one
+ * second), but the new data can stay in the page cache for the dirty writeback
+ * delay (default thirty seconds). A crash in between recovers an empty file:
+ * both the old and the new contents are lost.
+ *
+ * As a workaround, as on ext4, XFS and btrfs, truncating a nonempty file to
+ * zero length makes the next close start writeback of the file's data.
+ *
+ * This is an implicit fsync on close, minus waiting for the writeback and
+ * minus the journal commit, and it does not make the pattern safe. The file is
+ * empty on disk from the moment the truncate is journalled until the new data
+ * is written back, and a crash anywhere in that interval still loses both
+ * versions; no flush can prevent that, it can only shorten the interval.
+ *
+ * Applications that do this and need the old or the new contents to survive a
+ * crash are buggy, on every filesystem, and need to be fixed. The correct way
+ * to replace a file is to write the new contents to a new file - a temporary
+ * file, or an `O_TMPFILE` given a name with `linkat` - and rename it over the
+ * old one, fsyncing the new file first if the new contents must be durable.
+ */
+
+use core::ffi::{c_int, c_uint};
+use kernel::ffi::{c_long, c_ulong};
+
+use crate::c;
+use crate::errcode::{bch_errcode, ret_to_class, ret_to_result_void, BchError};
+use crate::fs::Fs;
+use crate::snapshots::subvolume;
+use crate::types::CStatic;
+use crate::util::file::{File, FileData, FileOps, FileVTable};
+use cstruct_macros::{c_export, c_extern, vtable};
+
+use super::inode::InodeInfo;
+use super::ioctl::fs_file_ioctl;
+
+c_extern! {
+    // The data path's, C's still:
+    fn bch2_llseek(file: *mut c::file, offset: c::loff_t, whence: c_int) -> c::loff_t;
+    fn bch2_read_iter(iocb: *mut c::kiocb, iter: *mut c::iov_iter) -> isize;
+    fn bch2_write_iter(iocb: *mut c::kiocb, iter: *mut c::iov_iter) -> isize;
+    pub(super) fn bch2_fsync(file: *mut c::file, start: c::loff_t, end: c::loff_t, datasync: c_int) -> c_int;
+    fn bch2_fallocate_dispatch(file: *mut c::file, mode: c_int, offset: c::loff_t, len: c::loff_t) -> c_long;
+    fn bch2_remap_file_range(file_src: *mut c::file, pos_src: c::loff_t, file_dst: *mut c::file,
+                             pos_dst: c::loff_t, len: c::loff_t, remap_flags: c_uint) -> c::loff_t;
+    fn bch2_page_fault(vmf: *mut c::vm_fault) -> c::vm_fault_t;
+    fn bch2_page_mkwrite(vmf: *mut c::vm_fault) -> c::vm_fault_t;
+}
+
+// SAFETY, of the CStatic: immutable, its only parts that aren't Sync pointers
+static VM_OPS: CStatic<c::vm_operations_struct> = unsafe {
+    CStatic::new(c::vm_operations_struct {
+        fault:        Some(bch2_page_fault),
+        map_pages:    Some(c::filemap_map_pages),
+        page_mkwrite: Some(bch2_page_mkwrite),
+        // SAFETY: zero is NULL, an op not implemented
+        ..core::mem::zeroed()
+    })
+};
+
+/// A regular file's state: its inode's. Never made: there's nothing to make.
+/// FileVTable::<InodeInfo> would take the inode for private data - the
+/// blanket FileData of an ops type - and drop it at release: this is the one.
+pub(crate) enum InodeFile {}
+
+impl FileData for InodeFile {
+    type Ops = InodeInfo;
+
+    fn ops(&self) -> &InodeInfo {
+        match *self {}
+    }
+
+    unsafe fn ops_of<'a>(file: *mut c::file) -> &'a InodeInfo {
+        // SAFETY: an open file of ours: its inode's referenced while it's open
+        unsafe { InodeInfo::from_inode((*file).f_inode) }
+    }
+
+    /// Writeback started, if a truncate to zero asked for it: see
+    /// DOC(replace-in-place).
+    unsafe fn release(file: *mut c::file) {
+        // SAFETY: as ops_of()'s
+        let inode = unsafe { Self::ops_of(file) };
+        if inode.take_flag(c::bch_inode_info_flags::EI_INODE_FLUSH_ON_CLOSE) {
+            unsafe { c::rust_filemap_flush((*inode.vfs().as_ptr()).i_mapping) };
+        }
+    }
+}
+
+/// A shared writable mapping is refused once the filesystem's gone emergency
+/// read-only: @flags the mapping's VM_*.
+fn mmap_check(fs: &Fs, flags: c_ulong) -> Result<(), BchError> {
+    let shared_writable = c::VM_SHARED | c::VM_WRITE;
+    if flags & shared_writable == shared_writable && fs.flag(c::bch_fs_flags::BCH_FS_emergency_ro) {
+        return fs.throw(bch_errcode::BCH_ERR_mmap_emergency_ro);
+    }
+    Ok(())
+}
+
+#[vtable]
+impl FileOps for InodeInfo {
+    // #[vtable] sees mmap() and mmap_prepare() whichever one is built
+    #[cfg(linux_ge = "6.17")]
+    const HAS_MMAP_PREPARE: bool = true;
+    #[cfg(not(linux_ge = "6.17"))]
+    const HAS_MMAP: bool = true;
+
+    #[cfg(linux_ge = "6.17")]
+    fn mmap_prepare(desc: &mut c::vm_area_desc) -> Result<(), BchError> {
+        #[cfg(linux_ge = "7.0")]
+        let flags = desc.vma_flags.__vma_flags[0];
+        #[cfg(not(linux_ge = "7.0"))]
+        let flags = desc.vm_flags;
+        // SAFETY: the file being mapped: one of ours, open
+        mmap_check(unsafe { <InodeFile as FileData>::ops_of(desc.file) }.fs(), flags)?;
+        unsafe { c::file_accessed(desc.file) };
+        desc.vm_ops = &*VM_OPS;
+        Ok(())
+    }
+
+    #[cfg(not(linux_ge = "6.17"))]
+    fn mmap(&self, file: &File, vma: &mut c::vm_area_struct) -> Result<(), BchError> {
+        // SAFETY: vm_flags and __vm_flags are the one word
+        mmap_check(self.fs(), unsafe { vma.__bindgen_anon_2.vm_flags })?;
+        unsafe { c::file_accessed(file.as_ptr()) };
+        vma.vm_ops = &*VM_OPS;
+        Ok(())
+    }
+
+    fn unlocked_ioctl(&self, file: &File, cmd: c_uint, arg: c_ulong) -> c_long {
+        fs_file_ioctl(file, cmd, arg)
+    }
+
+    #[cfg(CONFIG_COMPAT)]
+    fn compat_ioctl(&self, file: &File, cmd: c_uint, arg: c_ulong) -> c_long {
+        super::ioctl::fs_file_compat_ioctl(file, cmd, arg)
+    }
+}
+
+/// Opened for writing, the subvolume must be writable. FileOps' open() makes
+/// private data, and there's none: this is the table's own.
+unsafe extern "C" fn open(vinode: *mut c::inode, file: *mut c::file) -> c_int {
+    // SAFETY: a file of ours being opened, and its inode
+    let (inode, f) = unsafe { (InodeInfo::from_inode(vinode), File::from_raw(file)) };
+    ret_to_class((|| {
+        if f.flags() & (c::O_WRONLY | c::O_RDWR) != 0 {
+            subvolume::is_ro(inode.fs(), inode.inum().subvol as u32)?;
+        }
+        // SAFETY: not yet the file of anyone but the opener
+        unsafe { (*file).f_mode |= c::FMODE_CAN_ODIRECT };
+        ret_to_result_void(unsafe { c::generic_file_open(vinode, file) })
+    })())
+}
+
+/// i_fop, as bch2_vfs_inode_init() sets it for a regular file.
+#[c_export]
+pub static bch2_file_ops: c::file_operations = {
+    let mut ops = FileVTable::<InodeFile>::OPS;
+    // No module reference taken by each open, as FileVTable has it: the
+    // mount holds one, and an open of a regular file is hot
+    ops.owner            = core::ptr::null_mut();
+    ops.open             = Some(open);
+    ops.llseek           = Some(bch2_llseek);
+    ops.read_iter        = Some(bch2_read_iter);
+    ops.write_iter       = Some(bch2_write_iter);
+    #[cfg(CONFIG_TRANSPARENT_HUGEPAGE)]
+    {
+        ops.get_unmapped_area = Some(c::thp_get_unmapped_area);
+    }
+    ops.fsync            = Some(bch2_fsync);
+    ops.splice_read      = Some(c::filemap_splice_read);
+    ops.splice_write     = Some(c::iter_file_splice_write);
+    ops.fallocate        = Some(bch2_fallocate_dispatch);
+    ops.remap_file_range = Some(bch2_remap_file_range);
+    ops
+};
