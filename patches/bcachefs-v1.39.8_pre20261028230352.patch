index 0000000..b3527c8
--- /dev/null
+++ b/fs/bcachefs/util/eytzinger.h
@@ -0,0 +1,335 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _EYTZINGER_H
+#define _EYTZINGER_H
+
+#include <linux/bitops.h>
+#include <linux/log2.h>
+
+#ifdef EYTZINGER_DEBUG
+#include <linux/bug.h>
+#define EYTZINGER_BUG_ON(cond)		BUG_ON(cond)
+#else
+#define EYTZINGER_BUG_ON(cond)
+#endif
+
+/*
+ * Traversal for trees in eytzinger layout - a full binary tree layed out in an
+ * array.
+ *
+ * Consider using an eytzinger tree any time you would otherwise be doing binary
+ * search over an array. Binary search is a worst case scenario for branch
+ * prediction and prefetching, but in an eytzinger tree every node's children
+ * are adjacent in memory, thus we can prefetch children before knowing the
+ * result of the comparison, assuming multiple nodes fit on a cacheline.
+ *
+ * Two variants are provided, for one based indexing and zero based indexing.
+ *
+ * Zero based indexing is more convenient, but one based indexing has better
+ * alignment and thus better performance because each new level of the tree
+ * starts at a power of two, and thus if element 0 was cacheline aligned, each
+ * new level will be as well.
+ */
+
+static inline unsigned eytzinger1_child(unsigned i, unsigned child)
+{
+	EYTZINGER_BUG_ON(child > 1);
+
+	return (i << 1) + child;
+}
+
+static inline unsigned eytzinger1_left_child(unsigned i)
+{
+	return eytzinger1_child(i, 0);
+}
+
+static inline unsigned eytzinger1_right_child(unsigned i)
+{
+	return eytzinger1_child(i, 1);
+}
+
+static inline unsigned eytzinger1_first(unsigned size)
+{
+	return size ? rounddown_pow_of_two(size) : 0;
+}
+
+static inline unsigned eytzinger1_last(unsigned size)
+{
+	return rounddown_pow_of_two(size + 1) - 1;
+}
+
+static inline unsigned eytzinger1_next(unsigned i, unsigned size)
+{
+	EYTZINGER_BUG_ON(i == 0 || i > size);
+
+	if (eytzinger1_right_child(i) <= size) {
+		i = eytzinger1_right_child(i);
+
+		i <<= __fls(size) - __fls(i);
+		i >>= i > size;
+	} else {
+		i >>= ffz(i) + 1;
+	}
+
+	return i;
+}
+
+static inline unsigned eytzinger1_prev(unsigned i, unsigned size)
+{
+	EYTZINGER_BUG_ON(i == 0 || i > size);
+
+	if (eytzinger1_left_child(i) <= size) {
+		i = eytzinger1_left_child(i) + 1;
+
+		i <<= __fls(size) - __fls(i);
+		i -= 1;
+		i >>= i > size;
+	} else {
+		i >>= __ffs(i) + 1;
+	}
+
+	return i;
+}
+
+static inline unsigned eytzinger1_extra(unsigned size)
+{
+	return size
+		? (size + 1 - rounddown_pow_of_two(size)) << 1
+		: 0;
+}
+
+static inline unsigned __eytzinger1_to_inorder(unsigned i, unsigned size,
+					      unsigned extra)
+{
+	unsigned b = __fls(i);
+	unsigned shift = __fls(size) - b;
+	int s;
+
+	EYTZINGER_BUG_ON(!i || i > size);
+
+	i  ^= 1U << b;
+	i <<= 1;
+	i  |= 1;
+	i <<= shift;
+
+	/*
+	 * sign bit trick:
+	 *
+	 * if (i > extra)
+	 *	i -= (i - extra) >> 1;
+	 */
+	s = extra - i;
+	i += (s >> 1) & (s >> 31);
+
+	return i;
+}
+
+static inline unsigned __inorder_to_eytzinger1(unsigned i, unsigned size,
+					       unsigned extra)
+{
+	unsigned shift;
+	int s;
+
+	EYTZINGER_BUG_ON(!i || i > size);
+
+	/*
+	 * sign bit trick:
+	 *
+	 * if (i > extra)
+	 *	i += i - extra;
+	 */
+	s = extra - i;
+	i -= s & (s >> 31);
+
+	shift = __ffs(i);
+
+	i >>= shift + 1;
+	i  |= 1U << (__fls(size) - shift);
+
+	return i;
+}
+
+static inline unsigned eytzinger1_to_inorder(unsigned i, unsigned size)
+{
+	return __eytzinger1_to_inorder(i, size, eytzinger1_extra(size));
+}
+
+static inline unsigned inorder_to_eytzinger1(unsigned i, unsigned size)
+{
+	return __inorder_to_eytzinger1(i, size, eytzinger1_extra(size));
+}
+
+#define eytzinger1_for_each(_i, _size)			\
+	for (unsigned (_i) = eytzinger1_first((_size));	\
+	     (_i) != 0;					\
+	     (_i) = eytzinger1_next((_i), (_size)))
+
+/* Zero based indexing version: */
+
+static inline unsigned eytzinger0_child(unsigned i, unsigned child)
+{
+	EYTZINGER_BUG_ON(child > 1);
+
+	return (i << 1) + 1 + child;
+}
+
+static inline unsigned eytzinger0_left_child(unsigned i)
+{
+	return eytzinger0_child(i, 0);
+}
+
+static inline unsigned eytzinger0_right_child(unsigned i)
+{
+	return eytzinger0_child(i, 1);
+}
+
+static inline unsigned eytzinger0_first(unsigned size)
+{
+	return eytzinger1_first(size) - 1;
+}
+
+static inline unsigned eytzinger0_last(unsigned size)
+{
+	return eytzinger1_last(size) - 1;
+}
+
+static inline unsigned eytzinger0_next(unsigned i, unsigned size)
+{
+	return eytzinger1_next(i + 1, size) - 1;
+}
+
+static inline unsigned eytzinger0_prev(unsigned i, unsigned size)
+{
+	return eytzinger1_prev(i + 1, size) - 1;
+}
+
+static inline unsigned eytzinger0_extra(unsigned size)
+{
+	return eytzinger1_extra(size);
+}
+
+static inline unsigned __eytzinger0_to_inorder(unsigned i, unsigned size,
+					       unsigned extra)
+{
+	return __eytzinger1_to_inorder(i + 1, size, extra) - 1;
+}
+
+static inline unsigned __inorder_to_eytzinger0(unsigned i, unsigned size,
+					       unsigned extra)
+{
+	return __inorder_to_eytzinger1(i + 1, size, extra) - 1;
+}
+
+static inline unsigned eytzinger0_to_inorder(unsigned i, unsigned size)
+{
+	return __eytzinger0_to_inorder(i, size, eytzinger0_extra(size));
+}
+
+static inline unsigned inorder_to_eytzinger0(unsigned i, unsigned size)
+{
+	return __inorder_to_eytzinger0(i, size, eytzinger0_extra(size));
+}
+
+#define eytzinger0_for_each(_i, _size)			\
+	for (unsigned (_i) = eytzinger0_first((_size));	\
+	     (_i) != -1;				\
+	     (_i) = eytzinger0_next((_i), (_size)))
+
+#define eytzinger0_for_each_prev(_i, _size)		\
+	for (unsigned (_i) = eytzinger0_last((_size));	\
+	     (_i) != -1;				\
+	     (_i) = eytzinger0_prev((_i), (_size)))
+
+/* return greatest node <= @search, or -1 if not found */
+static inline int eytzinger0_find_le(void *base, size_t nr, size_t size,
+				     cmp_func_t cmp, const void *search)
+{
+	void *base1 = base - size;
+	unsigned n = 1;
+
+	while (n <= nr)
+		n = eytzinger1_child(n, cmp(base1 + n * size, search) <= 0);
+	n >>= __ffs(n) + 1;
+	return n - 1;
+}
+
+/* return smallest node > @search, or -1 if not found */
+static inline int eytzinger0_find_gt(void *base, size_t nr, size_t size,
+				     cmp_func_t cmp, const void *search)
+{
+	void *base1 = base - size;
+	unsigned n = 1;
+
+	while (n <= nr)
+		n = eytzinger1_child(n, cmp(base1 + n * size, search) <= 0);
+	n >>= __ffs(n + 1) + 1;
+	return n - 1;
+}
+
+/* return smallest node >= @search, or -1 if not found */
+static inline int eytzinger0_find_ge(void *base, size_t nr, size_t size,
+				     cmp_func_t cmp, const void *search)
+{
+	void *base1 = base - size;
+	unsigned n = 1;
+
+	while (n <= nr)
+		n = eytzinger1_child(n, cmp(base1 + n * size, search) < 0);
+	n >>= __ffs(n + 1) + 1;
+	return n - 1;
+}
+
+/* 0 == not found */
+static inline int eytzinger1_find_r(void *base, unsigned nr, unsigned size,
+				    cmp_r_func_t cmp_fn, const void *priv,
+				    const void *search)
+{
+	unsigned i = 1;
+	while (i <= nr) {
+		int cmp = cmp_fn(search, base + i * size, priv);
+		if (!cmp)
+			return i;
+		i = eytzinger1_child(i, cmp > 0);
+	}
+
+	return 0;
+}
+
+/* 0 == not found */
+static inline int eytzinger1_find(void *base, unsigned nr, unsigned size,
+				  cmp_func_t cmp_fn, const void *search)
+{
+	unsigned i = 1;
+	while (i <= nr) {
+		int cmp = cmp_fn(search, base + i * size);
+		if (!cmp)
+			return i;
+		i = eytzinger1_child(i, cmp > 0);
+	}
+
+	return 0;
+}
+
+/* -1 == not found */
+static inline int eytzinger0_find_r(void *base, unsigned nr, unsigned size,
+				    cmp_r_func_t cmp_fn, const void *priv,
+				    const void *search)
+{
+	return eytzinger1_find_r(base - size, nr, size, cmp_fn, priv, search) - 1;
+}
+
+/* -1 == not found */
+static inline int eytzinger0_find(void *base, unsigned nr, unsigned size,
+				  cmp_func_t cmp_fn, const void *search)
+{
+	return eytzinger1_find(base - size, nr, size, cmp_fn, search) - 1;
+}
+
+void eytzinger1_sort_r(void *, size_t, size_t,
+		       cmp_r_func_t, swap_r_func_t, const void *);
+void eytzinger1_sort(void *, size_t, size_t, cmp_func_t, swap_func_t);
+
+void eytzinger0_sort_r(void *, size_t, size_t,
+		       cmp_r_func_t, swap_r_func_t, const void *);
+void eytzinger0_sort(void *, size_t, size_t, cmp_func_t, swap_func_t);
+
+#endif /* _EYTZINGER_H */
diff --git a/fs/bcachefs/util/eytzinger.rs b/fs/bcachefs/util/eytzinger.rs
new file mode 100644
index 0000000..7219949
--- /dev/null
+++ b/fs/bcachefs/util/eytzinger.rs
@@ -0,0 +1,486 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! Eytzinger layout: a complete binary tree in an array, root first, then
+//! each level in turn - node i's children at 2i and 2i + 1. The C
+//! (util/eytzinger.[ch]) stays until its C users are gone.
+//!
+//! In place of binary search over a sorted array: binary search is a worst
+//! case for branch prediction and prefetching, while here a node's children
+//! are adjacent in memory, so they can be fetched before the comparison
+//! resolves - several levels' worth, when several nodes fit on a cacheline.
+//!
+//! A tree's index math is a method of its shape: Eytzinger1<T>, of a size,
+//! for every unsigned T it's instantiated for - and its `extra`, which the
+//! inorder conversions take, computed once at new(), where C's callers cache
+//! it by hand for the __eytzinger1_*() variants.
+//!
+//! Two variants, by index base:
+//! - Eytzinger1: nodes 1..=size, slot 0 of an array unused. Each level
+//!   starts at a power of two, so if the array is cacheline aligned, every
+//!   level is: the faster one. 0 is "no node", as in C.
+//! - Eytzinger0: nodes 0..size, every slot a node: the more convenient one.
+//!   The same tree, every index one less - each method Eytzinger1's on
+//!   i + 1, and None where C says -1.
+//!
+//! Searching and sorting are over slices - Eytzinger1::find_by(), sort_by(),
+//! Eytzinger0::find_le_by() and the rest - with the slice methods'
+//! comparisons: a find's closure takes an element and says how it orders
+//! against what's searched for, as binary_search_by()'s; a sort's compares
+//! two elements, as sort_by()'s. The C's cmp/swap function pointers, priv
+//! wrappers and alignment-picked word swaps are what closures and
+//! slice::swap() are.
+
+use core::cmp::Ordering;
+
+/// A one-based eytzinger tree of `size` nodes.
+#[derive(Clone, Copy, Debug)]
+pub struct Eytzinger1<T> {
+    size:  T,
+    /// Twice the nodes on the bottom level: past it, inorder positions skip
+    /// the missing leaves of an incomplete tree.
+    extra: T,
+}
+
+/// A zero-based eytzinger tree of `size` nodes.
+#[derive(Clone, Copy, Debug)]
+pub struct Eytzinger0<T>(Eytzinger1<T>);
+
+macro_rules! eytzinger_impl {
+    ($t:ty) => {
+        impl Eytzinger1<$t> {
+            /// The index of @x's highest set bit; @x nonzero. C's __fls().
+            const fn fls(x: $t) -> u32 {
+                <$t>::BITS - 1 - x.leading_zeros()
+            }
+
+            /// A tree of @size nodes: at most half the type's range, as the
+            /// inorder conversions reach 2 * size.
+            pub const fn new(size: $t) -> Self {
+                debug_assert!(size <= <$t>::MAX / 2);
+                let extra = if size != 0 { (size + 1 - (1 << Self::fls(size))) << 1 } else { 0 };
+                Self { size, extra }
+            }
+
+            pub const fn size(&self) -> $t {
+                self.size
+            }
+
+            /// Node @i's left (@dir 0) or right (@dir 1) child.
+            pub fn child(i: $t, dir: $t) -> $t {
+                debug_assert!(dir <= 1);
+                (i << 1) + dir
+            }
+
+            pub fn left_child(i: $t) -> $t {
+                Self::child(i, 0)
+            }
+
+            pub fn right_child(i: $t) -> $t {
+                Self::child(i, 1)
+            }
+
+            /// The first node in order, the leftmost; 0 for an empty tree.
+            pub fn first(&self) -> $t {
+                if self.size != 0 { 1 << Self::fls(self.size) } else { 0 }
+            }
+
+            /// The last node in order, the rightmost; 0 for an empty tree.
+            pub fn last(&self) -> $t {
+                (1 << Self::fls(self.size + 1)) - 1
+            }
+
+            /// The node after @i in order; 0 after the last.
+            pub fn next(&self, mut i: $t) -> $t {
+                debug_assert!(i != 0 && i <= self.size);
+
+                if Self::right_child(i) <= self.size {
+                    i = Self::right_child(i);
+
+                    i <<= Self::fls(self.size) - Self::fls(i);
+                    i >>= (i > self.size) as u32;
+                } else {
+                    i >>= i.trailing_ones() + 1;
+                }
+                i
+            }
+
+            /// The node before @i in order; 0 before the first.
+            pub fn prev(&self, mut i: $t) -> $t {
+                debug_assert!(i != 0 && i <= self.size);
+
+                if Self::left_child(i) <= self.size {
+                    i = Self::left_child(i) + 1;
+
+                    i <<= Self::fls(self.size) - Self::fls(i);
+                    i -= 1;
+                    i >>= (i > self.size) as u32;
+                } else {
+                    i >>= i.trailing_zeros() + 1;
+                }
+                i
+            }
+
+            /// Node @i's inorder (sorted) position, 1-based.
+            pub fn to_inorder(&self, mut i: $t) -> $t {
+                debug_assert!(i != 0 && i <= self.size);
+
+                let b = Self::fls(i);
+                let shift = Self::fls(self.size) - b;
+
+                i ^= 1 << b;
+                i <<= 1;
+                i |= 1;
+                i <<= shift;
+
+                // Past extra, only the levels above the bottom: shifted, so
+                // even, as extra is - the halving is exact.
+                if i > self.extra {
+                    i -= (i - self.extra) >> 1;
+                }
+                i
+            }
+
+            /// The node at inorder position @i, 1-based.
+            pub fn from_inorder(&self, mut i: $t) -> $t {
+                debug_assert!(i != 0 && i <= self.size);
+
+                if i > self.extra {
+                    i += i - self.extra;
+                }
+
+                let shift = i.trailing_zeros();
+
+                i >>= shift + 1;
+                i |= 1 << (Self::fls(self.size) - shift);
+                i
+            }
+
+            /// The nodes, in order.
+            pub fn iter(&self) -> impl Iterator<Item = $t> {
+                let e = *self;
+                let node = |i: $t| (i != 0).then_some(i);
+                core::iter::successors(node(e.first()), move |&i| node(e.next(i)))
+            }
+        }
+
+        impl Eytzinger0<$t> {
+            pub const fn new(size: $t) -> Self {
+                Self(Eytzinger1::<$t>::new(size))
+            }
+
+            pub const fn size(&self) -> $t {
+                self.0.size
+            }
+
+            /// Node @i's left (@dir 0) or right (@dir 1) child.
+            pub fn child(i: $t, dir: $t) -> $t {
+                debug_assert!(dir <= 1);
+                (i << 1) + 1 + dir
+            }
+
+            pub fn left_child(i: $t) -> $t {
+                Self::child(i, 0)
+            }
+
+            pub fn right_child(i: $t) -> $t {
+                Self::child(i, 1)
+            }
+
+            pub fn first(&self) -> Option<$t> {
+                self.0.first().checked_sub(1)
+            }
+
+            pub fn last(&self) -> Option<$t> {
+                self.0.last().checked_sub(1)
+            }
+
+            pub fn next(&self, i: $t) -> Option<$t> {
+                self.0.next(i + 1).checked_sub(1)
+            }
+
+            pub fn prev(&self, i: $t) -> Option<$t> {
+                self.0.prev(i + 1).checked_sub(1)
+            }
+
+            /// Node @i's inorder (sorted) position, 0-based.
+            pub fn to_inorder(&self, i: $t) -> $t {
+                self.0.to_inorder(i + 1) - 1
+            }
+
+            /// The node at inorder position @i, 0-based.
+            pub fn from_inorder(&self, i: $t) -> $t {
+                self.0.from_inorder(i + 1) - 1
+            }
+
+            /// The nodes, in order.
+            pub fn iter(&self) -> impl Iterator<Item = $t> {
+                let e = *self;
+                core::iter::successors(e.first(), move |&i| e.next(i))
+            }
+
+            /// The nodes, in reverse order.
+            pub fn iter_rev(&self) -> impl Iterator<Item = $t> {
+                let e = *self;
+                core::iter::successors(e.last(), move |&i| e.prev(i))
+            }
+        }
+    };
+}
+
+eytzinger_impl!(u16);
+eytzinger_impl!(u32);
+eytzinger_impl!(usize);
+
+/// The @n nodes stored in @v from @base - index pos - base is Eytzinger1 node
+/// pos - sorted into eytzinger order, as eytzinger1_sort_r(): compared and
+/// swapped by index, @v whatever holds them.
+fn sort_impl<S: ?Sized>(
+    v:        &mut S,
+    n:        usize,
+    base:     usize,
+    mut cmp:  impl FnMut(&S, usize, usize) -> Ordering,
+    mut swap: impl FnMut(&mut S, usize, usize),
+) {
+    let e = Eytzinger1::<usize>::new(n);
+    let pos = |inorder: usize| e.from_inorder(inorder) - base;
+
+    // Heapsort over inorder positions 1..=n, each stored at its eytzinger
+    // position - so when the inorder sequence is sorted, the tree is.
+    let mut gt = |v: &S, l: usize, r: usize| cmp(v, pos(l), pos(r));
+    let mut swap = |v: &mut S, l: usize, r: usize| swap(v, pos(l), pos(r));
+
+    // heapify
+    for i in (1..=n / 2).rev() {
+        // Find the sift-down path all the way to the leaves.
+        let mut j = i;
+        while j * 2 < n {
+            let k = j * 2;
+            j = if gt(v, k, k + 1) == Ordering::Greater { k } else { k + 1 };
+        }
+
+        // Special case for the last leaf with no sibling.
+        if j * 2 == n {
+            j *= 2;
+        }
+
+        // Backtrack to the correct location.
+        while j != i && gt(v, i, j) != Ordering::Less {
+            j /= 2;
+        }
+
+        // Shift the element into its correct place.
+        let k = j;
+        while j != i {
+            j /= 2;
+            swap(v, j, k);
+        }
+
+        crate::util::kernel::cond_resched();
+    }
+
+    // sort
+    for i in (2..=n).rev() {
+        swap(v, 1, i);
+
+        // Find the sift-down path all the way to the leaves.
+        let mut j = 1;
+        while j * 2 + 1 < i {
+            let k = j * 2;
+            j = if gt(v, k, k + 1) == Ordering::Greater { k } else { k + 1 };
+        }
+
+        // Special case for the last leaf with no sibling.
+        if j * 2 + 1 == i {
+            j *= 2;
+        }
+
+        // Backtrack to the correct location.
+        while j >= 1 && gt(v, 1, j) != Ordering::Less {
+            j /= 2;
+        }
+
+        // Shift the element into its correct place.
+        let k = j;
+        while j > 1 {
+            j /= 2;
+            swap(v, j, k);
+        }
+
+        crate::util::kernel::cond_resched();
+    }
+}
+
+fn sort_by_impl<T>(v: &mut [T], n: usize, base: usize, mut cmp: impl FnMut(&T, &T) -> Ordering) {
+    sort_impl(v, n, base, |v, l, r| cmp(&v[l], &v[r]), |v, l, r| v.swap(l, r))
+}
+
+/// The node of @n stored from @base that @f - given its index, pos - base -
+/// says is the one searched for (Equal), by Eytzinger1 position.
+fn find_impl(n: usize, base: usize, mut f: impl FnMut(usize) -> Ordering) -> Option<usize> {
+    let mut i = 1;
+    while i <= n {
+        match f(i - base) {
+            Ordering::Equal => return Some(i),
+            o => i = Eytzinger1::<usize>::child(i, (o == Ordering::Less) as usize),
+        }
+    }
+    None
+}
+
+impl Eytzinger1<usize> {
+    /// The tree in @v: one node less than its slots, for the unused slot 0.
+    pub fn of<T>(v: &[T]) -> Self {
+        Self::new(v.len().saturating_sub(1))
+    }
+
+    /// The node of @v that @f says is the one searched for (Equal), if any.
+    pub fn find_by<T>(v: &[T], mut f: impl FnMut(&T) -> Ordering) -> Option<usize> {
+        find_impl(Self::of(v).size, 0, |i| f(&v[i]))
+    }
+
+    /// @v's nodes, slot 0 aside, sorted into eytzinger order.
+    pub fn sort_by<T>(v: &mut [T], cmp: impl FnMut(&T, &T) -> Ordering) {
+        sort_by_impl(v, Self::of(v).size, 0, cmp)
+    }
+}
+
+impl Eytzinger0<usize> {
+    /// The tree in @v: a node per slot.
+    pub fn of<T>(v: &[T]) -> Self {
+        Self::new(v.len())
+    }
+
+    /// The node of @v that @f says is the one searched for (Equal), if any.
+    pub fn find_by<T>(v: &[T], mut f: impl FnMut(&T) -> Ordering) -> Option<usize> {
+        Self::of(v).find(|i| f(&v[i]))
+    }
+
+    /// The greatest node of @v <= what @f compares against, if any.
+    pub fn find_le_by<T>(v: &[T], mut f: impl FnMut(&T) -> Ordering) -> Option<usize> {
+        let mut n = 1;
+        while n <= v.len() {
+            n = Eytzinger1::<usize>::child(n, (f(&v[n - 1]) != Ordering::Greater) as usize);
+        }
+        n >>= n.trailing_zeros() + 1;
+        n.checked_sub(1)
+    }
+
+    /// The smallest node of @v > what @f compares against, if any.
+    pub fn find_gt_by<T>(v: &[T], mut f: impl FnMut(&T) -> Ordering) -> Option<usize> {
+        let mut n = 1;
+        while n <= v.len() {
+            n = Eytzinger1::<usize>::child(n, (f(&v[n - 1]) != Ordering::Greater) as usize);
+        }
+        n >>= (n + 1).trailing_zeros() + 1;
+        n.checked_sub(1)
+    }
+
+    /// The smallest node of @v >= what @f compares against, if any.
+    pub fn find_ge_by<T>(v: &[T], mut f: impl FnMut(&T) -> Ordering) -> Option<usize> {
+        let mut n = 1;
+        while n <= v.len() {
+            n = Eytzinger1::<usize>::child(n, (f(&v[n - 1]) == Ordering::Less) as usize);
+        }
+        n >>= (n + 1).trailing_zeros() + 1;
+        n.checked_sub(1)
+    }
+
+    /// @v sorted into eytzinger order.
+    pub fn sort_by<T>(v: &mut [T], cmp: impl FnMut(&T, &T) -> Ordering) {
+        sort_by_impl(v, v.len(), 1, cmp)
+    }
+
+    // By index, for nodes that aren't a slice's - a table of runtime-sized
+    // entries:
+
+    /// The node @f says is the one searched for (Equal), if any.
+    pub fn find(&self, f: impl FnMut(usize) -> Ordering) -> Option<usize> {
+        find_impl(self.0.size, 1, f).map(|i| i - 1)
+    }
+
+    /// @v's nodes sorted into eytzinger order: compared, and swapped, in @v
+    /// by index.
+    pub fn sort<S: ?Sized>(&self, v: &mut S, cmp: impl FnMut(&S, usize, usize) -> Ordering,
+                           swap: impl FnMut(&mut S, usize, usize)) {
+        sort_impl(v, self.0.size, 1, cmp, swap)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{Eytzinger0, Eytzinger1};
+
+    /// A permutation of 0, 2, 4.. (2n - 2), from an LCG: deterministic, no
+    /// dependencies.
+    fn shuffled(n: usize, seed: u64) -> Vec<u32> {
+        let mut v: Vec<u32> = (0..n as u32).map(|x| x * 2).collect();
+        let mut s = seed;
+        for i in (1..n).rev() {
+            s = s.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+            v.swap(i, (s >> 33) as usize % (i + 1));
+        }
+        v
+    }
+
+    // The index math and the sort are only checked against each other and a
+    // linear scan: a wrong answer here is a lookup that silently misses.
+    #[test]
+    fn eytzinger1_sort_find() {
+        for n in 0..300 {
+            let e = Eytzinger1::<usize>::new(n);
+            let e32 = Eytzinger1::<u32>::new(n as u32);
+            let e16 = Eytzinger1::<u16>::new(n as u16);
+            for i in 1..=n {
+                assert_eq!(e.from_inorder(e.to_inorder(i)), i);
+                assert_eq!(e32.to_inorder(i as u32) as usize, e.to_inorder(i));
+                assert_eq!(e16.from_inorder(i as u16) as usize, e.from_inorder(i));
+            }
+            let order: Vec<usize> = e.iter().collect();
+            assert_eq!(order, (1..=n).map(|i| e.from_inorder(i)).collect::<Vec<_>>());
+            assert_eq!(order.last().copied().unwrap_or(0), e.last());
+            assert!(e32.iter().map(|i| i as usize).eq(order.iter().copied()));
+            assert!(e16.iter().map(|i| i as usize).eq(order.iter().copied()));
+
+            let mut v = vec![u32::MAX];
+            v.extend(shuffled(n, n as u64));
+            Eytzinger1::sort_by(&mut v, |a, b| a.cmp(b));
+            assert_eq!(v[0], u32::MAX);
+            assert!(order.windows(2).all(|w| v[w[0]] < v[w[1]]), "n {n}: not sorted");
+
+            for x in 0..2 * n as u32 + 1 {
+                let found = Eytzinger1::find_by(&v, |e| e.cmp(&x));
+                assert_eq!(found.map(|i| v[i]), (x % 2 == 0 && x < 2 * n as u32).then_some(x));
+            }
+        }
+    }
+
+    #[test]
+    fn eytzinger0_sort_find() {
+        for n in 0..300 {
+            let e = Eytzinger0::<usize>::new(n);
+            let order: Vec<usize> = e.iter().collect();
+            assert_eq!(order, (0..n).map(|i| e.from_inorder(i)).collect::<Vec<_>>());
+            assert!(order.iter().enumerate().all(|(pos, &i)| e.to_inorder(i) == pos));
+            let mut rev: Vec<usize> = e.iter_rev().collect();
+            rev.reverse();
+            assert_eq!(rev, order);
+
+            let mut v = shuffled(n, n as u64 + 1000);
+            Eytzinger0::sort_by(&mut v, |a, b| a.cmp(b));
+            assert!(order.windows(2).all(|w| v[w[0]] < v[w[1]]), "n {n}: not sorted");
+
+            let sorted: Vec<u32> = order.iter().map(|&i| v[i]).collect();
+            for x in 0..2 * n as u32 + 1 {
+                let val = |i: Option<usize>| i.map(|i| v[i]);
+                assert_eq!(val(Eytzinger0::find_by(&v, |e| e.cmp(&x))),
+                           sorted.iter().copied().find(|&e| e == x));
+                assert_eq!(val(Eytzinger0::find_le_by(&v, |e| e.cmp(&x))),
+                           sorted.iter().copied().rev().find(|&e| e <= x));
+                assert_eq!(val(Eytzinger0::find_gt_by(&v, |e| e.cmp(&x))),
+                           sorted.iter().copied().find(|&e| e > x));
+                assert_eq!(val(Eytzinger0::find_ge_by(&v, |e| e.cmp(&x))),
+                           sorted.iter().copied().find(|&e| e >= x));
+            }
+        }
+    }
+}
diff --git a/fs/bcachefs/util/fast_list.c b/fs/bcachefs/util/fast_list.c
new file mode 100644
index 0000000..7ae0d66
--- /dev/null
+++ b/fs/bcachefs/util/fast_list.c
@@ -0,0 +1,187 @@
+// SPDX-License-Identifier: GPL-2.0
+
+/*
+ * Fast, unordered lists
+ *
+ * Supports add, remove, and iterate
+ *
+ * Underneath, they're a radix tree and an IDA, with a percpu buffer for slot
+ * allocation and freeing.
+ *
+ * This means that adding, removing, and iterating over items is lockless,
+ * except when refilling/emptying the percpu slot buffers.
+ */
+
+#include "bcachefs.h"
+#include "fast_list.h"
+
+struct fast_list_pcpu {
+	u32			nr;
+	u32			entries[31];
+};
+
+static int fast_list_alloc_idx(struct fast_list *l, gfp_t gfp)
+{
+	int idx = ida_alloc_range(&l->slots_allocated, 1, INT_MAX, gfp);
+	if (unlikely(idx < 0))
+		return 0;
+
+	if (unlikely(!genradix_ptr_alloc_inlined(&l->items, idx, gfp))) {
+		ida_free(&l->slots_allocated, idx);
+		return 0;
+	}
+
+	return idx;
+}
+
+/**
+ * fast_list_get_idx - get a slot in a fast_list
+ * @l:		list to get slot in
+ *
+ * This allocates a slot in the radix tree without storing to it, so that we can
+ * take the potential memory allocation failure early and do the list add later
+ * when we can't take an allocation failure.
+ *
+ * Returns: positive integer on success, -ENOMEM on failure
+ */
+int fast_list_get_idx(struct fast_list *l, gfp_t gfp)
+{
+	unsigned long flags;
+	int idx;
+
+	while (true) {
+		local_irq_save(flags);
+		struct fast_list_pcpu *lp = this_cpu_ptr(l->buffer);
+
+		if (unlikely(!lp->nr)) {
+			u32 entries[16], nr = 0;
+
+			local_irq_restore(flags);
+			while (nr < ARRAY_SIZE(entries) &&
+			       (idx = fast_list_alloc_idx(l, gfp)))
+				entries[nr++] = idx;
+			local_irq_save(flags);
+
+			lp = this_cpu_ptr(l->buffer);
+
+			while (nr && lp->nr < ARRAY_SIZE(lp->entries))
+				lp->entries[lp->nr++] = entries[--nr];
+
+			if (unlikely(nr)) {
+				local_irq_restore(flags);
+				while (nr)
+					ida_free(&l->slots_allocated, entries[--nr]);
+				continue;
+			}
+
+			if (unlikely(!lp->nr)) {
+				local_irq_restore(flags);
+				return -ENOMEM;
+			}
+		}
+
+		idx = lp->entries[--lp->nr];
+		local_irq_restore(flags);
+		break;
+	}
+
+	return idx;
+}
+
+/**
+ * fast_list_add - add an item to a fast_list
+ * @l:		list
+ * @item:	item to add
+ *
+ * Allocates a slot in the radix tree and stores to it and then returns the
+ * slot index, which must be passed to fast_list_remove().
+ *
+ * Returns: positive integer on success, -ENOMEM on failure
+ */
+int fast_list_add(struct fast_list *l, void *item)
+{
+	int idx = fast_list_get_idx(l, GFP_KERNEL);
+	if (idx < 0)
+		return idx;
+
+	*genradix_ptr_inlined(&l->items, idx) = item;
+	return idx;
+}
+
+/**
+ * fast_list_put_idx - return a slot index obtained from fast_list_get_idx()
+ * @l:		list
+ * @idx:	slot index to return
+ *
+ * Inverse of fast_list_get_idx(). Use this when the slot was reserved but
+ * never populated (so no slot-clearing is needed).
+ */
+void fast_list_put_idx(struct fast_list *l, unsigned idx)
+{
+	u32 entries[16], nr = 0;
+
+	if (!idx)
+		return;
+
+	scoped_guard(irqsave) {
+		struct fast_list_pcpu *lp = this_cpu_ptr(l->buffer);
+
+		if (unlikely(lp->nr == ARRAY_SIZE(lp->entries)))
+			while (nr < ARRAY_SIZE(entries))
+				entries[nr++] = lp->entries[--lp->nr];
+
+		lp->entries[lp->nr++] = idx;
+	}
+
+	if (unlikely(nr))
+		while (nr)
+			ida_free(&l->slots_allocated, entries[--nr]);
+}
+
+/**
+ * fast_list_remove - remove an item from a fast_list
+ * @l:		list
+ * @idx:	item's slot index
+ *
+ * Zeroes out the slot in the radix tree and frees the slot for future
+ * fast_list_add() operations.
+ */
+void fast_list_remove(struct fast_list *l, unsigned idx)
+{
+	if (!idx)
+		return;
+
+	*genradix_ptr_inlined(&l->items, idx) = NULL;
+	fast_list_put_idx(l, idx);
+}
+
+void fast_list_exit(struct fast_list *l)
+{
+	if (l->buffer) {
+		int cpu;
+		for_each_possible_cpu(cpu) {
+			struct fast_list_pcpu *lp = per_cpu_ptr(l->buffer, cpu);
+
+			while (lp->nr)
+				ida_free(&l->slots_allocated, lp->entries[--lp->nr]);
+		}
+
+		free_percpu(l->buffer);
+	}
+
+	WARN(ida_find_first(&l->slots_allocated) >= 0,
+	     "fast_list still has objects on exit\n");
+
+	ida_destroy(&l->slots_allocated);
+	genradix_free(&l->items);
+}
+
+int fast_list_init(struct fast_list *l)
+{
+	genradix_init(&l->items);
+	ida_init(&l->slots_allocated);
+	l->buffer = alloc_percpu(*l->buffer);
+	if (!l->buffer)
+		return -ENOMEM;
+	return 0;
+}
diff --git a/fs/bcachefs/util/fast_list.h b/fs/bcachefs/util/fast_list.h
new file mode 100644
index 0000000..ba8b35c
--- /dev/null
+++ b/fs/bcachefs/util/fast_list.h
@@ -0,0 +1,40 @@
+#ifndef _LINUX_FAST_LIST_H
+#define _LINUX_FAST_LIST_H
+
+#include <linux/generic-radix-tree.h>
+#include <linux/idr.h>
+#include <linux/percpu.h>
+
+#include "util/fast_list_gen.h"
+
+static inline void *fast_list_iter_peek(struct genradix_iter *iter,
+					struct fast_list *list)
+{
+	void **p;
+	while ((p = genradix_iter_peek(iter, &list->items)) && !*p)
+		genradix_iter_advance(iter, &list->items);
+
+	return p ? *p : NULL;
+}
+
+#define fast_list_for_each_from(_list, _iter, _i, _start)		\
+	for (_iter = genradix_iter_init(&(_list)->items, _start);	\
+	     (_i = fast_list_iter_peek(&(_iter), _list)) != NULL;	\
+	     genradix_iter_advance(&(_iter), &(_list)->items))
+
+#define fast_list_for_each(_list, _iter, _i)				\
+	fast_list_for_each_from(_list, _iter, _i, 0)
+
+static inline void fast_list_set(struct fast_list *l, unsigned idx, void *item)
+{
+	*genradix_ptr_inlined(&l->items, idx) = item;
+}
+
+int fast_list_get_idx(struct fast_list *l, gfp_t gfp);
+void fast_list_put_idx(struct fast_list *l, unsigned idx);
+int fast_list_add(struct fast_list *l, void *item);
+void fast_list_remove(struct fast_list *l, unsigned idx);
+void fast_list_exit(struct fast_list *l);
+int fast_list_init(struct fast_list *l);
+
+#endif /* _LINUX_FAST_LIST_H */
diff --git a/fs/bcachefs/util/fast_list_types.rs b/fs/bcachefs/util/fast_list_types.rs
new file mode 100644
index 0000000..af99dbe
--- /dev/null
+++ b/fs/bcachefs/util/fast_list_types.rs
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![allow(non_camel_case_types)]
+
+use crate::cstructs::c;
+use crate::types::{GenRadix, c_opaque, c_default};
+use crate::util::rcu::ReadGuard;
+use core::ffi::c_void;
+use core::ptr::NonNull;
+use core::sync::atomic::{AtomicPtr, Ordering};
+use cstruct_macros::CStruct;
+
+c_opaque!(fast_list_pcpu);
+
+#[repr(C)]
+#[derive(Clone, Copy, CStruct)]
+pub struct fast_list {
+    pub items: GenRadix<*mut c_void>,
+    pub slots_allocated: c::ida,
+    #[c("struct fast_list_pcpu __percpu *buffer")]
+    pub buffer: *mut c::fast_list_pcpu,
+}
+c_default!(fast_list);
+
+impl fast_list {
+    /// fast_list_for_each_from(), with each item's slot. Other CPUs change the
+    /// slots as it's read: each is read once, atomically.
+    ///
+    /// XXX: an item is only safe to use if it's freed a grace period after
+    /// removal, and nothing here says so. Once the owners are Rust: fast_list<T>,
+    /// items &'g T, with an unsafe marker on T the owner asserts that with.
+    /// async_objs' items don't hold to it today: see debug/async_objs.rs.
+    pub fn items_from<'g>(&'g self, idx: usize, _rcu: &'g ReadGuard)
+        -> impl Iterator<Item = (usize, NonNull<c_void>)> + 'g
+    {
+        self.items.iter_from_raw(idx).filter_map(|(i, slot)| {
+            // SAFETY: a slot of the radix, a pointer, which C writes as one
+            let item = unsafe { AtomicPtr::from_ptr(slot.as_ptr()) }.load(Ordering::Acquire);
+            NonNull::new(item).map(|item| (i, item))
+        })
+    }
+}
diff --git a/fs/bcachefs/util/ffi.rs b/fs/bcachefs/util/ffi.rs
new file mode 100644
index 0000000..43944cd
--- /dev/null
+++ b/fs/bcachefs/util/ffi.rs
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! For entry points C calls: C's objects, as references (Opaque), and C's
+//! buffers, as slices. (Names are os_str.rs's.)
+//!
+//! The buffer functions are unsafe the same way: the pointer has to be what
+//! C says it is, for as long as the slice is used - which the entry point's
+//! own contract promises, and these only restate.
+
+use core::cell::UnsafeCell;
+use core::marker::PhantomPinned;
+
+/// A C object as an entry point's argument: `&Opaque<c::bch_fs>` where C
+/// passes a `struct bch_fs *`. Same ABI; transparent. A transaction is
+/// BtreeTrans, itself over one.
+///
+/// Not a plain reference to the C struct, because Rust promises things about
+/// those that aren't true of these. `&T` says the memory doesn't change for
+/// the reference's life, and `&mut T` that nothing else touches it - LLVM's
+/// readonly and noalias. A transaction's locking state is read by other
+/// threads' deadlock detection while we run, and the filesystem is shared and
+/// changing everywhere. UnsafeCell takes away the first promise, PhantomPinned
+/// the second - as the kernel crate's Opaque<T>, which userspace doesn't have.
+///
+/// There's no constructor: only C hands these out, so one always refers to a
+/// live, initialized object of its type - what Fs::from_c() relies on. Safe
+/// code can't make one from a C struct with made-up fields. The exception is
+/// C's locks, which are Opaques as the structs C shares hold them
+/// (locking/raw.rs) - zeroed with the struct, and initialized by its init.
+#[repr(transparent)]
+pub struct Opaque<T> {
+    value: UnsafeCell<T>,
+    _pin:  PhantomPinned,
+}
+
+impl<T> Opaque<T> {
+    /// The C object, for C.
+    pub fn as_ptr(&self) -> *mut T {
+        self.value.get()
+    }
+}
+
+/// C's char, as C compiles it here. core::ffi::c_char is the platform ABI's -
+/// i8 on x86, u8 on arm64 - which is userspace's; the kernel builds with
+/// -funsigned-char, so u8 on every arch, as the kernel's own ffi::c_char. The
+/// types differ only to Rust, but that includes kCFI: a function C calls
+/// through a pointer taking `char *` as `*const i8` never hashes as C's
+/// prototype does.
+#[cfg(kernel)]
+#[allow(non_camel_case_types)]
+pub type c_char = u8;
+#[cfg(not(kernel))]
+pub use core::ffi::c_char;
+
+/// The rest of C's types, which are the same in either build: with c_char,
+/// codegen.rs's bindings' --ctypes-prefix.
+pub use core::ffi::{c_int, c_long, c_longlong, c_schar, c_short, c_uchar, c_uint, c_ulong,
+                    c_ulonglong, c_ushort, c_void};
+
+/// The C string at @p, None for a NULL @p.
+///
+/// # Safety
+/// @p NULL or a NUL-terminated string, valid for 'a.
+pub unsafe fn opt_cstr<'a>(p: *const c_char) -> Option<&'a core::ffi::CStr> {
+    (!p.is_null()).then(|| unsafe { core::ffi::CStr::from_ptr(p.cast()) })
+}
+
+/// @size bytes at @p - nothing, for none.
+///
+/// # Safety
+/// @p is valid for @size bytes, for 'a.
+pub unsafe fn bytes<'a>(p: *const c_void, size: usize) -> &'a [u8] {
+    if size == 0 { &[] } else { unsafe { core::slice::from_raw_parts(p as *const u8, size) } }
+}
+
+/// As bytes(), None for a NULL @p - C's way of saying there's no value.
+///
+/// # Safety
+/// As bytes().
+pub unsafe fn opt_bytes<'a>(p: *const c_void, size: usize) -> Option<&'a [u8]> {
+    (!p.is_null()).then(|| unsafe { bytes(p, size) })
+}
+
+/// The @size byte buffer at @p, None for a NULL @p - C's way of asking only
+/// how big something is.
+///
+/// # Safety
+/// @p is valid for @size bytes, and nothing else uses them, for 'a.
+pub unsafe fn opt_bytes_mut<'a>(p: *mut c_void, size: usize) -> Option<&'a mut [u8]> {
+    (!p.is_null()).then(|| unsafe { core::slice::from_raw_parts_mut(p as *mut u8, size) })
+}
+
+/// @s, NUL terminated, as a C string - for a const table of them, built from
+/// concat!(.., "\0").
+pub const fn c_str(s: &'static str) -> &'static core::ffi::CStr {
+    match core::ffi::CStr::from_bytes_with_nul(s.as_bytes()) {
+        Ok(s)  => s,
+        Err(_) => panic!("not a C string"),
+    }
+}
+
+/// @f, given @s as a C string - a copy, NUL terminated, and as C would see
+/// it: up to a NUL in @s, if there's one.
+pub fn with_cstr<R>(s: &str, f: impl FnOnce(&core::ffi::CStr) -> R)
+    -> Result<R, crate::util::alloc::AllocError>
+{
+    use crate::util::alloc::{flags::GFP_KERNEL, KVVec};
+
+    let mut buf = KVVec::new();
+    buf.extend_from_slice(s.as_bytes(), GFP_KERNEL)?;
+    buf.push(0, GFP_KERNEL)?;
+
+    // can't fail: the NUL pushed ends it, if nothing in @s did
+    Ok(f(core::ffi::CStr::from_bytes_until_nul(&buf).unwrap()))
+}
diff --git a/fs/bcachefs/util/fifo.h b/fs/bcachefs/util/fifo.h
new file mode 100644
index 0000000..8cdf82f
--- /dev/null
+++ b/fs/bcachefs/util/fifo.h
@@ -0,0 +1,185 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _BCACHEFS_FIFO_H
+#define _BCACHEFS_FIFO_H
+
+#include "util.h"
+
+#define __FIFO(type, index_type)					\
+struct {								\
+	index_type front, back, size, mask;				\
+	type *data;							\
+}
+
+#define FIFO(type)			__FIFO(type, size_t)
+#define FIFO_U16_IDX(type)		__FIFO(type, u16)
+#define FIFO_U32_IDX(type)		__FIFO(type, u32)
+#define FIFO_U64_IDX(type)		__FIFO(type, u64)
+
+#define DECLARE_FIFO(type, name)		FIFO(type) name
+#define DECLARE_FIFO_U16_IDX(type, name)	FIFO_U16_IDX(type) name
+#define DECLARE_FIFO_U32_IDX(type, name)	FIFO_U32_IDX(type) name
+#define DECLARE_FIFO_U64_IDX(type, name)	FIFO_U64_IDX(type) name
+
+#define fifo_buf_size(fifo)						\
+	((fifo)->size							\
+	 ? roundup_pow_of_two((fifo)->size) * sizeof((fifo)->data[0])	\
+	 : 0)
+
+#define init_fifo(fifo, _size, _gfp)					\
+({									\
+	(fifo)->front	= (fifo)->back = 0;				\
+	(fifo)->size	= (_size);					\
+	(fifo)->mask	= (fifo)->size					\
+		? roundup_pow_of_two((fifo)->size) - 1			\
+		: 0;							\
+	(fifo)->data	= kvmalloc(fifo_buf_size(fifo), (_gfp));	\
+})
+
+#define free_fifo(fifo)							\
+do {									\
+	kvfree((fifo)->data);						\
+	(fifo)->data = NULL;						\
+} while (0)
+
+#define fifo_swap(l, r)							\
+do {									\
+	swap((l)->front, (r)->front);					\
+	swap((l)->back, (r)->back);					\
+	swap((l)->size, (r)->size);					\
+	swap((l)->mask, (r)->mask);					\
+	swap((l)->data, (r)->data);					\
+} while (0)
+
+#define fifo_move(dest, src)						\
+do {									\
+	typeof(*((dest)->data)) _t;					\
+	while (!fifo_full(dest) &&					\
+	       fifo_pop(src, _t))					\
+		fifo_push(dest, _t);					\
+} while (0)
+
+#define __fifo_grow(fifo, _new_data, _new_size)			\
+({								\
+	size_t _old_size = fifo_buf_size(fifo);			\
+	typeof((fifo)->data) _old_data = (fifo)->data;		\
+								\
+	memcpy(_new_data,					\
+	       _old_data, _old_size);				\
+	memcpy(_new_data + (fifo)->mask + 1,			\
+	       _old_data, _old_size);				\
+	(fifo)->size	= _new_size;				\
+	(fifo)->mask	= roundup_pow_of_two(_new_size) - 1;	\
+})
+
+/*
+ * Double the size of a fifo, preserving front and back indices.
+ *
+ * The new mask gains one bit. For any absolute index i, i & new_mask is either
+ * (i & old_mask) or (i & old_mask) + old_buf_elems, depending on that bit in i.
+ * So copying the old buffer into both halves of the new buffer puts every
+ * element at the correct position for the new mask.
+ */
+#define fifo_grow(fifo, _gfp)						\
+({									\
+	size_t _osize = fifo_buf_size(fifo);				\
+	size_t _new_size = (fifo)->size * 2;				\
+	typeof((fifo)->data) _new_data =				\
+		kvmalloc(_osize * 2, (_gfp));				\
+	if (_new_data) {						\
+		__fifo_grow(fifo, _new_data, _new_size);		\
+		kvfree((fifo)->data);					\
+		(fifo)->data = _new_data;				\
+	}								\
+	_new_data != NULL;						\
+})
+
+#define fifo_used(fifo)		((typeof((fifo)->front)) ((fifo)->back - (fifo)->front))
+#define fifo_free(fifo)		((fifo)->size - fifo_used(fifo))
+
+#define fifo_empty(fifo)	((fifo)->front == (fifo)->back)
+#define fifo_full(fifo)		(fifo_used(fifo) == (fifo)->size)
+
+#define fifo_entry(fifo, idx)	((fifo)->data[(idx) & (fifo)->mask])
+
+#define fifo_peek_front(fifo)	fifo_entry((fifo), (fifo)->front)
+#define fifo_peek_back(fifo)	fifo_entry((fifo), (fifo)->back - 1)
+
+#define fifo_entry_idx_abs(fifo, p)					\
+	((((p) >= &fifo_peek_front(fifo)				\
+	   ? (fifo)->front : (fifo)->back) & ~(fifo)->mask) +		\
+	   (((p) - (fifo)->data)))
+
+#define fifo_entry_idx(fifo, p)	(((p) - &fifo_peek_front(fifo)) & (fifo)->mask)
+#define fifo_idx_entry(fifo, i)	((fifo)->data[((fifo)->front + (i)) & (fifo)->mask])
+
+#define fifo_push_back_ref(f)						\
+	(fifo_full((f)) ? NULL : &(f)->data[(f)->back++ & (f)->mask])
+
+#define fifo_push_front_ref(f)						\
+	(fifo_full((f)) ? NULL : &(f)->data[--(f)->front & (f)->mask])
+
+#define fifo_push_back(fifo, new)					\
+({									\
+	typeof(&(fifo)->data[0]) _r = fifo_push_back_ref(fifo);		\
+	if (_r)								\
+		*_r = (new);						\
+	_r != NULL;							\
+})
+
+#define fifo_push_front(fifo, new)					\
+({									\
+	typeof(&(fifo)->data[0]) _r = fifo_push_front_ref(fifo);	\
+	if (_r)								\
+		*_r = (new);						\
+	_r != NULL;							\
+})
+
+#define fifo_pop_front(fifo, i)						\
+({									\
+	bool _r = !fifo_empty((fifo));					\
+	if (_r)								\
+		(i) = (fifo)->data[(fifo)->front++ & (fifo)->mask];	\
+	_r;								\
+})
+
+#define fifo_pop_back(fifo, i)						\
+({									\
+	bool _r = !fifo_empty((fifo));					\
+	if (_r)								\
+		(i) = (fifo)->data[--(fifo)->back & (fifo)->mask];	\
+	_r;								\
+})
+
+#define fifo_push_ref(fifo)	fifo_push_back_ref(fifo)
+#define fifo_push(fifo, i)	fifo_push_back(fifo, (i))
+#define fifo_pop(fifo, i)	fifo_pop_front(fifo, (i))
+#define fifo_peek(fifo)		fifo_peek_front(fifo)
+
+#define fifo_for_each_entry_from(_entry, _fifo, _iter)			\
+	for (typecheck(typeof((_fifo)->front), _iter);			\
+	     ((_iter != (_fifo)->back) &&				\
+	      (_entry = fifo_entry(_fifo, _iter), true));		\
+	     (_iter)++)
+
+#define fifo_for_each_entry(_entry, _fifo, _iter)			\
+	for (typecheck(typeof((_fifo)->front), _iter),			\
+	     (_iter) = (_fifo)->front;					\
+	     ((_iter != (_fifo)->back) &&				\
+	      (_entry = fifo_entry(_fifo, _iter), true));		\
+	     (_iter)++)
+
+#define fifo_for_each_entry_ptr(_ptr, _fifo, _iter)			\
+	for (typecheck(typeof((_fifo)->front), _iter),			\
+	     (_iter) = (_fifo)->front;					\
+	     ((_iter != (_fifo)->back) &&				\
+	      (_ptr = &fifo_entry(_fifo, _iter), true));		\
+	     (_iter)++)
+
+#define fifo_for_each_entry_ptr_reverse(_ptr, _fifo, _iter)		\
+	for (typecheck(typeof((_fifo)->front), _iter),			\
+	     (_iter) = (_fifo)->back;					\
+	     ((_iter != (_fifo)->front) &&				\
+	      (_ptr = &fifo_entry(_fifo, _iter - 1), true));		\
+	     (_iter)--)
+
+#endif /* _BCACHEFS_FIFO_H */
diff --git a/fs/bcachefs/util/fifo.rs b/fs/bcachefs/util/fifo.rs
new file mode 100644
index 0000000..59a1b30
--- /dev/null
+++ b/fs/bcachefs/util/fifo.rs
@@ -0,0 +1,358 @@
+// SPDX-License-Identifier: GPL-2.0
+
+//! A fifo of absolute indices: front and back count up forever, wrapping at
+//! the index type's width, and the entry at index i lives at data[i & mask].
+//! So an index names its entry for as long as it's in the fifo, whatever's
+//! pushed and popped around it - the journal's are its sequence numbers.
+//!
+//! The struct is util/fifo.h's, Fifo<T, I> in types/lib.rs: C's macros and
+//! these methods work on the same one, until the journal's C is gone and
+//! fifo.h with it. size is C's limit on how many entries it holds; here it's
+//! always the whole buffer, mask + 1 - as C's journal fifos have it too - and
+//! goes with fifo.h.
+//!
+//! Growing keeps every index where it is: the buffer's a power of two, and
+//! the old one is copied into each old-sized stretch of the new one, so i &
+//! mask lands on i's entry under the new mask too, whatever bits it gained.
+//!
+//! An empty Fifo has no buffer, as C's before init_fifo(); one C has freed
+//! has none again (free_fifo() NULLs it), so dropping it frees nothing.
+
+use crate::types::Fifo;
+use crate::util::alloc::{kvfree_sized, kvrealloc, AllocError, Flags};
+use core::mem::{needs_drop, size_of, MaybeUninit};
+use core::ptr::NonNull;
+use num_traits::{AsPrimitive, ConstZero, PrimInt, Unsigned, WrappingAdd, WrappingSub};
+
+pub trait FifoIdx: PrimInt + Unsigned + ConstZero + WrappingAdd + WrappingSub + AsPrimitive<usize> {
+    /// Truncated to the type's width, as C's index arithmetic is.
+    fn from_usize(n: usize) -> Self;
+}
+
+impl<I> FifoIdx for I
+where
+    I: PrimInt + Unsigned + ConstZero + WrappingAdd + WrappingSub + AsPrimitive<usize>,
+    usize: AsPrimitive<I>,
+{
+    fn from_usize(n: usize) -> I {
+        n.as_()
+    }
+}
+
+// SAFETY: it owns its entries, as a Vec does
+unsafe impl<T: Send, I: FifoIdx + Send> Send for Fifo<T, I> {}
+unsafe impl<T: Sync, I: FifoIdx + Sync> Sync for Fifo<T, I> {}
+
+impl<T, I: FifoIdx> Default for Fifo<T, I> {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl<T, I: FifoIdx> Fifo<T, I> {
+    pub const fn new() -> Self {
+        Fifo { front: I::ZERO, back: I::ZERO, size: I::ZERO, mask: I::ZERO,
+               data: core::ptr::null_mut() }
+    }
+
+    fn add(i: I, n: usize) -> I {
+        i.wrapping_add(&I::from_usize(n))
+    }
+
+    fn prev(i: I) -> I {
+        i.wrapping_sub(&I::one())
+    }
+
+    /// How far @i is past front, in the index type's width.
+    fn offset(&self, i: I) -> usize {
+        i.wrapping_sub(&self.front).as_()
+    }
+
+    fn slot(&self, i: I) -> *mut T {
+        self.data.wrapping_add((i & self.mask).as_())
+    }
+
+    /// The buffer's entries, mask + 1, or none.
+    fn buf_len(&self) -> usize {
+        if self.data.is_null() { 0 } else { self.mask.as_() + 1 }
+    }
+
+    pub fn len(&self) -> usize {
+        self.offset(self.back)
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.front == self.back
+    }
+
+    pub fn capacity(&self) -> usize {
+        self.size.as_()
+    }
+
+    pub fn free(&self) -> usize {
+        self.capacity() - self.len()
+    }
+
+    pub fn is_full(&self) -> bool {
+        self.len() == self.capacity()
+    }
+
+    pub fn front_idx(&self) -> I {
+        self.front
+    }
+
+    /// One past the last entry's index: the next push_back()'s.
+    pub fn back_idx(&self) -> I {
+        self.back
+    }
+
+    pub fn get(&self, i: I) -> Option<&T> {
+        // SAFETY: in [front, back): an entry
+        (self.offset(i) < self.len()).then(|| unsafe { &*self.slot(i) })
+    }
+
+    pub fn get_mut(&mut self, i: I) -> Option<&mut T> {
+        // SAFETY: as get()'s
+        (self.offset(i) < self.len()).then(|| unsafe { &mut *self.slot(i) })
+    }
+
+    pub fn peek_front(&self) -> Option<&T> {
+        self.get(self.front)
+    }
+
+    pub fn peek_back(&self) -> Option<&T> {
+        self.get(Self::prev(self.back))
+    }
+
+    pub fn push_back(&mut self, v: T) -> Result<(), T> {
+        if self.is_full() {
+            return Err(v);
+        }
+        // SAFETY: a free slot
+        unsafe { self.slot(self.back).write(v) };
+        self.back = Self::add(self.back, 1);
+        Ok(())
+    }
+
+    pub fn push_front(&mut self, v: T) -> Result<(), T> {
+        if self.is_full() {
+            return Err(v);
+        }
+        self.front = Self::prev(self.front);
+        // SAFETY: a free slot
+        unsafe { self.slot(self.front).write(v) };
+        Ok(())
+    }
+
+    pub fn pop_front(&mut self) -> Option<T> {
+        if self.is_empty() {
+            return None;
+        }
+        // SAFETY: an entry, no longer one once front's past it
+        let v = unsafe { self.slot(self.front).read() };
+        self.front = Self::add(self.front, 1);
+        Some(v)
+    }
+
+    pub fn pop_back(&mut self) -> Option<T> {
+        if self.is_empty() {
+            return None;
+        }
+        self.back = Self::prev(self.back);
+        // SAFETY: an entry, no longer one now back's at it
+        Some(unsafe { self.slot(self.back).read() })
+    }
+
+    /// Drop the first @n entries.
+    pub fn advance_front(&mut self, n: usize) {
+        assert!(n <= self.len(), "advancing a fifo's front past its back");
+        if needs_drop::<T>() {
+            for _ in 0..n {
+                drop(self.pop_front());
+            }
+        } else {
+            self.front = Self::add(self.front, n);
+        }
+    }
+
+    pub fn iter(&self) -> impl Iterator<Item = &T> + '_ {
+        let (a, b) = self.as_slices();
+        a.iter().chain(b)
+    }
+
+    /// The entries, front to back, as the buffer has them: two stretches,
+    /// the second empty unless they wrap.
+    pub fn as_slices(&self) -> (&[T], &[T]) {
+        if self.data.is_null() {
+            return (&[], &[]);
+        }
+        let (start, first, rest) = self.stretches(self.front, self.len());
+        // SAFETY: entries, front to back
+        unsafe {
+            (core::slice::from_raw_parts(self.data.wrapping_add(start), first),
+             core::slice::from_raw_parts(self.data, rest))
+        }
+    }
+
+    /// The free slots after back, as as_slices() has the entries.
+    fn spare_mut(&mut self) -> (&mut [MaybeUninit<T>], &mut [MaybeUninit<T>]) {
+        if self.data.is_null() {
+            return (&mut [], &mut []);
+        }
+        let (start, first, rest) = self.stretches(self.back, self.free());
+        let data = self.data.cast::<MaybeUninit<T>>();
+        // SAFETY: free slots, disjoint, and ours while we're borrowed
+        unsafe {
+            (core::slice::from_raw_parts_mut(data.wrapping_add(start), first),
+             core::slice::from_raw_parts_mut(data, rest))
+        }
+    }
+
+    /// @n slots from index @i: where the first stretch starts, its length,
+    /// and the length of the second, from the buffer's start.
+    fn stretches(&self, i: I, n: usize) -> (usize, usize, usize) {
+        let start = (i & self.mask).as_();
+        let first = n.min(self.buf_len() - start);
+        (start, first, n - first)
+    }
+
+    /// Room for @more entries past those there, the buffer grown if it must
+    /// be - to a power of two, every index kept. @gfp as kvrealloc()'s.
+    pub fn reserve(&mut self, more: usize, gfp: Flags) -> Result<(), AllocError> {
+        const { assert!(size_of::<T>() != 0, "a fifo of zero sized entries") };
+
+        let want = self.len().checked_add(more).ok_or(AllocError)?;
+        if want <= self.capacity() {
+            return Ok(());
+        }
+
+        let old = self.buf_len();
+        let new = want.checked_next_power_of_two().ok_or(AllocError)?;
+        // size, the largest index field, holds the whole buffer
+        let size: I = num_traits::cast(new).ok_or(AllocError)?;
+
+        let p = kvrealloc(self.data.cast(), old * size_of::<T>(), new * size_of::<T>(), gfp)?
+            .cast::<T>().as_ptr();
+        if old != 0 {
+            for k in 1..new / old {
+                // SAFETY: within the new buffer; the first stretch is the old
+                unsafe { p.copy_to_nonoverlapping(p.add(k * old), old) };
+            }
+        }
+
+        self.data = p;
+        self.mask = size - I::one();
+        self.size = size;
+        Ok(())
+    }
+}
+
+impl<T: Copy, I: FifoIdx> Fifo<T, I> {
+    /// Up to @n entries off the front, a stretch at a time: @f takes each
+    /// stretch it's given, or refuses it and the rest. How many it took.
+    pub fn drain_with(&mut self, n: usize, mut f: impl FnMut(&[T]) -> bool) -> usize {
+        let (a, b) = self.as_slices();
+        let mut done = 0;
+        for s in [a, b] {
+            let k = s.len().min(n - done);
+            if k == 0 || !f(&s[..k]) {
+                break;
+            }
+            done += k;
+        }
+        self.advance_front(done);
+        done
+    }
+
+    /// Up to @n entries onto the back, as many as fit, a stretch of free
+    /// slots at a time: @f fills each stretch it's given, or refuses it and
+    /// the rest. How many it filled.
+    ///
+    /// # Safety
+    /// @f returns true only having written every slot of its stretch.
+    pub unsafe fn fill_with(&mut self, n: usize, mut f: impl FnMut(&mut [MaybeUninit<T>]) -> bool)
+        -> usize
+    {
+        let n = n.min(self.free());
+        let (a, b) = self.spare_mut();
+        let mut done = 0;
+        for s in [a, b] {
+            let k = s.len().min(n - done);
+            if k == 0 || !f(&mut s[..k]) {
+                break;
+            }
+            done += k;
+        }
+        self.back = Self::add(self.back, done);
+        done
+    }
+
+    /// @s at the back, all of it - Err if it doesn't fit.
+    pub fn extend_from_slice(&mut self, s: &[T]) -> Result<(), ()> {
+        if s.len() > self.free() {
+            return Err(());
+        }
+        let mut src = s;
+        // SAFETY: each stretch written in full
+        unsafe {
+            self.fill_with(s.len(), |d| {
+                let (h, t) = src.split_at(d.len());
+                d.as_mut_ptr().cast::<T>().copy_from_nonoverlapping(h.as_ptr(), h.len());
+                src = t;
+                true
+            })
+        };
+        Ok(())
+    }
+}
+
+impl<T, I: FifoIdx> Drop for Fifo<T, I> {
+    fn drop(&mut self) {
+        let Some(data) = NonNull::new(self.data) else { return };
+        self.advance_front(self.len());
+        // SAFETY: reserve()'s - or init_fifo()'s, kvmalloc() too - and no one's
+        unsafe { kvfree_sized(data.cast(), self.buf_len() * size_of::<T>()) };
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::util::alloc::flags::GFP_KERNEL;
+
+    #[test]
+    fn indices_survive_wrap_and_grow() {
+        let mut f = Fifo::<u32, u16>::new();
+        f.reserve(4, GFP_KERNEL).unwrap();
+
+        // walk the indices past the u16 wrap, the buffer wrapping too
+        for i in 0..70000u32 {
+            f.push_back(i).unwrap();
+            assert_eq!(f.pop_front(), Some(i));
+        }
+        for i in 0..3 {
+            f.push_back(i).unwrap();
+        }
+        let front = f.front_idx();
+
+        f.reserve(13, GFP_KERNEL).unwrap();
+        assert_eq!(f.capacity(), 16);
+        for i in 0..3u32 {
+            assert_eq!(f.get(Fifo::<u32, u16>::add(front, i as usize)), Some(&i));
+        }
+        assert_eq!(f.iter().copied().collect::<Vec<_>>(), [0, 1, 2]);
+    }
+
+    #[test]
+    fn slices_wrap() {
+        let mut f = Fifo::<u8>::new();
+        f.reserve(8, GFP_KERNEL).unwrap();
+        f.extend_from_slice(b"abcdef").unwrap();
+        assert_eq!(f.drain_with(5, |s| s == b"abcde"), 5);
+        f.extend_from_slice(b"ghijk").unwrap();
+        assert!(f.extend_from_slice(b"lmn").is_err());
+
+        let (a, b) = f.as_slices();
+        assert_eq!((a, b), (&b"fgh"[..], &b"ijk"[..]));
+    }
+}
